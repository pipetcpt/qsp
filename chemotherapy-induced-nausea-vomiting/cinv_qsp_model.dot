/* ===========================================================================
   cinv_qsp_model.dot
   Chemotherapy-Induced Nausea and Vomiting (CINV) — mechanistic QSP map

   ORGANISING THESIS (see README.md):

     A CINV endpoint is not a percentage that drugs shrink.  It is an
     EXPONENTIAL OF AN INTEGRAL OF A HAZARD, and the hazard is driven by a SUM:

         DRIVE(t) = SUM_j  w_j * A_j(t)          (additive, receptor-specific)
         lambda(t) = HMAX * (DRIVE - DRIVE0)^n / (THR^n + (DRIVE - DRIVE0)^n)
         CR(window) = E_S[ exp( -S * INTEGRAL lambda dt ) ]

     Every antiemetic ever licensed removes ONE TERM A_j from that sum.  None
     of them scales DRIVE.  Three consequences are therefore OUTPUTS of this
     map and not rules written into it:

       1. ADDITIVITY IS EXACT ONLY IN THE DRIVE.  Each drug deletes one term
          of the sum and leaves the others where they were - that layer is
          additive by construction.  But the chain drive -> lambda -> I -> CR
          is a SATURATING THRESHOLD followed by an EXPONENTIAL, so additivity
          is destroyed on the way to the endpoint: measured in this model, it
          is already down to ~67% of the sum at the dI level.  The "synergy"
          universally reported between a 5-HT3 RA, an NK1 RA, dexamethasone
          and olanzapine is therefore additive pharmacology seen through a
          nonlinear chain, not receptor interaction - and the ABSOLUTE benefit
          of the fourth agent is a NON-MONOTONIC function of baseline risk.

       2. THE ACUTE AND DELAYED PHASES ARE THE SAME EQUATION WITH A DIFFERENT
          TERM DOMINATING.  The 5-HT3 term is a mucosal BURST (peaks 4-6 h,
          gone by 24 h, trackable as urinary 5-HIAA).  The NK1 term is a
          TRANSCRIPTIONAL RAMP (preprotachykinin induction, peaks 24-72 h).
          A 5-HT3 antagonist deletes the term that dominates day 1 and is
          nearly absent from day 3 — the delayed phase is not the drug wearing
          off, it is a term the drug never addressed.

       3. NAUSEA AND VOMITING DISSOCIATE BECAUSE THEY ARE TWO DIFFERENT
          WEIGHTED SUMS.  The brainstem sum crosses a threshold (vomiting);
          the cortical/insular sum is graded (nausea) and contains H1, M1,
          5-HT2A, AVP, gastric-dysrhythmia and conditioned terms that no
          5-HT3 or NK1 antagonist touches.  Olanzapine is the only agent in
          the map that subtracts FOUR of the cortical terms at once, which is
          why "no nausea" is the endpoint it owns.

     A fourth structure is what makes 100% control impossible: the area
     postrema has no blood-brain barrier, so circulating platinum drives an
     input WAP*(FG + WAPD*FZ) that is downstream of NO receptor in the map.
     It has an ACUTE part (FG, the mucosal burst) and a DELAYED part (FZ, the
     transit signal), and the delayed part is why complete response in the
     24-120 h window caps below 80% even on a four-drug regimen.  No
     combination of antagonists can remove it; only the gain terms
     (glucocorticoid, GABA-A, CB1) attenuate it.

     FIFTH, AND IT IS A CORRECTION WORTH RECORDING: the tonic subtraction
     happens INSIDE each term, before the gain is applied.  An earlier version
     of this model subtracted a single tonic constant from the gain-scaled
     total, which let dexamethasone alone push the sum below baseline and act
     as a complete antiemetic.  Building the sum out of increments over
     analytic drug-free values makes that failure structurally impossible and
     removes two calibrated constants.

   RENDER:
     dot -Tsvg cinv_qsp_model.dot -o cinv_qsp_model.svg
     dot -Tpng -Gdpi=150 cinv_qsp_model.dot -o cinv_qsp_model.png

   LEGEND (edge semantics)
     solid black  ->   mass flow / conversion / transcription
     blue         ->   activation / positive influence
     red (tee)    ->   inhibition / receptor blockade / competitive occupancy
     green dashed ->   drug administration or PK linkage
     purple dot   ->   the hazard / threshold mathematics (the thesis)
     orange       ->   off-target or adverse consequence
   =========================================================================== */

digraph CINV {
  graph [rankdir=TB, splines=true, newrank=true, nodesep=0.22, ranksep=0.48,
         fontname="Helvetica", fontsize=11, compound=true,
         labelloc="t", label=<
           <B>Chemotherapy-Induced Nausea and Vomiting — QSP mechanistic map</B><BR/>
           <FONT POINT-SIZE="11">Every antiemetic subtracts ONE additive term from the emetic drive; every endpoint is exp(-&#8747;hazard).<BR/>
           Additivity is exact only in the DRIVE; the saturating hazard and the exponential endpoint destroy it, which is where all reported synergy comes from.</FONT>
         >, fontsize=20];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10,
         color="#4a4a4a", fillcolor="#f7f7f7", penwidth=1.0, margin="0.06,0.03"];
  edge  [fontname="Helvetica", fontsize=8, arrowsize=0.6, penwidth=1.0];

  /* ---------- edge classes ---------- */
  /* act = blue, inh = red tee, pk = green dashed, math = purple dotted, adv = orange */

  /* =====================================================================
     1. CHEMOTHERAPY / EMETOGENIC STIMULUS
     ===================================================================== */
  subgraph cluster_chemo {
    label="1 · Chemotherapy & emetogenic stimulus";
    style="rounded,filled"; fillcolor="#eef4fb"; color="#2c5aa0"; fontcolor="#2c5aa0"; fontsize=13;
    CISDOSE  [label="Cisplatin dose\n70–120 mg/m² IV 2 h", fillcolor="#d6e6f7"];
    C_CIS    [label="C_CIS\nfree plasma platinum\n(t½α ≈ 25 min)", fillcolor="#d6e6f7"];
    T_CIS    [label="T_CIS\ntissue-bound platinum\n(t½ ≈ 35 h, DNA adducts)", fillcolor="#d6e6f7"];
    G_CIS    [label="G_CIS\nGI-mucosal platinum signal", fillcolor="#d6e6f7"];
    FG       [label="FG = G^HG/(KG50^HG+G^HG)\nsigmoidal mucosal injury\n(HG = 2.5 → BURST, not tail)", fillcolor="#bcd8f2", shape=box, penwidth=2];
    Z1       [label="Z1 transit", fillcolor="#d6e6f7"];
    Z2       [label="Z2 delayed central signal\n(peaks ≈ 2/KZ ≈ 40 h)", fillcolor="#bcd8f2", penwidth=2];
    ROS      [label="mucosal ROS / oxidative stress\nxanthine oxidase, NADPH ox."];
    DNADAM   [label="enterocyte + EC-cell DNA damage\np53, apoptosis"];
    EMETO_P  [label="EMETO_P\nperipheral emetogenicity\n(EC-cell release potency)", fillcolor="#bcd8f2"];
    EMETO_C  [label="EMETO_C\ncentral emetogenicity\n(SP-induction potency)", fillcolor="#bcd8f2"];
    HEC      [label="HEC  cisplatin, AC, carmustine\n(>90% risk)", fillcolor="#f9dede"];
    MEC      [label="MEC  carboplatin, oxaliplatin,\nirinotecan, doxorubicin (30–90%)", fillcolor="#fdf0dd"];
    LEC      [label="LEC / minimal  taxanes, 5-FU,\ngemcitabine, bleomycin (<30%)", fillcolor="#e7f6e7"];
    RADIO    [label="concurrent radiotherapy\n(additive mucosal signal)"];
  }

  /* =====================================================================
     2. ENTEROCHROMAFFIN CELL / SEROTONIN
     ===================================================================== */
  subgraph cluster_ec {
    label="2 · Enterochromaffin cell — the ACUTE term";
    style="rounded,filled"; fillcolor="#fdf3ec"; color="#c05a10"; fontcolor="#c05a10"; fontsize=13;
    ECCELL   [label="enterochromaffin (EC) cell\nduodenal + jejunal mucosa\n(>90% of body 5-HT)", fillcolor="#fbe0cd"];
    TPH1     [label="TPH1 tryptophan hydroxylase"];
    TRP      [label="L-tryptophan"];
    HTP5     [label="5-hydroxytryptophan"];
    VMAT1    [label="VMAT1 (SLC18A1)\nvesicular loading"];
    ECS      [label="ECS\nEC-cell 5-HT store\n(fraction of normal)", fillcolor="#fbe0cd"];
    REL      [label="REL = KRE · EMETO_P · FG · ECS\nregulated exocytosis", fillcolor="#f7c9a6", penwidth=2];
    SHT_G    [label="SHT_G\ngut interstitial 5-HT (nM)\npeak 4–6 h", fillcolor="#f7c9a6", penwidth=2];
    SERT     [label="SERT (SLC6A4) reuptake"];
    MAOA     [label="MAO-A oxidative deamination"];
    SHT_P    [label="SHT_P\nplasma / platelet 5-HT"];
    UHIAA    [label="urinary 5-HIAA excretion\n(OBSERVABLE acute biomarker)", fillcolor="#f7c9a6"];
    ENTNEUR  [label="enteric neurons\n(SP, CGRP co-release)"];
    HTR3B_P  [label="HTR3B −100_−102AAG variant\n(higher release / response)", fillcolor="#efe3f7"];
  }

  /* =====================================================================
     3. VAGAL AFFERENT TERMINAL / 5-HT3 RECEPTOR
     ===================================================================== */
  subgraph cluster_vagal {
    label="3 · Vagal afferent terminal — 5-HT3 receptor occupancy (KINETIC)";
    style="rounded,filled"; fillcolor="#fbf1f1"; color="#a02c2c"; fontcolor="#a02c2c"; fontsize=13;
    HTR3A    [label="HTR3A subunit"];
    HTR3B    [label="HTR3B subunit"];
    R3TOT    [label="5-HT3 receptor pool\nligand-gated cation channel\n(vagal terminal + AP + NTS)", fillcolor="#f4d4d4"];
    FREE3    [label="FREE3 = 1 − ΣR3\navailable receptor", fillcolor="#f4d4d4"];
    R3S      [label="R3S  5-HT-occupied\n= THE ACUTE SIGNAL", fillcolor="#eeb4b4", penwidth=2];
    R3O      [label="R3O  ondansetron-occupied\n(Kd 2 nM, koff 4 /h)"];
    R3G      [label="R3G  granisetron-occupied\n(Kd 0.5 nM)"];
    R3P      [label="R3P  palonosetron-occupied\n(Kd 0.1 nM, koff 0.10 /h)"];
    R3I      [label="R3I  INTERNALISED receptor\npalonosetron-triggered\n(krec 0.012 /h)", fillcolor="#eeb4b4"];
    CAINF    [label="Ca²⁺ / Na⁺ influx\nterminal depolarisation"];
    VAGFIRE  [label="VAG\nvagal afferent firing rate", fillcolor="#eeb4b4", penwidth=2];
    NODOSE   [label="nodose ganglion\ncell bodies"];
    ABDVAG   [label="abdominal vagal trunk"];
    MECHAN   [label="gastric mechanoreceptors\n(distension)"];
    NK1_PER  [label="peripheral NK1 on vagal terminals\n(equilibrium occupancy)"];
  }

  /* =====================================================================
     4. SUBSTANCE P / NK1 — the DELAYED term
     ===================================================================== */
  subgraph cluster_sp {
    label="4 · Substance P / NK1 — the DELAYED term (transcriptional ramp)";
    style="rounded,filled"; fillcolor="#f2f0fa"; color="#5a3ca0"; fontcolor="#5a3ca0"; fontsize=13;
    TAC1     [label="TAC1 (preprotachykinin-A) gene"];
    PPT      [label="PPT\npreprotachykinin synthesis capacity\n(t½ ≈ 24 h ⇒ the DELAY)", fillcolor="#ddd6f3", penwidth=2];
    SP_C     [label="SP_C\ncentral (NTS / AP) substance P"];
    SP_P     [label="SP_P\nperipheral substance P\n(acute co-release + delayed ramp)"];
    NEP      [label="neprilysin (MME) degradation"];
    ACE_SP   [label="ACE / DPP4 secondary clearance"];
    TACR1    [label="TACR1 → NK1 receptor pool\nGq-coupled 7TM", fillcolor="#ddd6f3"];
    FREEN    [label="FREEN = 1 − ΣNK1\navailable receptor"];
    N1S      [label="N1S  SP-occupied NK1\n= THE DELAYED SIGNAL", fillcolor="#c9bef0", penwidth=2];
    N1A      [label="N1A  aprepitant-occupied\n(Kd 0.1 nM, koff 0.16 /h)"];
    N1N      [label="N1N  netupitant-occupied\n(Kd 0.9 nM)"];
    N1R      [label="N1R  rolapitant-occupied\n(Kd 0.03 nM, koff 0.033 /h)"];
    PLCB     [label="PLCβ → IP₃ / DAG → Ca²⁺\nPKC, ERK"];
    TACR1_P  [label="TACR1 polymorphism\n(NK1 RA response modifier)", fillcolor="#efe3f7"];
  }

  /* =====================================================================
     5. DOPAMINE / AREA POSTREMA
     ===================================================================== */
  subgraph cluster_da {
    label="5 · Dopamine & the area postrema (no blood-brain barrier)";
    style="rounded,filled"; fillcolor="#eef7f2"; color="#1c7a4a"; fontcolor="#1c7a4a"; fontsize=13;
    AP       [label="AREA POSTREMA\n(chemoreceptor trigger zone)\nFENESTRATED capillaries", fillcolor="#cceadb", penwidth=2];
    DA_AP    [label="DA_AP\ndopamine tone at the AP"];
    DRD2     [label="DRD2 receptor (Gi)"];
    OCCD2    [label="occD2 = DA/(KD_DA·(1+ΣC/Ki)+DA)\ncompetitive, EQUILIBRIUM"];
    WAPTERM  [label="WAP · (FG + WAPD·FZ)\nDIRECT platinum drive on the AP,\nACUTE + DELAYED\nDOWNSTREAM OF NO RECEPTOR", fillcolor="#8fd0b0", penwidth=3];
    BBBGAP   [label="absent BBB at the AP\n⇒ blood-borne toxin access"];
  }

  /* =====================================================================
     6. OTHER RECEPTOR INPUTS (equilibrium occupancy)
     ===================================================================== */
  subgraph cluster_rec {
    label="6 · Other receptor inputs (fast ⇒ equilibrium occupancy)";
    style="rounded,filled"; fillcolor="#f7f4ec"; color="#8a7220"; fontcolor="#8a7220"; fontsize=13;
    H1R      [label="H1 histamine receptor\n(vestibular / cortical)"];
    M1R      [label="M1 muscarinic receptor"];
    HTR2A    [label="5-HT2A / 5-HT2C receptor"];
    CB1R     [label="CB1 cannabinoid receptor\n(presynaptic, Gi)"];
    GABAA    [label="GABA-A receptor\n(benzodiazepine site)"];
    MOR      [label="µ-opioid receptor\n(pro-emetic at the AP)"];
    OCCH1    [label="occH1"]; OCCM1 [label="occM1"]; OCC2A [label="occ5HT2A"];
    OCCCB1   [label="occCB1"]; OCCGABA [label="occGABA"];
  }

  /* =====================================================================
     7. NTS / BRAINSTEM EMETIC INTEGRATION — the SUM
     ===================================================================== */
  subgraph cluster_nts {
    label="7 · NTS / brainstem integration — THE SUM";
    style="rounded,filled"; fillcolor="#eaf0f7"; color="#1a3d6b"; fontcolor="#1a3d6b"; fontsize=13;
    NTS      [label="NUCLEUS TRACTUS SOLITARII\nconvergence of all afferents", fillcolor="#c5d8ee", penwidth=2];
    DMNV     [label="dorsal motor nucleus of the vagus"];
    CPG      [label="emetic central pattern generator\n(medullary reticular formation)"];
    GAINBS   [label="GAIN_BS = (1−EGABA·occGABA)\n×(1−ECB1·occCB1)\n×(1−EDEXBS·f(DEXN))", fillcolor="#a8c6e8"];
    DRIVE    [label="DRIVE = GAIN_BS × Σ w_j ΔA_j\nWVAG·(VAG−VAG*) + WNKC·(N1S−N1S*)\n+ WD2·(occD2−occD2*) + WBLD·f(SHT_P)\n+ WAP·APT + WANT·ANTIC", fillcolor="#8fb4e0", penwidth=3];
    DRIVE0   [label="tonic reference values VAG*, N1S*, occD2*\nANALYTIC in the parameters —\nnot fitted, not integrated", fillcolor="#a8c6e8"];
    EBS      [label="EBS = max(0, DRIVE)\nevery term is an INCREMENT, so a\ndrug-free patient has EBS ≡ 0", fillcolor="#8fb4e0", penwidth=2];
  }

  /* =====================================================================
     8. CORTICAL / INSULAR NAUSEA NETWORK — a DIFFERENT SUM
     ===================================================================== */
  subgraph cluster_ctx {
    label="8 · Cortical / insular nausea network — a DIFFERENT weighted sum";
    style="rounded,filled"; fillcolor="#f6eef7"; color="#7a2c7a"; fontcolor="#7a2c7a"; fontsize=13;
    INSULA   [label="insular cortex\n(interoceptive representation)", fillcolor="#ecd4ee"];
    ACC      [label="anterior cingulate cortex"];
    AMYG     [label="amygdala"];
    PBN      [label="parabrachial nucleus\n(relay to forebrain)"];
    HYPOTH   [label="hypothalamic PVN\n(AVP, CRH)"];
    CTX      [label="CTX = GAIN_CTX × Σ n_j ΔA_j\nNVAG·ΔVAG + NNK·ΔN1S + N2A·occ2A\n+ NH1·ΔoccH1 + NM1·ΔoccM1 + ND2·ΔoccD2\n+ NAVP·ΔAVP + NAP·APT\n+ NANT·(ANTIC+ΔANX) + NSW·(1−SWC)", fillcolor="#dbb6e0", penwidth=3];
    CTX0     [label="tonic reference values\noccH1*, occM1*, AVP0, ANX0", fillcolor="#ecd4ee"];
    ECT      [label="ECT = max(0, CTX)", fillcolor="#dbb6e0", penwidth=2];
    NAUSEA   [label="NAUSEA (VAS 0–10)\nGRADED percept, not a threshold", fillcolor="#c893d0", penwidth=3];
  }

  /* =====================================================================
     9. GASTRIC MOTILITY / VASOPRESSIN
     ===================================================================== */
  subgraph cluster_gastric {
    label="9 · Gastric motility, dysrhythmia & vasopressin";
    style="rounded,filled"; fillcolor="#f0f7f7"; color="#1c6a7a"; fontcolor="#1c6a7a"; fontsize=13;
    ICC      [label="interstitial cells of Cajal\ngastric pacemaker (3 cpm)"];
    SWC      [label="SWC\nslow-wave coupling index\n(1 = normal)", fillcolor="#cfe8ec"];
    TACHY    [label="tachygastria / bradygastria\n(EGG abnormality)"];
    GVOL     [label="GVOL\ngastric content volume"];
    EMPT     [label="gastric emptying rate\n(D2-antagonist prokinesis)"];
    GASTSTAS [label="gastric stasis → distension\nPOSITIVE FEEDBACK to VAG", fillcolor="#cfe8ec", penwidth=2];
    AVP      [label="AVP (arginine vasopressin)\nplasma — nausea biomarker", fillcolor="#cfe8ec"];
    V2R      [label="renal V2 receptor → water retention"];
  }

  /* =====================================================================
     10. ANTICIPATORY CONDITIONING
     ===================================================================== */
  subgraph cluster_learn {
    label="10 · Anticipatory nausea — associative learning (no receptor to block)";
    style="rounded,filled"; fillcolor="#fdf7e8"; color="#9a7a10"; fontcolor="#9a7a10"; fontsize=13;
    CUE      [label="clinic cues\n(smell, room, infusion sight)"];
    ANTIC    [label="ANTIC\nconditioned association strength\nkacq·(NAUSEA/10)·(1−ANTIC)", fillcolor="#f7ecc8", penwidth=2];
    ANX      [label="ANX\nanticipatory anxiety"];
    HIPPO    [label="hippocampus / amygdala\nPavlovian consolidation"];
    CARRY    [label="CYCLE-TO-CYCLE CARRYOVER\nkext ≪ kacq ⇒ failure is REMEMBERED", fillcolor="#f2df9e", penwidth=2];
  }

  /* =====================================================================
     11. 5-HT3 RECEPTOR ANTAGONISTS
     ===================================================================== */
  subgraph cluster_5ht3ra {
    label="11 · 5-HT3 receptor antagonists (PK)";
    style="rounded,filled"; fillcolor="#eafaf1"; color="#157347"; fontcolor="#157347"; fontsize=13;
    OND      [label="ONDANSETRON 8–16 mg\nt½ 4 h · CYP3A4/1A2/2D6", fillcolor="#c9f0da"];
    GRA      [label="GRANISETRON 1–2 mg\nt½ 6–9 h · CYP3A4", fillcolor="#c9f0da"];
    GRAER    [label="GRANISETRON ER-SC 10 mg\npolymer depot, ka 0.0115 /h ⇒ ≥5 d", fillcolor="#c9f0da"];
    PAL      [label="PALONOSETRON 0.25 mg IV\nt½ 40 h · ALLOSTERIC, slow koff", fillcolor="#9fe3bd", penwidth=2];
    TROP     [label="tropisetron / dolasetron /\nramosetron / azasetron"];
    OND_A    [label="A_OND gut"]; OND_C [label="C_OND central"]; OND_P [label="P_OND peripheral"];
    PAL_C    [label="C_PAL central"]; PAL_P [label="P_PAL peripheral"];
    GRA_C    [label="C_GRA central"];
    ALLOST   [label="allosteric binding + positive cooperativity\n⇒ receptor internalisation\n⇒ effect OUTLASTS plasma", fillcolor="#9fe3bd", penwidth=2];
    XTALK    [label="palonosetron inhibits\n5-HT3 / NK1 CROSSTALK\n⇒ partial delayed cover", fillcolor="#9fe3bd"];
  }

  /* =====================================================================
     12. NK1 RECEPTOR ANTAGONISTS
     ===================================================================== */
  subgraph cluster_nk1ra {
    label="12 · NK1 receptor antagonists (PK)";
    style="rounded,filled"; fillcolor="#f0eefb"; color="#4a2c9a"; fontcolor="#4a2c9a"; fontsize=13;
    APR      [label="APREPITANT 125/80/80 mg PO\nt½ 11 h · CYP3A4 substrate\n+ MODERATE CYP3A4 INHIBITOR", fillcolor="#d9d0f5"];
    FOS      [label="FOSAPREPITANT 150 mg IV\nphosphoramidate prodrug", fillcolor="#d9d0f5"];
    NET      [label="NETUPITANT 300 mg PO\nt½ ≈ 88 h · CYP3A4 INHIBITOR", fillcolor="#d9d0f5"];
    FOSNET   [label="FOSNETUPITANT IV\n(no polysorbate-80 vehicle)"];
    ROL      [label="ROLAPITANT 180 mg PO\nt½ ≈ 180 h · CYP2D6 INHIBITOR\nNO CYP3A4 effect", fillcolor="#c3b4ef", penwidth=2];
    NEPA     [label="NEPA (netupitant + palonosetron)\nsingle-capsule combination"];
    APR_A    [label="A_APR gut"]; APR_C [label="C_APR central"]; APR_P [label="P_APR peripheral"];
    NET_C    [label="C_NET central"]; ROL_C [label="C_ROL central"];
    PETOCC   [label="PET striatal NK1 occupancy\n>85% sustained at 24 h\n(HELD-OUT validation)", fillcolor="#c3b4ef"];
  }

  /* =====================================================================
     13. CORTICOSTEROID ARM
     ===================================================================== */
  subgraph cluster_dex {
    label="13 · Dexamethasone — a SLOW GENOMIC arm (hence delayed-phase specific)";
    style="rounded,filled"; fillcolor="#fbf0f5"; color="#a02c6a"; fontcolor="#a02c6a"; fontsize=13;
    DEX      [label="DEXAMETHASONE\n20 mg d1 (12 mg with an NK1 RA)\n8 mg d2–4", fillcolor="#f4d4e4"];
    DEX_A    [label="A_DEX gut"]; DEX_C [label="C_DEX plasma (t½ 4 h)"]; DEX_P [label="P_DEX peripheral"];
    NR3C1    [label="NR3C1 glucocorticoid receptor\n(Kd ≈ 5 nM)"];
    DEXGR    [label="DEXGR\nGR-ligand complex (FAST)"];
    DEXN     [label="DEXN\nNUCLEAR / GENOMIC effect\nt½ ≈ 20 h — the SLOW step", fillcolor="#eeb4d0", penwidth=2];
    NFKB     [label="NF-κB / AP-1 transrepression"];
    DEXMECH  [label="three separable actions:\n① ↓5-HT synthesis & release\n② ↓TAC1 induction\n③ ↓NTS gain", fillcolor="#eeb4d0", penwidth=2];
    DEXDELAY [label="slow transduction ⇒ dexamethasone\nis a DELAYED-PHASE drug\nBY ITS KINETICS, not by a rule", fillcolor="#eeb4d0"];
  }

  /* =====================================================================
     14. OLANZAPINE — the multi-receptor arm
     ===================================================================== */
  subgraph cluster_ola {
    label="14 · Olanzapine — subtracts FOUR cortical terms at once";
    style="rounded,filled"; fillcolor="#fff4e8"; color="#b05c00"; fontcolor="#b05c00"; fontsize=13;
    OLA      [label="OLANZAPINE 10 mg (or 5 mg)\nt½ ≈ 30 h · CYP1A2/UGT", fillcolor="#ffe0c0"];
    OLA_A    [label="A_OLA gut"]; OLA_C [label="C_OLA central"]; OLA_P [label="P_OLA peripheral"];
    OLA_D2   [label="D2  Ki ≈ 20 nM"];
    OLA_2A   [label="5-HT2A Ki ≈ 4 nM"];
    OLA_H1   [label="H1  Ki ≈ 7 nM"];
    OLA_M1   [label="M1  Ki ≈ 26 nM"];
    OLA_MULTI[label="FOUR cortical terms removed\n⇒ moves the NAUSEA endpoint\nwhen 5-HT3/NK1 RAs cannot", fillcolor="#ffcfa0", penwidth=3];
  }

  /* =====================================================================
     15. DOPAMINE ANTAGONISTS / PROKINETICS
     ===================================================================== */
  subgraph cluster_d2ra {
    label="15 · Dopamine antagonists & prokinetics";
    style="rounded,filled"; fillcolor="#f2f7ea"; color="#5a7a10"; fontcolor="#5a7a10"; fontsize=13;
    MCP      [label="METOCLOPRAMIDE 10–20 mg\n(high dose 2–3 mg/kg: also 5-HT3)", fillcolor="#e2eec8"];
    DOMP     [label="domperidone\n(peripheral D2, does not cross BBB)"];
    PROCHL   [label="prochlorperazine / promethazine"];
    HALO     [label="haloperidol / droperidol"];
    AMISUL   [label="amisulpride (D2/D3)"];
    MCP_C    [label="C_MCP plasma"];
    PROKIN   [label="peripheral D2 blockade\n→ PROKINESIS → ↓gastric stasis", fillcolor="#e2eec8"];
  }

  /* =====================================================================
     16. GAIN MODULATORS (benzodiazepine / cannabinoid / other)
     ===================================================================== */
  subgraph cluster_gain {
    label="16 · Gain modulators & adjuncts";
    style="rounded,filled"; fillcolor="#eef7fb"; color="#1c5a7a"; fontcolor="#1c5a7a"; fontsize=13;
    LOR      [label="LORAZEPAM 0.5–2 mg\nthe ONLY agent that reaches ANTIC", fillcolor="#cfe6f5", penwidth=2];
    DRO      [label="DRONABINOL / nabilone\nCB1 agonist"];
    LOR_C    [label="C_LOR plasma"]; DRO_C [label="C_DRO plasma"];
    GABAPEN  [label="gabapentin / olanzapine adjunct"];
