  subgraph cluster_ddi {
    label="17 · CYP DDI network — the dexamethasone dose is a COMPUTED quantity";
    style="rounded,filled"; fillcolor="#fdeeee"; color="#a01c1c"; fontcolor="#a01c1c"; fontsize=13;
    E3A4     [label="hepatic CYP3A4 pool\n(turnover t½ 24 h)", fillcolor="#f7cccc"];
    E2D6     [label="hepatic CYP2D6 activity\n(no induction — genotype-set)", fillcolor="#f7cccc"];
    ACT3A4   [label="ACT3A4 = E3A4/(1+C_APR/Ki+C_NET/Ki)\nreversible competitive inhibition"];
    ACT2D6   [label="ACT2D6 = E2D6/(1+C_ROL/Ki)"];
    DEXCL    [label="CL_DEX = CL0·(fm3A4·ACT3A4 + 1−fm3A4)\nfm3A4 ≈ 0.85", fillcolor="#f7cccc"];
    DEXAUC   [label="dex AUC ×2.2 (aprepitant)\n×2.4 (netupitant) ×1.0 (rolapitant)\n⇒ 20 mg → 12 mg IS THE MODEL'S OUTPUT", fillcolor="#f0a0a0", penwidth=3];
    ONDCL    [label="CL_OND = CL0·(fm2D6·ACT2D6 + 1−fm2D6)"];
    DEXIND   [label="dexamethasone WEAKLY INDUCES CYP3A4\n(opposing its own inhibition)"];
    DXMDDI   [label="rolapitant × dextromethorphan\nAUC ×3 — CYP2D6, not CYP3A4\n⇒ THE CLASS SPLITS", fillcolor="#f0a0a0", penwidth=2];
