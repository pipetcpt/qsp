  CYP2D6G -> E2D6 [color="#6a2c8a", penwidth=2];
  CYP2D6G -> UMFAIL; UMFAIL -> ONDCL [color="#6a2c8a", penwidth=2];
  UMFAIL -> PAL [color="#5a1c9a", style=dotted, label="rescue: non-2D6 setron"];
  ABCB1 -> OND_C [color="#6a2c8a", style=dotted];
  HTR3C -> R3TOT [color="#6a2c8a", style=dotted];
  ERCC1 -> T_CIS [color="#6a2c8a", style=dotted];

  /* --- 19 efferent --- */
  CPG -> RGC [color="#2c5aa0"]; CPG -> LESREL [color="#2c5aa0"]; CPG -> ABDCON [color="#2c5aa0"];
  CPG -> SALIV [color="#2c5aa0"];
  RGC -> RETCH; LESREL -> EXPUL; ABDCON -> EXPUL; RETCH -> EXPUL;
  LAM -> EXPUL [color="#5a1c9a", style=dotted, penwidth=2];

  /* --- 20 the mathematics --- */
  LAM -> IINT [color="#5a1c9a", penwidth=2]; LAMR -> IINT [color="#5a1c9a"];
  FRAILTY -> CREQ [color="#5a1c9a", penwidth=2];
  IINT -> CREQ [color="#5a1c9a", penwidth=3];
  IINT -> MEANEP [color="#5a1c9a"];
  CREQ -> ADDLOG [color="#5a1c9a", penwidth=3];
  ADDLOG -> NONMONO [color="#5a1c9a", penwidth=2];
  FRAILTY -> OMEGAID [color="#5a1c9a"]; CREQ -> OMEGAID [color="#5a1c9a"];
  SUSC -> LAM [color="#3a3a7a", penwidth=2];
  LAMN -> NONAUS [color="#5a1c9a", penwidth=2];

  /* --- 21 endpoints --- */
  CREQ -> CRACUTE [color="#0f5a2a", penwidth=2];
  CREQ -> CRDELAY [color="#0f5a2a", penwidth=2];
  CREQ -> CROVER [color="#0f5a2a", penwidth=3];
  MEANEP -> RESCUE; LAMR -> RESCUE [color="#5a1c9a"];
  CROVER -> TCONTROL; NONAUS -> TCONTROL;
  NAUSEA -> FLIE [color="#a02c2c", arrowhead=tee]; EXPUL -> FLIE [color="#a02c2c", arrowhead=tee];
  LAM -> TTF [color="#5a1c9a", style=dotted];
  NAUSEA -> RDI [color="#a02c2c", arrowhead=tee, penwidth=2];
  ADDLOG -> QUAD [color="#5a1c9a", style=dotted, penwidth=2];

  /* --- 22 safety --- */
  HERG -> QTC [color="#d97706", penwidth=2]; QTC -> TORSADE [color="#d97706"];
  HYPOK -> TORSADE [color="#d97706", penwidth=2];
  SED -> FLIE [color="#a02c2c", arrowhead=tee];
  HYPERGLY -> DEXSPARE [color="#5a1c9a", style=dotted];

  /* --- 23 systemic --- */
  EXPUL -> ECFV [color="#d97706", penwidth=2]; EXPUL -> HYPOK [color="#d97706"];
  EXPUL -> ALKAL [color="#d97706"]; EXPUL -> MALLORY [color="#d97706"];
  ECFV -> NEPHRO [color="#d97706", penwidth=2]; T_CIS -> NEPHRO [color="#d97706"];
  NEPHRO -> SCR [color="#d97706"];
  NAUSEA -> MALNUT [color="#d97706"];
  ECFV -> HOSPITAL [color="#d97706"]; NAUSEA -> HOSPITAL [color="#d97706"];
  SCR -> DOSEDELAY [color="#d97706"]; NAUSEA -> DOSEDELAY [color="#d97706"];
  DOSEDELAY -> RDI [color="#a02c2c", arrowhead=tee, penwidth=2];
  HYDRATION -> ECFV [color="#a02c2c", arrowhead=tee]; HYDRATION -> NEPHRO [color="#a02c2c", arrowhead=tee];

  /* --- 24 risk --- */
  SEXF -> SUSC [color="#3a3a7a"]; AGEY -> SUSC [color="#3a3a7a"];
  ALCOHOL -> SUSC [color="#3a3a7a", arrowhead=tee]; MOTIONS -> SUSC [color="#3a3a7a"];
  PRIORC -> SUSC [color="#3a3a7a"]; ANXTRAIT -> SUSC [color="#3a3a7a"];
  SLEEPQ -> SUSC [color="#3a3a7a"];
  ANXTRAIT -> ANX [color="#2c5aa0"];
  CARRY -> PRIORC [color="#3a3a7a", style=dotted, penwidth=2];

  /* --- 25 guidelines --- */
  MASCC -> QUAD; NCCN -> QUAD; ASCO -> QUAD;
  NCCN -> TRIPLE; EMETO_C -> TRIPLE [color="#5a1c9a", style=dotted, label="carboplatin's\nCENTRAL potency"];
  QUAD -> OLA [color="#157347", style=dashed];
  QUAD -> APR [color="#157347", style=dashed]; QUAD -> PAL [color="#157347", style=dashed];
  QUAD -> DEX [color="#157347", style=dashed];
  DEXSPARE -> DEX [color="#a02c2c", arrowhead=tee];
  NONMONO -> ASCO [color="#5a1c9a", style=dotted, label="who benefits\nfrom the 4th agent"];
}
