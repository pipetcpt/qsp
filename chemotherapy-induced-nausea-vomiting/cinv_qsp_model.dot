  /* =====================================================================
     20. THE HAZARD MATHEMATICS — the thesis, drawn
     ===================================================================== */
  subgraph cluster_math {
    label="20 · THE THESIS — threshold hazard, exponential endpoint";
    style="rounded,filled"; fillcolor="#f3eefb"; color="#5a1c9a"; fontcolor="#5a1c9a"; fontsize=14; penwidth=2;
    LAM      [label="λ(t) = HMAX·EBS^n / (THR^n + EBS^n)\nemetic HAZARD (episodes/h)", fillcolor="#dcc8f5", penwidth=2];
    LAMR     [label="λ_rescue(t) = f(NAUSEA)"];
    LAMN     [label="λ_nausea(t) = KNAU·f(NAUSEA)"];
    IINT     [label="I = ∫ (λ + λ_rescue) dt\nCUMULATIVE HAZARD", fillcolor="#dcc8f5", penwidth=2];
    FRAILTY  [label="S ~ lognormal(0, ω²)\ninter-patient susceptibility", fillcolor="#dcc8f5"];
    CREQ     [label="CR = E_S[ exp(−S·I) ]\nGauss-Hermite quadrature", fillcolor="#c3a0f0", penwidth=3];
    ADDLOG   [label="ADDITIVE in log(CR)\nMULTIPLICATIVE in CR\nNEVER additive in CR%", fillcolor="#b088ea", penwidth=3];
    OMEGAID  [label="CR(0–120) > CR(0–24)·CR(24–120)\n⇒ THE PUBLISHED GAP IDENTIFIES ω", fillcolor="#c3a0f0", penwidth=2];
    NONMONO  [label="absolute benefit of the 4th agent\nis NON-MONOTONIC in baseline risk", fillcolor="#b088ea", penwidth=2];
    MEANEP   [label="E[episodes] = I  (same integral)\none equation, two endpoints", fillcolor="#dcc8f5"];
  }

