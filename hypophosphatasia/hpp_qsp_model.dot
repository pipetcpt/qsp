digraph HPP_QSP {
  rankdir=LR;
  fontname="Helvetica";
  labelloc="t";
  fontsize=20;
  label="Hypophosphatasia (HPP) — Mechanistic QSP Map\nOne enzyme (TNSALP/ALPL) → one competitive inhibitor at the mineralization front (PPi) → a THRESHOLD, not a gradient\nThe two circulating PD markers (PLP, PPi) are measured in the WRONG COMPARTMENT: they report plasma enzyme; mineralization is set by HA-BOUND enzyme\nDrug axes: asfotase alfa (D10 bone-targeted ERT) · efzimfotase alfa · pyridoxine · teriparatide (adult) · NSAID · bisphosphonate = MECHANISTIC POISON · gene therapy";
  node [style=filled, fontname="Helvetica", fontsize=10, shape=box, fillcolor="#ffffff"];
  edge [fontname="Helvetica", fontsize=8];
  newrank=true;
  ranksep=1.0;
  nodesep=0.32;

  // =========================================================================
  // 1. GENETIC ARCHITECTURE (ALPL, 1p36.12)
  // =========================================================================
  subgraph cluster_genetics {
    label="1. Genetic Architecture — ALPL (1p36.12), >400 variants, allelic dose sets residual activity";
    style=filled; color="#d8c9e8"; fillcolor="#f4eefb";
    ALPL_locus [label="ALPL gene (1p36.12)\n12 exons → TNSALP\n>400 pathogenic variants", fillcolor="#e3d1f5"];
    Var_severe [label="Biallelic severe LoF\n(e.g. c.1133A>T p.Asp378Val,\nnonsense / frameshift)\n→ residual activity ~0-3%", fillcolor="#e3d1f5"];
    Var_moderate [label="Compound het / hypomorph\n(e.g. p.Ala116Thr, p.Glu191Lys)\n→ residual ~5-20%", fillcolor="#e3d1f5"];
    Var_domneg [label="DOMINANT-NEGATIVE variants\nmutant monomer poisons the\nobligate homodimer\n→ activity < 50% in heterozygotes", fillcolor="#ffd9d9"];
    Var_mild [label="Monoallelic mild\n(p.Asn417Ser, p.Glu174Lys)\n→ odonto / adult HPP, ~35-50%"];
    Carrier [label="Heterozygous carrier\n~1:300 (Europe)\nusually near-normal skeleton"];
    Dimer_stoich [label="Obligate HOMODIMER\n(functional unit)\nWT/mut heterodimer partially active", fillcolor="#f0e2c8"];
    Genotype_activity [label="GENOTYPE → RESIDUAL\nLOCAL ENZYME ACTIVITY\nfracEnz ∈ [0.01 , 0.50]", fillcolor="#ffe9b3"];
    Prevalence [label="Prevalence\nsevere (biallelic) ~1:100,000-300,000\nmild (monoallelic) ~1:500-1,500"];
    Modifier_genes [label="Modifiers: ENPP1, ANKH,\nSPP1(OPN), COL1A1,\nvitamin-D pathway"];
    Somatic_mosaic [label="Intrafamilial variability\n/ incomplete penetrance\n(same genotype, different severity)"];
    ALPP_ALPI [label="Tissue-SPECIFIC ALPs\n(ALPP placental, ALPI intestinal,\nALPG germ-cell) = INTACT\n→ total serum ALP not zero", fillcolor="#e8f0e8"];
    ALPL_locus -> Var_severe; ALPL_locus -> Var_moderate; ALPL_locus -> Var_domneg;
    ALPL_locus -> Var_mild; ALPL_locus -> Carrier;
    Var_domneg -> Dimer_stoich [label="poisons"];
    Var_severe -> Dimer_stoich; Var_moderate -> Dimer_stoich; Var_mild -> Dimer_stoich;
    Dimer_stoich -> Genotype_activity;
    Modifier_genes -> Genotype_activity [style=dashed];
    Somatic_mosaic -> Genotype_activity [style=dashed];
    ALPL_locus -> Prevalence [style=dotted];
    ALPL_locus -> ALPP_ALPI [style=dotted, label="paralogues unaffected"];
  }

  // =========================================================================
  // 2. TNSALP PROTEIN BIOLOGY / TRAFFICKING
  // =========================================================================
  subgraph cluster_enzyme {
    label="2. TNSALP Protein Biology — GPI-anchored ectoenzyme on the MATRIX VESICLE membrane";
    style=filled; color="#c9dcf0"; fillcolor="#eaf3fb";
    TNSALP_synth [label="TNSALP synthesis (ER)\nN-glycosylation, Zn2+/Mg2+\nactive-site metals", fillcolor="#cfe4f7"];
    GPI_anchor [label="GPI anchor addition\n→ ectoenzyme, catalytic site\nfaces EXTRACELLULAR space", fillcolor="#cfe4f7"];
    MV_membrane [label="MATRIX VESICLE membrane\n(TNSALP + ENPP1 + ANKH + PHOSPHO1)\n= the mineralization nano-reactor", fillcolor="#bcd9f5"];
    OB_surface [label="Osteoblast plasma\nmembrane TNSALP"];
    HC_surface [label="Hypertrophic chondrocyte\nTNSALP (growth plate)"];
    Liver_TNSALP [label="Hepatic / renal TNSALP\n(same gene, same protein)"];
    Neuro_TNSALP [label="Neuronal / BBB-endothelial\nTNSALP (CNS B6 gating)", fillcolor="#cfe4f7"];
    GPI_shed [label="GPI-PLD shedding\n→ circulating soluble TNSALP\n= the SERUM ALP ASSAY", fillcolor="#ffe9b3"];
    Enz_kinetics [label="Kinetics: alkaline pH optimum,\nbroad phosphomonoesterase\nKm(PPi) ~ 20-50 uM"];
    Enz_local [label="E_LOCAL — enzyme activity AT\nthe perivesicular microenvironment\n(THE causal variable)", fillcolor="#ffcccc"];
    Enz_plasma [label="E_PLASMA — soluble activity\n(what the lab measures)", fillcolor="#ffe9b3"];
    Substrates_box [label="Natural substrates:\n(1) PPi  (2) PLP  (3) PEA\n(4) diphosphonucleotides"];
    Genotype_activity -> TNSALP_synth;
    TNSALP_synth -> GPI_anchor -> MV_membrane;
    GPI_anchor -> OB_surface; GPI_anchor -> HC_surface;
    GPI_anchor -> Liver_TNSALP; GPI_anchor -> Neuro_TNSALP;
    MV_membrane -> Enz_local; OB_surface -> Enz_local; HC_surface -> Enz_local;
    MV_membrane -> GPI_shed; Liver_TNSALP -> GPI_shed; GPI_shed -> Enz_plasma;
    Enz_kinetics -> Enz_local [style=dotted];
    Substrates_box -> Enz_local [style=dotted];
    Enz_local -> Enz_plasma [style=dashed, label="NOT proportional\nwhen drug is\nbone-targeted", color="red", fontcolor="red"];
  }

  // =========================================================================
  // 3. PYROPHOSPHATE (PPi) NETWORK — the inhibitor economy
  // =========================================================================
  subgraph cluster_ppi {
    label="3. Extracellular PPi Economy — production (ENPP1/ANKH) vs hydrolysis (TNSALP)";
    style=filled; color="#f0c9c9"; fillcolor="#fdeeee";
    ATP_ec [label="Extracellular ATP\n(released by MV / OB)"];
    ENPP1 [label="ENPP1 (NPP1)\nATP → AMP + PPi\nMAIN PPi source", fillcolor="#ffd9d9"];
    ANKH [label="ANKH / ANK\nintracellular → extracellular\nPPi channel/transporter", fillcolor="#ffd9d9"];
    PPi_intracell [label="Intracellular PPi pool\n(byproduct of >100 biosynthetic\nreactions)"];
    PPi_loc [label="PERIVESICULAR PPi  [uM]\nSTATE VARIABLE\nhealthy ~3 uM; severe HPP >30 uM", fillcolor="#ff9999"];
    PPi_plasma [label="PLASMA PPi  [uM]\nmeasurable biomarker\nHPP ~2-3x normal only", fillcolor="#ffe9b3"];
    PPi_urine [label="Urinary PPi excretion\n(classical HPP marker)"];
    PPi_hydro [label="TNSALP hydrolysis\nPPi + H2O → 2 Pi\n(removes inhibitor AND\nsupplies substrate = DOUBLE LEVER)", fillcolor="#ffd9d9"];
    PPi_diffuse [label="Diffusive escape\nperivesicular → plasma\n(kout, buffers plasma marker)"];
    PPi_sys [label="Systemic PPi production\n(non-skeletal tissues)"];
    OPN_PPi [label="Osteopontin (SPP1)\nphospho-OPN = 2nd inhibitor;\nPPi ↑ → OPN ↑ (co-regulated)", fillcolor="#ffd9d9"];
    OPN_cleave [label="TNSALP dephosphorylates OPN\n→ inhibitor relieved"];
    PHOSPHO1 [label="PHOSPHO1 (intravesicular)\nphosphocholine/-ethanolamine → Pi\nseeds first HA crystal", fillcolor="#e8f0e8"];
    PEA [label="Phosphoethanolamine (PEA)\nplasma/urine ↑ in HPP\n(diagnostic, not causal)"];
    ATP_ec -> ENPP1 -> PPi_loc;
    PPi_intracell -> ANKH -> PPi_loc;
    PPi_sys -> PPi_plasma;
    Enz_local -> PPi_hydro [color="blue", penwidth=2];
    PPi_hydro -> PPi_loc [label="− (clearance ∝ E_LOCAL)", color="blue", penwidth=2];
    PPi_loc -> PPi_diffuse -> PPi_plasma -> PPi_urine;
    Enz_plasma -> PPi_plasma [label="− (plasma hydrolysis)", color="blue"];
    PPi_loc -> OPN_PPi [label="+ co-induction"];
    Enz_local -> OPN_cleave -> OPN_PPi [label="−"];
    PHOSPHO1 -> PEA [style=dotted];
    Enz_local -> PEA [label="−", color="blue"];
  }

  // =========================================================================
  // 4. MINERALIZATION FRONT — the physics of HA nucleation
  // =========================================================================
  subgraph cluster_mineral {
    label="4. Mineralization Front — supersaturation × competitive inhibition (WHERE THE DISEASE HAPPENS)";
    style=filled; color="#c9e8d8"; fillcolor="#edfbf3";
    Ca_local [label="Local Ca2+ activity"];
    Pi_local [label="Local Pi activity\n(from PHOSPHO1, Pi transport,\nAND from PPi hydrolysis)"];
    SSAT [label="SUPERSATURATION\nS = (Ca x Pi)/Ksp\ndriving force for nucleation", fillcolor="#a8e0c0"];
    HA_nucleation [label="Hydroxyapatite NUCLEATION\nCa10(PO4)6(OH)2\ninside matrix vesicle", fillcolor="#a8e0c0"];
    HA_growth [label="HA crystal GROWTH &\npropagation onto collagen", fillcolor="#a8e0c0"];
    Coll_scaffold [label="Type I collagen scaffold\n(gap regions = nucleation sites)"];
    MINH [label="INHIBITION FACTOR\nMINH = 1/(1 + PPi/Ki + BP/Kbp + OPN/Kopn)\nKi(PPi) ~ 4 uM", fillcolor="#ff9999"];
    MAR [label="MINERAL APPOSITION RATE\nMAR = kmin x OB x MINH x S^n", fillcolor="#7fd4a6"];
    Osteoid [label="UNMINERALIZED OSTEOID\n(osteoid volume/thickness ↑)\n= OSTEOMALACIA", fillcolor="#ffd9d9"];
    Mineralized_bone [label="MINERALIZED MATRIX\n(BMC / cortical thickness)", fillcolor="#7fd4a6"];
    Threshold_box [label="CLOSED FORM (see README):\nMrel(E) = (1+P0/Ki) / (1 + Jppi/(Ki(kcat·E + kout)))\nHYPERBOLA in E → sharp toe →\nDISEASE IS A THRESHOLD IN ENZYME ACTIVITY", shape=note, fillcolor="#fff3c4"];
    Ca_local -> SSAT; Pi_local -> SSAT;
    PPi_hydro -> Pi_local [label="+2 Pi per PPi", color="blue"];
    PPi_loc -> MINH [label="− competitive\ninhibitor", color="red", penwidth=2];
    OPN_PPi -> MINH [label="−", color="red"];
    SSAT -> HA_nucleation -> HA_growth;
    MINH -> HA_nucleation [color="red", penwidth=2];
    MINH -> MAR [penwidth=2];
    SSAT -> MAR; Coll_scaffold -> HA_growth -> MAR;
    MAR -> Mineralized_bone [penwidth=2];
    MAR -> Osteoid [label="− (osteoid consumed\nby mineralization)"];
    Threshold_box -> MAR [style=dotted];
  }

  // =========================================================================
  // 5. GROWTH PLATE & ENDOCHONDRAL OSSIFICATION
  // =========================================================================
  subgraph cluster_growthplate {
    label="5. Growth Plate — endochondral ossification failure = RICKETS (partly IRREVERSIBLE)";
    style=filled; color="#e8dcc9"; fillcolor="#fbf6ec";
    GP_reserve [label="Resting / proliferative zone\nchondrocytes"];
    GP_hyper [label="HYPERTROPHIC ZONE\n(TNSALP-rich, MV-secreting)", fillcolor="#f0e2c8"];
    GP_calc [label="Zone of provisional\nCALCIFICATION"];
    GP_vasc [label="Vascular invasion &\nprimary spongiosa formation"];
    GP_widen [label="HYPERTROPHIC ZONE WIDENING\n(unmineralized cartilage\naccumulates)", fillcolor="#ffd9d9"];
    GP_tongue [label="Metaphyseal 'TONGUES' of\nradiolucency (HPP-specific)", fillcolor="#ffd9d9"];
    GP_integrity [label="GROWTH-PLATE INTEGRITY\nGP ∈ [0,1]  (reversible part)", fillcolor="#f0e2c8"];
    GP_irrev [label="IRREVERSIBLE architectural\ndamage GPdmg (accumulates\nwhile plate is active)", fillcolor="#ff9999"];
    Growth_vel [label="LINEAR GROWTH VELOCITY\n∝ GP x (1 − GPdmg)"];
    Bowing [label="Bowing deformity,\ngenu varum/valgum,\nrachitic rosary"];
    Fusion_age [label="Physis closure (~16-18 y)\n→ after this, no rescue\nof lost stature", shape=note, fillcolor="#fff3c4"];
    GP_reserve -> GP_hyper -> GP_calc -> GP_vasc;
    MINH -> GP_calc [label="− (same PPi block)", color="red", penwidth=2];
    GP_calc -> GP_widen [label="failure →"];
    GP_widen -> GP_tongue; GP_widen -> GP_integrity [label="−"];
    GP_integrity -> Growth_vel; GP_irrev -> Growth_vel [label="−", color="red"];
    GP_widen -> GP_irrev [label="+ (rate ∝ time spent\nunmineralized)", color="red"];
    GP_widen -> Bowing;
    Fusion_age -> GP_irrev [style=dotted];
    GP_hyper -> MV_membrane [style=dotted, label="secretes MV"];
  }

  // =========================================================================
  // 6. BONE REMODELLING
  // =========================================================================
  subgraph cluster_remodel {
    label="6. Bone Remodelling — osteoblast pool also SETS ENDOGENOUS ENZYME (self-amplifying loop)";
    style=filled; color="#c9d8e8"; fillcolor="#eef4fa";
    MSC [label="Mesenchymal stem cell"];
    OB_pool [label="OSTEOBLAST POOL (OB)\nRUNX2/OSX-driven", fillcolor="#cfe4f7"];
    Osteocyte [label="Osteocyte network\n(mechanosensing)"];
    OC_pool [label="OSTEOCLAST POOL (OC)\nresorption", fillcolor="#ffd9d9"];
    RANKL_OPG [label="RANKL / OPG ratio"];
    Sclerostin [label="Sclerostin (SOST)\n→ Wnt inhibition"];
    Wnt_bcat [label="Wnt / beta-catenin\nanabolic signalling"];
    PTH1R_ob [label="PTH1R on osteoblast\n(intermittent PTH = anabolic)"];
    BTM [label="Bone turnover markers\nP1NP / CTX / BSAP\n(BSAP LOW in HPP)"];
    Endo_enzyme [label="ENDOGENOUS ENZYME SUPPLY\nE_endo = fracEnz x OB\n→ MORE OB = MORE TNSALP", fillcolor="#ffe9b3"];
    Fx_burden [label="FRACTURES / PSEUDOFRACTURES\nmetatarsal stress fx,\nsubtrochanteric femoral\n(Looser zones)", fillcolor="#ffd9d9"];
    Healing [label="Delayed / non-union\nfracture healing"];
    MSC -> OB_pool -> Osteocyte;
    OB_pool -> MAR [penwidth=2];
    OB_pool -> Endo_enzyme -> Enz_local [color="darkgreen", penwidth=2, label="+ self-amplifying"];
    RANKL_OPG -> OC_pool; Osteocyte -> RANKL_OPG; Osteocyte -> Sclerostin -> Wnt_bcat [label="−"];
    Wnt_bcat -> OB_pool [label="+"]; PTH1R_ob -> OB_pool [label="+ (intermittent)"];
    OC_pool -> Mineralized_bone [label="− resorption"];
    OB_pool -> BTM; Enz_plasma -> BTM [style=dotted, label="BSAP low"];
    Osteoid -> Fx_burden [label="+ osteomalacic bone\nis mechanically weak", color="red"];
    Mineralized_bone -> Fx_burden [label="−"];
    Fx_burden -> Healing;
  }

  // =========================================================================
  // 7. MINERAL / ENDOCRINE HOMEOSTASIS
  // =========================================================================
  subgraph cluster_endocrine {
    label="7. Systemic Mineral Homeostasis — mineral NOT deposited stays in serum (paradoxical hypercalcaemia)";
    style=filled; color="#e8c9dc"; fillcolor="#fbeef5";
    Ca_intake [label="Dietary Ca / vitamin D\nintake (infant formula, supplements)"];
    Gut_Ca [label="Intestinal Ca absorption\n(1,25D-dependent, TRPV6)"];
    Ca_serum [label="SERUM Ca [mmol/L]\nHIGH in infantile HPP", fillcolor="#f5cfe4"];
    Pi_serum [label="SERUM Pi [mmol/L]\nHIGH (suppressed PTH →\nhigh TmP/GFR)", fillcolor="#f5cfe4"];
    PTH_gland [label="PARATHYROID PTH\nSUPPRESSED (feedback\nfrom hypercalcaemia)", fillcolor="#f5cfe4"];
    CaSR [label="CaSR sensing"];
    D1alpha [label="Renal 1-alpha-hydroxylase\n→ 1,25(OH)2D"];
    D125 [label="1,25(OH)2D"];
    FGF23_ax [label="FGF23 / Klotho axis\n(normal-low in HPP;\ncontrast with XLH)"];
    Renal_Ca [label="Renal Ca reabsorption\n(PTH-dependent)"];
    Ca_urine [label="HYPERCALCIURIA\n(Ca/creat ↑)", fillcolor="#ffd9d9"];
    Pi_urine [label="Urinary Pi handling\n(NaPi-2a/2c)"];
    Nephrocalcinosis [label="NEPHROCALCINOSIS\nmedullary Ca deposition", fillcolor="#ffd9d9"];
    CKD_prog [label="CKD progression\n(eGFR ↓, long-term)"];
    Ca_intake -> Gut_Ca; D125 -> Gut_Ca [label="+"]; Gut_Ca -> Ca_serum;
    MAR -> Ca_serum [label="− (Ca sink;\nlost when MAR ↓)", color="red", penwidth=2];
    MAR -> Pi_serum [label="− (Pi sink)", color="red"];
    Ca_serum -> CaSR -> PTH_gland [label="−"];
    PTH_gland -> Renal_Ca [label="+"]; PTH_gland -> D1alpha [label="+"] ; D1alpha -> D125;
    PTH_gland -> Pi_urine [label="+ phosphaturia"];
    Pi_urine -> Pi_serum [label="−"];
    Renal_Ca -> Ca_urine [label="−"]; Ca_serum -> Ca_urine [label="+ filtered load"];
    Ca_urine -> Nephrocalcinosis -> CKD_prog;
    Ca_serum -> SSAT [style=dashed]; Pi_serum -> SSAT [style=dashed];
    Ca_serum -> Ca_local [style=dotted]; Pi_serum -> Pi_local [style=dotted];
    FGF23_ax -> Pi_serum [style=dotted];
  }

  // =========================================================================
  // 8. VITAMIN B6 / CNS
  // =========================================================================
  subgraph cluster_b6 {
    label="8. Vitamin B6 / CNS — HIGH plasma PLP but LOW brain cofactor: substrate excess = product deficiency";
    style=filled; color="#d8c9e8"; fillcolor="#f4eefb";
    Diet_B6 [label="Dietary vitamin B6\n(pyridoxine, PN)"];
    PLP_liver [label="Hepatic PLP synthesis\n(PDXK, PNPO)"];
    PLP_plasma [label="PLASMA PLP [nM]\nnormal ~30-110; HPP 300-1500\n(PRIMARY PD MARKER)", fillcolor="#e3d1f5"];
    BBB_dephos [label="BBB / neuronal TNSALP\nDEPHOSPHORYLATES PLP → PL\n(PLP CANNOT cross the BBB)", fillcolor="#ffd9d9"];
    PL_brain [label="BRAIN PYRIDOXAL (PL)\n→ re-phosphorylated to PLP\nintracellularly", fillcolor="#e3d1f5"];
    Brain_PLP [label="BRAIN PLP COFACTOR POOL\nLOW despite HIGH plasma PLP", fillcolor="#ff9999"];
    GAD [label="GAD65/67 (PLP-dependent)\nglutamate → GABA"];
    GABA_tone [label="CNS GABA tone", fillcolor="#e3d1f5"];
    Seizures [label="PYRIDOXINE-RESPONSIVE\nSEIZURES (perinatal/infantile,\nmarker of lethality)", fillcolor="#ff9999"];
    Encephalopathy [label="Encephalopathy,\napnoea, EEG burst-suppression"];
    PN_bypass [label="PYRIDOXINE (PN) THERAPY\nnon-phosphorylated → crosses BBB\n→ bypasses the TNSALP step", fillcolor="#c9e8d8"];
    Other_PLP [label="Other PLP enzymes:\nSHMT, AAT, ALAS2, CBS,\nDDC (dopamine/serotonin)"];
    Diet_B6 -> PLP_liver -> PLP_plasma;
    Enz_plasma -> PLP_plasma [label="− hydrolysis", color="blue", penwidth=2];
    PLP_plasma -> BBB_dephos; Neuro_TNSALP -> BBB_dephos [color="blue", penwidth=2];
    BBB_dephos -> PL_brain -> Brain_PLP -> GAD -> GABA_tone;
    GABA_tone -> Seizures [label="− (low GABA →\nseizure)", color="red", penwidth=2];
    Seizures -> Encephalopathy;
    Diet_B6 -> PN_bypass [style=dotted];
    PN_bypass -> PL_brain [color="darkgreen", penwidth=2, label="+ bypass"];
    Brain_PLP -> Other_PLP [style=dotted];
  }

  // =========================================================================
  // 9. DENTAL / PERIODONTAL
  // =========================================================================
  subgraph cluster_dental {
    label="9. Dental — acellular cementum is the most PPi-sensitive mineralized tissue (earliest sign)";
    style=filled; color="#e8e0c9"; fillcolor="#fbf9ec";
    Cementoblast [label="Cementoblasts\n(TNSALP-dependent)"];
    Acell_cementum [label="ACELLULAR CEMENTUM\nformation (thin, PPi-sensitive)", fillcolor="#f0e2c8"];
    PDL_attach [label="Periodontal ligament\nSharpey fibre attachment", fillcolor="#f0e2c8"];
    Tooth_loss [label="PREMATURE LOSS OF\nDECIDUOUS TEETH (<5 y,\nroots intact) = odonto-HPP", fillcolor="#ff9999"];
    Enamel_dentin [label="Enamel hypoplasia,\nenlarged pulp chambers,\ndentin defects"];
    Adult_perio [label="Adult periodontitis,\nalveolar bone loss"];
    Cementoblast -> Acell_cementum -> PDL_attach;
    MINH -> Acell_cementum [label="− (highest sensitivity)", color="red", penwidth=2];
    PDL_attach -> Tooth_loss [label="−"];
    Acell_cementum -> Enamel_dentin [style=dotted];
    PDL_attach -> Adult_perio [label="−"];
  }

  // =========================================================================
  // 10. CRANIOFACIAL
  // =========================================================================
  subgraph cluster_cranio {
    label="10. Craniofacial — CRANIOSYNOSTOSIS: poorly treatment-responsive, an honest gap in the model";
    style=filled; color="#e8d8c9"; fillcolor="#fbf3ec";
    Skull_min [label="Calvarial membranous\nossification (no growth plate)"];
    Suture [label="Cranial suture patency\n(functional 'growth plate' of skull)"];
    Craniosynostosis [label="CRANIOSYNOSTOSIS\n(up to ~40-60% of infantile HPP)", fillcolor="#ffd9d9"];
    ICP [label="Raised intracranial pressure,\npapilloedema"];
    Chiari [label="Chiari I malformation,\nsyringomyelia"];
    Skull_soft [label="Craniotabes / wide fontanelle\n(paradoxical coexistence with\nsuture fusion)"];
    Surgery_cranio [label="Cranial vault expansion\n(surgical; ERT does not\nreliably prevent)", fillcolor="#c9e8d8"];
    Skull_min -> Suture -> Craniosynostosis -> ICP -> Chiari;
    MINH -> Skull_min [label="−", color="red"];
    Skull_min -> Skull_soft;
    Craniosynostosis -> Surgery_cranio [style=dashed];
  }

  // =========================================================================
  // 11. MUSCLE, PAIN, MOBILITY
  // =========================================================================
  subgraph cluster_muscle {
    label="11. Muscle · Pain · Mobility — the endpoints adults actually feel (6MWT, BOT-2, PROs)";
    style=filled; color="#c9e8e8"; fillcolor="#edfbfb";
    Myopathy [label="Proximal myopathy\n(muscle weakness, hypotonia)", fillcolor="#b3e0e0"];
    Myopathy_mech [label="Mechanisms: PLP/B6 disturbance,\nbone pain disuse, ?direct ALP role,\nCa/Pi flux abnormality"];
    Bone_pain [label="CHRONIC BONE / JOINT PAIN\n(osteomalacic, periosteal)", fillcolor="#ffd9d9"];
    Pyro_arthro [label="PPi-driven CPPD /\npseudogout, calcific periarthritis\n(PPi excess crystallises!)", fillcolor="#ffd9d9"];
    Gait [label="Waddling gait,\ndelayed walking, gross-motor delay"];
    SixMWT [label="6-MINUTE WALK TEST\n(% predicted) — key adult endpoint", fillcolor="#b3e0e0"];
    BOT2 [label="BOT-2 strength & agility\n(paediatric endpoint)", fillcolor="#b3e0e0"];
    HAQ_SF36 [label="PROs: SF-36 PF, HAQ,\nBPI-SF pain severity"];
    Wheelchair [label="Assistive-device / wheelchair\ndependence"];
    Myopathy_mech -> Myopathy;
    Osteoid -> Bone_pain [label="+"]; Fx_burden -> Bone_pain [label="+"];
    PPi_loc -> Pyro_arthro [label="+ crystal formation", color="red"];
    Myopathy -> Gait; Bone_pain -> Gait;
    Gait -> SixMWT [label="−"]; Myopathy -> SixMWT [label="−"]; Myopathy -> BOT2 [label="−"];
    Bone_pain -> HAQ_SF36 [label="−"]; SixMWT -> Wheelchair [label="−"];
    Brain_PLP -> Myopathy_mech [style=dotted];
  }

  // =========================================================================
  // 12. RESPIRATORY / PERINATAL LETHALITY
  // =========================================================================
  subgraph cluster_resp {
    label="12. Respiratory — the proximate cause of death in perinatal/infantile HPP";
    style=filled; color="#f0d8c9"; fillcolor="#fdf2ec";
    Rib_min [label="Rib / thoracic cage\nmineralization", fillcolor="#f5cfb3"];
    Rachitic_chest [label="RACHITIC CHEST:\nsoft ribs, narrow thorax,\nrib fractures, flail segments", fillcolor="#ffd9d9"];
    Chest_compl [label="Chest-wall compliance ↑↑\n(paradoxical inward motion)"];
    Hypoplasia [label="Secondary pulmonary\nhypoplasia (perinatal form)"];
    Resp_fn [label="RESPIRATORY FUNCTION INDEX\n(oxygenation, work of breathing)", fillcolor="#f5cfb3"];
    Vent_support [label="INVASIVE VENTILATION\nDEPENDENCE\n(key trial endpoint)", fillcolor="#ff9999"];
    Pneumonia [label="Recurrent pneumonia,\natelectasis"];
    Mortality [label="MORTALITY\nuntreated perinatal ~100%;\nuntreated infantile ~50-73% at 1 y", fillcolor="#ff9999"];
    MINH -> Rib_min [label="−", color="red", penwidth=2];
    Rib_min -> Rachitic_chest [label="−"]; Rachitic_chest -> Chest_compl -> Resp_fn [label="−"];
    Hypoplasia -> Resp_fn [label="−"]; Myopathy -> Resp_fn [label="− (diaphragm)"];
    Resp_fn -> Vent_support [label="− (threshold)", color="red"];
    Resp_fn -> Pneumonia; Vent_support -> Mortality; Seizures -> Mortality [label="+"];
    Pneumonia -> Mortality;
  }

  // =========================================================================
  // 13. DRUG 1 — ASFOTASE ALFA PK & BONE TARGETING
  // =========================================================================
  subgraph cluster_pk {
    label="13. Asfotase alfa PK — sTNSALP-Fc-D10: the deca-aspartate motif is the WHOLE point";
    style=filled; color="#c9e8d8"; fillcolor="#e9f9f0";
    Dose_SC [label="ASFOTASE ALFA SC DOSE\n2 mg/kg 3x/week  OR\n1 mg/kg 6x/week  (3 mg/kg TIW if\ninsufficient response)", fillcolor="#7fd4a6"];
    Depot [label="SC depot (A_SC)\nka ~ 1.2 /d, F ~ 0.46,\ntmax 24-48 h", fillcolor="#a8e0c0"];
    Plasma_drug [label="PLASMA ENZYME (A_C)\nt1/2 ~ 2.3 d\n→ serum ALP thousands of U/L", fillcolor="#a8e0c0"];
    D10_motif [label="DECA-ASPARTATE (D10) TAG\nbinds HYDROXYAPATITE\nwith high avidity", fillcolor="#7fd4a6"];
    Bone_bound [label="HA-BOUND ENZYME (E_B)\nCAPACITY-LIMITED (Bmax),\nlong residence (t1/2 ~ 2 wk)\n= THE EFFECT COMPARTMENT", fillcolor="#7fd4a6"];
    Fc_domain [label="Fc domain\n(purification, half-life,\nFcRn recycling)"];
    Clearance [label="Proteolytic clearance,\nRES uptake"];
    ADA [label="ANTI-DRUG ANTIBODIES\n(most patients seroconvert;\nneutralising subset ↑ CL)", fillcolor="#ffd9d9"];
    ISR [label="Injection-site reactions,\nlipohypertrophy (~70%)"];
    Ectopic_calc [label="ECTOPIC CALCIFICATION\n(ocular/conjunctival, renal)\n= over-suppression risk", fillcolor="#ffd9d9"];
    Efzim [label="EFZIMFOTASE ALFA (ALXN1850)\n2nd-gen: higher potency,\nlonger t1/2, once-weekly", fillcolor="#a8e0c0"];
    Bmax_sat [label="Bone binding SATURATION\n→ diminishing returns above\n~6 mg/kg/week", shape=note, fillcolor="#fff3c4"];
    Dose_SC -> Depot -> Plasma_drug;
    Plasma_drug -> Clearance; ADA -> Clearance [label="+ (CL x (1+g·ADA))", color="red"];
    Plasma_drug -> ADA [label="+ exposure-driven"];
    D10_motif -> Bone_bound; Plasma_drug -> Bone_bound [label="kon x (Bmax − E_B)", penwidth=2];
    Fc_domain -> Plasma_drug [style=dotted];
    Bone_bound -> Enz_local [color="darkgreen", penwidth=3, label="THE causal path"];
    Plasma_drug -> Enz_plasma [color="darkgreen", penwidth=2, label="the MEASURED path"];
    Dose_SC -> ISR [style=dashed];
    Bone_bound -> Ectopic_calc [style=dashed];
    Efzim -> Plasma_drug [style=dashed, label="alternative"];
    Bmax_sat -> Bone_bound [style=dotted];
    Mineralized_bone -> Bmax_sat [style=dotted, label="HA surface = binding sites"];
  }

  // =========================================================================
  // 14. OTHER THERAPEUTICS (incl. one that makes things worse)
  // =========================================================================
  subgraph cluster_drugs2 {
    label="14. Other Therapeutics — and the ONE mechanistic contraindication";
    style=filled; color="#d8e8c9"; fillcolor="#f2fbec";
    Teriparatide [label="TERIPARATIDE (PTH 1-34)\nintermittent → OB expansion\n→ MORE endogenous TNSALP\n(adult HPP, off-label)", fillcolor="#c9e8a8"];
    NSAID [label="NSAIDs\nsymptomatic pain / CPPD flare", fillcolor="#c9e8a8"];
    Bisphosphonate [label="BISPHOSPHONATES\n= NON-HYDROLYSABLE PPi ANALOGUES\nbone t1/2 YEARS → PERMANENT\nADDITION TO INHIBITOR POOL", fillcolor="#ff6666", fontcolor="white"];
    Denosumab [label="Denosumab\n(also inappropriate: no\nmineralization benefit)", fillcolor="#ffd9d9"];
    Ca_vitD_mgmt [label="Ca / vitamin-D RESTRICTION\nin infantile hypercalcaemia\n(counter-intuitive but correct)", fillcolor="#c9e8a8"];
    Thiazide_avoid [label="Loop diuretic / hydration\nfor hypercalciuria"];
    Pyridoxine_tx [label="PYRIDOXINE (high-dose)\nfor B6-responsive seizures", fillcolor="#c9e8a8"];
    Gene_tx [label="GENE THERAPY (preclinical):\nAAV8-TNALP-D10, ex-vivo\nlentiviral BM transplant", fillcolor="#c9e8a8"];
    Ortho [label="Orthopaedic: intramedullary\nrods/load-sharing (NOT plates)"];
    PT_OT [label="Physiotherapy, ventilation\nsupport, dental care,\nmultidisciplinary MDT"];
    Teriparatide -> OB_pool [label="+", color="darkgreen", penwidth=2];
    Bisphosphonate -> MINH [label="+ INHIBITION\n(worsens osteomalacia,\natypical femoral fx)", color="red", penwidth=3];
    Bisphosphonate -> OC_pool [label="−"];
    Denosumab -> OC_pool [label="−"];
    NSAID -> Bone_pain [label="−"]; NSAID -> Pyro_arthro [label="−"];
    Ca_vitD_mgmt -> Ca_intake [label="−", color="darkgreen"];
    Thiazide_avoid -> Ca_urine [label="−"];
    Pyridoxine_tx -> PN_bypass [color="darkgreen", penwidth=2];
    Gene_tx -> Enz_local [style=dashed, color="darkgreen"];
    Ortho -> Fx_burden [label="−", style=dashed];
    PT_OT -> SixMWT [label="+", style=dashed];
  }

  // =========================================================================
  // 15. CLINICAL ENDPOINTS & TRIAL READOUTS
  // =========================================================================
  subgraph cluster_endpoints {
    label="15. Clinical Endpoints & Regulatory Readouts (what the label was built on)";
    style=filled; color="#e8c9c9"; fillcolor="#fbeeee";
    RSS [label="RSS (Thacher Rickets\nSeverity Score, 0-10)\nradiographic, LAGS by weeks", fillcolor="#f5b3b3"];
    RGI_C [label="RGI-C (Radiographic Global\nImpression of Change, -3..+3)\nvalidated HPP endpoint", fillcolor="#f5b3b3"];
    Height_Z [label="HEIGHT / LENGTH Z-SCORE\n(growth recovery, catch-up)", fillcolor="#f5b3b3"];
    Survival_ep [label="OVERALL SURVIVAL\n(treated ~95% at 1 y vs\n~42-73% historical control)", fillcolor="#f5b3b3"];
    VFS [label="Ventilator-free survival"];
    ALP_lab [label="Serum ALP ACTIVITY\n(low untreated; supraphysiologic\non ERT — a DOSE marker,\nNOT an effect marker)", fillcolor="#ffe9b3"];
    PLP_lab [label="Plasma PLP\n(normalises within WEEKS,\nthen SATURATES)", fillcolor="#ffe9b3"];
    PPi_lab [label="Plasma / urine PPi\n(normalises; small dynamic range)", fillcolor="#ffe9b3"];
    PEA_lab [label="Plasma / urine PEA"];
    DXA_note [label="DXA aBMD:\nLIMITED utility in paediatric HPP\n(confounded by size/deformity)", shape=note, fillcolor="#fff3c4"];
    QoL [label="QoL: PedsQL, SF-36,\nPOSNA-PODCI"];
    Dissoc_box [label="THE DISSOCIATION (model prediction):\nPLP is ~fully normalised at a dose that leaves\nRSS/growth-plate response far from maximal →\nbiochemical normalisation does NOT license\nde-escalation", shape=note, fillcolor="#ffcccc"];
    GP_integrity -> RSS [label="−"]; RSS -> RGI_C [style=dotted];
    Growth_vel -> Height_Z; GP_irrev -> Height_Z [label="− permanent floor", color="red"];
    Mortality -> Survival_ep; Vent_support -> VFS;
    Enz_plasma -> ALP_lab; PLP_plasma -> PLP_lab; PPi_plasma -> PPi_lab; PEA -> PEA_lab;
    Mineralized_bone -> DXA_note [style=dotted];
    HAQ_SF36 -> QoL; SixMWT -> QoL;
    PLP_lab -> Dissoc_box [style=dotted]; RSS -> Dissoc_box [style=dotted];
  }

  // =========================================================================
  // 16. MODEL STRUCTURE / THESIS
  // =========================================================================
  subgraph cluster_thesis {
    label="16. QSP Model Structure — 36 ODE states, 14 scenarios";
    style=filled; color="#c9c9e8"; fillcolor="#eeeefb";
    Thesis1 [label="THESIS 1 — THRESHOLD, NOT GRADIENT\nBecause PPi clearance is ∝ E, PPi ∝ 1/E, and\nmineralization ∝ 1/(1+PPi/Ki) → a hyperbola in E.\nThe clinical severity spectrum is one hyperbola,\nnot five separate diseases.", shape=note, fillcolor="#d4d4f5"];
    Thesis2 [label="THESIS 2 — WRONG COMPARTMENT\nPLP and plasma PPi are hydrolysed by PLASMA enzyme;\nmineralization needs HA-BOUND enzyme. Bone binding\nis capacity-limited → the markers saturate BEFORE\nthe skeleton does.", shape=note, fillcolor="#d4d4f5"];
    Thesis3 [label="THESIS 3 — TWO CLOCKS\nOsteomalacia (reversible, PPi-driven, weeks-months)\nvs growth-plate architecture + craniosynostosis\n(irreversible, accrues while untreated)\n→ time-to-treatment has a PERMANENT cost.", shape=note, fillcolor="#d4d4f5"];
    Thesis4 [label="THESIS 4 — AN ANTIRESORPTIVE IS A POISON HERE\nBisphosphonate = non-hydrolysable PPi analogue with\na bone half-life of years: it enters the same Ki term\nthat the disease is already saturating.", shape=note, fillcolor="#ffcccc"];
    Thesis5 [label="THESIS 5 — FRACTIONATION IS NEARLY IRRELEVANT\nThe HA-bound pool has a ~2-week residence time and\nbuffers dosing interval; TOTAL WEEKLY DOSE and\nBmax dominate. 2 mg/kg TIW ≈ 1 mg/kg 6x/wk.", shape=note, fillcolor="#d4d4f5"];
    Thesis1 -> Thesis2 -> Thesis3 -> Thesis4 -> Thesis5 [style=invis];
  }

  // =========================================================================
  // CROSS-CLUSTER INTEGRATION
  // =========================================================================
  Genotype_activity -> Endo_enzyme [style=dashed];
  Enz_local -> MINH [style=invis];
  Osteoid -> RSS [style=dashed, label="osteomalacia\ncomponent"];
  MAR -> GP_calc [style=dashed];
  Ca_serum -> Nephrocalcinosis [style=dashed];
  Bone_bound -> PPi_hydro [color="darkgreen", style=bold];
  Plasma_drug -> PLP_plasma [color="darkgreen", label="fast, saturating"];
  Threshold_box -> Thesis1 [style=dotted];
  Dissoc_box -> Thesis2 [style=dotted];
  GP_irrev -> Thesis3 [style=dotted];
  Bisphosphonate -> Thesis4 [style=dotted];
  Bone_bound -> Thesis5 [style=dotted];
  Var_domneg -> Carrier [style=dashed, label="explains symptomatic\nheterozygotes"];
  Myopathy -> Vent_support [style=dashed];
  Tooth_loss -> Var_mild [style=dotted, label="defining feature\nof odonto-HPP"];
  Nephrocalcinosis -> Enz_plasma [style=invis];
}
