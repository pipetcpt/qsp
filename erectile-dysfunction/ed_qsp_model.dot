    O_impl  [label="Penile prosthesis\n(bypasses the entire model)" fillcolor="#B2EBF2" color="#006064"]
    O_life  [label="Lifestyle: exercise · weight loss\nsmoking cessation · statin" fillcolor="#C5E1A5" color="#33691E"]
    O_psych [label="Sex therapy / CBT\n(acts on PA directly)" fillcolor="#C5E1A5" color="#33691E"]
