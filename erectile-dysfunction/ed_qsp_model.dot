  //=========================================================
  // The three theses, as legend nodes
  //=========================================================
  subgraph cluster_legend {
    label="📐 The three structural statements this model makes computable"
    style=filled fillcolor="#FFFFFF" color="#37474F" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    L1 [shape=note fillcolor="#ECEFF1" color="#37474F" label="① GAIN × ZERO = ZERO.\nPDE5 inhibitors add no NO; they divide PDE5 activity by (1 + Cu/IC50).\nThe SAME unbound exposure that takes a vasculogenic patient from\nICP 34 → 62 mmHg takes a non-nerve-spared patient from 5.7 → 5.7."]
    L2 [shape=note fillcolor="#ECEFF1" color="#37474F" label="② TWO CLOCKS, ONE DRUG.\nOn-demand dosing acts through cGMP (minutes, washes out with the drug).\nOnce-daily dosing additionally acts through SMI (weeks, survives washout).\nProtecting structure cannot restore erection while the NEURAL input is limiting."]
    L3 [shape=note fillcolor="#ECEFF1" color="#37474F" label="③ THE SAME PRODUCT, TWO BEDS.\nCavernosal efficacy and systemic hypotension are the same two-factor\nproduct (NO source × PDE5 inhibition) evaluated in different vessels.\nThe nitrate contraindication is therefore structural, not idiosyncratic."]
  }
}
