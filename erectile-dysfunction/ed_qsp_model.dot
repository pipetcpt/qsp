    K_cyp   [label="CYP3A4 / CYP2C9\nketoconazole ↑ · rifampicin ↓" fillcolor="#C5CAE9" color="#1A237E"]
    K_plasm [label="Plasma concentration  C_p" fillcolor="#9FA8DA" color="#1A237E"]
    K_bind  [label="Plasma protein binding\nfu 0.01–0.06" fillcolor="#C5CAE9" color="#1A237E"]
    K_free  [label="UNBOUND concentration  Cu (nM)\nthe only quantity the enzyme sees" fillcolor="#7986CB" color="#1A237E" fontcolor="white"]
    K_sil   [label="Sildenafil 100 mg\nCu 32.6 nM · Cu/IC50 9.3 · t½ 4.4 h" fillcolor="#C5CAE9" color="#1A237E"]
    K_tad   [label="Tadalafil 20 mg\nCu 55 nM · Cu/IC50 30.6 · t½ 16.8 h" fillcolor="#C5CAE9" color="#1A237E"]
    K_var   [label="Vardenafil 20 mg\nCu 2.0 nM · Cu/IC50 14.4 · t½ 5.0 h" fillcolor="#C5CAE9" color="#1A237E"]
    K_ava   [label="Avanafil 200 mg\nCu 107 nM · Cu/IC50 20.6 · t½ 4.9 h" fillcolor="#C5CAE9" color="#1A237E"]
    K_tadd  [label="Tadalafil 5 mg ONCE-DAILY\ncontinuous Cu — the SLOW arm" fillcolor="#9FA8DA" color="#1A237E"]
    K_p6    [label="PDE6 (retina)\nsildenafil ratio ≈ 10 → cyanopsia" fillcolor="#FFCDD2" color="#B71C1C"]
    K_p11   [label="PDE11A (skeletal muscle)\ntadalafil ratio ≈ 20 → myalgia" fillcolor="#FFCDD2" color="#B71C1C"]
  }

