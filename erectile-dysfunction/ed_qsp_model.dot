digraph ED_QSP_Model {
  graph [
    label=<<B>Erectile Dysfunction (ED) — QSP Mechanistic Map</B><BR/><FONT POINT-SIZE="14">Erection is a <B>threshold read on a saturating amplifier</B>: a nitrergic NO <I>pulse</I> is amplified by cGMP gain, converted to smooth-muscle relaxation, and then read out by a<BR/>veno-occlusive mechanism that only engages above a critical sinusoidal expansion. PDE5 inhibitors supply <B>no NO</B> — they multiply the gain on whatever pulse arrives.<BR/>Multiplying a pulse that is 40× too small still lands below threshold, which is why the same drug at the same exposure cures one patient and does nothing for the next.</FONT>>
    labelloc=t fontsize=22 fontname="Helvetica"
    rankdir=LR bgcolor="#F7F8FA"
    splines=spline nodesep=0.30 ranksep=1.00
    newrank=true compound=true
  ]
  node [fontname="Helvetica" fontsize=10 style="filled,rounded" shape=box margin="0.14,0.05"]
  edge [fontname="Helvetica" fontsize=8 arrowsize=0.65 color="#5A6270"]

  //=========================================================
  // CLUSTER 1 — central and spinal control
  //=========================================================
  subgraph cluster_cns {
    label="🧠 Central & Spinal Control of Erection (the pulse generator)"
    style=filled fillcolor="#EDE7F6" color="#4527A0" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    C_vis   [label="Visual / tactile / fantasy\nerotic stimulus" fillcolor="#D1C4E9" color="#4527A0"]
    C_mpoa  [label="Medial preoptic area (MPOA)\npro-erectile integrator" fillcolor="#D1C4E9" color="#4527A0"]
    C_pvn   [label="Paraventricular nucleus (PVN)\noxytocinergic projection" fillcolor="#D1C4E9" color="#4527A0"]
    C_da    [label="Dopamine → D2/D4\n(apomorphine acts here)" fillcolor="#B39DDB" color="#311B92"]
    C_oxt   [label="Oxytocin → OXTR\nspinal pro-erectile" fillcolor="#D1C4E9" color="#4527A0"]
    C_mc4   [label="Melanocortin MC4R\n(bremelanotide axis)" fillcolor="#D1C4E9" color="#4527A0"]
    C_5ht   [label="5-HT (5-HT2C ↑ / 5-HT1A ↓)\nSSRI-mediated inhibition" fillcolor="#CE93D8" color="#4A148C"]
    C_npgi  [label="Nucleus paragigantocellularis\nDESCENDING INHIBITION" fillcolor="#CE93D8" color="#4A148C"]
    C_gen   [label="Spinal erection generator\nL3–L4 lumbar spinothalamic" fillcolor="#B39DDB" color="#311B92"]
    C_para  [label="Sacral parasympathetic S2–S4\npelvic nerve → cavernous nerve" fillcolor="#9575CD" color="#311B92" fontcolor="white"]
    C_symp  [label="Thoracolumbar sympathetic T11–L2\nhypogastric → antierectile" fillcolor="#CE93D8" color="#4A148C"]
    C_pud   [label="Pudendal somatic (S2–S4)\nischio/bulbocavernosus\n→ RIGID phase" fillcolor="#D1C4E9" color="#4527A0"]
    C_arou  [label="AROUSAL capacity  AROU\n★ state variable" shape=diamond fillcolor="#7E57C2" color="#311B92" fontcolor="white"]
    C_S     [label="Stimulation input  S(t)\nattempt bout + nocturnal (NPT)" shape=diamond fillcolor="#7E57C2" color="#311B92" fontcolor="white"]
  }

  //=========================================================
  // CLUSTER 2 — nitrergic (NANC) nerve terminal
  //=========================================================
  subgraph cluster_nanc {
    label="⚡ NANC Nerve Terminal — the NO PULSE (initiation)"
    style=filled fillcolor="#E8F5E9" color="#1B5E20" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    N_nrv   [label="Cavernous nerve integrity  NRV\n(0–1; 0.10 immediately post-RP)" fillcolor="#A5D6A7" color="#1B5E20"]
    N_nnos  [label="nNOS (NOS1) expression\nnerve-terminal density" fillcolor="#A5D6A7" color="#1B5E20"]
    N_ca    [label="Terminal Ca²⁺ influx\n(N-type VDCC)" fillcolor="#C8E6C9" color="#1B5E20"]
    N_no1   [label="NO pulse (nitrergic)\n★ INITIATION\nhealthy peak ≈ 20 nM" fillcolor="#66BB6A" color="#1B5E20" fontcolor="white"]
    N_vip   [label="VIP / PACAP → VPAC\n(cAMP co-transmitter)" fillcolor="#C8E6C9" color="#1B5E20"]
    N_ach   [label="ACh → M3 on endothelium\n(eNOS recruitment)" fillcolor="#C8E6C9" color="#1B5E20"]
    N_cgrp  [label="CGRP → cAMP" fillcolor="#C8E6C9" color="#1B5E20"]
    N_a2    [label="Prejunctional α2\nNE inhibits NO release" fillcolor="#EF9A9A" color="#B71C1C"]
    N_drv   [label="DRIVE = S · AROU · NRV / (1+kNE·ΔNE)" shape=diamond fillcolor="#43A047" color="#1B5E20" fontcolor="white"]
  }

  //=========================================================
  // CLUSTER 3 — endothelium
  //=========================================================
  subgraph cluster_endo {
    label="🩸 Cavernosal Endothelium — the NO MAINTENANCE loop (shear-driven)"
    style=filled fillcolor="#E1F5FE" color="#01579B" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    E_shear [label="Sinusoidal SHEAR STRESS\n∝ inflow Q_in  ★ positive feedback" fillcolor="#81D4FA" color="#01579B"]
    E_akt   [label="PI3K → Akt → eNOS Ser1177\nphosphorylation" fillcolor="#B3E5FC" color="#01579B"]
    E_cav   [label="Caveolin-1 inhibitory clamp\nCa²⁺-calmodulin release" fillcolor="#B3E5FC" color="#01579B"]
    E_enos  [label="eNOS (NOS3) coupled fraction  ECPL\nhealthy 0.71 · diabetic 0.41" fillcolor="#4FC3F7" color="#01579B"]
    E_bh4   [label="BH₄ : BH₂ ratio\ncofactor sufficiency" fillcolor="#B3E5FC" color="#01579B"]
    E_arg   [label="L-arginine / arginase-II\nsubstrate availability" fillcolor="#B3E5FC" color="#01579B"]
    E_adma  [label="ADMA (µM)  ·  DDAH-2\nhealthy 0.45 → diabetic 1.08" fillcolor="#81D4FA" color="#01579B"]
    E_no2   [label="NO (endothelial)\n★ MAINTENANCE" fillcolor="#29B6F6" color="#01579B" fontcolor="white"]
    E_gap   [label="Cx43 gap junctions\nsyncytial spread of relaxation" fillcolor="#B3E5FC" color="#01579B"]
    E_uncp  [label="eNOS UNCOUPLING\n→ O₂⁻ instead of NO" fillcolor="#FFAB91" color="#BF360C"]
  }

  //=========================================================
  // CLUSTER 4 — NO / sGC / cGMP / PDE5
  //=========================================================
  subgraph cluster_cgmp {
    label="🔑 NO–sGC–cGMP–PKG Axis  ·  the GAIN STAGE that PDE5 inhibitors act on"
    style=filled fillcolor="#FFFDE7" color="#F57F17" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    G_notot [label="Cavernosal NO  (nM)\nNO_prod / (kdeg + kscav·ROS)" fillcolor="#FFF59D" color="#F57F17"]
    G_sgcr  [label="sGC — REDUCED (Fe²⁺, haem-intact)\nNO-responsive" fillcolor="#FFF59D" color="#F57F17"]
    G_sgco  [label="sGC — OXIDISED / haem-free\nNO-INSENSITIVE  (0.05 → 0.36 in DM)" fillcolor="#FFCC80" color="#E65100"]
    G_gtp   [label="GTP → cGMP synthesis\nV = kSGC·(1−sGCox)·NO/(Km+NO)" fillcolor="#FFF176" color="#F57F17"]
    G_cgmp  [label="cGMP  ★ AMPLIFIED SIGNAL\nflaccid 1 → healthy peak 20 ×" fillcolor="#FBC02D" color="#E65100" fontcolor="white"]
    G_pde5  [label="PDE5A  (Km ≈ 2–5 µM)\nexpression T- and cGMP-dependent" fillcolor="#FFE082" color="#E65100"]
    G_pde5p [label="PKG-mediated PDE5 Ser102\nphosphorylation → 3–10× activation\n(NEGATIVE feedback)" fillcolor="#FFE082" color="#E65100"]
    G_pkg   [label="PKG-Iβ activity\nHill(cGMP): the THRESHOLD element" fillcolor="#FBC02D" color="#E65100" fontcolor="white"]
    G_mrp   [label="MRP4/MRP5 cGMP efflux\n+ PDE2/PDE3 cross-talk" fillcolor="#FFE082" color="#E65100"]
    G_res   [label="PDE5 residual activity\n= 1/(1 + Cu/IC50)" shape=diamond fillcolor="#F9A825" color="#E65100" fontcolor="white"]
  }

  //=========================================================
  // CLUSTER 5 — cAMP arm
  //=========================================================
  subgraph cluster_camp {
    label="💠 cAMP Arm — the NO-INDEPENDENT bypass (why ICI works in denervation)"
    style=filled fillcolor="#F1F8E9" color="#33691E" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    A_pge   [label="PGE₁ (alprostadil) intracavernosal\n10–20 µg" fillcolor="#DCEDC8" color="#33691E"]
    A_ep    [label="EP2 / EP4 receptors\nGs-coupled" fillcolor="#DCEDC8" color="#33691E"]
    A_ac    [label="Adenylate cyclase\nATP → cAMP" fillcolor="#DCEDC8" color="#33691E"]
    A_camp  [label="cAMP\nflaccid 1 → PGE₁ peak ≈ 22 ×" fillcolor="#AED581" color="#33691E"]
    A_pka   [label="PKA activity" fillcolor="#AED581" color="#33691E"]
    A_pde34 [label="PDE3 / PDE4\n(papaverine: non-selective)" fillcolor="#DCEDC8" color="#33691E"]
    A_pgdh  [label="15-PGDH local metabolism\n+ 96% pulmonary first pass\n→ negligible systemic PGE₁" fillcolor="#DCEDC8" color="#33691E"]
  }

  //=========================================================
  // CLUSTER 6 — Ca2+ / myosin machinery
  //=========================================================
  subgraph cluster_myo {
    label="🔧 Ca²⁺ / Myosin Machinery — where both second messengers converge"
    style=filled fillcolor="#E0F2F1" color="#004D40" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    M_vdcc  [label="L-type VDCC (Ca_V1.2)\nCa²⁺ entry" fillcolor="#B2DFDB" color="#004D40"]
    M_ip3   [label="IP₃R / RyR — SR Ca²⁺ release" fillcolor="#B2DFDB" color="#004D40"]
    M_serca [label="SERCA / PMCA / NCX\nCa²⁺ extrusion (PKG- and PKA-activated)" fillcolor="#B2DFDB" color="#004D40"]
    M_bkca  [label="BK_Ca / K_ATP channels\nhyperpolarisation" fillcolor="#B2DFDB" color="#004D40"]
    M_cai   [label="Cytosolic Ca²⁺  CAI\nflaccid 1 → relaxed 0.40" fillcolor="#80CBC4" color="#004D40"]
    M_mlck  [label="MLCK (Ca²⁺-calmodulin)" fillcolor="#B2DFDB" color="#004D40"]
    M_mlcp  [label="MLC phosphatase (MYPT1)\nPKG-activated" fillcolor="#B2DFDB" color="#004D40"]
    M_cpi   [label="CPI-17 (PKC-dependent)\nMLCP inhibition" fillcolor="#FFCCBC" color="#BF360C"]
    M_rho   [label="RhoA → ROCK-1/2\nCa²⁺-SENSITISATION" fillcolor="#FFAB91" color="#BF360C"]
    M_mlcp2 [label="MLC₂₀ phosphorylated fraction  MLCP\ncontracted 0.46 → relaxed 0.10" fillcolor="#4DB6AC" color="#004D40" fontcolor="white"]
    M_relax [label="RELAXATION  R = (MLCPmax − MLCP)/(MLCPmax − MLCPmin)\n★ absolute scale, not patient-relative" shape=diamond fillcolor="#00897B" color="#004D40" fontcolor="white"]
  }

  //=========================================================
  // CLUSTER 7 — contractile / antierectile tone
  //=========================================================
  subgraph cluster_tone {
    label="🔴 Antierectile Tone — the brake that must be released"
    style=filled fillcolor="#FFEBEE" color="#B71C1C" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    T_ne    [label="Noradrenaline tone  NE\n1.0 → 1.6 (performance anxiety)" fillcolor="#FFCDD2" color="#B71C1C"]
    T_a1    [label="α1A/α1D adrenoceptors\n(phentolamine · doxazosin)" fillcolor="#FFCDD2" color="#B71C1C"]
    T_et1   [label="Endothelin-1 → ET_A\n↑ with oxidative stress" fillcolor="#FFCDD2" color="#B71C1C"]
    T_ang   [label="Angiotensin II → AT₁\nRAAS activation" fillcolor="#FFCDD2" color="#B71C1C"]
    T_txa   [label="TXA₂ / PGF2α → TP receptor" fillcolor="#FFCDD2" color="#B71C1C"]
    T_plc   [label="Gq → PLC-β → DAG + IP₃\n→ PKC" fillcolor="#FFCDD2" color="#B71C1C"]
    T_rhogef[label="RhoGEF (p115, LARG)" fillcolor="#FFCDD2" color="#B71C1C"]
  }

  //=========================================================
  // CLUSTER 8 — haemodynamics and the veno-occlusive read-out
  //=========================================================
  subgraph cluster_hemo {
    label="🩻 Cavernosal Haemodynamics — the VENO-OCCLUSIVE READ-OUT (the threshold)"
    style=filled fillcolor="#E3F2FD" color="#0D47A1" penwidth=3 fontsize=13 fontname="Helvetica-Bold"

    H_map   [label="Mean arterial pressure  MAP\nperfusion head" fillcolor="#BBDEFB" color="#0D47A1"]
    H_ipud  [label="Internal pudendal / common penile artery\nfixed series resistance  R_feed" fillcolor="#BBDEFB" color="#0D47A1"]
    H_sten  [label="Atherosclerotic stenosis  STEN\nR_feed ∝ (1−STEN)⁻⁴" fillcolor="#90CAF9" color="#0D47A1"]
    H_helic [label="Helicine arteriolar conductance\nG_cav = G₀·exp(kG·R)  ★ exponential in R" fillcolor="#64B5F6" color="#0D47A1"]
    H_qin   [label="Arterial inflow  Q_in\nflaccid 300 → peak ≈ 4 000 mL/h" fillcolor="#90CAF9" color="#0D47A1"]
    H_sinus [label="Sinusoidal (lacunar) space\nvolume V_sin  12 → 52 mL" fillcolor="#64B5F6" color="#0D47A1"]
    H_tunica[label="Tunica albuginea\nexponential stiffening P(V)" fillcolor="#BBDEFB" color="#0D47A1"]
    H_subt  [label="Subtunical venular plexus\nCOMPRESSED by expansion" fillcolor="#BBDEFB" color="#0D47A1"]
    H_vocc  [label="Veno-occlusive engagement  VOCC\nHill⁶ in expansion  ★ POSITIVE FEEDBACK" fillcolor="#42A5F5" color="#0D47A1" fontcolor="white"]
    H_emis  [label="Emissary veins → deep dorsal vein\nleak conductance G_ven" fillcolor="#BBDEFB" color="#0D47A1"]
    H_qout  [label="Venous outflow  Q_out\nerect maintenance flow 3–5 mL/min" fillcolor="#90CAF9" color="#0D47A1"]
    H_icp   [label="INTRACAVERNOSAL PRESSURE  ICP\nflaccid 10 → full erection 85–90 mmHg" fillcolor="#1E88E5" color="#0D47A1" fontcolor="white"]
    H_rig   [label="Axial RIGIDITY (RigiScan %)\nHill³ in ICP; penetration ≥ 60%" fillcolor="#1565C0" color="#0D47A1" fontcolor="white"]
    H_isch  [label="Ischiocavernosus contraction\nsupra-systolic RIGID phase" fillcolor="#BBDEFB" color="#0D47A1"]
    H_vod   [label="VENO-OCCLUSIVE DYSFUNCTION\nceiling collapse below SMI knee" fillcolor="#EF9A9A" color="#B71C1C"]
  }

  //=========================================================
  // CLUSTER 9 — oxidative stress
  //=========================================================
  subgraph cluster_ros {
    label="☠️ Oxidative Stress & Endothelial Dysfunction (the shared final pathway of the comorbidities)"
    style=filled fillcolor="#FBE9E7" color="#BF360C" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    R_nox   [label="NOX1/2/4 (NADPH oxidase)" fillcolor="#FFCCBC" color="#BF360C"]
    R_xo    [label="Xanthine oxidase · uncoupled mito ETC" fillcolor="#FFCCBC" color="#BF360C"]
    R_ros   [label="Superoxide / ROS burden  ROS\nhealthy 1.0 → diabetic 3.5" fillcolor="#FF8A65" color="#BF360C" fontcolor="white"]
    R_onoo  [label="Peroxynitrite ONOO⁻\n→ 3-nitrotyrosine" fillcolor="#FFAB91" color="#BF360C"]
    R_scav  [label="NO SCAVENGING\nk·ROS·NO — NO is made but destroyed" fillcolor="#FF7043" color="#BF360C" fontcolor="white"]
    R_age   [label="AGE / RAGE signalling\n∝ (HbA1c/5.2)²" fillcolor="#FFCCBC" color="#BF360C"]
    R_pkcb  [label="PKC-β · hexosamine · polyol flux" fillcolor="#FFCCBC" color="#BF360C"]
    R_sod   [label="SOD / catalase / GPx\nantioxidant reserve" fillcolor="#D7CCC8" color="#4E342E"]
    R_rhoup [label="ROS → RhoA/ROCK up-regulation" fillcolor="#FFCCBC" color="#BF360C"]
  }

  //=========================================================
  // CLUSTER 10 — structural remodelling
  //=========================================================
  subgraph cluster_struct {
    label="🧱 Structural Remodelling — the IRREVERSIBLE arm (weeks–years)"
    style=filled fillcolor="#EFEBE9" color="#3E2723" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    S_npt   [label="Nocturnal erections (NPT)\n3–5 bouts · 2–3 h/night\n= periodic REOXYGENATION" fillcolor="#D7CCC8" color="#3E2723"]
    S_gox   [label="Oxygenation grade  g(ICP)\nweekly mean ERFR" shape=diamond fillcolor="#8D6E63" color="#3E2723" fontcolor="white"]
    S_po2   [label="Cavernosal pO₂\nflaccid 38 → erect 95 mmHg" fillcolor="#D7CCC8" color="#3E2723"]
    S_hif   [label="Chronic hypoxia → HIF-1α" fillcolor="#BCAAA4" color="#3E2723"]
    S_tgf   [label="TGF-β1 → Smad2/3 → CTGF\n(PKG inhibits Smad signalling)" fillcolor="#BCAAA4" color="#3E2723"]
    S_col   [label="Collagen I/III deposition  COL\n1.0 → 1.6 (fibrotic)" fillcolor="#A1887F" color="#3E2723" fontcolor="white"]
    S_mmp   [label="MMP-2/9 : TIMP balance\nelastin fragmentation" fillcolor="#D7CCC8" color="#3E2723"]
    S_apop  [label="Smooth-muscle apoptosis\n(hypoxia + TGF-β1)" fillcolor="#BCAAA4" color="#3E2723"]
    S_sm    [label="Trabecular smooth-muscle mass  SM\n45% → 30% of trabecular area" fillcolor="#A1887F" color="#3E2723" fontcolor="white"]
    S_smi   [label="SMOOTH-MUSCLE INDEX  SMI = SM/(SM+COL)\n★ sets the veno-occlusive ceiling" shape=diamond fillcolor="#6D4C41" color="#3E2723" fontcolor="white"]
    S_len   [label="Stretched penile length\npost-RP shortening 1–2 cm" fillcolor="#D7CCC8" color="#3E2723"]
    S_peyr  [label="Focal plaque (Peyronie's)\ncurvature" fillcolor="#D7CCC8" color="#3E2723"]
  }

  //=========================================================
  // CLUSTER 11 — cavernous nerve injury and regeneration
  //=========================================================
  subgraph cluster_nerve {
    label="🔪 Cavernous Nerve Injury & Regeneration (radical prostatectomy · the rehabilitation window)"
    style=filled fillcolor="#F3E5F5" color="#6A1B9A" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    V_rp    [label="Radical prostatectomy\ntraction · thermal · ischaemic injury" fillcolor="#E1BEE7" color="#6A1B9A"]
    V_ns    [label="Nerve-sparing grade\nbilateral 0.90 · unilateral 0.50 · none 0.15\n★ sets the RECOVERY CEILING" fillcolor="#CE93D8" color="#6A1B9A"]
    V_wall  [label="Wallerian degeneration\naxonal dieback" fillcolor="#E1BEE7" color="#6A1B9A"]
    V_schw  [label="Schwann cells · Büngner bands\nBDNF · GDNF · NGF" fillcolor="#E1BEE7" color="#6A1B9A"]
    V_reg   [label="Axonal regeneration\nτ ≈ 5 000 h (≈ 7 months)" fillcolor="#CE93D8" color="#6A1B9A"]
    V_apop  [label="Cavernosal apoptosis wave\n(loss of NO trophic support)" fillcolor="#E1BEE7" color="#6A1B9A"]
    V_race  [label="RACE: regeneration τ 7 mo\nvs fibrosis τ 12 wk\n★ rehabilitation window" shape=diamond fillcolor="#8E24AA" color="#4A148C" fontcolor="white"]
    V_pelvi [label="Pelvic radiotherapy · cryotherapy\nHIFU · TURP" fillcolor="#E1BEE7" color="#6A1B9A"]
    V_dm    [label="Diabetic autonomic neuropathy\nnNOS fibre loss (no recovery)" fillcolor="#E1BEE7" color="#6A1B9A"]
  }

  //=========================================================
  // CLUSTER 12 — endocrine axis
  //=========================================================
  subgraph cluster_endoc {
    label="⚗️ Hypothalamic–Pituitary–Gonadal Axis (permissive, multiplicative)"
    style=filled fillcolor="#FFF3E0" color="#E65100" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    D_gnrh  [label="GnRH pulse generator" fillcolor="#FFE0B2" color="#E65100"]
    D_lh    [label="LH (IU/L)\nnegative feedback from T" fillcolor="#FFE0B2" color="#E65100"]
    D_ley   [label="Leydig-cell steroidogenesis\nStAR · CYP17 · 17β-HSD" fillcolor="#FFE0B2" color="#E65100"]
    D_tt    [label="Total testosterone (ng/dL)\neugonadal 550 · hypogonadal 290" fillcolor="#FFCC80" color="#E65100"]
    D_shbg  [label="SHBG / albumin binding\nfree T ≈ 2%" fillcolor="#FFE0B2" color="#E65100"]
    D_ar    [label="Androgen receptor\ncavernosal + CNS" fillcolor="#FFE0B2" color="#E65100"]
    D_arom  [label="Aromatase → oestradiol\nadipose tissue" fillcolor="#FFE0B2" color="#E65100"]
    D_prl   [label="Prolactin\n(antipsychotics · prolactinoma)" fillcolor="#FFE0B2" color="#E65100"]
    D_thy   [label="Thyroid status\n(hyper- and hypo- both cause ED)" fillcolor="#FFE0B2" color="#E65100"]
    D_trg   [label="T-dependent GATE\n→ nNOS ↑ · PDE5 ↑ · SM trophism ↑ · libido ↑" shape=diamond fillcolor="#FB8C00" color="#E65100" fontcolor="white"]
    D_hct   [label="Haematocrit (%)\nerythrocytosis on TRT" fillcolor="#FFE0B2" color="#E65100"]
  }

  //=========================================================
  // CLUSTER 13 — comorbid drivers
  //=========================================================
  subgraph cluster_como {
    label="🏥 Comorbid Drivers (ED as a sentinel of systemic vascular disease)"
    style=filled fillcolor="#F9FBE7" color="#827717" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    B_dm    [label="Type 2 diabetes\nHbA1c (%)" fillcolor="#F0F4C3" color="#827717"]
    B_lip   [label="Dyslipidaemia\nLDL-C (mg/dL)" fillcolor="#F0F4C3" color="#827717"]
    B_htn   [label="Hypertension / RAAS activity" fillcolor="#F0F4C3" color="#827717"]
    B_obes  [label="Obesity (BMI)\nleptin ↑ adiponectin ↓" fillcolor="#F0F4C3" color="#827717"]
    B_smoke [label="Smoking" fillcolor="#F0F4C3" color="#827717"]
    B_age   [label="Chronological age" fillcolor="#F0F4C3" color="#827717"]
    B_osa   [label="Obstructive sleep apnoea\n(also abolishes NPT)" fillcolor="#F0F4C3" color="#827717"]
    B_ckd   [label="Chronic kidney disease · uraemia" fillcolor="#F0F4C3" color="#827717"]
    B_luts  [label="LUTS / BPH\n(shared NO-ROCK biology)" fillcolor="#F0F4C3" color="#827717"]
    B_drug  [label="Iatrogenic: thiazides · β-blockers\nSSRI · 5ARI · antiandrogens · opioids" fillcolor="#F0F4C3" color="#827717"]
    B_alc   [label="Alcohol · cannabis · cocaine" fillcolor="#F0F4C3" color="#827717"]
    B_ros   [label="COMMON ENTRY POINT\noxidative drive  rosdrv" shape=diamond fillcolor="#C0CA33" color="#827717"]
  }

  //=========================================================
  // CLUSTER 14 — psychogenic / behavioural loop
  //=========================================================
  subgraph cluster_psy {
    label="😰 Psychogenic Loop — a positive feedback that converts an organic deficit into a worse one"
    style=filled fillcolor="#FCE4EC" color="#880E4F" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    P_fail  [label="FAILED attempt\n(rigidity below threshold)" fillcolor="#F8BBD0" color="#880E4F"]
    P_pa    [label="Performance anxiety  PA\nuntreated ED 0.45 → treated 0.05" fillcolor="#F48FB1" color="#880E4F"]
    P_symp  [label="Sympathetic overdrive\n→ NE tone ↑" fillcolor="#F8BBD0" color="#880E4F"]
    P_conf  [label="Sexual confidence\n(IIEF-EF item 15 · GAQ)" fillcolor="#F8BBD0" color="#880E4F"]
    P_dep   [label="Depression · relationship distress" fillcolor="#F8BBD0" color="#880E4F"]
    P_ssri  [label="SSRI: central 5-HT ↑\n+ delayed ejaculation" fillcolor="#F8BBD0" color="#880E4F"]
    P_avoid [label="Sexual avoidance\n→ fewer attempts, less NPT reinforcement" fillcolor="#F8BBD0" color="#880E4F"]
    P_succ  [label="SUCCESSFUL attempt\n→ PA decays  ★ the confidence effect" fillcolor="#C5E1A5" color="#33691E"]
  }

  //=========================================================
