    Spreading_dep [label="Brainstem spreading\ndepolarisation"];
    SUDEP_haz  [label="SUDEP HAZARD", penwidth=2.0, fillcolor="#e88e8e"];
    Mortality  [label="Cumulative mortality\n(~10-20% by age 20;\nSUDEP ≈ half of deaths)", penwidth=1.8];
