// ============================================================================
//  Dravet Syndrome (SCN1A Developmental & Epileptic Encephalopathy)
//  Mechanistic QSP Map
//  ---------------------------------------------------------------------------
//  Render:  dot -Tsvg dravet_qsp_model.dot -o dravet_qsp_model.svg
//           dot -Tpng -Gdpi=150 dravet_qsp_model.dot -o dravet_qsp_model.png
//
//  The map is organised around four structural commitments that the companion
//  mrgsolve model turns into equations. Each is stated so that it can be
//  attacked.
//
//   (1) THE LESION IS IN INHIBITION, NOT EXCITATION.  Nav1.1 (SCN1A) is
//       expressed preferentially in GABAergic interneurons — above all in
//       PV+ fast-spiking and SST+ cells. Haploinsufficiency therefore removes
//       INHIBITORY drive. The excitatory compartment runs on Nav1.2/Nav1.6 and
//       is left essentially intact. Every downstream consequence in this map
//       inherits that asymmetry.
//
//   (2) INTERNEURON FIRING IS A THRESHOLD FUNCTION OF SODIUM RESERVE.
//       Sustaining 100-200 Hz non-adapting firing costs far more available
//       sodium conductance than the 5-20 Hz output of a pyramidal cell. The
//       map therefore carries TWO separate sodium-reserve nodes with TWO
//       different steepness/threshold pairs. This single asymmetry is what
//       makes sodium-channel blockers anticonvulsant in a normal brain and
//       PROCONVULSANT in Dravet: the sign of the drug effect is emergent, not
//       assumed. It is the model's built-in falsification test.
//
//   (3) CLOBAZAM IS TWO DRUGS.  Clobazam is a 1,5-benzodiazepine cleared by
//       CYP3A4 to N-desmethylclobazam (norclobazam), which is itself cleared
//       by polymorphic CYP2C19 and accumulates to 5-20x the parent. Both are
//       GABA-A positive allosteric modulators. Consequence: any drug that
//       inhibits CYP2C19 raises norclobazam and is therefore an INDIRECT
//       GABAergic drug. Stiripentol and cannabidiol both do exactly this.
//       The map keeps the PK route (dashed orange) and the direct
//       pharmacodynamic route (solid orange) as physically separate paths into
//       the same GABA-A node, because the central question of this model is
//       how much of the observed benefit travels down each.
//
//   (4) EFFICACY AND SEDATION SHARE A NODE.  Norclobazam drives seizure
//       protection and somnolence through the same GABA-A occupancy term.
//       A drug that works by raising norclobazam therefore cannot separate
//       the two; a drug that works through an independent node (serotonin,
//       sigma-1, adenosine, or SCN1A upregulation) can. This gives the two
//       routes in commitment (3) different therapeutic indices, which is the
//       clinically actionable output of the whole model.
//
//  Colour key
//    Blue    = gene / transcript / channel biology
//    Green   = cellular & network physiology (interneuron, pyramidal, circuit)
//    Red     = seizure generation & injury
//    Orange  = drug, dose, PK compartment, intervention
//    Pink    = enzymology / drug-drug interaction
//    Purple  = receptor & signalling targets
//    Grey    = clinical endpoints
//    Yellow  = toxicity / adverse effects
// ============================================================================

digraph DRAVET_QSP {
  rankdir=LR;
  compound=true;
  splines=spline;
  nodesep=0.19;
  ranksep=0.60;
  fontname="Helvetica";
  labelloc="t";
  fontsize=22;
  label=<<B>Dravet Syndrome (SCN1A Developmental &amp; Epileptic Encephalopathy) — Mechanistic QSP Map</B><BR/>
<FONT POINT-SIZE="13">SCN1A haploinsufficiency → Nav1.1 loss in GABAergic interneurons → threshold failure of fast-spiking inhibition → E:I imbalance → seizures, status epilepticus, developmental arrest, SUDEP<BR/>
Blue = gene/channel · Green = cell &amp; network physiology · Red = seizure/injury · Orange = drug &amp; PK · Pink = enzymology/DDI · Purple = receptor target · Grey = clinical endpoint · Yellow = toxicity</FONT>>;
  node [style="filled,rounded", shape=box, fontname="Helvetica", fontsize=10, color="#666666", penwidth=0.8];
  edge [fontname="Helvetica", fontsize=8, color="#5a5a5a", arrowsize=0.7];

  // ==========================================================================
  subgraph cluster_gene {
    label="1. SCN1A locus, variant class & transcript fate";
    style="filled,rounded"; color="#9fb4d4"; fillcolor="#f1f5fb"; fontsize=13; fontcolor="#22395c";
    node [fillcolor="#d8e4f5"];
    SCN1A_locus    [label="SCN1A\n2q24.3 · 26 exons\nNav1.1 α-subunit"];
    Var_denovo     [label="De novo variant\n(~90% of cases)"];
    Var_trunc      [label="Truncating / nonsense\nfrmshift (~50%)\n→ clear haploinsufficiency"];
    Var_missense   [label="Missense in pore /\nvoltage sensor (~40%)\n→ LoF, variable severity"];
    Var_deletion   [label="Whole-gene &amp; multi-exon\ndeletion (~2-3%)"];
    Var_GOF        [label="GOF missense\n(EIMFS / migrating focal\nseizures — NOT Dravet)", fillcolor="#f7dede"];
    Mosaic_parent  [label="Parental somatic mosaicism\n(~7% of 'de novo')"];
    NMD            [label="Nonsense-mediated decay\nof mutant transcript"];
    PoisonExon     [label="Poison exon 20N\n(non-productive splice isoform,\n~⅓ of transcripts)"];
    Prod_mRNA      [label="PRODUCTIVE SCN1A mRNA\nfrom wild-type allele\n(~50% of normal)"];
    NonProd_mRNA   [label="Non-productive transcript\npool (20N-containing)"];
    Modifier_genes [label="Modifier loci\n(SCN9A, CACNB4, HCN;\nfamily-level variability)"];
    Allele_WT      [label="Intact wild-type allele\n— the therapeutic substrate"];

    SCN1A_locus -> Var_denovo;
    Var_denovo  -> Var_trunc;
    Var_denovo  -> Var_missense;
    Var_denovo  -> Var_deletion;
    SCN1A_locus -> Var_GOF [style=dotted, label="different disease"];
    Mosaic_parent -> Var_denovo [style=dashed, label="recurrence risk"];
    Var_trunc   -> NMD;
    NMD         -> Prod_mRNA [arrowhead=tee, label="one allele lost"];
    Var_missense -> Prod_mRNA [arrowhead=tee, label="functional loss"];
    Var_deletion -> Prod_mRNA [arrowhead=tee];
    SCN1A_locus -> PoisonExon;
    PoisonExon  -> NonProd_mRNA;
    NonProd_mRNA -> Prod_mRNA [arrowhead=tee, label="diverts pre-mRNA"];
    Allele_WT   -> Prod_mRNA;
    Modifier_genes -> Prod_mRNA [style=dashed];
  }

  // ==========================================================================
  subgraph cluster_channel {
    label="2. Nav1.1 protein, trafficking & biophysics";
    style="filled,rounded"; color="#9fb4d4"; fillcolor="#f1f5fb"; fontsize=13; fontcolor="#22395c";
    node [fillcolor="#d8e4f5"];
    Nav11_synth   [label="Nav1.1 translation"];
    Nav11_traffic [label="Axon-initial-segment\ntargeting (ankyrin-G / βIV-spectrin)"];
    Nav11_AIS     [label="Nav1.1 density at\ninterneuron AIS"];
    Nav11_degr    [label="Channel turnover\n(t½ ~1-2 days)"];
    Beta_subunit  [label="β1/β2 subunits (SCN1B)\nmodulate gating"];
    Persistent_Na [label="Persistent Na+ current\nINaP (subthreshold gain)"];
    Resurgent_Na  [label="Resurgent Na+ current\n(high-frequency recovery)"];
    Inact_recov   [label="Recovery from fast\ninactivation (τ)"];
    Nav12_16      [label="Nav1.2 / Nav1.6\n(excitatory neuron sodium —\nSCN2A / SCN8A, intact)", fillcolor="#e6f0dc"];
    Temp_gating   [label="Temperature-dependent\ngating of mutant Nav1.1\n(loss steepens with T)"];

    Prod_mRNA     -> Nav11_synth [ltail=cluster_gene];
    Nav11_synth   -> Nav11_traffic -> Nav11_AIS;
    Nav11_AIS     -> Nav11_degr [style=dashed];
    Beta_subunit  -> Nav11_AIS [style=dashed];
    Nav11_AIS     -> Persistent_Na;
    Nav11_AIS     -> Resurgent_Na;
    Nav11_AIS     -> Inact_recov;
    Temp_gating   -> Nav11_AIS [arrowhead=tee, color="#c0392b"];
  }

  // ==========================================================================
  subgraph cluster_int {
    label="3. GABAergic interneuron compartment — the primary lesion";
    style="filled,rounded"; color="#a8c48c"; fillcolor="#f3f8ee"; fontsize=13; fontcolor="#2f4a22";
    node [fillcolor="#dcecca"];
    PV_int        [label="PV+ fast-spiking\ninterneuron (perisomatic\nbasket/chandelier)"];
    SST_int       [label="SST+ interneuron\n(dendritic inhibition)"];
    VIP_int       [label="VIP+ interneuron\n(disinhibitory)"];
    Na_reserve_INT[label="INTERNEURON SODIUM RESERVE\n= Nav1.1 available × (1 − blocker occupancy)\n× temperature factor", fillcolor="#c3dfa2", penwidth=2.0];
    Firing_cap    [label="SUSTAINED HIGH-FREQUENCY\nFIRING CAPACITY\n(steep threshold function,\nHill n≈4, EC50 high)", fillcolor="#c3dfa2", penwidth=2.0];
    Spike_fail    [label="Spike amplitude decrement\n&amp; firing failure during\nrepetitive activation"];
    GABA_release  [label="Vesicular GABA release\nfrom interneuron terminals"];
    Tonic_inhib   [label="Tonic inhibitory conductance\n(extrasynaptic GABA-A)"];
    Phasic_inhib  [label="Phasic IPSC amplitude\n&amp; frequency"];
    INH_total     [label="TOTAL INHIBITORY DRIVE\n(INH)", fillcolor="#b3d68e", penwidth=2.0];
    Int_dev       [label="Developmental window:\ninterneuron maturation\n(first 12-24 months)"];
    Int_remodel   [label="Chronic circuit remodelling\n(interneuron loss / sprouting)"];

    Nav11_AIS -> Na_reserve_INT [penwidth=1.6];
    Na_reserve_INT -> Firing_cap [penwidth=1.6, label="steep"];
    Firing_cap -> Spike_fail [arrowhead=tee];
    Firing_cap -> GABA_release [penwidth=1.4];
    PV_int -> Firing_cap [style=dashed];
    SST_int -> Firing_cap [style=dashed];
    VIP_int -> INH_total [arrowhead=tee, style=dotted, label="disinhibition"];
    GABA_release -> Phasic_inhib;
    GABA_release -> Tonic_inhib;
    Phasic_inhib -> INH_total;
    Tonic_inhib  -> INH_total;
    Int_dev -> Firing_cap [style=dashed, label="age-dependent"];
    Int_remodel -> INH_total [arrowhead=tee, style=dashed];
  }

  // ==========================================================================
  subgraph cluster_exc {
    label="4. Excitatory compartment — structurally spared";
    style="filled,rounded"; color="#a8c48c"; fillcolor="#f3f8ee"; fontsize=13; fontcolor="#2f4a22";
    node [fillcolor="#e3f0d5"];
    Pyr_neuron    [label="Cortical / hippocampal\npyramidal neuron"];
    Na_reserve_PYR[label="PYRAMIDAL SODIUM RESERVE\n(Nav1.2/1.6, NOT Nav1.1)\n× (1 − blocker occupancy)", fillcolor="#cfe6b6", penwidth=2.0];
    Pyr_excit     [label="Pyramidal excitability\n(shallower dependence,\nlower firing demand)", fillcolor="#cfe6b6", penwidth=2.0];
    Glut_release  [label="Glutamate release"];
    AMPA_R        [label="AMPA receptor current"];
    NMDA_R        [label="NMDA receptor current"];
    Rec_excit     [label="Recurrent excitatory\ncollateral loops"];
    EXC_total     [label="TOTAL EXCITATORY DRIVE\n(EXC)", fillcolor="#bcdc9c", penwidth=2.0];
    Kv_channels   [label="Kv / HCN / SK\naccessory conductances"];

    Nav12_16 -> Na_reserve_PYR [penwidth=1.4];
    Pyr_neuron -> Na_reserve_PYR [style=dashed];
    Na_reserve_PYR -> Pyr_excit [penwidth=1.6, label="shallow"];
    Pyr_excit -> Glut_release -> AMPA_R -> EXC_total;
    Glut_release -> NMDA_R -> EXC_total;
    Rec_excit -> EXC_total;
    EXC_total -> Rec_excit [style=dashed, label="positive feedback"];
    Kv_channels -> Pyr_excit [arrowhead=tee, style=dotted];
  }

  // ==========================================================================
  subgraph cluster_network {
    label="5. Network E:I balance & seizure generation";
    style="filled,rounded"; color="#d9a3a3"; fillcolor="#fdf2f2"; fontsize=13; fontcolor="#7b2020";
    node [fillcolor="#f8dada"];
    EI_ratio      [label="E:I RATIO\n= EXC / INH", fillcolor="#f3c0c0", penwidth=2.2];
    Net_synch     [label="Network synchronisation\n&amp; recruitment"];
    Ictal_thresh  [label="Ictal threshold crossing"];
    Sz_hazard     [label="SEIZURE HAZARD λ(t)\n(steep power law in E:I)", fillcolor="#eda8a8", penwidth=2.2];
    Kindling      [label="Kindling / use-dependent\nexcitability accumulation\n(slow positive feedback)"];
    Sz_types      [label="Seizure semiology:\nhemiclonic · GTC · myoclonic ·\natypical absence · focal"];
    Sz_cluster    [label="Seizure clustering\n(within-day burst structure)"];
    NCSE          [label="Non-convulsive status /\nobtundation state"];
    SE_event      [label="CONVULSIVE STATUS\nEPILEPTICUS", fillcolor="#e88e8e", penwidth=1.8];
    Postictal     [label="Post-ictal refractory\nperiod &amp; depression"];
    Excitotox     [label="Excitotoxic Ca2+ load,\nneuroinflammation (IL-1β, TNF-α),\nBBB leakage"];
    Cereb_edema   [label="Cerebral oedema\n(rare, fatal SE complication)"];

    EXC_total -> EI_ratio [ltail=cluster_exc, penwidth=1.8];
    INH_total -> EI_ratio [ltail=cluster_int, penwidth=1.8, arrowhead=tee];
    EI_ratio -> Net_synch -> Ictal_thresh -> Sz_hazard [penwidth=1.6];
    Sz_hazard -> Sz_types;
    Sz_hazard -> Sz_cluster;
    Sz_hazard -> SE_event;
    Sz_hazard -> NCSE;
    Sz_types -> Postictal;
    Sz_hazard -> Kindling [style=dashed];
    Kindling -> EI_ratio [style=dashed, color="#c0392b", label="slow drift"];
    SE_event -> Excitotox [color="#c0392b"];
    Excitotox -> Kindling [style=dashed];
    SE_event -> Cereb_edema [style=dotted];
  }

  // ==========================================================================
  subgraph cluster_temp {
    label="6. Thermal & non-thermal seizure triggers";
    style="filled,rounded"; color="#d9a3a3"; fillcolor="#fdf2f2"; fontsize=13; fontcolor="#7b2020";
    node [fillcolor="#fae3d5"];
    Infection     [label="Intercurrent infection\n(viral, otitis, gastroenteritis)"];
    Vaccination   [label="Vaccination\n(fever-mediated, not causal)"];
    Fever         [label="FEVER / core temperature\nrise (>38 °C)", penwidth=1.6];
    Hot_bath      [label="Hot bath / ambient heat /\nexercise hyperthermia"];
    Photic        [label="Photic &amp; pattern\nstimulation"];
    Sleep_dep     [label="Sleep deprivation &amp;\nfragmented sleep"];
    Emotion       [label="Excitement / emotional\narousal"];
    Trig_load     [label="AGGREGATE TRIGGER LOAD\n(temperature-equivalent)", penwidth=1.6];

    Infection -> Fever;
    Vaccination -> Fever [style=dashed];
    Hot_bath -> Fever [style=dashed];
    Fever -> Trig_load [penwidth=1.4];
    Photic -> Trig_load;
    Sleep_dep -> Trig_load;
    Emotion -> Trig_load;
    Fever -> Temp_gating [lhead=cluster_channel, color="#c0392b", penwidth=1.4, label="mutant-selective"];
    Trig_load -> Sz_hazard [lhead=cluster_network, color="#c0392b", penwidth=1.4];
  }

  // ==========================================================================
  subgraph cluster_clb {
    label="7. Clobazam PK — parent and the active metabolite that dominates";
    style="filled,rounded"; color="#e0b183"; fillcolor="#fdf6ed"; fontsize=13; fontcolor="#7a4a12";
    node [fillcolor="#fbe4c7"];
    CLB_dose   [label="CLOBAZAM dose\n0.2-1.0 mg/kg/day PO", penwidth=1.6];
    CLB_gut    [label="Gut / absorption depot\n(ka ≈ 1.2 /h)"];
    CLB_C      [label="Clobazam central\n(parent)"];
    CLB_P      [label="Clobazam peripheral"];
    CLB_3A4    [label="CYP3A4 N-demethylation"];
    NCLB_C     [label="N-DESMETHYLCLOBAZAM\n(norclobazam) central\n— 5-20x parent at steady state", fillcolor="#f8d09e", penwidth=2.0];
    NCLB_P     [label="Norclobazam peripheral\n(t½ 36-82 h)"];
    NCLB_2C19  [label="CYP2C19 4'-hydroxylation\n(rate-limiting elimination)", penwidth=1.6];
    NCLB_out   [label="Renal excretion of\nhydroxy-metabolites"];
    CLB_free   [label="Unbound fractions\n(fu ≈ 0.13 CLB / 0.30 N-CLB)"];

    CLB_dose -> CLB_gut -> CLB_C;
    CLB_C -> CLB_P [dir=both, style=dashed];
    CLB_C -> CLB_3A4 -> NCLB_C [penwidth=1.6];
    NCLB_C -> NCLB_P [dir=both, style=dashed];
    NCLB_C -> NCLB_2C19 -> NCLB_out;
    CLB_C -> CLB_free [style=dotted];
    NCLB_C -> CLB_free [style=dotted];
  }

  // ==========================================================================
  subgraph cluster_stp {
    label="8. Stiripentol — a drug with two entirely separate routes of action";
    style="filled,rounded"; color="#e0b183"; fillcolor="#fdf6ed"; fontsize=13; fontcolor="#7a4a12";
    node [fillcolor="#fbe4c7"];
    STP_dose   [label="STIRIPENTOL dose\n50 mg/kg/day PO (÷2-3)", penwidth=1.6];
    STP_gut    [label="Gut depot"];
    STP_C      [label="Stiripentol central\n— MICHAELIS-MENTEN clearance\n(nonlinear, dose-supraproportional)", penwidth=1.6];
    STP_CLnl   [label="Saturable elimination\n(Vmax / Km); autoinhibition"];
    STP_2C19i  [label="Potent CYP2C19 inhibition", fillcolor="#f6cfe0"];
    STP_3A4i   [label="CYP3A4 inhibition", fillcolor="#f6cfe0"];
    STP_1A2i   [label="CYP1A2 / CYP2B6 / CYP2D6\ninhibition", fillcolor="#f6cfe0"];
    STP_GABA   [label="DIRECT GABA-A PAM\n(α3-preferring, distinct site\nfrom the benzodiazepine site)", fillcolor="#e6d5f2", penwidth=1.8];
    STP_LDH    [label="Lactate dehydrogenase\ninhibition (metabolic,\nputative accessory route)"];

    STP_dose -> STP_gut -> STP_C;
    STP_C -> STP_CLnl;
    STP_C -> STP_2C19i [penwidth=1.6];
    STP_C -> STP_3A4i;
    STP_C -> STP_1A2i;
    STP_C -> STP_GABA [penwidth=1.6, label="direct PD"];
    STP_C -> STP_LDH [style=dotted];
  }

  // ==========================================================================
  subgraph cluster_cbd {
    label="9. Cannabidiol PK — and the same CYP2C19 hinge";
    style="filled,rounded"; color="#e0b183"; fillcolor="#fdf6ed"; fontsize=13; fontcolor="#7a4a12";
    node [fillcolor="#fbe4c7"];
    CBD_dose   [label="CANNABIDIOL dose\n10-20 mg/kg/day PO ÷2", penwidth=1.6];
    CBD_gut    [label="Gut depot\n(high fat meal ↑ AUC ~4x)"];
    CBD_C      [label="Cannabidiol central\n(high first-pass)"];
    CBD_P      [label="CBD peripheral (lipophilic)"];
    CBD_7OH    [label="7-OH-CBD\n(active, CYP2C19-formed)", fillcolor="#f8d09e"];
    CBD_7COOH  [label="7-COOH-CBD\n(inactive, abundant)"];
    CBD_2C19i  [label="CYP2C19 inhibition\n(→ norclobazam ↑)", fillcolor="#f6cfe0", penwidth=1.6];
    CBD_UGTi   [label="UGT1A9 / UGT2B7 inhibition\n(→ valproate handling)", fillcolor="#f6cfe0"];
    CBD_GPR55  [label="GPR55 antagonism", fillcolor="#e6d5f2"];
    CBD_TRPV1  [label="TRPV1 desensitisation", fillcolor="#e6d5f2"];
    CBD_ENT1   [label="ENT1 inhibition →\nadenosine tone ↑", fillcolor="#e6d5f2"];
    CBD_noCB1  [label="NOT a CB1 agonist\n(no cannabimimetic route)", style="filled,dashed"];

    CBD_dose -> CBD_gut -> CBD_C;
    CBD_C -> CBD_P [dir=both, style=dashed];
    CBD_C -> CBD_7OH -> CBD_7COOH;
    CBD_C -> CBD_2C19i [penwidth=1.6];
    CBD_C -> CBD_UGTi;
    CBD_C -> CBD_GPR55;
    CBD_C -> CBD_TRPV1;
    CBD_C -> CBD_ENT1;
    CBD_7OH -> CBD_GPR55 [style=dashed];
    CBD_C -> CBD_noCB1 [style=dotted];
  }

  // ==========================================================================
  subgraph cluster_ffa {
    label="10. Fenfluramine — the serotonergic / sigma-1 route";
    style="filled,rounded"; color="#e0b183"; fillcolor="#fdf6ed"; fontsize=13; fontcolor="#7a4a12";
    node [fillcolor="#fbe4c7"];
    FFA_dose   [label="FENFLURAMINE dose\n0.7 mg/kg/day (max 26 mg);\n0.4 mg/kg (max 17 mg) with STP", penwidth=1.6];
    FFA_gut    [label="Gut depot"];
    FFA_C      [label="Fenfluramine central"];
    FFA_P      [label="Fenfluramine peripheral"];
    FFA_nor    [label="Norfenfluramine\n(active metabolite;\n5-HT2B affinity)", fillcolor="#f8d09e"];
    FFA_CYP    [label="CYP1A2 / 2B6 / 2D6\nN-de-ethylation", fillcolor="#f6cfe0"];
    FFA_SERT   [label="SERT reversal / VMAT2 —\nvesicular 5-HT release", fillcolor="#e6d5f2"];
    FFA_5HT    [label="Extracellular 5-HT tone ↑", fillcolor="#e6d5f2", penwidth=1.6];
    FFA_5HT1D  [label="5-HT1D / 5-HT2C / 5-HT2A\nreceptor agonism", fillcolor="#e6d5f2"];
    FFA_sigma1 [label="Sigma-1 receptor\npositive modulation", fillcolor="#e6d5f2", penwidth=1.6];
    FFA_5HT2B  [label="5-HT2B on valve\nfibroblasts (the historic\nfen-phen liability)", fillcolor="#fdf3c4"];

    FFA_dose -> FFA_gut -> FFA_C;
    FFA_C -> FFA_P [dir=both, style=dashed];
    FFA_C -> FFA_CYP -> FFA_nor;
    FFA_C -> FFA_SERT -> FFA_5HT [penwidth=1.6];
    FFA_nor -> FFA_5HT [style=dashed];
    FFA_5HT -> FFA_5HT1D;
    FFA_C -> FFA_sigma1 [penwidth=1.4];
    FFA_nor -> FFA_5HT2B [color="#b8860b"];
  }

  // ==========================================================================
  subgraph cluster_other_asm {
    label="11. Background & adjunct anti-seizure medication";
    style="filled,rounded"; color="#e0b183"; fillcolor="#fdf6ed"; fontsize=13; fontcolor="#7a4a12";
    node [fillcolor="#fbe4c7"];
    VPA_dose   [label="VALPROATE\n20-40 mg/kg/day\n(first-line background)"];
    VPA_C      [label="Valproate central\n(saturable protein binding)"];
    VPA_mech   [label="Multi-target: GABA turnover,\nNa+/T-Ca2+, HDAC"];
    TPM_dose   [label="Topiramate (adjunct)"];
    LEV_dose   [label="Levetiracetam (SV2A)"];
    BRV_dose   [label="Brivaracetam (SV2A)"];
    KD_diet    [label="KETOGENIC DIET\n(ketone bodies, ~⅓ responders)"];
    KD_mech    [label="β-hydroxybutyrate:\nATP-sensitive K+ channels,\nGABA shunt, mTOR ↓"];
    VNS        [label="Vagus nerve stimulation"];
    Rescue_DZP [label="Rescue benzodiazepine\n(buccal midazolam /\nrectal diazepam)", penwidth=1.4];
    Fever_mgmt [label="Aggressive antipyresis\n&amp; trigger avoidance"];

    VPA_dose -> VPA_C -> VPA_mech;
    KD_diet -> KD_mech;
    TPM_dose -> INH_total [lhead=cluster_int, style=dashed];
    LEV_dose -> EXC_total [lhead=cluster_exc, style=dashed, arrowhead=tee];
    BRV_dose -> EXC_total [lhead=cluster_exc, style=dashed, arrowhead=tee];
    VNS -> Sz_hazard [lhead=cluster_network, style=dashed, arrowhead=tee];
    Fever_mgmt -> Fever [lhead=cluster_temp, arrowhead=tee, style=dashed];
  }

  // ==========================================================================
  subgraph cluster_navblock {
    label="12. Sodium-channel blockers — the model's falsification test";
    style="filled,rounded"; color="#c98d8d"; fillcolor="#fbeeee"; fontsize=13; fontcolor="#7b2020";
    node [fillcolor="#f6d6d6"];
    LTG_dose   [label="LAMOTRIGINE\n(contraindicated in Dravet)", penwidth=1.6];
    CBZ_dose   [label="CARBAMAZEPINE /\nOXCARBAZEPINE\n(contraindicated)"];
    PHT_dose   [label="PHENYTOIN\n(contraindicated except\nacute SE rescue)"];
    VGB_dose   [label="Vigabatrin, tiagabine\n(GABA-transaminase /\nGAT-1 — aggravate absence)"];
    NavB_C     [label="Blocker plasma / brain\nconcentration"];
    NavB_occ   [label="USE-DEPENDENT Nav BLOCK\n(occupancy rises with\nfiring frequency)", penwidth=1.8];
    NavB_INT   [label="Occupancy at INTERNEURON Nav\n— HIGHER, because the cell\nfires at 100-200 Hz", fillcolor="#f0bcbc", penwidth=1.8];
    NavB_PYR   [label="Occupancy at PYRAMIDAL Nav\n— lower (5-20 Hz)", fillcolor="#f6d6d6"];
    Aggravation[label="PARADOXICAL SEIZURE\nAGGRAVATION\n(emergent, not assumed)", fillcolor="#e88e8e", penwidth=2.2];

    LTG_dose -> NavB_C;
    CBZ_dose -> NavB_C;
    PHT_dose -> NavB_C;
    NavB_C -> NavB_occ -> NavB_INT [penwidth=1.6];
    NavB_occ -> NavB_PYR;
    NavB_INT -> Na_reserve_INT [lhead=cluster_int, arrowhead=tee, color="#c0392b", penwidth=2.0, label="pushes below threshold"];
    NavB_PYR -> Na_reserve_PYR [lhead=cluster_exc, arrowhead=tee, color="#2e7d32", label="mild benefit"];
    Aggravation -> Sz_hazard [lhead=cluster_network, color="#c0392b", style=dotted];
    VGB_dose -> Aggravation [style=dotted];
  }

  // ==========================================================================
  subgraph cluster_ddi {
    label="13. Enzyme network — where the drug-drug interactions live";
    style="filled,rounded"; color="#d9a0bd"; fillcolor="#fdf1f6"; fontsize=13; fontcolor="#7a2149";
    node [fillcolor="#f6cfe0"];
    E_2C19     [label="CYP2C19 ACTIVITY\n(turnover state)", penwidth=2.0];
    E_3A4      [label="CYP3A4 activity\n(turnover state)", penwidth=1.6];
    E_1A2      [label="CYP1A2 / 2B6 / 2D6\ncomposite activity"];
    Geno_2C19  [label="CYP2C19 GENOTYPE\nUM · NM · IM · PM\n(PM ~2-5% White, ~15-20% East Asian)", penwidth=2.0];
    Age_ontog  [label="Ontogeny: paediatric\nenzyme maturation &amp;\nper-kg clearance"];
    DDI_NCLB   [label="NET NORCLOBAZAM\nEXPOSURE MULTIPLIER", fillcolor="#f2b6d0", penwidth=2.2];
    DDI_FFAup  [label="Stiripentol → fenfluramine\nexposure ↑ → the 0.4 mg/kg\nDOSE CAP"];
    DDI_VPA    [label="CBD × valproate:\nhepatic transaminase\nelevation", fillcolor="#fdf3c4"];
    Enz_induce [label="Enzyme inducers\n(phenobarbital, phenytoin,\ncarbamazepine) → N-CLB ↓"];

    Geno_2C19 -> E_2C19 [penwidth=1.8];
    Age_ontog -> E_2C19 [style=dashed];
    Age_ontog -> E_3A4 [style=dashed];
    STP_2C19i -> E_2C19 [ltail=cluster_stp, arrowhead=tee, penwidth=1.8, color="#b03060"];
    CBD_2C19i -> E_2C19 [ltail=cluster_cbd, arrowhead=tee, penwidth=1.8, color="#b03060"];
    STP_3A4i  -> E_3A4  [ltail=cluster_stp, arrowhead=tee];
    STP_1A2i  -> E_1A2  [ltail=cluster_stp, arrowhead=tee];
    Enz_induce -> E_2C19 [label="induction"];
    E_2C19 -> DDI_NCLB [arrowhead=tee, penwidth=2.0];
    DDI_NCLB -> NCLB_2C19 [lhead=cluster_clb, arrowhead=tee, penwidth=2.0, style=dashed, color="#b03060", label="PK ROUTE"];
    E_1A2 -> DDI_FFAup [arrowhead=tee];
    DDI_FFAup -> FFA_C [lhead=cluster_ffa, style=dashed, color="#b03060"];
    CBD_UGTi -> DDI_VPA [ltail=cluster_cbd];
    VPA_C -> DDI_VPA [ltail=cluster_other_asm, style=dashed];
    E_3A4 -> CLB_3A4 [lhead=cluster_clb, style=dashed];
  }

  // ==========================================================================
  subgraph cluster_gabaa {
    label="14. GABA-A receptor pharmacology & benzodiazepine tolerance";
    style="filled,rounded"; color="#b79ad4"; fillcolor="#f6f1fb"; fontsize=13; fontcolor="#432268";
    node [fillcolor="#e6d5f2"];
    GABAA_R    [label="GABA-A receptor\n(α1/α2/α3/α5 · β · γ2)"];
    BZD_site   [label="Benzodiazepine site\n(α+/γ2 interface)"];
    PAM_occ    [label="TOTAL PAM OCCUPANCY\n= clobazam + NORCLOBAZAM\n+ stiripentol + rescue BZD", penwidth=2.2, fillcolor="#d5bcec"];
    Cl_current [label="Chloride conductance ↑\n(channel open probability)"];
    GABA_gain  [label="INHIBITORY GAIN\nmultiplier on INH", penwidth=2.0, fillcolor="#d5bcec"];
    BZD_tol    [label="TOLERANCE: receptor\ndownregulation / uncoupling\n(weeks-months)", penwidth=1.8];
    Alpha3_pref[label="α3-subunit preference\n(stiripentol) vs α1/α2\n(benzodiazepine site)"];
    KCC2_NKCC1 [label="KCC2 / NKCC1 chloride\ngradient (age-dependent\nGABA polarity)"];

    NCLB_C -> PAM_occ [ltail=cluster_clb, penwidth=2.0, label="dominant contributor"];
    CLB_C  -> PAM_occ [ltail=cluster_clb, penwidth=1.2];
    STP_GABA -> PAM_occ [ltail=cluster_stp, penwidth=1.6, label="DIRECT PD ROUTE"];
    Rescue_DZP -> PAM_occ [ltail=cluster_other_asm, style=dashed];
    GABAA_R -> BZD_site -> PAM_occ [style=dotted];
    Alpha3_pref -> PAM_occ [style=dotted];
    PAM_occ -> Cl_current -> GABA_gain [penwidth=1.8];
    PAM_occ -> BZD_tol [style=dashed, label="chronic exposure"];
    BZD_tol -> GABA_gain [arrowhead=tee, penwidth=1.6, color="#c0392b"];
    KCC2_NKCC1 -> Cl_current [style=dotted];
    GABA_gain -> INH_total [lhead=cluster_int, penwidth=2.0, color="#2e7d32"];
  }

  // ==========================================================================
  subgraph cluster_indep {
    label="15. Non-GABAergic anticonvulsant nodes (independent of norclobazam)";
    style="filled,rounded"; color="#b79ad4"; fillcolor="#f6f1fb"; fontsize=13; fontcolor="#432268";
    node [fillcolor="#e6d5f2"];
    Sero_brake [label="SEROTONERGIC BRAKE\n(5-HT1D/2C on excitatory\nterminals + raphe tone)", penwidth=1.8];
