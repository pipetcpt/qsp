    KD_mech   -> Ketone_ax [ltail=cluster_other_asm];
    Sero_brake -> INDEP_sum [penwidth=1.6];
    Sigma1_mod -> INDEP_sum;
    Adeno_tone -> INDEP_sum;
    GPR55_ax   -> INDEP_sum;
    TRPV1_ax   -> INDEP_sum;
    Ketone_ax  -> INDEP_sum;
