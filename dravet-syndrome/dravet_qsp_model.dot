    Adeno_tone [label="Adenosine A1 tone\n(ENT1 block)", penwidth=1.4];
    GPR55_ax   [label="GPR55 antagonism →\npresynaptic release ↓"];
    TRPV1_ax   [label="TRPV1 desensitisation →\nCa2+ load ↓"];
    Ketone_ax  [label="Ketone / metabolic\nstabilisation (KATP)"];
    INDEP_sum  [label="INDEPENDENT PROTECTION\nTERM (no sedation cost)", penwidth=2.2, fillcolor="#d5bcec"];

    FFA_5HT1D -> Sero_brake [ltail=cluster_ffa, penwidth=1.6];
    FFA_5HT   -> Sero_brake [ltail=cluster_ffa, penwidth=1.4];
