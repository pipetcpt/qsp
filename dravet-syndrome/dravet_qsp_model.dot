  // ==========================================================================
  subgraph cluster_tox {
    label="20. Treatment-emergent toxicity — the price of each route";
    style="filled,rounded"; color="#d4c17a"; fillcolor="#fdfaeb"; fontsize=13; fontcolor="#6b5410";
    node [fillcolor="#fdf3c4"];
    Somnolence [label="SOMNOLENCE / sedation\n— tracks norclobazam,\nnot the parent drug", penwidth=2.0];
    Ataxia_tox [label="Drug-induced ataxia,\ndysarthria, drooling"];
    Appetite   [label="Appetite loss &amp; weight\ndecline (FFA, STP, TPM)", penwidth=1.6];
    Growth     [label="Growth velocity\nimpairment"];
    ALT_rise   [label="ALT / AST elevation\n(CBD, concentrated in\nvalproate co-medication)", penwidth=1.6];
    Diarrhoea  [label="Diarrhoea (CBD oil vehicle)"];
    Valve_reg  [label="Echocardiographic valve\nregurgitation (5-HT2B)"];
    PAH_risk   [label="Pulmonary arterial\nhypertension surveillance"];
    Neutropenia[label="Neutropenia / thrombocytopenia\n(stiripentol, valproate)"];
    VPA_hep    [label="Valproate hepatotoxicity\n&amp; hyperammonaemia"];
    Withdrawal [label="Benzodiazepine withdrawal\nseizures on abrupt taper"];
    Dose_reduce[label="MITIGATION: pre-emptive\nclobazam dose reduction\nwhen adding CBD or STP", fillcolor="#e2f0d9", penwidth=1.8];

    PAM_occ -> Somnolence [ltail=cluster_gabaa, penwidth=2.0, color="#b8860b"];
    Sed_burden -> Ataxia_tox [ltail=cluster_dev];
    FFA_C -> Appetite [ltail=cluster_ffa, color="#b8860b"];
    STP_C -> Appetite [ltail=cluster_stp, color="#b8860b"];
    Appetite -> Growth;
    DDI_VPA -> ALT_rise [ltail=cluster_ddi, penwidth=1.6];
    CBD_C -> Diarrhoea [ltail=cluster_cbd];
    FFA_5HT2B -> Valve_reg [ltail=cluster_ffa, penwidth=1.4];
    FFA_5HT2B -> PAH_risk [ltail=cluster_ffa];
    STP_C -> Neutropenia [ltail=cluster_stp, style=dotted];
    VPA_C -> VPA_hep [ltail=cluster_other_asm, style=dotted];
    BZD_tol -> Withdrawal [ltail=cluster_gabaa, style=dashed];
    Somnolence -> Dose_reduce [style=dashed, color="#2e7d32"];
    Dose_reduce -> CLB_dose [lhead=cluster_clb, arrowhead=tee, color="#2e7d32", penwidth=1.6];
  }

  // ==========================================================================
  subgraph cluster_question {
    label="21. The identifiability question this model exists to answer";
    style="filled,rounded"; color="#7a7a7a"; fillcolor="#eceff1"; fontsize=13; fontcolor="#263238";
    node [fillcolor="#cfd8dc"];
    Q_central  [label="Both stiripentol AND cannabidiol\nraise norclobazam 2-4x\nAND show large seizure reductions\non clobazam backgrounds.\nHOW MUCH IS THE DRUG?", penwidth=2.4, fillcolor="#b0bec5"];
    Null_PK    [label="STRUCTURAL NULL A:\ndelete the direct PD route,\nkeep only the CYP2C19 effect", penwidth=1.6];
    Null_PD    [label="STRUCTURAL NULL B:\ndelete the CYP2C19 effect,\nkeep only the direct route", penwidth=1.6];
    Test_PM    [label="FALSIFIABLE PREDICTION:\nin a CYP2C19 poor metaboliser\nthere is no 2C19 headroom,\nso the PK route must vanish", penwidth=2.0, fillcolor="#b0bec5"];
    Test_CLBfree [label="CLOBAZAM-FREE STRATUM:\nthe only clean read-out of the\ndirect route (exists for CBD,\nabsent for stiripentol)", penwidth=1.8];
    TI_compare [label="THERAPEUTIC INDEX:\nseizure reduction per unit\nof somnolence — differs\nbetween the two routes", penwidth=2.0, fillcolor="#b0bec5"];

    DDI_NCLB -> Q_central [ltail=cluster_ddi, penwidth=1.8, style=dashed];
    STP_GABA -> Q_central [ltail=cluster_stp, penwidth=1.8];
    INDEP_sum -> Q_central [ltail=cluster_indep, penwidth=1.4];
    Q_central -> Null_PK;
    Q_central -> Null_PD;
    Q_central -> Test_PM [penwidth=1.6];
    Q_central -> Test_CLBfree;
    Geno_2C19 -> Test_PM [ltail=cluster_ddi, style=dashed];
    Somnolence -> TI_compare [ltail=cluster_tox, style=dashed];
    Pct_red -> TI_compare [ltail=cluster_endpoints, style=dashed];
    Q_central -> TI_compare [penwidth=1.6];
  }

  // ==========================================================================
  subgraph cluster_biomarker {
    label="22. Measurables & model read-outs";
    style="filled,rounded"; color="#9c8ab8"; fillcolor="#f5f2fa"; fontsize=13; fontcolor="#3d2a5c";
    node [fillcolor="#ded4ee"];
    TDM_CLB    [label="Plasma clobazam &amp;\nnorclobazam (TDM)\n— directly measurable"];
