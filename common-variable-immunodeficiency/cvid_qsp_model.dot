  P_IVINF  -> P_CENT     [label="bolus"];
  P_CENT   -> P_PERIPH   [dir=both];
  P_CENT   -> P_FCRN;
  P_FCRN   -> P_CENT     [label="salvage"];
  P_FCRN   -> P_HALF;
  P_FCRN   -> P_CATAB    [arrowhead=tee];
  P_CATAB  -> P_CENT     [arrowhead=tee];
  P_HALF   -> P_SWING;
  D_IVIG   -> P_SWING    [label="600-800 mg/dL\nsawtooth"];
  D_SCIG   -> P_SWING    [arrowhead=tee, label="flat"];
  P_ADJ    -> D_SCIG;
  P_LOSS   -> P_CENT     [arrowhead=tee];
  P_WT     -> P_CENT;
  P_ENDOG  -> P_TOTAL;
  P_CENT   -> P_TOTAL;
  P_TOTAL  -> R_TROUGH;
  P_TOTAL  -> K_IGG;
  D_LOADING -> P_CENT;
  P_SWING  -> R_TROUGH   [arrowhead=tee, label="the SAME monthly dose\ngives a LOWER trough\nwhen the profile swings"];

  /* PROTECTION */
  R_TROUGH -> R_SPECAB;
