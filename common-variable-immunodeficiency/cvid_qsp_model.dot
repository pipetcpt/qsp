    S_AZA     [label="아자티오프린 / MMF\nAzathioprine, mycophenolate\n— steroid-sparing partner\nfor GLILD"];
    S_GC      [label="글루코코르티코이드\nPrednisone — fast, effective,\nunsustainable"];
    S_ABA     [label="아바타셉트 (CTLA4-Ig)\nAbatacept — mechanism-matched\nfor CTLA4/LRBA deficiency"];
    S_SIRO    [label="시롤리무스 / mTOR 억제제\nSirolimus — lymphoproliferation,\nenteropathy, APDS"];
    S_LENIO   [label="레니올리십\nLeniolisib (PI3Kδ inhibitor)\n— APPROVED 2023 for APDS;\nthe first genotype-directed\ntherapy in this space"];
    S_JAK     [label="JAK 억제제\nRuxolitinib / baricitinib\n— STAT3 GOF, refractory\ndysregulation"];
    S_TPO     [label="TPO 수용체 작용제\nEltrombopag / romiplostim\n— non-immunosuppressive\nroute to a platelet count"];
    S_HSCT    [label="조혈모세포 이식\nHSCT — curative for\nmonogenic dysregulation,\n~40-60% mortality in\nunselected adult CVID"];
    S_VEDO    [label="베돌리주맙 / 부데소니드\nVedolizumab, oral budesonide\n— enteropathy"];
    S_ISBURD  [label="총 면역억제 부담\nNET IMMUNOSUPPRESSION\nBURDEN — the single quantity\nthat prices ARM 2 therapy", penwidth=2.0, fillcolor="#9575CD"];
  }

