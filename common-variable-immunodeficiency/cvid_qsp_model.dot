  /* MALIGNANCY */
  M_CHRONAG -> M_NHL;
  M_SURV   -> M_NHL      [arrowhead=tee];
  B_CD21LO -> M_NHL      [style=dashed];
  Y_LAD    -> M_NHL      [style=dashed];
  M_NHL    -> M_HAZ;
  M_GASTRIC -> M_HAZ;
