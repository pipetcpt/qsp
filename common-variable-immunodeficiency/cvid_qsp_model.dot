  /* ENTEROPATHY AND THE PK FEEDBACK */
  T_IEL_DUMMY [style=invis, shape=point, width=0.01];
  E_VILL   -> E_INFLAM;
  E_NLH    -> E_INFLAM;
  E_IEL    -> E_INFLAM;
  T_CD8ACT -> E_IEL;
  B_CD21LO -> E_NLH;
