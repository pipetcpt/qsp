    Z_INHABX  [label="흡입 항생제\nInhaled colistin / tobramycin\n— for Pseudomonas"];
    Z_PHYSIO  [label="기도 청결 물리치료\nAirway clearance physiotherapy,\nhypertonic saline"];
    Z_PJP     [label="PJP 예방\nCo-trimoxazole — when CD4 low\nor on immunosuppression"];
    Z_VACC    [label="백신 접종\nVaccination — poor response,\nbut conjugate vaccines and\ninfluenza still given"];
    Z_ABXRES  [label="항생제 내성 압력\nAntimicrobial resistance\nfrom chronic exposure", shape=octagon, fillcolor="#FFCC80", color="#EF6C00"];
  }

