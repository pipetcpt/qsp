  /* INNATE, TRANSLOCATION AND THE IFN LOOP */
  I_IGAMUC  -> I_BARRIER [arrowhead=tee];
  I_BARRIER -> I_LPS     [arrowhead=tee];
  I_LPS     -> I_SCD14;
  I_LPS     -> I_MONO;
  I_MONO    -> I_ISG;
  I_MONO    -> T_IL6;
  I_ISG     -> T_CD8ACT  [label="bystander\nactivation"];
  I_DYSBIO  -> I_LPS;
  I_IGAMUC  -> I_DYSBIO;
  I_TLR9    -> B_ACT     [arrowhead=tee];
  I_PDC     -> I_ISG;
  I_NK      -> X_EBV     [arrowhead=tee];
  I_SCD14   -> K_SCD14B;
  I_COMP    -> X_SPN     [arrowhead=tee];
  I_LPS     -> T_IL6;
  I_LPS     -> E_INFLAM;

  /* IMMUNOGLOBULIN PK */
  D_IVIG   -> P_IVINF;
