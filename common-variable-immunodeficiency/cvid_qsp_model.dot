     ================================================================ */
  subgraph cluster_ae {
    label="18 · 치료 부작용과 대가 (Therapy Costs & Adverse Effects)";
    style="filled,rounded"; color="#E65100"; fillcolor="#FFF3E0"; fontsize=11;
    node [shape=doubleoctagon, fillcolor="#FFCC80", color="#E65100"];

    V_SYSAE   [label="전신 주입 반응\nSystemic infusion reactions:\nheadache, myalgia, fever\n— rate-dependent, IVIG >> SCIG"];
    V_LOCAE   [label="국소 주입 부위 반응\nLocal SC site reaction:\nswelling, erythema\n— common but self-limiting"];
