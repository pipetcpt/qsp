    V_AKI     [label="급성 신손상\nAKI — sucrose-containing\nproducts (largely historical)"];
    V_ASEPMEN [label="무균성 수막염\nAseptic meningitis\n(migraineurs, high rate)"];
    V_OPPINF  [label="기회감염\nOpportunistic infection\n— the price of ARM 2 therapy\n(PJP, CMV, fungal, PML)"];
    V_GCTOX   [label="글루코코르티코이드 독성\nGC toxicity: bone, glucose,\nadrenal, cataract"];
    V_MALIGIS [label="면역억제 관련 악성도\nImmunosuppression-associated\nlymphoproliferation"];
    V_BURDEN  [label="치료 부담\nTreatment burden: lifelong,\n~4-52 infusions/year,\ncost, venous access"];
  }

