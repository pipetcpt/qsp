    E_ALB     [label="혈청 알부민\nSerum albumin", shape=diamond, fillcolor="#C5E1A5"];
    E_IGGLOSS [label="IgG 소실 증가\nEnteric IgG loss → APPARENT\nCL ↑ → same dose gives\nLOWER trough\n▶ feeds back to cluster 6", penwidth=1.8, fillcolor="#AED581"];
    E_MALAB   [label="흡수장애 / 체중감소\nMalabsorption, weight loss,\nfat-soluble vitamin and\nB12 deficiency"];
    E_ATROPH  [label="위축성 위염\nAtrophic gastritis,\nachlorhydria"];
    E_HP      [label="Helicobacter pylori\n— higher prevalence,\nharder to eradicate"];
    E_PA      [label="악성 빈혈\nPernicious anaemia\n(intrinsic factor loss)"];
    E_DIARR   [label="만성 설사\nChronic diarrhoea", shape=octagon, fillcolor="#C5E1A5", color="#33691E"];
  }

