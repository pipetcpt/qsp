     ================================================================ */
  subgraph cluster_isrx {
    label="16 · 면역조절 치료 (Immunomodulation) — ARM 2 치료, 그리고 그 대가";
    style="filled,rounded"; color="#4527A0"; fillcolor="#EDE7F6"; fontsize=11;
    node [shape=hexagon, fillcolor="#B39DDB", color="#4527A0"];

