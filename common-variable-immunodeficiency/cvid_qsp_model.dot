  T_ICOS   -> B_GC;
  T_CD40L  -> B_AID      [label="the canonical\nCSR signal"];
  T_IL21   -> B_PBLAST;
  T_IL21   -> B_AID;
  T_IL10   -> B_PBLAST;
  T_TREG   -> T_TFH      [arrowhead=tee];
  T_TREG   -> T_CD8ACT   [arrowhead=tee];
  T_TREG   -> U_TOLBRK   [arrowhead=tee];
  T_CTLA4  -> T_TREG     [label="suppressive\nfunction"];
  T_CD4N   -> K_CD4N;
  T_CD4N   -> T_LYMPHOP  [arrowhead=tee];
  T_LYMPHOP -> X_PJP;
  T_LYMPHOP -> Z_PJP;
  T_CD8ACT -> T_IFNG;
  T_TFH    -> T_IFNG     [label="Th1 skew"];
  T_IFNG   -> L_TH1;
