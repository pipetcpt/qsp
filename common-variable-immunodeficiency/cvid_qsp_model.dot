    U_HGB     [label="헤모글로빈\nHaemoglobin", shape=diamond, fillcolor="#F48FB1"];
    U_ORGAN   [label="장기 특이 자가면역\nThyroiditis, vitiligo,\nalopecia, pernicious anaemia,\ntype 1 diabetes"];
    U_ARTH    [label="염증성 관절염 / 건선\nInflammatory arthritis,\npsoriasis, uveitis"];
    U_BLEED   [label="출혈 사건\nBleeding event", shape=octagon, fillcolor="#EF9A9A", color="#C62828"];
  }

  /* ================================================================
     13. ENTEROPATHY, PROTEIN LOSS AND STOMACH
     ================================================================ */
  subgraph cluster_gut {
    label="13 · 장병증·단백소실·위 (Enteropathy, Protein Loss & Stomach) — ARM 2 + PK로의 되먹임";
