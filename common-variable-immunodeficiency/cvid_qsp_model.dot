    U_AIHA    [label="자가면역 용혈성 빈혈\nAIHA (~5-7%)"];
    U_EVANS   [label="에반스 증후군\nEvans syndrome\n(ITP + AIHA)"];
    U_NEUTRO  [label="자가면역 호중구감소증\nAutoimmune neutropenia"];
