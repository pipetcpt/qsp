  D_TARGFIX -> R_TROUGH;
  D_TARGEFF -> R_TROUGH  [label="escalate until\nevent-free"];

  /* PROTECTION TO PATHOGEN */
  R_OPSPH  -> X_SPN      [arrowhead=tee];
  R_OPSPH  -> X_HI       [arrowhead=tee];
  R_OPSPH  -> X_MCAT     [arrowhead=tee];
