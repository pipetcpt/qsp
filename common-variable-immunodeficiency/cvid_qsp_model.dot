  /* THE BRONCHIECTASIS RATCHET — bold red vicious circle */
  X_COLON  -> W_IL8      [color="#B71C1C", penwidth=2.0];
  W_IL8    -> I_NEUT     [color="#B71C1C", penwidth=2.0];
  I_NEUT   -> W_NE       [color="#B71C1C", penwidth=2.0];
