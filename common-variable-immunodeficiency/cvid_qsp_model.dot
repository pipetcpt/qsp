  E_INFLAM -> E_DIARR;
  E_ATROPH -> E_PA;
  E_HP     -> E_ATROPH;
  E_ATROPH -> M_GASTRIC;
  E_HP     -> M_GASTRIC;
  E_INFLAM -> N_MORTNON;
  E_ALB    -> N_QOL;
