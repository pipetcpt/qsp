    D_FSCIG   [label="fSCIG (hyaluronidase-\nfacilitated)\nfull monthly dose SC q3-4 weeks"];
    D_SCIGFREQ [label="SCIG 빈도 변형\nDaily / 2× weekly /\nbiweekly SCIG — the flatness\nknob"];
    D_TARGFIX [label="고정 trough 목표\nFIXED TARGET strategy:\n500 vs 700 vs 1000 mg/dL"];
    D_TARGEFF [label="효과 도달 전략\nTREAT-TO-EFFECT:\nescalate until infection-free\n(Bonagura)"];
    D_HOME    [label="자가 가정 요법\nHome therapy, wearable pump\n— adherence and QoL driver"];
    D_LOADING [label="부하 용량\nLoading strategy —\nor accept 3-6 months to\nsteady state (5 half-lives)"];
  }

