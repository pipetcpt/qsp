  subgraph cluster_autoim {
    label="12 · 자가면역 세포감소증 (Autoimmune Cytopenias & Other Autoimmunity) — ARM 2";
    style="filled,rounded"; color="#AD1457"; fillcolor="#FCE4EC"; fontsize=11;
    node [shape=box, fillcolor="#F8BBD0", color="#AD1457"];

