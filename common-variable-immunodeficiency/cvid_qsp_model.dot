  T_TEMRA  -> M_SURV     [arrowhead=tee];
  T_ANERGY -> B_GC       [arrowhead=tee];
  T_IL6    -> N_QOL      [arrowhead=tee];
  T_CXCL13 -> K_CXCL13B;
