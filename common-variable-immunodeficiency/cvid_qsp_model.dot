  W_WALL   -> W_BE       [color="#B71C1C", penwidth=2.2, label="IRREVERSIBLE\nincrement"];
  W_BE     -> W_MCC      [color="#B71C1C", penwidth=2.0, arrowhead=tee];
  W_MCC    -> W_MUCUS    [color="#B71C1C", penwidth=2.0, arrowhead=tee];
  W_MUCUS  -> X_COLON    [color="#B71C1C", penwidth=2.2, label="the loop closes:\ndestroyed airway\nis colonised airway"];
  X_PNEU   -> W_WALL     [color="#B71C1C", penwidth=2.0, label="each event\ndeposits damage"];
  W_AAT    -> W_NE       [arrowhead=tee];
  W_NE     -> W_AAT      [arrowhead=tee, label="overwhelmed"];
  W_BE     -> X_PSA      [label="late acquisition"];
  W_BE     -> W_TRAP;
  W_BE     -> W_FEV1     [arrowhead=tee];
  W_BE     -> W_FEV1IRR;
  W_TRAP   -> W_FEV1     [arrowhead=tee];
  W_MUCUS  -> W_FEV1     [arrowhead=tee];
  W_FEV1IRR -> W_FEV1    [arrowhead=tee, penwidth=1.6];
  W_BE     -> W_EXAC;
  X_SINO   -> W_EXAC;
  W_EXAC   -> W_WALL;
  W_BE     -> W_HAEM;
  W_BE     -> K_HRCTB;
  W_FEV1   -> K_SPIRO;
  W_DLCO   -> K_SPIRO;

  /* GLILD — ARM 2 LUNG */
  T_TFH    -> L_LYMPHAGG;
  B_CD21LO -> L_LYMPHAGG;
  T_CXCL13 -> L_LYMPHAGG [label="ectopic GC\norganisation"];
  L_LYMPHAGG -> L_FOLLBR;
  L_FOLLBR -> L_LIP;
  L_LIP    -> L_GLILD;
  L_NSIP   -> L_GLILD;
  L_GRAN   -> L_GLILD;
  L_TH1    -> L_GRAN;
  L_LYMPHAGG -> L_GLILD;
  L_GLILD  -> L_FIBRO;
  L_FIBRO  -> L_FIB      [label="years"];
  L_FIB    -> L_REST     [penwidth=1.6];
  L_GLILD  -> L_REST;
  L_REST   -> W_DLCO     [arrowhead=tee];
  L_FIB    -> L_PH;
  L_GLILD  -> L_HRCT;
  L_HRCT   -> K_HRCTB;
  L_GLILD  -> N_GLILDPROG;
  L_PH     -> N_MORTNON;
  L_FIB    -> N_MORTNON  [penwidth=1.6];
  I_LPS    -> L_TH1      [style=dashed, label="translocation feeds\nthe Th1 arm"];

  /* THE DELIBERATE NULL: replacement does not touch GLILD */
  R_TROUGH -> L_GLILD    [arrowhead=none, style=dotted, color="#7B1FA2", penwidth=2.0,
                          label="★ STRUCTURAL NULL\nno edge — maximal IgG\nreplacement does NOT\nmodify GLILD", fontcolor="#7B1FA2"];

  /* LYMPHOPROLIFERATION AND LIVER */
  T_CD8ACT -> Y_LAD;
  B_CD21LO -> Y_SPLEEN;
  Y_LAD    -> Y_SPLEEN;
  Y_SPLEEN -> Y_HYPERSP;
  Y_HYPERSP -> U_PLT     [arrowhead=tee];
  L_GRAN   -> Y_NRH;
  Y_NRH    -> Y_PORTAL;
  Y_PORTAL -> N_MORTNON;
  Y_NRH    -> Y_ALP;
  Y_SPLEEN -> Y_SPLENEC  [style=dashed, label="historical\nresponse to\nrefractory ITP"];
  U_ITP    -> Y_SPLENEC  [style=dashed];
  Y_SPLENEC -> Y_ASPLEN;
  Y_SPLENEC -> U_PLT     [label="raises platelets"];
  Y_ASPLEN -> X_INVAS    [penwidth=1.8, color="#BF360C",
                          label="MULTIPLICATIVE with\nabsent opsonising\nantibody"];
  Y_ALP    -> K_A1AT     [style=invis];

  /* AUTOIMMUNE CYTOPENIAS */
  U_TOLBRK -> U_AUTOAB;
  B_CD21LO -> U_AUTOAB   [label="autoreactive\npool"];
  T_TFH    -> U_AUTOAB;
  U_AUTOAB -> U_ITP;
  U_AUTOAB -> U_AIHA;
  U_AUTOAB -> U_NEUTRO;
  U_ITP    -> U_EVANS;
  U_AIHA   -> U_EVANS;
  U_ITP    -> U_PLT      [arrowhead=tee];
