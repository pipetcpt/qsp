  /* IMMUNOMODULATION — MECHANISM OF ACTION */
  S_RTX    -> B_NAIVE    [arrowhead=tee, color="#4527A0"];
  S_RTX    -> B_MEM      [arrowhead=tee, color="#4527A0"];
  S_RTX    -> B_CD21LO   [arrowhead=tee, color="#4527A0", penwidth=1.6];
  S_RTX    -> U_AUTOAB   [arrowhead=tee, color="#4527A0", penwidth=1.6];
  S_RTX    -> A_SINK     [arrowhead=tee, color="#4527A0",
                          label="depleting the sink\ndrives BAFF UP"];
  S_RTX    -> P_ENDOG    [arrowhead=tee, color="#4527A0", style=dashed,
                          label="a cost ALREADY PAID\nin CVID — this is why\nRTX is comparatively\ncheap here"];
  S_RTX    -> L_LYMPHAGG [arrowhead=tee, color="#4527A0"];
  S_AZA    -> T_CD4M     [arrowhead=tee, color="#4527A0"];
  S_AZA    -> L_GLILD    [arrowhead=tee, color="#4527A0"];
  S_GC     -> L_GLILD    [arrowhead=tee, color="#4527A0", label="fast"];
  S_GC     -> U_AUTOAB   [arrowhead=tee, color="#4527A0"];
  S_GC     -> V_GCTOX    [color="#E65100"];
  S_ABA    -> T_TFH      [arrowhead=tee, color="#4527A0",
                          label="replaces missing\nCTLA-4 function"];
  S_ABA    -> T_CTLA4    [label="pharmacological\nsubstitute", color="#4527A0", style=dashed];
  S_ABA    -> E_INFLAM   [arrowhead=tee, color="#4527A0"];
  S_SIRO   -> Y_LAD      [arrowhead=tee, color="#4527A0"];
  S_SIRO   -> E_INFLAM   [arrowhead=tee, color="#4527A0"];
  S_SIRO   -> T_CD4M     [arrowhead=tee, color="#4527A0"];
  S_LENIO  -> G_PIK3CD   [arrowhead=tee, color="#4527A0", penwidth=1.8,
                          label="genotype-matched:\nblocks the hyperactive\nPI3Kδ directly"];
  S_LENIO  -> Y_LAD      [arrowhead=tee, color="#4527A0", penwidth=1.6];
  S_LENIO  -> B_NAIVE    [color="#4527A0", label="naive B % RISES\n(the block is relieved)"];
  S_LENIO  -> B_TRANS    [arrowhead=tee, color="#4527A0"];
  S_JAK    -> T_IFNG     [arrowhead=tee, color="#4527A0"];
  S_JAK    -> L_GLILD    [arrowhead=tee, color="#4527A0"];
  S_TPO    -> U_PLT      [color="#4527A0", label="raises platelets\nWITHOUT immunosuppression"];
  S_HSCT   -> B_PROB     [color="#4527A0", style=dashed, label="replaces the\nhaematopoietic system"];
  S_HSCT   -> T_TREG     [color="#4527A0", style=dashed];
  S_VEDO   -> E_INFLAM   [arrowhead=tee, color="#4527A0"];

  /* NET IMMUNOSUPPRESSION AND ITS PRICE */
  S_RTX    -> S_ISBURD;
  S_AZA    -> S_ISBURD;
  S_GC     -> S_ISBURD;
  S_ABA    -> S_ISBURD;
  S_SIRO   -> S_ISBURD;
  S_JAK    -> S_ISBURD;
  S_LENIO  -> S_ISBURD   [style=dashed, label="低 — targeted"];
  S_ISBURD -> V_OPPINF   [penwidth=1.8, color="#E65100"];
  S_ISBURD -> X_SINO     [penwidth=1.6, color="#E65100",
                          label="ARM 2 therapy\nfeeds ARM 1 disease"];
  S_ISBURD -> V_MALIGIS  [color="#E65100"];
  S_ISBURD -> T_LYMPHOP  [color="#E65100"];
  V_OPPINF -> N_MORTINF;
  S_HSCT   -> V_OPPINF   [color="#E65100", label="transplant-related\nmortality"];

  /* ANTIMICROBIAL AND SUPPORTIVE */
  Z_AZM    -> X_COLON    [arrowhead=tee, color="#00695C", penwidth=1.6];
  Z_AZM    -> W_IL8      [arrowhead=tee, color="#00695C", label="anti-inflammatory,\nindependent of\nantibacterial effect"];
  Z_AZM    -> Z_ABXRES   [color="#EF6C00"];
  Z_ABXACUTE -> X_PNEU   [arrowhead=tee, color="#00695C"];
  Z_ABXACUTE -> Z_ABXRES [color="#EF6C00"];
  Z_INHABX -> X_PSA      [arrowhead=tee, color="#00695C"];
  Z_PHYSIO -> W_MUCUS    [arrowhead=tee, color="#00695C"];
  Z_PHYSIO -> W_MCC      [color="#00695C"];
  Z_PJP    -> X_PJP      [arrowhead=tee, color="#00695C"];
  Z_VACC   -> R_SPECAB   [color="#00695C", style=dashed, label="weak but non-zero"];

  /* REPLACEMENT ADVERSE EFFECTS */
  P_IVINF  -> V_SYSAE    [color="#E65100", label="rate-dependent"];
  P_SCDEP  -> V_LOCAE    [color="#E65100"];
  P_IVINF  -> V_THROMB   [color="#E65100"];
  P_IVINF  -> V_HAEMOL   [color="#E65100"];
  P_IVINF  -> V_AKI      [color="#E65100", style=dashed];
  P_IVINF  -> V_ASEPMEN  [color="#E65100"];
  D_HOME   -> V_BURDEN   [arrowhead=tee, color="#00695C"];
  D_IVIG   -> V_BURDEN   [color="#E65100"];
  D_SCIG   -> V_BURDEN   [color="#E65100", label="52 infusions/y\nbut at home"];
  D_FSCIG  -> V_BURDEN   [arrowhead=tee, color="#00695C",
                          label="monthly SC —\nfewest sticks"];
  V_BURDEN -> N_QOL      [arrowhead=tee];
  V_SYSAE  -> N_QOL      [arrowhead=tee];
  V_LOCAE  -> N_QOL      [arrowhead=tee];

  /* DIAGNOSTIC DELAY DRIVES THE RATCHET */
  N_ONSET  -> N_DELAY    [penwidth=1.8];
  N_NBSGAP -> N_DELAY    [penwidth=1.6, label="no screening net\nto shorten it"];
  N_DELAY  -> W_BE       [penwidth=2.2, color="#B71C1C", style=dashed,
                          label="★ THE PRICE OF DELAY:\nthe ratchet runs UNOPPOSED\nfor 4-7 years and the\nirreversible floor is set\nBEFORE therapy starts"];
  N_DELAY  -> X_PNEU     [penwidth=1.6, color="#B71C1C", style=dashed];
  N_DELAY  -> W_FEV1IRR  [penwidth=1.6, color="#B71C1C", style=dashed];

  /* ENDPOINTS */
  X_PNEU   -> N_PNEURATE [penwidth=1.6];
  X_SINO   -> N_INFDAYS;
  Z_ABXACUTE -> N_INFDAYS;
  W_FEV1   -> N_FEV1SLOPE;
  W_FEV1IRR -> N_FEV1SLOPE [penwidth=1.6];
  W_BE     -> N_BEPROG;
  X_PNEU   -> N_HOSP;
  W_EXAC   -> N_HOSP;
  X_INVAS  -> N_MORTINF  [penwidth=1.6];
  N_MORTINF -> N_SURV    [arrowhead=tee];
  N_MORTNON -> N_SURV    [arrowhead=tee, penwidth=2.0];
  N_PNEURATE -> N_QOL    [arrowhead=tee];
  N_FEV1SLOPE -> N_QOL   [arrowhead=tee];
  N_GLILDPROG -> N_SURV  [arrowhead=tee];
  N_QOL    -> K_PROM;
  E_DIARR  -> N_QOL      [arrowhead=tee];
  U_BLEED  -> N_HOSP;

  /* DIAGNOSTIC CRITERIA READOUTS */
  P_TOTAL  -> K_IGAM     [style=invis];
  B_MEMIGM -> K_IGAM;
  B_LAMINA -> K_IGAM;

  /* ================================================================
     ANNOTATION PANELS
     ================================================================ */
  subgraph cluster_note1 {
    label="";
    style="filled,rounded"; color="#0D47A1"; fillcolor="#E3F2FD"; fontsize=10;
    NOTE_ER [shape=note, fillcolor="#FFFDE7", color="#F9A825", fontsize=9,
      label=<<b>ARM 1 — the calibrated exposure-response</b><br align="left"/>
      <br align="left"/>
      Orange 2010, meta-regression of 17 IVIG studies:<br align="left"/>
      pneumonia incidence falls <b>27% per 100 mg/dL</b> IgG trough.<br align="left"/>
      <br align="left"/>
      This model keeps that slope but implements it as<br align="left"/>
      <b>rate = R0 · exp(−k·(IgG−500))</b>, k = ln(1/0.73)/100<br align="left"/>
      = 0.003147 dL/mg, anchored at 0.113 pneumonia/py at 500 mg/dL.<br align="left"/>
      <br align="left"/>
      The often-quoted corollary — zero pneumonia at a trough of<br align="left"/>
      1400 mg/dL — is an artefact of fitting a <i>straight line</i> to<br align="left"/>
      a ratio. The exponential form preserves the measured slope<br align="left"/>
      without predicting sterile protection, and produces a<br align="left"/>
      diminishing-returns knee near 800-1000 mg/dL instead.<br align="left"/>>];
  }

  subgraph cluster_note2 {
    label="";
    style="filled,rounded"; color="#4A148C"; fillcolor="#F3E5F5"; fontsize=10;
    NOTE_ARM2 [shape=note, fillcolor="#FFFDE7", color="#F9A825", fontsize=9,
      label=<<b>ARM 2 — why replacement is not enough</b><br align="left"/>
      <br align="left"/>
      Resnick 2012 (473 patients, 4 decades):<br align="left"/>
      • no non-infectious complication → near-normal survival<br align="left"/>
      • any non-infectious complication → mortality <b>RR ≈ 11×</b><br align="left"/>
      <br align="left"/>
      Chapel 2008 defined five mutually near-exclusive phenotypes:<br align="left"/>
      no complications / autoimmunity / polyclonal<br align="left"/>
      lymphoproliferation / enteropathy / lymphoid malignancy.<br align="left"/>
      <br align="left"/>
      Every ARM 2 drug on this map costs net immunosuppression,<br align="left"/>
      which loops straight back into ARM 1. That loop —<br align="left"/>
      <i>treating dysregulation makes infection worse</i> — is the<br align="left"/>
      second of the model's four trade-offs.<br align="left"/>>];
  }

  subgraph cluster_note3 {
    label="";
    style="filled,rounded"; color="#B71C1C"; fillcolor="#FFEBEE"; fontsize=10;
    NOTE_RATCHET [shape=note, fillcolor="#FFFDE7", color="#F9A825", fontsize=9,
      label=<<b>THE RATCHET — why timing beats dose</b><br align="left"/>
      <br align="left"/>
      colonisation → IL-8 → neutrophil elastase → wall destruction<br align="left"/>
      → <b>bronchiectasis (irreversible)</b> → impaired clearance<br align="left"/>
      → mucus stasis → <i>more colonisation</i><br align="left"/>
      <br align="left"/>
      A positive feedback loop with an irreversible state inside it.<br align="left"/>
      Two patients with the identical steady-state trough have<br align="left"/>
      permanently different FEV1 if one was diagnosed at year 1<br align="left"/>
      and the other at year 7. Replacement stops the ratchet;<br align="left"/>
      it does not rewind it.<br align="left"/>
      <br align="left"/>
      Consequence: the most valuable intervention in CVID is not a<br align="left"/>
      better immunoglobulin. It is an earlier serum IgG measurement.<br align="left"/>>];
  }

  NOTE_ER      -> R_TROUGH   [style=invis];
  NOTE_ARM2    -> L_GLILD    [style=invis];
  NOTE_RATCHET -> W_BE       [style=invis];
}
