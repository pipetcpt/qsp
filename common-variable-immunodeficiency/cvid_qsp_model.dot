  /* ================================================================
     20. DIAGNOSTIC DELAY, ENDPOINTS AND MORTALITY
     ================================================================ */
  subgraph cluster_end {
    label="20 · 진단 지연·임상 종점·사망 (Diagnostic Delay, Endpoints & Mortality)";
    style="filled,rounded"; color="#212121"; fillcolor="#FAFAFA"; fontsize=11;
    node [shape=octagon, fillcolor="#E0E0E0", color="#424242"];

    N_ONSET   [label="증상 발생\nFirst symptom\n(often childhood)", shape=box, fillcolor="#EEEEEE"];
    N_DELAY   [label="진단 지연\nDIAGNOSTIC DELAY\nmedian 4-7 years\n(historically up to 10)\n★ the ratchet's runtime", penwidth=2.0, fillcolor="#BDBDBD"];
    N_NBSGAP  [label="신생아 스크리닝 공백\nTREC/KREC newborn screening\nDOES NOT detect CVID\n— onset is post-thymic and\noften adult", shape=box, fillcolor="#EEEEEE"];
    N_PNEURATE [label="연간 폐렴률\nAnnual pneumonia rate\n(events/patient-year)"];
    N_INFDAYS [label="연간 감염 일수\nInfection days / year,\nIV antibiotic courses"];
    N_FEV1SLOPE [label="FEV1 하강 기울기\nFEV1 decline (mL/year)"];
    N_BEPROG  [label="기관지확장증 진행\nBronchiectasis progression\non serial HRCT"];
    N_GLILDPROG [label="GLILD 진행\nGLILD progression /\nrespiratory failure"];
    N_HOSP    [label="입원\nHospitalisation rate"];
    N_QOL     [label="삶의 질\nHealth-related QoL"];
    N_MORTINF [label="감염 관련 사망\nInfection-attributable\nmortality — LOW once\nreplaced"];
    N_MORTNON [label="비감염 합병증 사망\nNON-INFECTIOUS-complication\nmortality — RR ≈ 11×\n(Resnick 2012)\n★ what actually kills", penwidth=2.0, fillcolor="#9E9E9E"];
    N_SURV    [label="생존\nOverall survival\n(median ~good if uncomplicated;\nsharply worse with GLILD,\nenteropathy or NRH)"];
  }

  /* ================================================================
     EDGES — GENETICS TO CELLULAR PHENOTYPE
     ================================================================ */
  G_TACI    -> B_AID     [style=dashed];
  G_TACI    -> A_TACI    [style=dashed];
  G_TACI    -> U_TOLBRK  [style=dashed, label="autoimmunity\nenriched"];
  G_BAFFR   -> A_BAFFR   [style=dashed];
  G_BAFFR   -> B_NAIVE   [style=dashed];
  G_CTLA4   -> T_CTLA4   [arrowhead=tee, style=dashed];
  G_LRBA    -> T_LRBAREC [arrowhead=tee, style=dashed];
  T_LRBAREC -> T_CTLA4;
  G_NFKB1   -> A_TRAF    [arrowhead=tee, style=dashed];
  G_NFKB2   -> A_TRAF    [arrowhead=tee, style=dashed];
  G_PIK3CD  -> B_TRANS   [style=dashed, label="senescent\ntransitional B"];
  G_PIK3CD  -> T_TEMRA   [style=dashed];
  G_PIK3CD  -> Y_LAD     [style=dashed];
  G_ICOS    -> T_ICOS    [arrowhead=tee, style=dashed];
  G_CD19    -> B_ANERGY  [style=dashed];
  G_TWEAK   -> A_TRAF    [style=dashed];
  G_IKZF1   -> B_NAIVE   [arrowhead=tee, style=dashed];
  G_ARHGEF1 -> B_MEM     [arrowhead=tee, style=dashed];
  G_POLY    -> B_AID     [style=dashed];
  G_SOMATIC -> A_TRAF    [style=dashed];
  G_YIELD   -> S_LENIO   [style=dashed, label="genotype-directed\ntherapy needs a genotype"];
  G_YIELD   -> S_ABA     [style=dashed];
  G_YIELD   -> S_HSCT    [style=dashed];

  /* B-CELL DEVELOPMENT CHAIN */
  B_PROB   -> B_IMM;
  B_IMM    -> B_TRANS;
  B_TRANS  -> B_NAIVE;
  B_NAIVE  -> B_ACT;
  B_ACT    -> B_GC;
  B_GC     -> B_AID;
  B_GC     -> B_SHM;
  B_AID    -> B_MEM      [label="★ THE BLOCK"];
  B_SHM    -> B_MEM;
  B_GC     -> B_PBLAST;
  B_PBLAST -> B_PCSHORT;
  B_PBLAST -> B_PCLONG;
  B_MEM    -> B_PBLAST   [label="recall"];
  B_NAIVE  -> B_MEMIGM   [label="T-independent,\nTACI-dependent"];
  B_MEMIGM -> B_PCSHORT;
  B_ANERGY -> B_ACT      [arrowhead=tee];
  B_NAIVE  -> B_CD21LO   [label="chronic\nactivation"];
  B_CD21LO -> B_EURO;
  B_MEM    -> B_EURO;
  B_TRANS  -> B_EURO;
  B_CD21LO -> B_FREIB;
  B_PCLONG -> P_ENDOG;
  B_PCSHORT -> P_ENDOG;
  B_MEM    -> B_LAMINA   [arrowhead=tee];
  B_LAMINA -> I_IGAMUC;
  B_MEM    -> K_SMB;
  B_CD21LO -> K_CD21;
  B_PCLONG -> K_FLC;

  /* BAFF AXIS */
  A_BAFF   -> A_BAFFR;
  A_BAFF   -> A_TACI;
  A_APRIL  -> A_TACI;
  A_APRIL  -> A_BCMA;
  A_BAFFR  -> A_TRAF;
  A_TACI   -> A_TRAF;
  A_BCMA   -> A_TRAF;
  A_TRAF   -> B_NAIVE    [label="survival"];
  A_TRAF   -> B_AID;
  A_TRAF   -> B_PCLONG;
  B_NAIVE  -> A_SINK     [label="receptor-mediated\nBAFF consumption"];
  B_MEM    -> A_SINK;
  A_SINK   -> A_BAFF     [arrowhead=tee];
  B_PCLONG -> A_SBCMA;
  A_SBCMA  -> A_APRIL    [arrowhead=tee, label="decoy"];
  A_BAFF   -> K_BAFFB;
  A_TACI   -> B_ACT      [arrowhead=tee, label="negative\nregulation"];

  /* T-CELL HELP AND REGULATION */
  T_THYMUS -> T_CD4N;
  T_CD4N   -> T_CD4M;
  T_CD4M   -> T_TFH;
  T_TFH    -> T_ICOS;
  T_TFH    -> T_CD40L;
  T_TFH    -> T_IL21;
