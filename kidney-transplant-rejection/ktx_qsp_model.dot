/* =====================================================================
   Kidney Transplant Rejection & Immunosuppression — QSP Mechanistic Map
   ---------------------------------------------------------------------
   The organising idea of this map (and of ktx_mrgsolve_model.R):

   A kidney transplant is the only "disease" in this library in which the
   pathology is CAUSED BY THE PATIENT'S OWN INTACT IMMUNE SYSTEM doing
   exactly what it is supposed to do, and in which the therapeutic target
   is therefore not a pathway but a SET POINT.  Everything here is drawn
   around one axis:

        NET IMMUNOSUPPRESSION (NIS)
        too little  ->  alloimmunity  ->  TCMR / dnDSA / ABMR  ->  graft loss
        too much    ->  BK virus, CMV, PTLD, sepsis            ->  graft loss

   The map is therefore a U-SHAPED TRADE-OFF, not a cascade, and the two
   arms are drawn as two competing loops that converge on the same
   endpoint box (death-censored graft failure).  Between them sits the
   thing a transplant clinician actually manipulates: drug exposure.

   Three feedback loops close the system:

     LOOP 1  (alloimmune amplification)
         graft injury -> DAMPs -> more antigen presentation + more
         endothelial activation -> more effector traffic -> more injury

     LOOP 2  (nephron-mass / hyperfiltration, Brenner)
         nephron loss -> single-nephron hyperfiltration -> TGF-beta ->
         IFTA -> further nephron loss.  This loop is drug-independent
         and is why every graft eventually declines even without rejection

     LOOP 3  (the clinical control loop)
         viraemia / rejection -> clinician moves NIS -> the OTHER arm of
         the U worsens.  BK screening with pre-emptive IS reduction is
         implemented as a genuine closed-loop controller in the R model,
         not as a scripted dose change

   Why the drugs are placed where they are:

     ATG (rabbit)        depletes the T-cell pool itself (signal-independent)
     basiliximab         blocks CD25 -> caps IL-2-driven clonal expansion
     tacrolimus / CsA    block calcineurin -> NFAT -> IL-2 transcription
                         (signal 1->3 coupling) AND constrict the afferent
                         arteriole and drive arteriolar hyalinosis - the
                         same molecule creates the benefit and the toxicity
     mycophenolate       blocks IMPDH -> de novo purine synthesis, on which
                         lymphocytes uniquely depend -> blocks PROLIFERATION
                         of both T and B arms (and of marrow -> leucopenia)
     belatacept          blocks CD80/86-CD28 signal 2 -> profound effect on
                         NAIVE T cells and on the B-cell help that generates
                         dnDSA, but CD28-null CD57+ memory T cells escape:
                         less dnDSA, better GFR, MORE early TCMR
     corticosteroids     trans-repress NF-kB/AP-1 across APC and T cells
     mTOR inhibitors     block signal 3 downstream of CD25, spare the
                         afferent arteriole, favour Treg, but impair tubular
                         repair and cause proteinuria
     rituximab           depletes CD20+ B cells but NOT CD20-negative
                         long-lived plasma cells -> DSA barely moves
                         (this is drawn explicitly - it is why RITUX-ERAH
                         was negative)
     anti-CD38           reaches the plasma-cell compartment rituximab
     (felzartamab)       cannot, and additionally disarms NK ADCC
     tocilizumab /       IL-6R blockade -> less Tfh help, slower plasmablast
     clazakizumab        generation -> DSA falls slowly over months
     eculizumab          blocks C5 -> stops MAC but NOT C4d, NK ADCC or
                         the non-complement endothelial arm
     imlifidase (IdeS)   cleaves circulating IgG within hours - the only
                         intervention that can remove DSA faster than the
                         plasma cells remake it
     PLEX                first-order removal of circulating IgG only

   Render:
     dot -Tsvg ktx_qsp_model.dot -o ktx_qsp_model.svg
     dot -Tpng -Gdpi=150 ktx_qsp_model.dot -o ktx_qsp_model.png
   ===================================================================== */

digraph KTX_QSP {
    rankdir = TB;
    compound = true;
    newrank = true;
    splines = spline;
    concentrate = false;
    nodesep = 0.24;
    ranksep = 0.55;
    fontname = "Helvetica";
    labelloc = "t";
    label = <<b>Kidney Transplant Rejection &amp; Immunosuppression — Quantitative Systems Pharmacology Map</b><br/>
             <font point-size="13">donor antigen &#8594; allorecognition &#8594; T-cell and B-cell effector arms &#8594; TCMR / DSA / ABMR &#8594; nephron loss &#8594; graft failure,<br/>
             held in balance against BK / CMV / malignancy by one manipulable quantity: net immunosuppression</font><br/>
             <font point-size="11">20 mechanistic modules · 243 nodes · 385 edges · states carried as ODEs in ktx_mrgsolve_model.R are drawn with a double border</font>>;
    fontsize = 22;
    bgcolor = "white";

    node [shape = box, style = "rounded,filled", fontname = "Helvetica",
          fontsize = 10, penwidth = 1.0, margin = "0.09,0.05"];
    edge [fontname = "Helvetica", fontsize = 8, color = "#5c6670",
          arrowsize = 0.62, penwidth = 0.9];

    /* ---------- shared visual vocabulary ------------------------------
       double border (peripheries=2) = ODE state in the mrgsolve model
       octagon                       = drug / intervention
       hexagon                       = clinical endpoint / read-out
       diamond                       = regulatory switch or decision node
       parallelogram                 = flux / transfer process
       red edge                      = inhibition / antagonism
       green edge                    = restorative / protective
       orange edge                   = amplifying (positive-feedback) arm
       ---------------------------------------------------------------- */

    /* ================================================================
       1. DONOR AND RECIPIENT — THE FIXED RISK SET
       ================================================================ */
    subgraph cluster_risk {
        label = "1. Donor / recipient risk set — everything that is fixed before the anastomosis";
        style = "filled,rounded"; fillcolor = "#f4f1ec"; color = "#b9ae9c";
        fontsize = 13; fontcolor = "#6b5f4b";
        node [fillcolor = "#efe8dc", color = "#a99a80"];

        D_TYPE    [label = "Donor type\nliving > DBD > DCD\nDCD adds warm ischaemia", shape = diamond, fillcolor = "#e5dbc6"];
        D_KDPI    [label = "KDPI / KDRI\ndonor age, HTN, DM, Cr, HCV, DCD\nsets NEPHRON DOSE handed over", shape = diamond, fillcolor = "#e5dbc6"];
        D_AGE     [label = "Donor age\n> 60 y: fewer, sclerotic glomeruli\nlower repair reserve"];
        D_MASS    [label = "Transplanted nephron mass\n~ 0.9-1.1 x 10^6 glomeruli (1 kidney)\nvs 2.0-2.4 x 10^6 native"];
        D_CIT     [label = "Cold ischaemia time (h)\neach +1 h: ~1.3% higher graft failure risk"];
        D_MP      [label = "Machine perfusion vs static cold storage", shape = octagon, fillcolor = "#f0e6d2"];
        R_HLAMM   [label = "HLA A/B/DR mismatch (0-6)\nclassical antigen-level matching", shape = diamond, fillcolor = "#e5dbc6"];
        R_EPLET   [label = "HLA-DR/DQ eplet mismatch load\nmolecular mismatch, better dnDSA predictor\nthreshold ~ 10 DR / 17 DQ eplets", shape = diamond, fillcolor = "#e5dbc6"];
        R_CPRA    [label = "cPRA / sensitisation\nprior transplant, transfusion, pregnancy\ncPRA > 80% = high immunological risk", shape = diamond, fillcolor = "#e5dbc6"];
        R_PREDSA  [label = "Preformed DSA\npositive XM or DSA+/XM- (incompatible)"];
        R_CYP3A5  [label = "CYP3A5 *1/*3 genotype\nEXPRESSER (*1 carrier) clears tacrolimus ~1.5-2x faster\n~15-25% of Europeans, 50-80% of Africans, ~25% East Asians", shape = diamond, fillcolor = "#e5dbc6"];
        R_ABCB1   [label = "ABCB1 (P-gp) haplotype\nenterocyte efflux, modest effect on F"];
        R_AGE     [label = "Recipient age / immunosenescence\nolder = weaker alloresponse, higher infection risk"];
        R_RACE    [label = "Ancestry\nhigher CYP3A5 expresser frequency,\nAPOL1 donor risk variants"];
        R_BMI     [label = "Body weight / BMI\nfixed mg/kg dosing overshoots in obesity"];
        R_PRIM    [label = "Primary renal disease\nrecurrence risk (FSGS, IgAN, aHUS, MPGN)"];
        R_ADHRISK [label = "Adherence risk profile\nadolescent/young adult, low health literacy,\ndepression, cost, pill burden", shape = diamond, fillcolor = "#e5dbc6"];
        R_CMVSER  [label = "CMV serostatus D+/R-\nhighest-risk mismatch", shape = diamond, fillcolor = "#e5dbc6"];
    }

    /* ================================================================
       2. ISCHAEMIA-REPERFUSION INJURY AND DELAYED GRAFT FUNCTION
       ================================================================ */
    subgraph cluster_iri {
        label = "2. Ischaemia-reperfusion injury · innate priming · delayed graft function";
        style = "filled,rounded"; fillcolor = "#fdeeee"; color = "#e2a3a3";
        fontsize = 13; fontcolor = "#9b3535";
        node [fillcolor = "#fadede", color = "#d38b8b"];

        I_ATP     [label = "Tubular ATP depletion\nNa+/K+-ATPase failure, cytoskeletal collapse"];
        I_ROS     [label = "Reperfusion ROS burst\nxanthine oxidase, mitochondrial complex I"];
        I_MPT     [label = "Mitochondrial permeability transition\ncytochrome c release", shape = parallelogram, fillcolor = "#f6cccc"];
        I_NEC     [label = "Acute tubular necrosis / ferroptosis\nproximal S3 segment most vulnerable", shape = parallelogram, fillcolor = "#f6cccc"];
        I_AKI     [label = "AKI\nacute tubular injury burden (recoverable)", peripheries = 2, fillcolor = "#f4c3c3"];
        I_DAMP    [label = "DAMP\nHMGB1 · HSP70 · uric acid · mtDNA · ATP", peripheries = 2, fillcolor = "#f4c3c3"];
        I_TLR     [label = "TLR2 / TLR4 · NLRP3 inflammasome\nsterile innate activation", shape = parallelogram, fillcolor = "#f6cccc"];
        I_COMP    [label = "Complement activation on ischaemic endothelium\nlectin + alternative pathway"];
        I_NEUT    [label = "Neutrophil / monocyte influx\nICAM-1, P-selectin, IL-8"];
        I_KIM1    [label = "Tubular injury markers\nKIM-1 · NGAL · urinary CXCL9/10"];
        I_DGF     [label = "Delayed graft function\ndialysis within 7 days · ~25% DBD, ~50% DCD", shape = hexagon, fillcolor = "#f0b3b3"];
        I_REPAIR  [label = "Tubular regeneration\nsurviving epithelium dedifferentiates and repopulates", shape = parallelogram, fillcolor = "#f6cccc"];
        I_MALREP  [label = "Maladaptive repair\nG2/M arrest, senescence, profibrotic secretome", shape = parallelogram, fillcolor = "#f6cccc"];
    }

    /* ================================================================
       3. ALLORECOGNITION
       ================================================================ */
    subgraph cluster_allorec {
        label = "3. Allorecognition — how the recipient learns the graft is foreign";
        style = "filled,rounded"; fillcolor = "#f2eef8"; color = "#b2a2cf";
        fontsize = 13; fontcolor = "#553f85";
        node [fillcolor = "#e7e0f3", color = "#9c89bf"];

        A_PASS    [label = "Donor passenger leucocytes\ndonor DC migrate to recipient lymph node\ndecay over ~2-4 weeks", shape = parallelogram, fillcolor = "#ded3ee"];
        A_DIR     [label = "DIRECT allorecognition\nrecipient TCR reads intact donor MHC\nhuge precursor frequency (1-10%)\ndominates EARLY rejection", shape = parallelogram, fillcolor = "#ded3ee"];
        A_INDIR   [label = "INDIRECT allorecognition\nrecipient APC presents processed donor peptide\non self-MHC-II · dominates LATE rejection\nand provides B-cell help for dnDSA", shape = parallelogram, fillcolor = "#ded3ee"];
        A_SEMI    [label = "SEMI-DIRECT (cross-dressing)\nrecipient DC acquires intact donor MHC\nvia trogocytosis / exosomes", shape = parallelogram, fillcolor = "#ded3ee"];
        A_AG      [label = "Ag\ndonor antigen presentation load\n(the driver of every downstream arm)", peripheries = 2, fillcolor = "#d6c8ec"];
        A_MHC1    [label = "Donor HLA class I (A, B, C)\non every nucleated graft cell"];
        A_MHC2    [label = "Donor HLA class II (DR, DQ, DP)\nconstitutive on endothelium/DC,\nIFN-gamma-inducible on tubular cells"];
        A_MICA    [label = "Non-HLA targets\nMICA · AT1R · perlecan/LG3 · endothelial antigens"];
        A_LN      [label = "Draining lymph node / spleen\nsite of priming"];
        A_TLO     [label = "Tertiary lymphoid organs in the graft\nlate, local priming and B-cell maturation"];
    }

    /* ================================================================
       4. T-CELL ACTIVATION — SIGNALS 1, 2, 3
       ================================================================ */
    subgraph cluster_tact {
        label = "4. T-cell activation — signal 1 (TCR) · signal 2 (costimulation) · signal 3 (IL-2/mTOR) — where 5 drug classes act";
        style = "filled,rounded"; fillcolor = "#eef4fa"; color = "#8fb4d9";
        fontsize = 13; fontcolor = "#2d5b8c";
        node [fillcolor = "#dceaf6", color = "#6f9fce"];

        T_TCR     [label = "SIGNAL 1 · TCR-CD3 engagement\nLck -> ZAP-70 -> LAT -> PLC-gamma1", shape = parallelogram, fillcolor = "#cfe2f4"];
        T_CA      [label = "IP3 -> Ca2+ release -> calmodulin", shape = parallelogram, fillcolor = "#cfe2f4"];
        T_CN      [label = "CALCINEURIN (PPP3)\nphosphatase · the tacrolimus/CsA target", shape = parallelogram, fillcolor = "#cfe2f4"];
        T_FKBP    [label = "FKBP12 - tacrolimus complex\n(cyclophilin - cyclosporine complex)"];
        T_NFAT    [label = "NFAT dephosphorylation and nuclear import\n-> IL2, IFNG, CD40LG, IL4 transcription", shape = parallelogram, fillcolor = "#cfe2f4"];
        T_CD28    [label = "SIGNAL 2 · CD80/CD86 -> CD28\nPI3K/AKT, Bcl-xL, IL-2 mRNA stabilisation", shape = parallelogram, fillcolor = "#cfe2f4"];
        T_CD40    [label = "CD40 - CD154 (CD40L)\nlicenses the APC, drives germinal centres"];
        T_ICOS    [label = "ICOS - ICOSL\nTfh differentiation and maintenance"];
        T_LFA     [label = "LFA-1 / ICAM-1 immunological synapse\nadhesion, also graft entry"];
        T_CTLA4   [label = "CTLA-4 (CD152)\nhigher-affinity CD80/86 competitor\nthe physiological brake belatacept mimics", shape = diamond, fillcolor = "#c6dcf1"];
        T_PD1     [label = "PD-1 / PD-L1 exhaustion axis\nsustains long-term graft acceptance"];
        T_IL2     [label = "IL2\nautocrine/paracrine IL-2 pool", peripheries = 2, fillcolor = "#c9def2"];
        T_CD25    [label = "SIGNAL 3 · IL-2R alpha (CD25) induction\nhigh-affinity trimeric receptor", shape = parallelogram, fillcolor = "#cfe2f4"];
        T_JAK     [label = "JAK1/JAK3 -> STAT5\nclonal expansion programme", shape = parallelogram, fillcolor = "#cfe2f4"];
        T_MTOR    [label = "PI3K -> AKT -> mTORC1 (raptor)\nS6K1/4E-BP1 -> G1/S transit", shape = parallelogram, fillcolor = "#cfe2f4"];
        T_PURINE  [label = "De novo purine synthesis\nIMPDH type II -> GTP\nlymphocytes lack the salvage pathway", shape = parallelogram, fillcolor = "#cfe2f4"];
        T_CYCLE   [label = "Cell-cycle entry and clonal expansion", shape = parallelogram, fillcolor = "#cfe2f4"];
    }

    /* ================================================================
       5. T-CELL POPULATIONS AND THE REGULATORY BALANCE
       ================================================================ */
    subgraph cluster_tpop {
        label = "5. T-cell compartments · memory · the effector-to-regulatory balance";
        style = "filled,rounded"; fillcolor = "#eaf4f1"; color = "#8dc0ae";
        fontsize = 13; fontcolor = "#1f6b52";
        node [fillcolor = "#d8ece5", color = "#6cab95"];

        P_TN      [label = "Tn\nnaive / resting alloreactive precursors", peripheries = 2, fillcolor = "#c6e2d8"];
        P_TACT    [label = "Tact\nactivated blasts in lymphoid tissue", peripheries = 2, fillcolor = "#c6e2d8"];
        P_TEFF    [label = "Teff\ncirculating cytotoxic CD8 + Th1 effectors", peripheries = 2, fillcolor = "#c6e2d8"];
        P_TMEM    [label = "Tmem\nalloreactive memory (Tem/Tcm)\nheterologous immunity from prior viral exposure", peripheries = 2, fillcolor = "#c6e2d8"];
        P_CD28N   [label = "CD28-null CD57+ CD4 Tem\nBELATACEPT-RESISTANT subset\nexpanded by age, CMV, prior transplant", shape = diamond, fillcolor = "#b9dbcf"];
        P_TREG    [label = "Treg\nFOXP3+ regulatory T cells", peripheries = 2, fillcolor = "#c6e2d8"];
        P_TFH     [label = "T follicular helper (Tfh)\nCXCR5+ PD-1hi · IL-21 · the B-cell help node"];
        P_TH17    [label = "Th17 / IL-17\nneutrophilic and fibrotic arm"];
        P_SUP     [label = "Regulatory balance\nSUP = Treg / (Treg + Teff)\nsets the size of the lesion for a given effector load", shape = diamond, fillcolor = "#b9dbcf"];
        P_TINF    [label = "Tinf\ngraft-infiltrating T cells", peripheries = 2, fillcolor = "#c6e2d8"];
        P_HOMEO   [label = "Homeostatic proliferation after depletion\nIL-7/IL-15-driven repopulation favours MEMORY\n(the ATG paradox)", shape = parallelogram, fillcolor = "#cbe6dc"];
        P_TOL     [label = "Operational tolerance\nchimerism, deletion, regulation\n(rare, deliberate protocols only)", shape = diamond, fillcolor = "#b9dbcf"];
    }

    /* ================================================================
       6. T-CELL MEDIATED REJECTION (TCMR)
       ================================================================ */
    subgraph cluster_tcmr {
        label = "6. T cell-mediated rejection — the tubulointerstitial lesion";
        style = "filled,rounded"; fillcolor = "#fdf2e6"; color = "#e0b57a";
        fontsize = 13; fontcolor = "#8a5a20";
        node [fillcolor = "#fbe6cd", color = "#d3a25f"];

        M_CHEMO   [label = "CXCL9 / CXCL10 / CXCL11 -> CXCR3\nIFN-gamma-induced recruitment gradient"];
        M_MIG     [label = "Effector traffic into the graft\nrolling -> LFA-1/ICAM firm adhesion -> diapedesis", shape = parallelogram, fillcolor = "#f7d6a8"];
        M_GZMB    [label = "Granzyme B / perforin\ndirect tubular epithelial killing", shape = parallelogram, fillcolor = "#f7d6a8"];
        M_FAS     [label = "Fas-FasL apoptosis of tubular cells", shape = parallelogram, fillcolor = "#f7d6a8"];
        M_MAC     [label = "Activated macrophages\nIFN-gamma-licensed, iNOS, TNF-alpha"];
        M_TUB     [label = "TUB\ntubulitis + interstitial inflammation burden", peripheries = 2, fillcolor = "#f4c98f"];
        M_BANFFT  [label = "Banff t score (tubulitis, 0-3)", shape = hexagon, fillcolor = "#f0bd7a"];
        M_BANFFI  [label = "Banff i score (interstitial inflammation, 0-3)", shape = hexagon, fillcolor = "#f0bd7a"];
        M_BANFFV  [label = "Banff v score (intimal arteritis, 0-3)\nBanff IIA/IIB - steroid-resistant phenotype", shape = hexagon, fillcolor = "#f0bd7a"];
        M_BORDER  [label = "Borderline changes\ni1t1 - not benign: predicts later dnDSA", shape = diamond, fillcolor = "#f2c98c"];
        M_SUBCL   [label = "Subclinical rejection\nfound only on protocol biopsy, stable creatinine", shape = diamond, fillcolor = "#f2c98c"];
        M_IFNG    [label = "IFNg\ninterferon-gamma tone", peripheries = 2, fillcolor = "#f4c98f"];
    }

    /* ================================================================
       7. B CELLS, PLASMA CELLS, DSA
       ================================================================ */
    subgraph cluster_bcell {
        label = "7. B-cell arm — germinal centre · plasmablast · the long-lived plasma cell that no B-cell drug reaches";
        style = "filled,rounded"; fillcolor = "#f6eef5"; color = "#cf9ec4";
        fontsize = 13; fontcolor = "#7d3269";
        node [fillcolor = "#efdfec", color = "#bd85b1"];

        B_BN      [label = "Bn\nnaive + memory alloreactive B cells (CD20+)", peripheries = 2, fillcolor = "#e6cfe1"];
        B_BCR     [label = "BCR ligation by intact donor HLA\nB cells are also efficient alloantigen APC", shape = parallelogram, fillcolor = "#e9d5e5"];
        B_GC      [label = "Bgc\ngerminal-centre / activated B cells", peripheries = 2, fillcolor = "#e6cfe1"];
        B_HELP    [label = "Tfh help: CD40L + IL-21 (+ IL-6)\nrequired for class switch and affinity maturation", shape = parallelogram, fillcolor = "#e9d5e5"];
        B_BAFF    [label = "BAFF / APRIL survival niche\nrises after B-cell depletion (rebound risk)"];
        B_CSR     [label = "Class-switch recombination (AID)\nIgM -> IgG1/IgG3 (complement-fixing)\nvs IgG2/IgG4 (non-fixing)", shape = parallelogram, fillcolor = "#e9d5e5"];
        B_PB      [label = "PB\nshort-lived plasmablasts (CD20- CD38+)", peripheries = 2, fillcolor = "#e6cfe1"];
        B_LLPC    [label = "LLPC\nlong-lived bone-marrow plasma cells\nCD20-NEGATIVE, CD38+/BCMA+, t1/2 in years\nWHY RITUXIMAB DOES NOT LOWER DSA", peripheries = 2, fillcolor = "#dfc0d8"];
        B_BMNICHE [label = "Bone-marrow survival niche\nCXCL12+ stroma, APRIL, IL-6"];
        B_DSA     [label = "DSA\ncirculating donor-specific IgG (MFI)", peripheries = 2, fillcolor = "#dfc0d8"];
        B_DNDSA   [label = "de novo DSA (dnDSA)\n~ 15-25% by 5 y · driven by eplet load,\nlow tacrolimus exposure and non-adherence", shape = hexagon, fillcolor = "#dbb3d2"];
        B_MFI     [label = "DSA MFI · C1q/C3d binding · IgG subclass\nrisk stratification of the antibody itself", shape = hexagon, fillcolor = "#dbb3d2"];
        B_BOUND   [label = "DSA bound to graft endothelium\nsaturable target: the graft is an antibody sink", shape = parallelogram, fillcolor = "#e9d5e5"];
    }

    /* ================================================================
       8. COMPLEMENT, NK CELLS, ENDOTHELIUM — THE ABMR EFFECTOR ARMS
       ================================================================ */
    subgraph cluster_abmr {
        label = "8. ABMR effector arms — complement · FcgammaR/NK ADCC · direct endothelial signalling · 'missing self'";
        style = "filled,rounded"; fillcolor = "#fdeef4"; color = "#e5a0bd";
        fontsize = 13; fontcolor = "#9c2d57";
        node [fillcolor = "#fadfe9", color = "#d885a5"];

        C_C1Q     [label = "C1q binding by IgG1/IgG3 hexamers\nclassical pathway ignition", shape = parallelogram, fillcolor = "#f6cddc"];
        C_C4      [label = "C1s -> C4 cleavage -> C4b -> C4d\nC4d is a covalent FOOTPRINT, not an effector", shape = parallelogram, fillcolor = "#f6cddc"];
        C_C4D     [label = "C4D\nperitubular capillary C4d deposition", peripheries = 2, fillcolor = "#f4c0d3"];
        C_C3      [label = "C3 convertase -> C3a / C3b\namplification loop"];
        C_C5      [label = "C5 convertase -> C5a (chemotaxis) + C5b", shape = parallelogram, fillcolor = "#f6cddc"];
        C_MAC     [label = "C5b-9 membrane attack complex\nsublytic MAC -> non-canonical NF-kB in endothelium", shape = parallelogram, fillcolor = "#f6cddc"];
        C_FCGR    [label = "FcgammaRIIIa (CD16) on NK cells\nADCC - the COMPLEMENT-INDEPENDENT arm", shape = parallelogram, fillcolor = "#f6cddc"];
        C_MISS    [label = "'Missing self'\ndonor HLA-I fails to engage recipient inhibitory KIR\n-> NK activation WITHOUT any antibody", shape = diamond, fillcolor = "#f2b6ce"];
        C_NK      [label = "NKact\nactivated intragraft NK cells", peripheries = 2, fillcolor = "#f4c0d3"];
        C_ENDO    [label = "ENDO\nendothelial activation state", peripheries = 2, fillcolor = "#f4c0d3"];
        C_HLAX    [label = "HLA cross-linking -> mTOR, ERK, Src\nproliferative endothelial signalling (antibody as agonist)", shape = parallelogram, fillcolor = "#f6cddc"];
        C_PSEL    [label = "P-selectin exocytosis, vWF release,\nleucocyte capture in peritubular capillaries"];
        C_MVI     [label = "MVI\nmicrovascular inflammation (g + ptc)", peripheries = 2, fillcolor = "#f4c0d3"];
        C_BANFFG  [label = "Banff g (glomerulitis) + ptc (capillaritis)\ng+ptc >= 2 defines active MVI", shape = hexagon, fillcolor = "#f0aac6"];
        C_TG      [label = "TG\ntransplant glomerulopathy (cg)\nGBM duplication - largely irreversible", peripheries = 2, fillcolor = "#f4c0d3"];
        C_ABMRDX  [label = "Active / chronic active ABMR\nBanff: MVI + evidence of antibody interaction + DSA", shape = hexagon, fillcolor = "#f0aac6"];
    }

    /* ================================================================
       9. TACROLIMUS / CYCLOSPORINE PK
       ================================================================ */
    subgraph cluster_cnipk {
        label = "9. Calcineurin-inhibitor PK — the exposure that has to be steered";
        style = "filled,rounded"; fillcolor = "#eef2f7"; color = "#9aa9bd";
        fontsize = 13; fontcolor = "#3c4e66";
        node [fillcolor = "#dfe6ef", color = "#8496ad"];

        K_TDOSE   [label = "Tacrolimus PO BID\n0.05-0.1 mg/kg BID start\n(or once-daily extended release)", shape = octagon, fillcolor = "#d3ddea"];
        K_TA1     [label = "TAC_A1 / TAC_A2\ngut transit (absorption lag)", peripheries = 2, fillcolor = "#cdd8e7"];
        K_CYP34   [label = "Enterocyte + hepatic CYP3A4/CYP3A5\nfirst pass ~ 75% · F ~ 0.25", shape = parallelogram, fillcolor = "#d6dfeb"];
        K_PGP     [label = "P-glycoprotein (ABCB1) efflux\nback into the gut lumen", shape = parallelogram, fillcolor = "#d6dfeb"];
        K_TC      [label = "TAC_C\ncentral tacrolimus (whole blood)", peripheries = 2, fillcolor = "#cdd8e7"];
        K_TP      [label = "TAC_P\nperipheral tissue tacrolimus", peripheries = 2, fillcolor = "#cdd8e7"];
        K_RBC     [label = "Erythrocyte partitioning (~95%)\nwhole-blood assay, haematocrit-dependent"];
        K_C0      [label = "Trough C0 (ng/mL)\nmonths 0-3: 8-10 · later: 5-7", shape = hexagon, fillcolor = "#c6d3e4"];
        K_DDI     [label = "CYP3A interactions\nazoles, diltiazem, ritonavir (up)\nrifampicin, phenytoin (down)", shape = diamond, fillcolor = "#c6d3e4"];
        K_IPV     [label = "Intra-patient variability (IPV)\nCV% of consecutive troughs\n> 30% -> dnDSA, rejection, graft loss", shape = diamond, fillcolor = "#c6d3e4"];
        K_TTR     [label = "Time in therapeutic range\nand time below 5 ng/mL", shape = hexagon, fillcolor = "#c6d3e4"];
        K_CSA     [label = "Cyclosporine PO BID (comparator)\nC0 150-250 ng/mL · ~25x less potent per ng", shape = octagon, fillcolor = "#d3ddea"];
        K_CSAC    [label = "CSA_C / CSA_P\ncyclosporine central / peripheral", peripheries = 2, fillcolor = "#cdd8e7"];
        K_TACEQ   [label = "TACEQ = TAC + CSA/25\npotency-normalised CNI exposure", shape = diamond, fillcolor = "#c6d3e4"];
    }

    /* ================================================================
       10. MYCOPHENOLATE, STEROID, mTOR INHIBITOR PK
       ================================================================ */
    subgraph cluster_otherpk {
        label = "10. Antiproliferative · corticosteroid · mTOR-inhibitor PK";
        style = "filled,rounded"; fillcolor = "#f0f4ec"; color = "#a7bd94";
