        H_MISS    [label = "Missed / mistimed doses\nBID regimens are the most vulnerable", shape = parallelogram, fillcolor = "#e8d9ca"];
        H_DIP     [label = "Trough excursions below 5 ng/mL\nNFAT escape windows", shape = diamond, fillcolor = "#dfcab6"];
        H_INTERV  [label = "Adherence intervention\nreminders, once-daily conversion, DOT, counselling", shape = octagon, fillcolor = "#e8dbcc"];
        H_MONITOR [label = "Monitoring\ntrough CV%, dd-cfDNA, DSA screening, protocol biopsy", shape = octagon, fillcolor = "#e8dbcc"];
    }

    /* ================================================================
       14. GRAFT STRUCTURE AND FUNCTION
       ================================================================ */
    subgraph cluster_func {
        label = "14. Graft structure and function — nephron mass, haemodynamics, filtration";
        style = "filled,rounded"; fillcolor = "#eaf1f6"; color = "#93b2c8";
        fontsize = 13; fontcolor = "#25566f";
        node [fillcolor = "#d9e6ef", color = "#7ba0ba"];

        F_NM      [label = "NM\nfunctioning nephron mass (fraction of implanted)", peripheries = 2, fillcolor = "#c8dbe8"];
        F_SNGFR   [label = "Single-nephron GFR\nrises as NM falls (compensatory hyperfiltration)", shape = parallelogram, fillcolor = "#d0e0ea"];
        F_AFF     [label = "Afferent arteriolar vasoconstriction\nCNI: endothelin up, NO down, RAAS up\nFULLY REVERSIBLE - the belatacept GFR gap", shape = parallelogram, fillcolor = "#d0e0ea"];
        F_HYAL    [label = "CNIHYAL\ncumulative CNI arteriolopathy (ah) - irreversible", peripheries = 2, fillcolor = "#c8dbe8"];
        F_EGFR    [label = "eGFR (mL/min/1.73 m2)\nCKD-EPI 2021", shape = hexagon, fillcolor = "#bcd3e3"];
        F_SCR     [label = "SCR\nserum creatinine (generation vs clearance)", peripheries = 2, fillcolor = "#c8dbe8"];
        F_SLOPE   [label = "eGFR slope (mL/min/1.73 m2 per year)\nthe accepted surrogate for graft failure", shape = hexagon, fillcolor = "#bcd3e3"];
        F_PROT    [label = "PROT\nproteinuria (UPCR, g/g)", peripheries = 2, fillcolor = "#c8dbe8"];
        F_CFDNA   [label = "CFDNA\ndonor-derived cell-free DNA (%)\nt1/2 ~ 6 h - an injury flux, not a state", peripheries = 2, fillcolor = "#c8dbe8"];
        F_BP      [label = "Post-transplant hypertension\nCNI, steroids, graft dysfunction"];
    }

    /* ================================================================
       15. CHRONIC FIBROSIS
       ================================================================ */
    subgraph cluster_fib {
        label = "15. Chronic injury — IFTA, the final common pathway (drug-independent)";
        style = "filled,rounded"; fillcolor = "#f3f0e6"; color = "#c3b98d";
        fontsize = 13; fontcolor = "#6a5f1e";
        node [fillcolor = "#e8e3ce", color = "#b0a678"];

        X_TGF     [label = "TGF-beta1 / SMAD2-3 signalling\nthe fibrotic master switch", shape = parallelogram, fillcolor = "#ded7bd"];
        X_EMT     [label = "Partial EMT of tubular epithelium\nsenescent, profibrotic phenotype", shape = parallelogram, fillcolor = "#ded7bd"];
        X_MYOF    [label = "Interstitial myofibroblast expansion\n(pericyte-derived, alpha-SMA+)"];
        X_COLL    [label = "Collagen I/III, fibronectin deposition"];
        X_PTCRAR  [label = "Peritubular capillary rarefaction\n-> chronic hypoxia -> HIF-1a -> more fibrosis", shape = parallelogram, fillcolor = "#ded7bd"];
        X_IFTA    [label = "IFTA\ninterstitial fibrosis + tubular atrophy (ci + ct)", peripheries = 2, fillcolor = "#dcd4b4"];
        X_BANFFCI [label = "Banff ci + ct score (0-6)\nchronicity - each point costs graft years", shape = hexagon, fillcolor = "#d5cba4"];
        X_HYPER   [label = "HYPERFILTRATION LOOP\nnephron loss -> SNGFR up -> shear/strain ->\nTGF-beta -> IFTA -> more nephron loss", shape = diamond, fillcolor = "#d5cba4", penwidth = 2.0];
    }

    /* ================================================================
       16. BK POLYOMAVIRUS
       ================================================================ */
    subgraph cluster_bk {
        label = "16. BK polyomavirus — the price of the other arm of the U";
        style = "filled,rounded"; fillcolor = "#eef6f0"; color = "#95c2a4";
        fontsize = 13; fontcolor = "#255f38";
        node [fillcolor = "#dbeee2", color = "#78ab89"];

        V_LATENT  [label = "Latent BKV in renourinary epithelium\n(usually of DONOR origin)"];
        V_REACT   [label = "Reactivation when T-cell control falls", shape = parallelogram, fillcolor = "#d2e8da"];
        V_BKV     [label = "BKV\nplasma BK viral load (copies/mL)", peripheries = 2, fillcolor = "#c8e3d2"];
        V_VIRURIA [label = "Decoy cells / viruria\nprecedes viraemia by ~4 weeks", shape = hexagon, fillcolor = "#bcdcc8"];
        V_TCTRL   [label = "BKV-specific T-cell control\nsuppressed in proportion to NIS", shape = parallelogram, fillcolor = "#d2e8da"];
        V_BKVAN   [label = "BKVAN\nBK nephropathy - tubular lysis + interstitial infiltrate\nhistologically MIMICS TCMR", peripheries = 2, fillcolor = "#c8e3d2"];
        V_SCREEN  [label = "Screening protocol\nplasma PCR monthly x 6, then q3mo to 2 y", shape = octagon, fillcolor = "#d2e8da"];
        V_REDUCE  [label = "Pre-emptive IS reduction\nMPA first (-50%), then CNI target down\nCLOSED-LOOP CONTROLLER in the R model", shape = octagon, fillcolor = "#d2e8da", penwidth = 2.0];
        V_TRAP    [label = "The BK trap\nreduce IS -> virus clears -> alloimmunity rebounds\n-> rejection on a scarred graft", shape = diamond, fillcolor = "#bcdcc8"];
    }

    /* ================================================================
       17. CMV AND OTHER INFECTION / MALIGNANCY
       ================================================================ */
    subgraph cluster_inf {
        label = "17. CMV, other infection and malignancy — the rest of the over-immunosuppression arm";
        style = "filled,rounded"; fillcolor = "#f7f1ec"; color = "#c9a68e";
        fontsize = 13; fontcolor = "#7d472a";
        node [fillcolor = "#eee1d7", color = "#bb937a"];

        W_CMV     [label = "CMV\nCMV viral load (IU/mL)", peripheries = 2, fillcolor = "#e6d3c5"];
        W_DRSTAT  [label = "D+/R- serostatus\nno pre-existing CMV-specific T cells", shape = diamond, fillcolor = "#e0c9b8"];
        W_VGC     [label = "Valganciclovir prophylaxis 200 d\n(or letermovir - no myelosuppression)", shape = octagon, fillcolor = "#e8d8ca"];
        W_GCVC    [label = "GCV_C\nganciclovir concentration (renally cleared)", peripheries = 2, fillcolor = "#e6d3c5"];
        W_CMVDIS  [label = "CMV syndrome / tissue-invasive disease\nplus indirect alloimmune effects", shape = hexagon, fillcolor = "#dfc3ae"];
        W_WBC     [label = "WBC\nleucocyte count (x10^9/L)", peripheries = 2, fillcolor = "#e6d3c5"];
        W_LEUK    [label = "Leucopenia\nMPA + valganciclovir + ATG additive", shape = hexagon, fillcolor = "#dfc3ae"];
        W_PTLD    [label = "EBV-driven PTLD\nrisk highest in EBV D+/R- and after depletion", shape = hexagon, fillcolor = "#dfc3ae"];
        W_SKIN    [label = "Skin cancer / solid tumours\ncumulative net-immunosuppression exposure", shape = hexagon, fillcolor = "#dfc3ae"];
        W_NISAUC  [label = "NISAUC\ncumulative net-immunosuppression exposure", peripheries = 2, fillcolor = "#e6d3c5"];
        W_PTDM    [label = "GLU\npost-transplant diabetes index\n(steroid + tacrolimus beta-cell toxicity)", peripheries = 2, fillcolor = "#e6d3c5"];
        W_SEPSIS  [label = "Bacterial / fungal infection, sepsis\nthe commonest cause of death with function", shape = hexagon, fillcolor = "#dfc3ae"];
    }

    /* ================================================================
       18. DIAGNOSTIC AND DECISION LAYER
       ================================================================ */
    subgraph cluster_dx {
        label = "18. Diagnostic and decision layer — what the clinician can actually see";
        style = "filled,rounded"; fillcolor = "#eef3f3"; color = "#9bb8b8";
        fontsize = 13; fontcolor = "#2f5c5c";
        node [fillcolor = "#dde9e9", color = "#82a5a5"];

        Q_SCRRISE [label = "Creatinine rise > 20%\nthe classical (late, insensitive) trigger", shape = diamond, fillcolor = "#cfe0e0"];
        Q_INDBX   [label = "Indication biopsy", shape = octagon, fillcolor = "#d7e4e4"];
        Q_PROTBX  [label = "Protocol biopsy (3 / 12 mo)\nfinds subclinical rejection before creatinine moves", shape = octagon, fillcolor = "#d7e4e4"];
        Q_MMDX    [label = "Molecular microscope (MMDx)\ntranscript-based rejection archetypes"];
        Q_CFDNA   [label = "dd-cfDNA > 0.5-1.0%\nrules out active rejection well (high NPV)", shape = diamond, fillcolor = "#cfe0e0"];
        Q_DSAMON  [label = "DSA surveillance (SAB assay)", shape = octagon, fillcolor = "#d7e4e4"];
        Q_LADDER  [label = "Treatment ladder\nTCMR: steroid pulse -> ATG if steroid-resistant\nABMR: PLEX/IVIG +/- anti-IL-6 / anti-CD38", shape = octagon, fillcolor = "#d7e4e4", penwidth = 2.0];
        Q_IBOX    [label = "iBox composite risk\neGFR + proteinuria + histology + DSA\nvalidated surrogate for graft loss", shape = hexagon, fillcolor = "#c6d9d9"];
    }

    /* ================================================================
       19. CLINICAL ENDPOINTS
       ================================================================ */
    subgraph cluster_end {
        label = "19. Clinical endpoints";
        style = "filled,rounded"; fillcolor = "#f6eaea"; color = "#cf9a9a";
        fontsize = 14; fontcolor = "#8f2b2b";
        node [fillcolor = "#eed6d6", color = "#c08585"];

        E_BPAR    [label = "Biopsy-proven acute rejection at 12 mo\nTAC/MPA/steroid ~ 10-12% · belatacept ~ 17-22%", shape = hexagon, fillcolor = "#e6c2c2"];
        E_EGFR12  [label = "eGFR at 12 months\nTAC ~ 55-60 · belatacept ~ 63-68 · CsA ~ 50", shape = hexagon, fillcolor = "#e6c2c2"];
        E_DNDSA5  [label = "dnDSA at 5 years\n~ 15-25% overall · > 40% with non-adherence", shape = hexagon, fillcolor = "#e6c2c2"];
        E_SLOPE   [label = "eGFR slope\nstable graft ~ -1 · chronic ABMR ~ -5 to -10 /yr", shape = hexagon, fillcolor = "#e6c2c2"];
        E_DCGS    [label = "Death-censored graft survival\n~ 90% at 5 y, ~ 75% at 10 y (deceased donor)", shape = hexagon, fillcolor = "#e0b0b0", penwidth = 2.0];
        E_HAZ     [label = "HAZ\ncumulative graft-failure hazard", peripheries = 2, fillcolor = "#e6c2c2"];
        E_DIAL    [label = "Return to dialysis (eGFR < 15)", shape = hexagon, fillcolor = "#e0b0b0"];
        E_DWFG    [label = "Death with functioning graft\ncardiovascular, infection, malignancy", shape = hexagon, fillcolor = "#e6c2c2"];
        E_CUMREJ  [label = "CUMREJ\ncumulative rejection burden (lesion-days)", peripheries = 2, fillcolor = "#e6c2c2"];
    }

    /* ================================================================
       20. SIMULATED THERAPEUTIC SCENARIOS
       ================================================================ */
    subgraph cluster_scen {
        label = "20. The 20 scenarios simulated in ktx_mrgsolve_model.R";
        style = "filled,rounded"; fillcolor = "#f0f0f4"; color = "#a8a8bd";
        fontsize = 13; fontcolor = "#3f3f5c";
        node [fillcolor = "#e2e2ea", color = "#9494ab"];

        S_STD     [label = "1-2 · standard-risk TAC/MPA/steroid\nwith basiliximab, +/- living donor", shape = octagon, fillcolor = "#d8d8e3"];
        S_HIGH    [label = "3-4 · high immunological risk\nATG vs basiliximab induction", shape = octagon, fillcolor = "#d8d8e3"];
        S_CYP     [label = "5-6 · CYP3A5 expresser\nstandard vs genotype-guided dose", shape = octagon, fillcolor = "#d8d8e3"];
        S_BELA    [label = "7 · belatacept CNI-free\n8 · cyclosporine comparator", shape = octagon, fillcolor = "#d8d8e3"];
        S_STER    [label = "9 · early steroid withdrawal (d7)\n10 · everolimus + reduced CNI", shape = octagon, fillcolor = "#d8d8e3"];
        S_ADH     [label = "11 · non-adherence from month 12\n12 · high tacrolimus IPV (CV 40%)", shape = octagon, fillcolor = "#d8d8e3"];
        S_BK      [label = "13 · BK viraemia WITH screening\n14 · BK viraemia without screening", shape = octagon, fillcolor = "#d8d8e3"];
        S_TCMR    [label = "15 · Banff IIA TCMR, steroid pulse\n16 · steroid-resistant TCMR -> ATG rescue", shape = octagon, fillcolor = "#d8d8e3"];
        S_ABMR    [label = "17 · active ABMR: PLEX/IVIG/rituximab\n18 · chronic active ABMR: anti-IL-6\n19 · chronic active ABMR: anti-CD38", shape = octagon, fillcolor = "#d8d8e3"];
        S_DGF     [label = "20 · DCD donor, CIT 24 h, KDPI 85\nDGF and low nephron dose", shape = octagon, fillcolor = "#d8d8e3"];
    }

    /* ================================================================
       EDGES
       ================================================================ */

    /* --- 1 -> 2 : donor quality drives ischaemic injury --- */
    D_TYPE   -> D_CIT;
    D_TYPE   -> I_ATP     [label = "warm ischaemia (DCD)"];
    D_CIT    -> I_ATP     [label = "duration"];
    D_KDPI   -> D_MASS    [label = "sets nephron dose", color = "#b06a2c"];
    D_AGE    -> D_KDPI;
    D_AGE    -> I_MALREP  [label = "less repair reserve"];
    D_MP     -> I_ATP     [color = "#2e7d32", label = "attenuates"];
    D_MASS   -> F_NM      [label = "initial condition", color = "#b06a2c"];
    R_RACE   -> R_CYP3A5;
    R_BMI    -> K_TDOSE   [label = "mg/kg dosing"];
    R_PRIM   -> F_PROT    [label = "disease recurrence", style = dashed];
    R_ADHRISK-> H_DECAY;
    R_CMVSER -> W_DRSTAT;
    R_AGE    -> P_CD28N   [label = "immunosenescence"];

    /* --- 2 : IRI cascade --- */
    I_ATP    -> I_ROS;
    I_ROS    -> I_MPT;
    I_MPT    -> I_NEC;
    I_ROS    -> I_NEC;
    I_NEC    -> I_AKI;
    I_NEC    -> I_DAMP;
    I_AKI    -> I_DAMP;
    I_DAMP   -> I_TLR;
    I_TLR    -> I_NEUT;
    I_COMP   -> I_NEUT;
    I_ROS    -> I_COMP;
    I_NEUT   -> I_AKI     [color = "#e07b39", label = "amplifies"];
    I_AKI    -> I_KIM1;
    I_AKI    -> I_DGF;
    I_AKI    -> I_REPAIR;
    I_REPAIR -> I_AKI     [color = "#2e7d32", label = "resolves"];
    I_AKI    -> I_MALREP  [label = "if severe / prolonged"];
    I_MALREP -> X_TGF     [color = "#e07b39"];
    I_DGF    -> E_DCGS    [style = dashed, label = "worse long-term"];
    I_AKI    -> F_EGFR    [color = "#c62828", label = "acute functional loss"];
    I_AKI    -> F_CFDNA   [label = "releases dd-cfDNA"];

    /* --- 2 -> 3 : danger signals amplify allorecognition --- */
    I_DAMP   -> A_AG      [color = "#e07b39", label = "LOOP 1: raises antigen presentation"];
    I_TLR    -> A_PASS    [label = "matures donor DC"];
    I_DAMP   -> C_ENDO;

    /* --- 3 : allorecognition --- */
    A_PASS   -> A_DIR;
    A_MHC1   -> A_DIR;
    A_MHC2   -> A_DIR;
    A_MHC1   -> A_INDIR;
    A_MHC2   -> A_INDIR;
    A_PASS   -> A_SEMI;
    A_DIR    -> A_AG;
    A_INDIR  -> A_AG;
    A_SEMI   -> A_AG;
    A_MICA   -> A_AG      [style = dashed, label = "non-HLA"];
    R_HLAMM  -> A_AG      [label = "antigenic load"];
    R_EPLET  -> B_BN      [label = "B-cell epitope load", color = "#b06a2c"];
    R_EPLET  -> A_INDIR;
    A_LN     -> T_TCR;
    A_AG     -> T_TCR     [penwidth = 1.6];
    A_AG     -> B_BCR     [penwidth = 1.6];
    A_TLO    -> B_GC      [label = "late local B maturation"];
    A_INDIR  -> P_TFH     [label = "provides help for dnDSA", color = "#b06a2c"];
    M_IFNG   -> A_MHC2    [color = "#e07b39", label = "induces class II on tubules"];

    /* --- 4 : activation signals --- */
    T_TCR    -> T_CA;
    T_CA     -> T_CN;
    T_CN     -> T_NFAT;
    T_NFAT   -> T_IL2;
    T_CD28   -> T_NFAT    [label = "signal 2 sustains"];
    T_CD28   -> T_IL2;
    T_CTLA4  -> T_CD28    [color = "#c62828", label = "outcompetes"];
    T_PD1    -> T_TCR     [color = "#c62828"];
    T_LFA    -> T_TCR     [label = "stabilises synapse"];
    T_IL2    -> T_CD25;
    T_CD25   -> T_JAK;
    T_JAK    -> T_MTOR;
    T_MTOR   -> T_CYCLE;
    T_PURINE -> T_CYCLE;
    T_CYCLE  -> P_TACT    [penwidth = 1.6];
    T_TCR    -> P_TACT;
    T_CD40   -> B_HELP;
    T_ICOS   -> P_TFH;
    T_NFAT   -> T_CD40    [label = "CD40LG transcription"];

    /* --- drug -> target : CNI --- */
    K_TDOSE  -> K_TA1;
    K_TA1    -> K_CYP34;
    K_CYP34  -> K_TC      [label = "F ~ 0.25"];
    K_PGP    -> K_TA1     [color = "#c62828", label = "efflux"];
    K_TC     -> K_TP;
    K_TP     -> K_TC;
    K_TC     -> K_RBC;
    K_TC     -> K_C0;
    K_TC     -> K_CYP34   [label = "systemic clearance"];
    R_CYP3A5 -> K_CYP34   [label = "EXPRESSER: CL x 1.9", color = "#b06a2c", penwidth = 1.4];
    R_ABCB1  -> K_PGP;
    K_DDI    -> K_CYP34;
    K_CSA    -> K_CSAC;
    K_C0     -> K_TACEQ;
    K_CSAC   -> K_TACEQ;
    K_TACEQ  -> T_FKBP;
    T_FKBP   -> T_CN      [color = "#c62828", penwidth = 1.8, label = "CALCINEURIN INHIBITION"];
    K_C0     -> K_TTR;
    K_IPV    -> K_TTR     [color = "#c62828"];
    K_TACEQ  -> N_CNINH;
    K_TACEQ  -> F_AFF     [color = "#c62828", penwidth = 1.4, label = "vasoconstriction (reversible)"];
    K_TACEQ  -> F_HYAL    [label = "cumulative exposure -> ah"];
    K_TACEQ  -> W_PTDM    [label = "beta-cell toxicity"];
    K_TACEQ  -> F_BP;

    /* --- drug -> target : MPA --- */
    Y_MMF    -> Y_MMFD;
    Y_MMFD   -> Y_ESTER;
    Y_ESTER  -> Y_MPAC;
    Y_MPAC   -> Y_ALB;
    Y_MPAC   -> Y_UGT;
    Y_UGT    -> Y_MPAG;
    Y_MPAG   -> Y_EHC;
    Y_EHC    -> Y_MMFD    [color = "#2e7d32", label = "second peak"];
    Y_MPAC   -> Y_AUC;
    Y_MPAC   -> T_PURINE  [color = "#c62828", penwidth = 1.8, label = "IMPDH-II INHIBITION"];
    Y_MPAC   -> N_MPAINH;
    Y_MPAC   -> W_WBC     [color = "#c62828", label = "marrow suppression"];

    /* --- drug -> target : steroids --- */
    Y_PRED   -> Y_PREDC;
    Y_MP     -> Y_MPC;
    Y_PREDC  -> Y_GR;
    Y_MPC    -> Y_GR      [penwidth = 1.4];
    Y_GR     -> M_TUB     [color = "#c62828", penwidth = 1.5, label = "resolves tubulitis"];
    Y_GR     -> T_NFAT    [color = "#c62828"];
    Y_GR     -> M_IFNG    [color = "#c62828"];
    Y_GR     -> N_STINH;
    Y_PREDC  -> W_PTDM    [label = "insulin resistance"];

    /* --- drug -> target : mTORi --- */
    Y_EVR    -> Y_EVRC;
    Y_EVRC   -> T_MTOR    [color = "#c62828", penwidth = 1.6, label = "signal-3 blockade"];
    Y_EVRC   -> P_TREG    [color = "#2e7d32", label = "spares/favours Treg"];
    Y_EVRC   -> C_HLAX    [color = "#c62828", label = "blocks endothelial proliferation"];
    Y_EVRC   -> F_PROT    [color = "#c62828", label = "podocyte VEGF -> proteinuria"];
    Y_EVRC   -> I_REPAIR  [color = "#c62828", label = "impairs tubular repair"];

    /* --- drug -> target : biologics --- */
    Z_ATG    -> Z_ATGC;
    Z_ATGC   -> Z_DEPL;
    Z_DEPL   -> P_TN      [color = "#c62828", penwidth = 1.6];
    Z_DEPL   -> P_TEFF    [color = "#c62828"];
    Z_DEPL   -> P_TMEM    [color = "#c62828", style = dashed, label = "partially resistant"];
    Z_DEPL   -> P_TINF    [color = "#c62828"];
    Z_DEPL   -> P_TREG    [color = "#c62828", style = dashed];
    Z_DEPL   -> P_HOMEO;
    P_HOMEO  -> P_TMEM    [color = "#e07b39", label = "repopulation skews to memory"];
    Z_DEPL   -> N_DEPL;
    Z_BAS    -> Z_BASC;
    Z_BASC   -> T_CD25    [color = "#c62828", penwidth = 1.6, label = "CD25 saturation"];
    Z_BASC   -> N_IL2BLK;
    Z_BELA   -> Z_BELAC;
    Z_BELAC  -> Z_OCC;
    Z_OCC    -> T_CD28    [color = "#c62828", penwidth = 1.8, label = "SIGNAL 2 BLOCKADE"];
    Z_OCC    -> P_TFH     [color = "#c62828", label = "cuts B-cell help -> less dnDSA"];
    P_CD28N  -> Z_OCC     [color = "#e07b39", style = dashed, label = "ESCAPES blockade"];
    Z_OCC    -> N_COSBLK;
    Z_RTX    -> Z_RTXC;
    Z_RTXC   -> B_BN      [color = "#c62828", penwidth = 1.5, label = "CD20 depletion"];
    Z_RTXC   -> B_GC      [color = "#c62828"];
    Z_RTXC   -> B_LLPC    [color = "#9e9e9e", style = dashed, label = "NO EFFECT (CD20-negative)"];
    Z_RTXC   -> B_BAFF    [color = "#e07b39", label = "BAFF rises after depletion"];
    Z_TCZ    -> Z_TCZC;
    Z_TCZC   -> B_HELP    [color = "#c62828", penwidth = 1.4, label = "IL-6R blockade"];
    Z_TCZC   -> P_TFH     [color = "#c62828"];
    Z_CD38   -> Z_CD38C;
    Z_CD38C  -> B_PB      [color = "#c62828", penwidth = 1.5];
    Z_CD38C  -> B_LLPC    [color = "#c62828", penwidth = 1.5, label = "REACHES the plasma cell"];
    Z_CD38C  -> C_NK      [color = "#c62828", label = "also depletes CD38+ NK"];
    Z_IVIG   -> Z_IVIGC;
    Z_IVIGC  -> B_DSA     [color = "#c62828", label = "neutralisation / FcRn competition"];
    Z_IVIGC  -> C_C1Q     [color = "#c62828", label = "complement scavenging"];
    Z_PLEX   -> B_DSA     [color = "#c62828", penwidth = 1.6, label = "first-order removal"];
    Z_IDES   -> B_DSA     [color = "#c62828", penwidth = 1.8, label = "IgG cleaved within hours"];
    Z_ECU    -> C_C5      [color = "#c62828", penwidth = 1.6];
    Z_BTZ    -> B_PB      [color = "#c62828", style = dashed];
    Z_BTZ    -> B_LLPC    [color = "#c62828", style = dashed, label = "modest in vivo"];

    /* --- 5 : T-cell population flows --- */
    P_TN     -> P_TACT    [label = "priming"];
    P_TACT   -> P_TEFF    [label = "differentiation"];
    P_TACT   -> P_TMEM;
    P_TMEM   -> P_TACT    [color = "#e07b39", label = "rapid recall (costimulation-independent)"];
    P_TACT   -> P_TREG    [label = "peripheral induction"];
    P_TEFF   -> P_SUP;
    P_TREG   -> P_SUP;
    P_SUP    -> M_TUB     [color = "#2e7d32", label = "limits lesion size"];
    P_TEFF   -> P_TINF    [label = "graft entry", penwidth = 1.4];
    P_TACT   -> P_TFH;
    P_TACT   -> P_TH17;
    P_TH17   -> X_TGF     [style = dashed];
    P_TREG   -> P_TOL     [color = "#2e7d32", style = dashed];
    T_CN     -> P_TREG    [color = "#c62828", style = dashed, label = "CNI impairs Treg (IL-2 dependent)"];

    /* --- 6 : TCMR lesion --- */
    M_IFNG   -> M_CHEMO;
    M_CHEMO  -> M_MIG;
    C_ENDO   -> M_MIG     [label = "adhesion molecules"];
    M_MIG    -> P_TINF;
    P_TINF   -> M_GZMB;
    P_TINF   -> M_FAS;
    P_TINF   -> M_IFNG;
    M_IFNG   -> M_MAC;
    M_GZMB   -> M_TUB     [penwidth = 1.4];
    M_FAS    -> M_TUB;
    M_MAC    -> M_TUB;
    M_TUB    -> M_BANFFT;
    M_TUB    -> M_BANFFI;
    M_TUB    -> M_BANFFV  [label = "if arterial involvement"];
    M_TUB    -> M_BORDER;
    M_TUB    -> M_SUBCL;
    M_BORDER -> B_DNDSA   [style = dashed, label = "predicts later dnDSA"];
    M_TUB    -> I_DAMP    [color = "#e07b39", penwidth = 1.4, label = "LOOP 1 closes"];
    M_TUB    -> F_CFDNA;
    M_TUB    -> F_NM      [color = "#c62828", penwidth = 1.5, label = "nephron loss"];
    M_TUB    -> X_TGF     [color = "#e07b39"];
    M_TUB    -> E_CUMREJ;
    M_BANFFV -> Q_LADDER  [label = "steroid-resistant"];

    /* --- 7 : B-cell arm --- */
    B_BCR    -> B_GC;
    B_BN     -> B_GC;
    P_TFH    -> B_HELP    [penwidth = 1.4];
    B_HELP   -> B_GC      [penwidth = 1.4];
    B_HELP   -> B_CSR;
    B_BAFF   -> B_BN      [color = "#2e7d32"];
    B_CSR    -> B_PB;
    B_GC     -> B_PB      [label = "differentiation"];
    B_PB     -> B_LLPC    [label = "niche entry", penwidth = 1.3];
    B_BMNICHE-> B_LLPC    [color = "#2e7d32", label = "survival signals"];
    B_PB     -> B_DSA     [penwidth = 1.5, label = "high per-cell IgG output"];
    B_LLPC   -> B_DSA     [penwidth = 1.5, label = "constitutive, drug-resistant output"];
    B_DSA    -> B_DNDSA;
    B_DSA    -> B_MFI;
    B_DSA    -> B_BOUND   [penwidth = 1.5];
    R_PREDSA -> B_DSA     [label = "preformed"];
    R_CPRA   -> R_PREDSA;
    B_GC     -> A_TLO     [style = dashed];

    /* --- 8 : ABMR effector arms --- */
    B_BOUND  -> C_C1Q     [penwidth = 1.4];
    B_BOUND  -> C_FCGR    [penwidth = 1.4];
    B_BOUND  -> C_HLAX    [penwidth = 1.3];
    C_C1Q    -> C_C4;
    C_C4     -> C_C4D;
    C_C4     -> C_C3;
    C_C3     -> C_C5;
    C_C5     -> C_MAC;
    C_MAC    -> C_ENDO    [penwidth = 1.4];
    C_MISS   -> C_NK      [penwidth = 1.4];
    C_FCGR   -> C_NK      [penwidth = 1.4];
    C_NK     -> C_ENDO;
    C_HLAX   -> C_ENDO;
    C_ENDO   -> C_PSEL;
    C_PSEL   -> C_MVI;
    C_NK     -> C_MVI     [penwidth = 1.4];
    C_MAC    -> C_MVI;
    P_TINF   -> C_MVI     [style = dashed, label = "mixed rejection"];
    C_MVI    -> C_BANFFG;
    C_MVI    -> C_TG      [penwidth = 1.4, label = "chronic remodelling"];
    C_MVI    -> C_ABMRDX;
    C_C4D    -> C_ABMRDX;
    B_DSA    -> C_ABMRDX;
    C_MVI    -> F_NM      [color = "#c62828", penwidth = 1.5];
    C_TG     -> F_PROT    [penwidth = 1.4];
    C_TG     -> F_NM      [color = "#c62828", penwidth = 1.4];
    C_MVI    -> F_CFDNA   [penwidth = 1.3, label = "highest dd-cfDNA signal"];
    C_MVI    -> I_DAMP    [color = "#e07b39"];
    C_MVI    -> X_TGF     [color = "#e07b39"];
    C_MVI    -> E_CUMREJ;
    C_ENDO   -> M_CHEMO;

    /* --- 12 : net immunosuppression aggregation --- */
    N_CNINH  -> N_NIS     [penwidth = 1.3];
    N_MPAINH -> N_NIS     [penwidth = 1.3];
    N_STINH  -> N_NIS;
    N_COSBLK -> N_NIS;
    N_IL2BLK -> N_NIS;
    N_DEPL   -> N_NIS     [penwidth = 1.3];
    N_NIS    -> N_UNDER   [label = "too low", color = "#c62828"];
    N_NIS    -> N_OVER    [label = "too high", color = "#c62828"];
    N_UNDER  -> A_AG      [style = dashed];
    N_UNDER  -> B_DNDSA   [penwidth = 1.4];
    N_UNDER  -> M_TUB     [penwidth = 1.4];
    N_OVER   -> V_REACT   [penwidth = 1.4];
    N_OVER   -> W_CMV     [penwidth = 1.3];
    N_OVER   -> W_PTLD;
    N_OVER   -> W_SEPSIS;
    N_UNDER  -> N_UCURVE;
    N_OVER   -> N_UCURVE;
    N_UCURVE -> E_DCGS    [penwidth = 1.8, color = "#8f2b2b"];
    N_NIS    -> W_NISAUC  [label = "integrated over time"];
    W_NISAUC -> W_SKIN;
    W_NISAUC -> W_PTLD;

    /* --- 13 : adherence --- */
    H_DECAY  -> H_ADH     [color = "#c62828"];
    H_ADH    -> H_MISS;
    H_MISS   -> K_TA1     [color = "#c62828", penwidth = 1.5, label = "lowers effective dose"];
    H_MISS   -> K_IPV     [penwidth = 1.4];
    K_IPV    -> H_DIP;
    H_DIP    -> T_NFAT    [color = "#e07b39", penwidth = 1.5, label = "NFAT escape"];
    H_DIP    -> B_DNDSA   [color = "#e07b39", penwidth = 1.5];
    H_INTERV -> H_ADH     [color = "#2e7d32"];
    H_MONITOR-> H_INTERV  [color = "#2e7d32"];
    H_MONITOR-> Q_DSAMON;

    /* --- 14/15 : function, fibrosis, the hyperfiltration loop --- */
    F_NM     -> F_SNGFR   [color = "#e07b39", label = "fewer nephrons -> higher SNGFR"];
    F_SNGFR  -> X_HYPER   [color = "#e07b39", penwidth = 1.5];
    X_HYPER  -> X_TGF     [color = "#e07b39", penwidth = 1.5];
    X_TGF    -> X_EMT;
    X_TGF    -> X_MYOF;
    X_MYOF   -> X_COLL;
    X_COLL   -> X_IFTA    [penwidth = 1.4];
    X_EMT    -> X_IFTA;
    X_IFTA   -> X_PTCRAR;
    X_PTCRAR -> X_TGF     [color = "#e07b39", label = "hypoxia loop"];
    X_IFTA   -> X_BANFFCI;
    X_IFTA   -> F_NM      [color = "#c62828", penwidth = 1.6, label = "LOOP 2 closes"];
    F_HYAL   -> X_IFTA;
    F_HYAL   -> F_NM      [color = "#c62828"];
    F_NM     -> F_EGFR    [penwidth = 1.8];
    F_AFF    -> F_EGFR    [color = "#c62828", penwidth = 1.4];
    F_SNGFR  -> F_EGFR    [color = "#2e7d32", label = "partial compensation"];
    F_EGFR   -> F_SCR     [color = "#c62828", label = "clearance of creatinine"];
    F_EGFR   -> F_SLOPE;
    F_SLOPE  -> Q_IBOX;
    F_PROT   -> Q_IBOX;
    F_PROT   -> X_TGF     [label = "proteinuric tubular stress"];
    F_EGFR   -> E_EGFR12;
    F_EGFR   -> E_DIAL    [label = "< 15 mL/min"];
    F_BP     -> X_TGF     [style = dashed];

    /* --- 16 : BK --- */
    V_LATENT -> V_REACT;
    V_REACT  -> V_BKV     [penwidth = 1.4];
    V_BKV    -> V_VIRURIA;
    V_TCTRL  -> V_BKV     [color = "#c62828", penwidth = 1.4, label = "immune clearance"];
    N_NIS    -> V_TCTRL   [color = "#c62828", penwidth = 1.4];
    V_BKV    -> V_BKVAN   [label = "sustained > 10^4 copies/mL"];
    V_BKVAN  -> F_NM      [color = "#c62828", penwidth = 1.4];
    V_BKVAN  -> M_TUB     [style = dashed, label = "mimics TCMR histologically"];
    V_BKVAN  -> X_TGF;
    V_SCREEN -> V_BKV     [style = dashed, label = "detects"];
    V_SCREEN -> V_REDUCE  [penwidth = 1.5];
    V_REDUCE -> Y_MMF     [color = "#2e7d32", penwidth = 1.5, label = "-50% MPA first"];
    V_REDUCE -> K_TDOSE   [color = "#2e7d32", label = "then CNI target down"];
    V_REDUCE -> V_TRAP;
    V_TRAP   -> N_UNDER   [color = "#e07b39", penwidth = 1.4];
    V_BKV    -> F_CFDNA   [style = dashed];

    /* --- 17 : CMV and other over-immunosuppression --- */
    W_DRSTAT -> W_CMV     [penwidth = 1.3];
    W_VGC    -> W_GCVC;
    W_GCVC   -> W_CMV     [color = "#c62828", penwidth = 1.4];
    W_GCVC   -> W_WBC     [color = "#c62828", label = "myelosuppression"];
    F_EGFR   -> W_GCVC    [label = "renal clearance"];
    W_CMV    -> W_CMVDIS;
    W_CMV    -> A_AG      [style = dashed, color = "#e07b39", label = "indirect alloimmune effect"];
    W_WBC    -> W_LEUK;
    W_LEUK   -> Y_MMF     [color = "#c62828", style = dashed, label = "forces dose reduction"];
    Z_DEPL   -> W_WBC     [color = "#c62828"];
    W_PTDM   -> E_DWFG    [style = dashed];
    W_SEPSIS -> E_DWFG    [penwidth = 1.3];
    W_SKIN   -> E_DWFG    [style = dashed];
    W_PTLD   -> E_DWFG    [style = dashed];

    /* --- 18 : diagnostics and decisions --- */
    F_SCR    -> Q_SCRRISE;
    Q_SCRRISE-> Q_INDBX   [penwidth = 1.3];
    F_CFDNA  -> Q_CFDNA;
    Q_CFDNA  -> Q_INDBX;
    Q_INDBX  -> M_BANFFT;
    Q_INDBX  -> C_BANFFG;
    Q_INDBX  -> X_BANFFCI;
    Q_PROTBX -> M_SUBCL   [penwidth = 1.3];
    Q_INDBX  -> Q_MMDX;
    Q_DSAMON -> B_MFI;
    M_BANFFT -> Q_LADDER;
    C_ABMRDX -> Q_LADDER  [penwidth = 1.4];
    M_SUBCL  -> Q_LADDER;
    Q_LADDER -> Y_MP      [penwidth = 1.4];
    Q_LADDER -> Z_ATG     [label = "steroid-resistant TCMR"];
    Q_LADDER -> Z_PLEX;
    Q_LADDER -> Z_IVIG;
    Q_LADDER -> Z_RTX;
    Q_LADDER -> Z_TCZ     [label = "chronic active ABMR"];
    Q_LADDER -> Z_CD38;
    Q_IBOX   -> E_DCGS    [penwidth = 1.4];
    B_MFI    -> Q_IBOX;
    X_BANFFCI-> Q_IBOX;
    C_BANFFG -> Q_IBOX;

    /* --- 19 : endpoints --- */
    M_TUB    -> E_BPAR;
    C_ABMRDX -> E_BPAR;
    B_DNDSA  -> E_DNDSA5;
    F_SLOPE  -> E_SLOPE;
    E_CUMREJ -> E_HAZ     [penwidth = 1.3];
    F_EGFR   -> E_HAZ     [penwidth = 1.4];
    F_PROT   -> E_HAZ;
    C_TG     -> E_HAZ     [penwidth = 1.3];
    X_IFTA   -> E_HAZ     [penwidth = 1.3];
    B_DSA    -> E_HAZ;
    E_HAZ    -> E_DCGS    [penwidth = 1.8, color = "#8f2b2b"];
    E_DIAL   -> E_DCGS;
    E_DWFG   -> E_DCGS    [style = dashed, label = "censored"];

    /* --- 20 : scenarios point at the levers they move --- */
    S_STD    -> K_TDOSE   [style = dotted, color = "#7a7a94"];
    S_HIGH   -> Z_ATG     [style = dotted, color = "#7a7a94"];
    S_CYP    -> R_CYP3A5  [style = dotted, color = "#7a7a94"];
    S_BELA   -> Z_BELA    [style = dotted, color = "#7a7a94"];
    S_STER   -> Y_PRED    [style = dotted, color = "#7a7a94"];
    S_ADH    -> H_ADH     [style = dotted, color = "#7a7a94"];
    S_BK     -> V_SCREEN  [style = dotted, color = "#7a7a94"];
    S_TCMR   -> Y_MP      [style = dotted, color = "#7a7a94"];
    S_ABMR   -> Z_PLEX    [style = dotted, color = "#7a7a94"];
    S_DGF    -> D_CIT     [style = dotted, color = "#7a7a94"];
}
