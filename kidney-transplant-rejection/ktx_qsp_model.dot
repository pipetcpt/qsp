        Y_MMF     [label = "Mycophenolate mofetil 500-1000 mg BID\n(or EC-MPS 720 mg BID)", shape = octagon, fillcolor = "#d7e4ca"];
        Y_MMFD    [label = "MMF_D\ngut depot (ester prodrug)", peripheries = 2, fillcolor = "#d2e0c4"];
        Y_ESTER   [label = "Rapid esterase hydrolysis MMF -> MPA", shape = parallelogram, fillcolor = "#dae7cf"];
        Y_MPAC    [label = "MPA_C / MPA_P\nmycophenolic acid central / peripheral", peripheries = 2, fillcolor = "#d2e0c4"];
        Y_ALB     [label = "97-99% albumin bound\nfree fraction rises in hypoalbuminaemia and uraemia"];
        Y_UGT     [label = "UGT1A9 glucuronidation -> MPAG", shape = parallelogram, fillcolor = "#dae7cf"];
        Y_MPAG    [label = "MPAG\nglucuronide, biliary excreted", peripheries = 2, fillcolor = "#d2e0c4"];
        Y_EHC     [label = "Enterohepatic recirculation\ngut beta-glucuronidase regenerates MPA\n~ 30-40% of AUC, second peak at 6-12 h", shape = parallelogram, fillcolor = "#dae7cf"];
        Y_AUC     [label = "MPA AUC0-12 (mg.h/L)\ntherapeutic window 30-60", shape = hexagon, fillcolor = "#cddcbf"];
        Y_PRED    [label = "Prednisone PO daily\n(taper 20 -> 5 mg)", shape = octagon, fillcolor = "#d7e4ca"];
        Y_PREDC   [label = "PRED_C\nprednisolone (active)", peripheries = 2, fillcolor = "#d2e0c4"];
        Y_MP      [label = "Methylprednisolone IV pulse\n250-500 mg x 3 d for TCMR", shape = octagon, fillcolor = "#d7e4ca"];
        Y_MPC     [label = "MP_C\nmethylprednisolone", peripheries = 2, fillcolor = "#d2e0c4"];
        Y_GR      [label = "Glucocorticoid receptor -> trans-repression\nof NF-kB and AP-1 in APC and T cells", shape = parallelogram, fillcolor = "#dae7cf"];
        Y_EVR     [label = "Everolimus / sirolimus\nC0 3-8 ng/mL with reduced CNI", shape = octagon, fillcolor = "#d7e4ca"];
        Y_EVRC    [label = "EVR_C\nmTOR-inhibitor concentration", peripheries = 2, fillcolor = "#d2e0c4"];
    }

    /* ================================================================
       11. BIOLOGICS PK AND TARGET ENGAGEMENT
       ================================================================ */
    subgraph cluster_bio {
        label = "11. Biologics — induction, costimulation blockade, and the ABMR toolbox";
        style = "filled,rounded"; fillcolor = "#eef1f8"; color = "#9aa4cd";
        fontsize = 13; fontcolor = "#37417d";
        node [fillcolor = "#dfe3f3", color = "#8b95c4"];

        Z_ATG     [label = "Rabbit ATG (Thymoglobulin)\n1.5 mg/kg x 4-5 d · high immunological risk", shape = octagon, fillcolor = "#d2d7ef"];
        Z_ATGC    [label = "ATG_C\nrabbit ATG concentration (t1/2 ~ 30 d)", peripheries = 2, fillcolor = "#ccd2ec"];
        Z_DEPL    [label = "Polyclonal opsonisation, complement lysis,\napoptosis, margination of T cells\n(B and NK partially spared)", shape = parallelogram, fillcolor = "#d6dbf1"];
        Z_BAS     [label = "Basiliximab 20 mg d0 + d4\nstandard immunological risk", shape = octagon, fillcolor = "#d2d7ef"];
        Z_BASC    [label = "BAS_C\nbasiliximab (CD25 saturation ~ 4-6 weeks)", peripheries = 2, fillcolor = "#ccd2ec"];
        Z_BELA    [label = "Belatacept 10 -> 5 mg/kg IV monthly\nCNI-free maintenance (EBV-seropositive only)", shape = octagon, fillcolor = "#d2d7ef"];
        Z_BELAC   [label = "BELA_C\nbelatacept concentration", peripheries = 2, fillcolor = "#ccd2ec"];
        Z_OCC     [label = "CD80/CD86 receptor occupancy\nsignal-2 blockade (naive >> CD28-null memory)", shape = parallelogram, fillcolor = "#d6dbf1"];
        Z_RTX     [label = "Rituximab 375 mg/m2\nanti-CD20", shape = octagon, fillcolor = "#d2d7ef"];
        Z_RTXC    [label = "RTX_C\nrituximab concentration", peripheries = 2, fillcolor = "#ccd2ec"];
        Z_TCZ     [label = "Tocilizumab 8 mg/kg q4w /\nclazakizumab 25 mg q4w (anti-IL-6R / anti-IL-6)", shape = octagon, fillcolor = "#d2d7ef"];
        Z_TCZC    [label = "TCZ_C\nIL-6 axis blocker concentration", peripheries = 2, fillcolor = "#ccd2ec"];
        Z_CD38    [label = "Felzartamab / daratumumab\nanti-CD38 - reaches plasma cells AND NK", shape = octagon, fillcolor = "#d2d7ef"];
        Z_CD38C   [label = "FZB_C\nanti-CD38 concentration", peripheries = 2, fillcolor = "#ccd2ec"];
        Z_IVIG    [label = "IVIG 2 g/kg\nFc-mediated modulation, idiotype neutralisation", shape = octagon, fillcolor = "#d2d7ef"];
        Z_IVIGC   [label = "IVIG_C\npooled IgG concentration", peripheries = 2, fillcolor = "#ccd2ec"];
        Z_PLEX    [label = "Plasma exchange\n1-1.5 plasma volumes, alternate days\nremoves circulating IgG only", shape = octagon, fillcolor = "#d2d7ef"];
        Z_IDES    [label = "Imlifidase (IdeS)\ncleaves IgG below the hinge within hours\ndesensitisation for the positive crossmatch", shape = octagon, fillcolor = "#d2d7ef"];
        Z_ECU     [label = "Eculizumab (anti-C5)\nblocks MAC, leaves C4d and ADCC intact", shape = octagon, fillcolor = "#d2d7ef"];
        Z_BTZ     [label = "Bortezomib (proteasome inhibitor)\nplasma-cell directed - BORTEJECT was negative", shape = octagon, fillcolor = "#d2d7ef"];
    }

    /* ================================================================
       12. NET IMMUNOSUPPRESSION — THE CONTROLLED VARIABLE
       ================================================================ */
    subgraph cluster_nis {
        label = "12. NET IMMUNOSUPPRESSION — the single quantity that trades rejection against infection";
        style = "filled,rounded"; fillcolor = "#fff8e1"; color = "#dcc06a";
