        N_MPAINH  [label = "IMPDH inhibition\nEmax on lymphocyte proliferation", shape = parallelogram, fillcolor = "#fbe7ac"];
        N_STINH   [label = "Glucocorticoid trans-repression", shape = parallelogram, fillcolor = "#fbe7ac"];
        N_COSBLK  [label = "Costimulation blockade", shape = parallelogram, fillcolor = "#fbe7ac"];
        N_IL2BLK  [label = "CD25 blockade", shape = parallelogram, fillcolor = "#fbe7ac"];
        N_DEPL    [label = "Lymphodepletion", shape = parallelogram, fillcolor = "#fbe7ac"];
        N_NIS     [label = "NET IMMUNOSUPPRESSION (NIS, 0-1)\nthe controlled variable of transplantation", shape = diamond, fillcolor = "#f7d977", penwidth = 2.0];
        N_UNDER   [label = "UNDER-immunosuppression\nrejection, dnDSA, ABMR", shape = diamond, fillcolor = "#f9dd8e"];
        N_OVER    [label = "OVER-immunosuppression\nBK, CMV, PTLD, sepsis, malignancy", shape = diamond, fillcolor = "#f9dd8e"];
        N_UCURVE  [label = "U-SHAPED graft survival\nboth arms end at the same place", shape = hexagon, fillcolor = "#f5cf5e", penwidth = 2.0];
    }

