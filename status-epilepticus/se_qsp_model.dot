digraph Status_Epilepticus_QSP_Model {
  graph [
    label=<<B>Status Epilepticus — QSP Mechanistic Map</B><BR/><FONT POINT-SIZE="14">Status epilepticus is not a long seizure. It is a <B>receptor-trafficking clock</B>: the drug target is leaving the synapse while the clinician decides what to give.<BR/>ONE clock drives TWO receptor movements in OPPOSITE directions (synaptic γ2-GABA-A out, synaptic NMDA in), so benzodiazepine efficacy DECAYS and ketamine efficacy GROWS along the same time axis.<BR/>A third pool — extrasynaptic δ-GABA-A — is not internalised at all, which is why the drugs that survive benzodiazepine failure are the ones that never depended on the pool that was lost.<BR/>Everything downstream (the ESETT three-way tie, RAMPART's IM-beats-IV result, the subtle-SE response collapse, the negative allopregnanolone trial) is arithmetic on those three pools plus one delay.</FONT>>
    labelloc=t fontsize=22 fontname="Helvetica"
    rankdir=LR bgcolor="#F6F7F9"
    splines=spline nodesep=0.28 ranksep=0.95
    newrank=true
    compound=true concentrate=false
  ]
  node [fontname="Helvetica" fontsize=10 style="filled,rounded" shape=box margin="0.14,0.05"]
  edge [fontname="Helvetica" fontsize=8 arrowsize=0.65 color="#5A6270"]

  //==========================================================
  // CLUSTER 1 : Aetiology — sets the DRIVE term, not the drug term
  //==========================================================
  subgraph cluster_etio {
    label="🧨 1. Aetiology — sets DRIVE (the term drugs must out-suppress). Refractoriness = DRIVE > maximal achievable SUPPRESSION, not 'wrong drug chosen'"
    style=filled fillcolor="#FFEBEE" color="#B71C1C" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    E_withdraw [label="AED withdrawal / non-adherence\n(~20% of adult SE)\nDRIVE low · best prognosis\nmortality ≈ 4%" fillcolor="#FFCDD2" color="#B71C1C"]
    E_stroke   [label="Acute ischaemic stroke ·\nintracerebral haemorrhage\nDRIVE high · structural" fillcolor="#FFCDD2" color="#B71C1C"]
    E_anoxia   [label="★ Post-anoxic (cardiac arrest)\nDRIVE very high + neurons already dead\nSE is a MARKER, not the lesion\nmortality > 80%" fillcolor="#EF9A9A" color="#B71C1C" penwidth=2]
    E_cnsinf   [label="CNS infection\n(HSV encephalitis, bacterial meningitis)\nDRIVE high + BBB already open" fillcolor="#FFCDD2" color="#B71C1C"]
    E_autoimm  [label="★ Autoimmune encephalitis\n(anti-NMDAR, LGI1, GABA-B-R)\nDRIVE sustained by antibody\n→ no anticonvulsant can win\nuntil the antibody is removed" fillcolor="#EF9A9A" color="#B71C1C" penwidth=2]
    E_fires    [label="★ FIRES / NORSE\nIL-1β-driven, cryptogenic\n→ anakinra / tocilizumab, not more AED" fillcolor="#EF9A9A" color="#B71C1C" penwidth=2]
    E_metab    [label="Metabolic: hypoglycaemia · hyponatraemia\nhypocalcaemia · uraemia · hepatic\nDRIVE reversible — fix the number, not the receptor" fillcolor="#FFCDD2" color="#B71C1C"]
    E_tox      [label="Toxic: INH · bupropion · tramadol ·\ncocaine · theophylline · flumazenil\n(INH → pyridoxine, not more benzo)" fillcolor="#FFCDD2" color="#B71C1C"]
    E_tumour   [label="Tumour · cortical dysplasia ·\nremote symptomatic scar\nDRIVE moderate, chronic" fillcolor="#FFCDD2" color="#B71C1C"]
    E_febrile  [label="Febrile SE (children)\nprolonged FS → hippocampal T2 signal\n→ later MTS in a subset" fillcolor="#FFCDD2" color="#B71C1C"]
    E_genetic  [label="Genetic: Dravet (SCN1A) ·\nPCDH19 · KCNQ2\n(avoid Na-channel blockers in Dravet)" fillcolor="#FFCDD2" color="#B71C1C"]
    E_drive    [label="⇒ DRIVE  (model input EDRIVE)\nscales the excitatory source term\nof the network ODE" fillcolor="#B71C1C" fontcolor="white" color="#7F0000" penwidth=3 shape=box3d]
  }

  //==========================================================
  // CLUSTER 2 : Network — self-sustainment is BISTABILITY, not persistence
  //==========================================================
  subgraph cluster_net {
    label="🕸️ 2. Cortico-hippocampal network — self-sustainment is a BISTABLE switch. Once E-feedback gain > 1, removing the trigger no longer stops the seizure"
    style=filled fillcolor="#EDE7F6" color="#4527A0" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    N_trigger  [label="Trigger discharge\n(focal or generalised onset)" fillcolor="#D1C4E9" color="#311B92"]
    N_pyr      [label="Principal (pyramidal / granule) cells\nrecurrent excitatory collaterals" fillcolor="#D1C4E9" color="#311B92"]
    N_inhib    [label="Fast-spiking PV+ interneurons\n(the brake — and the first to fail)" fillcolor="#C5CAE9" color="#283593"]
    N_som      [label="SST+ / dendrite-targeting interneurons\n(depolarisation block at high rates)" fillcolor="#C5CAE9" color="#283593"]
    N_gain     [label="★ Excitatory feedback gain  G\nG = f(GLU, NR_SYN, AMPA) / f(INH)\nG > 1 ⇒ SELF-SUSTAINING" fillcolor="#B39DDB" color="#311B92" penwidth=2]
    N_bistable [label="★ BISTABLE state variable  SEIZ\ndSEIZ/dt = SEIZ·(G−1)·(1−SEIZ/SMAX) − k_term·SEIZ\ntwo stable roots: 0 and ~SMAX" fillcolor="#9575CD" color="#311B92" fontcolor="white" penwidth=3 shape=box3d]
    N_transit  [label="Transition to self-sustainment\n≈ 5 min of continuous activity\n(hence the ILAE t1 = 5 min definition)" fillcolor="#D1C4E9" color="#311B92"]
    N_spread   [label="Secondary generalisation\nthalamocortical + brainstem recruitment" fillcolor="#D1C4E9" color="#311B92"]
    N_depol    [label="Depolarisation block of interneurons\n(the brake fails from OVER-firing,\nnot from under-firing)" fillcolor="#C5CAE9" color="#283593"]
    N_gapj     [label="Gap junctions · ephaptic coupling ·\n[K+]o accumulation\n(drug-inaccessible synchronisation)" fillcolor="#D1C4E9" color="#311B92"]
    N_ko       [label="Extracellular [K+]o rise\n→ depolarises everything\n→ positive feedback" fillcolor="#D1C4E9" color="#311B92"]
  }

  //==========================================================
  // CLUSTER 3 : THE CLOCK, arm 1 — synaptic γ2-GABA-A leaves
  //==========================================================
  subgraph cluster_gabatraf {
    label="⏱️ 3. THE CLOCK, arm 1 — SYNAPTIC γ2-GABA-A RECEPTORS ARE INTERNALISED. This is the whole benzodiazepine story: the target itself is a decaying resource"
    style=filled fillcolor="#E3F2FD" color="#0D47A1" penwidth=3 fontsize=13 fontname="Helvetica-Bold"

    T_ca       [label="Seizure-driven Ca²⁺ entry\n+ PKC / PKA phosphorylation shift\nof γ2 (S327) and β3 (S408/409)" fillcolor="#BBDEFB" color="#0D47A1"]
    T_gephyrin [label="Gephyrin scaffold destabilised\n· collybistin displacement\n→ γ2 no longer anchored" fillcolor="#BBDEFB" color="#0D47A1"]
    T_ap2      [label="AP2-µ2 binds the γ2/β3 basic patch\n→ clathrin-coated pit" fillcolor="#BBDEFB" color="#0D47A1"]
    T_endo     [label="★ Clathrin-mediated ENDOCYTOSIS\nof γ2-containing synaptic GABA-A\nτ ≈ 20-30 min of continuous seizure" fillcolor="#64B5F6" color="#0D47A1" penwidth=2]
    T_rsyn     [label="★ R_SYN — synaptic γ2-GABA-A\nSTATE VARIABLE\n≈ −47% surface γ2 after 1 h of SE\n(Naylor 2005, dentate granule cells)" fillcolor="#1E88E5" fontcolor="white" color="#0D47A1" penwidth=3 shape=box3d]
    T_rendo    [label="R_ENDO — endosomal GABA-A pool\n(recycling is SLOW: hours)" fillcolor="#BBDEFB" color="#0D47A1"]
    T_lysos    [label="Lysosomal degradation\n(late; makes the loss semi-permanent)" fillcolor="#BBDEFB" color="#0D47A1"]
    T_mipsc    [label="mIPSC amplitude ↓\nquantal inhibition falls\nBEFORE any drug is given" fillcolor="#BBDEFB" color="#0D47A1"]
    T_bzloss   [label="★ Diazepam potency ↓ ~20-fold\nafter 30 min of SE\n(Kapur & Macdonald 1997)" fillcolor="#42A5F5" fontcolor="white" color="#0D47A1" penwidth=2]
    T_pbloss   [label="★ Phenobarbital potency ↓ only ~3-fold\n— barbiturate site is less dependent\non the γ2 subunit ⇒ SLOWER decay" fillcolor="#42A5F5" fontcolor="white" color="#0D47A1" penwidth=2]
  }

  //==========================================================
  // CLUSTER 4 : The pool that STAYS — extrasynaptic δ-GABA-A
  //==========================================================
  subgraph cluster_delta {
    label="🛡️ 4. THE POOL THAT STAYS — extrasynaptic α4/α6βδ GABA-A is NOT internalised (some evidence it INCREASES). Every drug that still works late acts here or downstream of the receptor"
    style=filled fillcolor="#E8F5E9" color="#1B5E20" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    D_rextra   [label="★ R_EXTRA — extrasynaptic δ-GABA-A\nSTATE VARIABLE · tonic conductance\nNOT lost during SE" fillcolor="#66BB6A" fontcolor="white" color="#1B5E20" penwidth=3 shape=box3d]
    D_tonic    [label="Tonic Cl⁻ conductance\n(sets the whole-cell shunt, not\nthe phasic IPSC)" fillcolor="#C8E6C9" color="#1B5E20"]
    D_bzinsens [label="★ δ-subunit receptors are\nBENZODIAZEPINE-INSENSITIVE\n⇒ benzos cannot recruit this pool" fillcolor="#A5D6A7" color="#1B5E20" penwidth=2]
    D_neuroster[label="Neurosteroid site (α+/β− interface)\nallopregnanolone · ganaxolone ·\nbrexanolone — HIGH δ efficacy" fillcolor="#A5D6A7" color="#1B5E20"]
    D_allowith [label="Endogenous allopregnanolone withdrawal\n(catamenial SE, post-partum)\n→ δ-receptor plasticity" fillcolor="#C8E6C9" color="#1B5E20"]
    D_propgab  [label="Propofol: direct GABA-A gating\n(β-subunit M286) — agonist, not modulator\n⇒ works with FEW receptors" fillcolor="#A5D6A7" color="#1B5E20"]
    D_barb     [label="Barbiturate: direct channel opening\nat high concentration\n+ AMPA/kainate block" fillcolor="#A5D6A7" color="#1B5E20"]
  }

  //==========================================================
  // CLUSTER 5 : THE CLOCK, arm 2 — synaptic NMDA arrives
  //==========================================================
  subgraph cluster_nmda {
    label="⏱️ 5. THE CLOCK, arm 2 — NMDA RECEPTORS MOVE INTO THE SYNAPSE. Same clock, opposite sign: this is why ketamine is the only drug that gets BETTER with delay"
    style=filled fillcolor="#FFF3E0" color="#E65100" penwidth=3 fontsize=13 fontname="Helvetica-Bold"

    M_intra    [label="NR_INTRA — intracellular NR1/NR2B pool\n(subsynaptic reserve)" fillcolor="#FFE0B2" color="#E65100"]
    M_exo      [label="★ Activity-driven EXOCYTOSIS +\nlateral diffusion into the PSD\n(SAP102 / PSD-95 capture)" fillcolor="#FFCC80" color="#E65100" penwidth=2]
    M_nrsyn    [label="★ NR_SYN — synaptic NMDA receptors\nSTATE VARIABLE\n≈ +38% synaptic NR1 within 1 h of SE\n(Naylor 2013)" fillcolor="#FB8C00" fontcolor="white" color="#E65100" penwidth=3 shape=box3d]
    M_ampa     [label="AMPA GluA1 insertion +\nGluA2 down-regulation\n→ Ca²⁺-permeable AMPA receptors" fillcolor="#FFE0B2" color="#E65100"]
    M_perampa  [label="Perampanel: non-competitive\nAMPA antagonist — target also GROWS" fillcolor="#FFCC80" color="#E65100"]
    M_ket      [label="★ Ketamine: open-channel NMDA blocker\nUSE-DEPENDENT — needs the channel\nOPEN, so late SE is its ideal substrate" fillcolor="#F57C00" fontcolor="white" color="#E65100" penwidth=2]
    M_mg       [label="Mg²⁺ block relieved by depolarisation\n(and by [K+]o rise)\n→ NMDA current grows non-linearly" fillcolor="#FFE0B2" color="#E65100"]
    M_early    [label="⚠️ Ketamine EARLY under-performs:\nfew synaptic NMDA receptors,\nchannels mostly shut ⇒ little to block" fillcolor="#FFCC80" color="#E65100"]
    M_cross    [label="★ CROSSOVER TIME\nthe minute at which ketamine's\nmarginal effect exceeds a benzo's\n— a model OUTPUT, not an assumption" fillcolor="#EF6C00" fontcolor="white" color="#BF360C" penwidth=3 shape=box3d]
  }

  //==========================================================
  // CLUSTER 6 : Chloride — GABA can become EXCITATORY
  //==========================================================
  subgraph cluster_cl {
    label="🧂 6. Chloride homeostasis — KCC2 down-regulation makes GABA-A opening DEPOLARISING. A fourth failure mode that no GABAergic drug can fix"
    style=filled fillcolor="#E0F7FA" color="#006064" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    C_kcc2     [label="★ KCC2 (SLC12A5) — Cl⁻ extruder\nDOWN-regulated / internalised by\nseizure + BDNF-TrkB signalling" fillcolor="#80DEEA" color="#006064" penwidth=2]
    C_nkcc1    [label="NKCC1 (SLC12A2) — Cl⁻ loader\nrelatively up-regulated\n(bumetanide target; trials negative)" fillcolor="#B2EBF2" color="#006064"]
    C_cli      [label="★ [Cl⁻]i RISES\nSTATE VARIABLE\nE_Cl shifts positive" fillcolor="#4DD0E1" color="#006064" penwidth=3 shape=box3d]
    C_ecl      [label="E_GABA → depolarising\nGABA-A opening now EXCITES\n⇒ benzos can paradoxically worsen" fillcolor="#80DEEA" color="#006064"]
    C_hco3     [label="HCO₃⁻ efflux through GABA-A\nadds a depolarising component" fillcolor="#B2EBF2" color="#006064"]
    C_bdnf     [label="BDNF → TrkB → Shc/PLCγ\ndrives KCC2 transcriptional loss" fillcolor="#B2EBF2" color="#006064"]
    C_shunt    [label="Residual SHUNTING inhibition\n(conductance, not driving force)\n— why GABA drugs still do something" fillcolor="#B2EBF2" color="#006064"]
  }

  //==========================================================
  // CLUSTER 7 : Endogenous terminators vs promoters
  //==========================================================
  subgraph cluster_endog {
    label="⚖️ 7. Endogenous neuropeptide balance — the brain's own OFF switch is consumed while its ON switch is up-regulated (a second, slower clock)"
    style=filled fillcolor="#F3E5F5" color="#4A148C" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    P_adeno    [label="★ Adenosine (A1 receptor)\nthe principal endogenous terminator\n— rises then is cleared by ADK" fillcolor="#CE93D8" color="#4A148C" penwidth=2]
    P_adk      [label="Adenosine kinase (ADK) up-regulated\nin reactive astrocytes\n→ terminator removed" fillcolor="#E1BEE7" color="#4A148C"]
    P_npy      [label="NPY (Y2/Y5) — inhibitory,\nreleased but depleted with time" fillcolor="#E1BEE7" color="#4A148C"]
    P_gal      [label="Galanin (GalR1/2) — inhibitory,\ndepleted in prolonged SE" fillcolor="#E1BEE7" color="#4A148C"]
    P_dyn      [label="Dynorphin (κ) — inhibitory, depleted" fillcolor="#E1BEE7" color="#4A148C"]
    P_subp     [label="★ Substance P / NK1 — EXCITATORY,\nUP-regulated during SE" fillcolor="#CE93D8" color="#4A148C" penwidth=2]
    P_nkb      [label="Neurokinin B · CRH · VIP\nexcitatory, up-regulated" fillcolor="#E1BEE7" color="#4A148C"]
    P_balance  [label="⇒ NETPEP = inhibitory peptides\n− excitatory peptides\nfalls monotonically with SE duration" fillcolor="#BA68C8" fontcolor="white" color="#4A148C" penwidth=2]
  }

  //==========================================================
  // CLUSTER 8 : Neuroinflammation & BBB
  //==========================================================
  subgraph cluster_infl {
    label="🔥 8. Neuroinflammation + BBB opening — a slow loop that both sustains the seizure and writes the chronic epilepsy that follows"
    style=filled fillcolor="#FFF8E1" color="#FF6F00" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    I_hmgb1    [label="HMGB1 released from stressed neurons\n→ TLR4" fillcolor="#FFECB3" color="#FF6F00"]
    I_il1b     [label="★ IL-1β (caspase-1 / inflammasome)\n→ IL-1R1 → Src → NR2B Tyr1472\nphosphorylation ⇒ MORE NMDA current" fillcolor="#FFE082" color="#FF6F00" penwidth=2]
    I_anakinra [label="Anakinra (IL-1Ra) · tocilizumab\n— rational only where IL-1 is the DRIVE\n(FIRES / NORSE)" fillcolor="#FFECB3" color="#FF6F00"]
    I_cox2     [label="COX-2 · PGE₂ · EP2 receptor\n→ BBB leak + neuronal loss" fillcolor="#FFECB3" color="#FF6F00"]
    I_astro    [label="Reactive astrogliosis\nglutamate uptake (EAAT2) ↓\n→ extracellular glutamate ↑" fillcolor="#FFECB3" color="#FF6F00"]
    I_micro    [label="Microglial activation\nTNF-α → AMPA GluA2 endocytosis" fillcolor="#FFECB3" color="#FF6F00"]
    I_bbb      [label="★ BBB opening (STATE)\nalbumin extravasation" fillcolor="#FFD54F" color="#FF6F00" penwidth=2]
    I_tgfb     [label="Albumin → TGF-β receptor on astrocytes\n→ Kir4.1 ↓ → K⁺ buffering fails\n→ epileptogenesis" fillcolor="#FFECB3" color="#FF6F00"]
    I_edema    [label="Vasogenic + cytotoxic oedema\n→ ICP ↑ → CPP ↓" fillcolor="#FFECB3" color="#FF6F00"]
    I_drugbbb  [label="⚠️ Open BBB CUTS BOTH WAYS:\nmore drug in — and more albumin,\nwhich binds phenytoin and valproate" fillcolor="#FFECB3" color="#FF6F00"]
  }

  //==========================================================
  // CLUSTER 9 : Excitotoxic injury — the SECOND integrator
  //==========================================================
  subgraph cluster_injury {
    label="💀 9. Excitotoxic neuronal injury — a SEPARATE integrator. 'Seizure stopped' and 'brain undamaged' are two different endpoints with two different clocks"
    style=filled fillcolor="#ECEFF1" color="#263238" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    X_glu      [label="Extracellular glutamate (STATE)\nrelease ↑ + EAAT2 uptake ↓" fillcolor="#CFD8DC" color="#263238"]
    X_cai      [label="★ Neuronal [Ca²⁺]i (STATE)\nNMDA + Ca-permeable AMPA + VGCC" fillcolor="#B0BEC5" color="#263238" penwidth=2]
    X_mito     [label="Mitochondrial Ca²⁺ overload\n→ mPTP opening · ΔΨm collapse" fillcolor="#CFD8DC" color="#263238"]
    X_atp      [label="ATP demand ≫ supply\n(a tonic-clonic seizure is\nmaximal aerobic exercise in the brain)" fillcolor="#CFD8DC" color="#263238"]
    X_ros      [label="ROS · lipid peroxidation ·\nPARP-1 over-activation → NAD⁺ depletion" fillcolor="#CFD8DC" color="#263238"]
    X_calpain  [label="Calpain-1 activation\n→ cytoskeletal + KCC2 cleavage" fillcolor="#CFD8DC" color="#263238"]
    X_apop     [label="Caspase-3 · AIF translocation\nnecrosis + apoptosis mix" fillcolor="#CFD8DC" color="#263238"]
    X_injury   [label="★ INJURY — cumulative integrator\ndINJURY/dt = k·(CA_I − θ)₊\nhippocampal CA1/CA3, dentate hilus,\namygdala, thalamus, cerebellar Purkinje" fillcolor="#78909C" fontcolor="white" color="#263238" penwidth=3 shape=box3d]
    X_nse      [label="Serum NSE · S100B · NfL\n(biomarkers that read INJURY,\nnot seizure duration)" fillcolor="#CFD8DC" color="#263238"]
    X_mri      [label="Peri-ictal MRI: DWI restriction,\nhippocampal T2 → later atrophy / MTS" fillcolor="#CFD8DC" color="#263238"]
  }

  //==========================================================
  // CLUSTER 10 : Systemic phase I — compensated (0-30 min)
  //==========================================================
  subgraph cluster_sys1 {
    label="🫀 10. Systemic PHASE I — COMPENSATED (≈ 0-30 min). Massive sympathetic surge keeps cerebral supply ahead of demand"
    style=filled fillcolor="#E1F5FE" color="#01579B" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    S1_cat     [label="Catecholamine surge\n(plasma NA/A ×10-100)" fillcolor="#B3E5FC" color="#01579B"]
    S1_map     [label="MAP ↑ · HR ↑ · CO ↑" fillcolor="#B3E5FC" color="#01579B"]
    S1_cbf     [label="CBF ↑ 200-600%\ncoupled to metabolic demand" fillcolor="#B3E5FC" color="#01579B"]
    S1_gluc    [label="Hyperglycaemia\n(catecholamine + glucagon)" fillcolor="#B3E5FC" color="#01579B"]
    S1_lac     [label="Lactic acidosis (muscular)\npH may fall to 7.0 — usually benign,\nresolves in minutes; do NOT chase it" fillcolor="#B3E5FC" color="#01579B"]
    S1_temp    [label="Core temperature ↑\nmuscular + hypothalamic" fillcolor="#B3E5FC" color="#01579B"]
    S1_wbc     [label="Leucocytosis · CSF pleocytosis\n(reactive; not proof of infection)" fillcolor="#B3E5FC" color="#01579B"]
  }

  //==========================================================
  // CLUSTER 11 : Systemic phase II — decompensated (>30 min)
  //==========================================================
  subgraph cluster_sys2 {
    label="🩸 11. Systemic PHASE II — DECOMPENSATED (> ~30 min). Supply now falls while demand stays maximal: the systemic switch that mirrors the receptor switch"
    style=filled fillcolor="#FBE9E7" color="#BF360C" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    S2_auto    [label="★ Cerebral autoregulation FAILS\nCBF becomes pressure-passive" fillcolor="#FFCCBC" color="#BF360C" penwidth=2]
    S2_hypo    [label="Systemic hypotension\n(catecholamine depletion +\nanaesthetic drugs)" fillcolor="#FFCCBC" color="#BF360C"]
    S2_mismatch[label="★ SUPPLY-DEMAND MISMATCH\ndemand still maximal, delivery falling\n⇒ injury accelerates" fillcolor="#FFAB91" color="#BF360C" penwidth=2]
    S2_gluc    [label="Hypoglycaemia (glycogen exhausted)\n→ removes the only fuel" fillcolor="#FFCCBC" color="#BF360C"]
    S2_hyper   [label="Hyperthermia > 40 °C\nindependently worsens injury" fillcolor="#FFCCBC" color="#BF360C"]
    S2_rhabdo  [label="Rhabdomyolysis → CK ↑ ↑ ·\nmyoglobinuric AKI · hyperkalaemia" fillcolor="#FFCCBC" color="#BF360C"]
    S2_resp    [label="Respiratory failure · aspiration ·\nneurogenic pulmonary oedema · hypoxaemia" fillcolor="#FFCCBC" color="#BF360C"]
    S2_takot   [label="Takotsubo · arrhythmia ·\ntroponin rise · SUDEP mechanism" fillcolor="#FFCCBC" color="#BF360C"]
    S2_dic     [label="DIC · multi-organ failure" fillcolor="#FFCCBC" color="#BF360C"]
  }

  //==========================================================
  // CLUSTER 12 : Benzodiazepine PK/PD + the ROUTE argument
  //==========================================================
  subgraph cluster_bzd {
    label="💉 12. First line — BENZODIAZEPINES. Their PK differences are real but small; the variable that dominates outcome is the DELAY before the first adequate dose"
    style=filled fillcolor="#E8EAF6" color="#1A237E" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    B_lzp      [label="LORAZEPAM 4 mg IV (0.1 mg/kg)\nVd 1.3 L/kg · t½ 14 h\nCNS t½keo ≈ 5 min · duration 12-24 h" fillcolor="#C5CAE9" color="#1A237E"]
    B_dzp      [label="DIAZEPAM 10 mg IV\nfastest onset, Vd 1.1 L/kg but\nREDISTRIBUTES out of brain in ~20 min\n⇒ early recurrence" fillcolor="#C5CAE9" color="#1A237E"]
    B_mdziv    [label="MIDAZOLAM 0.2 mg/kg IV\nshort t½ 1.5-3 h · water-soluble at pH 3.5,\nlipophilic at pH 7.4" fillcolor="#C5CAE9" color="#1A237E"]
    B_mdzim    [label="★ MIDAZOLAM 10 mg IM\nTmax ≈ 25 min — pharmacologically SLOWER" fillcolor="#9FA8DA" color="#1A237E" penwidth=2]
    B_mdznas   [label="Midazolam intranasal 0.2 mg/kg ·\nbuccal 10 mg · diazepam rectal 0.5 mg/kg\n(no-IV settings)" fillcolor="#C5CAE9" color="#1A237E"]
    B_iv       [label="⚠️ IV access in a convulsing patient\nmedian ≈ 5-8 min extra, often fails" fillcolor="#C5CAE9" color="#1A237E"]
    B_rampart  [label="★ RAMPART: IM MDZ 73.4% vs IV LZP 63.4%\nThe SLOWER drug WON, because\nADMINISTRATION delay > ABSORPTION delay.\nA logistics result, read as pharmacology" fillcolor="#7986CB" fontcolor="white" color="#1A237E" penwidth=3 shape=box3d]
    B_under    [label="★ UNDER-DOSING is the norm\n~⅔ receive < guideline dose;\nfear of respiratory depression\n— but PHTSE showed placebo intubation 22.5%\nvs lorazepam 10.6%: the SEIZURE\nsuppresses breathing more than the drug" fillcolor="#9FA8DA" color="#1A237E" penwidth=2]
    B_site     [label="Benzodiazepine site = α+/γ2− interface\n⇒ REQUIRES the γ2 subunit\n⇒ requires the pool that is being lost" fillcolor="#C5CAE9" color="#1A237E"]
    B_eff      [label="⇒ EFFECT = f(C_CNS) × R_SYN\nboth terms move — one up (dose),\none down (time)" fillcolor="#5C6BC0" fontcolor="white" color="#1A237E" penwidth=2]
    B_resp     [label="Respiratory depression · hypotension ·\nsedation confounding neuro exam" fillcolor="#C5CAE9" color="#1A237E"]
  }

  //==========================================================
  // CLUSTER 13 : Second line — why ESETT was a three-way tie
  //==========================================================
  subgraph cluster_second {
    label="⚖️ 13. Second line — ESETT's three-way tie is a STRUCTURAL PREDICTION: all three act on targets that are NOT time-dependently lost, so all three give the same modest, delay-insensitive ~46%"
    style=filled fillcolor="#F1F8E9" color="#33691E" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    L_lev      [label="LEVETIRACETAM 60 mg/kg IV (max 4500)\ntarget SV2A (presynaptic vesicle)\nlinear PK · renal · no interactions\nESETT 47%" fillcolor="#DCEDC8" color="#33691E"]
    L_fos      [label="FOSPHENYTOIN 20 mg PE/kg\nprodrug → phenytoin (t½conv ≈ 8-15 min)\ntarget Nav1 slow inactivation (axonal)\nESETT 45%" fillcolor="#DCEDC8" color="#33691E"]
    L_pht      [label="★ Phenytoin: MICHAELIS-MENTEN elimination\nVmax/Km · 90% albumin-bound\n→ free fraction rises in hypoalbuminaemia,\nuraemia, and when valproate displaces it" fillcolor="#C5E1A5" color="#33691E" penwidth=2]
    L_phtinf   [label="⚠️ Rate limit 50 mg/min (PHT) —\npropylene glycol vehicle → hypotension,\narrhythmia, purple glove.\nFosphenytoin 150 mg PE/min avoids the vehicle" fillcolor="#DCEDC8" color="#33691E"]
    L_vpa      [label="VALPROATE 40 mg/kg IV\nmultiple targets · saturable protein binding\nESETT 46% · avoid in hepatic / mitochondrial\n(POLG) disease and pregnancy" fillcolor="#DCEDC8" color="#33691E"]
    L_lac      [label="LACOSAMIDE 400 mg IV\nenhances SLOW Nav inactivation\n(alternative; not in ESETT)" fillcolor="#DCEDC8" color="#33691E"]
    L_brv      [label="BRIVARACETAM — SV2A, higher affinity,\nfaster brain entry than levetiracetam" fillcolor="#DCEDC8" color="#33691E"]
    L_tie      [label="★ THE STRUCTURAL POINT\nSV2A, Nav and VPA targets are\nPRESYNAPTIC / AXONAL — they are NOT\nendocytosed by seizure activity.\n⇒ same ~46%, and it barely decays with time.\nThe choice does not matter; the CLOCK does" fillcolor="#8BC34A" fontcolor="white" color="#33691E" penwidth=3 shape=box3d]
    L_ceiling  [label="⇒ but a delay-INSENSITIVE 46% is also a\nCEILING: second-line drugs cannot recover\nwhat the first-line delay already cost" fillcolor="#AED581" color="#33691E" penwidth=2]
  }

  //==========================================================
  // CLUSTER 14 : Third line — anaesthetics for RSE
  //==========================================================
  subgraph cluster_third {
    label="🛌 14. Third line — RSE anaesthesia. These act at sites that do not need γ2, so they still work; the cost moves from 'will it work' to 'what does it cost to keep it working'"
    style=filled fillcolor="#EFEBE9" color="#3E2723" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    A_mdzinf   [label="MIDAZOLAM infusion 0.05-2 mg/kg/h\nTACHYPHYLAXIS: receptor loss +\nactive metabolite 1-OH-midazolam-glucuronide\naccumulates in renal failure" fillcolor="#D7CCC8" color="#3E2723"]
    A_prop     [label="PROPOFOL 1-2 mg/kg bolus + 2-10 mg/kg/h\ndirect GABA-A gating · very fast offset\n⚠️ PRIS: > 4 mg/kg/h beyond 48 h" fillcolor="#D7CCC8" color="#3E2723"]
    A_pris     [label="Propofol infusion syndrome:\nlactic acidosis · rhabdomyolysis ·\nBrugada-like ECG · cardiac failure" fillcolor="#D7CCC8" color="#3E2723"]
    A_pent     [label="PENTOBARBITAL / THIOPENTAL\nhighest efficacy, longest offset\n(zero-order at high dose, fat depot)\nhypotension · ileus · immunosuppression" fillcolor="#D7CCC8" color="#3E2723"]
    A_ketinf   [label="KETAMINE 1.5-3 mg/kg bolus +\n1-10 mg/kg/h — HAEMODYNAMICALLY\nSUPPORTIVE (raises MAP)" fillcolor="#BCAAA4" color="#3E2723" penwidth=2]
    A_norket   [label="Norketamine (active, ~⅓ potency)\nCYP3A4/2B6 — accumulates on infusion" fillcolor="#D7CCC8" color="#3E2723"]
    A_iso      [label="Inhaled isoflurane / desflurane\n(rescue; needs an anaesthesia circuit in ICU)" fillcolor="#D7CCC8" color="#3E2723"]
    A_burst    [label="Titration target: burst-suppression\nvs seizure-suppression\n— no RCT shows deeper is better" fillcolor="#D7CCC8" color="#3E2723"]
    A_cost     [label="★ THE COST TERM\nintubation · vasopressors · VAP ·\nICU LOS · immobility.\nAn anaesthetic that stops the EEG but\ndoubles ICU days may not help the patient" fillcolor="#8D6E63" fontcolor="white" color="#3E2723" penwidth=2]
    A_wean     [label="Weaning after 24-48 h seizure-free;\n~50% relapse on first wean" fillcolor="#D7CCC8" color="#3E2723"]
  }

  //==========================================================
  // CLUSTER 15 : Neurosteroids and other non-classical routes
  //==========================================================
  subgraph cluster_steroid {
    label="🧪 15. Neurosteroids and adjuncts — the pharmacology that follows from cluster 4, and the trial that shows why a correct target is not sufficient"
    style=filled fillcolor="#F9FBE7" color="#827717" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    Y_allo     [label="ALLOPREGNANOLONE (brexanolone)\nsynaptic AND extrasynaptic GABA-A;\nno γ2 requirement" fillcolor="#F0F4C3" color="#827717"]
    Y_status   [label="★ STATUS Trial (SAGE-547, SRSE): NEGATIVE\nModel reading: correct target, wrong PATIENT —\nby SRSE the DRIVE term and INJURY integrator\nhave already moved past the point where\nrestoring inhibition changes the endpoint" fillcolor="#E6EE9C" color="#827717" penwidth=2]
    Y_ganax    [label="GANAXOLONE — synthetic analogue,\noral + IV, no steroid-hormone conversion" fillcolor="#F0F4C3" color="#827717"]
    Y_pyridox  [label="Pyridoxine 100 mg IV\n(INH toxicity; neonatal PDE)" fillcolor="#F0F4C3" color="#827717"]
    Y_thiamine [label="Thiamine 100 mg + glucose\n(never glucose alone in the malnourished)" fillcolor="#F0F4C3" color="#827717"]
    Y_mgso4    [label="Magnesium sulfate\n(eclampsia — a DIFFERENT disease with a\ndifferent right answer)" fillcolor="#F0F4C3" color="#827717"]
    Y_hypoth   [label="Therapeutic hypothermia (HYBERNATUS: negative\nfor functional outcome; fewer EEG seizures)" fillcolor="#F0F4C3" color="#827717"]
    Y_kd       [label="Ketogenic diet · immunotherapy ·\nVNS · resective surgery in SRSE" fillcolor="#F0F4C3" color="#827717"]
  }

  //==========================================================
  // CLUSTER 16 : Pharmacoresistance at the barrier
  //==========================================================
  subgraph cluster_resist {
    label="🚧 16. Pharmacoresistance — TWO independent hypotheses. Only one of them is fixed by giving more drug"
    style=filled fillcolor="#FCE4EC" color="#880E4F" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    R_pgp      [label="★ TRANSPORTER HYPOTHESIS\nP-glycoprotein (ABCB1) up-regulated on\nBBB endothelium by seizures (glutamate-COX2-PGE2)\n→ brain:plasma ratio falls" fillcolor="#F8BBD0" color="#880E4F" penwidth=2]
    R_bcrp     [label="BCRP (ABCG2) · MRP2 —\nadditional efflux at the barrier" fillcolor="#F8BBD0" color="#880E4F"]
    R_target   [label="★ TARGET HYPOTHESIS\nthe receptor itself is altered/absent\n(clusters 3, 5, 6)" fillcolor="#F48FB1" color="#880E4F" penwidth=2]
    R_diff     [label="⇒ THE TWO ARE DISTINGUISHABLE:\ntransporter resistance is beaten by DOSE,\ntarget resistance is beaten only by\nCHANGING TARGET.\nModel prediction: measure brain:plasma —\nif it is normal, stop escalating the same drug" fillcolor="#EC407A" fontcolor="white" color="#880E4F" penwidth=3 shape=box3d]
    R_bind     [label="Protein binding shifts (phenytoin, valproate)\nlook like resistance on a TOTAL level\nbut are not — measure FREE" fillcolor="#F8BBD0" color="#880E4F"]
    R_tach     [label="Acute tachyphylaxis to midazolam infusion\n(a target-side, not transporter-side, event)" fillcolor="#F8BBD0" color="#880E4F"]
  }

  //==========================================================
  // CLUSTER 17 : The delay chain — where the minutes actually go
  //==========================================================
  subgraph cluster_delay {
    label="⏳ 17. THE DELAY CHAIN — the single most consequential variable in the model, and the only one that is entirely operational"
    style=filled fillcolor="#E0F2F1" color="#004D40" penwidth=3 fontsize=13 fontname="Helvetica-Bold"

    Q_onset    [label="t = 0 · seizure onset\n(often unwitnessed)" fillcolor="#B2DFDB" color="#004D40"]
    Q_recog    [label="Recognition + 911 call\nmedian 2-10 min" fillcolor="#B2DFDB" color="#004D40"]
    Q_ems      [label="EMS arrival\nmedian 8-11 min" fillcolor="#B2DFDB" color="#004D40"]
    Q_prehosp  [label="★ Prehospital benzodiazepine\n— given in only ~⅓ of eligible patients" fillcolor="#80CBC4" color="#004D40" penwidth=2]
    Q_ed       [label="ED arrival · triage · IV access" fillcolor="#B2DFDB" color="#004D40"]
    Q_first    [label="★ TIME TO FIRST ADEQUATE DOSE\nobserved median ≈ 30 min\nguideline target ≤ 5 min" fillcolor="#4DB6AC" fontcolor="white" color="#004D40" penwidth=3 shape=box3d]
    Q_second   [label="Time to second-line agent\nobserved median ≈ 60-70 min\n(guideline 20-40 min)" fillcolor="#B2DFDB" color="#004D40"]
    Q_third    [label="Time to anaesthetic\nobserved median ≈ 3-8 h" fillcolor="#B2DFDB" color="#004D40"]
    Q_eeg      [label="⚠️ Time to EEG — often HOURS.\nUntil then, NCSE is invisible" fillcolor="#B2DFDB" color="#004D40"]
    Q_cliff    [label="★ THE TIMING CLIFF\nBecause R_SYN decays with τ ≈ 25 min,\nthe SAME milligram given at 10 vs 40 min\nbuys different amounts of inhibition.\nDose deficits EARLY cost more than LATE" fillcolor="#00897B" fontcolor="white" color="#004D40" penwidth=3 shape=box3d]
  }

  //==========================================================
  // CLUSTER 18 : Clinical endpoints and their dissociations
  //==========================================================
  subgraph cluster_endp {
    label="🎯 18. Clinical endpoints — and the three dissociations that make SE trials so hard to read"
    style=filled fillcolor="#F5F5F5" color="#212121" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    K_motor    [label="★ MOTOR manifestation amplitude\n(what the bedside sees)" fillcolor="#E0E0E0" color="#212121" penwidth=2]
    K_eeg      [label="★ ELECTROGRAPHIC burden\n(what the brain is doing)" fillcolor="#E0E0E0" color="#212121" penwidth=2]
    K_diss1    [label="★ DISSOCIATION 1 — ELECTROMECHANICAL\nMotor output fades with time and with\npartial treatment; EEG activity does not.\n⇒ 'subtle SE' / NCSE.\nVA Cooperative: lorazepam 64.9% in overt SE,\n7.7-24.2% in subtle SE — SAME DRUG" fillcolor="#BDBDBD" color="#212121" penwidth=3 shape=box3d]
    K_cess     [label="Clinical seizure cessation at 60 min\n(the ESETT / RAMPART primary endpoint)" fillcolor="#E0E0E0" color="#212121"]
    K_diss2    [label="★ DISSOCIATION 2 — STOPPING ≠ SAVING\nSEIZ and INJURY are separate states.\nTermination at 20 vs 60 min both count as\n'success' but differ several-fold in\ncumulative excitotoxic load" fillcolor="#BDBDBD" color="#212121" penwidth=3 shape=box3d]
    K_rse      [label="Refractory SE (~⅓) →\nSuper-refractory SE (>24 h, ~10-15%)" fillcolor="#E0E0E0" color="#212121"]
    K_mort     [label="In-hospital mortality\noverall ≈ 20% · RSE 30-40% · SRSE 30-50%\npost-anoxic > 80%" fillcolor="#E0E0E0" color="#212121"]
    K_mrs      [label="Functional outcome (mRS) · cognition ·\nSTESS / EMSE prognostic scores" fillcolor="#E0E0E0" color="#212121"]
    K_diss3    [label="★ DISSOCIATION 3 — AETIOLOGY DOMINATES\nMuch of the mortality variance is DRIVE,\nnot treatment. A trial that does not\nstratify on aetiology is measuring\ncase-mix, not the drug" fillcolor="#BDBDBD" color="#212121" penwidth=3 shape=box3d]
    K_los      [label="ICU length of stay · ventilator days ·\ntracheostomy · cost" fillcolor="#E0E0E0" color="#212121"]
  }

  //==========================================================
  // CLUSTER 19 : What SE leaves behind
  //==========================================================
  subgraph cluster_chronic {
    label="🕰️ 19. The tail — SE is also an epileptogenic event. The integrator that keeps running after the ICU discharge"
    style=filled fillcolor="#EDE7F6" color="#311B92" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    Z_latent   [label="Latent period (weeks-months)\nmossy fibre sprouting · gliosis ·\ninterneuron loss" fillcolor="#D1C4E9" color="#311B92"]
    Z_mts      [label="Mesial temporal sclerosis\n(CA1/CA3/hilar loss + granule cell dispersion)" fillcolor="#D1C4E9" color="#311B92"]
    Z_epilep   [label="★ EPILEPTOGENESIS integrator\n~20-40% develop chronic epilepsy after SE\n(driver = INJURY + INFLAMMATION, not\nseizure duration alone)" fillcolor="#B39DDB" color="#311B92" penwidth=2]
    Z_recur    [label="SE recurrence ~ 10-15% within 2 years" fillcolor="#D1C4E9" color="#311B92"]
    Z_cog      [label="Persistent memory / executive deficits ·\nreturn to work · depression · PTSD" fillcolor="#D1C4E9" color="#311B92"]
    Z_prevent  [label="⇒ Antiepileptogenic window:\nthe only interval in which IL-1 / COX-2 /\nTGF-β interventions could plausibly act\n— and it opens AFTER the emergency ends" fillcolor="#D1C4E9" color="#311B92"]
  }

  //==========================================================
  //  EDGES
  //==========================================================

  // 1 -> drive
  E_withdraw -> E_drive ; E_stroke -> E_drive ; E_anoxia -> E_drive
  E_cnsinf -> E_drive ; E_autoimm -> E_drive ; E_fires -> E_drive
  E_metab -> E_drive ; E_tox -> E_drive ; E_tumour -> E_drive
  E_febrile -> E_drive ; E_genetic -> E_drive
  E_cnsinf -> I_bbb [style=dashed color="#FF6F00"]
  E_fires -> I_il1b [color="#FF6F00" penwidth=2]
  E_autoimm -> M_nrsyn [label="anti-NMDAR internalises\nNMDA receptors — a\nDIFFERENT trafficking lesion" color="#B71C1C" style=dashed fontcolor="#B71C1C"]
  E_anoxia -> X_injury [style=dashed color="#B71C1C" label="injury precedes SE"]

  // 1/2 network
  E_drive -> N_trigger [penwidth=2 color="#B71C1C"]
  N_trigger -> N_pyr
  N_pyr -> N_gain [penwidth=2]
  N_inhib -> N_gain [arrowhead=tee color="#283593" penwidth=2]
  N_som -> N_gain [arrowhead=tee color="#283593"]
  N_gain -> N_bistable [penwidth=3 color="#4527A0"]
  N_bistable -> N_transit -> N_spread
  N_pyr -> N_depol -> N_inhib [arrowhead=tee color="#283593"]
  N_bistable -> N_ko -> N_pyr [color="#4527A0"]
  N_ko -> M_mg [color="#E65100"]
  N_gapj -> N_bistable
  N_bistable -> N_gapj [style=dotted]
  N_bistable -> K_motor [penwidth=2]
  N_bistable -> K_eeg [penwidth=2]

  // 2 -> 3 (the clock is DRIVEN by seizure activity)
  N_bistable -> T_ca [penwidth=3 color="#0D47A1" label="  activity drives the clock"]
  T_ca -> T_gephyrin -> T_ap2 -> T_endo
  T_ca -> T_ap2 [style=dashed]
  T_endo -> T_rsyn [arrowhead=tee penwidth=3 color="#0D47A1"]
  T_endo -> T_rendo -> T_lysos
  T_rendo -> T_rsyn [style=dashed label="slow recycling (hours)"]
  T_rsyn -> T_mipsc [penwidth=2]
  T_mipsc -> N_inhib [penwidth=2 color="#0D47A1"]
  T_rsyn -> T_bzloss [arrowhead=tee penwidth=2]
  T_rsyn -> T_pbloss [arrowhead=tee style=dashed]
  T_rsyn -> B_eff [penwidth=3 color="#0D47A1"]

  // 4 the pool that stays
  D_rextra -> D_tonic -> N_inhib [color="#1B5E20" penwidth=2]
  D_bzinsens -> D_rextra [style=dotted]
  D_neuroster -> D_rextra [penwidth=2 color="#1B5E20"]
  D_allowith -> D_rextra [arrowhead=tee style=dashed]
  D_propgab -> D_rextra [color="#1B5E20"]
  D_barb -> D_rextra [color="#1B5E20"]
  T_endo -> D_rextra [style=dotted label="NOT internalised" color="#1B5E20"]
  B_site -> D_bzinsens [style=dotted]

  // 5 the opposite clock
  N_bistable -> M_exo [penwidth=3 color="#E65100" label="  same clock, opposite sign"]
  M_intra -> M_exo -> M_nrsyn [penwidth=2 color="#E65100"]
  M_nrsyn -> N_gain [penwidth=3 color="#E65100"]
  M_nrsyn -> X_cai [penwidth=2 color="#263238"]
  M_ampa -> N_gain ; M_ampa -> X_cai
  N_bistable -> M_ampa [style=dashed color="#E65100"]
  M_perampa -> M_ampa [arrowhead=tee]
  M_mg -> M_nrsyn [label="unblocks"]
  M_ket -> M_nrsyn [arrowhead=tee penwidth=3 color="#E65100"]
  M_nrsyn -> M_ket [style=dashed label="  more open channels\n  ⇒ MORE ketamine effect" color="#E65100"]
  M_early -> M_ket [style=dotted]
  T_rsyn -> M_cross [style=dashed color="#0D47A1"]
  M_nrsyn -> M_cross [style=dashed color="#E65100"]
  I_il1b -> M_nrsyn [label="Src → NR2B pY1472" color="#FF6F00" penwidth=2]

  // 6 chloride
  N_bistable -> C_bdnf -> C_kcc2 [arrowhead=tee color="#006064" penwidth=2]
  X_calpain -> C_kcc2 [arrowhead=tee color="#006064"]
  C_kcc2 -> C_cli [arrowhead=tee penwidth=2 color="#006064"]
  C_nkcc1 -> C_cli [penwidth=2 color="#006064"]
  C_cli -> C_ecl [penwidth=2]
  C_hco3 -> C_ecl
  C_ecl -> N_inhib [arrowhead=tee penwidth=2 color="#006064" label="GABA becomes\ndepolarising"]
  C_shunt -> N_inhib [color="#006064" style=dashed]
  C_ecl -> B_eff [arrowhead=tee style=dashed color="#006064"]

  // 7 peptides
  N_bistable -> P_adeno ; P_adeno -> N_bistable [arrowhead=tee color="#4A148C" penwidth=2]
  P_adk -> P_adeno [arrowhead=tee color="#4A148C"]
  N_bistable -> P_adk [style=dashed]
  P_npy -> P_balance ; P_gal -> P_balance ; P_dyn -> P_balance ; P_adeno -> P_balance
  P_subp -> P_balance [arrowhead=tee] ; P_nkb -> P_balance [arrowhead=tee]
  N_bistable -> P_subp [color="#4A148C"] ; N_bistable -> P_nkb [style=dashed]
  N_bistable -> P_npy [arrowhead=tee style=dashed label="depletion"]
  N_bistable -> P_gal [arrowhead=tee style=dashed]
  N_bistable -> P_dyn [arrowhead=tee style=dashed]
  P_balance -> N_gain [arrowhead=tee penwidth=2 color="#4A148C"]

  // 8 inflammation
  N_bistable -> I_hmgb1 -> I_il1b [penwidth=2 color="#FF6F00"]
  I_il1b -> I_cox2 -> I_bbb [color="#FF6F00"]
  I_il1b -> I_bbb [color="#FF6F00"]
  I_anakinra -> I_il1b [arrowhead=tee penwidth=2]
  I_il1b -> I_astro -> X_glu [penwidth=2 color="#FF6F00"]
  I_il1b -> I_micro -> M_ampa
  I_bbb -> I_tgfb -> Z_epilep [color="#FF6F00"]
  I_bbb -> I_edema -> S2_mismatch [color="#BF360C"]
  I_bbb -> I_drugbbb
  I_drugbbb -> L_pht [style=dashed label="albumin → binding shift"]
  I_cox2 -> R_pgp [color="#880E4F" style=dashed]
  I_il1b -> N_gain [color="#FF6F00"]

  // 9 injury
  N_bistable -> X_glu [penwidth=2]
  X_glu -> X_cai [penwidth=2]
  X_cai -> X_mito -> X_ros -> X_apop
  X_cai -> X_calpain -> X_apop
  X_atp -> X_mito [arrowhead=tee]
  N_bistable -> X_atp [penwidth=2]
  X_cai -> X_injury [penwidth=3 color="#263238"]
  X_ros -> X_injury ; X_apop -> X_injury
  X_injury -> X_nse ; X_injury -> X_mri
  X_injury -> Z_latent -> Z_mts -> Z_epilep [color="#311B92"]
  X_injury -> Z_epilep [penwidth=2 color="#311B92"]
  X_injury -> K_mrs [arrowhead=tee penwidth=2]
  X_injury -> K_mort [penwidth=2]
  S2_mismatch -> X_injury [penwidth=3 color="#BF360C"]
  S2_hyper -> X_injury [color="#BF360C"]
  S2_gluc -> X_injury [color="#BF360C"]

  // 10 -> 11 systemic switch
  N_bistable -> S1_cat [penwidth=2]
  S1_cat -> S1_map -> S1_cbf
  S1_cat -> S1_gluc ; N_bistable -> S1_lac ; N_bistable -> S1_temp ; S1_cat -> S1_wbc
  S1_cbf -> X_atp [arrowhead=tee label="supply meets demand"]
  S1_cat -> S2_hypo [style=dashed label="depletion after ~30 min" color="#BF360C"]
  S1_gluc -> S2_gluc [style=dashed color="#BF360C"]
  S1_temp -> S2_hyper [style=dashed color="#BF360C"]
  S2_auto -> S2_mismatch [penwidth=2] ; S2_hypo -> S2_mismatch [penwidth=2]
  N_bistable -> S2_auto [style=dashed]
  N_bistable -> S2_rhabdo ; N_bistable -> S2_resp ; N_bistable -> S2_takot
  S2_resp -> S2_mismatch ; S2_rhabdo -> S2_dic ; S2_takot -> S2_hypo
  S2_takot -> K_mort [style=dashed]

  // 12 benzodiazepines
  Q_first -> B_lzp [style=dotted] ; Q_first -> B_mdzim [style=dotted]
  B_lzp -> B_site ; B_dzp -> B_site ; B_mdziv -> B_site ; B_mdzim -> B_site ; B_mdznas -> B_site
  B_site -> B_eff [penwidth=2]
  B_eff -> N_inhib [penwidth=3 color="#1A237E"]
  B_iv -> B_mdzim [style=dashed label="drives the IM choice"]
  B_iv -> B_rampart [style=dashed]
  B_mdzim -> B_rampart [penwidth=2]
  B_lzp -> B_rampart [style=dashed]
  B_under -> B_eff [arrowhead=tee penwidth=2 color="#1A237E"]
  B_under -> Q_first [style=dashed]
  B_lzp -> B_resp ; B_mdziv -> B_resp
  B_dzp -> K_cess [style=dashed label="early recurrence\n(redistribution)"]
  B_eff -> K_cess [penwidth=2]

  // 13 second line
  Q_second -> L_lev [style=dotted] ; Q_second -> L_fos [style=dotted] ; Q_second -> L_vpa [style=dotted]
  L_fos -> L_pht -> N_gain [arrowhead=tee]
  L_pht -> L_phtinf
  L_lev -> N_gain [arrowhead=tee] ; L_vpa -> N_gain [arrowhead=tee]
  L_lac -> N_gain [arrowhead=tee] ; L_brv -> N_gain [arrowhead=tee]
  L_lev -> L_tie ; L_fos -> L_tie ; L_vpa -> L_tie
  L_tie -> L_ceiling [penwidth=2]
  L_ceiling -> K_cess [penwidth=2]
  T_rsyn -> L_tie [style=dotted label="  these targets are\n  NOT in the decaying pool" color="#33691E"]
  L_vpa -> L_pht [style=dashed label="displaces from albumin" color="#880E4F"]
  L_pht -> R_bind [style=dashed]

  // 14 third line
  Q_third -> A_mdzinf [style=dotted] ; Q_third -> A_prop [style=dotted] ; Q_third -> A_ketinf [style=dotted]
  A_mdzinf -> B_site ; A_mdzinf -> A_cost
  A_prop -> D_propgab [penwidth=2] ; A_prop -> A_pris ; A_prop -> A_cost
  A_pent -> D_barb [penwidth=2] ; A_pent -> A_cost
  A_ketinf -> M_ket [penwidth=3 color="#E65100"]
  A_ketinf -> A_norket -> M_ket
  A_ketinf -> S2_hypo [arrowhead=tee color="#1B5E20" label="raises MAP"]
  A_iso -> D_barb [style=dashed]
  A_burst -> K_eeg [arrowhead=tee]
  A_cost -> K_los [penwidth=2] ; A_cost -> K_mrs [arrowhead=tee]
  A_mdzinf -> R_tach [color="#880E4F"]
  R_tach -> A_mdzinf [arrowhead=tee style=dashed]
  A_wean -> K_rse [style=dashed label="~50% relapse"]
  A_prop -> S2_hypo ; A_pent -> S2_hypo

  // 15 neurosteroids
  Y_allo -> D_neuroster [penwidth=2] ; Y_ganax -> D_neuroster
  Y_allo -> Y_status [penwidth=2]
  E_drive -> Y_status [style=dashed color="#B71C1C" label="the term that was\nnever addressed"]
  X_injury -> Y_status [style=dashed color="#263238"]
  Y_pyridox -> E_tox [arrowhead=tee] ; Y_thiamine -> E_metab [arrowhead=tee]
  Y_mgso4 -> N_gain [arrowhead=tee style=dashed]
  Y_hypoth -> X_injury [arrowhead=tee style=dashed]
  Y_kd -> K_rse [arrowhead=tee style=dashed]

  // 16 resistance
  R_pgp -> B_eff [arrowhead=tee color="#880E4F"]
  R_pgp -> L_pht [arrowhead=tee color="#880E4F"]
  R_bcrp -> R_pgp [style=dotted]
  T_rsyn -> R_target [style=dotted] ; M_nrsyn -> R_target [style=dotted] ; C_ecl -> R_target [style=dotted]
  R_pgp -> R_diff ; R_target -> R_diff [penwidth=2]
  R_bind -> R_diff [style=dashed]
  R_diff -> K_rse [penwidth=2]

  // 17 the delay chain
  Q_onset -> Q_recog -> Q_ems -> Q_prehosp -> Q_ed -> Q_first -> Q_second -> Q_third [penwidth=2 color="#004D40"]
  Q_ed -> Q_eeg [style=dashed]
  Q_eeg -> K_diss1 [style=dashed color="#004D40"]
  Q_first -> Q_cliff [penwidth=3 color="#004D40"]
  T_rsyn -> Q_cliff [penwidth=3 color="#0D47A1" style=dashed]
  Q_cliff -> B_eff [penwidth=3 color="#004D40"]
  Q_cliff -> K_rse [penwidth=2 color="#004D40"]
  Q_cliff -> X_injury [penwidth=2 color="#004D40"]

  // 18 endpoints and dissociations
  K_motor -> K_diss1 [penwidth=2] ; K_eeg -> K_diss1 [penwidth=2]
  T_rsyn -> K_motor [style=dashed label="motor output fades\nfaster than EEG"]
  K_motor -> K_cess [penwidth=2]
  K_cess -> K_diss2 ; X_injury -> K_diss2 [penwidth=2]
  K_cess -> K_rse [arrowhead=tee] ; K_rse -> K_mort [penwidth=2] ; K_rse -> K_los
  E_drive -> K_diss3 [penwidth=2 color="#B71C1C"] ; K_mort -> K_diss3
  K_mrs -> Z_cog [style=dashed]
  K_rse -> Z_recur [style=dashed]

  // 19 tail
  Z_epilep -> Z_recur ; Z_epilep -> Z_cog
  I_tgfb -> Z_prevent [style=dashed] ; I_il1b -> Z_prevent [style=dashed]
  Z_prevent -> Z_epilep [arrowhead=tee style=dashed]

  //==========================================================
  //  LEGEND
  //==========================================================
  subgraph cluster_legend {
    label="📌 Reading the map"
    style=filled fillcolor="#FFFFFF" color="#455A64" penwidth=2 fontsize=13 fontname="Helvetica-Bold"
    LG1 [label="★ = load-bearing node (a state variable\nor a derived quantity the model outputs)" shape=note fillcolor="#FFF9C4" color="#F57F17"]
    LG2 [label="───▶ promotes / produces\n───⊣ inhibits / consumes\n- - -▶ modulatory, slow, or conditional" shape=note fillcolor="#F5F5F5" color="#455A64"]
    LG3 [label="THE ONE-LINE MODEL\n\nEFFECT_benzo(t)  ∝  C_CNS(t) × R_SYN(t)\nEFFECT_ketamine(t) ∝ C_CNS(t) × NR_SYN(t)\nEFFECT_2nd-line(t) ∝ C_CNS(t) × 1\n\nR_SYN falls, NR_SYN rises, and the third\nterm is constant. Three curves, one clock." shape=note fillcolor="#E1F5FE" color="#01579B" penwidth=2]
    LG4 [label="WHAT THE MODEL IS FOR\n\nNot to choose a drug — ESETT already showed\nthe choice is nearly free. It is to price a\nMINUTE, and to say which drugs a minute costs\nyou (benzodiazepines) and which it does not\n(second line), and which one it buys you\n(ketamine)." shape=note fillcolor="#E8F5E9" color="#1B5E20" penwidth=2]
    LG1 -> LG2 [style=invis] ; LG2 -> LG3 [style=invis] ; LG3 -> LG4 [style=invis]
  }
}
