  /* =====================================================================
     ================  E D G E S  ========================================
     ===================================================================== */

  /* --- genetics into the core --------------------------------------- */
  G_SNCA  -> A_SYN   [label="gene dosage", color="#8e7cc3"];
  G_GBA1  -> L_ERGC  [label="misfolded GCase\nretained in ER", color="#8e7cc3"];
  G_GBA1  -> L_GCASE [style=dashed, arrowhead=tee, label="activity ↓"];
  G_TMEM  -> L_ACID  [arrowhead=tee];
  G_LRRK2 -> L_CMA   [arrowhead=tee, label="Rab10-P"];
  G_LRRK2 -> L_MACRO [arrowhead=tee];
  G_APOE4 -> B_APP;
  G_APOE4 -> A_FIB   [label="lipid-mediated\nseeding ↑", style=dashed];
  G_AGE   -> L_CMA   [arrowhead=tee];
  G_AGE   -> S_GLYM  [arrowhead=tee];
  G_SNCB  -> A_OLIG  [style=dashed];
  G_CHRNA -> C_NIC   [style=dashed];
  G_CYP   -> K_DONC  [label="CL variability", style=dashed];
  G_CYP   -> P_PIMC  [style=dashed];

  /* --- aggregation cascade ------------------------------------------ */
  A_SYN   -> A_MEMB;
  A_MEMB  -> A_SYN   [style=dashed];
  A_SYN   -> A_NUC1;
  A_NUC1  -> A_OLIG;
  A_OLIG  -> A_PROTO -> A_FIB -> A_LB;
  A_FIB   -> A_NUC2  [label="catalytic surface", color="#a00000"];
  A_SYN   -> A_NUC2;
  A_NUC2  -> A_OLIG  [label="★ autocatalysis", color="#a00000", penwidth=1.6];
  A_FIB   -> A_FRAG  -> A_FIB [label="more ends", color="#a00000"];
  A_PS129 -> A_FIB   [style=dashed];
  A_OLIG  -> A_PS129;
  A_TRUNC -> A_NUC1;
  A_FIB   -> A_STRAIN;
  A_STRAIN-> R_NEO   [label="DLB-fold tropism", style=dashed];
  A_LB    -> A_FIB   [style=dashed, label="reservoir"];

  /* --- clearance ------------------------------------------------------ */
  L_GCASE -> L_GLCC  [arrowhead=tee, label="hydrolyses"];
  L_ERGC  -> L_GCASE;
  L_GLCC  -> A_OLIG  [label="stabilises\noligomer", color="#a00000"];
  A_OLIG  -> L_ERGC  [arrowhead=tee, label="blocks GCase\ntrafficking", color="#a00000"];
  L_SWITCH-> L_GCASE [arrowhead=tee, style=bold, color="#b8860b"];
  L_GLCC  -> L_SWITCH[color="#b8860b"];
  A_OLIG  -> L_SWITCH[color="#b8860b"];
  L_CMA   -> A_SYN   [arrowhead=tee, label="degrades monomer"];
  A_OLIG  -> L_CMA   [arrowhead=tee, label="blocks LAMP2A"];
  L_MACRO -> A_FIB   [arrowhead=tee];
  L_UPS   -> A_SYN   [arrowhead=tee];
  A_OLIG  -> L_UPS   [arrowhead=tee];
  L_TFEB  -> L_MACRO;
  L_TFEB  -> L_GCASE;
  L_MTOR  -> L_TFEB  [arrowhead=tee];
  L_ACID  -> L_CTSD;
  L_CTSD  -> A_FIB   [arrowhead=tee];
  L_CTSD  -> A_TRUNC [label="partial digestion", style=dashed];
  L_ACID  -> L_GCASE;

  /* --- propagation ---------------------------------------------------- */
  A_FIB   -> S_EXO -> S_ISF;
  A_OLIG  -> S_EXO;
  S_ISF   -> S_UPT -> A_NUC2 [label="seeded conversion\nin recipient neuron", color="#a00000"];
  S_ISF   -> S_TNT -> A_NUC2;
  S_GLYM  -> S_ISF   [arrowhead=tee, label="washout"];
  Z_SLEEPGLY -> S_GLYM;
  S_GUT   -> R_BSTEM;
  S_OLF   -> R_LIMB;
  R_BSTEM -> R_LIMB  [label="ascending\nstaging"];
  R_LIMB  -> R_NEO;
  S_ISF   -> R_BSTEM; S_ISF -> R_LIMB; S_ISF -> R_NEO;
  R_ORDER -> R_NEO   [style=dotted];
  I_PHAGO -> S_ISF   [arrowhead=tee, label="microglial\nclearance"];

  /* --- region -> neuron populations ----------------------------------- */
  R_BSTEM -> N_LC    [arrowhead=tee];
  R_BSTEM -> Z_SLD   [arrowhead=tee];
  R_BSTEM -> T_RAPHE [arrowhead=tee];
  R_BSTEM -> D_SNC   [arrowhead=tee];
  R_BSTEM -> C_PPN   [arrowhead=tee];
  R_BSTEM -> U_CARD  [arrowhead=tee];
  R_BSTEM -> Z_ORX   [arrowhead=tee];
  R_LIMB  -> C_NBM   [arrowhead=tee];
  R_LIMB  -> E_SYN   [arrowhead=tee];
  R_NEO   -> E_SYN   [arrowhead=tee];
  R_NEO   -> V_VENT  [arrowhead=tee];
  R_NEO   -> V_V1    [arrowhead=tee];
  R_NEO   -> V_DORS  [arrowhead=tee];

  /* --- mitochondria / oxidative --------------------------------------- */
  A_OLIG  -> M_C1    [arrowhead=tee];
  A_OLIG  -> M_MITO  [arrowhead=tee];
  M_C1    -> M_ROS;
  M_MITO  -> M_ROS   [arrowhead=tee];
  M_CAV   -> M_CA -> M_ROS;
  M_ROS   -> A_OLIG  [label="oxidative\nmodification"];
  M_ROS   -> M_ATP   [arrowhead=tee];
  M_C1    -> M_ATP   [arrowhead=tee];
  M_ATP   -> E_SYN   [label="terminals fail\nfirst"];
  D_DA    -> M_DAQ -> M_ROS;
  M_NRF2  -> M_ROS   [arrowhead=tee];
  M_ROS   -> M_NRF2;
  M_CAV   -> D_SNC   [arrowhead=tee, label="pacemaking\nCa load"];
  M_CAV   -> N_LC    [arrowhead=tee];
  M_ROS   -> C_NBM   [arrowhead=tee];

  /* --- inflammation ---------------------------------------------------- */
  S_ISF   -> I_MG;
  I_MG    -> I_NLRP3 -> I_CYT;
  I_MG    -> I_PHAGO;
  I_CYT   -> I_PHAGO [arrowhead=tee, label="chronic\nexhaustion"];
  I_CYT   -> I_A1;
  I_A1    -> E_SYN   [arrowhead=tee];
  I_MG    -> I_C1Q -> E_SYN [arrowhead=tee, label="pruning"];
  I_CYT   -> M_ROS;
  I_TCELL -> I_MG;
  A_PS129 -> I_TCELL [label="MHC-II epitope", style=dashed];
  I_MG    -> I_TSPO  [style=dotted];
  I_A1    -> W_GFAP  [style=dotted];
  I_CYT   -> C_NBM   [arrowhead=tee];
  I_CYT   -> D_SNC   [arrowhead=tee];

  /* --- CHOLINERGIC transducer ------------------------------------------ */
  C_NBM   -> C_CHAT;
  C_PPN   -> E_THAL;
  C_CHAT  -> C_VACHT -> C_ACH;
  C_ACHE  -> C_ACH   [arrowhead=tee];
  C_BUCHE -> C_ACH   [arrowhead=tee];
  C_ACHE  -> C_BUCHE [arrowhead=tee, style=dashed, label="compensatory\nrise"];
  C_ACH   -> C_M1;
  C_ACH   -> C_M2 -> C_ACH [arrowhead=tee, label="autoinhibition"];
  C_ACH   -> C_NIC;
  C_CHAT  -> C_TRANS [color="#b8860b"];
  C_M1    -> C_TRANS [color="#b8860b", penwidth=1.4];
  C_ACHE  -> C_TRANS [color="#b8860b", arrowhead=tee];
  C_TRANS -> E_ATT   [penwidth=1.4];
  C_TRANS -> E_GAIN;
  C_TRANS -> V_TD    [label="attentional\nbinding"];
  C_NIC   -> E_THAL;
  E_THAL  -> E_ATT;

  /* --- DOPAMINERGIC transducer ----------------------------------------- */
  D_SNC   -> D_TH -> D_DA;
  D_SNC   -> D_DAT [style=dotted];
  D_DAT   -> W_DAT [style=dotted];
  D_SNC   -> D_VMAT;
  D_DA    -> D_D2;
  D_DA    -> D_D1;
  D_TH    -> D_TRANS [color="#b8860b"];
  D_D2    -> D_TRANS [color="#b8860b", penwidth=1.4];
  P_D2OCC -> D_TRANS [color="#b8860b", arrowhead=tee, penwidth=1.4];
  D_TRANS -> F_UPDRS [arrowhead=tee, penwidth=1.4];
  D_A2A   -> D_TRANS [arrowhead=tee];
  D_MESO  -> V_PAD   [label="aberrant\nsalience"];
  D_SNC   -> D_MESO  [style=dashed];

  /* --- SEROTONERGIC transducer ------------------------------------------ */
  T_RAPHE -> T_5HT;
  T_5HT   -> T_2A    [arrowhead=tee, style=dashed, label="denervation\nsupersensitivity"];
  R_NEO   -> T_2A    [label="local up-regulation\nin BA18/19"];
  T_2A    -> T_2AGQ -> E_GAIN;
  T_5HT   -> T_TRANS [color="#b8860b"];
  T_2A    -> T_TRANS [color="#b8860b", penwidth=1.4];
  T_TRANS -> V_PAD   [penwidth=1.4];
  T_1A    -> T_5HT   [arrowhead=tee];

  /* --- NORADRENERGIC ----------------------------------------------------- */
  N_LC    -> N_NE;
  N_NE    -> N_A1; N_NE -> N_A2;
  N_A1    -> N_AROUS;
  N_AROUS -> E_ATT   [penwidth=1.2];
  N_LC    -> U_BARO  [label="central baroreflex"];
  N_NE    -> Z_RBD   [arrowhead=tee, style=dashed];

  /* --- SLEEP ------------------------------------------------------------- */
  Z_SLD   -> Z_GIV -> Z_RBD [arrowhead=tee, label="atonia intact\nwhen present"];
  Z_ORX   -> Z_EDS   [arrowhead=tee];
  Z_ORX   -> W_ORXC  [style=dotted];
  Z_MEL   -> Z_RBD   [arrowhead=tee];
  Z_EDS   -> E_ATT   [arrowhead=tee];
  Z_RBD   -> W_PSG   [style=dotted];
  Z_RBD   -> F_FALL  [label="injurious\nenactment"];
  Z_SLEEPGLY -> Z_EDS [style=dashed];

  /* --- AUTONOMIC --------------------------------------------------------- */
  U_CARD  -> U_MIBG  [arrowhead=tee, style=dotted];
  U_CARD  -> U_OH;
  U_BARO  -> U_OH    [arrowhead=tee];
  U_OH    -> U_CBF   [arrowhead=tee];
  U_CBF   -> E_ATT   [label="transient dips →\nlooks like fluctuation"];
  U_OH    -> F_FALL;
  U_ENS   -> X_LDC   [arrowhead=tee, label="erratic gastric\nemptying"];
  U_URIN  -> X_ANTIC [style=dashed, label="drives\nprescribing"];
  X_DROX  -> U_OH    [arrowhead=tee];
  X_DROX  -> U_SUPH;
  U_SUPH  -> F_FALL  [style=dashed];

  /* --- AD CO-PATHOLOGY ---------------------------------------------------- */
  B_APP   -> B_PLQ;
  B_PLQ   -> B_TAU;
  B_TAU   -> B_PTAU  [style=dotted];
  B_PLQ   -> B_CROSS [color="#b8860b"];
  B_TAU   -> B_CROSS [color="#b8860b"];
  A_FIB   -> B_CROSS [color="#b8860b"];
  B_CROSS -> A_NUC2  [label="bilinear\nacceleration", color="#a00000", penwidth=1.4];
  B_CROSS -> B_TAU;
  B_TAU   -> E_SYN   [arrowhead=tee];
  B_CROSS -> B_PHENO [style=dotted];
  B_PHENO -> F_SURV  [arrowhead=tee, style=dashed];
  B_PHENO -> V_VH    [arrowhead=tee, style=dashed];
  B_PLQ   -> W_ABRAT [style=dotted];
  B_TAU   -> C_NBM   [arrowhead=tee];

  /* --- NETWORK / ATTENTION ------------------------------------------------ */
  E_SYN   -> F_MMSE;
  E_SYN   -> E_GAIN;
  E_THAL  -> E_EEG;
  E_ATT   -> E_EEG   [label="temporal\nvariability"];
  E_ATT   -> E_FLUC  [label="★ σ, not μ", penwidth=1.6, color="#b8860b"];
  E_ATT   -> F_ATT;
  E_ATT   -> V_TD;
  E_DMN   -> E_ATT;
  E_GAIN  -> V_PROTO;
  R_NEO   -> E_OCC   [style=dotted];
  E_OCC   -> E_CING  [style=dotted];
  E_OCC   -> V_BU    [arrowhead=tee];
  E_SYN   -> E_DMN;

  /* --- VISUAL / PAD -------------------------------------------------------- */
  V_RET   -> V_BU    [arrowhead=tee];
  V_V1    -> V_BU;
  V_VENT  -> V_BU;
  V_DORS  -> V_TD;
  V_BU    -> V_PAD   [arrowhead=tee, penwidth=1.4];
  V_TD    -> V_PAD   [arrowhead=tee, penwidth=1.4];
  V_PROTO -> V_PAD;
  V_PAD   -> V_VH    [penwidth=1.6];
  V_PAD   -> V_PASS;
  V_VH    -> V_DEL;
  V_VH    -> F_NPI   [penwidth=1.4];
  V_DEL   -> F_NPI;
  V_VH    -> F_CARE;

  /* --- ChEI PHARMACOLOGY ---------------------------------------------------- */
  K_RIVAPO-> K_RIVAC -> K_CARB;
  K_CARB  -> C_ACHE  [arrowhead=tee, penwidth=1.5];
  K_CARB  -> C_BUCHE [arrowhead=tee, label="dual inhibition —\nmatters late"];
  K_DONG  -> K_DONC -> K_DONE;
  K_DONE  -> C_ACHE  [arrowhead=tee, penwidth=1.5];
  K_GAL   -> C_ACHE  [arrowhead=tee];
  K_GAL   -> C_NIC   [label="allosteric\npotentiation"];
  K_RIVAC -> K_CHOLAE;
  K_DONC  -> K_CHOLAE;
  K_CHOLAE-> F_FALL;
  K_PATCH -> K_RIVAPO [style=dotted];
  K_PATCH -> K_CHOLAE [arrowhead=tee, style=dotted];
  X_ANTIC -> C_M1    [arrowhead=tee, penwidth=1.4, color="#a00000"];

  /* --- ANTIPSYCHOTIC / SENSITIVITY ------------------------------------------ */
  P_PIMG  -> P_PIMC -> P_PIMOC;
  P_PIMOC -> T_TRANS [arrowhead=tee, penwidth=1.5, color="#b8860b"];
  P_PIMC  -> P_QT;
  P_TYP   -> P_D2OCC [penwidth=1.5, color="#a00000"];
  P_QUET  -> P_D2OCC [style=dashed, label="low, transient"];
  P_CLOZ  -> P_D2OCC [style=dashed, label="very low"];
  P_CLOZ  -> T_2A    [arrowhead=tee, label="5-HT2A\ninverse agonism"];
  P_QUET  -> N_A1    [arrowhead=tee, label="→ orthostasis,\nsedation"];
  D_D2    -> P_NSENS [color="#a00000", penwidth=1.6, label="RESIDUAL signal =\ndensity × (1−occ)"];
  P_D2OCC -> P_NSENS [color="#a00000", penwidth=1.6];
  P_NSENS -> P_NMS   [penwidth=1.4];
  P_NMS   -> F_SURV  [arrowhead=tee, penwidth=1.4];
  P_NMS   -> F_UPDRS [penwidth=1.4];
  P_QT    -> F_SURV  [arrowhead=tee, style=dashed];
  P_PIMOC -> V_PAD   [arrowhead=tee, penwidth=1.4];

  /* --- MOTOR / OTHER --------------------------------------------------------- */
  X_LDG   -> X_LDC -> X_LDB;
  X_LDB   -> D_DA    [penwidth=1.2];
  D_VMAT  -> X_LDB   [label="storage needed for\nsmooth conversion", style=dashed];
  X_LDB   -> D_MESO  -> X_LDVH;
  X_LDVH  -> V_VH    [color="#a00000"];
  X_ZON   -> D_DA    [label="MAO-B inhibition"];
  X_ZON   -> F_UPDRS [arrowhead=tee];
  X_IST   -> D_A2A   [arrowhead=tee];
  X_MEM   -> X_NMDA  [arrowhead=tee];
  X_NMDA  -> E_SYN   [arrowhead=tee, label="excitotoxicity"];
  X_MEM   -> F_NPI   [arrowhead=tee, style=dashed];
  X_MELCL -> Z_RBD   [arrowhead=tee];
  X_MOD   -> Z_EDS   [arrowhead=tee];
  X_MOD   -> N_AROUS;

  /* --- DISEASE MODIFICATION --------------------------------------------------- */
  Y_AMB   -> L_ERGC  [label="chaperones GCase\nout of the ER", penwidth=1.3];
  Y_AMB   -> W_GCA   [style=dotted];
  Y_VENG  -> L_GLCC  [arrowhead=tee];
  Y_MAB   -> Y_TE -> S_ISF [arrowhead=tee, penwidth=1.3];
  Y_MAB   -> I_PHAGO [label="opsonisation →\nFcγR clearance"];
  Y_ASO   -> A_SYN   [arrowhead=tee, penwidth=1.3];
  Y_LRRK  -> L_CMA;
  Y_ADUC  -> B_PLQ   [arrowhead=tee];
  Y_ADUC  -> B_CROSS [arrowhead=tee, style=dashed];
  Y_WIN   -> L_SWITCH[style=dotted];
  L_SWITCH-> Y_WIN   [style=dotted];

  /* --- BIOMARKERS ------------------------------------------------------------- */
  S_ISF   -> W_SAA   [style=dotted];
  A_FIB   -> W_SAA   [style=dotted];
  E_SYN   -> W_NFL   [style=dotted, label="axonal loss"];
  R_BSTEM -> W_PSG   [style=dotted];
  E_EEG   -> F_ATT   [style=dotted];

  /* --- CLINICAL ENDPOINT INTEGRATION -------------------------------------------- */
  F_ATT   -> F_MMSE;
  E_FLUC  -> F_ATT   [arrowhead=tee, penwidth=1.3];
  E_FLUC  -> F_CARE;
  F_MMSE  -> F_CDR   [arrowhead=tee];
  F_MMSE  -> F_ADL;
  F_UPDRS -> F_FALL;
  F_UPDRS -> F_ADL   [arrowhead=tee];
  F_NPI   -> F_ADL   [arrowhead=tee];
  F_NPI   -> F_CARE;
  F_FALL  -> F_SURV  [arrowhead=tee];
  F_CARE  -> F_SURV  [arrowhead=tee, style=dashed, label="institutionalisation"];
  F_MMSE  -> F_CIBIC;
  F_NPI   -> F_CIBIC;
  F_UPDRS -> F_CIBIC;
  E_SYN   -> F_SURV;

  /* --- the three transducers meet the endpoints ---------------------------------- */
  C_TRANS -> F_MMSE  [penwidth=1.4, color="#b8860b"];
  C_TRANS -> F_NPI   [arrowhead=tee, penwidth=1.4, color="#b8860b"];
  C_TRANS -> E_FLUC  [arrowhead=tee, penwidth=1.6, color="#b8860b",
                      label="★ largest single effect —\nfluctuation before mean"];
  C_TRANS -> V_PAD   [arrowhead=tee, penwidth=1.3, color="#b8860b"];

  /* --- an explanatory legend node ------------------------------------------------- */
  LEGEND [shape=note, fillcolor="#fffbe6", color="#b8860b", fontsize=9,
          label=<<B>Reading the map</B><BR ALIGN="LEFT"/>
          ─▶  activates / increases<BR ALIGN="LEFT"/>
          ─⊣  inhibits / decreases<BR ALIGN="LEFT"/>
          ····▶ measured by (biomarker)<BR ALIGN="LEFT"/>
          ★ octagon = a structural commitment of the model,<BR ALIGN="LEFT"/>
          &#160;&#160;&#160;not a fitted parameter<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>
          <B>The three transducers (clusters 7·8·9) are the same</B><BR ALIGN="LEFT"/>
          <B>equation with a different sign on receptor plasticity.</B><BR ALIGN="LEFT"/>
          ChEI superiority over AD, levodopa failure relative to PD,<BR ALIGN="LEFT"/>
          neuroleptic sensitivity and pimavanserin efficacy are all<BR ALIGN="LEFT"/>
          CONSEQUENCES of that, not separate rules.<BR ALIGN="LEFT"/>>];
}
