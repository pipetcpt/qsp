    Y_VENG  [label="VENGLUSTAT (GCS inhibitor —\nreduces GlcCer synthesis upstream)", fillcolor="#d9f2e6"];
    Y_MAB   [label="ANTI-α-SYN mAb\n(prasinezumab, cinpanemab)\nIgG1, t½ ~10–20 d,\nCSF:plasma ~0.1–0.3%", fillcolor="#d9f2e6"];
    Y_TE    [label="Target engagement:\nfree interstitial seed ↓", fillcolor="#d9f2e6"];
    Y_ASO   [label="SNCA-lowering ASO /\nsiRNA (intrathecal)", fillcolor="#d9f2e6"];
    Y_LRRK  [label="LRRK2 kinase inhibitor", fillcolor="#d9f2e6"];
    Y_ADUC  [label="Anti-amyloid mAb\n(lecanemab/donanemab) —\nacts only on the CO-PATHOLOGY arm;\nARIA risk with APOE ε4", fillcolor="#d9f2e6"];
    Y_WIN   [label="★ LEVER ARM, NOT A DEADLINE\nBecause the GBA1 loop is monostable, the\nsame ambroxol exposure started earlier buys\nmore simply by acting for longer against a\nsmaller burden — there is no cliff to miss.\nThat is a weaker claim than a therapeutic\nwindow, and it is the one the model can\nactually support. Prodromal/RBD cohorts are\nstill the right trial population, for the\nordinary reason.",
             shape=note, fillcolor="#fff2cc"];
  }

