/*
 * acn_qsp_model.dot
 * ---------------------------------------------------------------------------
 * 심상성 여드름 (Acne vulgaris, ACN)
 * Quantitative Systems Pharmacology mechanistic map
 *
 * 18 clusters · ~230 nodes · ~400 edges
 *
 * Render:
 *   dot -Tsvg acn_qsp_model.dot -o acn_qsp_model.svg
 *   dot -Tpng -Gdpi=150 acn_qsp_model.dot -o acn_qsp_model.png
 *
 * Legend (edge style):
 *   solid black   = mass flux / differentiation / lesion transit
 *   blue          = stimulation / activation
 *   red (tee)     = inhibition / suppression
 *   dashed green  = drug action
 *   dotted grey   = feedback / amplification loop
 *   dashed orange = adverse effect / safety liability
 *
 * The four classical pathogenic pillars are colour-anchored:
 *   (1) hyperseborrhoea .................. cluster 4  (gold)
 *   (2) infundibular hyperkeratinisation . cluster 5  (tan)
 *   (3) C. acnes dysbiosis / biofilm ..... cluster 6  (green)
 *   (4) inflammation ..................... clusters 7-9 (red/purple)
 * ---------------------------------------------------------------------------
 */
digraph ACN_QSP {
  graph [rankdir=TB, newrank=true, splines=spline, overlap=false, nodesep=0.26, ranksep=0.52,
         fontname="Helvetica", fontsize=11, compound=true,
         labelloc="t", label=<<B>심상성 여드름 (Acne vulgaris) — QSP Mechanistic Map</B><BR/>
         <FONT POINT-SIZE="11">Androgen–IGF-1/mTORC1–sebocyte axis · infundibular hyperkeratinisation · <I>C. acnes</I> phylotype/biofilm/resistance · NLRP3–IL-1β–Th17 inflammation · lesion-transit kinetics · topical/systemic/hormonal/isotretinoin pharmacology</FONT>>];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10,
         color="#555555", penwidth=1.0, margin="0.08,0.05"];
  edge  [fontname="Helvetica", fontsize=8, color="#444444", arrowsize=0.6];

  /* ===================================================================== */
  /* 1. 병인 — 유전·연령·외인 (Etiology / exposome)                          */
  /* ===================================================================== */
  subgraph cluster_etio {
    label=<<B>1. 병인 — 유전 · 부신초기발육 · 외인 (Exposome)</B>>;
    style="rounded,filled"; fillcolor="#FDF2F2"; color="#C0392B"; fontcolor="#943126";
    node [fillcolor="#FADBD8"];

    e_herit   [label="유전율 78–81%\n(쌍둥이 연구)", fillcolor="#F5B7B1", penwidth=2];
    e_gwas    [label="GWAS 위험 유전자좌\n(TGFB2 · OVOL1 · FST · WNT10A\nSEMA4B · 11q13.1)"];
    e_fst     [label="FST (Follistatin)\n→ TGF-β/액티빈 신호 조절"];
    e_tgfb2   [label="TGFB2 → 모낭피지선\n분화 프로그램 변화"];
    e_ovol1   [label="OVOL1 → 각질세포\n분화 조절"];
    e_cyp     [label="CYP17A1 · CYP1A1 다형성\n(스테로이드 생성 변이)"];
    e_ar_cag  [label="AR 유전자 CAG 반복 짧음\n→ 수용체 전사활성↑"];
    e_srd5a1  [label="SRD5A1 (5α-환원효소 1형)\n피지선 발현량 변이"];

    e_adrenar [label="부신초기발육 (Adrenarche)\n8–10세 · DHEA-S 상승", fillcolor="#F5B7B1", penwidth=2];
    e_puberty [label="사춘기 성선 성숙\n(LH/FSH → 성선 안드로겐)"];
    e_age     [label="연령 분포\n호발 15–19세 · 성인여성 지속형 12–22%"];
    e_sex     [label="성별: 청소년기 남>여\n성인기 여>남 (턱선·하부안면)"];

    e_diet_gi [label="고혈당지수 식이\n(High glycaemic load)", fillcolor="#F5B7B1", penwidth=2];
    e_dairy   [label="유제품 (특히 탈지유)\n웨이 단백 · 류신"];
    e_whey    [label="웨이/BCAA 보충제\n(운동 보조제)"];
    e_smoke   [label="흡연 (면포성 여드름 연관)"];
    e_humid   [label="고온다습 · 폐색성 화장품\n(Acne cosmetica)"];
    e_mech    [label="기계적 마찰·압박\n(Acne mechanica · 마스크)"];
    e_drug    [label="약물유발 여드름양 발진\n(EGFR 억제제·코르티코스테로이드·\n리튬·이소니아지드·안드로겐)"];
    e_pcos    [label="PCOS · 고안드로겐혈증\n(SAHA 증후군)", fillcolor="#F5B7B1", penwidth=2];
    e_stress  [label="심리적 스트레스\n(시험기 악화 재현)"];
    e_micro   [label="피부 마이크로바이옴\n다양성 감소"];
  }

  /* ===================================================================== */
  /* 2. 안드로겐 축 (Androgen axis)                                          */
  /* ===================================================================== */
  subgraph cluster_andro {
    label=<<B>2. 안드로겐 축 — 부신 · 성선 · 국소 스테로이드 생성</B>>;
    style="rounded,filled"; fillcolor="#FEF9E7"; color="#B7950B"; fontcolor="#7D6608";
    node [fillcolor="#FCF3CF"];

    a_crhhpa  [label="시상하부 CRH → 뇌하수체 ACTH"];
    a_zr      [label="부신 망상대 (Zona reticularis)"];
    a_dheas   [label="DHEA-S (혈중 저장형)", fillcolor="#F9E79F", penwidth=2];
    a_dhea    [label="DHEA"];
    a_andros  [label="Androstenedione"];
    a_lh      [label="LH → 난소 난포막세포 /\n고환 라이디히세포"];
    a_tt      [label="총 테스토스테론 (TT)", fillcolor="#F9E79F", penwidth=2];
    a_shbg    [label="SHBG (간 합성)", fillcolor="#F9E79F", penwidth=2];
    a_ft      [label="유리 테스토스테론 (FT)\n= 생물학적 활성분획", fillcolor="#F9E79F", penwidth=2];
    a_5ar1    [label="5α-환원효소 1형 (SRD5A1)\n피지선에 우세 발현", fillcolor="#F9E79F", penwidth=2];
    a_dht     [label="모낭내 DHT\n(AR 친화도 5–10배)", fillcolor="#F5B041", penwidth=2];
    a_3bhsd   [label="3β-HSD · 17β-HSD\n(피지선 국소 전환)"];
    a_ar      [label="안드로겐 수용체 (AR)\n피지세포·모낭 각질세포 핵수용체", fillcolor="#F5B041", penwidth=2];
    a_arE     [label="AR–ARE 결합 → 표적유전자 전사"];
    a_aromat  [label="아로마타제 → 에스트라디올\n(피지 억제 방향)"];
    a_insSHBG [label="인슐린 → 간 SHBG 합성 억제", fillcolor="#F8C471"];
    a_ee      [label="에스트로겐(EE) → SHBG 합성 유도"];
    a_pcosdrv [label="PCOS: LH/FSH비↑ · 난포막세포\n안드로겐 과분비"];
    a_lateCAH [label="비고전형 21-수산화효소 결핍\n(성인여성 난치성 여드름 감별)"];
  }

  /* ===================================================================== */
  /* 3. 영양·대사 신호 (Nutrient / metabolic signalling)                     */
  /* ===================================================================== */
  subgraph cluster_metab {
    label=<<B>3. 영양-대사 신호 — 인슐린 · IGF-1 · mTORC1/FoxO1</B>>;
    style="rounded,filled"; fillcolor="#EAF7F0"; color="#1E8449"; fontcolor="#145A32";
    node [fillcolor="#D5F5E3"];

    m_gl      [label="혈당부하 (Glycaemic load) ↑"];
    m_ins     [label="혈중 인슐린 ↑", fillcolor="#ABEBC6", penwidth=2];
    m_igfbp3  [label="IGFBP-3 ↓ (유리 IGF-1 증가)"];
    m_igf1    [label="IGF-1 (혈중 · 국소)", fillcolor="#7DCEA0", penwidth=2];
    m_igf1r   [label="IGF-1R / 인슐린 수용체\n(피지세포)"];
    m_pi3k    [label="PI3K → AKT"];
    m_foxo1   [label="FoxO1 (핵 배제 시 억제 해제)", fillcolor="#7DCEA0", penwidth=2];
    m_mtorc1  [label="mTORC1 (영양-성장 허브)", fillcolor="#52BE80", penwidth=2];
    m_leu     [label="류신/BCAA → Rag GTPase\n→ mTORC1 직접 활성화"];
    m_srebp   [label="SREBP-1c (지질생성 전사인자)", fillcolor="#7DCEA0", penwidth=2];
    m_pparg   [label="PPAR-γ (피지세포 분화·지질축적)"];
    m_lxr     [label="LXR-α → 지질생성 보조"];
    m_ampk    [label="AMPK (메트포민 표적) ⟂ mTORC1"];
    m_ir      [label="인슐린 저항성 (HOMA-IR↑)"];
    m_obes    [label="비만 · 지방조직 염증"];
  }

  /* ===================================================================== */
  /* 4. 피지선 생물학 & 피지 조성 (필러 1: 과피지)                            */
  /* ===================================================================== */
  subgraph cluster_seb {
    label=<<B>4. 피지선 · 피지 조성 — 필러 ① 과피지 (Hyperseborrhoea)</B>>;
    style="rounded,filled"; fillcolor="#FDF6E3"; color="#B9770E"; fontcolor="#7E5109";
    node [fillcolor="#FAE5D3"];

    s_stem    [label="피지선 줄기세포 (Blimp1⁺ · LRIG1⁺)"];
    s_prolif  [label="피지세포 증식\n(기저 피지세포)", fillcolor="#F0B27A", penwidth=2];
    s_diff    [label="피지세포 말단분화\n(지질 적재 · holocrine)", fillcolor="#F0B27A", penwidth=2];
    s_mass    [label="피지선 유효 질량 (SGM)", fillcolor="#E67E22", penwidth=2, fontcolor="white"];
    s_apop    [label="피지세포 세포자멸\n(이소트레티노인 표적)", fillcolor="#F0B27A"];
    s_holo    [label="Holocrine 분비 → 피지 배출"];
    s_ser     [label="피지 분비율 SER\n(µg/cm²/min)", fillcolor="#E67E22", penwidth=2, fontcolor="white"];

    s_tg      [label="트리글리세라이드 (~40%)"];
    s_wax     [label="왁스 에스터 (~25%)"];
    s_squal   [label="스쿠알렌 (~12%, 피부 고유)", fillcolor="#F0B27A", penwidth=2];
    s_sapien  [label="Sapienic acid (C16:1Δ6)\n(항균 · SCD-1 산물)"];
    s_chol    [label="콜레스테롤 · 콜레스테릴 에스터"];
    s_la      [label="리놀레산 (필수지방산)\n피지 증가 시 희석 결핍", fillcolor="#F5CBA7", penwidth=2];
    s_scd     [label="SCD-1 (지방산 불포화화)"];
    s_fasn    [label="FASN · ACC (지질 신생합성)"];
    s_sqox    [label="스쿠알렌 과산화물 (SQOX)\n면포유발 + 염증유발", fillcolor="#DC7633", penwidth=2, fontcolor="white"];
    s_ros     [label="ROS · 지질 과산화\n(UV · 포르피린 광반응)"];
    s_vitE    [label="피지 내 비타민 E ↓\n(항산화 방어 소진)"];
    s_crhr    [label="피지세포 CRH-R1\n(신경내분비 수용체)"];
    s_msh     [label="MC1R / α-MSH → 지질생성↑"];
    s_cb2     [label="CB2 카나비노이드 수용체\n(내인성 카나비노이드 지질생성)"];
    s_sp      [label="Substance P → NK-1R\n피지선 비대 · 비만세포 활성"];
  }

  /* ===================================================================== */
  /* 5. 모낭 누두부 각질화 (필러 2)                                          */
  /* ===================================================================== */
  subgraph cluster_ker {
    label=<<B>5. 모낭 누두부 과각화 — 필러 ② (Infundibular hyperkeratinisation)</B>>;
    style="rounded,filled"; fillcolor="#FBF3E4"; color="#9A7D0A"; fontcolor="#7D6608";
    node [fillcolor="#F9E79F"];

    k_kc      [label="누두부 각질형성세포"];
    k_prolif  [label="각질형성세포 증식↑ (Ki-67↑)", fillcolor="#F7DC6F", penwidth=2];
    k_diff    [label="이상 말단분화\n(K6/K16 · 인볼루크린 이상)"];
    k_desmo   [label="데스모좀 분해 지연\n(각질세포 응집 유지)", fillcolor="#F7DC6F", penwidth=2];
    k_fillag  [label="필라그린 발현 증가\n(누두부 국한)"];
    k_ladef   [label="리놀레산 결핍\n→ 장벽 이상 · 과각화 유발", fillcolor="#F7DC6F", penwidth=2];
    k_il1a    [label="IL-1α (각질세포 자가분비)\n면포 형성의 최초 신호", fillcolor="#F4D03F", penwidth=2];
    k_il1r    [label="IL-1R → MyD88 → NF-κB"];
    k_androk  [label="AR 매개 각질세포 증식"];
    k_retrar  [label="RAR-β/γ → 정상 분화 회복\n(레티노이드 표적)", fillcolor="#F7DC6F", penwidth=2];
    k_plug    [label="각질 플러그 (Corneocyte plug)", fillcolor="#D4AC0D", penwidth=2, fontcolor="white"];
    k_micro   [label="미세면포 (Microcomedone)\n임상 전 병변 저장고", fillcolor="#D4AC0D", penwidth=2, fontcolor="white"];
    k_dilate  [label="모낭 확장 · 벽 얇아짐"];
    k_rupture [label="모낭벽 파열\n(내용물 진피 유출)", fillcolor="#CA6F1E", penwidth=2, fontcolor="white"];
  }

  /* ===================================================================== */
  /* 6. Cutibacterium acnes 생태 (필러 3)                                    */
  /* ===================================================================== */
  subgraph cluster_cacnes {
    label=<<B>6. <I>Cutibacterium acnes</I> — 필러 ③ 이상균총 · 바이오필름 · 내성</B>>;
    style="rounded,filled"; fillcolor="#E8F8F5"; color="#117A65"; fontcolor="#0E6251";
    node [fillcolor="#D1F2EB"];

    c_niche   [label="무산소 · 지질 풍부 모낭 니치"];
    c_growth  [label="C. acnes 증식 (지질 의존)", fillcolor="#A3E4D7", penwidth=2];
    c_ia1     [label="Phylotype IA1 (여드름 우세)", fillcolor="#76D7C4", penwidth=2];
    c_ib_ii   [label="Phylotype IB · II (건강 피부 우세)"];
    c_iii     [label="Phylotype III (진행성 대식세포 반응)"];
    c_loss    [label="계통형 다양성 상실\n(균총 불균형 = 진정한 이상균총)", fillcolor="#76D7C4", penwidth=2];
    c_biofilm [label="바이오필름 (EPS 다당)\n항생제 침투 저해 · MIC 수백배↑", fillcolor="#48C9B0", penwidth=2, fontcolor="white"];
    c_plank   [label="부유성 (Planktonic) 집단"];
    c_lipase  [label="세균 리파아제 (GehA)\n→ 유리지방산 생성", fillcolor="#76D7C4", penwidth=2];
    c_ffa     [label="유리지방산 (FFA)\n면포유발 + 자극성", fillcolor="#45B39D", penwidth=2, fontcolor="white"];
    c_porph   [label="포르피린 (코프로/프로토포르피린 III)\n→ 광활성 ROS", fillcolor="#76D7C4", penwidth=2];
    c_camp    [label="CAMP factor (용혈독소)\n→ 각질세포 세포독성"];
    c_hyal    [label="히알루로니데이트 리아제"];
    c_prote   [label="세균 프로테아제 → PAR-2 활성화"];
    c_scfa    [label="단쇄지방산 (프로피온산)\n→ HDAC 억제 · 각질세포 반응 변화"];
    c_res23   [label="23S rRNA 돌연변이\n(에리트로마이신·클린다마이신 내성)", fillcolor="#F1948A", penwidth=2];
    c_res16   [label="16S rRNA G1058C\n(테트라사이클린 내성)", fillcolor="#F1948A", penwidth=2];
    c_erm     [label="erm(X) 획득 내성 유전자"];
    c_resfrac [label="내성 분획 (RESFRAC)\n항생제 선택압 하 증가", fillcolor="#E74C3C", penwidth=2, fontcolor="white"];
    c_sepi    [label="S. epidermidis (길항균)\n숙신산 생성 → C. acnes 억제"];
    c_malas   [label="Malassezia spp.\n(모낭염 감별진단)"];
  }

  /* ===================================================================== */
  /* 7. 선천면역 인식 (Innate recognition)                                   */
  /* ===================================================================== */
  subgraph cluster_innate {
    label=<<B>7. 선천면역 인식 — TLR2 · 인플라마좀 · 항균펩타이드</B>>;
    style="rounded,filled"; fillcolor="#FDEDEC"; color="#B03A2E"; fontcolor="#922B21";
    node [fillcolor="#FADBD8"];

    i_tlr2    [label="TLR2 (모낭주위 단핵구·각질세포)", fillcolor="#F1948A", penwidth=2];
    i_tlr4    [label="TLR4"];
    i_nod2    [label="NOD2 (세포내 펩티도글리칸 감지)"];
    i_par2    [label="PAR-2 (프로테아제 활성화 수용체)"];
    i_cd36    [label="CD36 (지질 스캐빈저 수용체)"];
    i_myd88   [label="MyD88 → IRAK → TRAF6"];
    i_nfkb    [label="NF-κB 활성화", fillcolor="#EC7063", penwidth=2, fontcolor="white"];
    i_ap1     [label="AP-1 (c-Jun/c-Fos)\n→ MMP 전사"];
    i_nlrp3   [label="NLRP3 인플라마좀\n(NLRP3–ASC–procaspase-1)", fillcolor="#EC7063", penwidth=2, fontcolor="white"];
    i_casp1   [label="Caspase-1 활성화"];
    i_prol1b  [label="pro-IL-1β → IL-1β 성숙", fillcolor="#E74C3C", penwidth=2, fontcolor="white"];
    i_kefflux [label="K⁺ 유출 · 리소좀 파열 · ROS\n(NLRP3 2차 신호)"];
    i_hbd2    [label="hBD-2 (β-디펜신 2)"];
    i_ll37    [label="LL-37 (카텔리시딘)"];
    i_psor    [label="Psoriasin (S100A7)"];
    i_gran    [label="그래뉼리신 · RNase 7"];
  }

  /* ===================================================================== */
  /* 8. 사이토카인 · 호중구 · 기질분해 (Effector inflammation)                */
  /* ===================================================================== */
  subgraph cluster_cyto {
    label=<<B>8. 사이토카인 · 호중구 · 기질 분해</B>>;
    style="rounded,filled"; fillcolor="#F5EEF8"; color="#7D3C98"; fontcolor="#5B2C6F";
    node [fillcolor="#E8DAEF"];

    y_il1b    [label="IL-1β", fillcolor="#C39BD3", penwidth=2];
    y_il8     [label="IL-8 / CXCL8 (호중구 주화)", fillcolor="#C39BD3", penwidth=2];
    y_tnf     [label="TNF-α", fillcolor="#C39BD3", penwidth=2];
    y_il6     [label="IL-6"];
    y_gmcsf   [label="GM-CSF"];
