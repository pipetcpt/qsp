digraph CIPN_QSP {
  rankdir=LR;
  fontname="Helvetica";
  labelloc="t";
  fontsize=20;
  label="Chemotherapy-Induced Peripheral Neuropathy (CIPN) — Mechanistic QSP Map\nNeurotoxic Drug Exposure (Cmax vs AUC vs Cumulative Dose) → DRG / Distal Axon Injury → Committed Degeneration & Coasting → Hyperexcitability → CIPN20 / TNSc / Dose Intensity / Tumour Control";
  node [style=filled, fontname="Helvetica", fontsize=10, shape=box];
  edge [fontname="Helvetica", fontsize=8];
  newrank=true;

  /* ======================================================================
     1. NEUROTOXIC CHEMOTHERAPY CLASSES & DOSING SCHEDULE
     ====================================================================== */
  subgraph cluster_drugs {
    label="1. Neurotoxic Chemotherapy: Class, Schedule & Cumulative Dose (the exposure the whole model is driven by)";
    style=filled; color="#d8c6d8"; fillcolor="#f2e8f2";
    Oxaliplatin [label="Oxaliplatin\n85 mg/m² q2w (FOLFOX)\n130 mg/m² q3w (CAPOX)", fillcolor="#e0b0e0"];
    Cisplatin [label="Cisplatin\n75–100 mg/m² q3w", fillcolor="#e0b0e0"];
    Carboplatin [label="Carboplatin\n(AUC 5–6 — minimally neurotoxic)"];
    Paclitaxel [label="Paclitaxel\n80 mg/m² weekly ×12\n175 mg/m² q3w", fillcolor="#c9b0e8"];
    Nab_paclitaxel [label="nab-Paclitaxel\n125 mg/m² d1,8,15"];
    Docetaxel [label="Docetaxel\n75–100 mg/m² q3w"];
    Bortezomib [label="Bortezomib\n1.3 mg/m² d1,4,8,11\nIV bolus vs SC", fillcolor="#b0c9e8"];
    Carfilzomib [label="Carfilzomib\n(lower PN — irreversible epoxyketone)"];
    Vincristine [label="Vincristine\n1.4 mg/m² (cap 2 mg) weekly", fillcolor="#c9b0e8"];
    Thalidomide [label="Thalidomide / lenalidomide\n(length-dependent axonopathy)"];
    Eribulin [label="Eribulin\n1.4 mg/m² d1,8"];
    Brentuximab [label="Brentuximab vedotin\n(MMAE payload)"];
    TDXd_ADC [label="Auristatin-payload ADCs\n(MMAE released in tissue)"];
    Cumulative_dose [label="CUMULATIVE DOSE\n(mg/m², the dominant\nCIPN determinant)", fillcolor="#e8a0a0"];
    Dose_per_cycle [label="Dose per cycle\n(→ Cmax)"];
    Cycle_interval [label="Cycle interval\n(q1w / q2w / q3w →\nrecovery time between hits)", fillcolor="#f5d5a8"];
    Infusion_duration [label="Infusion duration\n(2 h vs 3 h vs bolus vs SC)"];
    Treatment_duration [label="Planned duration\n(3 vs 6 months — IDEA)", fillcolor="#f5d5a8"];
    Route_SC_vs_IV [label="Route: SC vs IV bolus\n(same AUC, ~½ Cmax)", fillcolor="#bfe3f5"];
    Cmax_metric [label="Peak concentration\nCmax", fillcolor="#f5c6c6"];
    AUC_metric [label="Exposure\nAUC", fillcolor="#cfe8cf"];
  }

  /* ======================================================================
     2. SYSTEMIC PK & PLASMA DISPOSITION
     ====================================================================== */
  subgraph cluster_pk {
    label="2. Systemic Pharmacokinetics (plasma → tissue distribution)";
    style=filled; color="#cddff0"; fillcolor="#e7f0fa";
    PK_oxa_central [label="Oxaliplatin ultrafilterable Pt\ncentral cmt (Vc ≈ 13 L)"];
    PK_oxa_periph [label="Peripheral cmt\n(Vp ≈ 260 L)"];
    PK_pt_tissue [label="Long-lived tissue-bound Pt\n(t½ ≈ 273 days)", fillcolor="#f5c6c6"];
    PK_pt_erythrocyte [label="Erythrocyte-bound Pt\n(irreversible, t½ = RBC lifespan)"];
    Plasma_protein_binding [label="Plasma protein binding\n(Pt >85% irreversible)"];
    PK_pac_central [label="Paclitaxel central cmt\n(Cremophor EL micelles)"];
    PK_pac_p1 [label="Shallow peripheral\ncompartment"];
    PK_pac_p2 [label="Deep peripheral\ncompartment"];
    Saturable_pac [label="Saturable distribution &\nelimination (Michaelis–Menten)", fillcolor="#bfd8f0"];
    Time_above_thresh [label="Time above 0.05 µmol/L\n(Tc>0.05 — taxane PD driver)", fillcolor="#f5d5a8"];
    PK_btz_central [label="Bortezomib central cmt"];
    PK_btz_periph [label="Very large Vd\n(≈ 500–1900 L)"];
    CYP3A4 [label="CYP3A4/5 metabolism\n(paclitaxel 6α-OH, bortezomib)"];
    CYP2C8 [label="CYP2C8 metabolism\n(paclitaxel — *3 variant)"];
    Biliary_excretion [label="Biliary / faecal\nexcretion"];
    Renal_excretion [label="Renal excretion\n(platinum ~50% in 48 h)"];
    Hepatic_impairment [label="Hepatic impairment\n(↑ taxane exposure)"];
    Renal_impairment [label="Renal impairment\n(↑ platinum exposure)"];
  }

  /* ======================================================================
     3. TRANSPORTERS & THE UNPROTECTED DRG
     ====================================================================== */
  subgraph cluster_transport {
    label="3. Why the DRG? Transporters & the Absent Blood–Nerve Barrier (the anatomical basis of selectivity)";
    style=filled; color="#cfe6e0"; fillcolor="#e6f5f1";
    BNB_intact [label="Blood–nerve barrier\n(intact along nerve trunk)", fillcolor="#cfe8cf"];
    BNB_absent_DRG [label="BNB FENESTRATED at DRG\n& distal nerve terminals", fillcolor="#e8a0a0"];
    Fenestrated_caps [label="Fenestrated capillaries\n(no tight junctions)"];
    OCT2 [label="OCT2 / SLC22A2\n(oxaliplatin uptake into DRG)", fillcolor="#bfe3d8"];
    CTR1 [label="CTR1 / SLC31A1\n(cisplatin & Pt uptake)", fillcolor="#bfe3d8"];
    MATE1 [label="MATE1 / SLC47A1\n(Pt efflux)"];
    ATP7A_ATP7B [label="ATP7A / ATP7B\n(Pt sequestration & efflux)"];
    Pgp_ABCB1 [label="P-glycoprotein / ABCB1\n(taxane & vincristine efflux)", fillcolor="#bfe3d8"];
    ABCC1_MRP [label="MRP1/ABCC1\n(conjugate efflux)"];
    OATP1B1_1B3 [label="OATP1B1/1B3\n(hepatic uptake)"];
    DRG_neuron_soma [label="DRG SENSORY NEURON SOMA\n(large-diameter Aβ most vulnerable)", fillcolor="#e8a0a0"];
    Satellite_glia [label="Satellite glial cells\n(DRG)"];
    Long_axon_burden [label="Longest axons first\n(length-dependent, feet→hands)", fillcolor="#f5d5a8"];
    Metabolic_demand [label="High axonal metabolic\ndemand per unit length"];
    Free_nerve_endings [label="Intraepidermal free\nnerve endings (C/Aδ)"];
    Autonomic_ganglia [label="Autonomic ganglia\n(vincristine — ileus, orthostasis)"];
    Motor_axon_relative_sparing [label="Motor axons relatively\nspared (BNB-protected)", fillcolor="#cfe8cf"];
  }

  /* ======================================================================
     4. PLATINUM: DNA ADDUCTS & GENOTOXIC SOMA INJURY
     ====================================================================== */
  subgraph cluster_platinum {
    label="4. Platinum Mechanism: Nuclear & Mitochondrial DNA Adducts in the Post-Mitotic Neuron";
    style=filled; color="#e6d8c6"; fillcolor="#f7efe2";
    Aquation [label="Aquation / activation\n(oxaliplatin → DACH-Pt)"];
    Pt_GG_adduct [label="Pt–DNA 1,2-d(GpG)\nintrastrand crosslink", fillcolor="#e8c8a0"];
    Pt_interstrand [label="Interstrand crosslinks\n(minority, most cytotoxic)"];
    Nuclear_DNA_damage [label="Nuclear DNA damage\n(non-replicating neuron)"];
    mtDNA_adducts [label="mtDNA adducts\n(no NER in mitochondria)", fillcolor="#e8a0a0"];
    NER_ERCC1 [label="Nucleotide excision repair\n(ERCC1/XPD — repair capacity)", fillcolor="#cfe8cf"];
    ATR_CHK1 [label="ATR–CHK1 damage\nsignalling"];
    p53_activation [label="p53 activation\n(soma)"];
    PUMA_BAX [label="PUMA / BAX\napoptotic priming"];
    Nucleolar_stress [label="Nucleolar stress &\nribosome biogenesis arrest", fillcolor="#e8c8a0"];
    Transcription_arrest [label="RNA Pol II stalling →\ntranscription arrest"];
    Nucleolar_size [label="Reduced nucleolar volume\n(pathognomonic in DRG)"];
    Protein_synth_down [label="Somal protein synthesis ↓\n(cannot resupply axon)", fillcolor="#e8a0a0"];
    Soma_atrophy [label="DRG soma atrophy\n& chromatolysis"];
    Neuronopathy_pattern [label="SENSORY NEURONOPATHY\n(ganglionopathy, non-length-dependent)", fillcolor="#e8a0a0"];
    Oxalate_release [label="Oxalate release\n(oxaliplatin-specific)"];
    Ca_chelation [label="Ca²⁺ chelation by oxalate\n→ acute channelopathy", fillcolor="#f5c6c6"];
  }

  /* ======================================================================
     5. MICROTUBULE / AXONAL TRANSPORT FAILURE (TAXANES, VINCA, MMAE)
     ====================================================================== */
  subgraph cluster_microtubule {
    label="5. Microtubule & Axonal Transport Failure (taxanes, vinca alkaloids, auristatin ADCs)";
    style=filled; color="#d8d8c6"; fillcolor="#f2f2e2";
    Beta_tubulin_binding [label="β-tubulin binding\n(taxane site / vinca domain)", fillcolor="#e0e0a0"];
    MT_stabilization [label="Microtubule\nhyperstabilization (taxanes)"];
    MT_depolymerization [label="Microtubule\ndepolymerization (vinca, MMAE)"];
    MT_dynamics_loss [label="Loss of microtubule\ndynamic instability", fillcolor="#e0e0a0"];
    TUBB_variants [label="TUBB2A / TUBB3\npromoter & coding variants"];
    Kinesin_KIF5A [label="Kinesin-1 (KIF5A)\nanterograde transport"];
    Dynein [label="Dynein / dynactin\nretrograde transport"];
    Axonal_transport [label="AXONAL TRANSPORT CAPACITY\n(mitochondria, cargo, NGF signal)", fillcolor="#e8a0a0"];
    Mito_trafficking [label="Mitochondrial trafficking\nto distal axon", fillcolor="#e0e0a0"];
    Cargo_starvation [label="Distal cargo starvation\n(the 'dying-back' driver)", fillcolor="#e8a0a0"];
    NGF_retrograde [label="NGF/TrkA retrograde\ntrophic signalling ↓"];
    Bundling_MT [label="Aberrant microtubule\nbundles in axon"];
    Axon_swelling_pathology [label="Axonal swellings &\ncytoskeletal disorganization"];
    Mac_transport_block [label="Macrophage-independent\nprimary axonopathy", fillcolor="#e0e0a0"];
    Axonopathy_pattern [label="DISTAL AXONOPATHY\n(length-dependent, stocking-glove)", fillcolor="#e8a0a0"];
  }

  /* ======================================================================
     6. PROTEASOME INHIBITION (BORTEZOMIB)
     ====================================================================== */
  subgraph cluster_proteasome {
    label="6. Proteasome Inhibition (bortezomib): Cmax-Driven, Partly Reversible";
    style=filled; color="#c6d8e6"; fillcolor="#e2eff7";
    Proteasome_20S [label="20S proteasome β5\nchymotrypsin-like site", fillcolor="#a0c8e8"];
    Prot_inhibition [label="Proteasome inhibition\n(% — Cmax-driven)", fillcolor="#a0c8e8"];
    Reversible_binding [label="Slowly reversible boronate\nbinding (t½ ≈ 110 min)"];
    Ubiquitinated_aggregates [label="Ubiquitinated protein\naggregates in DRG"];
    ER_stress_UPR [label="ER stress / unfolded\nprotein response"];
    ATF4_CHOP [label="ATF4 / CHOP\napoptotic arm"];
    Autophagy_block [label="Autophagic flux\nimpairment"];
    Tubulin_polymer_btz [label="Secondary tubulin\npolymerization change"];
    Sphingolipid_ceramide [label="Ceramide / S1P\ndysregulation"];
    Schwann_myelin_btz [label="Schwann-cell &\nmyelin abnormality", fillcolor="#a0c8e8"];
    Small_fiber_predom [label="Small-fibre predominant,\npainful phenotype"];
    NFkB_block [label="NF-κB inhibition\n(anti-tumour arm)", fillcolor="#cfe8cf"];
  }

  /* ======================================================================
     7. MITOCHONDRIAL DYSFUNCTION & OXIDATIVE STRESS (COMMON FINAL PATH)
     ====================================================================== */
  subgraph cluster_mito {
    label="7. Mitochondrial Dysfunction & Oxidative Stress (the shared convergence node of all classes)";
    style=filled; color="#e6c6c6"; fillcolor="#f7e2e2";
    Complex_I [label="Complex I inhibition"];
    Complex_IV [label="Complex II/IV\nactivity ↓"];
    ETC_uncoupling [label="ETC uncoupling &\nmembrane potential loss"];
    mPTP [label="mPTP opening\n(cyclophilin D)", fillcolor="#e8a0a0"];
    ROS_generation [label="ROS / superoxide\ngeneration", fillcolor="#e8a0a0"];
    Peroxynitrite [label="Peroxynitrite (ONOO⁻)\n& nitrotyrosine"];
    Lipid_peroxidation [label="Lipid peroxidation\n(4-HNE, MDA)"];
    SOD2_catalase [label="SOD2 / catalase /\nGPx antioxidant defence", fillcolor="#cfe8cf"];
    GSH_pool [label="Glutathione pool\n(GSTP1 genotype)", fillcolor="#cfe8cf"];
    NAD_NMNAT2 [label="NMNAT2 / NAD⁺\naxon-survival factor", fillcolor="#cfe8cf"];
    SARM1_activation [label="SARM1 activation\n(NMN/NAD⁺ ratio sensor)", fillcolor="#e8a0a0"];
    NAD_collapse [label="Axonal NAD⁺ collapse"];
    ATP_axonal [label="Axonal ATP deficit\n(energy crisis)", fillcolor="#e8a0a0"];
    NaK_ATPase_axon [label="Axonal Na⁺/K⁺-ATPase\nfailure"];
    Ca_overload [label="Axoplasmic Ca²⁺\noverload"];
    Calpain [label="Calpain activation\n(cytoskeletal proteolysis)"];
    Megamitochondria [label="Swollen atypical / mega-\nmitochondria in axon"];
    Mitophagy [label="PINK1/Parkin mitophagy\n(clearance capacity)", fillcolor="#cfe8cf"];
    Bioenergetic_reserve [label="Bioenergetic reserve\n(pre-existing: age, diabetes)", fillcolor="#f5d5a8"];
  }

  /* ======================================================================
     8. COMMITTED AXON DEGENERATION & THE COASTING PHENOMENON
     ====================================================================== */
  subgraph cluster_degeneration {
    label="8. Committed Degeneration & COASTING (why CIPN worsens for weeks AFTER the last dose)";
    style=filled; color="#e6b0b0"; fillcolor="#f7dede";
    Axon_death_program [label="SARM1 axon-death\nEXECUTION program", fillcolor="#e8a0a0"];
    Commitment_threshold [label="Commitment threshold\n(damage past this point\nproceeds without drug)", fillcolor="#e8a0a0"];
    Latency_execution [label="Execution latency\n(weeks — slow, not Wallerian-fast)", fillcolor="#f5c6c6"];
    Coasting [label="COASTING\n(peak severity 4–12 weeks\nAFTER last dose)", fillcolor="#e8a0a0"];
    Residual_tissue_Pt [label="Residual tissue platinum\n(continues to drive injury)"];
    Distal_axon_loss [label="Distal sensory axon loss\n(IENFD ↓)", fillcolor="#e8a0a0"];
    IENFD [label="Intraepidermal nerve fibre\ndensity (fibres/mm)", fillcolor="#f5c6c6"];
    Myelinated_fiber_loss [label="Large myelinated fibre\nloss (sural nerve)"];
    Wallerian_like [label="Wallerian-like degeneration\nof distal segment"];
    Regeneration_program [label="Axonal regeneration &\ncollateral sprouting", fillcolor="#cfe8cf"];
    Regeneration_rate [label="Regeneration ≈ 1 mm/day\n(months for foot reinnervation)", fillcolor="#cfe8cf"];
    Regen_capacity_age [label="Regenerative capacity\n(↓ with age, diabetes)", fillcolor="#f5d5a8"];
    Incomplete_recovery [label="Incomplete recovery\n(~30–40% persistent at 6 yr)", fillcolor="#e8a0a0"];
    Neuron_loss_irreversible [label="DRG neuron death\n(irreversible floor — platinum)", fillcolor="#e8a0a0"];
    Reinnervation [label="Target reinnervation\n(skin, muscle spindle)", fillcolor="#cfe8cf"];
  }

  /* ======================================================================
     9. ION CHANNEL REMODELLING & PERIPHERAL HYPEREXCITABILITY
     ====================================================================== */
  subgraph cluster_channels {
    label="9. Ion-Channel Remodelling & Peripheral Hyperexcitability (fast, reversible — the ACUTE syndrome)";
    style=filled; color="#c6e6d8"; fillcolor="#e2f7ef";
    Nav16 [label="Nav1.6 / SCN8A\n(slowed inactivation — oxaliplatin)", fillcolor="#a0e8c8"];
    Nav17 [label="Nav1.7 / SCN9A\n(threshold amplifier)"];
    Nav18 [label="Nav1.8 / SCN10A\n(resurgent current)"];
    Persistent_Na [label="Persistent / resurgent\nNa⁺ current", fillcolor="#a0e8c8"];
    Kv7_KCNQ [label="Kv7.2/7.3 (KCNQ) M-current ↓\n(loss of brake)", fillcolor="#a0e8c8"];
    K2P_TREK [label="K2P TREK-1 / TRAAK ↓\n(cold-sensing brake)"];
    HCN1 [label="HCN1 Ih pacemaker ↑"];
    Kir_channels [label="Kir / leak conductance ↓"];
    TRPM8 [label="TRPM8 up-regulation\n(COLD allodynia)", fillcolor="#a0e8c8"];
    TRPA1 [label="TRPA1 sensitization\n(oxidative-stress sensor)"];
    TRPV1 [label="TRPV1 sensitization\n(heat, capsaicin target)"];
    TRPV4 [label="TRPV4 (mechanical\nallodynia)"];
    CaV32 [label="CaV3.2 T-type Ca²⁺\nchannel ↑"];
    CaV_alpha2delta [label="CaV α2δ-1 subunit ↑\n(gabapentinoid target)", fillcolor="#a0e8c8"];
    Ectopic_discharge [label="Ectopic spontaneous\ndischarge", fillcolor="#e8a0a0"];
    Axonal_hyperexcitability [label="AXONAL HYPEREXCITABILITY\nINDEX", fillcolor="#e8a0a0"];
    Acute_cold_allodynia [label="ACUTE cold allodynia\n(48–72 h, fully reversible)", fillcolor="#f5c6c6"];
    Pharyngolaryngeal [label="Pharyngolaryngeal\ndysaesthesia (oxaliplatin)"];
    Muscle_cramps [label="Muscle cramps &\nfasciculation"];
    Nerve_excitability_studies [label="Threshold tracking /\nnerve excitability testing"];
  }

  /* ======================================================================
     10. NEUROINFLAMMATION: DRG MACROPHAGES, SATELLITE GLIA, SCHWANN CELLS
     ====================================================================== */
  subgraph cluster_neuroinflam {
    label="10. Peripheral Neuroinflammation (DRG macrophages, satellite glia, Schwann cells, mast cells)";
    style=filled; color="#e6d8e6"; fillcolor="#f7eff7";
    DAMPs [label="DAMPs (HMGB1, mtDNA,\nATP) from injured neuron", fillcolor="#e0b0e0"];
    TLR4_MyD88 [label="TLR4 / MyD88\nsignalling", fillcolor="#e0b0e0"];
    NLRP3 [label="NLRP3 inflammasome\n& caspase-1"];
    DRG_macrophage [label="DRG macrophage\ninfiltration (CCR2⁺)", fillcolor="#e0b0e0"];
    CX3CR1 [label="CX3CL1/CX3CR1\nneuron–macrophage axis"];
    CXCL12_CXCR4 [label="CXCL12 / CXCR4\n(chronic maintenance)"];
    IL1beta [label="IL-1β", fillcolor="#e0b0e0"];
    TNFalpha [label="TNF-α"];
    IL6 [label="IL-6"];
    IL10_resolution [label="IL-10 / TGF-β\nresolution program", fillcolor="#cfe8cf"];
    Mast_cells [label="Mast-cell degranulation\n(histamine, tryptase)"];
    Satellite_glia_activation [label="Satellite glia activation\n(GFAP⁺, Cx43)"];
    Schwann_dedifferentiation [label="Schwann-cell de-differentiation\n& myelin abnormality"];
    Langerhans_cells [label="Epidermal Langerhans-cell\nactivation"];
    Keratinocyte_signaling [label="Keratinocyte–nerve\nterminal signalling"];
    T_cell_infiltration [label="CD8⁺ T-cell infiltration\n(chronic phase)"];
    Sensitization_peripheral [label="PERIPHERAL SENSITIZATION\n(lowered nociceptor threshold)", fillcolor="#e8a0a0"];
    Gut_microbiome [label="Gut microbiome / LPS tone\n(modulates TLR4 set-point)", fillcolor="#f5d5a8"];
  }

  /* ======================================================================
     11. SPINAL DORSAL HORN & CENTRAL SENSITIZATION
     ====================================================================== */
  subgraph cluster_central {
    label="11. Spinal Dorsal Horn & Descending Modulation (central amplification — the duloxetine target)";
    style=filled; color="#c6c6e6"; fillcolor="#e2e2f7";
    Primary_afferent_barrage [label="Primary afferent\nbarrage → dorsal horn"];
    WDR_neurons [label="Wide-dynamic-range\nprojection neurons", fillcolor="#a0a0e8"];
    Glutamate_NMDA [label="Glutamate / NMDA-R\n& AMPA-R"];
    Microglia_spinal [label="Spinal microglia\nactivation (P2X4)", fillcolor="#a0a0e8"];
    BDNF_TrkB [label="BDNF → TrkB\n→ KCC2 down-regulation"];
    Disinhibition [label="GABA/glycine\ndisinhibition"];
    Astrocyte_GLT1 [label="Astrocytic GLT-1\nglutamate uptake ↓"];
    Wind_up [label="Wind-up & long-term\npotentiation"];
    CENTRAL_SENS [label="CENTRAL SENSITIZATION\nGAIN", fillcolor="#e8a0a0"];
    Descending_NA [label="Descending noradrenergic\ninhibition (LC → α2)", fillcolor="#cfe8cf"];
    Descending_5HT [label="Descending serotonergic\nmodulation (RVM)", fillcolor="#cfe8cf"];
    DNIC_loss [label="Loss of diffuse noxious\ninhibitory control (DNIC)"];
    Thalamus_S1 [label="Thalamus → S1/S2\n(sensory-discriminative)"];
    ACC_insula [label="ACC / insula\n(affective-motivational)"];
    Catastrophizing [label="Pain catastrophizing,\nanxiety, poor sleep", fillcolor="#f5d5a8"];
    Perceived_pain [label="PERCEIVED PAIN\n(BPI 0–10)", fillcolor="#e8a0a0"];
  }

  /* ======================================================================
     12. RISK MODIFIERS & PHARMACOGENOMICS
     ====================================================================== */
  subgraph cluster_risk {
    label="12. Host Risk Modifiers & Pharmacogenomics (why identical exposure gives different CIPN)";
    style=filled; color="#e6e6c6"; fillcolor="#f7f7e2";
    Age [label="Older age\n(↓ regenerative reserve)", fillcolor="#e8e8a0"];
    Diabetes_baseline [label="Diabetes / prior\nsubclinical neuropathy", fillcolor="#e8e8a0"];
    Baseline_reserve [label="BASELINE AXONAL RESERVE\n(the reserve that\ndetermines grade crossing)", fillcolor="#e8a0a0"];
    Alcohol_hx [label="Alcohol use, B12 /\nfolate deficiency"];
    Obesity_BSA [label="Obesity & BSA-capped\ndosing"];
    Smoking [label="Smoking, vascular\ncomorbidity"];
    Prior_neurotoxic [label="Prior neurotoxic\nchemotherapy exposure", fillcolor="#e8e8a0"];
    CMT_carrier [label="Inherited neuropathy\n(CMT / PMP22) carrier", fillcolor="#e8a0a0"];
    GSTP1 [label="GSTP1 Ile105Val\n(platinum detoxification)"];
    ERCC1_var [label="ERCC1 / XPD variants\n(repair capacity)"];
    CYP2C8_3 [label="CYP2C8*3\n(paclitaxel clearance ↓)"];
    ABCB1_var [label="ABCB1 3435C>T\n(efflux)"];
    SCN9A_var [label="SCN9A / SCN10A\ngain-of-function variants"];
    EPHA_var [label="EPHA5/EPHA6\n(axon guidance) variants"];
    Female_sex [label="Sex differences in\npain phenotype"];
    Vitamin_D [label="Low vitamin D\n(taxane CIPN association)"];
    Physical_activity [label="Baseline physical\nactivity / fitness", fillcolor="#cfe8cf"];
  }

  /* ======================================================================
     13. PREVENTION STRATEGIES (EXPOSURE-LIMITING — MUST BE GIVEN PER CYCLE)
     ====================================================================== */
  subgraph cluster_prevention {
    label="13. Prevention: Exposure-Limiting Strategies (must be applied AT EVERY infusion to work)";
    style=filled; color="#c6e6c6"; fillcolor="#e2f7e2";
    Cryotherapy [label="Frozen-glove / sock\ncryotherapy (limb cooling)", fillcolor="#a0e8a0"];
    Vasoconstriction_local [label="Local vasoconstriction\n→ ↓ drug delivery to nerve", fillcolor="#a0e8a0"];
    Compression_therapy [label="Surgical-glove compression\ntherapy", fillcolor="#a0e8a0"];
    Limb_hypothermia_target [label="Skin temperature target\n(≈ 20–25 °C)"];
    Exercise_program [label="Sensorimotor / balance\nexercise program", fillcolor="#a0e8a0"];
    Exercise_mechanism [label="↑ mitochondrial biogenesis,\n↑ neurotrophins, ↓ inflammation"];
    Dose_capping [label="Dose capping / cycle\nomission (planned)"];
    Stop_and_go [label="Stop-and-go / OPTIMOX\nintermittent strategy", fillcolor="#a0e8a0"];
    Duration_3mo [label="3-month rather than\n6-month adjuvant (IDEA)", fillcolor="#a0e8a0"];
    SC_route [label="Subcutaneous route\n(bortezomib — ↓Cmax)", fillcolor="#a0e8a0"];
    Weekly_lower_dose [label="Weekly lower dose\n(bortezomib d1,8,15,22)"];
    Failed_CaMg [label="Ca²⁺/Mg²⁺ infusion\n(NEGATIVE — N08CB)", fillcolor="#d8d8d8"];
    Failed_glutathione [label="Glutathione / amifostine\n(insufficient evidence)", fillcolor="#d8d8d8"];
    Failed_vitE [label="Vitamin E\n(NEGATIVE)", fillcolor="#d8d8d8"];
    Harmful_ALC [label="Acetyl-L-carnitine\n(HARMFUL — worse CIPN)", fillcolor="#f5a0a0"];
