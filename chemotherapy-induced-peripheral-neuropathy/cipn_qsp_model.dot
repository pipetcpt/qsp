  Grade2_plus -> Dose_delay [label="triggers", color=red];
  Grade2_plus -> Dose_reduction [color=red];
  Grade3_plus -> Early_discontinuation [color=red];
  Dose_delay -> RDI [label="↓"];
  Dose_reduction -> RDI [label="↓"];
  Early_discontinuation -> RDI [label="↓↓"];
  Dose_reduction -> Cumulative_dose [label="↓", color=darkgreen];
  Early_discontinuation -> Cumulative_dose [label="↓↓", color=darkgreen];
  RDI -> Tumour_effective_exposure;
  Tumour_effective_exposure -> Tumour_kill;
  Tumour_kill -> Tumour_burden [label="↓"];
  Tumour_burden -> Resistance_clone;
  Resistance_clone -> Tumour_burden;
  Tumour_burden -> DFS [label="↓ DFS"];
  DFS -> OS;
  Risk_stratification -> Treatment_duration [label="informs"];
  Risk_stratification -> Utility_tradeoff;
  DFS -> Utility_tradeoff;
  Grade2_plus -> Utility_tradeoff [label="cost side"];
  Monitoring_strategy -> Dose_reduction [label="earlier, smaller"];
  Shared_decision -> Utility_tradeoff;
  Duration_3mo -> DFS [style=dashed, label="non-inferior\n(low risk)"];
  Duration_3mo -> Grade2_plus [label="↓↓", color=darkgreen];

  /* CROSS-CLUSTER CORE SPINE (highlighted) */
  Cumulative_dose -> DRG_neuron_soma [penwidth=3, color=red, label="CORE DRIVER"];
  DRG_neuron_soma -> Axonal_transport [penwidth=2, color=red];
  Axonal_transport -> ATP_axonal [penwidth=2, color=red];
  ATP_axonal -> SARM1_activation [penwidth=3, color=red, label="energy crisis →\ncommitment"];
  SARM1_activation -> Distal_axon_loss [penwidth=3, color=red];
  Distal_axon_loss -> Grade2_plus [penwidth=3, color=red, label="STRUCTURAL\nENDPOINT"];
  Grade2_plus -> RDI [penwidth=3, color=red];
  RDI -> DFS [penwidth=3, color=red, label="ONCOLOGIC\nCOST"];
}
