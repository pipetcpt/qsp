  subgraph cluster_tox {
    label="⑯ 장기계 효과 및 이상반응 (Organ-System Effects)"; style="rounded,filled";
    fillcolor="#faf0fd"; color="#7b2cbf"; fontsize=11; fontcolor="#5a189a";
    HRT      [label="심박수 ↓\n(β₁ 점유 유래)", fillcolor="#f1e2f7"];
    BPS      [label="수축기 혈압 ↓", fillcolor="#f1e2f7"];
    FEV1     [label=<FEV₁ ↓ · 기관지수축<br/><i>효능과 같은 β₂ 점유율</i>>, fillcolor="#f1e2f7", penwidth=1.6];
    HYPOGLY  [label="저혈당 자각증상 은폐\n(β₂ 매개)", fillcolor="#f1e2f7"];
    FATIGUE  [label="운동 내성 ↓·피로", fillcolor="#f1e2f7"];
    SEDAT    [label="졸림 (SED, 내성 발생)", fillcolor="#f1e2f7"];
    SEDTOL   [label="SED_TOL 내성 상태\nτ ≈ 10 일", fillcolor="#f1e2f7"];
    ATAXIA   [label="실조 지수\n(PB·에탄올·병변)", fillcolor="#f1e2f7"];
    COGWF    [label="인지·어휘 인출 장애\n(토피라메이트)", fillcolor="#f1e2f7"];
    HCO3     [label="HCO₃⁻ ↓ (CA 억제)\n→ 신결석 위험", fillcolor="#f1e2f7"];
    WTLOSS   [label="체중 감소\n(토피라메이트)", fillcolor="#f1e2f7"];
    BMD      [label="골밀도 ↓\n(PB → 25-OH-D ↓)", fillcolor="#f1e2f7"];
    LFT      [label="ALT ↑ · 간손상\n(만성 에탄올)", fillcolor="#f1e2f7"];
    INTOX    [label="취기 지수\n(피질 Kp × ETOH_BR)", fillcolor="#f1e2f7"];
    WDRAW    [label="금단 반동\n(β 상향조절·GABA 적응)", fillcolor="#f1e2f7"];
  }

  subgraph cluster_end {
    label="⑰ 임상 평가지표 — 로그 척도가 만드는 겉보기 불일치 (Endpoints: the log-scale artefact)";
    style="rounded,filled"; fillcolor="#f2ecff"; color="#5a189a"; fontsize=11; fontcolor="#3c096c";
    ACCEL    [label="가속도계 진폭 (cm)\n연속 선형 측정", fillcolor="#e6dcff"];
    LOGMAP   [label=<<b>Elble 로그 변환</b><br/>등급 = a + 2·log₁₀(A)<br/>1점 ≈ 3.16배 진폭>, fillcolor="#d9c9ff", penwidth=1.8];
    TETRASPS [label="TETRAS 수행 하위척도\n(0-64)", fillcolor="#e6dcff"];
    TETRASADL[label="TETRAS ADL 하위척도\n(0-48)", fillcolor="#e6dcff"];
    FTM      [label="Fahn-Tolosa-Marin\n(0-144)", fillcolor="#e6dcff"];
    SPIRAL   [label="Archimedes 나선\n(0-4)", fillcolor="#e6dcff"];
    BAINF    [label="Bain-Findley 척도\n(0-10)", fillcolor="#e6dcff"];
    QUEST    [label="QUEST 삶의질\n(0-100)", fillcolor="#e6dcff"];
    ADLSPOON [label="숟가락·컵 과제\n(흘림 여부)", fillcolor="#e6dcff"];
    HEADTR   [label="두부 떨림 (yes-yes/no-no)", fillcolor="#e6dcff"];
    VOICETR  [label="음성 떨림 (F0 변조 %)", fillcolor="#e6dcff"];
    ARTEFACT [label=<<b>유도된 결론</b><br/>가속도 −50%가 항목당 −0.6점<br/>→ '불일치'는 로그일 뿐>, fillcolor="#d9c9ff", penwidth=1.6];
    RESP     [label="반응자 정의\n(≥50% 진폭 vs ≥5점)", fillcolor="#e6dcff"];
  }

  subgraph cluster_state {
    label="⑱ 상태·과제 조절 및 감별진단 (State Modulation & Differential Diagnosis)";
    style="rounded,filled"; fillcolor="#f0f3f6"; color="#495867"; fontsize=11; fontcolor="#2f3e4d";
    POSTURAL [label="자세성 떨림 (팔 뻗기)", fillcolor="#e9edf2"];
    KINETIC  [label="운동성 떨림\n(손가락-코 검사)", fillcolor="#e9edf2"];
    INTENT   [label="의도성 떨림\n(종말 접근 시 이득 ↑)", fillcolor="#e9edf2"];
    VISDELAY [label="시각운동 되먹임 지연\n(추가 지연 경로)", fillcolor="#ffe3c2"];
    ANXIETY  [label="불안·수행 스트레스", fillcolor="#e9edf2"];
    CAFFEINE [label="카페인", fillcolor="#e9edf2"];
    FATIG2   [label="피로·수면부족", fillcolor="#e9edf2"];
    COOLING  [label="한랭 (냉각 → 진폭 ↓)", fillcolor="#e9edf2"];
    EPT      [label=<<b>강화 생리적 떨림 (EPT)</b><br/>μ&lt;0 · 주파수 = f₀(기계적)<br/>진폭은 구동에 선형>, fillcolor="#e9edf2", penwidth=1.6];
    THYRO    [label="갑상선기능항진증\n(CAT·β₂ 경로)", fillcolor="#e9edf2"];
    B2AGON   [label="살부타몰·테르부탈린", fillcolor="#e9edf2"];
    PDREST   [label="파킨슨 안정 떨림\n(4-6 Hz, 자세 시 감소)", fillcolor="#e9edf2"];
    DYSTR    [label="근긴장이상 떨림\n(영점·방향성)", fillcolor="#e9edf2"];
    ORTHOT   [label="기립성 떨림 (13-18 Hz)", fillcolor="#e9edf2"];
    HOLMES   [label="Holmes/소뇌 떨림\n(2-4 Hz)", fillcolor="#e9edf2"];
    LOADTEST [label=<<b>유도된 감별검사</b><br/>질량 부하 시 EPT 주파수 ↓↓<br/>ET 주파수는 거의 불변>, fillcolor="#e9edf2", penwidth=1.8];
  }

  /* ===================================================================== */
  /* EDGES — genetics / pathology                                          */
  /* ===================================================================== */
  LINGO1 -> PCARBOR;  LINGO1 -> TORPEDO;
  STK32B -> PCLOSS;   CTNNA3 -> CFPC;   FUSg -> PCLOSS;
  NOTCH2NL -> PCLOSS; HS1BP3 -> PFPC;   FAMHX -> LINGO1 [style=dotted];
  AGEr -> PCLOSS;     AGEr -> TORPEDO;
  HARMANE -> HARMSITE; LEADx -> PCLOSS;  HARMAL -> HARMSITE;

  PCLOSS -> PCINT [color="#c1121f"];  TORPEDO -> PCINT [color="#c1121f"];
  DENDSW -> PCINT;  PCARBOR -> PCINT;  HETPC -> PCINT;
  CFPC -> CFDRIVE [color="#2c5aa0"];  BASKET -> PCOUT;  GRID2 -> PFPC;
  PCINT -> PCOUT [color="#2c5aa0", label="출력 ↓"];
  PCINT -> DNDIS [color="#c1121f", label="탈억제 ↑"];
  GABAADN -> DNDIS [color="#c1121f"];
  DNDIS -> PHICBL [color="#c1121f", label="이득 ↑", penwidth=1.6];
  EXCFB -> PCINT [style=dashed, color="#c1121f", label="가설"];
  RENV -> EXCFB [style=dashed, color="#c1121f"];

  /* IO branch */
  CAV31 -> IOSUB [color="#2c5aa0"];  CAV32 -> IOSUB;  HCN1 -> IOSUB;
  SKCA -> IOSUB;  CX36 -> IOSYNC [color="#2c5aa0"];  IOSUB -> IOSYNC;
  HARMSITE -> CX36;  HARMSITE -> CAV31;
  IOSYNC -> CFDRIVE [color="#2c5aa0"];  GABAIO -> IOSYNC [label="−"];
  DENT -> GABAIO;   CFDRIVE -> PCOUT [color="#2c5aa0"];
  IOSYNC -> PHIC [color="#2c5aa0", label="a_O = 0.35", penwidth=1.6];

  /* cerebello-thalamic branch */
  PFPC -> PCOUT;  PCOUT -> DENT [color="#2c5aa0", label="−"];
  DENT -> DNBURST;  DNBURST -> CTTRACT;  CTTRACT -> VIM [color="#2c5aa0"];
  DNDIS -> DNBURST;  PHICBL -> PHIC [color="#2c5aa0", label="a_R = 0.65", penwidth=1.6];
  DENT -> PHICBL;

  /* series thalamic element */
  VIM -> VIMRHY;  VIMRHY -> M1 [color="#2c5aa0"];  PSA -> VIM;
  VIM -> PHITH [color="#c1121f"];  THALREROUTE -> PHITH [color="#c1121f"];
  PHITH -> PHIC [color="#c1121f", label="직렬 곱", penwidth=1.8];

  /* cortical limb */
  M1 -> CTXCOH;  SMA -> M1;  M1 -> CSTOUT [color="#2c5aa0"];
  M1 -> PONS;  PONS -> PFPC [color="#2c5aa0", label="루프 폐쇄"];
  CTXCOH -> ALPHAMN;  PHICTX -> PHIC [color="#2c5aa0", label="직렬 곱"];
  M1 -> PHICTX;  CSTOUT -> ALPHAMN [color="#2c5aa0"];

  /* peripheral loop */
  CATdrv -> B2SPIN [color="#2c5aa0"];  B2SPIN -> SPINDLE [color="#2c5aa0"];
  GAMMA -> SPINDLE;  SPINDLE -> ALPHAMN [color="#2c5aa0", label="Ia 흥분"];
  IARET -> SPINDLE [color="#e07b39"];  IB -> ALPHAMN [label="−"];
  ALPHAMN -> NMJ [color="#2c5aa0"];  NMJ -> JINERT [color="#2c5aa0", label="근력"];
  SPINDLE -> PHISPIN [color="#2c5aa0"];  PHISPIN -> PHIP [color="#2c5aa0", penwidth=1.6];
  NMJ -> PHIP [color="#2c5aa0", label="φ_nmj"];
  JINERT -> SPINDLE [color="#2c5aa0", label="신장 되먹임", style=bold];

  /* mechanics */
  KSTIFF -> FRES [color="#e07b39"];  JINERT -> FRES [color="#e07b39", label="∝1/√J"];
  BDAMP -> HMAG [color="#e07b39"];   FRES -> HMAG [color="#e07b39"];
  MASSLOAD -> JINERT [color="#e07b39"];  ARMLEN -> AOBS;
  HMAG -> AOBS [color="#e07b39", label="기계적 증폭", penwidth=1.6];
  HMAG -> NOISEFL [color="#e07b39"];
  NECKMECH -> HEADTR;  LARMECH -> VOICETR;
  FRES -> LOADTEST [color="#e07b39"];  FNEUR -> LOADTEST [color="#e07b39"];

  /* oscillator core */
  PHIC -> GTOT [color="#1b3a6b", label="w_C = 0.70", penwidth=1.8];
  PHIP -> GTOT [color="#1b3a6b", label="w_P = 0.30", penwidth=1.8];
  GTOT -> MU [color="#1b3a6b", penwidth=1.8];
  MU  -> HOPF [color="#1b3a6b", penwidth=1.8];
  HOPF -> RENV [color="#1b3a6b", penwidth=1.8];
  RENV -> SQRTLAW [color="#1b3a6b"];
  SQRTLAW -> RESP [color="#5a189a", label="반응자 분리"];
  RENV -> AOBS [color="#1b3a6b", penwidth=1.8];
  NOISEFL -> AOBS [color="#1b3a6b"];
  TAULOOP -> FNEUR [color="#e07b39", penwidth=1.6];
  IARET -> TAULOOP [color="#e07b39"];  CTTRACT -> TAULOOP [color="#e07b39"];
  IOSUB -> TAULOOP [color="#e07b39"];  PCINT -> TAULOOP [color="#e07b39", label="지연 ↑"];
  AGEr -> TAULOOP [color="#e07b39", label="−0.06 Hz/년"];
  FNEUR -> HMAG [color="#e07b39"];  FNEUR -> FOBS;  FRES -> FOBS;
  AOBS -> FOBS [style=dotted];  SQRTLAW -> SUBLIN;
  AOBS -> ACCEL [color="#5a189a", penwidth=1.6];

  /* propranolol */
  PROPDOSE -> PROPABS -> PROP1ST -> PROPC;
  PROPC -> PROPP [dir=both];  PROPC -> PROPPB;  PROPPB -> OCCB2;
  PROPC -> PROPBR [color="#2d6a4f"];
  PROPC -> KIB1 [style=dotted];  PROPC -> KIB2 [style=dotted];
  KIB2 -> OCCB2 [color="#2d6a4f", penwidth=1.6];  KIB1 -> OCCB1 [color="#2d6a4f"];
  OCCB2 -> PHISPIN [color="#2d6a4f", label="방추 이득 ↓", penwidth=1.8];
  PROPBR -> PHICBL [color="#2d6a4f", label="중추 성분(약)"];
  OCCB2 -> PROPCEIL;  PROPCEIL -> PHISPIN [style=dotted, label="포화"];
  OCCB1 -> HRT [color="#7b2cbf", penwidth=1.6];  OCCB1 -> BPS [color="#7b2cbf"];
  OCCB1 -> FATIGUE [color="#7b2cbf"];
  OCCB2 -> FEV1 [color="#7b2cbf", label="같은 점유율!", penwidth=1.8];
  OCCB2 -> HYPOGLY [color="#7b2cbf"];
  PROPBR -> SEDAT [color="#7b2cbf"];
  ATEN -> OCCB1 [color="#2d6a4f", label="β₁만"];
  ATEN -> PHISPIN [style=dotted, label="≈효과 없음"];
  PROPC -> B2REG [color="#2d6a4f"];  B2REG -> WDRAW [color="#7b2cbf"];
  PROPRA2 -> OCCB2 [style=dotted];
  CATdrv -> OCCB2 [label="경쟁적 작용제"];

  /* primidone */
  PRIMDOSE -> PRIMC;  PRIMC -> PBC [color="#2d6a4f", label="CYP2C9/2C19"];
  PRIMC -> PEMAC;  PRIMC -> PRIMBR;  PBC -> PBBR;
  PRIMBR -> GABAAP [color="#2d6a4f", penwidth=1.8, label="주 기여"];
  PBBR -> GABAAP [color="#2d6a4f", label="부 기여"];
  PEMAC -> GABAAP [style=dotted];
  PRIMBR -> PRIMFAST;  PRIMFAST -> GABAAP [style=dotted];
  PBBR -> PBWEAK [style=dotted];
  GABAAP -> PHICBL [color="#2d6a4f", label="이득 ↓", penwidth=1.8];
  PRIMBR -> NACH;  NACH -> PHICTX [color="#2d6a4f"];
  PBC -> IND [color="#2d6a4f"];  IND -> TOPC [color="#2d6a4f", label="CL ↑"];
  IND -> BMD [color="#7b2cbf", label="25-OH-D ↓"];
  PBBR -> SEDAT [color="#7b2cbf"];  PBBR -> ATAXIA [color="#7b2cbf"];
  SEDAT -> SEDTOL [dir=both, color="#7b2cbf"];

  /* other orals */
  TOPI -> TOPC;  TOPC -> PHICTX [color="#2d6a4f"];  TOPC -> GABAAP [style=dotted];
  TOPC -> COGWF [color="#7b2cbf"];  TOPC -> HCO3 [color="#7b2cbf"];
  TOPC -> WTLOSS [color="#7b2cbf"];
  GBP -> GBPC;  GBPC -> PHICTX [style=dotted];  GBPC -> SEDAT [color="#7b2cbf"];
  ZONI -> TTBIC50 [style=dotted];  BZD -> GABAAP [color="#2d6a4f"];
  BZD -> SEDAT [color="#7b2cbf"];  GAPAM -> GABAAP [color="#2d6a4f"];

  /* ethanol */
  ETOHDOSE -> ETOHGUT -> ETOHC;  ADH -> ETOHC [label="MM 제거"];
  ETOHC -> ETOHGABA [color="#2d6a4f"];  ETOHC -> ETOHIO [color="#2d6a4f"];
  ETOHGABA -> GABAAP [color="#2d6a4f", penwidth=1.6];
  ETOHIO -> IOSYNC [color="#2d6a4f", label="탈동기화", penwidth=1.6];
  ETOHC -> ADAPTF [color="#2d6a4f"];  ETOHC -> ADAPTS [color="#2d6a4f"];
  ADAPTF -> GABAAP [color="#c1121f", label="적응 (분모)", penwidth=1.6];
  ADAPTS -> GABAAP [color="#c1121f"];
  ADAPTF -> REBOUND [color="#c1121f", penwidth=1.6];
  REBOUND -> GTOT [color="#c1121f", label="기저선 초과"];
  ADAPTS -> AUDTRAP;  AUDTRAP -> ETOHDOSE [style=dashed, color="#c1121f", label="증량 되먹임"];
  ETOHC -> INTOX [color="#7b2cbf"];  ETOHC -> ATAXIA [color="#7b2cbf"];
  ETOHC -> LFT [color="#7b2cbf"];
  OCT -> ETOHGABA [color="#2d6a4f"];  OCT -> ETOHIO [color="#2d6a4f"];
  OCT -> INTOX [style=dotted, label="Kp 낮음 → 취기 ↓"];

  /* T-type */
  TTBDOSE -> TTBC -> TTBIC50;
  TTBIC50 -> CAV31 [color="#2d6a4f", label="차단", penwidth=1.6];
  TTBIC50 -> IOSYNC [color="#2d6a4f"];
  IOSYNC -> TTBCEIL [style=dotted];  TTBCEIL -> PHIC [color="#c1121f", penwidth=1.6];
  HARMRAT -> TTBCEIL [style=dashed];  TTBCEIL -> SPECDISC [penwidth=1.6];
  HARMAL -> HARMRAT;
  TTBIC50 -> DNBURST [style=dotted, label="DCN T형도"];

  /* botulinum */
  BTXDOSE -> BTXSV2 -> BTXLC;
  BTXLC -> SNAPT [color="#2d6a4f", penwidth=1.6];
  BTXLC -> SNAPG [color="#c1121f", label="f_spill", penwidth=1.6];
  FSPILL -> SNAPG [color="#c1121f", penwidth=1.8];
  SNAPREC -> SNAPT [dir=both];  SNAPREC -> SNAPG [dir=both];
  SNAPT -> NMJ [color="#2d6a4f", label="φ_nmj ↓", penwidth=1.6];
  SNAPG -> GRIPW [color="#7b2cbf", penwidth=1.6];
  FSPILL -> BTXWIN [penwidth=1.6];  SNAPT -> BTXWIN [style=dotted];
  GRIPW -> ADLSPOON [color="#5a189a"];

  /* surgery */
  MRGFUS -> LESVOL [color="#2d6a4f"];  RFTHAL -> LESVOL;
  LESVOL -> PHITH [color="#2d6a4f", label="→ 0.05", penwidth=1.8];
  LESVOL -> GAITAX [color="#7b2cbf", label="같은 부피!", penwidth=1.6];
  DBS -> DBSFREQ;  DBS -> DBSAMP;
  DBSFREQ -> PHITH [color="#2d6a4f", label="Hill h=4, f₅₀=80 Hz", penwidth=1.6];
  DBSAMP -> PHITH [color="#2d6a4f"];
  DBSFREQ -> DBSENTR [style=dotted];  DBSENTR -> GTOT [color="#c1121f", label="저주파 악화"];
  DBS -> HABIT;  HABIT -> THALREROUTE [color="#c1121f", penwidth=1.6];
  DBSAMP -> GAITAX [color="#7b2cbf"];  GAITAX -> QUEST [color="#5a189a"];

  /* state modulation */
  ANXIETY -> CATdrv [color="#2c5aa0"];  CAFFEINE -> CATdrv [color="#2c5aa0"];
  THYRO -> CATdrv;  B2AGON -> B2SPIN [color="#2c5aa0"];
  FATIG2 -> PHICTX;  COOLING -> BDAMP [label="ζ ↑"];
  POSTURAL -> GTOT [style=dotted];  KINETIC -> GTOT [style=dotted];
  INTENT -> VISDELAY;  VISDELAY -> TAULOOP [color="#e07b39"];
  VISDELAY -> GTOT [color="#2c5aa0", label="종말 이득 ↑"];

  /* differential diagnosis */
  CATdrv -> EPT [color="#495867"];  B2AGON -> EPT;  THYRO -> EPT;
  EPT -> NOISEFL [color="#495867", label="μ<0, 잡음 구동", penwidth=1.6];
  EPT -> LOADTEST [color="#495867", penwidth=1.6];
  PDREST -> FOBS [style=dotted];  DYSTR -> FOBS [style=dotted];
  ORTHOT -> FOBS [style=dotted];  HOLMES -> FOBS [style=dotted];
  LOADTEST -> FOBS [color="#495867"];

  /* endpoints */
  ACCEL -> LOGMAP [color="#5a189a", penwidth=1.8];
  LOGMAP -> TETRASPS [color="#5a189a", penwidth=1.8];
  LOGMAP -> FTM [color="#5a189a"];  LOGMAP -> SPIRAL [color="#5a189a"];
  LOGMAP -> BAINF [color="#5a189a"];
  LOGMAP -> ARTEFACT [penwidth=1.6];
  TETRASPS -> TETRASADL [style=dotted];
  TETRASPS -> RESP [color="#5a189a"];  ACCEL -> RESP [color="#5a189a"];
  TETRASADL -> QUEST [color="#5a189a"];  ADLSPOON -> TETRASADL;
  HEADTR -> TETRASPS;  VOICETR -> TETRASPS;
  AOBS -> ADLSPOON [color="#5a189a"];
  SEDAT -> QUEST [color="#5a189a"];  COGWF -> QUEST [color="#5a189a"];
  ATAXIA -> QUEST [color="#5a189a"];  INTOX -> QUEST [color="#5a189a"];
  HRT -> FATIGUE;  FEV1 -> QUEST [color="#5a189a"];
  HCO3 -> QUEST [style=dotted];  WTLOSS -> QUEST [style=dotted];
  BMD -> QUEST [style=dotted];  WDRAW -> GTOT [color="#c1121f"];

  /* head / voice effectors driven by the same core */
  RENV -> NECKMECH [color="#1b3a6b"];  RENV -> LARMECH [color="#1b3a6b"];

  /* ---- legend ---- */
  subgraph cluster_legend {
    label="범례 (Legend)"; style="rounded,filled"; fillcolor="#ffffff";
    color="#8a9bb0"; fontsize=10;
    L1 [label="이득 경로 (진폭 결정)", fillcolor="#d6e4ff", fontsize=9];
    L2 [label="지연 경로 (주파수 결정)", fillcolor="#ffe3c2", fontsize=9];
    L3 [label="위상/직렬 경로 (천장 결정)", fillcolor="#ffd9d9", fontsize=9];
    L4 [label="약물·기기", fillcolor="#d8f3dc", fontsize=9];
    L5 [label="PK 구획", fillcolor="#eaf7ee", fontsize=9];
    L6 [label="장기계 이상반응", fillcolor="#f1e2f7", fontsize=9];
    L7 [label="임상 평가지표", fillcolor="#e6dcff", fontsize=9];
    L8 [label="감별진단·상태조절", fillcolor="#e9edf2", fontsize=9];
    L1 -> L2 -> L3 -> L4 [style=invis];
    L5 -> L6 -> L7 -> L8 [style=invis];
  }
}
