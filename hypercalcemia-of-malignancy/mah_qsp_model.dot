digraph MAH_QSP_Model {
  graph [
    label=<<B>Hypercalcaemia of Malignancy — QSP Mechanistic Map</B><BR/><FONT POINT-SIZE="14">Plasma calcium is not a stock but the RESIDUAL of three fluxes on three clocks — bone (days), gut (a day), kidney (hours) — and no single drug moves more than one of them fast.<BR/>The renal escape valve has a CEILING that is itself a function of the calcium it is excreting: hypercalcaemia causes nephrogenic diabetes insipidus, nausea and vomiting, which contract the ECF, which drops GFR, which lowers the ceiling.<BR/>When bone resorption exceeds that ceiling no steady state exists — the crisis is a saddle-node, not a big number. Saline is fast because it raises the ceiling; bisphosphonate is slow because it is delivered by the very process it stops.</FONT>>
    labelloc=t fontsize=22 fontname="Helvetica"
    rankdir=LR bgcolor="#F7F8FA"
    splines=spline nodesep=0.28 ranksep=0.95
    newrank=true compound=true
  ]
  node [fontname="Helvetica" fontsize=10 style="filled,rounded" shape=box margin="0.14,0.05"]
  edge [fontname="Helvetica" fontsize=8 arrowsize=0.65 color="#5A6270"]

  //=========================================================
  // 1 : AETIOLOGY — four mechanisms that load DIFFERENT arms
  //=========================================================
  subgraph cluster_aeti {
    label="⚡ Aetiology — four mechanisms, and the arm each one loads is what decides the drug"
    style=filled fillcolor="#FFEBEE" color="#B71C1C" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    A_sqcc  [label="Squamous carcinoma\nlung · head & neck · oesophagus\ncervix · renal cell · bladder" fillcolor="#FFCDD2" color="#B71C1C"]
    A_brca  [label="Breast carcinoma\nboth humoral AND osteolytic\n(the overlap case)" fillcolor="#FFCDD2" color="#B71C1C"]
    A_mm    [label="Multiple myeloma\n≈30% hypercalcaemic at some point\nMIP-1α · IL-6 · DKK1 · sclerostin" fillcolor="#FFCDD2" color="#B71C1C"]
    A_lym   [label="Lymphoma (Hodgkin, NHL)\nHTLV-1 ATLL · granulomatous disease\nectopic 1α-hydroxylase" fillcolor="#FFCDD2" color="#B71C1C"]
    A_pca   [label="Parathyroid carcinoma\nrare ectopic/eutopic PTH\n(the only PTH-DEPENDENT cause)" fillcolor="#FFCDD2" color="#B71C1C"]
    A_hhm   [label="MECHANISM 1 — HUMORAL (PTHrP)\n≈80% of cases\nloads BONE arm AND shuts the RENAL valve" shape=diamond fillcolor="#E57373" color="#7F0000" fontcolor="white"]
    A_loh   [label="MECHANISM 2 — LOCAL OSTEOLYTIC\n≈20%\nloads BONE arm ONLY; renal valve stays open" shape=diamond fillcolor="#E57373" color="#7F0000" fontcolor="white"]
    A_ctd   [label="MECHANISM 3 — CALCITRIOL\n<1%\nloads GUT arm + bone; valve wide open" shape=diamond fillcolor="#E57373" color="#7F0000" fontcolor="white"]
    A_ept   [label="MECHANISM 4 — ECTOPIC PTH\n<1%\nPTH-dependent: the only cinacalcet case" shape=diamond fillcolor="#E57373" color="#7F0000" fontcolor="white"]
    A_prec  [label="PRECIPITANTS (never the whole story,\nalways the tipping point)\nimmobilisation · thiazide · lithium\nvitamin D/A · calcium supplements\ndehydration · TPN · tamoxifen flare" shape=note fillcolor="#FFF9C4" color="#F57F17"]
  }

  //=========================================================
  // 2 : TUMOUR AND ITS MEDIATORS
  //=========================================================
  subgraph cluster_tum {
    label="🧬 Tumour compartment — one mass, four possible secretomes"
    style=filled fillcolor="#FCE4EC" color="#880E4F" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    T_bur   [label="TUMOUR BURDEN  T (kg)\nlogistic growth; chemotherapy\nis the only therapy that removes\nthe INPUT rather than buffering it" shape=box3d fillcolor="#F8BBD0" color="#880E4F"]
    T_pthrp [label="PTHrP (1–36)\nplasma 2–30 pmol/L (normal <2)\nt½ ≈ 40 min\nPTHLH gene, chr 12p11" fillcolor="#F48FB1" color="#880E4F"]
    T_il6   [label="IL-6 · IL-8 · IL-11\nstromal RANKL induction" fillcolor="#F8BBD0" color="#880E4F"]
    T_mip   [label="MIP-1α (CCL3)\nmyeloma osteoclast chemoattractant" fillcolor="#F8BBD0" color="#880E4F"]
    T_tnf   [label="TNF-α · lymphotoxin\nRANKL-independent osteoclastogenesis\n(why suppression is never 100%)" fillcolor="#F8BBD0" color="#880E4F"]
    T_dkk   [label="DKK1 · sclerostin\nWnt blockade → osteoblast OFF\n(the myeloma uncoupling)" fillcolor="#F8BBD0" color="#880E4F"]
    T_rankl [label="Tumour-derived RANKL\ndirect, bypasses the osteoblast" fillcolor="#F8BBD0" color="#880E4F"]
    T_1a    [label="Ectopic CYP27B1\nmacrophage / lymphoma 1α-hydroxylase\nNOT suppressed by FGF23 or by Ca²⁺\n★ the glucocorticoid target" fillcolor="#F48FB1" color="#880E4F"]
    T_pth   [label="Autonomous PTH secretion\n(parathyroid carcinoma)\n★ the cinacalcet target" fillcolor="#F48FB1" color="#880E4F"]
  }

  //=========================================================
  // 3 : PTH AXIS AND THE CALCIUM-SENSING RECEPTOR
  //=========================================================
  subgraph cluster_pth {
    label="🎛 Parathyroid / CaSR — appropriately suppressed in 99% of malignant hypercalcaemia"
    style=filled fillcolor="#E1F5FE" color="#01579B" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    P_casr  [label="CaSR (GPRC6-family, chr 3q21)\nchief cell · sigmoid, n ≈ 4–6\nset point ≈ 1.20 mmol/L ionised" fillcolor="#B3E5FC" color="#01579B"]
    P_pool  [label="Stored PTH pool\nsecretory granules — the FAST release\n(minutes) before synthesis responds" fillcolor="#B3E5FC" color="#01579B"]
    P_pth   [label="Plasma PTH  1–7 pmol/L\nt½ ≈ 4 min\n★ SUPPRESSED (<1) is the diagnosis" shape=box3d fillcolor="#81D4FA" color="#01579B"]
    P_pth1r [label="PTH1R  (bone + kidney)\nPTH and PTHrP(1–34) are\nEQUIPOTENT here — the receptor\ncannot tell them apart" shape=diamond fillcolor="#4FC3F7" color="#01579B"]
    P_disc  [label="THE DIAGNOSTIC ASYMMETRY\nPTH1R signalling is HIGH while\nmeasured PTH is LOW.\nThe assay sees the ligand it was\nbuilt for, not the one that is acting." shape=note fillcolor="#FFF9C4" color="#F57F17"]
    P_diff  [label="…but they are NOT equipotent at\nrenal 1α-hydroxylase: PTHrP is a\nweak agonist there (≈15%).\n→ 1,25D LOW in PTHrP disease,\n   HIGH in true hyperparathyroidism" shape=note fillcolor="#FFF9C4" color="#F57F17"]
  }

  //=========================================================
  // 4 : BONE REMODELLING UNIT
  //=========================================================
  subgraph cluster_bone {
    label="🦴 Bone remodelling unit — the SLOW arm; a cell-population problem, not a chemistry problem"
    style=filled fillcolor="#EFEBE9" color="#3E2723" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    B_stro  [label="Stromal / osteoblast lineage\nthe RANKL source" fillcolor="#D7CCC8" color="#3E2723"]
    B_rankl [label="RANKL (TNFSF11)\nmembrane + soluble" fillcolor="#BCAAA4" color="#3E2723"]
    B_opg   [label="OPG (TNFRSF11B)\ndecoy receptor\n★ SUPPRESSED by PTH/PTHrP" fillcolor="#BCAAA4" color="#3E2723"]
    B_ratio [label="RANKL / OPG RATIO\nthe single number that sets\nosteoclastogenesis" shape=diamond fillcolor="#A1887F" color="#3E2723" fontcolor="white"]
    B_rank  [label="RANK on precursor\nTRAF6 → NF-κB → NFATc1" fillcolor="#D7CCC8" color="#3E2723"]
    B_ocp   [label="Osteoclast precursors\nCD14+ monocyte lineage\nM-CSF/CSF1R dependent" fillcolor="#D7CCC8" color="#3E2723"]
    B_oc    [label="MATURE OSTEOCLAST  (OC)\nmultinucleate · sealing zone\nlifespan ≈ 10–14 d" shape=box3d fillcolor="#8D6E63" color="#3E2723" fontcolor="white"]
    B_ruff  [label="Ruffled border\nV-ATPase H⁺ · ClC-7 Cl⁻\npH 4.5 in the resorption lacuna" fillcolor="#D7CCC8" color="#3E2723"]
    B_ctsk  [label="Cathepsin K · MMP-9 · TRAP\ncollagen I telopeptide release" fillcolor="#D7CCC8" color="#3E2723"]
    B_res   [label="J_res  BONE RESORPTION FLUX\nnormal ≈ 8 mmol Ca/day\nHHM ≈ 25–45 mmol/day\n★ ARM 1 of the balance" shape=diamond fillcolor="#6D4C41" color="#3E2723" fontcolor="white"]
    B_tgf   [label="TGF-β / IGF-1 released\nfrom resorbed matrix\n= the COUPLING signal" fillcolor="#D7CCC8" color="#3E2723"]
    B_obp   [label="Osteoblast precursors\nRunx2 · Osterix · Wnt/β-catenin" fillcolor="#D7CCC8" color="#3E2723"]
    B_ob    [label="MATURE OSTEOBLAST (OB)\ncollagen I · alkaline phosphatase" shape=box3d fillcolor="#A1887F" color="#3E2723" fontcolor="white"]
    B_form  [label="J_form  BONE FORMATION FLUX\nnormal ≈ 8 mmol Ca/day\nthe only physiological SINK" shape=diamond fillcolor="#6D4C41" color="#3E2723" fontcolor="white"]
    B_unc   [label="THE UNCOUPLING\nPTHrP (continuous, not pulsatile)\nsuppresses OPG and kills osteoblasts;\nDKK1/sclerostin block Wnt.\nSo resorption rises while the sink\nSHRINKS — the two errors add." shape=note fillcolor="#FFF9C4" color="#F57F17"]
    B_rap   [label="Rapidly exchangeable bone surface\n≈100 mmol, equilibrates in hours\nthe BUFFER that hides early imbalance" shape=box3d fillcolor="#D7CCC8" color="#3E2723"]
    B_skel  [label="Skeletal mineral pool\n≈25 000 mmol (1 kg Ca)\n1000× the ECF pool" shape=box3d fillcolor="#EFEBE9" color="#3E2723"]
  }

  //=========================================================
  // 5 : VITAMIN D
  //=========================================================
  subgraph cluster_vitd {
    label="☀ Vitamin D — the arm that separates lymphoma from everything else"
    style=filled fillcolor="#FFF8E1" color="#FF6F00" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    V_25d   [label="25(OH)D  50–125 nmol/L\nt½ ≈ 3 weeks — the SUBSTRATE" shape=box3d fillcolor="#FFECB3" color="#FF6F00"]
    V_ren1a [label="Renal CYP27B1 (1α-hydroxylase)\nproximal tubule\n+PTH · −FGF23 · −Ca²⁺ · −Pi" fillcolor="#FFE082" color="#FF6F00"]
    V_ext1a [label="EXTRARENAL CYP27B1\ntumour / granuloma macrophage\nNO negative feedback at all\n★ the whole point of mechanism 3" fillcolor="#FFCA28" color="#E65100"]
    V_125d  [label="1,25(OH)₂D  60–160 pmol/L\nt½ ≈ 5 h\nLOW in HHM · HIGH in lymphoma" shape=box3d fillcolor="#FFD54F" color="#FF6F00"]
    V_24    [label="CYP24A1 (24-hydroxylase)\nautoinduced by 1,25D\nthe brake that fails extrarenally" fillcolor="#FFE082" color="#FF6F00"]
    V_vdr   [label="VDR–RXR heterodimer\nVDRE on TRPV6 · calbindin · RANKL" fillcolor="#FFE082" color="#FF6F00"]
    V_fgf   [label="FGF23 (osteocyte)\n+Pi · +1,25D → −1α-hydroxylase\n+ phosphaturia" fillcolor="#FFE082" color="#FF6F00"]
  }

  //=========================================================
  // 6 : GUT ARM
  //=========================================================
  subgraph cluster_gut {
    label="🍽 Gut — the middle clock (≈1 day); it switches itself OFF in most patients, and ON in lymphoma"
    style=filled fillcolor="#F1F8E9" color="#33691E" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    G_diet  [label="Dietary calcium 20–30 mmol/day" fillcolor="#DCEDC8" color="#33691E"]
    G_trpv6 [label="TRPV6 (duodenum, transcellular)\nVDR-dependent, saturable" fillcolor="#DCEDC8" color="#33691E"]
    G_cbd   [label="Calbindin-D9k shuttle\nPMCA1b basolateral extrusion" fillcolor="#DCEDC8" color="#33691E"]
    G_para  [label="Paracellular absorption (jejunum/ileum)\nnon-saturable, ≈ concentration-driven" fillcolor="#DCEDC8" color="#33691E"]
    G_sec   [label="Endogenous intestinal secretion\n≈4–5 mmol/day, obligatory" fillcolor="#DCEDC8" color="#33691E"]
    G_abs   [label="J_gut  NET ABSORPTION\nnormal ≈ +5 mmol/day\nlymphoma ≈ +15 mmol/day\n★ ARM 2 of the balance" shape=diamond fillcolor="#AED581" color="#33691E"]
    G_ano   [label="ANOREXIA closes this arm\nby itself in most patients —\nwhich is why 'stop the calcium\nsupplement' is nearly always\ntrue but nearly never enough" shape=note fillcolor="#FFF9C4" color="#F57F17"]
  }

  //=========================================================
  // 7 : THE THREE-ARM BALANCE — the central claim
  //=========================================================
  subgraph cluster_bal {
    label="⚖ THE BALANCE — plasma calcium is a RESIDUAL, and the three arms run on three different clocks"
    style=filled fillcolor="#E8EAF6" color="#1A237E" penwidth=3 fontsize=14 fontname="Helvetica-Bold"

    X_bal   [label="dCa_ECF/dt = J_res − J_form + J_gut − U_Ca\nECF pool ≈ 36 mmol · turnover < 1 day\nEVERY therapy is an intervention on ONE of these four terms" shape=diamond fillcolor="#9FA8DA" color="#1A237E" penwidth=2]
    X_c1    [label="CLOCK 1 — KIDNEY  (hours)\ncapacity ≈ 20–26 mmol/day\nthe only arm that can move today" shape=hexagon fillcolor="#7986CB" color="#1A237E" fontcolor="white"]
    X_c2    [label="CLOCK 2 — GUT  (≈1 day)\ncapacity ≈ ±10 mmol/day" shape=hexagon fillcolor="#7986CB" color="#1A237E" fontcolor="white"]
    X_c3    [label="CLOCK 3 — BONE  (2–5 days)\ncapacity ≈ ±40 mmol/day\nthe biggest arm and the slowest" shape=hexagon fillcolor="#7986CB" color="#1A237E" fontcolor="white"]
    X_why   [label="WHY NO DRUG IS BOTH FAST AND DEFINITIVE\nSaline works in hours because it acts on clock 1,\nand for the same reason it cannot cure anything.\nBisphosphonate is definitive because it acts on clock 3,\nand for the same reason it cannot rescue today.\nThe guideline combination is not additive chemistry —\nit is a RELAY between two clocks." shape=note fillcolor="#FFF9C4" color="#F57F17"]
    X_ecf   [label="ECF CALCIUM POOL\n≈36 mmol in 15 L\nthe smallest pool in the system" shape=box3d fillcolor="#C5CAE9" color="#1A237E"]
  }

  //=========================================================
  // 8 : RENAL CALCIUM HANDLING — segment by segment
  //=========================================================
  subgraph cluster_kid {
    label="🫘 Renal calcium handling — the escape valve, segment by segment"
    style=filled fillcolor="#E0F7FA" color="#006064" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    K_gfr   [label="GFR  ≈180 L/day\nsteeply dependent on ECF volume" shape=diamond fillcolor="#80DEEA" color="#006064"]
    K_uf    [label="Ultrafilterable calcium\n= ionised + complexed ≈ 60% of total\nprotein-bound fraction is NOT filtered" fillcolor="#B2EBF2" color="#006064"]
    K_fl    [label="FILTERED LOAD ≈ 260 mmol/day\n(seven times the entire ECF pool,\nevery single day)" shape=box3d fillcolor="#4DD0E1" color="#006064"]
    K_pct   [label="PROXIMAL TUBULE  ≈65%\npassive, paracellular, solvent drag\nCOUPLED TO SODIUM AND WATER\n→ volume depletion raises it" fillcolor="#B2EBF2" color="#006064"]
    K_tal   [label="THICK ASCENDING LIMB  ≈25%\nparacellular via claudin-16/19\ndriven by the NKCC2 lumen-positive PD" fillcolor="#B2EBF2" color="#006064"]
    K_casr2 [label="Basolateral CaSR in the TAL\nhigh Ca²⁺ → ↓NKCC2, ↓ROMK\n→ physiological calciuresis\n(the body's own loop diuretic)" fillcolor="#80DEEA" color="#006064"]
    K_dct   [label="DISTAL CONVOLUTED TUBULE ≈8%\nTRPV5 · calbindin-D28k · NCX1 · PMCA1b\nTRANSPORT-LIMITED (a Tm, not a fraction)\n★ PTH/PTHrP raise this Tm" fillcolor="#B2EBF2" color="#006064"]
    K_exc   [label="U_Ca  URINARY EXCRETION\nnormal ≈5 mmol/day (FE ≈2%)\n★ ARM 3 — the only fast arm" shape=diamond fillcolor="#26C6DA" color="#006064" fontcolor="white"]
    K_hhmp  [label="THE HHM PARADOX\nPTHrP raises the distal Tm at the same\ntime as it raises bone resorption.\nOne ligand closes the valve and opens\nthe tap. That is why HHM reaches a\nhigher calcium than myeloma does\nat the SAME resorption rate." shape=note fillcolor="#FFF9C4" color="#F57F17"]
  }

  //=========================================================
  // 9 : THE CEILING AND THE SADDLE-NODE
  //=========================================================
  subgraph cluster_ceil {
    label="🚧 THE CEILING — a maximum excretion rate that hypercalcaemia itself pushes DOWN"
    style=filled fillcolor="#EDE7F6" color="#4527A0" penwidth=3 fontsize=14 fontname="Helvetica-Bold"

    C_curve [label="U_Ca(Ca) is NON-MONOTONIC\nrising limb: more filtered load, CaSR calciuresis\nfalling limb: volume loss → GFR ↓ → load ↓\nso there is a MAXIMUM" shape=diamond fillcolor="#B39DDB" color="#311B92"]
    C_ceil  [label="CEILING  U_max\n≈24 mmol/day euvolaemic\n≈9 mmol/day at 15% ECF deficit" shape=hexagon fillcolor="#9575CD" color="#311B92" fontcolor="white"]
    C_in    [label="NET INPUT  J_res − J_form + J_gut\nmild disease ≈ 12 mmol/day\ncrisis ≈ 35 mmol/day" shape=hexagon fillcolor="#9575CD" color="#311B92" fontcolor="white"]
    C_sn    [label="SADDLE-NODE\ninput < ceiling → a stable steady state exists\ninput > ceiling → NO steady state:\ncalcium rises until the model leaves\nphysiology. The crisis is a BIFURCATION,\nnot a large number." shape=doubleoctagon fillcolor="#7E57C2" color="#311B92" fontcolor="white" penwidth=2]
    C_sal   [label="WHAT SALINE ACTUALLY DOES\nIt removes almost no calcium itself.\nIt RAISES THE CEILING back above the\ninput, by restoring GFR and switching\noff proximal avidity. That is why it\nworks in hours and why it stops working\nthe moment the infusion stops." shape=note fillcolor="#FFF9C4" color="#F57F17"]
  }

  //=========================================================
  // 10 : THE VICIOUS CYCLE
  //=========================================================
  subgraph cluster_loop {
    label="🔁 THE CLOSED LOOP — hypercalcaemia disables the only organ that can fix it"
    style=filled fillcolor="#FBE9E7" color="#BF360C" penwidth=3 fontsize=14 fontname="Helvetica-Bold"

    L_casr3 [label="CaSR on the collecting duct\nprincipal cell (apical)" fillcolor="#FFCCBC" color="#BF360C"]
    L_aqp2  [label="AQP2 down-regulation\ntranscript AND trafficking\nτ ≈ 2 days DOWN and UP" fillcolor="#FFAB91" color="#BF360C"]
    L_ndi   [label="NEPHROGENIC DIABETES INSIPIDUS\nU_osm ceiling falls to 300–400 mosm/kg\n→ obligate 3–5 L/day water loss" shape=box3d fillcolor="#FF8A65" color="#BF360C" fontcolor="white"]
    L_nau   [label="Nausea · vomiting · anorexia\n(CNS + gastric smooth muscle)" fillcolor="#FFCCBC" color="#BF360C"]
    L_ecv   [label="ECF VOLUME CONTRACTION\n10–20% deficit at presentation\nis the rule, not the exception" shape=box3d fillcolor="#FF7043" color="#BF360C" fontcolor="white"]
    L_prox  [label="Proximal Na⁺ avidity ↑\n(RAAS, ANG II, peritubular oncotic)\n→ calcium follows sodium" fillcolor="#FFCCBC" color="#BF360C"]
    L_gfr2  [label="GFR falls\nprerenal, then structural" fillcolor="#FFAB91" color="#BF360C"]
    L_less  [label="FILTERED LOAD FALLS\n→ LESS calcium excreted\n→ CALCIUM RISES FURTHER" shape=diamond fillcolor="#E64A19" color="#7F0000" fontcolor="white"]
    L_mem   [label="THE MEMORY IN THE LOOP\nAQP2 recovers with a ~2-day time constant.\nCorrect the calcium this afternoon and the\nkidney still cannot concentrate tomorrow —\nwhich is why the fluid must continue after\nthe number looks better, and why relapse\nafter a single dose is a volume event\nbefore it is a bone event." shape=note fillcolor="#FFF9C4" color="#F57F17"]
    L_alk   [label="Vomiting → H⁺ and Cl⁻ loss\n→ metabolic alkalosis\n→ MORE albumin binding\n→ IONISED calcium FALLS\nA protective arm inside the vicious cycle." shape=note fillcolor="#DCEDC8" color="#33691E"]
  }

  //=========================================================
  // 11 : SPECIATION — three calciums, one number reported
  //=========================================================
  subgraph cluster_spec {
    label="🔬 Speciation — the number measured is not the number acting"
    style=filled fillcolor="#E8F5E9" color="#1B5E20" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    S_tot   [label="TOTAL CALCIUM  2.15–2.55 mmol/L\nwhat the laboratory reports" shape=box3d fillcolor="#A5D6A7" color="#1B5E20"]
    S_ion   [label="IONISED Ca²⁺  1.15–1.30 mmol/L\n≈50% — the ONLY biologically active\nspecies; what the CaSR reads" shape=box3d fillcolor="#66BB6A" color="#1B5E20" fontcolor="white"]
    S_alb   [label="ALBUMIN-BOUND ≈40%\nn·[Alb]·Ca/(Kd+Ca)\nalbumin is LOW in cancer" fillcolor="#C8E6C9" color="#1B5E20"]
    S_cx    [label="COMPLEXED ≈10%\ncitrate · bicarbonate · phosphate\n(filtered, like the ionised fraction)" fillcolor="#C8E6C9" color="#1B5E20"]
    S_ph    [label="pH modulates the binding constant\nΔ ionised ≈ −0.05 mmol/L per +0.1 pH" fillcolor="#C8E6C9" color="#1B5E20"]
    S_payne [label="PAYNE CORRECTION\nCa + 0.02×(40 − albumin g/L)\nDerived in a 1973 hospital population,\napplied to every cancer patient since." fillcolor="#C8E6C9" color="#1B5E20"]
    S_fail  [label="WHERE THE CORRECTION FAILS\nAt albumin 22 g/L the model's ionised\ncalcium corresponds to a total of 2.88\nat normal albumin — Payne returns 2.70.\nIt UNDER-corrects by ~0.2 mmol/L, and it\ndoes so in exactly the population where\nthe albumin is low: the sick ones." shape=note fillcolor="#FFF9C4" color="#F57F17"]
  }

  //=========================================================
  // 12 : PHOSPHATE, MAGNESIUM, NEPHROCALCINOSIS
  //=========================================================
  subgraph cluster_min {
    label="🧪 Phosphate · magnesium · precipitation — why the aetiology can be read off the phosphate"
    style=filled fillcolor="#F3E5F5" color="#4A148C" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    M_pi    [label="Serum phosphate\nLOW in PTHrP disease (phosphaturia)\nHIGH in myeloma with renal failure\n→ the cheapest mechanism test there is" shape=box3d fillcolor="#E1BEE7" color="#4A148C"]
    M_npt   [label="NaPi-IIa / NaPi-IIc (SLC34A1/A3)\nretrieved from the brush border\nby PTH1R and by FGF23" fillcolor="#E1BEE7" color="#4A148C"]
    M_cap   [label="Ca × Pi PRODUCT\nthreshold ≈3.6 (mmol/L)²" shape=diamond fillcolor="#CE93D8" color="#4A148C"]
    M_neph  [label="Nephrocalcinosis / tubular deposition\nslow to form, slower to dissolve\n→ PERMANENT loss of nephron mass" fillcolor="#CE93D8" color="#4A148C"]
    M_mg    [label="Magnesium\nCaSR-driven renal wasting;\nhypomagnesaemia after denosumab\nand after bisphosphonate" fillcolor="#E1BEE7" color="#4A148C"]
    M_hypop [label="Hungry-bone hypocalcaemia\nafter antiresorptive in a patient with\nvitamin D deficiency or renal failure —\nthe one iatrogenic harm this model\npredicts from its own structure" shape=note fillcolor="#FFF9C4" color="#F57F17"]
  }

  //=========================================================
  // 13 : SALINE
  //=========================================================
  subgraph cluster_sal {
    label="💧 THERAPY 1 — isotonic saline: raises the ceiling, removes almost no calcium"
    style=filled fillcolor="#E3F2FD" color="#0D47A1" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    D_sal   [label="0.9% NaCl 200–300 mL/h\n(4.8–7.2 L/day)" fillcolor="#BBDEFB" color="#0D47A1"]
    D_vol   [label="ECF re-expansion\n→ GFR recovers" fillcolor="#BBDEFB" color="#0D47A1"]
    D_prox2 [label="Proximal Na⁺ avidity switched OFF\n→ paracellular Ca²⁺ reabsorption falls\n(the actual calciuretic mechanism)" fillcolor="#90CAF9" color="#0D47A1"]
    D_dil   [label="Dilution of the ECF pool\na real but SMALL and TRANSIENT effect" fillcolor="#BBDEFB" color="#0D47A1"]
    D_ovl   [label="Volume overload / pulmonary oedema\nthe rate-limiting toxicity in\nelderly, cardiac and renal patients" fillcolor="#FFCDD2" color="#B71C1C"]
  }

  //=========================================================
  // 14 : CALCITONIN
  //=========================================================
  subgraph cluster_ct {
    label="⏱ THERAPY 2 — calcitonin: the only drug that moves TWO arms at once, and it lasts 48 hours"
    style=filled fillcolor="#FFF3E0" color="#E65100" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    D_ctn   [label="Salmon calcitonin 4–8 IU/kg\nSC/IM q6–12 h · t½ ≈ 1 h" fillcolor="#FFE0B2" color="#E65100"]
    D_ctr   [label="CTR (class B GPCR) on the osteoclast\nGs → cAMP → retraction of the\nruffled border within MINUTES" fillcolor="#FFE0B2" color="#E65100"]
    D_ctk   [label="CTR on the distal tubule\n→ direct calciuresis\n(the second arm)" fillcolor="#FFE0B2" color="#E65100"]
    D_tach  [label="RECEPTOR DOWN-REGULATION\ninternalisation faster than resynthesis\n→ effect gone by 48 h\nrecovery t½ ≈ 6 days" shape=diamond fillcolor="#FFB74D" color="#BF360C"]
    D_bridge[label="CALCITONIN IS A BRIDGE, NOT A TREATMENT\nIts tachyphylaxis half-life and the\nbisphosphonate's onset half-life are\nalmost exactly complementary. The\nguideline pairing is a relay hand-off\nbetween two clocks, and the model\nreproduces the hand-off window." shape=note fillcolor="#FFF9C4" color="#F57F17"]
  }

  //=========================================================
  // 15 : BISPHOSPHONATE — the self-delivering drug
  //=========================================================
  subgraph cluster_bp {
    label="🎯 THERAPY 3 — zoledronate: a drug delivered to its target BY the process it abolishes"
    style=filled fillcolor="#E0F2F1" color="#004D40" penwidth=3 fontsize=13 fontname="Helvetica-Bold"

    D_za    [label="Zoledronic acid 4 mg IV / 15 min\n(pamidronate 60–90 mg over 2–4 h)" fillcolor="#B2DFDB" color="#004D40"]
    D_zapk  [label="Plasma: t½ minutes–hours\nCLEARED RENALLY — hence the\ndose reduction and the 15-min floor" fillcolor="#B2DFDB" color="#004D40"]
    D_hap   [label="Hydroxyapatite binding\nN-BP affinity: ZOL > RIS > IBN > ALN > PAM\n40–60% of the dose retained in bone" fillcolor="#80CBC4" color="#004D40"]
    D_bury  [label="Buried in matrix (pharmacologically silent)\nreleased only on later resorption —\nthe source of the multi-year terminal t½" fillcolor="#B2DFDB" color="#004D40"]
    D_up    [label="UPTAKE BY THE RESORBING OSTEOCLAST\nrate ∝ (surface drug) × (resorption rate)\n★ THE SELF-LIMITING STEP" shape=diamond fillcolor="#4DB6AC" color="#004D40"]
    D_fpps  [label="Farnesyl pyrophosphate synthase blocked\n→ no GGPP → Rab/Rho/Rac unprenylated\n→ ruffled border cannot assemble\n→ osteoclast apoptosis" fillcolor="#B2DFDB" color="#004D40"]
    D_self  [label="THE SELF-LIMITING PARADOX\nDelivery is proportional to resorption,\nso the drug loads FASTEST in the sickest\nbone and then shuts off its own delivery.\nThis single term produces three observed\nfacts at once: the 2–4 day onset, the\n4-week duration from one dose, and the\nflat 4 mg → 8 mg dose–response." shape=note fillcolor="#FFF9C4" color="#F57F17"]
    D_aki   [label="Nephrotoxicity (tubular)\nrate- and exposure-dependent\n+ osteonecrosis of the jaw\n+ acute-phase reaction (≈25%)" fillcolor="#FFCDD2" color="#B71C1C"]
  }

  //=========================================================
  // 16 : DENOSUMAB AND THE REST
  //=========================================================
  subgraph cluster_other {
    label="💊 THERAPIES 4–8 — denosumab · glucocorticoid · cinacalcet · dialysis · (and the loop diuretic that is not a therapy)"
    style=filled fillcolor="#F9FBE7" color="#827717" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    D_dmb   [label="Denosumab 120 mg SC\nfully human IgG2 anti-RANKL\nK_D ≈ 3 pmol/L" fillcolor="#F0F4C3" color="#827717"]
    D_tmdd  [label="Target-mediated disposition\nnon-renal clearance → NO dose adjustment\nin renal failure (its decisive advantage)" fillcolor="#E6EE9C" color="#827717"]
    D_dmbon [label="Blocks RANKL BEFORE the osteoclast exists\n→ does not need resorption to be delivered\n→ works where a bisphosphonate has failed" shape=diamond fillcolor="#DCE775" color="#827717"]
    D_hypo  [label="Hypocalcaemia risk higher than with N-BP\n(no rate-limiting delivery step to stop it)" fillcolor="#FFCDD2" color="#B71C1C"]
    D_gc    [label="Prednisolone 40–60 mg/day\nblocks extrarenal CYP27B1,\ncuts intestinal absorption,\nlymphotoxic in lymphoma\n★ mechanism 3 only" fillcolor="#F0F4C3" color="#827717"]
    D_cin   [label="Cinacalcet (CaSR positive allosteric)\nleft-shifts the parathyroid set point\n★ mechanism 4 only — useless when\nPTH is already suppressed" fillcolor="#F0F4C3" color="#827717"]
    D_dial  [label="Haemodialysis, low-calcium dialysate\n(1.0–1.25 mmol/L)\nthe only intervention that removes\ncalcium FASTER than the bone adds it" fillcolor="#F0F4C3" color="#827717"]
    D_fur   [label="LOOP DIURETIC\nBlocks NKCC2 → blocks the TAL\nparacellular driving force → calciuresis.\nTrue, and almost always the wrong move:\nit worsens the volume deficit that is\nholding the ceiling down." fillcolor="#FFCDD2" color="#B71C1C"]
    D_furok [label="…legitimate ONLY after repletion,\nand then for fluid overload,\nnot for the calcium." shape=note fillcolor="#FFF9C4" color="#F57F17"]
    D_chemo [label="ANTITUMOUR THERAPY\nthe only intervention that removes\nthe INPUT instead of buffering it —\nand the only one whose benefit\nkeeps growing after week 2" fillcolor="#C5E1A5" color="#33691E"]
  }

  //=========================================================
  // 17 : CLINICAL ENDPOINTS
  //=========================================================
  subgraph cluster_clin {
    label="🩺 Clinical endpoints — and why the same calcium means different things in different patients"
    style=filled fillcolor="#ECEFF1" color="#263238" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    E_cns   [label="CNS: lethargy → confusion →\nstupor → coma\n(the dominant symptom domain)" fillcolor="#CFD8DC" color="#263238"]
    E_gi    [label="GI: anorexia · nausea · vomiting\nconstipation · ileus · pancreatitis" fillcolor="#CFD8DC" color="#263238"]
    E_ren   [label="Renal: polyuria · polydipsia\nAKI · nephrocalcinosis · stones" fillcolor="#CFD8DC" color="#263238"]
    E_ecg   [label="Cardiac: short QT · wide T\nbradyarrhythmia · digoxin sensitivity\nJ (Osborn) wave at extremes" fillcolor="#CFD8DC" color="#263238"]
    E_mus   [label="Neuromuscular: weakness\nhyporeflexia · bone pain" fillcolor="#CFD8DC" color="#263238"]
    E_rate  [label="RATE-DEPENDENCE\nA calcium of 3.2 reached in three days\nis a medical emergency; the same 3.2\nreached over three months is an\noutpatient problem. The CNS adapts\nits set point — PARTIALLY, ~45%." shape=diamond fillcolor="#B0BEC5" color="#263238"]
    E_prog  [label="PROGNOSIS\nHypercalcaemia of malignancy marks the\ndisease, not just the calcium: median\nsurvival ≈30 days historically, still\n<12 months in modern series.\nTreating the number is palliation;\ntreating the tumour is treatment." shape=note fillcolor="#FFF9C4" color="#F57F17"]
    E_relap [label="RELAPSE\nafter one zoledronate dose: median\n≈4 weeks — set jointly by the drug's\nbone residence AND by tumour growth,\nnot by the drug alone" fillcolor="#CFD8DC" color="#263238"]
  }

  //=========================================================
  // 18 : BIOMARKERS AND THE THREE READOUTS
  //=========================================================
  subgraph cluster_bio {
    label="📈 Biomarkers — three readouts on three clocks, and the panel that names the mechanism"
    style=filled fillcolor="#FFFDE7" color="#F57F17" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    Y_ctx   [label="CTX-I / NTX  (resorption)\nresponds in 24–48 h\nthe EARLIEST antiresorptive signal" shape=box3d fillcolor="#FFF59D" color="#F57F17"]
    Y_p1np  [label="P1NP / bone ALP (formation)\nlags days–weeks; falls too, via coupling\n(the 'frozen bone' of over-suppression)" shape=box3d fillcolor="#FFF59D" color="#F57F17"]
    Y_ica   [label="Ionised calcium\nthe variable the patient experiences" shape=box3d fillcolor="#FFF176" color="#F57F17"]
    Y_pth   [label="PTH — the single most informative test\nsuppressed → malignancy\nnot suppressed → parathyroid disease\n(they coexist more often than expected)" shape=box3d fillcolor="#FFF176" color="#F57F17"]
    Y_panel [label="THE MECHANISM PANEL\nPTH ↓ + PTHrP ↑ + Pi ↓ + 1,25D ↓ → HUMORAL\nPTH ↓ + PTHrP – + lytic lesions → OSTEOLYTIC\nPTH ↓ + 1,25D ↑↑            → CALCITRIOL\nPTH ↑                        → PARATHYROID" shape=note fillcolor="#FFF9C4" color="#F57F17"]
    Y_fe    [label="Fractional excretion of calcium\nthe one number that separates HHM from\nosteolytic disease at the same total Ca —\nand nobody orders it" fillcolor="#FFF59D" color="#F57F17"]
  }

  //=========================================================
  //  EDGES
  //=========================================================

  // --- aetiology into mechanisms
  A_sqcc -> A_hhm; A_brca -> A_hhm; A_brca -> A_loh; A_mm -> A_loh
  A_lym -> A_ctd; A_pca -> A_ept
  A_hhm -> T_bur; A_loh -> T_bur; A_ctd -> T_bur; A_ept -> T_bur
  A_prec -> L_ecv [style=dashed]
  A_prec -> B_res [style=dashed label="immobilisation"]
  A_prec -> K_dct [style=dashed label="thiazide ↑Tm"]

  // --- tumour secretome
  T_bur -> T_pthrp [label="mechanism 1"]
  T_bur -> T_il6; T_bur -> T_mip; T_bur -> T_tnf; T_bur -> T_dkk; T_bur -> T_rankl
  T_bur -> T_1a  [label="mechanism 3"]
  T_bur -> T_pth [label="mechanism 4"]

  // --- PTH axis
  S_ion -> P_casr [label="the sensed variable"]
  P_casr -> P_pool [label="− (suppression)"]
  P_pool -> P_pth
  T_pth -> P_pth [label="autonomous"]
  P_pth -> P_pth1r
  T_pthrp -> P_pth1r [label="equipotent"]
  P_pth1r -> P_disc [style=dotted]
  P_pth1r -> P_diff [style=dotted]

  // --- PTH1R onto bone and kidney
  P_pth1r -> B_stro [label="+ RANKL"]
  P_pth1r -> B_opg  [label="− OPG"]
  P_pth1r -> B_ocp  [label="+ recruitment"]
  P_pth1r -> B_ob   [label="− (continuous exposure)"]
  P_pth1r -> K_dct  [label="+ Tm (TRPV5)"]
  P_pth1r -> M_npt  [label="− NaPi-II"]
  P_pth1r -> V_ren1a [label="+ (PTH ≫ PTHrP)"]

  // --- bone remodelling
  B_stro -> B_rankl; B_stro -> B_opg
  T_il6 -> B_stro; T_mip -> B_ocp; T_rankl -> B_ratio; T_tnf -> B_oc [label="RANKL-independent"]
  T_dkk -> B_obp [label="− Wnt"]
  B_rankl -> B_ratio; B_opg -> B_ratio [label="decoy"]
  B_ratio -> B_rank; B_rank -> B_ocp; B_ocp -> B_oc
  B_oc -> B_ruff -> B_ctsk -> B_res
  B_oc -> B_res
  B_res -> B_tgf -> B_obp -> B_ob -> B_form
  B_res -> B_skel [dir=back label="mineral out"]
  B_form -> B_skel
  B_unc -> B_form [style=dotted]
  B_res -> B_unc [style=dotted]
  B_res -> Y_ctx; B_form -> Y_p1np

  // --- vitamin D
  V_25d -> V_ren1a; V_25d -> V_ext1a
  T_1a -> V_ext1a
  V_ren1a -> V_125d; V_ext1a -> V_125d
  V_125d -> V_24 -> V_125d [label="− autoinduced"]
  V_125d -> V_vdr
  V_vdr -> G_trpv6; V_vdr -> G_cbd; V_vdr -> B_rankl [label="+ VDRE"]
  V_125d -> V_fgf; M_pi -> V_fgf
  V_fgf -> V_ren1a [label="−"]; V_fgf -> M_npt [label="−"]
  S_ion -> V_ren1a [label="− (CaSR, proximal)"]
  S_ion -> V_ext1a [label="NO feedback" color="#B71C1C" style=bold]

  // --- gut
  G_diet -> G_trpv6; G_diet -> G_para
  G_trpv6 -> G_cbd -> G_abs; G_para -> G_abs; G_sec -> G_abs [label="−"]
  G_ano -> G_abs [style=dotted]
  L_nau -> G_ano [style=dashed]

  // --- the balance
  B_res -> X_bal [color="#1A237E" penwidth=2]
  B_form -> X_bal [color="#1A237E" penwidth=2 label="−"]
  G_abs -> X_bal [color="#1A237E" penwidth=2]
  K_exc -> X_bal [color="#1A237E" penwidth=2 label="−"]
  X_bal -> X_ecf -> S_tot
  X_bal -> X_c1; X_bal -> X_c2; X_bal -> X_c3
  K_exc -> X_c1 [style=dotted]; G_abs -> X_c2 [style=dotted]; B_res -> X_c3 [style=dotted]
  X_c1 -> X_why [style=dotted]; X_c3 -> X_why [style=dotted]
  X_ecf -> B_rap [dir=both label="rapid buffer"]

  // --- speciation
  S_tot -> S_ion; S_tot -> S_alb; S_tot -> S_cx
  S_alb -> S_ion [label="−"]; S_ph -> S_alb; S_ph -> S_ion [label="−0.05 / +0.1 pH"]
  S_tot -> S_payne -> S_fail [style=dotted]
  S_ion -> S_fail [style=dotted]
  S_ion -> K_uf; S_cx -> K_uf

  // --- renal handling
  K_gfr -> K_fl; K_uf -> K_fl
  K_fl -> K_pct -> K_tal -> K_dct -> K_exc
  S_ion -> K_casr2 -> K_tal [label="− reabsorption"]
  K_dct -> K_hhmp [style=dotted]; P_pth1r -> K_hhmp [style=dotted]
  K_exc -> Y_fe

  // --- the ceiling
  K_exc -> C_curve; K_gfr -> C_curve
  C_curve -> C_ceil
  X_bal -> C_in
  C_ceil -> C_sn; C_in -> C_sn
  C_sn -> L_less [color="#B71C1C" penwidth=2]
  C_sal -> C_ceil [style=dotted]

  // --- the vicious cycle
  S_ion -> L_casr3 -> L_aqp2 -> L_ndi -> L_ecv
  S_ion -> L_nau -> L_ecv
  L_ecv -> L_prox -> K_pct [label="+ avidity" color="#BF360C"]
  L_ecv -> L_gfr2 -> K_gfr [color="#BF360C"]
  L_gfr2 -> L_less
  L_less -> X_ecf [color="#B71C1C" penwidth=2 label="POSITIVE FEEDBACK"]
  L_aqp2 -> L_mem [style=dotted]
  L_nau -> L_alk [style=dotted]
  L_alk -> S_ph [style=dotted]

  // --- minerals
  M_npt -> M_pi [label="− reabsorption"]
  M_pi -> M_cap; S_ion -> M_cap
  M_cap -> M_neph -> K_gfr [label="− nephron mass" color="#B71C1C"]
  K_casr2 -> M_mg [label="renal Mg wasting"]
  M_pi -> Y_panel [style=dotted]

  // --- saline
  D_sal -> D_vol -> K_gfr [color="#0D47A1" penwidth=2]
  D_sal -> D_prox2 -> K_pct [label="− avidity" color="#0D47A1" penwidth=2]
  D_sal -> D_dil -> X_ecf
  D_vol -> C_ceil [label="RAISES THE CEILING" color="#0D47A1" penwidth=2]
  D_sal -> D_ovl [style=dashed]
  D_sal -> C_sal [style=dotted]

  // --- calcitonin
  D_ctn -> D_ctr -> B_ruff [label="− within minutes" color="#E65100" penwidth=2]
  D_ctn -> D_ctk -> K_dct [label="− Tm" color="#E65100"]
  D_ctn -> D_tach; D_tach -> D_ctr [label="− receptor" color="#BF360C"]
  D_tach -> D_bridge [style=dotted]; D_za -> D_bridge [style=dotted]

  // --- bisphosphonate
  D_za -> D_zapk -> D_hap -> D_up
  D_hap -> D_bury
  B_res -> D_up [label="DELIVERY ∝ RESORPTION" color="#004D40" penwidth=2 style=bold]
  D_up -> D_fpps -> B_oc [label="apoptosis" color="#004D40" penwidth=2]
  D_fpps -> B_res [label="− activity" color="#004D40" penwidth=2]
  D_up -> D_self [style=dotted]; D_self -> D_up [style=dotted]
  D_zapk -> D_aki [style=dashed]
  K_gfr -> D_zapk [label="renal clearance"]

  // --- denosumab
  D_dmb -> D_tmdd -> D_dmbon
  D_dmbon -> B_rankl [label="sequesters" color="#827717" penwidth=2]
  D_dmb -> D_hypo [style=dashed]
  D_dmbon -> D_hypo [style=dotted]

  // --- glucocorticoid / cinacalcet / dialysis / diuretic / chemo
  D_gc -> V_ext1a [label="− CYP27B1" color="#827717" penwidth=2]
  D_gc -> G_abs [label="− absorption" color="#827717"]
  D_gc -> T_bur [label="lymphotoxic" color="#827717"]
  D_gc -> B_ob [label="− (the cost)" style=dashed]
  D_cin -> P_casr [label="left-shifts set point" color="#827717"]
  D_dial -> X_ecf [label="direct removal" color="#827717" penwidth=2]
  D_fur -> K_tal [label="− NKCC2"]
  D_fur -> L_ecv [label="WORSENS the deficit" color="#B71C1C" penwidth=2]
  D_fur -> D_furok [style=dotted]
  D_chemo -> T_bur [label="removes the input" color="#33691E" penwidth=2]

  // --- clinical
  S_ion -> E_cns; S_ion -> E_gi; S_ion -> E_ren; S_ion -> E_ecg; S_ion -> E_mus
  E_rate -> E_cns [style=dotted]
  S_ion -> E_rate
  E_gi -> L_nau
  L_ndi -> E_ren
  M_neph -> E_ren
  T_bur -> E_prog [style=dotted]
  D_chemo -> E_prog [style=dotted]
  D_za -> E_relap [style=dotted]; T_bur -> E_relap [style=dotted]

  // --- biomarkers
  S_ion -> Y_ica; P_pth -> Y_pth
  Y_pth -> Y_panel; T_pthrp -> Y_panel; V_125d -> Y_panel
  Y_ctx -> Y_panel [style=dotted]
  Y_fe -> Y_panel [style=dotted]
  M_hypop -> Y_p1np [style=dotted]
  D_dmbon -> M_hypop [style=dashed]; V_25d -> M_hypop [style=dashed]
}
