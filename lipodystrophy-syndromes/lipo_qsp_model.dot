     ===================================================================== */
  subgraph cluster_repro {
    label="15 · Reproductive / endocrine axis";
    style="rounded,filled"; fillcolor="#fdf0f6"; color="#ab47bc"; fontsize=12; fontcolor="#6a1b9a";
    X_SHBG   [label="SHBG ↓ (hyperinsulinaemia)", fillcolor="#f3e0f5"];
    X_AND    [label="Ovarian + adrenal androgen ↑\n→ hirsutism, PCOS-like phenotype", fillcolor="#f3e0f5"];
    X_AMEN   [label="Oligo/amenorrhoea, subfertility\n(leptin-permissive GnRH failure)", fillcolor="#f3e0f5"];
    X_PREG   [label="Pregnancy: HTG crisis risk,\ngestational diabetes; metreleptin\ndata sparse", fillcolor="#ffd9d9"];
    X_GH     [label="GH/IGF-1 axis:\nlow IGFBP-1, acromegaloid features", fillcolor="#f3e0f5"];
  }

  /* =====================================================================
     16. SKIN, MUSCLE, APPEARANCE
     ===================================================================== */
  subgraph cluster_derm {
    label="16 · Skin, muscle and phenotype";
    style="rounded,filled"; fillcolor="#f6f4f0"; color="#8d6e63"; fontsize=12; fontcolor="#4e342e";
    S_PHENO  [label="Visible fat loss pattern\n(the diagnostic signature —\ndepot map of cluster 3)", fillcolor="#efe9e0"];
    S_MUSC   [label="Muscular / phlebomegalic appearance\n(pseudohypertrophy)", fillcolor="#efe9e0"];
    S_MYOP   [label="Myopathy, rhabdomyolysis\n(CAVIN1, LMNA)", fillcolor="#fadadd"];
    S_ACRO   [label="Acromegaloid facies, prominent\numbilicus, hepatomegaly (CGL)", fillcolor="#efe9e0"];
    S_QOL    [label="Body-image distress, stigma,\ndepression — QoL endpoint\nnot captured by HbA1c", fillcolor="#d7e9ff"];
    S_PANNIC [label="Panniculitis (AGL prodrome)", fillcolor="#fadadd"];
  }

  /* =====================================================================
     17. METRELEPTIN PK/PD AND IMMUNOGENICITY
     ===================================================================== */
  subgraph cluster_metr {
    label="17 · Metreleptin PK/PD — occupancy is easy, the deficit is the constraint";
    style="rounded,filled"; fillcolor="#eaf7f0"; color="#2e8b57"; fontsize=12; fontcolor="#1d5c39";
    M_SC     [label="Metreleptin SC depot\n0.06 mg/kg/d (≤40 kg: 0.06;\n>40 kg fixed 2.5-10 mg)", fillcolor="#d9f2e6"];
    M_ABS    [label="SC absorption ka\n(t½ abs ~1-2 h)", fillcolor="#d9f2e6"];
    M_CENT   [label="Central compartment\n(free metreleptin;\nt½ ~3.8-4.7 h)", fillcolor="#d9f2e6"];
    M_CLR    [label="Renal filtration + LepR-mediated\nclearance (saturable)", fillcolor="#d9f2e6"];
    M_TOTAL  [label="Total leptin exposure\nL_total = endogenous + metreleptin", fillcolor="#d9f2e6", penwidth=2.0, color="#1d5c39"];
    M_OCC    [label="Receptor occupancy\n(near-maximal at approved dose\nin BOTH GL and PL)", fillcolor="#d9f2e6", penwidth=2.0, color="#1d5c39"];
    M_EFF    [label="EFFECT = occupancy x Δ (deficit)\nthe product that explains the\nGL/PL dissociation", fillcolor="#ecebe4", penwidth=2.6, color="#1d5c39"];
    M_ADA    [label="Anti-metreleptin antibodies\n(nearly universal binding ADA)", fillcolor="#ffd9d9"];
    M_NEUT   [label="NEUTRALISING ADA\n→ effective free leptin ↓ while\ndose and Ctotal look unchanged", fillcolor="#ffd9d9", penwidth=2.0, color="#8b0000"];
    M_TCELL  [label="T-cell lymphoma signal in AGL\n(background risk vs drug —\nunresolved; boxed warning)", fillcolor="#ffd9d9"];
    M_WD     [label="Withdrawal → deficit returns\n→ hyperphagia, TG and HFF rebound\n(reversible, no hysteresis)", fillcolor="#ffd9d9"];
    M_DOSEUP [label="Dose escalation in PL\n(0.06 → 0.13 mg/kg)\nraises occupancy from ~0.9 to ~0.97\n→ effect barely moves", fillcolor="#ecebe4"];
  }

  /* =====================================================================
     18. PPARgamma AGONISTS — capacity-directed therapy
     ===================================================================== */
  subgraph cluster_ppar {
    label="18 · PPARγ agonists — the only agents that touch CAPACITY (and only if depots exist)";
    style="rounded,filled"; fillcolor="#eaf7f0"; color="#388e3c"; fontsize=12; fontcolor="#1b5e20";
    P_PIO    [label="Pioglitazone 30-45 mg PO\n(1-cmt, t½ 3-7 h; active M-III/IV)", fillcolor="#d9f2e6"];
    P_PPARG  [label="PPARγ activation in residual\npreadipocytes", fillcolor="#d9f2e6"];
    P_ADIPGEN[label="Adipogenesis → NEW adipocytes\n→ C_cap ↑ (weeks-months,\nτ ≈ 30-60 d)", fillcolor="#d9f2e6", penwidth=2.0, color="#1b5e20"];
    P_NULL   [label="In CGL: no preadipocyte substrate →\nΔC_cap ≈ 0 at identical exposure\n(the matched-control contrast)", fillcolor="#ecebe4", penwidth=2.0, color="#1b5e20"];
    P_FLUID  [label="Fluid retention, weight gain,\nbone loss, cosmetic worsening of\npreserved depots", fillcolor="#ffd9d9"];
    P_ADIPUP [label="Adiponectin ↑ (a genuine\nsecond mechanism of TZDs)", fillcolor="#d9f2e6"];
  }

  /* =====================================================================
     19. TG-DIRECTED AGENTS — spillover clearance, neither deficit touched
     ===================================================================== */
  subgraph cluster_tglow {
    label="19 · TG-directed agents — they clear the SPILLOVER, not the influx or the capacity";
    style="rounded,filled"; fillcolor="#eaf7f0"; color="#00897b"; fontsize=12; fontcolor="#00584d";
    V_VOL    [label="Volanesorsen / olezarsen\n(APOC3 ASO, SC; hepatic uptake)", fillcolor="#d9f2e6"];
    V_APOC3  [label="APOC3 mRNA knockdown\n(indirect-response, τ ≈ 2-3 wk)\n→ LPL de-inhibition", fillcolor="#d9f2e6"];
    V_EVIN   [label="Evinacumab (anti-ANGPTL3 mAb)\nLPL/EL de-inhibition, LPL-independent\nVLDL effect", fillcolor="#d9f2e6"];
    V_FIB    [label="Fenofibrate (PPARα)\n→ LPL ↑, APOC3 ↓, β-oxidation ↑", fillcolor="#d9f2e6"];
    V_OM3    [label="Omega-3 (EPA/DHA 4 g/d)\n→ hepatic VLDL-TG secretion ↓", fillcolor="#d9f2e6"];
    V_DIET   [label="Very-low-fat diet (<15-20% kcal)\n— the non-pharmacological way to\ncut J_in directly", fillcolor="#d9f2e6", penwidth=2.0, color="#00584d"];
    V_PLT    [label="Thrombocytopenia (volanesorsen),\ninjection-site reactions", fillcolor="#ffd9d9"];
    V_DECOUP [label="DECOUPLING PREDICTION:\nplasma TG ↓↓ while hepatic fat and\nHbA1c barely move — TG is a marker\nof overflow, not its cause", fillcolor="#ecebe4", penwidth=2.2, color="#00584d"];
  }

  /* =====================================================================
     20. GLYCAEMIA-DIRECTED AGENTS
     ===================================================================== */
  subgraph cluster_gly {
    label="20 · Glycaemia-directed agents (downstream of both deficits)";
    style="rounded,filled"; fillcolor="#eaf7f0"; color="#43a047"; fontsize=12; fontcolor="#1b5e20";
    Y_MET    [label="Metformin\n(hepatic AMPK/mGPD, HGP ↓)", fillcolor="#d9f2e6"];
    Y_INS    [label="High-dose / U-500 insulin\n(often >2 U/kg/d)", fillcolor="#d9f2e6"];
    Y_INSTRA [label="MODEL RESULT: 150 U/d lowers HbA1c\n1.4% and leaves hepatic fat and TG\nUNCHANGED — insulin treats the\nreadout, not the lesion", fillcolor="#ecebe4", penwidth=2.0, color="#1b5e20"];
    Y_GLP1   [label="GLP-1 RA / tirzepatide\n(intake ↓ — same lever as leptin,\ndifferent receptor)", fillcolor="#d9f2e6"];
    Y_SGLT2  [label="SGLT2 inhibitor\n(glucosuria; ketosis caution in\nvery low insulin reserve)", fillcolor="#d9f2e6"];
    Y_LEPCOMB[label="Metreleptin + GLP-1 RA:\ntwo anorexigenic levers on ONE\nintake term → less than additive", fillcolor="#ecebe4"];
  }

  /* =====================================================================
     21. CLINICAL ENDPOINTS AND BIOMARKERS
     ===================================================================== */
  subgraph cluster_end {
    label="21 · Clinical endpoints & biomarkers (what a trial measures)";
    style="rounded,filled"; fillcolor="#eef4fb"; color="#1f6feb"; fontsize=12; fontcolor="#0b3d91";
    Z_A1C    [label="ΔHbA1c\n(GL: ~−2.2%; FPLD overall: ~−0.6%)", fillcolor="#d7e9ff"];
    Z_TG     [label="ΔTG %\n(GL: ~−40 to −60%;\nvolanesorsen: ~−88%)", fillcolor="#d7e9ff"];
    Z_HFF    [label="ΔHepatic fat fraction\n(GL: ~−30 to −50% relative)", fillcolor="#d7e9ff"];
    Z_LEP    [label="Leptin (diagnostic + PD marker;\nsex- and BMI-adjusted cut-offs)", fillcolor="#d7e9ff"];
    Z_ADIPO  [label="Adiponectin", fillcolor="#d7e9ff"];
    Z_HUNGER [label="Hunger / satiety VAS,\nad-libitum intake, food-cue fMRI", fillcolor="#d7e9ff"];
    Z_ALT    [label="ALT, liver stiffness, NAS score", fillcolor="#d7e9ff"];
    Z_PROT   [label="Proteinuria, eGFR slope", fillcolor="#d7e9ff"];
    Z_PANCEP [label="Pancreatitis episodes /\ntime-above-threshold", fillcolor="#d7e9ff"];
    Z_INSDOSE[label="Insulin dose requirement\n(often falls >50% on metreleptin)", fillcolor="#d7e9ff"];
    Z_WT     [label="Body weight, fat mass (DXA),\nlean mass", fillcolor="#d7e9ff"];
  }

  /* =====================================================================
     22. STRUCTURAL INFERENCES — what the map claims and how to falsify it
     ===================================================================== */
  subgraph cluster_infer {
    label="22 · Structural inferences and their falsification tests";
    style="rounded,filled"; fillcolor="#f4f4ef"; color="#7f7f6a"; fontsize=12; fontcolor="#4a4a3c";
    Q_PRODUCT[label="INFERENCE 1\nEffect = occupancy x deficit.\nFalsified if dose escalation in\nhigh-leptin PL restores the GL-sized\neffect.", fillcolor="#ecebe4"];
    Q_PAIRFED[label="INFERENCE 2 — RESULT\nUnder a food-intake clamp 57% of the\nhepatic-fat benefit and 35% of the HbA1c\nbenefit SURVIVE (ΔHFF −48.6%, ΔHbA1c\n−0.83, ΔTG −19%). The direct hepatic arm\nis real but smaller than the appetite arm.", fillcolor="#ecebe4", penwidth=2.0, color="#1d5c39"];
    Q_TIER   [label="INFERENCE 3\nPlasma TG is tier 5 of a cascade.\nTest: remove it (APOC3 ASO) and\nhepatic fat should NOT follow.", fillcolor="#ecebe4"];
    Q_CAPSUB [label="INFERENCE 4\nTZD effect requires a preadipocyte\nsubstrate. Test: identical\nexposure in CGL vs FPLD.", fillcolor="#ecebe4"];
    Q_EQUIV  [label="INFERENCE 5\nA diet that cuts J_in by the same\namount as metreleptin's anorexigenic\neffect should match it on TG and HFF,\nbut NOT on the direct peripheral term.", fillcolor="#ecebe4"];
    Q_WINDOW [label="INFERENCE 6\nOnly fibrosis is irreversible, so\nearly initiation changes the ceiling\nof recovery, not its rate.", fillcolor="#ecebe4"];
    Q_NEUT   [label="INFERENCE 7\nNeutralising ADA reproduces\nwithdrawal while total leptin assay\nstays high — a PK/PD dissociation,\nnot non-adherence.", fillcolor="#ecebe4"];
  }

  /* =====================================================================
     EDGES — aetiology into the lesion
     ===================================================================== */
  G_AGPAT2 -> A_GPAT   [label="blocks LPA→PA", color="#b03060"];
  G_BSCL2  -> A_SEIPIN [label="loss", color="#b03060"];
  G_CAV1   -> A_CAVEO  [label="loss", color="#b03060"];
  G_CAVIN  -> A_CAVEO  [label="loss", color="#b03060"];
  G_CAVIN  -> S_MYOP;
  G_CAVIN  -> C_ARR;
  G_LMNA   -> A_LAMIN  [label="prelamin A", color="#b03060"];
  G_LMNA   -> C_LAMDCM;
  G_PPARG  -> A_PPARG  [label="dominant-negative", color="#b03060"];
  G_PPARG  -> C_HTN    [label="severe, early"];
  G_PLIN1  -> A_PLIN   [label="loss of barrier", color="#b03060"];
  G_PLIN1  -> F_BASLIP;
  G_AKT2   -> I_IRS    [label="signalling defect", color="#b03060"];
  G_PROG   -> A_LAMIN;
  G_AGL    -> A_APOP   [label="immune attack", color="#b03060"];
  G_AGL    -> S_PANNIC;
  G_AGL    -> M_TCELL  [style=dashed, label="confounded risk"];
  G_APL    -> K_C3NEF;
  G_HIV    -> A_APOP;
  G_IATRO  -> A_APOP;
  K_C3NEF  -> A_APOP   [label="adipocyte lysis"];
  K_C3NEF  -> R_MPGN;

  A_PREAD  -> A_PPARG;
  A_PPARG  -> A_CEBPA  [dir=both, label="mutual induction"];
  A_CEBPA  -> A_DIFF;
  A_PPARG  -> A_DIFF;
  A_PPARG  -> A_SREBP;
  A_SREBP  -> A_GPAT;
  A_LAMIN  -> A_SREBP  [label="sequestration ⇒ ↓", color="#b03060"];
  A_GPAT   -> A_LD     [label="TG synthesis"];
  A_SEIPIN -> A_LD     [label="droplet maturation"];
  A_CD36   -> A_GPAT   [label="FA supply"];
  A_CAVEO  -> A_CD36;
  A_PLIN   -> A_LD;
  A_HSL    -> F_NEFA   [label="lipolysis"];
  A_PLIN   -> A_HSL    [label="restrains", color="#2e8b57", arrowhead=tee];
  A_LD     -> A_DIFF;
  A_DIFF   -> D_CAPTOT [label="adipocyte number\n→ capacity"];
  A_APOP   -> D_CAPTOT [label="↓", color="#b03060"];
  A_APOP   -> A_PREAD  [style=dashed, label="pool depleted"];
  A_HYPER  -> K_INFL   [label="stress → inflammation"];
  A_HYPER  -> F_BASLIP;
  A_DIFF   -> E_VMAX;
  A_GPAT   -> E_VMAX   [label="sets Vmax"];
  A_PREAD  -> D_EXPAND;
  A_PPARG  -> D_EXPAND;

  /* depots and the capacity distribution */
  D_FEMGL  -> D_CAPTOT;
  D_UPTRUNK-> D_CAPTOT;
  D_FACE   -> D_CAPTOT;
  D_VISC   -> D_CAPTOT;
  D_MECH   -> D_CAPTOT [style=dashed, label="non-metabolic"];
  D_MARROW -> D_CAPTOT [style=dashed];
  G_LMNA   -> D_FEMGL  [label="lost", color="#b03060"];
  G_LMNA   -> D_UPTRUNK[label="preserved/expanded", color="#2e8b57"];
  G_BSCL2  -> D_MECH   [label="lost (unlike CGL1)", color="#b03060"];
  G_BSCL2  -> D_MARROW [label="lost", color="#b03060"];
  G_AGPAT2 -> D_MECH   [label="preserved", color="#2e8b57"];
  G_APL    -> D_FACE   [label="cephalocaudal loss", color="#b03060"];
  D_CAPTOT -> E_FILL;
  D_CAPTOT -> L_SECR   [label="fat mass sets\nsignal", penwidth=1.6];
  D_FEMGL  -> L_SECR   [label="SC ≫ visceral\nper gram"];
  D_EXPAND -> D_CAPTOT [label="only movable term", color="#2e8b57"];

  /* influx */
  F_INTAKE -> F_FATDIET;
  F_INTAKE -> F_CHO;
  F_FATDIET-> F_JIN;
  F_CHO    -> F_DNL;
  F_DNL    -> F_JIN;
  F_DNL    -> H_TG     [label="direct hepatic\ndeposition"];
  F_NEFA   -> F_JIN;
  F_BASLIP -> F_NEFA;
  F_LPL    -> D_FEMGL  [label="TG hydrolysis →\ndepot uptake"];
  F_APOC3  -> F_LPL    [arrowhead=tee, color="#b03060", label="inhibits"];
  F_ANGPTL -> F_LPL    [arrowhead=tee, color="#b03060", label="inhibits"];
  F_LPL    -> E_SPILL  [label="spillover if uptake\n< hydrolysis"];
  E_SPILL  -> F_NEFA;
  F_JIN    -> E_SAT    [label="substrate"];
  F_JIN    -> E_OVER   [label="numerator", penwidth=1.8];

  /* the buffer */
  E_VMAX   -> E_SAT;
  E_FILL   -> E_SAT    [label="(1−f) gating", arrowhead=tee, color="#b03060"];
  I_IRS    -> E_SAT    [label="insulin action\nrequired"];
  E_SAT    -> E_OVER   [arrowhead=tee, color="#2e8b57", label="subtracts", penwidth=1.8];
  E_SAT    -> O_SC;
  E_THERMO -> E_OVER   [style=dashed, label="why it must\ngo somewhere"];
  D_CAPTOT -> E_SAT    [label="ceiling"];

  /* overflow cascade — ordered */
  E_OVER   -> O_SC     [label="tier 1", penwidth=1.4];
  O_SC     -> O_VISC   [label="tier 2 when SC full", penwidth=1.4];
  O_VISC   -> O_LIVER  [label="portal NEFA", penwidth=1.4];
  E_OVER   -> O_LIVER  [label="tier 3", penwidth=1.8];
  E_OVER   -> O_MUSCLE [label="tier 4", penwidth=1.4];
  E_OVER   -> O_PLASMA [label="tier 5", penwidth=1.4];
  E_OVER   -> O_PANC   [label="tier 6", penwidth=1.4];
  E_OVER   -> O_HEART;
  E_OVER   -> O_KIDNEY;
  O_LIVER  -> H_TG;
  O_LIVER  -> O_DAG;
  O_MUSCLE -> O_DAG;
  O_DAG    -> I_SER    [label="PKCε/θ activation", penwidth=1.6];
  O_CERAM  -> I_SER;
  O_LIVER  -> O_CERAM;
  O_PANC   -> U_LIPOTX;
  O_HEART  -> C_DIAST;
  O_HEART  -> C_HCM;
  O_KIDNEY -> R_FSGS;
  O_PLASMA -> T_TG;

  /* leptin axis */
  L_SECR   -> L_PLASMA;
  L_PLASMA -> L_BBB;
  L_BBB    -> L_LEPRB;
  L_LEPRB  -> L_TRANS  [label="signal transduction"];
  L_PLASMA -> L_TRANS  [label="input to S(L)", penwidth=1.6];
  L_TRANS  -> L_DEFICIT[label="Δ = 1 − S", penwidth=2.0];
  L_TRANS  -> L_POMC   [color="#2e8b57"];
  L_TRANS  -> L_AGRP   [arrowhead=tee, color="#b03060"];
  L_POMC   -> L_MC4R;
  L_AGRP   -> L_MC4R   [arrowhead=tee, color="#b03060"];
  L_MC4R   -> L_HYPER  [arrowhead=tee, color="#2e8b57", label="satiety"];
  L_DEFICIT-> L_HYPER  [label="drives", penwidth=2.0, color="#b03060"];
  L_TRANS  -> L_REWARD [arrowhead=tee];
  L_REWARD -> L_HYPER;
  L_TRANS  -> L_SNS;
  L_SNS    -> Z_WT     [style=dashed, label="EE component (small)"];
  L_TRANS  -> L_HPT;
  L_HPT    -> Z_WT     [style=dashed];
  L_TRANS  -> L_KISS   [color="#2e8b57"];
  L_KISS   -> X_AMEN   [arrowhead=tee, color="#2e8b57", label="permissive"];
  L_TRANS  -> L_IMMUNE;
  L_TRANS  -> L_SOCS   [label="induces its own brake"];
  L_SOCS   -> L_TRANS  [arrowhead=tee, color="#b03060", label="desensitisation\n(obesity)"];
  L_HYPER  -> F_INTAKE [label="EI ↑", penwidth=2.2, color="#b03060"];
  L_PERIPH -> H_OX     [color="#2e8b57", label="FA oxidation ↑"];
  L_PERIPH -> F_DNL    [arrowhead=tee, color="#2e8b57", label="SREBP-1c ↓"];
  H_TG     -> H_VLDL   [style=dashed, label="secretion falls only\nbecause substrate does"];
  L_PERIPH -> I_IRINDEX[arrowhead=tee, color="#2e8b57", label="direct sensitisation"];
  L_TRANS  -> L_PERIPH;

  /* adipokines */
  D_CAPTOT -> K_ADIPO  [label="fat mass"];
  K_ADIPO  -> K_ADIPOR;
  K_ADIPOR -> H_OX     [color="#2e8b57", label="FA oxidation ↑"];
  K_ADIPOR -> O_CERAM  [arrowhead=tee, color="#2e8b57"];
  K_ADIPO  -> I_IRINDEX[arrowhead=tee, color="#2e8b57"];
  H_ROS    -> K_FGF21;
  K_FGF21  -> D_CAPTOT [style=dashed, label="target tissue\nmissing"];
  K_INFL   -> I_SER;
  K_INFL   -> H_KUPF;

  /* insulin signalling */
  I_SER    -> I_IRS    [arrowhead=tee, color="#b03060", label="uncouples"];
  I_IRS    -> I_GLUT4;
  I_IRS    -> I_HGP    [arrowhead=tee, label="suppresses"];
  I_SER    -> I_SELECT;
  I_SELECT -> F_DNL    [label="DNL stays\ninsulin-driven", color="#b03060", penwidth=1.6];
  I_SELECT -> I_HGP    [label="HGP escapes", color="#b03060"];
  I_IRINDEX-> I_GLUT4  [arrowhead=tee];
  I_IRINDEX-> I_HYPINS;
  O_LIVER  -> I_IRINDEX[label="a·HFF", penwidth=1.4];
  O_MUSCLE -> I_IRINDEX[label="b·IMCL", penwidth=1.4];
  I_HYPINS -> I_ACANTH;
  I_HYPINS -> X_SHBG   [arrowhead=tee];
  I_HYPINS -> R_HYPER;
  I_HYPINS -> F_DNL;

  /* glucose */
  I_GLUT4  -> U_GLUC   [arrowhead=tee, label="disposal"];
  I_HGP    -> U_GLUC   [label="production"];
  U_GLUC   -> U_ISEC;
  U_BCELL  -> U_ISEC;
  U_ISEC   -> I_HYPINS;
  U_LIPOTX -> U_BCELL  [arrowhead=tee, color="#b03060", label="functional loss"];
  U_GLUC   -> U_LIPOTX [label="glucotoxicity"];
  U_GLUC   -> U_A1C    [label="τ ≈ 35 d integrator", penwidth=1.6];
  U_GLUC   -> R_HYPER;
  Y_SGLT2  -> U_DKA    [style=dashed];
  U_A1C    -> Z_A1C;

  /* liver */
  H_TG     -> H_VLDL   [label="substrate-driven"];
  H_TG     -> H_ROS;
  H_TG     -> H_HEPMEG;
  H_OX     -> H_TG     [arrowhead=tee, color="#2e8b57"];
  H_ROS    -> H_ALT;
  H_ROS    -> H_KUPF;
  H_KUPF   -> H_HSC;
  H_HSC    -> H_FIB    [penwidth=1.6];
  H_FIB    -> H_CIRR;
  H_FIB    -> H_STIFF;
  H_ALT    -> Z_ALT;
  H_STIFF  -> Z_ALT;
  H_VLDL   -> T_TG     [penwidth=1.8];
  O_LIVER  -> H_TG     [style=invis];

  /* plasma lipids */
  T_TG     -> T_CM;
  T_CM     -> T_XANTH;
  T_TG     -> T_HDL;
  T_TG     -> T_PANC   [label="steep threshold", penwidth=1.8, color="#b03060"];
  T_PANC   -> Z_PANCEP;
  T_TG     -> T_TIME;
  T_TIME   -> Z_PANCEP;
  T_APHER  -> T_TG     [arrowhead=tee, color="#2e8b57", label="acute rescue"];
  T_TG     -> C_ATH;
  T_HDL    -> C_ATH;
  F_LPL    -> T_TG     [arrowhead=tee, color="#2e8b57", label="clearance"];

  /* organ complications to endpoints */
  C_HTN    -> C_ATH;
  C_HTN    -> C_MACE;
  C_ATH    -> C_MACE;
  C_HCM    -> C_MACE;
  C_ARR    -> C_MACE;
  C_LAMDCM -> C_MACE;
  C_DIAST  -> C_MACE;
  R_HYPER  -> R_PROT;
  R_PROT   -> R_CKD;
  R_FSGS   -> R_PROT;
  R_MPGN   -> R_CKD;
  R_PROT   -> Z_PROT;
  R_CKD    -> Z_PROT;
  X_SHBG   -> X_AND;
  I_HYPINS -> X_AND    [label="ovarian theca\nstimulation"];
  X_AND    -> X_AMEN;
  X_AMEN   -> X_PREG   [style=dashed];
  T_TG     -> X_PREG   [label="HTG crisis in\npregnancy"];
  I_HYPINS -> X_GH;
  X_GH     -> S_ACRO;
  D_CAPTOT -> S_PHENO;
  S_PHENO  -> S_QOL;
  S_MUSC   -> S_PHENO;
  S_ACRO   -> S_PHENO;
  S_PANNIC -> A_APOP;
  S_MYOP   -> S_QOL;
  H_HEPMEG -> S_ACRO;

  /* METRELEPTIN */
  M_SC     -> M_ABS;
  M_ABS    -> M_CENT;
  M_CENT   -> M_CLR;
  M_CENT   -> M_TOTAL;
  L_PLASMA -> M_TOTAL  [label="endogenous term"];
  M_TOTAL  -> M_OCC;
  M_TOTAL  -> L_TRANS  [label="drives S(L)", penwidth=2.2, color="#2e8b57"];
  M_OCC    -> M_EFF    [label="factor 1", penwidth=1.8];
  L_DEFICIT-> M_EFF    [label="factor 2 (patient)", penwidth=2.4, color="#b03060"];
  M_EFF    -> L_HYPER  [arrowhead=tee, color="#2e8b57", label="intake ↓", penwidth=2.0];
  M_EFF    -> L_PERIPH [color="#2e8b57", penwidth=1.6];
  M_ADA    -> M_CENT   [style=dashed, label="alters PK,\nassay interference"];
  M_ADA    -> M_NEUT   [label="subset"];
  M_NEUT   -> M_TOTAL  [arrowhead=tee, color="#8b0000", label="neutralises free\ndrug", penwidth=1.8];
  M_NEUT   -> Q_NEUT;
  M_WD     -> L_DEFICIT[label="deficit returns"];
  M_DOSEUP -> M_OCC    [label="0.9 → 0.97"];
  M_DOSEUP -> Q_PRODUCT;
  M_EFF    -> Z_INSDOSE[arrowhead=tee, color="#2e8b57"];
  M_EFF    -> U_HYPO   [style=dashed, label="if insulin/SU\nnot reduced"];
  M_EFF    -> X_AMEN   [arrowhead=tee, color="#2e8b57", label="menses restored"];
  M_TCELL  -> Z_A1C    [style=invis];

  /* PPARgamma */
  P_PIO    -> P_PPARG;
  P_PPARG  -> P_ADIPGEN;
  D_EXPAND -> P_ADIPGEN[label="required substrate", penwidth=1.8];
  P_ADIPGEN-> D_CAPTOT [label="ΔC_cap ↑", color="#2e8b57", penwidth=1.8];
  P_PPARG  -> P_ADIPUP;
  P_ADIPUP -> K_ADIPO  [color="#2e8b57"];
  P_PIO    -> P_FLUID;
  P_NULL   -> Q_CAPSUB;
  P_ADIPGEN-> P_NULL   [style=dashed, label="absent if no\npreadipocytes"];
  P_FLUID  -> S_PHENO  [style=dashed, label="cosmetic worsening"];

  /* TG-directed */
  V_VOL    -> V_APOC3;
  V_APOC3  -> F_APOC3  [arrowhead=tee, color="#2e8b57", penwidth=1.8];
  V_EVIN   -> F_ANGPTL [arrowhead=tee, color="#2e8b57"];
  V_FIB    -> F_LPL    [color="#2e8b57"];
  V_FIB    -> F_APOC3  [arrowhead=tee, color="#2e8b57"];
  V_FIB    -> H_OX     [color="#2e8b57"];
  V_OM3    -> H_VLDL   [arrowhead=tee, color="#2e8b57"];
  V_DIET   -> F_FATDIET[arrowhead=tee, color="#2e8b57", penwidth=1.8, label="cuts J_in directly"];
  V_VOL    -> V_PLT;
  V_APOC3  -> V_DECOUP;
  V_DECOUP -> Q_TIER;
  V_DIET   -> Q_EQUIV;

  /* glycaemia agents */
  Y_MET    -> I_HGP    [arrowhead=tee, color="#2e8b57"];
  Y_INS    -> U_GLUC   [arrowhead=tee, color="#2e8b57"];
  Y_INS    -> F_DNL    [label="SREBP-1c ↑", color="#b03060"];
  Y_INS    -> Y_INSTRA;
  Y_INSTRA -> O_LIVER  [style=dashed, label="no change at\nΔHbA1c −1.4"];
  Y_GLP1   -> F_INTAKE [arrowhead=tee, color="#2e8b57"];
  Y_GLP1   -> Y_LEPCOMB;
  M_EFF    -> Y_LEPCOMB[style=dashed];
  Y_LEPCOMB-> F_INTAKE [style=dashed, label="shared saturating\nlever"];
  Y_SGLT2  -> U_GLUC   [arrowhead=tee, color="#2e8b57"];

  /* endpoints */
  O_LIVER  -> Z_HFF    [penwidth=1.6];
  T_TG     -> Z_TG     [penwidth=1.6];
  L_PLASMA -> Z_LEP;
  M_TOTAL  -> Z_LEP    [style=dashed, label="assay measures\ntotal"];
  K_ADIPO  -> Z_ADIPO;
  L_HYPER  -> Z_HUNGER;
  D_CAPTOT -> Z_WT;
  O_SC     -> Z_WT;
  H_FIB    -> Q_WINDOW [label="only irreversible\nstate"];

  /* inference wiring */
  L_PERIPH -> Q_PAIRFED[label="predicts residual\neffect"];
  M_EFF    -> Q_PRODUCT[penwidth=1.4];
  G_LEPMUT -> Q_PRODUCT[style=dashed, label="deficit=1, capacity\nintact → pure signal\narm"];
  G_OBES   -> Q_PRODUCT[style=dashed, label="deficit≈0, capacity\nexceeded → pure\ncapacity arm"];
  G_OBES   -> L_SOCS   [style=dashed, label="transducer saturated\n+ desensitised"];
  E_OVER   -> Q_TIER   [style=dashed];
  D_EXPAND -> Q_CAPSUB [style=dashed];
  V_DIET   -> F_JIN    [arrowhead=tee, color="#2e8b57"];

  /* ranking hints to keep the flow legible */
  { rank=same; F_JIN; E_SAT; }
  { rank=same; L_TRANS; M_OCC; }
  { rank=same; Z_A1C; Z_TG; Z_HFF; }
}
