/* ===========================================================================
   lipo_qsp_model.dot
   Lipodystrophy syndromes (congenital generalised · acquired generalised ·
   familial partial · acquired partial) — mechanistic QSP map

   ORGANISING THESIS (see README.md):
     Adipose tissue does two unrelated jobs with one tissue.  It is
       (a) a MECHANICAL BUFFER — the only compartment that can esterify a
           large postprandial triglyceride flux and hold it at low
           thermodynamic cost, and
       (b) an ENDOCRINE ORGAN — the source of the afferent leptin signal that
           tells the hypothalamus how large the buffer is.

     Lipodystrophy is ONE lesion (loss of adipocyte mass or function) that
     therefore produces TWO independent deficits.  Every clinical feature and
     every therapeutic success and failure in this map is derived from which
     of the two deficits a drug touches:

        deficit (a)  storage capacity lost   -> influx that cannot be
                                                esterified OVERFLOWS in a
                                                fixed cascade
                                                (SC -> visceral -> liver ->
                                                 muscle -> plasma -> pancreas)
        deficit (b)  leptin signal lost      -> hyperphagia RAISES the influx
                                                that the missing buffer cannot
                                                store, and the peripheral
                                                actions of leptin on hepatic
                                                VLDL and insulin sensitivity
                                                are absent

     The therapeutic consequence is drawn as a PRODUCT, not as a list:

        metreleptin effect  =  receptor occupancy  x  SIGNAL DEFICIT

     Occupancy is a property of the dose.  The deficit is a property of the
     patient.  In generalised lipodystrophy (leptin 0.5-2 ng/mL) the deficit
     term is near 1 and the drug is transformative; in partial lipodystrophy
     with leptin 8-12 ng/mL the SAME dose reaches the SAME occupancy against a
     deficit term near 0.1 and the drug looks like a failure.  Nothing in this
     map treats "metreleptin works in GL but not in PL" as a separate rule —
     it is the deficit factor, and raising the dose cannot move it.

     Symmetrically, PPARgamma agonists act only on deficit (a) and only where
     residual expandable adipocytes exist, so the identical exposure that
     helps FPLD does nothing in CGL.  APOC3/ANGPTL3-directed agents act on
     neither deficit: they clear the SPILLOVER (plasma TG) without changing
     influx or capacity, which is why they collapse triglyceride while barely
     moving hepatic fat.

   Render:
     dot -Tsvg lipo_qsp_model.dot -o lipo_qsp_model.svg
     dot -Tpng -Gdpi=150 lipo_qsp_model.dot -o lipo_qsp_model.png
   =========================================================================== */

digraph LIPO_QSP {
  graph [rankdir=TB, splines=spline, overlap=false, newrank=true, nodesep=0.28, ranksep=0.52,
         fontname="Helvetica", fontsize=11, compound=true,
         labelloc="t", fontcolor="#1a1a2e",
         label=<<B>Lipodystrophy Syndromes — Quantitative Systems Pharmacology Map</B><BR/>
                <FONT POINT-SIZE="11">adipose tissue as a finite mechanical buffer AND the afferent endocrine signal reporting its size<BR/>
                one lesion, two deficits · overflow cascade to liver/muscle/plasma/pancreas · metreleptin effect = occupancy x signal deficit · drug PK/PD</FONT>>];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=9,
         color="#33334d", penwidth=0.8, margin="0.07,0.04"];
  edge  [fontname="Helvetica", fontsize=8, color="#5a5a72", arrowsize=0.6, penwidth=0.9];

  /* ---------------------------------------------------------------- palette
     genetics/aetiology    #e8e2f7   adipocyte biology  #fdf0d8
     depots / capacity     #fdf3d0   lipid flux         #fde6d8
     ectopic / overflow    #f7ded0   leptin-CNS axis    #e2f0e2
     insulin / glucose     #dfeef7   liver              #efe4d4
     plasma lipid          #fdeae0   organ complications #fadadd
     drugs                 #d9f2e6   endpoints          #d7e9ff
     inference / structure #ecebe4   harm/adverse       #ffd9d9
     ---------------------------------------------------------------------- */

  /* =====================================================================
     1. GENETIC AND ACQUIRED AETIOLOGY  —  many causes, ONE lesion
     ===================================================================== */
  subgraph cluster_gen {
    label="1 · Aetiology (many causes converge on one lesion: lost adipocyte mass/function)";
    style="rounded,filled"; fillcolor="#f6f4fb"; color="#8e7cc3"; fontsize=12; fontcolor="#4a3b78";
    G_AGPAT2 [label="AGPAT2 (CGL1, ~45% of CGL)\n1-acylglycerol-3-P acyltransferase 2\nglycerolipid synthesis blocked at\nLPA → PA step", fillcolor="#e8e2f7"];
    G_BSCL2  [label="BSCL2 / seipin (CGL2, ~35%)\nlipid-droplet fusion + ER-LD contact\nsite; most severe, bone marrow fat\nalso lost", fillcolor="#e8e2f7"];
    G_CAV1   [label="CAV1 (CGL3, rare)\ncaveolin-1 — caveolar FA uptake,\nvitamin D resistance", fillcolor="#e8e2f7"];
    G_CAVIN  [label="CAVIN1 / PTRF (CGL4)\ncaveolae scaffold loss →\n+ myopathy, long QT,\ncatecholaminergic arrhythmia", fillcolor="#e8e2f7"];
    G_LMNA   [label="LMNA R482W/Q (FPLD2, Dunnigan)\nlamin A/C — nuclear lamina;\nlimb + gluteal loss, facial/neck\nfat PRESERVED or increased", fillcolor="#e8e2f7"];
    G_PPARG  [label="PPARG (FPLD3)\nmaster adipogenic TF —\ndominant-negative alleles;\nsevere hypertension + HTG", fillcolor="#e8e2f7"];
    G_PLIN1  [label="PLIN1 (FPLD4) · CIDEC (FPLD5)\nlipid droplet coat proteins →\nsmall droplets, high basal lipolysis", fillcolor="#e8e2f7"];
    G_AKT2   [label="AKT2 · LIPE · ADRA2A\n(FPLD6-7) insulin signalling and\nlipolysis defects", fillcolor="#e8e2f7"];
    G_PROG   [label="ZMPSTE24 · POLD1 · WRN · BANF1\nprogeroid laminopathies with\ngeneralised fat loss", fillcolor="#e8e2f7"];
    G_AGL    [label="Acquired generalised (Lawrence)\npanniculitis / autoimmune /\nidiopathic; anti-adipocyte immunity;\nassociated T-cell dyscrasia", fillcolor="#e8e2f7"];
    G_APL    [label="Acquired partial (Barraquer-Simons)\ncephalocaudal fat loss, C3\nnephritic factor, low C3,\nMPGN/C3 glomerulopathy", fillcolor="#e8e2f7"];
    G_HIV    [label="HIV/ART-associated\n(thymidine analogue-era):\nmitochondrial toxicity +\nprotease-inhibitor effects", fillcolor="#e8e2f7"];
    G_IATRO  [label="Iatrogenic / localised:\nsteroid, insulin injection\nlipoatrophy, anti-PD1 AGL,\npost-HSCT", fillcolor="#e8e2f7"];
    G_LEPMUT [label="Congenital leptin / LEPR deficiency\n(NOT lipodystrophy — fat mass is\nHIGH) → the deficit-only control\ncase for this map", fillcolor="#ecebe4"];
    G_OBES   [label="Common obesity\n(capacity exceeded, signal HIGH)\n→ the capacity-only control case", fillcolor="#ecebe4"];
  }

  /* =====================================================================
     2. ADIPOCYTE DIFFERENTIATION AND LIPID DROPLET BIOLOGY
     ===================================================================== */
  subgraph cluster_adipo {
    label="2 · Adipocyte differentiation & lipid-droplet machinery (sets Vmax and capacity)";
    style="rounded,filled"; fillcolor="#fefaf0"; color="#c9a227"; fontsize=12; fontcolor="#8a6d0b";
    A_PREAD  [label="Preadipocyte pool\n(PDGFRα+ / CD34+ progenitors)", fillcolor="#fdf0d8"];
    A_PPARG  [label="PPARγ–RXRα\nmaster adipogenic switch", fillcolor="#fdf0d8"];
    A_CEBPA  [label="C/EBPα ⇄ PPARγ\npositive feedback loop", fillcolor="#fdf0d8"];
    A_SREBP  [label="SREBP-1c / SCD1\nlipogenic gene programme\nin adipocyte", fillcolor="#fdf0d8"];
    A_DIFF   [label="Terminal differentiation\n(mature unilocular adipocyte)", fillcolor="#fdf0d8"];
    A_GPAT   [label="GPAT → AGPAT2 → LIPIN1/PAP →\nDGAT1/2\nglycerolipid esterification chain", fillcolor="#fdf0d8"];
    A_SEIPIN [label="Seipin at ER–LD contact\n(droplet nucleation & fusion,\nPA/DAG channelling)", fillcolor="#fdf0d8"];
    A_LD     [label="Lipid droplet\n(unilocular, PLIN1-coated)", fillcolor="#fdf0d8"];
    A_CAVEO  [label="Caveolae (CAV1 + CAVIN1)\nFA uptake, membrane reservoir,\nmechanoprotection", fillcolor="#fdf0d8"];
    A_CD36   [label="CD36 / FATP1 / FABP4\nfatty acid transport into adipocyte", fillcolor="#fdf0d8"];
    A_HSL    [label="ATGL → HSL → MGL\nlipolytic cascade\n(PKA / natriuretic peptide driven)", fillcolor="#fdf0d8"];
    A_PLIN   [label="PLIN1 barrier function\n(restrains BASAL lipolysis)", fillcolor="#fdf0d8"];
    A_APOP   [label="Adipocyte apoptosis / senescence\n(lamin A toxicity, panniculitis,\nimmune attack)", fillcolor="#fadadd"];
    A_LAMIN  [label="Nuclear lamina integrity\n(prelamin A accumulation →\nSREBP-1c sequestration)", fillcolor="#fdf0d8"];
    A_HYPER  [label="Residual adipocyte HYPERTROPHY\n(compensatory; raises stress,\nnot capacity)", fillcolor="#fdf0d8"];
  }

  /* =====================================================================
     3. DEPOT-SPECIFIC CAPACITY — the ceiling is a DISTRIBUTION
     ===================================================================== */
  subgraph cluster_depot {
    label="3 · Depot-specific storage capacity (the ceiling is a distribution, not a number)";
    style="rounded,filled"; fillcolor="#fffcf0"; color="#b8860b"; fontsize=12; fontcolor="#7a5c00";
    D_FEMGL  [label="Femorogluteal SC depot\nlargest, most insulin-sensitive\nsink — lost in FPLD2 and all GL", fillcolor="#fdf3d0"];
    D_UPTRUNK[label="Upper trunk / dorsocervical depot\nPRESERVED and expanded in FPLD2\n(buffalo hump, double chin)", fillcolor="#fdf3d0"];
    D_FACE   [label="Facial / bucal fat\nlost in AGL and APL,\npreserved in FPLD2", fillcolor="#fdf3d0"];
    D_VISC   [label="Visceral / omental depot\nsecond-tier sink;\nexpanded in FPLD, absent in CGL2", fillcolor="#fdf3d0"];
    D_MECH   [label="Mechanical depots\n(palms, soles, orbit, periarticular)\nPRESERVED in CGL1, LOST in CGL2\n(seipin) — diagnostic dissociation", fillcolor="#fdf3d0"];
    D_MARROW [label="Bone marrow fat\nlost in CGL2 only", fillcolor="#fdf3d0"];
    D_CAPTOT [label="TOTAL STORAGE CAPACITY  C_cap\n= Σ (depot mass ceiling)\nCGL ≈ 2-5% of normal\nFPLD2 ≈ 40-60% of normal", fillcolor="#fdf3d0", penwidth=2.2, color="#8a6d0b"];
    D_EXPAND [label="Expandability reserve\n(preadipocyte pool x PPARγ tone)\n— the ONLY term a TZD can move", fillcolor="#fdf3d0"];
  }

  /* =====================================================================
     4. LIPID INFLUX  —  what has to be stored each day
     ===================================================================== */
  subgraph cluster_influx {
    label="4 · Daily lipid influx J_in (the numerator of the overflow problem)";
    style="rounded,filled"; fillcolor="#fff5ee"; color="#d2691e"; fontsize=12; fontcolor="#8b4513";
    F_INTAKE [label="Energy intake EI\n(kcal/d) — set by hypothalamic\nleptin signal (cluster 7)", fillcolor="#fde6d8", penwidth=2.0, color="#8b4513"];
    F_FATDIET[label="Dietary fat load\n(chylomicron-TG flux)", fillcolor="#fde6d8"];
    F_CHO    [label="Dietary carbohydrate\n(→ hepatic DNL substrate)", fillcolor="#fde6d8"];
    F_DNL    [label="Hepatic de novo lipogenesis\nChREBP + SREBP-1c → ACC → FASN\n→ SCD1", fillcolor="#fde6d8"];
    F_LPL    [label="Capillary LPL activity\n(GPIHBP1-anchored,\nAPOC2 cofactor)", fillcolor="#fde6d8"];
    F_APOC3  [label="APOC3\ninhibits LPL + hepatic\nremnant uptake", fillcolor="#fde6d8"];
    F_ANGPTL [label="ANGPTL3 / ANGPTL4 / ANGPTL8\nendogenous LPL inhibitors\n(depot- and fasting-state specific)", fillcolor="#fde6d8"];
    F_NEFA   [label="Plasma NEFA flux\n(adipose lipolysis + spillover)", fillcolor="#fde6d8"];
    F_BASLIP [label="Elevated BASAL lipolysis\n(PLIN1/CIDEC defect, small droplets)\n— influx that never got stored", fillcolor="#fde6d8"];
    F_JIN    [label="J_in = dietary TG + DNL + NEFA re-esterification\nload presented to the buffer", fillcolor="#fde6d8", penwidth=2.2, color="#8b4513"];
  }

  /* =====================================================================
     5. THE BUFFER FUNCTION — capacity-limited esterification
     ===================================================================== */
  subgraph cluster_buffer {
    label="5 · The buffer function: capacity-limited esterification (where the model's non-linearity lives)";
    style="rounded,filled"; fillcolor="#f4f7ee"; color="#6b8e23"; fontsize=12; fontcolor="#40551a";
    E_VMAX   [label="Esterification Vmax_i\n∝ adipocyte number x AGPAT2/DGAT\nactivity x insulin action", fillcolor="#eaf2dc"];
    E_FILL   [label="Fractional fill  f_i = A_i / C_cap,i\n(how full each depot is)", fillcolor="#eaf2dc"];
    E_SAT    [label="Storage flux  J_st,i =\nVmax_i · (1 − f_i)⁺ · NEFA/(Km+NEFA)\n· insulin action", fillcolor="#eaf2dc", penwidth=2.2, color="#40551a"];
    E_OVER   [label="OVERFLOW  J_ov = J_in − Σ J_st,i\nthe single quantity that drives\nevery downstream complication", fillcolor="#f7ded0", penwidth=2.4, color="#8b4513"];
    E_SPILL  [label="Postprandial spillover\n(TG hydrolysed but not taken up)", fillcolor="#eaf2dc"];
    E_THERMO [label="Why overflow is obligatory:\nno alternative low-cost TG sink;\noxidation capacity is fixed", fillcolor="#ecebe4"];
  }

  /* =====================================================================
     6. OVERFLOW CASCADE — fixed order of ectopic deposition
     ===================================================================== */
  subgraph cluster_over {
    label="6 · Overflow cascade (fixed order: SC → visceral → liver → muscle → plasma → pancreas)";
    style="rounded,filled"; fillcolor="#fdf1ea"; color="#cd5b45"; fontsize=12; fontcolor="#8b3a2b";
    O_SC     [label="Tier 1 · subcutaneous TG mass\n(first and cheapest sink)", fillcolor="#f7ded0"];
    O_VISC   [label="Tier 2 · visceral TG mass\n(portal NEFA delivery)", fillcolor="#f7ded0"];
    O_LIVER  [label="Tier 3 · hepatocyte TG\n→ hepatic fat fraction (MRI-PDFF)", fillcolor="#f7ded0", penwidth=2.0, color="#8b3a2b"];
    O_MUSCLE [label="Tier 4 · intramyocellular lipid\n(DAG species, not TG itself,\nare the signalling toxin)", fillcolor="#f7ded0"];
    O_PLASMA [label="Tier 5 · plasma TG (VLDL1 + CM)\nthe OVERFLOW MARKER —\nnot a reservoir", fillcolor="#f7ded0", penwidth=2.0, color="#8b3a2b"];
    O_PANC   [label="Tier 6 · pancreatic islet lipid\n→ beta-cell lipotoxicity", fillcolor="#f7ded0"];
    O_HEART  [label="Myocardial TG\n(→ diastolic dysfunction, HCM in CGL)", fillcolor="#f7ded0"];
    O_KIDNEY [label="Renal lipid / podocyte lipotoxicity", fillcolor="#f7ded0"];
    O_DAG    [label="DAG–PKCε axis (liver)\nDAG–PKCθ axis (muscle)\nthe mechanistic bridge to insulin\nresistance", fillcolor="#f7ded0"];
    O_CERAM  [label="Ceramide accumulation\n(alternative lipotoxic mediator;\nadiponectin-suppressible)", fillcolor="#f7ded0"];
  }

  /* =====================================================================
     7. LEPTIN — the afferent signal and its saturating transducer
     ===================================================================== */
  subgraph cluster_leptin {
    label="7 · Leptin axis: the afferent signal, its SATURATING transducer, and the deficit term";
    style="rounded,filled"; fillcolor="#eef7ee"; color="#2e8b57"; fontsize=12; fontcolor="#1d5c39";
    L_SECR   [label="Adipocyte leptin secretion\n∝ fat mass x adipocyte size\n(SC ≫ visceral per gram)", fillcolor="#e2f0e2"];
    L_PLASMA [label="Plasma leptin\nCGL 0.5-2 · FPLD 4-12 ·\nnormal F 10-15 · obesity 30-80 ng/mL", fillcolor="#e2f0e2", penwidth=2.0, color="#1d5c39"];
    L_BBB    [label="Transport across median eminence /\ntanycytes (saturable)", fillcolor="#e2f0e2"];
    L_LEPRB  [label="LepR-b (ARC, VMH, DMH, NTS)\nJAK2 → STAT3 → SOCS3", fillcolor="#e2f0e2"];
    L_TRANS  [label="TRANSDUCER  S(L) = L^h/(L^h + EC50^h)\nEC50 ≈ 4 ng/mL, h ≈ 2\n→ SATURATES above ~10 ng/mL", fillcolor="#e2f0e2", penwidth=2.4, color="#1d5c39"];
    L_DEFICIT[label="SIGNAL DEFICIT  Δ = 1 − S(L_baseline)\nCGL Δ ≈ 0.85-0.95\nFPLD (leptin 9) Δ ≈ 0.16\n— a PATIENT property, not a dose property", fillcolor="#ecebe4", penwidth=2.4, color="#1d5c39"];
    L_POMC   [label="ARC POMC/CART neurons\n(activated by leptin) → α-MSH", fillcolor="#e2f0e2"];
    L_AGRP   [label="ARC NPY/AgRP neurons\n(inhibited by leptin)", fillcolor="#e2f0e2"];
    L_MC4R   [label="PVN MC4R signalling\n→ satiety, energy expenditure", fillcolor="#e2f0e2"];
    L_HYPER  [label="HYPERPHAGIA\nEI = EI0 · (1 + Hmax·Δ)\n— the deficit feeding the capacity problem", fillcolor="#e2f0e2", penwidth=2.2, color="#1d5c39"];
    L_REWARD [label="Mesolimbic VTA/NAcc reward\n(food salience, food-cue fMRI)", fillcolor="#e2f0e2"];
    L_SNS    [label="Sympathetic outflow, BAT tone,\nresting energy expenditure", fillcolor="#e2f0e2"];
    L_HPT    [label="TRH → TSH → T3\n(leptin-permissive)", fillcolor="#e2f0e2"];
    L_KISS   [label="Kisspeptin → GnRH pulse generator\n(leptin-permissive for reproduction)", fillcolor="#e2f0e2"];
    L_PERIPH [label="DIRECT peripheral leptin actions\nFA oxidation ↑ · SREBP-1c/DNL ↓ ·\ninsulin sensitisation.\nNOT a primary VLDL inhibition — that\ndraft predicted the clamp would make\nsteatosis worse, so it was discarded", fillcolor="#e2f0e2", penwidth=2.0, color="#1d5c39"];
    L_IMMUNE [label="Leptin as immune permissive factor\n(T-cell function, thymic mass)", fillcolor="#e2f0e2"];
    L_SOCS   [label="SOCS3 / PTP1B negative feedback\n(the transducer's own brake —\nthe reason obesity is leptin-resistant)", fillcolor="#e2f0e2"];
  }

  /* =====================================================================
     8. ADIPONECTIN AND OTHER ADIPOKINES
     ===================================================================== */
  subgraph cluster_adipok {
    label="8 · Other adipokines (a second, non-replaceable endocrine loss)";
    style="rounded,filled"; fillcolor="#eef7f4"; color="#20b2aa"; fontsize=12; fontcolor="#12756f";
    K_ADIPO  [label="Adiponectin (HMW multimers)\nlow in GL and FPLD\n(no replacement therapy exists)", fillcolor="#ddf1ee"];
    K_ADIPOR [label="AdipoR1/R2 → AMPK, ceramidase\n→ hepatic FA oxidation ↑,\nceramide ↓", fillcolor="#ddf1ee"];
    K_FGF21  [label="FGF21 (hepatic, stress-induced)\nelevated; adipose target tissue\nis missing → FGF21 resistance", fillcolor="#ddf1ee"];
    K_INFL   [label="Adipose-tissue macrophage /\nIL-6, TNFα, MCP-1\n(from hypertrophic residual depots)", fillcolor="#fadadd"];
    K_C3NEF  [label="C3 nephritic factor / low C3\n(acquired partial lipodystrophy)\n→ adipocyte lysis + MPGN", fillcolor="#fadadd"];
  }

  /* =====================================================================
     9. INSULIN SIGNALLING AND RESISTANCE
     ===================================================================== */
  subgraph cluster_insig {
    label="9 · Insulin signalling: ectopic-lipid-driven resistance and its SELECTIVITY";
    style="rounded,filled"; fillcolor="#eef4fb"; color="#4a90b8"; fontsize=12; fontcolor="#1f5c7a";
    I_IRS    [label="IR → IRS-1/2 → PI3K → AKT2\n(canonical cascade)", fillcolor="#dfeef7"];
    I_SER    [label="IRS-1 Ser³⁰⁷/Ser¹¹⁰¹ phosphorylation\n(PKCε/θ, JNK, S6K1) → cascade\nuncoupling", fillcolor="#dfeef7"];
    I_GLUT4  [label="GLUT4 translocation ↓\n→ muscle glucose disposal ↓", fillcolor="#dfeef7"];
    I_HGP    [label="Hepatic glucose production\n(FoxO1 → PEPCK/G6Pase)\nfails to be suppressed", fillcolor="#dfeef7"];
    I_SELECT [label="SELECTIVE hepatic insulin resistance\ngluconeogenesis resistant BUT\nSREBP-1c/DNL still stimulated\n→ hyperglycaemia AND hyperlipogenesis", fillcolor="#dfeef7", penwidth=2.2, color="#1f5c7a"];
    I_IRINDEX[label="Insulin resistance index\nIR = 1 + a·HFF + b·IMCL − c·S(L) − d·Adipo", fillcolor="#dfeef7", penwidth=2.0, color="#1f5c7a"];
    I_ACANTH [label="Acanthosis nigricans / skin tags\n(IGF-1R crosstalk of extreme\nhyperinsulinaemia)", fillcolor="#fadadd"];
    I_HYPINS [label="Compensatory hyperinsulinaemia\n(often >100 µU/mL; U-500 insulin\nrequirements >200 U/d)", fillcolor="#dfeef7"];
  }

  /* =====================================================================
     10. GLUCOSE HOMEOSTASIS, BETA CELL, HbA1c
     ===================================================================== */
  subgraph cluster_gluc {
    label="10 · Glucose homeostasis, beta-cell trajectory and HbA1c";
    style="rounded,filled"; fillcolor="#f0f6fc"; color="#3a7ca5"; fontsize=12; fontcolor="#1f4f6e";
    U_GLUC   [label="Plasma glucose\n(fasting + postprandial)", fillcolor="#dfeef7"];
    U_BCELL  [label="Beta-cell functional mass\n(compensation → decompensation)", fillcolor="#dfeef7"];
    U_LIPOTX [label="Islet lipotoxicity + glucotoxicity\n(ceramide, ER stress, oxidative)", fillcolor="#fadadd"];
    U_ISEC   [label="Insulin secretion rate", fillcolor="#dfeef7"];
    U_A1C    [label="HbA1c (RBC-lifespan integrator,\nτ ≈ 35 d)", fillcolor="#d7e9ff", penwidth=2.0, color="#1f4f6e"];
    U_DKA    [label="Diabetic ketoacidosis risk\n(low, insulin present; raised by\nSGLT2i)", fillcolor="#ffd9d9"];
    U_HYPO   [label="Hypoglycaemia\n(metreleptin + insulin/SU:\nrequirement falls fast)", fillcolor="#ffd9d9"];
  }

  /* =====================================================================
     11. LIVER — steatosis → steatohepatitis → fibrosis
     ===================================================================== */
  subgraph cluster_liver {
    label="11 · Liver: steatosis → steatohepatitis → fibrosis (the irreversible arm)";
    style="rounded,filled"; fillcolor="#f7f2ea"; color="#a0793d"; fontsize=12; fontcolor="#6b4f21";
    H_TG     [label="Hepatocyte TG pool\n(HFF often 20-40% in GL)", fillcolor="#efe4d4"];
    H_VLDL   [label="VLDL1-TG secretion\n(substrate-driven, APOB100)", fillcolor="#efe4d4"];
    H_OX     [label="Hepatic FA β-oxidation\n(PPARα, CPT1; capacity-limited)", fillcolor="#efe4d4"];
    H_ROS    [label="Lipotoxic stress: ER stress,\nmitochondrial ROS, JNK", fillcolor="#fadadd"];
    H_ALT    [label="ALT / AST release\n(hepatocyte injury marker)", fillcolor="#efe4d4"];
    H_KUPF   [label="Kupffer / recruited macrophage\nactivation → TNFα, IL-1β", fillcolor="#fadadd"];
    H_HSC    [label="Hepatic stellate cell activation\n(TGF-β1, PDGF) → collagen I/III", fillcolor="#efe4d4"];
    H_FIB    [label="Fibrosis stage F0→F4\n(slow, partially irreversible)", fillcolor="#efe4d4", penwidth=2.0, color="#6b4f21"];
    H_CIRR   [label="Cirrhosis · portal hypertension ·\nHCC (leading cause of death in CGL)", fillcolor="#ffd9d9"];
    H_HEPMEG [label="Hepatomegaly / splenomegaly", fillcolor="#efe4d4"];
    H_STIFF  [label="Liver stiffness (VCTE kPa) /\nFIB-4 · ELF", fillcolor="#d7e9ff"];
  }

  /* =====================================================================
     12. PLASMA LIPIDS AND PANCREATITIS
     ===================================================================== */
  subgraph cluster_tg {
    label="12 · Plasma lipids: chylomicronaemia and the pancreatitis threshold";
    style="rounded,filled"; fillcolor="#fdf3ee"; color="#e07b39"; fontsize=12; fontcolor="#8f4a13";
    T_TG     [label="Plasma triglyceride\n(GL often 500-5000 mg/dL;\nrefractory to statins)", fillcolor="#fdeae0", penwidth=2.0, color="#8f4a13"];
    T_CM     [label="Chylomicronaemia\n(LPL saturated: production >\nclearance capacity)", fillcolor="#fdeae0"];
    T_HDL    [label="HDL-C low · small dense LDL ·\nremnant cholesterol high", fillcolor="#fdeae0"];
    T_XANTH  [label="Eruptive xanthomata ·\nlipaemia retinalis", fillcolor="#fadadd"];
    T_PANC   [label="Acute pancreatitis\nhazard rises steeply\nabove TG ≈ 1000-2000 mg/dL", fillcolor="#ffd9d9", penwidth=2.0, color="#8f4a13"];
    T_TIME   [label="Time-above-threshold\n(the endpoint that matters —\nnot mean TG)", fillcolor="#d7e9ff"];
    T_APHER  [label="Plasmapheresis / apheresis\n(rescue in TG crisis)", fillcolor="#d9f2e6"];
  }

  /* =====================================================================
     13. CARDIOVASCULAR
     ===================================================================== */
  subgraph cluster_cv {
    label="13 · Cardiovascular consequences";
    style="rounded,filled"; fillcolor="#fdeff1"; color="#c2185b"; fontsize=12; fontcolor="#7a0f38";
    C_HTN    [label="Hypertension\n(severe and early in FPLD3/PPARG)", fillcolor="#fadadd"];
    C_HCM    [label="Concentric LV hypertrophy /\nHCM phenotype (CGL)", fillcolor="#fadadd"];
    C_DIAST  [label="Diastolic dysfunction\n(myocardial steatosis)", fillcolor="#fadadd"];
    C_ARR    [label="Arrhythmia / long QT\n(CAVIN1-CGL4)", fillcolor="#fadadd"];
    C_LAMDCM [label="Laminopathic conduction disease /\nDCM (LMNA)", fillcolor="#fadadd"];
    C_ATH    [label="Premature atherosclerosis\n(remnants + IR + HTN)", fillcolor="#fadadd"];
    C_MACE   [label="MACE / CV mortality", fillcolor="#d7e9ff"];
  }

  /* =====================================================================
     14. RENAL
     ===================================================================== */
  subgraph cluster_renal {
    label="14 · Renal involvement";
    style="rounded,filled"; fillcolor="#f0f4f8"; color="#607d8b"; fontsize=12; fontcolor="#37474f";
    R_HYPER  [label="Glomerular hyperfiltration\n(hyperinsulinaemia, hyperglycaemia)", fillcolor="#dfeef7"];
    R_PROT   [label="Proteinuria / albuminuria\n(common and early in CGL)", fillcolor="#dfeef7"];
    R_FSGS   [label="FSGS / diabetic-pattern\nglomerulosclerosis; podocyte\nlipotoxicity", fillcolor="#fadadd"];
    R_MPGN   [label="MPGN / C3 glomerulopathy\n(acquired partial only)", fillcolor="#fadadd"];
    R_CKD    [label="eGFR decline → CKD", fillcolor="#d7e9ff"];
  }

  /* =====================================================================
