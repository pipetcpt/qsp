digraph CPP_QSP {
  rankdir=LR;
  newrank=true;          /* global ranking: required for this cluster/edge topology */
  compound=true;
  fontname="Helvetica";
  labelloc="t";
  label="Central Precocious Puberty (CPP) — Mechanistic QSP Map\nKNDy Pulse Generator Disinhibition (MKRN3/DLK1 loss) → GnRH Pulse FREQUENCY ↑ → LH/FSH → Gonadal Steroids\nTHE CENTRAL TENSION: oestradiol enters the adult-height integral TWICE WITH OPPOSITE SIGNS\n(+) raises growth velocity via GH/IGF-1 amplification   (−) consumes growth-plate proliferative reserve → epiphyseal fusion\nTherapy: GnRH agonist depots/implant (pulsatility destroyed, NOT axis ablated) · GnRH antagonist · aromatase inhibitors · rhGH add-on · anti-oestrogens for GnRH-INDEPENDENT disease";
  node [style=filled, fontname="Helvetica", fontsize=10, shape=box, fillcolor="#ffffff"];
  edge [fontname="Helvetica", fontsize=8];

  /* =======================================================================
     1. GENETIC / EPIGENETIC SET-POINT — the brake, not the accelerator
     Human puberty is held CLOSED by active inhibition. CPP in most
     monogenic cases is LOSS OF A BRAKE (MKRN3, DLK1), not gain of a drive.
     ======================================================================= */
  subgraph cluster_genetic {
    label="1. Genetic / Epigenetic Set-Point — puberty is RESTRAINED, and CPP is usually a lost brake";
    style=filled; color="#d8c9e8"; fillcolor="#f2ecf9";
    MKRN3 [label="★ MKRN3 (15q11.2)\nimprinted, PATERNALLY expressed\nubiquitin ligase = BRAKE on GnRH\nLoF → commonest monogenic CPP", fillcolor="#e3cdea", penwidth=2];
    MKRN3_decline [label="Physiological MKRN3 protein\nDECLINE before puberty\n(permissive de-repression)"];
    DLK1 [label="DLK1 (14q32, imprinted)\nNotch-pathway brake\nLoF → CPP + central obesity"];
    KISS1 [label="KISS1 (1q32)\nkisspeptin-54 precursor"];
    KISS1R [label="KISS1R / GPR54 (19p13)\nactivating p.Arg386Pro → CPP\nLoF → hypogonadotropic hypogonadism"];
    TAC3 [label="TAC3 → neurokinin B (NKB)\nautocrine ACCELERATOR of KNDy"];
    TACR3 [label="TACR3 (NK3R)\nNKB receptor on KNDy"];
    PDYN [label="PDYN → dynorphin A\nautocrine BRAKE (κ-opioid)\nsets inter-pulse interval"];
    OPRK1 [label="OPRK1 (κ-opioid receptor)\non KNDy dendrons"];
    LIN28B [label="LIN28B / let-7 axis\nGWAS menarche-timing locus"];
    MECP2_PROK2 [label="Other loci: PROK2, PROKR2,\nMECP2, NPVF, KDM6A"];
    Epigenetic_PcG [label="Polycomb (EED/CBX7) →\nTrithorax switch on Kiss1 promoter\n(Lomniczi/Ojeda)"];
    Imprint_loss [label="Loss of imprinting /\nmaternal-allele silencing\n(MKRN3, DLK1)"];
    Familial_hx [label="Familial CPP\n~27.5% autosomal dominant\nwith incomplete penetrance"];
    Sex_bias [label="Sex bias ~10:1 female\n(girls 1:5,000-10,000)"];
    Adoption_intl [label="International adoption\n(catch-up growth → RR ↑ 10-20×)"];
    Genetic_setpoint [label="★ GENETIC PUBERTAL SET-POINT\n(≈60-80% of menarche-timing variance)", fillcolor="#e3cdea", penwidth=2];
  }

  /* =======================================================================
     2. METABOLIC / ENVIRONMENTAL GATING — the permissive signal
     ======================================================================= */
  subgraph cluster_environment {
    label="2. Metabolic & Environmental Gating — permissive, not causal";
    style=filled; color="#c9dfc9"; fillcolor="#eef7ee";
    Adiposity [label="Adipose mass / BMI-Z\n(secular ↑ → earlier thelarche)"];
    Leptin [label="Leptin\nPERMISSIVE metabolic signal\n(no leptin → no puberty)"];
    LEPR_ARC [label="LepR on ARC neurons\n(indirect: via GABA/POMC,\nNOT directly on KNDy)"];
    Insulin_env [label="Insulin / insulin resistance\n(SHBG ↓ → free steroid ↑)"];
    IGF1_perm [label="Nutritional IGF-1 tone"];
    Ghrelin [label="Ghrelin (inhibitory)"];
    Melatonin [label="Melatonin / photoperiod\n(pineal, inhibitory tone)"];
    Sleep_arch [label="Sleep architecture\nsleep-entrained LH pulses\n(earliest pubertal sign)"];
    EDC [label="Endocrine-disrupting chemicals\nBPA, phthalates, DDE,\nlavender/tea-tree oil"];
    Psychosocial_stress [label="Early psychosocial adversity\nabsent father, stress"];
    Vitamin_D [label="Vitamin D status"];
    Gut_micro [label="Gut microbiome / SCFA"];
    Preterm_SGA [label="SGA / preterm birth\n+ rapid postnatal catch-up"];
  }

  /* =======================================================================
     3. KNDy PULSE GENERATOR (arcuate nucleus) — the true oscillator
     THE STATE VARIABLE IS FREQUENCY, NOT CONCENTRATION.
     ======================================================================= */
  subgraph cluster_kndy {
    label="3. KNDy Pulse Generator (arcuate nucleus) — the oscillator whose OUTPUT IS A FREQUENCY";
    style=filled; color="#f0d5b8"; fillcolor="#fdf1e4";
    KNDy_neuron [label="★ KNDy neuron population\n(Kisspeptin + NKB + Dynorphin\nco-expressing, ARC)", fillcolor="#f8d9b0", penwidth=2];
    NKB_release [label="NKB release\n(auto-excitation → pulse ONSET)"];
    Dyn_release [label="Dynorphin release\n(auto-inhibition → pulse TERMINATION)"];
    Kiss_release [label="Kisspeptin-10/54 release\n(the OUTPUT signal to GnRH)"];
    Pulse_freq [label="★ GnRH PULSE FREQUENCY\nprepubertal ~1/3-4 h (nocturnal only)\nadult ~1/60-90 min", fillcolor="#f8c98f", penwidth=2];
    Pulse_amp [label="GnRH pulse amplitude"];
    Nocturnal_gate [label="Nocturnal gating\n(sleep-entrained pulses first)"];
    AVPV_Kiss [label="AVPV/POA kisspeptin\n(E2-POSITIVE feedback,\nsurge generator, female-specific)"];
    GABA_tone [label="GABA-A/B inhibitory tone\n(juvenile brake)"];
    Glutamate_tone [label="Glutamatergic (NMDA/kainate)\nexcitatory drive"];
    NPY_tone [label="NPY / AgRP restraint"];
    RFRP3 [label="RFRP-3 (GnIH)\ninhibitory"];
    Astro_glia [label="Astrocytic/tanycyte plasticity\n(erbB, TGF-α, PGE2)"];
    Hypothal_lesion [label="Organic CNS lesions:\nhypothalamic hamartoma,\noptic glioma/NF1, hydrocephalus,\ncranial irradiation, TBI"];
    Hamartoma_ectopic [label="Hamartoma = ectopic\nGnRH/TGF-α source\n(bypasses the brake entirely)"];
  }

  /* =======================================================================
     4. GnRH NEURON & PORTAL DELIVERY
     ======================================================================= */
  subgraph cluster_gnrh {
    label="4. GnRH Neuron → Median Eminence → Portal Delivery";
    style=filled; color="#f5cccc"; fillcolor="#fdeeee";
    GnRH_neuron [label="GnRH neuron (~2000 cells,\nolfactory-placode derived)"];
    GnRH_synth [label="GnRH decapeptide synthesis\n(GNRH1)"];
    ME_terminal [label="Median-eminence terminals\n(outside BBB)"];
    Portal_GnRH [label="★ Hypophysial-portal GnRH\nPULSE TRAIN (t½ 2-4 min)", fillcolor="#f6b8b8", penwidth=2];
    GnRH_deg [label="Rapid peptidase degradation\n(EP24.15, t½ 2-4 min)\n→ why native GnRH is useless as a drug"];
    Kiss1R_GnRH [label="KISS1R on GnRH neuron\n(Gq → PLC → depolarisation)"];
  }

  /* =======================================================================
     5. PITUITARY GONADOTROPE — where agonists actually act
     ======================================================================= */
  subgraph cluster_pituitary {
    label="5. Pituitary Gonadotrope — receptor occupancy vs PULSATILITY DECODING (the site of GnRHa action)";
    style=filled; color="#cdd9f0"; fillcolor="#e9eefb";
    GnRHR_surface [label="★ GnRHR available at surface\n(sensitised, coupled pool)", fillcolor="#b9c9ec", penwidth=2];
    GnRHR_desens [label="★ GnRHR desensitised /\ninternalised pool\n(β-arrestin, no Type-II C-tail\n→ slow, incomplete recycling)", fillcolor="#b9c9ec", penwidth=2];
    Gq_PLC [label="Gq/11 → PLC-β → IP3/DAG\n→ Ca²⁺ / PKC"];
    ERK_EGR1 [label="ERK1/2 → EGR1\n(LHB transcription)"];
    Pulse_decoder [label="★ PULSATILITY DECODER\nfast pulses → LHB\nslow pulses → FSHB\nCONTINUOUS → NEITHER", fillcolor="#a8bce8", penwidth=2];
    LH_synth [label="LHB synthesis / storage"];
    FSH_synth [label="FSHB synthesis (constitutive-leaning)"];
    LH_plasma [label="★ Plasma LH (IU/L)\nbasal <0.3 prepubertal\npeak >5 on GnRH stim = CENTRAL", fillcolor="#b9c9ec", penwidth=2];
    FSH_plasma [label="Plasma FSH (IU/L)"];
    LH_FSH_ratio [label="LH:FSH ratio >0.66 on stim\n(central activation index)"];
    Glyco_variant [label="Glycosylation / bioactivity\n(sialylation → t½)"];
    Free_alpha [label="Free α-subunit"];
    Flare_surge [label="★ ACUTE AGONIST FLARE\nLH/FSH surge over days 0-7,\nthen down-regulation", fillcolor="#f4b183", penwidth=2];
  }

  /* =======================================================================
     6. OVARY (girls) — dominant phenotype
     ======================================================================= */
  subgraph cluster_ovary {
    label="6. Ovary — Folliculogenesis, Aromatisation, Oestradiol Output";
    style=filled; color="#f0cde0"; fillcolor="#fdeef6";
    Follicle_pool [label="Antral follicle pool\n(FSH-recruited)"];
    Granulosa [label="Granulosa cells\n(FSHR → cAMP)"];
    Theca [label="Theca cells (LHR)\n→ androstenedione"];
    CYP19A1_ov [label="★ Ovarian aromatase CYP19A1\n(A'dione → oestrone → E2)", fillcolor="#f4c2dc", penwidth=2];
    E2 [label="★ OESTRADIOL (E2, pg/mL)\nprepubertal <10 → pubertal 30-80\nTHE DOUBLE-SIGNED DRIVER", fillcolor="#f19cc8", penwidth=2];
    Estrone [label="Oestrone (E1)"];
    Inhibin_B [label="Inhibin B\n(FSH-selective feedback)"];
    AMH_ov [label="AMH (falls with recruitment)"];
    Ovarian_vol [label="Ovarian volume >1-3 mL\n+ multifollicular pattern"];
    Progesterone_ov [label="Progesterone\n(only after ovulatory cycles)"];
    Cyst_MAS [label="Autonomous ovarian cyst\n(McCune-Albright)"];
  }

  /* =======================================================================
     7. TESTIS (boys) — 10% of CPP but higher organic-lesion rate
     ======================================================================= */
  subgraph cluster_testis {
    label="7. Testis (boys ~10% of CPP; ~40-75% have an organic CNS cause)";
    style=filled; color="#cde5f0"; fillcolor="#eaf6fb";
    Leydig [label="Leydig cells (LHR)\n→ testosterone"];
    Sertoli [label="Sertoli cells (FSHR)\n→ inhibin B, AMH ↓"];
    Testosterone [label="Testosterone (ng/dL)\n→ virilisation, muscle, voice"];
    DHT [label="DHT (SRD5A2)\n→ genital, sexual hair, acne"];
    CYP19A1_periph [label="Peripheral aromatase\n(adipose, bone, brain)\nT → E2"];
    Testis_vol [label="Testicular volume >4 mL /\n>2.5 cm = central activation"];
    AMH_testis [label="AMH (falls with\nintratesticular T rise)"];
  }

  /* =======================================================================
     8. ADRENAL ANDROGEN AXIS — a SEPARATE clock, NOT suppressed by GnRHa
     ======================================================================= */
  subgraph cluster_adrenal {
    label="8. Adrenarche — an INDEPENDENT axis: pubic hair progresses ON therapy (a counselling trap)";
    style=filled; color="#e8e0c0"; fillcolor="#f9f6e8";
    ACTH_ad [label="ACTH"];
    ZR_maturation [label="Zona reticularis maturation\n(CYB5A ↑, HSD3B2 ↓)"];
    DHEAS [label="DHEA / DHEAS\n(adrenarche, age 6-8)"];
    Androstenedione_ad [label="Androstenedione (adrenal)"];
    Pubic_hair [label="Pubarche / axillary hair / odour\nNOT GnRHa-suppressible", fillcolor="#f2e6b8"];
    CAH_21OH [label="21-hydroxylase deficiency (CAH)\n→ GnRH-INDEPENDENT androgen\n(then secondary TRUE CPP)"];
    Adrenal_tumour [label="Adrenal androgen-secreting tumour"];
  }

  /* =======================================================================
     9. GnRH-INDEPENDENT (PERIPHERAL) PRECOCIOUS PUBERTY — the anti-target
     ======================================================================= */
  subgraph cluster_peripheral {
    label="9. GnRH-INDEPENDENT (Peripheral) Precocious Puberty — where a GnRH agonist is STRUCTURALLY USELESS";
    style=filled; color="#e0c0c0"; fillcolor="#f7eaea";
    GNAS_MAS [label="★ GNAS p.Arg201 mosaic\n(McCune-Albright)\nconstitutive Gsα → cAMP\nWITHOUT LH", fillcolor="#e8b4b4", penwidth=2];
    Autonomous_E2 [label="Autonomous gonadal E2\n(LH-independent → GnRHa\ncannot reach it)", fillcolor="#e8b4b4"];
    hCG_tumour [label="hCG-secreting tumour\n(germinoma, hepatoblastoma)\ncross-reacts at LHR"];
    Fibrous_dysplasia [label="Polyostotic fibrous dysplasia\n+ café-au-lait"];
    Exogenous_steroid [label="Exogenous oestrogen/androgen\n(creams, supplements)"];
    Testotoxicosis [label="Familial male-limited PP\n(LHCGR activating)"];
    Secondary_central [label="Secondary TRUE CPP\n(peripheral steroids advance BA\n→ the central brake then releases)"];
  }

  /* =======================================================================
     10. GH–IGF-1 AXIS — the (+) sign of oestradiol
     ======================================================================= */
  subgraph cluster_gh {
    label="10. GH–IGF-1 Axis — sex steroids AMPLIFY it (this is the (+) term in the height integral)";
    style=filled; color="#c0dcd0"; fillcolor="#eaf6f0";
    GHRH [label="GHRH (ARC)"];
    SST [label="Somatostatin (PeVN)"];
    GH_pulse [label="★ GH pulse amplitude\n(~×2-3 at mid-puberty,\nE2-dose-dependent)", fillcolor="#b2dcc8", penwidth=2];
    IGF1 [label="★ IGF-1 (hepatic + local)\npeaks at Tanner 3-4", fillcolor="#b2dcc8", penwidth=2];
    IGFBP3 [label="IGFBP-3 / ALS ternary complex"];
    IGF1R_plate [label="IGF-1R on proliferative\nchondrocytes"];
    GH_direct [label="Direct GHR action on\nresting-zone chondrocytes"];
    Growth_velocity [label="★ GROWTH VELOCITY (cm/yr)\nprepubertal 5-6 → peak 8-10\nON GnRHa: falls to 3-5", fillcolor="#9dd3ba", penwidth=2];
    PHV [label="Peak height velocity\n(girls Tanner 2-3, EARLY;\nboys Tanner 3-4, LATE)"];
  }

  /* =======================================================================
     11. GROWTH PLATE — the (−) sign of oestradiol. THE IRREVERSIBLE CLOCK.
     ======================================================================= */
  subgraph cluster_plate {
    label="11. Epiphyseal Growth Plate — SENESCENCE IS A CONSUMED RESERVE, NOT A TIME (the (−) term; irreversible)";
    style=filled; color="#d0c0e0"; fillcolor="#f0eaf8";
    Resting_zone [label="Resting (stem) zone\nchondrocytes"];
    Prolif_zone [label="Proliferative zone\n(clonal expansion)"];
    Hypertroph_zone [label="Hypertrophic zone\n(cell enlargement = most of\nthe elongation)"];
    GP_reserve [label="★ GROWTH-PLATE PROLIFERATIVE\nRESERVE (GPRES 1 → 0)\nCONSUMED by cumulative E2 exposure,\nNEVER regenerated", fillcolor="#c3aede", penwidth=2];
    Senescence [label="Growth-plate senescence\n(Nilsson & Baron: reserve is\nspent by divisions, not clock time)"];
    ERa_plate [label="ERα (ESR1) on chondrocytes\n+ LOCAL aromatase"];
    Aromatase_plate [label="Local CYP19A1 in growth plate\n(→ why AI works in boys)"];
    Fusion [label="★ EPIPHYSEAL FUSION\n(oestrogen-DEPENDENT in both sexes:\nESR1 & CYP19A1 LoF → no fusion,\ncontinued growth into adulthood)", fillcolor="#c3aede", penwidth=2];
    Bone_age [label="★ BONE AGE (BA, years)\nGreulich-Pyle / TW3\nADVANCES with E2, NEVER REVERSES", fillcolor="#b39ad6", penwidth=2];
    BA_CA_ratio [label="★ ΔBA/ΔCA RATIO\nCPP untreated 1.5-2.5\non GnRHa → 0.3-0.6\nTHE correct monitoring endpoint", fillcolor="#b39ad6", penwidth=2];
    Remaining_growth [label="Remaining growth potential\n= f(BA) — Bayley-Pinneau table\n(≈ the LIMIT of the integral)"];
    Sitting_height [label="Sitting height / leg-length\nsegment disproportion"];
  }

  /* =======================================================================
     12. BONE MASS ACCRUAL — the safety axis of E2 withdrawal
     ======================================================================= */
  subgraph cluster_bone {
    label="12. Bone Mass Accrual — GnRHa withdraws E2 DURING the peak-accrual window";
    style=filled; color="#c8d8e8"; fillcolor="#edf3f9";
    Osteoblast [label="Osteoblast / RUNX2"];
    Osteoclast [label="Osteoclast / RANKL:OPG"];
    Sclerostin [label="Sclerostin / Wnt-β-catenin"];
    BMD_LS [label="★ Lumbar-spine aBMD Z-score\n(dips ON therapy, recovers after)", fillcolor="#b7cbe0", penwidth=2];
    Peak_bone_mass [label="Peak bone mass (age ~19-20)\n— the endpoint that matters"];
    Ca_VitD [label="Calcium + vitamin D\n+ weight-bearing exercise\n(mitigation)"];
    CTX_P1NP [label="CTX / P1NP turnover markers"];
  }

  /* =======================================================================
     13. TARGET TISSUES & TANNER STAGING
     ======================================================================= */
  subgraph cluster_target {
    label="13. Secondary Sexual Development — the examined phenotype";
    style=filled; color="#f0d8e8"; fillcolor="#fdf0f7";
    Breast_bud [label="★ Thelarche / Tanner breast B1→B5\n(B2 <8 y = precocious in girls)", fillcolor="#f5c6de"];
    Uterus_vol [label="★ Uterine volume (mL) / length\n>3.4 mL or >34 mm = oestrogenised\n(a monitoring surrogate for E2)", fillcolor="#f5c6de"];
    Endometrial_echo [label="Endometrial echo\n(→ withdrawal bleeding risk)"];
    Vaginal_mucosa [label="Vaginal mucosa oestrogenisation\n/ physiological leucorrhoea"];
    Menarche [label="★ MENARCHE\nCPP untreated ~9-10 y;\npost-GnRHa ~1.0-1.5 y after stop", fillcolor="#f5c6de"];
    Acne_odour [label="Acne, sebum, body odour\n(androgen-driven)"];
    Voice_muscle [label="Voice break, muscle mass (boys)"];
  }

  /* =======================================================================
     14. DRUG PK — GnRH ANALOGUE FORMULATIONS (the real design space)
     ======================================================================= */
  subgraph cluster_pk_gnrha {
    label="14. GnRH-Analogue PK — the clinically decisive axis is TROUGH COVERAGE, not potency";
    style=filled; color="#f5e0b8"; fillcolor="#fdf6e6";
    Leup_1m [label="Leuprolide acetate depot IM\n3.75 / 7.5 mg q28d\n(PLGA microspheres: burst + slow)"];
    Leup_3m [label="Leuprolide depot IM\n11.25 / 30 mg q12wk"];
    Leup_6m_SC [label="Leuprolide 45 mg SC q24wk\n(Fensolvi; ATRIGEL depot)"];
    Trip_3m [label="Triptorelin pamoate\n11.25 mg q12wk / 22.5 mg q24wk"];
    Hist_implant [label="★ Histrelin 50 mg subdermal implant\nZERO-ORDER ~65 µg/day, 12 mo\n(no trough, no burst)", fillcolor="#f7d999", penwidth=2];
    Nafarelin_nasal [label="Nafarelin nasal spray\n1600-1800 µg/day in 2-3 doses\n(ADHERENCE-limited)"];
    Depot_burst [label="Depot BURST fraction\n(→ the flare)"];
    Depot_slow [label="Depot slow-release fraction\n(first-order dissolution)"];
    Plasma_analog [label="★ Plasma analogue conc.\n(sustained, NON-pulsatile\n= the therapeutic principle)", fillcolor="#f7d999", penwidth=2];
    Analog_potency [label="Analogue potency /\nreceptor affinity\n(D-aa substitutions, no EP24.15 site)"];
    Interdose_escape [label="★ INTERDOSE ESCAPE\n(late-cycle trough → LH >4 IU/L)\nthe failure mode of monthly depots", fillcolor="#f4b183", penwidth=2];
    Adherence [label="Adherence / injection\nintervals in real practice"];
  }

  /* =======================================================================
     15. OTHER DRUG CLASSES
     ======================================================================= */
  subgraph cluster_pk_other {
    label="15. Other Pharmacology — antagonists, aromatase inhibitors, rhGH, anti-oestrogens, anti-androgens";
    style=filled; color="#d8e8c0"; fillcolor="#f2f8e8";
    GnRH_antag [label="★ GnRH ANTAGONIST\n(degarelix/elagolix class)\ncompetitive: NO FLARE,\nimmediate suppression", fillcolor="#cfe4a8", penwidth=2];
    Anastrozole [label="Anastrozole 1 mg/day PO\n(non-steroidal AI)"];
    Letrozole [label="Letrozole 2.5 mg/day PO\n(more potent AI)"];
    AI_effect [label="★ AROMATASE INHIBITION\nblocks E2 WITHOUT blocking T\n→ separates the two E2 signs", fillcolor="#cfe4a8", penwidth=2];
    rhGH [label="rhGH 0.3 mg/kg/wk SC\n(add-on when PAH already low)"];
    Tamoxifen [label="Tamoxifen (SERM)\nMcCune-Albright"];
    Fulvestrant [label="Fulvestrant (SERD)\nMcCune-Albright"];
    Bicalutamide [label="Bicalutamide + AI\n(familial male-limited PP)"];
    Ketoconazole [label="Ketoconazole\n(steroidogenesis inhibitor)"];
    Cyproterone [label="Cyproterone acetate\n(historical)"];
    Oxandrolone [label="Oxandrolone (boys, historical)"];
    Kiss_antag [label="Kisspeptin/NK3R antagonists\n(investigational, upstream)"];
  }

  /* =======================================================================
     16. CNS / PSYCHOSOCIAL
     ======================================================================= */
  subgraph cluster_cns {
    label="16. CNS, Behaviour & Psychosocial — the reason to treat when height is not at stake";
    style=filled; color="#e0d8f0"; fillcolor="#f4f1fb";
    Sex_steroid_CNS [label="Sex-steroid action on\namygdala / PFC / HPA"];
    Emotional_lability [label="Emotional lability, mood swings"];
    Body_image [label="Body-image distress,\nsocial stigma, teasing"];
    Early_sexual [label="Early sexual debut / risk\nof abuse & exploitation"];
    Cognitive [label="Cognition / school performance\n(no consistent GnRHa effect)"];
    QoL [label="★ Psychosocial distress index\n(an endpoint in its own right)", fillcolor="#ddd2f0"];
    Vasomotor_tx [label="Hot flushes on GnRHa\n(oestrogen-deprivation symptom)"];
  }

  /* =======================================================================
     17. ADVERSE EFFECTS & SAFETY
     ======================================================================= */
  subgraph cluster_safety {
    label="17. Adverse Effects & Safety Signals";
    style=filled; color="#f0c8c8"; fillcolor="#fdeaea";
    Withdrawal_bleed [label="Withdrawal bleeding\n~5-10% after 1st depot\n(the visible face of the flare)"];
    Sterile_abscess [label="Sterile abscess / injection-site\nreaction (leuprolide ~3-10%)"];
    Implant_break [label="Implant breakage / difficult\nexplantation (histrelin)"];
    Weight_gain [label="Weight/BMI-Z gain on therapy\n(inconsistent)"];
    PTC [label="Pseudotumour cerebri\n(rare, FDA signal 2022)"];
    Seizure_signal [label="Seizure signal (FDA 2017)"];
    Slipped_epiphysis [label="Slipped capital femoral\nepiphysis (rare)"];
    Anaphylaxis [label="Hypersensitivity / anaphylaxis (rare)"];
    Fertility_later [label="Fertility: normal in follow-up\ncohorts (Lazar, Heger)"];
    PCOS_later [label="PCOS prevalence not increased\nby treatment (~ same as untreated CPP)"];
    Metab_later [label="Adult BMI / metabolic outcome\n(driven by CPP, not by GnRHa)"];
    BrCa_risk [label="Adult breast-cancer risk\n(early menarche = known risk factor)"];
  }

  /* =======================================================================
     18. DIAGNOSTICS & MONITORING
     ======================================================================= */
  subgraph cluster_dx {
    label="18. Diagnostics & On-Treatment Monitoring";
    style=filled; color="#c8e0e0"; fillcolor="#edf8f8";
    GnRH_stim_test [label="★ GnRH/leuprolide stimulation test\npeak LH >5 IU/L = CENTRAL\n(gold standard)", fillcolor="#b3d9d9", penwidth=2];
    Basal_LH [label="Basal LH ≥0.3 IU/L (ICMA)\nspecific but insensitive"];
    Random_E2 [label="Random E2 (poor sensitivity —\nepisodic secretion)"];
    Pelvic_US [label="Pelvic ultrasound\n(uterine volume/length, ovaries)"];
    BA_xray [label="Left-hand/wrist radiograph\n→ bone age"];
    MRI_brain [label="Brain MRI\n(mandatory <6 y; boys; atypical)"];
    Height_velocity_monitor [label="Growth velocity monitoring\n★ MISLEADING on GnRHa\n(falls even when therapy is working)", fillcolor="#f4b183"];
    Suppression_test [label="On-treatment suppression check\n(post-injection LH <4 IU/L,\nor basal LH + E2 + exam)"];
    PAH_calc [label="★ Predicted adult height (PAH)\nBayley-Pinneau from BA + Ht", fillcolor="#b3d9d9", penwidth=2];
  }

  /* =======================================================================
     19. CLINICAL ENDPOINTS
     ======================================================================= */
  subgraph cluster_endpoints {
    label="19. Clinical Endpoints";
    style=filled; color="#f8d8a8"; fillcolor="#fdf2e0";
    Adult_height [label="★★ FINAL ADULT HEIGHT (cm)\nuntreated CPP girls ~151-156\ntreated ~159-163\n= ∫GV dt over a SHRINKING window", fillcolor="#f6b26b", penwidth=3];
    Height_gain [label="★ HEIGHT GAIN vs UNTREATED\nthe quantity whose SIGN FLIPS\nwith bone age at start", fillcolor="#f6b26b", penwidth=2];
    Target_height [label="Mid-parental target height\n(the reference)"];
    Ht_SDS_deficit [label="Adult height − target height\n(SDS deficit)"];
    Tanner_arrest [label="Regression/arrest of Tanner stage\n(breast B3→B2, cyst resolution)"];
    Menarche_timing [label="Age at menarche (post-treatment)"];
    Cycle_regularity [label="Cycle regularity / ovulation"];
  }

  /* =======================================================================
     20. LONG-TERM & LIFE-COURSE
     ======================================================================= */
  subgraph cluster_longterm {
    label="20. Life-Course Outcomes (drivers of the decision to treat at all)";
    style=filled; color="#d8d8d8"; fillcolor="#f2f2f2";
    Adult_BMI [label="Adult BMI / visceral adiposity"];
    T2DM_risk [label="Adult T2DM / metabolic risk"];
    CVD_risk [label="Cardiovascular risk"];
    Bone_fx [label="Adult fragility-fracture risk"];
    Repro_span [label="Reproductive span"];
    Psych_adult [label="Adult psychosocial adjustment"];
  }

  /* =====================================================================
     ---------------------- E D G E S ----------------------
     ===================================================================== */

  /* 1 → KNDy: brakes and set-point */
  MKRN3 -> MKRN3_decline [label="protein falls\npre-puberty"];
  MKRN3_decline -> KNDy_neuron [label="DE-REPRESSION", color="#c00000", penwidth=2];
  MKRN3 -> KNDy_neuron [label="ubiquitinates MBD3/\nrepresses KISS1  ⊣", color="#0070c0", arrowhead=tee, penwidth=2];
  Imprint_loss -> MKRN3 [label="LoF"];
  Imprint_loss -> DLK1 [label="LoF"];
  DLK1 -> KNDy_neuron [label="⊣", color="#0070c0", arrowhead=tee];
  DLK1 -> Adiposity [label="LoF → central obesity"];
  Familial_hx -> MKRN3;
  Familial_hx -> Genetic_setpoint;
  Genetic_setpoint -> KNDy_neuron [penwidth=2];
  Sex_bias -> Genetic_setpoint [style=dashed];
  Adoption_intl -> Genetic_setpoint [style=dashed];
  Adoption_intl -> Adiposity [label="catch-up growth"];
  KISS1 -> Kiss_release;
  KISS1R -> Kiss1R_GnRH;
  TAC3 -> NKB_release;
  TACR3 -> NKB_release [label="autocrine loop"];
  PDYN -> Dyn_release;
  OPRK1 -> Dyn_release [label="autocrine loop"];
  LIN28B -> Genetic_setpoint;
  MECP2_PROK2 -> Genetic_setpoint;
  Epigenetic_PcG -> KISS1 [label="promoter switch"];
  Epigenetic_PcG -> KNDy_neuron;

  /* 2 → gating */
  Adiposity -> Leptin [penwidth=2];
  Leptin -> LEPR_ARC;
  LEPR_ARC -> KNDy_neuron [label="permissive\n(indirect)", style=dashed];
  Adiposity -> CYP19A1_periph [label="aromatase mass ↑"];
  Insulin_env -> KNDy_neuron [style=dashed];
  Insulin_env -> IGF1;
  IGF1_perm -> KNDy_neuron [style=dashed];
  Ghrelin -> KNDy_neuron [arrowhead=tee, color="#0070c0"];
  Melatonin -> KNDy_neuron [arrowhead=tee, color="#0070c0"];
  Sleep_arch -> Nocturnal_gate;
  Nocturnal_gate -> Pulse_freq [label="first pulses\nare sleep-entrained"];
  EDC -> KNDy_neuron [style=dashed];
  EDC -> E2 [label="xeno-oestrogen\n(→ peripheral PP)", style=dashed];
  Psychosocial_stress -> Genetic_setpoint [style=dashed];
  Vitamin_D -> BMD_LS;
  Gut_micro -> Adiposity [style=dashed];
  Preterm_SGA -> Adiposity;
  Preterm_SGA -> Genetic_setpoint [style=dashed];

  /* 3 KNDy internals — the oscillator */
  KNDy_neuron -> NKB_release;
  KNDy_neuron -> Dyn_release;
  KNDy_neuron -> Kiss_release;
  NKB_release -> KNDy_neuron [label="+ (ignition)", color="#c00000"];
  Dyn_release -> KNDy_neuron [label="− (termination)", color="#0070c0", arrowhead=tee];
  NKB_release -> Pulse_freq [label="↑ frequency", color="#c00000", penwidth=2];
  Dyn_release -> Pulse_freq [label="↓ frequency", color="#0070c0", arrowhead=tee, penwidth=2];
  Kiss_release -> Pulse_amp;
  Kiss_release -> Kiss1R_GnRH [penwidth=2];
  GABA_tone -> KNDy_neuron [arrowhead=tee, color="#0070c0"];
  Glutamate_tone -> KNDy_neuron [color="#c00000"];
  NPY_tone -> KNDy_neuron [arrowhead=tee, color="#0070c0"];
  RFRP3 -> GnRH_neuron [arrowhead=tee, color="#0070c0"];
  Astro_glia -> GnRH_neuron [label="TGF-α/PGE2"];
  Hypothal_lesion -> Hamartoma_ectopic;
  Hamartoma_ectopic -> Portal_GnRH [label="ectopic GnRH —\nBYPASSES the brake", color="#c00000", penwidth=2];
  Hypothal_lesion -> KNDy_neuron [label="disinhibition"];
  MRI_brain -> Hypothal_lesion [style=dotted, label="detects"];
  AVPV_Kiss -> GnRH_neuron [label="surge generator"];
  E2 -> AVPV_Kiss [label="+ feedback\n(female)", color="#c00000"];

  /* 4 GnRH neuron → portal */
  Kiss1R_GnRH -> GnRH_neuron [penwidth=2];
  GnRH_neuron -> GnRH_synth;
  GnRH_synth -> ME_terminal;
  ME_terminal -> Portal_GnRH [penwidth=2];
  Pulse_freq -> Portal_GnRH [label="sets pulse TRAIN", penwidth=2];
  Pulse_amp -> Portal_GnRH;
  Portal_GnRH -> GnRH_deg;
  GnRH_deg -> Analog_potency [style=dotted, label="the reason analogues\nresist degradation"];

  /* 5 pituitary */
  Portal_GnRH -> GnRHR_surface [label="binds"];
  Plasma_analog -> GnRHR_surface [label="binds (sustained)", color="#e36c0a", penwidth=2];
  GnRHR_surface -> Gq_PLC;
  Gq_PLC -> ERK_EGR1;
  ERK_EGR1 -> LH_synth;
  GnRHR_surface -> GnRHR_desens [label="continuous occupancy\n→ β-arrestin\ninternalisation", color="#e36c0a", penwidth=2];
  GnRHR_desens -> GnRHR_surface [label="slow recycling /\nresynthesis", style=dashed];
  Pulse_freq -> Pulse_decoder [penwidth=2];
  Plasma_analog -> Pulse_decoder [label="DESTROYS pulsatility\n(effective frequency → 0)", color="#e36c0a", penwidth=2, arrowhead=tee];
  Pulse_decoder -> LH_synth [label="fast pulses → LHB", penwidth=2];
  Pulse_decoder -> FSH_synth [label="slow pulses → FSHB"];
  LH_synth -> LH_plasma [penwidth=2];
  FSH_synth -> FSH_plasma;
  LH_plasma -> LH_FSH_ratio;
  FSH_plasma -> LH_FSH_ratio;
  Glyco_variant -> LH_plasma [label="t½"];
  Gq_PLC -> Free_alpha;
  GnRHR_surface -> Flare_surge [label="1st dose: full\nagonism before\ndown-regulation", color="#c00000", penwidth=2];
  Depot_burst -> Flare_surge [color="#c00000", penwidth=2];
  Flare_surge -> LH_plasma [color="#c00000"];
  Flare_surge -> E2 [label="transient E2 surge", color="#c00000"];
  Flare_surge -> Withdrawal_bleed [color="#c00000"];
  GnRH_antag -> GnRHR_surface [label="COMPETITIVE block —\nno flare", color="#00a000", arrowhead=tee, penwidth=2];

  /* 6 ovary */
  FSH_plasma -> Follicle_pool [penwidth=2];
  FSH_plasma -> Granulosa;
  LH_plasma -> Theca [penwidth=2];
  Follicle_pool -> Granulosa;
  Theca -> CYP19A1_ov [label="androstenedione\nsubstrate"];
  Granulosa -> CYP19A1_ov [label="FSH → CYP19A1 expression"];
  CYP19A1_ov -> Estrone;
  CYP19A1_ov -> E2 [penwidth=2];
  Estrone -> E2;
  Granulosa -> Inhibin_B;
  Inhibin_B -> FSH_synth [arrowhead=tee, color="#0070c0"];
  Follicle_pool -> AMH_ov [arrowhead=tee, color="#0070c0"];
  Follicle_pool -> Ovarian_vol;
  E2 -> LH_synth [label="− then + feedback", style=dashed];
  Progesterone_ov -> Pulse_freq [arrowhead=tee, color="#0070c0", label="slows pulses"];
  Cyst_MAS -> E2 [label="autonomous", color="#c00000"];

  /* 7 testis */
  LH_plasma -> Leydig [penwidth=2];
  FSH_plasma -> Sertoli;
  Leydig -> Testosterone [penwidth=2];
  Testosterone -> DHT;
  Testosterone -> CYP19A1_periph;
  CYP19A1_periph -> E2 [label="the fusion signal\nin BOYS too", penwidth=2];
  Sertoli -> AMH_testis;
  Sertoli -> Inhibin_B;
  FSH_plasma -> Testis_vol;
  Testosterone -> Voice_muscle;
  DHT -> Acne_odour;
  Testis_vol -> GnRH_stim_test [style=dotted];

  /* 8 adrenarche — parallel, unsuppressed */
  ACTH_ad -> ZR_maturation;
  ZR_maturation -> DHEAS;
  DHEAS -> Androstenedione_ad;
  Androstenedione_ad -> Pubic_hair;
  DHEAS -> Pubic_hair [penwidth=2];
  Androstenedione_ad -> CYP19A1_periph;
  Pubic_hair -> Body_image [label="progresses ON therapy\n→ parental alarm", color="#c00000"];
  CAH_21OH -> Androstenedione_ad [color="#c00000", penwidth=2];
  CAH_21OH -> Bone_age [label="androgen → BA advance", color="#c00000"];
  CAH_21OH -> Secondary_central;
  Adrenal_tumour -> Androstenedione_ad;

  /* 9 peripheral PP */
  GNAS_MAS -> Autonomous_E2 [penwidth=2, color="#c00000"];
  GNAS_MAS -> Fibrous_dysplasia;
  GNAS_MAS -> Cyst_MAS;
  Autonomous_E2 -> E2 [label="LH-INDEPENDENT", color="#c00000", penwidth=2];
  Autonomous_E2 -> Plasma_analog [label="NOT reachable by\na GnRH agonist", style=dotted, arrowhead=none, color="#c00000"];
  hCG_tumour -> Leydig [label="LHR cross-reaction", color="#c00000"];
  Testotoxicosis -> Leydig [label="constitutive LHR", color="#c00000"];
  Exogenous_steroid -> E2 [color="#c00000"];
  Autonomous_E2 -> Secondary_central [label="BA advance releases\nthe central brake"];
  Secondary_central -> KNDy_neuron [color="#c00000"];
  Tamoxifen -> E2 [label="ER block  ⊣", arrowhead=tee, color="#00a000"];
  Fulvestrant -> E2 [label="ER degradation  ⊣", arrowhead=tee, color="#00a000"];
  Bicalutamide -> DHT [arrowhead=tee, color="#00a000"];
  Ketoconazole -> CYP19A1_ov [arrowhead=tee, color="#00a000"];
  Cyproterone -> DHT [arrowhead=tee, color="#00a000"];

  /* 10 GH axis — the (+) sign */
  GHRH -> GH_pulse;
  SST -> GH_pulse [arrowhead=tee, color="#0070c0"];
  E2 -> GH_pulse [label="(+) AMPLIFIES\n×2-3", color="#c00000", penwidth=3];
  Testosterone -> GH_pulse [label="(+) via aromatisation", color="#c00000"];
  GH_pulse -> IGF1 [penwidth=2];
  GH_pulse -> IGFBP3;
  rhGH -> GH_pulse [label="exogenous", color="#00a000", penwidth=2];
  IGF1 -> IGFBP3;
  IGF1 -> IGF1R_plate [penwidth=2];
  GH_pulse -> GH_direct;
  GH_direct -> Resting_zone;
  IGF1R_plate -> Prolif_zone [penwidth=2];
  Prolif_zone -> Growth_velocity [penwidth=2];
  Hypertroph_zone -> Growth_velocity [penwidth=2];
  Growth_velocity -> PHV;
  E2 -> Growth_velocity [label="(+) direct low-dose\nchondrocyte effect", color="#c00000"];
  Oxandrolone -> Growth_velocity [color="#00a000"];

  /* 11 growth plate — the (−) sign, irreversible */
  Resting_zone -> Prolif_zone [label="stem-cell\nrecruitment"];
  Prolif_zone -> Hypertroph_zone;
  Prolif_zone -> GP_reserve [label="each division\nCONSUMES reserve", arrowhead=tee, color="#7030a0", penwidth=2];
  GP_reserve -> Prolif_zone [label="reserve gates\nfurther division", penwidth=2];
  GP_reserve -> Senescence [arrowhead=tee];
  Senescence -> Fusion [penwidth=2];
  E2 -> ERa_plate [penwidth=2];
  ERa_plate -> Senescence [label="(−) ACCELERATES\nreserve consumption", color="#7030a0", penwidth=3];
  ERa_plate -> Fusion [label="(−) drives fusion", color="#7030a0", penwidth=3];
  Aromatase_plate -> ERa_plate [label="local T → E2"];
  Testosterone -> Aromatase_plate;
  Senescence -> Bone_age [penwidth=2];
  E2 -> Bone_age [label="(−) ADVANCES\nirreversibly", color="#7030a0", penwidth=3];
  Bone_age -> Remaining_growth [arrowhead=tee, penwidth=2];
  Bone_age -> BA_CA_ratio [penwidth=2];
  Fusion -> Remaining_growth [arrowhead=tee, penwidth=2];
  Fusion -> Growth_velocity [arrowhead=tee, penwidth=2];
  Remaining_growth -> Adult_height [penwidth=2];
  Growth_velocity -> Adult_height [label="∫ GV dt", penwidth=3];
  Bone_age -> PAH_calc [penwidth=2];
  Prolif_zone -> Sitting_height;
  BA_xray -> Bone_age [style=dotted, label="measures"];

  /* 12 bone mass */
  E2 -> Osteoblast [label="+ accrual", color="#c00000"];
  E2 -> Osteoclast [label="⊣ resorption", arrowhead=tee, color="#0070c0", penwidth=2];
  Osteoclast -> BMD_LS [arrowhead=tee];
  Osteoblast -> BMD_LS [penwidth=2];
  Sclerostin -> Osteoblast [arrowhead=tee, color="#0070c0"];
  Ca_VitD -> BMD_LS [color="#00a000"];
  Osteoclast -> CTX_P1NP;
  Osteoblast -> CTX_P1NP;
  BMD_LS -> Peak_bone_mass [penwidth=2];
  Peak_bone_mass -> Bone_fx [arrowhead=tee];
  Plasma_analog -> BMD_LS [label="E2 withdrawal during\npeak-accrual window\n→ transient Z dip", color="#e36c0a"];

  /* 13 target tissues */
  E2 -> Breast_bud [penwidth=2];
  E2 -> Uterus_vol [penwidth=2];
  E2 -> Vaginal_mucosa;
  Uterus_vol -> Endometrial_echo;
  Endometrial_echo -> Withdrawal_bleed;
  Endometrial_echo -> Menarche [penwidth=2];
  E2 -> Menarche [label="threshold + duration", penwidth=2];
  Breast_bud -> Body_image;
  Breast_bud -> Tanner_arrest;
  Menarche -> Menarche_timing;
  Menarche -> Cycle_regularity;
  Uterus_vol -> Pelvic_US [style=dotted, label="measured by"];

  /* 14 PK */
  Leup_1m -> Depot_burst;
  Leup_1m -> Depot_slow;
  Leup_3m -> Depot_slow;
  Leup_6m_SC -> Depot_slow;
  Trip_3m -> Depot_burst;
  Trip_3m -> Depot_slow;
  Nafarelin_nasal -> Plasma_analog [label="short t½,\nTID dosing"];
  Hist_implant -> Plasma_analog [label="ZERO-ORDER\nno trough", color="#00a000", penwidth=2];
  Depot_burst -> Plasma_analog [penwidth=2];
  Depot_slow -> Plasma_analog [penwidth=2];
  Analog_potency -> Plasma_analog;
  Plasma_analog -> Interdose_escape [label="late-cycle\ntrough", arrowhead=tee];
  Interdose_escape -> LH_plasma [label="LH escape >4 IU/L", color="#c00000", penwidth=2];
  Interdose_escape -> E2 [color="#c00000"];
  Adherence -> Plasma_analog [penwidth=2];
  Nafarelin_nasal -> Adherence [label="worst", color="#c00000"];
  Hist_implant -> Adherence [label="best", color="#00a000"];
  Plasma_analog -> GnRHR_desens [penwidth=2, color="#e36c0a"];
  GnRHR_desens -> LH_synth [arrowhead=tee, color="#e36c0a", penwidth=2];
  Plasma_analog -> Vasomotor_tx;
  Leup_1m -> Sterile_abscess;
  Hist_implant -> Implant_break;
  Plasma_analog -> Weight_gain [style=dashed];
  Plasma_analog -> PTC [style=dashed];
  Plasma_analog -> Seizure_signal [style=dashed];
  Plasma_analog -> Anaphylaxis [style=dashed];
  Fusion -> Slipped_epiphysis [style=dashed];

  /* 15 other drugs */
  Anastrozole -> AI_effect;
  Letrozole -> AI_effect [penwidth=2];
  AI_effect -> CYP19A1_ov [arrowhead=tee, color="#00a000", penwidth=2];
  AI_effect -> CYP19A1_periph [arrowhead=tee, color="#00a000", penwidth=2];
  AI_effect -> Aromatase_plate [arrowhead=tee, color="#00a000", penwidth=2];
  AI_effect -> Testosterone [label="T RISES\n(no negative feedback)", color="#c00000"];
  AI_effect -> BMD_LS [label="E2 loss → BMD ↓", arrowhead=tee, color="#c00000"];
  Kiss_antag -> KNDy_neuron [arrowhead=tee, color="#00a000"];
  rhGH -> IGF1 [color="#00a000", penwidth=2];

  /* 16 CNS */
  E2 -> Sex_steroid_CNS;
  Testosterone -> Sex_steroid_CNS;
  Sex_steroid_CNS -> Emotional_lability;
  Sex_steroid_CNS -> Early_sexual;
  Sex_steroid_CNS -> Cognitive;
  Emotional_lability -> QoL [arrowhead=tee];
  Body_image -> QoL [arrowhead=tee, penwidth=2];
  Early_sexual -> QoL [arrowhead=tee];
  Vasomotor_tx -> QoL [arrowhead=tee];
  QoL -> Psych_adult;

  /* 17/18 diagnostics */
  LH_plasma -> GnRH_stim_test [penwidth=2];
  LH_plasma -> Basal_LH;
  E2 -> Random_E2;
  GnRH_stim_test -> Suppression_test [style=dotted];
  Plasma_analog -> Suppression_test [style=dotted];
  Growth_velocity -> Height_velocity_monitor;
  Height_velocity_monitor -> Suppression_test [label="FALSE alarm channel:\nGV falls on effective therapy", color="#c00000", style=dashed];
  BA_CA_ratio -> Suppression_test [label="the RELIABLE channel", color="#00a000", penwidth=2];
  PAH_calc -> Height_gain [penwidth=2];
  Pelvic_US -> Suppression_test [style=dotted];

  /* 19/20 endpoints */
  Adult_height -> Height_gain [penwidth=2];
  Target_height -> Ht_SDS_deficit;
  Adult_height -> Ht_SDS_deficit [penwidth=2];
  Height_gain -> Ht_SDS_deficit;
  Menarche -> Repro_span;
  Weight_gain -> Adult_BMI;
  Adult_BMI -> T2DM_risk;
  Adult_BMI -> CVD_risk;
  E2 -> BrCa_risk [label="lifetime exposure", style=dashed];
  Menarche_timing -> BrCa_risk [style=dashed];
  Plasma_analog -> Fertility_later [style=dashed, label="no impairment\nin cohorts"];
  Plasma_analog -> PCOS_later [style=dashed];
  Plasma_analog -> Metab_later [style=dashed];
  Cycle_regularity -> Repro_span;

  /* ---- the two signed paths, drawn explicitly as the model's thesis ---- */
  E2 -> Adult_height [label="NET SIGN IS NOT FIXED:\n(+) via GV, (−) via fusion\nthe sign of dHeight/dTreatment\nflips at BA ≈ 11.5-12 y", color="#7030a0", style=bold, penwidth=3, fontsize=11];
  Plasma_analog -> E2 [label="suppresses BOTH arms\n→ benefit only while the\n(−) arm still dominates", color="#e36c0a", arrowhead=tee, penwidth=3];
}
