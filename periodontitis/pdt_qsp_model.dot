digraph PDT_QSP {
  rankdir=LR;
  fontname="Helvetica";
  labelloc="t";
  fontsize=20;
  label="Periodontitis (PDT) — Mechanistic QSP Map\nPolymicrobial Synergy & Dysbiosis → C5aR1-TLR2 Subversion of Neutrophil Killing → Inflammophilic Nutrient Feedback → RANKL-Driven IRREVERSIBLE Alveolar Bone Loss\nThe bacteria start it; the host does the damage; only the bone loss is permanent";
  node [style=filled, fontname="Helvetica", fontsize=10, shape=box, fillcolor="#ffffff"];
  edge [fontname="Helvetica", fontsize=8, color="#555555"];
  compound=true;
  newrank=true;

  //=========================================================================
  subgraph cluster_risk {
    label="1. Host Risk Modifiers / Susceptibility (the parameters, not the state)"; style=filled; color="#e6d7c3"; fillcolor="#f7f0e6"; fontsize=13;
    Smoking [label="Smoking\n(2-6x odds; dose-dependent\npack-years)", fillcolor="#f0d0d0"];
    Nicotine_vasoconstr [label="Nicotine vasoconstriction\n→ BOP MASKED despite\nworse destruction"];
    Smoke_PMN [label="Smoke: impaired PMN\nchemotaxis + phagocytosis"];
    Smoke_fibro [label="Smoke: fibroblast\nattachment/proliferation ↓\n→ poor healing"];
    Diabetes [label="Diabetes mellitus\n(HbA1c-graded risk)", fillcolor="#f0d0d0"];
    AGE_RAGE [label="AGE-RAGE axis\n(hyperglycaemia → advanced\nglycation end-products)"];
    Hypergly_PMN [label="Hyperglycaemia: PMN\nrespiratory burst / killing ↓"];
    Obesity_adipo [label="Obesity / adipokines\n(leptin ↑, adiponectin ↓)"];
    Genetics_IL1 [label="IL-1A/IL-1B composite\ngenotype (contested)"];
    LADI [label="Leukocyte adhesion\ndeficiency-I (LAD-I)\n→ NO PMN in tissue", fillcolor="#f0d0d0"];
    LADI_IL17 [label="LAD-I paradox:\nlocal IL-23/IL-17 SURGE\n→ severe bone loss"];
    PapillonLefevre [label="Papillon-Lefevre\n(CTSC / cathepsin C loss\n→ no PMN serine proteases)"];
    Downs [label="Down syndrome\n(near-universal, early onset)"];
    Age_host [label="Age / cumulative exposure\n(CAL is an integral)"];
    Stress_cortisol [label="Psychosocial stress\n→ cortisol → immune shift"];
    VitD_low [label="Vitamin D / calcium\ninsufficiency"];
    Oral_hygiene [label="Plaque control\n(supragingival, patient-side)", fillcolor="#d7ecd9"];
    Anatomy [label="Local anatomy: furcation,\nroot concavity, malposition,\noverhang restorations", fillcolor="#f0e0c0"];
    Occlusal [label="Occlusal trauma\n(co-factor, not initiator)"];
  }

  //=========================================================================
  subgraph cluster_biofilm {
    label="2. Subgingival Biofilm Ecology — Polymicrobial Synergy & Dysbiosis (PSD)"; style=filled; color="#c8dcc8"; fillcolor="#eef6ee"; fontsize=13;
    Pellicle [label="Acquired salivary pellicle\n(proline-rich proteins, statherin)"];
    Early_col [label="Early colonisers\nStreptococcus, Actinomyces\n(saccharolytic, aerotolerant)", fillcolor="#d7ecd9"];
    Fusobacterium [label="Fusobacterium nucleatum\nBRIDGING organism\n(coaggregation hub)", fillcolor="#f0e0c0"];
    Orange_complex [label="Orange complex\nP. intermedia, P. micra,\nC. rectus, E. nodatum"];
    Red_complex [label="Red complex\nP. gingivalis, T. forsythia,\nT. denticola", fillcolor="#f5c6c6"];
    Aa [label="A. actinomycetemcomitans\nJP2 clone (leukotoxin)\n— molar-incisor pattern", fillcolor="#f5c6c6"];
    Synergistetes [label="Uncultivated taxa\nSynergistetes, Filifactor,\nTM7 / Saccharibacteria"];
    Biofilm_matrix [label="EPS matrix\n→ 100-1000x antimicrobial\ntolerance (NOT resistance)", fillcolor="#f0e0c0"];
    Anaerobiosis [label="Deepening pocket → redox\npotential ↓ → strict-anaerobe\nniche"];
    Calculus [label="Subgingival CALCULUS\nmineralised reservoir\n→ re-seeds biofilm", fillcolor="#f0e0c0"];
    Biomass_total [label="Total biofilm biomass\n(carrying capacity limited)"];
    Dysbiosis_index [label="DYSBIOSIS\n(community composition shift,\nnot merely more bacteria)", fillcolor="#f5c6c6"];
    Symbiosis [label="Symbiotic community\n(health-compatible)", fillcolor="#d7ecd9"];
    Saliva_reseed [label="Salivary / mucosal\nre-inoculation reservoir"];
  }

  //=========================================================================
  subgraph cluster_keystone {
    label="3. Keystone Pathogen Virulence — P. gingivalis at <0.01% Abundance"; style=filled; color="#e0b8b8"; fillcolor="#faeeee"; fontsize=13;
    Pg [label="P. gingivalis\nKEYSTONE at LOW abundance\n(catalyst, not bulk contributor)", fillcolor="#f5c6c6"];
    Gingipains [label="Gingipains Rgp/Kgp\n(Arg-/Lys-specific cysteine\nproteases; ~85% of virulence)", fillcolor="#f5c6c6"];
    Gp_C5conv [label="Gingipain C5 convertase-like\nactivity → LOCAL C5a\n(complement-independent)"];
    Gp_CD14 [label="Gingipain cleavage of\nCD14, CD4, CD8, TNFR"];
    Gp_nutrition [label="Gingipain proteolysis of\nhost proteins → PEPTIDES\n(asaccharolytic nutrition)"];
    Gp_heme [label="Kgp haemoglobin degradation\n→ HAEM acquisition\n(mu-oxo-haem dimer pigment)"];
    FimA [label="FimA fimbriae (type II)\n→ epithelial invasion,\nintegrin engagement"];
    Pg_LPS [label="P.g. LPS lipid A heterogeneity\npenta-acyl (TLR4 agonist) vs\ntetra-acyl (TLR4 ANTAGONIST)"];
    Pg_evasion [label="TLR4 antagonism = innate\nEVASION while inflammation\nis driven via TLR2"];
    Pg_invasion [label="Intracellular persistence in\ngingival epithelium\n→ antibiotic sanctuary", fillcolor="#f0e0c0"];
    PPAD [label="PPAD peptidyl-arginine\ndeiminase → protein\nCITRULLINATION"];
    Td_dentilisin [label="T. denticola dentilisin +\nmajor sheath protein"];
    Tf_BspA [label="T. forsythia BspA\n(TLR2 ligand, invasion)"];
    Aa_Ltx [label="A.a. leukotoxin LtxA\n→ LFA-1-dependent PMN lysis\n→ NLRP3 → IL-1beta burst"];
    Aa_CDT [label="A.a. cytolethal distending\ntoxin (CDT) → G2 arrest"];
  }

  //=========================================================================
  subgraph cluster_feedback {
    label="4. THE ENGINE — Inflammophilic Nutrient Feedback Loop (why it is self-sustaining)"; style=filled; color="#d9a5a5"; fillcolor="#fce8e8"; fontsize=14;
    GCF_flow [label="GCF flow rate ↑\n(0.05 → 1-2 uL/min/site)\nSERUM EXUDATE", fillcolor="#f5c6c6"];
    Serum_protein [label="Serum-derived protein\n(albumin, transferrin,\nhaemoglobin, haptoglobin)"];
    Tissue_breakdown [label="Degraded host collagen\n& matrix peptides"];
    Haem_iron [label="Haem / iron availability\n(essential P.g. growth\nlimiting nutrient)", fillcolor="#f5c6c6"];
    Nutrient_pool [label="NUTRIENT POOL for\nasaccharolytic proteolytic\nanaerobes", fillcolor="#f5c6c6"];
    Inflammophilic [label="INFLAMMOPHILIC selection:\ninflammation FEEDS the\ndysbiotic community", fillcolor="#f5a5a5"];
    Positive_loop [label="POSITIVE FEEDBACK\n→ BISTABILITY\n(health attractor vs\ndisease attractor)", fillcolor="#f58080", shape=octagon];
    Separatrix [label="SEPARATRIX / tipping point\nTherapy must cross it,\nnot merely approach it", fillcolor="#f58080", shape=octagon];
  }

  //=========================================================================
  subgraph cluster_complement {
    label="5. Complement & the C5aR1-TLR2 Crosstalk Subversion"; style=filled; color="#c3c3e0"; fillcolor="#eeeef8"; fontsize=13;
    C3_central [label="C3 — central complement hub\n(target of AMY-101)", fillcolor="#d0d0f0"];
    C3a_C3aR [label="C3a / C3aR"];
    C5_cleave [label="C5 cleavage\n(canonical convertase +\ngingipain shortcut)"];
    C5a [label="LOCAL C5a", fillcolor="#d0d0f0"];
    C5aR1 [label="C5aR1 (CD88) on\nneutrophils & macrophages", fillcolor="#d0d0f0"];
    TLR2_recep [label="TLR2 / TLR2-TLR1 heterodimer\n(P.g. lipoproteins, BspA)"];
    Crosstalk [label="C5aR1 x TLR2 CROSSTALK\n(the subversion node)", fillcolor="#c0c0ee", shape=octagon];
    Smurf1 [label="Ubiquitin ligase Smurf1\n→ MyD88 PROTEASOMAL\nDEGRADATION"];
    PI3K_Mal [label="Mal-PI3K-Akt branch\nSELECTIVELY PRESERVED"];
    RhoA_block [label="PI3K → RhoA / actin\npolymerisation BLOCK\n→ phagocytosis fails"];
    Ca_signal [label="C5aR1 → intracellular\nCa2+ → cAMP-PKA\n→ NO / iNOS killing ↓"];
    MAC_C5b9 [label="C5b-9 membrane attack\ncomplex (bystander lysis)"];
    Subversion_out [label="NET RESULT: killing DOWN,\ninflammation UP\n(uncoupled)", fillcolor="#f5a5a5", shape=octagon];
  }

  //=========================================================================
  subgraph cluster_epithelium {
    label="6. Junctional Epithelium Barrier & Innate Sensing"; style=filled; color="#c8d8e8"; fillcolor="#eef4fa"; fontsize=13;
    JE [label="Junctional epithelium\n(non-keratinised, wide\nintercellular spaces)", fillcolor="#d7ecd9"];
    JE_TJ [label="Tight/adherens junctions\n(E-cadherin, ZO-1, occludin)"];
    JE_damage [label="Barrier breakdown\n(gingipain + MMP cleavage\nof E-cadherin)", fillcolor="#f5c6c6"];
    Pocket_epi [label="Pocket epithelium\nULCERATED, discontinuous\n→ direct bacteraemia route", fillcolor="#f5c6c6"];
    Apical_migration [label="Apical migration of JE\n(the histological definition\nof attachment loss)", fillcolor="#f5c6c6"];
    TLR4_recep [label="TLR4 / MD-2 / CD14"];
    NOD12 [label="NOD1 / NOD2\ncytosolic peptidoglycan"];
    NLRP3 [label="NLRP3 inflammasome\n→ caspase-1"];
    Gasdermin [label="Gasdermin-D pyroptosis\n→ IL-1beta / IL-18 release"];
    HBD [label="hBD-1/2/3, LL-37\nepithelial antimicrobial\npeptides", fillcolor="#d7ecd9"];
    IL8_epi [label="Epithelial CXCL8 (IL-8)\nchemokine gradient\n→ PMN transmigration"];
    Chemokine_paralysis [label="'Local chemokine paralysis'\n(P.g. suppresses IL-8\nearly → stealth)"];
    ICAM1 [label="ICAM-1 / E-selectin\nendothelial adhesion"];
  }

  //=========================================================================
  subgraph cluster_pmn {
    label="7. Neutrophil Biology — Recruited, Disarmed, Destructive"; style=filled; color="#e8dcc0"; fillcolor="#faf6ea"; fontsize=13;
    PMN_recruit [label="PMN transmigration into\ngingival crevice\n(dominant cell, 95% of\ncrevicular leukocytes)"];
    PMN_pool [label="Crevicular PMN pool"];
    PMN_kill [label="PMN KILLING CAPACITY\n(phagocytosis + oxidative\nburst) — A STATE VARIABLE", fillcolor="#d7ecd9"];
    PMN_kill_loss [label="Killing capacity SUBVERTED\n(C5aR1-TLR2, hyperglycaemia,\nsmoking)", fillcolor="#f5c6c6"];
    Degranulation [label="Azurophil / specific granule\ndegranulation"];
    MPO [label="Myeloperoxidase\n→ HOCl"];
    ROS_burst [label="NADPH oxidase ROS\n(unrestrained, bystander\ndamage)", fillcolor="#f5c6c6"];
    NETs [label="NETosis\n(DNA-histone-elastase webs;\ncitrullinated H3)", fillcolor="#f5c6c6"];
    NE_PR3 [label="Neutrophil elastase,\nproteinase-3, cathepsin G"];
    MMP8_release [label="MMP-8 (collagenase-2)\nPRE-STORED in granules\n→ released, not synthesised", fillcolor="#f5c6c6"];
    MMP9_release [label="MMP-9 (gelatinase B)"];
    Reverse_migration [label="Delayed apoptosis /\nfailed clearance\n→ persistent PMN load"];
  }

  //=========================================================================
  subgraph cluster_mono {
    label="8. Monocyte / Macrophage / Dendritic Cell Axis"; style=filled; color="#d8c8e0"; fillcolor="#f5eefa"; fontsize=13;
    Mono_recruit [label="CCL2 (MCP-1) monocyte\nrecruitment"];
    M1 [label="M1 macrophage\n(IL-1beta, TNF-alpha, IL-6,\nIL-12, iNOS)", fillcolor="#f5c6c6"];
    M2 [label="M2 macrophage\n(IL-10, TGF-beta, arginase,\nefferocytosis)", fillcolor="#d7ecd9"];
    M1M2_ratio [label="M1:M2 ratio\n= net inflammatory tone", shape=octagon];
    DC_gingival [label="Gingival dendritic cells\n(P.g. hijacks DC-SIGN\n→ intracellular transit)"];
    Efferocytosis [label="Efferocytosis of apoptotic\nPMN (resolution step)", fillcolor="#d7ecd9"];
    Efferocytosis_fail [label="Failed efferocytosis\n→ secondary necrosis\n→ DAMP release", fillcolor="#f5c6c6"];
    DAMPs [label="DAMPs: HMGB1, S100A8/A9,\nmitochondrial DNA, ATP"];
    Osteoclast_precursor [label="CD14+ monocyte =\nOSTEOCLAST PRECURSOR", fillcolor="#f0e0c0"];
  }

  //=========================================================================
  subgraph cluster_adaptive {
    label="9. Adaptive Immunity — the Established Lesion"; style=filled; color="#c0d8d8"; fillcolor="#eef7f7"; fontsize=13;
    APC_present [label="Antigen presentation\n(MHC-II, CD80/86)"];
    Th1 [label="Th1 (IFN-gamma)\nstable-lesion bias"];
    Th2 [label="Th2 (IL-4, IL-5)\nB-cell help"];
    Th17 [label="Th17 (IL-17A/F, IL-21, IL-22)\nDOMINANT osteodestructive\nsubset in human lesions", fillcolor="#f5c6c6"];
    Th17_damage [label="Th17 accrual is driven by\nLOCAL DAMAGE / mastication,\nnot only by microbiota"];
    Treg [label="Treg (FoxP3, IL-10, TGF-beta)\nprotective", fillcolor="#d7ecd9"];
    Th17_Treg_bal [label="Th17 : Treg balance", shape=octagon];
    IL23_axis [label="IL-23 / IL-23R axis\n(DC & macrophage derived)"];
    Tfh_GC [label="Tfh / ectopic germinal-centre\nlike structures"];
    Bcell [label="B cells", fillcolor="#f0e0c0"];
    Plasma_cell [label="PLASMA CELLS\ndominant cell of the\nestablished/advanced lesion", fillcolor="#f5c6c6"];
    Bcell_RANKL [label="B & T cells are a MAJOR\nRANKL source in human\nperiodontitis", fillcolor="#f5c6c6"];
    Antibody [label="Serum + local IgG/IgA\n(protective vs. non-protective\navidity)"];
  }

  //=========================================================================
  subgraph cluster_mediators {
    label="10. Cytokine / Lipid Mediator Network"; style=filled; color="#e0d0b0"; fillcolor="#faf4e6"; fontsize=13;
    IL1b [label="IL-1beta\n(GCF concentration tracks\ndisease activity)", fillcolor="#f5c6c6"];
    TNFa [label="TNF-alpha", fillcolor="#f5c6c6"];
    IL6_loc [label="IL-6 (local)"];
    IL17A [label="IL-17A", fillcolor="#f5c6c6"];
    IL8_med [label="CXCL8 / IL-8"];
    IL10 [label="IL-10 (regulatory)", fillcolor="#d7ecd9"];
    TGFb [label="TGF-beta"];
    PGE2 [label="PGE2 (COX-2 derived)\n→ RANKL ↑, vasodilation,\nbone resorption", fillcolor="#f5c6c6"];
    LTB4 [label="LTB4 (5-LOX)\nPMN chemoattractant"];
    IFNg [label="IFN-gamma"];
    OSM [label="Oncostatin M / IL-11\n(gp130 family)"];
    Inflam_index [label="COMPOSITE INFLAMMATORY\nTONE (drives everything\ndownstream)", fillcolor="#f5a5a5", shape=octagon];
  }

  //=========================================================================
  subgraph cluster_resolution {
    label="11. Resolution Programme — Failure of Resolution, Not Excess of Initiation"; style=filled; color="#b8d8b8"; fillcolor="#eaf7ea"; fontsize=13;
    ALX_FPR2 [label="ALX / FPR2 receptor"];
    LXA4 [label="Lipoxin A4", fillcolor="#d7ecd9"];
    RvE1 [label="Resolvin E1 (EPA-derived)\nChemR23 agonist", fillcolor="#d7ecd9"];
    RvD1 [label="Resolvin D1 / D2\n(DHA-derived)", fillcolor="#d7ecd9"];
    Maresin [label="Maresin-1, Protectin-D1"];
    SPM_actions [label="SPM actions: STOP PMN influx,\nENHANCE efferocytosis,\nrestore tissue — non-\nimmunosuppressive", fillcolor="#d7ecd9"];
    Resolution_fail [label="RESOLUTION FAILURE\n(SPM:LTB4 ratio ↓)", fillcolor="#f5c6c6", shape=octagon];
    Omega3 [label="Dietary omega-3 (EPA/DHA)\n+/- low-dose aspirin\n→ AT-SPM"];
  }

  //=========================================================================
  subgraph cluster_ecm {
    label="12. Connective Tissue Attachment Destruction (partly REVERSIBLE)"; style=filled; color="#d0c0b0"; fillcolor="#f7f2ec"; fontsize=13;
    Fibroblast [label="Gingival / PDL fibroblast"];
    Col_I_III [label="Collagen type I/III\nsupracrestal + PDL fibres", fillcolor="#d7ecd9"];
    Sharpey [label="Sharpey's fibres inserting\ninto cementum & bone"];
    MMP8_act [label="ACTIVE MMP-8\n(Zn2+ catalytic site)", fillcolor="#f5c6c6"];
    MMP13 [label="MMP-13 (collagenase-3)\nfibroblast/osteoblast"];
    MMP2_9 [label="MMP-2 / MMP-9 gelatinases"];
    TIMP [label="TIMP-1 / TIMP-2\nendogenous inhibitors", fillcolor="#d7ecd9"];
    MMP_TIMP [label="MMP : TIMP IMBALANCE\n(the proteolytic set-point)", shape=octagon, fillcolor="#f0e0c0"];
    ProMMP_act [label="proMMP activation by\nHOCl / plasmin / other MMPs\n(cysteine-switch)"];
    Col_frag [label="Collagen fragments\nICTP / ICTP-like peptides\n(GCF biomarker)"];
    LJE [label="LONG JUNCTIONAL EPITHELIUM\nre-attachment = the healing\nthat therapy actually achieves", fillcolor="#d7ecd9"];
    True_regen [label="True new attachment\n(cementum + PDL + bone)\n— only with regeneration", fillcolor="#d7ecd9"];
  }

  //=========================================================================
  subgraph cluster_bone {
    label="13. Alveolar Bone Remodelling — the IRREVERSIBLE RATCHET"; style=filled; color="#c0b0a0"; fillcolor="#f2ede8"; fontsize=14;
    RANKL [label="RANKL (TNFSF11)\nfrom T/B cells, fibroblasts,\nosteocytes, osteoblasts", fillcolor="#f5c6c6"];
    OPG [label="OPG (decoy receptor)", fillcolor="#d7ecd9"];
    RANKL_OPG [label="RANKL : OPG RATIO\nfinal common effector", fillcolor="#f58080", shape=octagon];
    RANK_recep [label="RANK on osteoclast\nprecursor"];
    MCSF [label="M-CSF / CSF1R\n(permissive signal)"];
    NFATc1 [label="NFATc1 master\nosteoclastogenic TF"];
    Osteoclast [label="Multinucleated OSTEOCLAST\n(ruffled border, sealing zone)", fillcolor="#f5c6c6"];
    CathK [label="Cathepsin K + TRAP\n+ H+ (V-ATPase)\n→ matrix dissolution"];
    Osteocyte [label="Osteocyte RANKL /\nsclerostin (SOST)"];
    Wnt [label="Wnt / beta-catenin\nosteoblast programme", fillcolor="#d7ecd9"];
    Sclerostin [label="Sclerostin ↑\n→ Wnt BLOCKED\n→ formation uncoupled", fillcolor="#f5c6c6"];
    Osteoblast [label="Osteoblast bone formation\n(largely UNCOUPLED here)", fillcolor="#d7ecd9"];
    Bone_loss [label="CUMULATIVE ALVEOLAR\nBONE LOSS (mm)\nMONOTONE — NEVER RETURNS", fillcolor="#f58080", shape=octagon];
    Safe_distance [label="~1.5-2 mm 'safe distance'\nfrom biofilm front to bone\n(range of osteoclastogenic\nsignal)"];
    Furcation [label="Furcation involvement\n(Grade I/II/III)\n— anatomic point of no return", fillcolor="#f5c6c6"];
  }

  //=========================================================================
  subgraph cluster_mech {
    label="14. Pharmacology A — Mechanical Therapy (resets the STATE)"; style=filled; color="#b0c8e0"; fillcolor="#e9f1fa"; fontsize=13;
    OHI [label="Oral hygiene instruction /\nsupragingival plaque control", fillcolor="#cfe3f7"];
    SRP [label="SCALING & ROOT PLANING\n(subgingival instrumentation)", fillcolor="#cfe3f7"];
    SRP_depth [label="SRP calculus-removal efficacy\nFALLS WITH DEPTH\n(>90% at <=3 mm,\n<50% at >=6 mm)", fillcolor="#f0e0c0"];
    FMD_protocol [label="Full-mouth disinfection\n(within 24 h) vs quadrant\n— acute bacteraemia burst"];
    Surgery [label="Open flap debridement /\naccess surgery\n(better access, RECESSION cost)", fillcolor="#cfe3f7"];
    Resective [label="Resective / osseous surgery,\napically positioned flap"];
    Regen [label="REGENERATION: EMD,\nGTR membrane, bone graft,\nrhPDGF-BB", fillcolor="#cfe3f7"];
    Critical_PD [label="CRITICAL PROBING DEPTH\nSRP ~2.9 mm; surgery ~4.2 mm\n(below it, therapy LOSES\nattachment)", fillcolor="#f0e0c0", shape=octagon];
    SPT [label="Supportive periodontal therapy\n(3-monthly recall)\n— prevents re-crossing\nthe separatrix", fillcolor="#cfe3f7"];
    Extraction [label="Extraction of hopeless teeth"];
  }

  //=========================================================================
  subgraph cluster_antimicrob {
    label="15. Pharmacology B — Antimicrobial (attacks BIOMASS)"; style=filled; color="#b0d8c8"; fillcolor="#e9f7f1"; fontsize=13;
    Amox [label="Amoxicillin 500 mg TID x7d\n(covers facultative +\nINTRACELLULAR sanctuary)", fillcolor="#cceee0"];
    Metro [label="Metronidazole 400 mg TID x7d\n(strict anaerobes: P.g, T.f,\nT.d — nitroreduction)", fillcolor="#cceee0"];
    AM_synergy [label="Van Winkelhoff cocktail\nSYNERGY — greatest benefit\nin DEEP pockets", fillcolor="#f0e0c0"];
    Azithro [label="Azithromycin\n(tissue/PMN accumulation,\nanti-inflammatory too)"];
    Mino_local [label="Minocycline microspheres\n(local sustained release,\nArestin)", fillcolor="#cceee0"];
    Doxy_gel [label="Doxycycline hyclate gel 10%\n/ chlorhexidine chip"];
    CHX [label="Chlorhexidine 0.12-0.2% rinse\nSUPRAGINGIVAL ONLY\n— negligible subgingival\npenetration", fillcolor="#f0e0c0"];
    PDT_photo [label="Antimicrobial photodynamic\ntherapy (adjunct, weak\nevidence)"];
    Probiotic [label="Probiotics / prebiotics\n(ecological approach)"];
    AMR [label="ANTIMICROBIAL RESISTANCE\n& dysbiosis of gut flora\n— stewardship limit", fillcolor="#f5c6c6"];
  }

  //=========================================================================
  subgraph cluster_hostmod {
    label="16. Pharmacology C — Host Modulation (changes the PARAMETERS)"; style=filled; color="#d8b0d8"; fillcolor="#f8eaf8"; fontsize=13;
    SDD [label="SUB-ANTIMICROBIAL DOSE\nDOXYCYCLINE 20 mg BID\n(Periostat) — MMP inhibition,\nNOT antibacterial", fillcolor="#eed0ee"];
    SDD_mech [label="Zn2+/Ca2+ chelation at MMP\ncatalytic site + proMMP\nactivation block + osteoclast\ninhibition"];
    CMT [label="Chemically modified\ntetracyclines (CMT-3,\nno antibiotic moiety)"];
    NSAID [label="NSAID / selective COX-2\n(flurbiprofen) — REBOUND\non withdrawal, GI/CV limits", fillcolor="#f0e0c0"];
    AMY101 [label="AMY-101 (Cp40)\nC3 INHIBITOR, local injection\n— phase IIa positive", fillcolor="#eed0ee"];
    C5aR1_ant [label="C5aR1 antagonist (PMX-53)\n— preclinical"];
    RvE1_drug [label="Resolvin E1 / SPM analogues\n(pro-resolving, non-\nimmunosuppressive)", fillcolor="#eed0ee"];
    AntiTNF [label="Anti-TNF (infliximab,\netanercept) — RA patients\nshow LESS periodontal\ninflammation", fillcolor="#eed0ee"];
    AntiIL17 [label="Anti-IL-17A (secukinumab)\n— CAUTION: IL-17 also\nantimicrobial at mucosa", fillcolor="#f0e0c0"];
    AntiIL6R [label="Anti-IL-6R (tocilizumab)"];
    Denosumab [label="Denosumab (anti-RANKL) /\nbisphosphonate\n— protects bone", fillcolor="#eed0ee"];
    MRONJ [label="MRONJ RISK\n(x16-33 after extraction;\ndose-dependent)", fillcolor="#f5c6c6"];
    Glycaemic [label="Glycaemic control\n(metformin / GLP-1 / insulin)\n— treats the AMPLIFIER", fillcolor="#eed0ee"];
    Cessation [label="Smoking cessation\n— restores responsiveness\nover 5-10 y", fillcolor="#eed0ee"];
    Statin_adj [label="Statins (local simvastatin gel)\npleiotropic BMP-2 / anti-\ninflammatory"];
  }

  //=========================================================================
  subgraph cluster_endpoints {
    label="17. Clinical Endpoints & Biomarkers"; style=filled; color="#a8b8c8"; fillcolor="#eaeef2"; fontsize=14;
    PPD [label="PPD — probing pocket depth\n(mm; margin → pocket base)", fillcolor="#dbe5ee"];
    GM_pos [label="Gingival margin position\n(swelling coronal vs\nRECESSION apical)"];
    CAL [label="CAL — CLINICAL ATTACHMENT\nLEVEL (CEJ → pocket base)\nPPD + recession\nTHE primary endpoint", fillcolor="#f58080", shape=octagon];
    Decomposition [label="PPD reduction =\nATTACHMENT GAIN + RECESSION\n(most of it is recession)", fillcolor="#f0e0c0", shape=octagon];
    BOP [label="BOP — bleeding on probing %\n(NPV ~98% for stability;\nPPV only ~30%)", fillcolor="#dbe5ee"];
    Suppuration [label="Suppuration / abscess"];
