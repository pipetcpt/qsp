    Tooth_loss [label="TOOTH LOSS\n(the patient-centred outcome)", fillcolor="#f58080", shape=octagon];
    PISA [label="PISA — periodontal inflamed\nSURFACE AREA (mm2)\nup to 1500-2000 mm2\n= the systemic dose", fillcolor="#f0e0c0", shape=octagon];
