                     color="#2e8b57", penwidth=1.8];
  U_IMP  -> G_LVEDV [label="&#8722; unloading",
                     color="#2e8b57", penwidth=1.4];
  U_ECMO -> H_CO    [color="#2e8b57", penwidth=1.4];
  U_IMP  -> U_BRIDGE; U_ECMO -> U_BRIDGE;
  Z_EFREC-> U_BRIDGE[label="the target exists",
                     color="#2e8b57", style=dashed];

  /* 25: endpoints */
  G_LVEF  -> N_CP     [style=dashed];
  Q_STELEV-> N_CP;
  N_KILLIP-> N_ICU    [penwidth=1.6];
  H_SHOCK -> N_ICU    [penwidth=1.8];
  H_SHOCK -> N_MORT30 [penwidth=1.8];
  N_ICU   -> N_MORT30 [penwidth=1.6];
  N_MORT30-> N_MORT1Y [penwidth=1.4];
  T_PHYS  -> N_TRIGST [penwidth=1.4];
  T_EMO   -> N_TRIGST;
  N_TRIGST-> N_MORT1Y [penwidth=1.6];
  N_RECUR -> N_MORT1Y [style=dashed];
  W_PHOS  -> N_RECUR  [style=dashed, label="residual substrate"];
  G_LVEF  -> N_INTERT [style=dashed];
  N_QOL   -> N_MORT1Y [style=dashed];
  I_RATIO -> N_INTERT [label="diagnostic discriminator",
                       penwidth=1.4];

  /* 26: inference wiring */
  J_HDGI   -> J_PRODUCT[penwidth=1.6];
  J_HDOED  -> J_PRODUCT[penwidth=1.4];
  J_HDATP  -> J_PRODUCT[penwidth=1.4];
  J_HDLVOT -> J_PRODUCT[penwidth=1.4];
  O_OED    -> J_HDOED  [style=dashed];
  E_ATP    -> J_HDATP  [style=dashed];
  J_PRODUCT-> J_MATCH  [penwidth=1.8];
  X_DOB    -> J_MATCH  [penwidth=1.6, color="#c0392b"];
  Y_LEVO   -> J_MATCH  [penwidth=1.6, color="#2e8b57"];
  J_AUC    -> J_HDGI   [style=dashed];
  K_AFFIN  -> J_FALSIF [penwidth=1.6];
  W_PTX    -> J_FALSIF [penwidth=1.6];
  J_MATCH  -> J_FALSIF [style=dashed];
  J_FALSIF -> G_VARIANT[label="falsified if NE alone\nballoons the apex",
                        style=dashed, penwidth=1.4];
}
