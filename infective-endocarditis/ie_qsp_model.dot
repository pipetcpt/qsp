digraph IE_QSP {
  rankdir=LR;
  fontname="Helvetica";
  labelloc="t";
  fontsize=20;
  label="Infective Endocarditis (IE) — Mechanistic QSP Map\nThe MIC is measured on 10^5 CFU/mL of log-phase planktonic cells in broth. The vegetation presents 10^10 CFU/g of stationary-phase cells behind a 2-5 mm AVASCULAR diffusion barrier.\nEvery peculiarity of IE therapy — 6-week durations, bactericidal-only regimens, combinations, the surgical indications, the ceiling on vancomycin exposure — is a consequence of that mismatch.\nIE is a GEOMETRY problem wearing the clothes of a susceptibility problem.";
  node [style=filled, fontname="Helvetica", fontsize=10, shape=box, fillcolor="#ffffff"];
  edge [fontname="Helvetica", fontsize=8, color="#555555"];
  compound=true;
  newrank=true;

  //=========================================================================
  subgraph cluster_portal {
    label="1. Portal of Entry & Organism — WHICH organism is a covariate on almost every parameter below"; style=filled; color="#cdbfa8"; fillcolor="#f7f2e8"; fontsize=13;
    Dental [label="Oral / dental procedures\n+ daily toothbrushing\n(cumulative exposure >> single\nprocedure — why prophylaxis\nis a small lever)"];
    Skin_portal [label="Skin breach: IV catheter,\nhaemodialysis access,\nPWID injection", fillcolor="#f0d0d0"];
    GI_portal [label="Colonic mucosa\n(S. gallolyticus → occult\ncolorectal neoplasia)"];
    GU_portal [label="Genitourinary instrumentation\n(E. faecalis)"];
    Prosthetic_portal [label="Intra-operative seeding of\nprosthetic material\n(early PVE < 12 mo)", fillcolor="#f0d0d0"];
    CIED_portal [label="CIED lead / generator pocket\n(pacemaker, ICD)"];
    Saureus [label="STAPHYLOCOCCUS AUREUS\n~30% of IE; acute, destructive,\nembolic; MSSA vs MRSA", fillcolor="#f5c6c6"];
    VGS [label="Viridans group streptococci\nsubacute, low MIC,\nhighly penicillin-susceptible"];
    Efaecalis [label="ENTEROCOCCUS FAECALIS\nintrinsically tolerant —\ncell-wall agents are\nBACTERIOSTATIC alone", fillcolor="#f0e0c0"];
    CoNS [label="Coagulase-negative staph\n(S. epidermidis) — PVE,\nheavy biofilm, methicillin-R"];
    HACEK [label="HACEK / fastidious GNB\nslow-growing, culture-negative\nrisk"];
    Candida_ie [label="Candida / fungal IE\nlarge friable vegetations,\nsurgery near-obligatory", fillcolor="#f5c6c6"];
    Culture_neg [label="Culture-negative IE (~10%)\nprior antibiotics, Coxiella,\nBartonella, Tropheryma"];
    Adhesins [label="Adhesins: ClfA, ClfB, FnBPA/B,\nSdrC/D/E, Ebp pili (Efs),\nAtlE (CoNS)"];
    Inoculum_size [label="Bacteraemia magnitude x duration\n= seeding probability\n(catheter-related SAB: ~25%\nendovascular seeding)"];
  }

  //=========================================================================
  subgraph cluster_nbte {
    label="2. Endothelial Injury & Non-Bacterial Thrombotic Endocarditis (NBTE) — the LANDING PAD must exist first"; style=filled; color="#b9cddc"; fillcolor="#eef4f9"; fontsize=13;
    Jet_lesion [label="High-velocity regurgitant jet\n→ mechanical endothelial\ndenudation (Venturi / MacCallum\npatch, low-pressure side)"];
    Degen_valve [label="Degenerative / calcific valve\n(now the commonest substrate\nin high-income countries)"];
    RHD [label="Rheumatic heart disease\n(dominant substrate in LMIC)"];
    Congenital [label="Congenital: bicuspid aortic\nvalve, VSD, repaired CHD\nwith residual shunt"];
    Prosth_surface [label="Prosthetic valve surface /\nsewing ring / annuloplasty ring\n— NO endothelium to defend"];
    Endoth_activate [label="Cytokine-activated endothelium\nexpresses fibronectin +\nintegrin α5β1 → INTERNALISES\nS. aureus (no denudation needed)", fillcolor="#f0e0c0"];
    TF_expose [label="Tissue factor exposure\n(subendothelial)"];
    vWF_expose [label="vWF multimers unfurled\nby shear → GPIbα capture"];
    Fibronectin [label="Fibronectin bridge:\nFnBPA — fibronectin — α5β1\n(the S. aureus 'invasin' route)"];
    NBTE_lesion [label="NBTE: sterile platelet-fibrin\nthrombus — the OBLIGATE\nprecursor lesion", fillcolor="#f0e0c0"];
    Hypercoag [label="Hypercoagulable states\n(malignancy, APS) →\nmarantic endocarditis"];
    Shear_side [label="Vegetations sit on the\nLOW-PRESSURE side:\natrial face of MV,\nventricular face of AV"];
  }

  //=========================================================================
  subgraph cluster_veg {
    label="3. Vegetation Assembly — a platelet-fibrin FORTRESS the organism builds out of host material"; style=filled; color="#d8b8b8"; fillcolor="#faeeee"; fontsize=13;
    Plt_adhere [label="Platelet adhesion\nGPIbα-vWF, GPVI-collagen"];
    Plt_activate [label="Platelet ACTIVATION\nby bacterial products\n(SraP, IsdB, protein A,\nα-toxin, SspB)", fillcolor="#f5c6c6"];
    Plt_bridge [label="Fibrinogen bridging:\nClfA/ClfB — fibrinogen —\nGPIIb/IIIa (αIIbβ3)"];
    Alpha_granule [label="α-granule release:\nPF4, β-thromboglobulin,\nfibrinogen, vWF, P-selectin"];
    Thrombin_gen [label="Thrombin generation\n(bacterial staphylocoagulase\n+ vWF-binding protein →\nCOAGULASE bypasses FXa)", fillcolor="#f5c6c6"];
    Fibrin_polym [label="Fibrin polymerisation\n→ matrix accretion"];
    Staphylokinase [label="Staphylokinase / plasminogen\nactivation → local lysis\n(fragmentation → EMBOLI)"];
    NETs [label="NETs released by trapped\nneutrophils — DNA scaffold\nSTABILISES the vegetation\n(host defence feeding the fortress)", fillcolor="#f0e0c0"];
    Veg_mass [label="VEGETATION MASS (mg)\n→ diameter, → depth,\n→ everything downstream", fillcolor="#f5c6c6"];
    Veg_diam [label="Vegetation DIAMETER\n(the single most actionable\nnumber on the echo report)", fillcolor="#f5c6c6"];
    Veg_avascular [label="AVASCULAR: no capillaries,\nno perfusion, no leukocyte\ndelivery to the core", fillcolor="#f5c6c6"];
    Fibrinolysis [label="Slow endogenous fibrinolysis\n+ organisation / fibrosis\n(weeks — vegetations persist\nlong after sterilisation)"];
    Veg_positive_fb [label="POSITIVE FEEDBACK:\nbacteria → coagulase → fibrin →\nbigger vegetation → worse\npenetration → more bacteria", fillcolor="#f5c6c6"];
  }

  //=========================================================================
  subgraph cluster_micro {
    label="4. Microbial Physiology INSIDE the Vegetation — three shells, two phenotypes"; style=filled; color="#c8b8d8"; fillcolor="#f4eefa"; fontsize=13;
    Shell_S [label="SURFACE shell (0-0.5 mm)\nnutrient-replete, aerobic,\nGROWING, exposed to blood\n→ the source of bacteraemia", fillcolor="#d7ecd9"];
    Shell_M [label="MID shell\nnutrient gradient,\nmixed phenotype"];
    Shell_C [label="CORE shell (>1.5 mm)\nanoxic, acidic (pH ~5.5-6.5),\nnutrient-starved, NON-GROWING", fillcolor="#f5c6c6"];
    Density [label="Bacterial density\n10^9 - 10^11 CFU/g\n(vs 10^5 CFU/mL in the\nMIC assay — 5-6 logs higher)", fillcolor="#f5c6c6"];
    Carrying_cap [label="Carrying capacity reached\nwithin ~24-48 h of seeding\n→ NET GROWTH ≈ 0 thereafter"];
    Stationary [label="STATIONARY PHASE\nμ → 0 → β-lactam killing → 0\n(kill requires active\npeptidoglycan turnover)", fillcolor="#f5c6c6"];
    Persister [label="PERSISTERS (phenotypic,\nnon-inherited, reversible)\n~10^-3 - 10^-5 of population;\nHigBA/toxin-antitoxin, ppGpp"];
    SCV [label="Small colony variants\n(hemB/menD): slow-growing,\naminoglycoside-tolerant,\nintracellular persistence"];
    Biofilm_matrix [label="Biofilm matrix: PIA/PNAG (icaADBC),\neDNA, phenol-soluble modulins;\nagr quorum sensing (dispersal)"];
    Anoxia [label="Anoxic core → no proton-motive\nforce → AMINOGLYCOSIDE UPTAKE\nFAILS (energy-dependent phase II)", fillcolor="#f0e0c0"];
    Acid_core [label="Acidic core → aminoglycoside\nand daptomycin activity ↓;\nβ-lactam stability ↓"];
    Intracell [label="Intracellular reservoir\n(endothelial cells, macrophages)\n— shielded from vancomycin"];
    Switch_GD [label="G ⇄ D switching\n(growing ⇄ dormant), slow\nrelative to a dosing interval\n→ dormancy is a STATE, not a rate"];
  }

  //=========================================================================
  subgraph cluster_diffusion {
    label="5. Antibiotic Diffusion Physics — why plasma AUC and core AUC are different numbers"; style=filled; color="#a8c4b8"; fillcolor="#eef7f2"; fontsize=13;
    Diff_only [label="Transport into vegetation is\nDIFFUSION ONLY\n(no convection, no capillaries)", fillcolor="#f5c6c6"];
    Thiele [label="Thiele modulus φ = L·√(k_bind/D)\npenetration length λ = √(D/k_bind)\n— the governing dimensionless group", fillcolor="#f0e0c0"];
    Depth_exp [label="Steady-state attenuation\nC(x) ≈ C_surface · exp(-x/λ)\n→ EXPONENTIAL loss with depth", fillcolor="#f5c6c6"];
    MW_effect [label="Molecular weight\nvancomycin 1449 Da,\ndaptomycin 1620 Da,\nnafcillin 414 Da,\nrifampicin 823 Da (lipophilic)"];
    ProtBind [label="Plasma protein binding\ndaptomycin ~92%, ceftriaxone ~95%,\nnafcillin ~90%, vancomycin ~50%,\nampicillin ~20%\n→ only FREE drug diffuses", fillcolor="#f0e0c0"];
    Fibrin_bind [label="BINDING TO THE MATRIX ITSELF\nvancomycin binds fibrin/D-Ala-D-Ala\ndebris; aminoglycosides are cationic\nand bind anionic eDNA/fibrin\n→ k_bind ↑ → λ ↓", fillcolor="#f5c6c6"];
    Consumption [label="Drug consumption/inactivation\nin transit (β-lactamase, pH,\nbinding to dead cell walls)"];
    Lag_time [label="Diffusive equilibration lag\nτ ≈ L²/(6D) ~ 0.5-2 h\n→ vegetation sees a SMOOTHED,\nDELAYED version of the plasma curve"];
    Peak_blunt [label="Peak blunting: a 60 mg/L\nvancomycin peak becomes a\n~flat few mg/L in the core\n→ Cmax-driven PD is lost"];
    Lambda_rank [label="λ ranking (long → short):\nRIFAMPICIN >> β-lactam >\nlinezolid > daptomycin ≈\nvancomycin > gentamicin", fillcolor="#f0e0c0"];
    Core_AUC [label="CORE AUC/MIC — the quantity\nthat actually decides cure,\nand the one nobody measures", fillcolor="#f5c6c6"];
    Saturation [label="STRUCTURAL CONSEQUENCE:\ncore exposure saturates in\nplasma exposure; toxicity does NOT\n→ there is an OPTIMUM dose,\nnot a maximum one", fillcolor="#f5c6c6"];
  }

  //=========================================================================
  subgraph cluster_betalactam {
    label="6. β-Lactams — the reference bactericidal class, and its growth-rate dependency"; style=filled; color="#b8c8dc"; fillcolor="#eff3f9"; fontsize=13;
    Nafcillin [label="Nafcillin / flucloxacillin\nMSSA drug of choice\n(β-lactamase stable)", fillcolor="#d7ecd9"];
    Cefazolin [label="Cefazolin 6 g/day\nbetter tolerated; the 'inoculum\neffect' (BlaZ type A) is the\ncontested caveat", fillcolor="#d7ecd9"];
    Ceftriaxone [label="Ceftriaxone 2 g q24h\nVGS / HACEK; OPAT-friendly\nlong half-life"];
    Ampicillin [label="Ampicillin 2 g q4h\nE. faecalis backbone"];
    Amp_Ctx [label="AMPICILLIN + CEFTRIAXONE\n— saturates complementary PBPs\n(PBP4/5) in E. faecalis;\nno aminoglycoside, no nephrotoxicity", fillcolor="#d7ecd9"];
    PBP [label="PBP transpeptidase acylation\n→ peptidoglycan cross-linking\nblocked"];
    Autolysin [label="Autolysin (Atl) dysregulation\n→ LYSIS — requires an actively\nremodelling cell wall"];
    Growth_dep [label="KILL RATE ∝ GROWTH RATE\nstationary cells are\nPHENOTYPICALLY TOLERANT\n(tolerance ≠ resistance:\nMIC unchanged, MBC ↑↑)", fillcolor="#f5c6c6"];
    fT_MIC [label="PD index: fT>MIC\n(target ~50-100% for\nendovascular infection)"];
    Cont_inf [label="Continuous / extended infusion\nmaximises fT>MIC at fixed daily\ndose — the free lever"];
    Eagle [label="EAGLE / paradoxical effect:\nkilling falls at very high\nconcentration and very high\ninoculum", fillcolor="#f0e0c0"];
    Inoc_effect [label="Inoculum effect: MIC rises\n≥8-fold going from 10^5 to\n10^7 CFU/mL (cefazolin/MSSA)", fillcolor="#f0e0c0"];
    BL_AIN [label="Nafcillin: interstitial nephritis,\nhepatitis, phlebitis, neutropenia", fillcolor="#f0d0d0"];
  }

  //=========================================================================
  subgraph cluster_glyco {
    label="7. Glycopeptides & Lipopeptides — the MRSA options and their opposite failure modes"; style=filled; color="#dcc8b8"; fillcolor="#faf3ec"; fontsize=13;
    Vanco [label="VANCOMYCIN\nAUC24/MIC 400-600 target\n(2020 consensus guideline —\ntroughs abandoned)", fillcolor="#d7ecd9"];
    Vanco_target [label="Binds D-Ala-D-Ala terminus\n→ blocks transglycosylation\n(substrate-directed, not\nenzyme-directed)"];
    Vanco_slow [label="Slowly bactericidal;\nlarge, fibrin-binding,\npoor core penetration →\nthe SLOWEST clearance of\nbacteraemia of any option", fillcolor="#f5c6c6"];
    Vanco_MICcreep [label="MIC 1 → 2 mg/L doubles the\nrequired AUC to 800 —\nunreachable without AKI\n→ the real reason MIC 2\nMRSA does badly", fillcolor="#f5c6c6"];
    hVISA [label="hVISA / VISA: thickened cell\nwall sequesters vancomycin\n(a decoy-binding, not enzymatic,\nresistance)"];
    Dapto [label="DAPTOMYCIN 8-10 mg/kg\n(6 mg/kg is the LABEL dose and\nis widely regarded as too low\nfor endocarditis)", fillcolor="#d7ecd9"];
    Dapto_mech [label="Ca²⁺-dependent insertion into\nPG-containing membrane →\ndepolarisation, ion efflux\n→ death WITHOUT LYSIS"];
    Dapto_stat [label="RETAINS ACTIVITY AGAINST\nNON-DIVIDING CELLS\n— the single most important\nproperty for a vegetation core", fillcolor="#f5c6c6"];
    Dapto_surf [label="Bound and INACTIVATED by\npulmonary surfactant\n→ useless in pneumonia,\nfine in endocarditis"];
    Dapto_mprF [label="mprF / yycFG mutation →\nnon-susceptibility ON THERAPY\n(emerges in high-inoculum,\nlow-exposure settings)", fillcolor="#f0d0d0"];
    Seesaw [label="SEESAW EFFECT: dapto-NS strains\nregain β-lactam susceptibility\n→ DAPTOMYCIN + β-LACTAM\n(ceftaroline) combination", fillcolor="#f0e0c0"];
    Dalba [label="DALBAVANCIN\nt½ ~14 d; 1500 mg day 1 + day 8\n→ consolidation / OPAT-free\ncompletion (DALBACEN, mostly\nobservational evidence)"];
    Dapto_CK [label="Daptomycin: CK rise,\nmyopathy, eosinophilic\npneumonia", fillcolor="#f0d0d0"];
    Vanco_AKI [label="Vancomycin AKI: AUC-driven,\nsteep above AUC24 ~600·h·mg/L", fillcolor="#f0d0d0"];
  }

  //=========================================================================
  subgraph cluster_rifgent {
    label="8. Rifampicin & Aminoglycosides — the two 'adjuncts', both with quantitative traps"; style=filled; color="#d0c0a0"; fillcolor="#f8f4e8"; fontsize=13;
    Rif [label="RIFAMPICIN 900 mg/day\nsmall, lipophilic, un-ionised →\nBEST core penetration of any\nantistaphylococcal agent", fillcolor="#d7ecd9"];
    Rif_target [label="Binds RNA polymerase β subunit\n(rpoB) → blocks transcription\n→ active against NON-GROWING\nand BIOFILM-EMBEDDED cells"];
    Rif_mono_fail [label="RIFAMPICIN MONOTHERAPY FAILS\nDETERMINISTICALLY, not by bad luck:\nmutation freq ~10^-8 x 10^10 CFU\n= ~100 rpoB mutants ALREADY\nPRESENT at diagnosis", fillcolor="#f5c6c6"];
    rpoB [label="rpoB point mutation → high-level\nresistance in ONE step\n(no gradual MIC creep)", fillcolor="#f5c6c6"];
    Fitness_cost [label="rpoB mutants carry a fitness cost\n→ they lose in the absence of\nrifampicin, which is why the\ncompanion drug must be adequate"];
    Rif_induce [label="RIFAMPICIN INDUCES CYP3A4/2C9,\nUGT and P-gp → lowers the\nCOMPANION drug's exposure\n(and warfarin, DOACs, azoles,\nARVs, tacrolimus)", fillcolor="#f5c6c6"];
    Rif_PVE [label="Guideline role is confined to\nPROSTHETIC valve staph IE\n(biofilm) — added AFTER\nbacteraemia clears"];
    ARREST [label="ARREST (Lancet 2018): adjunctive\nrifampicin in S. aureus bacteraemia\n— NO benefit, more interactions\n→ an INFORMATIVE NEGATIVE", fillcolor="#f0d0d0"];
    Gent [label="GENTAMICIN 3 mg/kg/day\n'synergy' dosing"];
    Gent_uptake [label="Uptake needs an ELECTRON\nTRANSPORT-DRIVEN PMF →\nanoxic, acidic core = NO UPTAKE", fillcolor="#f5c6c6"];
    Gent_synergy [label="True synergy mechanism:\ncell-wall agent ↑ permeability\n→ aminoglycoside entry ↑\n(real in vitro; small in vivo)"];
    Cosgrove [label="Cosgrove 2009 (CID): low-dose\ngentamicin in staph IE gave NO\nbenefit and measurable AKI\n→ removed from guidelines\n(a second INFORMATIVE NEGATIVE)", fillcolor="#f0d0d0"];
    HLAR [label="High-level aminoglycoside\nresistance (E. faecalis) →\nsynergy abolished → Amp+Ctx"];
    Gent_ATN [label="Gentamicin: proximal tubular\nATN, ototoxicity, vestibular\ntoxicity (cumulative)", fillcolor="#f0d0d0"];
  }

  //=========================================================================
  subgraph cluster_newer {
    label="9. Newer / Adjunct Agents & Route Strategy"; style=filled; color="#b8d0d8"; fillcolor="#eef6f8"; fontsize=13;
    Ceftaroline [label="Ceftaroline — anti-MRSA\ncephalosporin (PBP2a affinity);\nsalvage, and the partner in\ndapto+ceftaroline"];
    Ceftobiprole [label="Ceftobiprole (ERADICATE, NEJM 2023):\nnon-inferior to daptomycin in\ncomplicated SAB incl. right-sided IE"];
    Linezolid [label="Linezolid — oral bioavailability 100%,\ngood tissue penetration, but\nBACTERIOSTATIC → not first-line\nfor a lesion needing 10 logs", fillcolor="#f0e0c0"];
    Fosfomycin [label="Fosfomycin combinations\n(with dapto/imipenem) — salvage,\nexcellent penetration"];
    Oral_stepdown [label="PARTIAL ORAL STEP-DOWN (POET,\nNEJM 2019): after ≥10 d IV and\nstabilisation, oral completion was\nNON-INFERIOR at 6 mo and 5 y", fillcolor="#d7ecd9"];
    RODEO [label="Right-sided IE in PWID:\nshorter courses, higher cure —\na different disease physically\n(smaller pressure, less destruction)"];
    Phage_lysin [label="Exebacase (lysin CF-301):\nphase III DISRUPT failed —\nadjunct enzybiotics remain\nunproven", fillcolor="#f0d0d0"];
    Antiplatelet [label="Aspirin 325 mg (Chan 2003, JACC):\nNO reduction in embolic events,\nMORE bleeding\n→ a THIRD informative negative", fillcolor="#f0d0d0"];
    Anticoag_ie [label="Anticoagulation does NOT treat\nvegetations and raises\nhaemorrhagic transformation risk\nafter septic stroke", fillcolor="#f0d0d0"];
    OPAT [label="OPAT / outpatient parenteral therapy\n— feasibility, not efficacy, is the\nusual constraint"];
  }

  //=========================================================================
  subgraph cluster_resist {
    label="10. Resistance & Tolerance Evolution — a POPULATION problem at 10^10 cells"; style=filled; color="#e0b0b0"; fillcolor="#fceeee"; fontsize=13;
    Mut_freq [label="Spontaneous mutation frequency\nrifampicin ~10^-8,\nfluoroquinolone ~10^-7 - 10^-9,\ndaptomycin/vanco: multi-step"];
    Preexist [label="N_resistant(t=0) = f_mut × N_total\nAt N = 10^10 and f = 10^-8:\n100 MUTANTS BEFORE THE FIRST DOSE", fillcolor="#f5c6c6"];
    MSW [label="Mutant selection window\n(MIC < C < MPC): the concentration\nband that ENRICHES resistance"];
    MPC [label="Mutant prevention concentration\n— what you must exceed in the\nCORE, not in plasma", fillcolor="#f0e0c0"];
    Hetero [label="Heteroresistance: a minority\nsubpopulation with higher MIC\ninvisible to routine AST"];
    Tolerance [label="TOLERANCE: unchanged MIC,\nprolonged killing time (MBC/MIC ≥32)\n— the dominant mechanism in IE,\nand invisible to the lab report", fillcolor="#f5c6c6"];
    Compensatory [label="Compensatory mutations restore\nfitness → resistance persists\nafter drug withdrawal"];
    Comb_suppress [label="Combination suppresses resistance\nONLY IF each drug independently\nkills the other's mutants\nIN THE SAME SHELL", fillcolor="#f0e0c0"];
  }

  //=========================================================================
  subgraph cluster_innate {
    label="11. Innate Immunity — recruited, and then locked out"; style=filled; color="#c0d8c0"; fillcolor="#eff8ef"; fontsize=13;
    Complement [label="Complement activation\nC3a/C5a; staphylococcal SCIN,\nEfb, CHIPS block it"];
    PMN_recruit [label="Neutrophil recruitment to the\nvegetation SURFACE"];
    PMN_excluded [label="PMNs CANNOT ENTER the avascular\ncore — the immune system faces\nthe same geometry the drug does", fillcolor="#f5c6c6"];
    Panton [label="Leukocidins (PVL, LukAB),\nα-haemolysin → PMN lysis\nat the interface"];
    Macrophage [label="Macrophage / monocyte\ninfiltrate at the annulus"];
    TLR2 [label="TLR2/NOD2 sensing of\nlipoteichoic acid, peptidoglycan"];
    IL1b [label="IL-1β (inflammasome)"];
    TNF_ie [label="TNF-α"];
    IL6_ie [label="IL-6 — the driver of the\nhepatic acute-phase response", fillcolor="#f0e0c0"];
    Mono_TF [label="Monocyte tissue factor →\nmore fibrin → BIGGER vegetation\n(immunity feeding the fortress)", fillcolor="#f0e0c0"];
  }

  //=========================================================================
  subgraph cluster_systemic {
    label="12. Systemic Inflammatory Response & Biomarkers"; style=filled; color="#d8d0b0"; fillcolor="#f9f7ec"; fontsize=13;
    CRP [label="CRP — slow (t½ ~19 h), the\nstandard trajectory marker;\nfailure to fall by ~50% in\n1-2 wk predicts complications", fillcolor="#f0e0c0"];
    PCT [label="Procalcitonin — faster kinetics,\nbetter for bacteraemia than\nfor vegetation burden"];
    ESR_WBC [label="ESR, leucocytosis, anaemia\nof inflammation"];
    Fever_curve [label="Persistent fever >7 d on\nappropriate therapy →\nabscess, embolism, or\ndrug fever", fillcolor="#f0e0c0"];
    Sepsis_ie [label="Sepsis / septic shock\n(SOFA, lactate) — the acute\nS. aureus presentation", fillcolor="#f5c6c6"];
    Splenomeg [label="Splenomegaly, clubbing\n(subacute phenotype)"];
  }

  //=========================================================================
  subgraph cluster_bacteraemia {
    label="13. Continuous Bacteraemia — the surface shell shedding into blood"; style=filled; color="#c8b8b0"; fillcolor="#f6f1ee"; fontsize=13;
    Shedding [label="Surface-shell shedding\n→ CONTINUOUS (not intermittent)\nbacteraemia — the diagnostic\nsignature of endovascular infection", fillcolor="#f5c6c6"];
    Blood_CFU [label="Bloodstream CFU/mL\n(typically 1-100 CFU/mL —\nwhy 3 sets of ≥10 mL matter)"];
    RES_clear [label="Reticuloendothelial clearance\n(splenic + hepatic macrophages)"];
    BC_positive [label="Blood culture positivity\n(detection threshold ~0.1-1 CFU/mL\nover 10 mL bottles)"];
    Time_to_clear [label="TIME TO BLOOD-CULTURE STERILISATION\nMSSA + nafcillin ~2-3 d;\nMRSA + vancomycin ~7-9 d\n— a clean validation target", fillcolor="#f0e0c0"];
    Persistent_bact [label="PERSISTENT BACTERAEMIA >5-7 d\n= metastatic focus, abscess,\nor an inadequate regimen\n→ mortality predictor", fillcolor="#f5c6c6"];
    Metastatic [label="Metastatic seeding: vertebral\nosteomyelitis, psoas/splenic abscess,\nseptic arthritis, epidural abscess"];
  }

  //=========================================================================
  subgraph cluster_valve {
    label="14. Valve Destruction & Haemodynamics — the leading indication for surgery"; style=filled; color="#dcb8c8"; fillcolor="#faeef3"; fontsize=13;
    Proteases [label="Bacterial proteases (aureolysin,\nSspA/B), α-toxin, host MMP-9\n/ neutrophil elastase"];
    Leaflet_perf [label="Leaflet PERFORATION\n/ destruction", fillcolor="#f5c6c6"];
    Chordal [label="Chordal rupture → flail leaflet\n(acute severe MR)"];
    Annular_abscess [label="Perivalvular / ANNULAR ABSCESS\n(aortic root; S. aureus, PVE)", fillcolor="#f5c6c6"];
    Fistula [label="Fistula, pseudoaneurysm,\nprosthetic DEHISCENCE"];
    Conduction [label="PR prolongation / AV block\n— an ECG marker of ROOT\nABSCESS extension", fillcolor="#f0e0c0"];
    Regurg [label="Acute valvular REGURGITATION\n(no time for chamber\ncompliance to adapt)", fillcolor="#f5c6c6"];
    Vol_overload [label="LV volume overload\n→ LVEDV ↑, wall stress ↑"];
    LAP_up [label="Acute MR: non-compliant LA →\nLAP ↑↑ → flash pulmonary oedema\nat a NORMAL LV size"];
    NTproBNP [label="NT-proBNP ↑ (wall stress)\n— strong prognostic marker"];
    HF_ie [label="HEART FAILURE — the #1\nindication for surgery and\nthe #1 driver of mortality", fillcolor="#f5c6c6"];
    Cardiogenic [label="Cardiogenic shock\n(class I emergency surgery,\n<24 h)", fillcolor="#f5c6c6"];
  }

  //=========================================================================
  subgraph cluster_embol {
    label="15. Embolic Events — a hazard that is FRONT-LOADED and falls steeply on effective therapy"; style=filled; color="#b0c0d8"; fillcolor="#eef2f9"; fontsize=13;
    Veg_size_risk [label="Vegetation >10 mm → risk ↑;\n>15 mm → risk ↑↑\n(and mobility, mitral position)", fillcolor="#f0e0c0"];
    Organism_risk [label="S. aureus, Candida, and\nS. gallolyticus carry the\nhighest embolic risk"];
    Emb_hazard [label="EMBOLIC HAZARD RATE\n(events per 1000 patient-days)", fillcolor="#f5c6c6"];
    Front_load [label="~65% of embolic events occur\nBEFORE or in the FIRST 2 WEEKS;\nhazard falls ~10-fold after\neffective therapy starts", fillcolor="#f5c6c6"];
    Stroke_isch [label="Ischaemic stroke\n(most common; often silent\non MRI in 30-50%)"];
    Haem_transf [label="Haemorrhagic transformation\n— the reason anticoagulation\nis dangerous here", fillcolor="#f0d0d0"];
    Mycotic [label="Infectious (mycotic) aneurysm\n— vasa vasorum seeding;\nrupture risk"];
    Splenic_inf [label="Splenic / renal infarct,\nsplenic abscess"];
    Septic_pulm [label="Septic pulmonary emboli\n(right-sided IE)"];
    Peripheral_signs [label="Janeway lesions, Osler nodes,\nsplinter haemorrhages, Roth spots"];
    Emb_prevention [label="Surgery for EMBOLISM PREVENTION\n(class IIa): the indication with\nthe clearest time dependence", fillcolor="#f0e0c0"];
  }

  //=========================================================================
  subgraph cluster_immunecomplex {
    label="16. Immune-Complex Phenomena"; style=filled; color="#c8c8d8"; fillcolor="#f2f2f8"; fontsize=13;
    IC_form [label="Circulating immune complexes\n(chronic antigenaemia)"];
    GN_ie [label="Immune-complex glomerulonephritis\n→ haematuria, RBC casts,\nAKI independent of drugs", fillcolor="#f0d0d0"];
    Low_C3 [label="Hypocomplementaemia\n(low C3/C4)"];
    RF_ie [label="Rheumatoid factor positivity\n(a minor Duke criterion in\nolder schemes)"];
    ANCA_ie [label="ANCA positivity in IE —\nMIMICS vasculitis; the classic\nand dangerous misdiagnosis", fillcolor="#f5c6c6"];
  }

  //=========================================================================
  subgraph cluster_dx {
    label="17. Diagnosis & Imaging — 2023 Duke-ISCVID criteria"; style=filled; color="#b8c0b0"; fillcolor="#f0f2ee"; fontsize=13;
    Duke [label="2023 Duke-ISCVID criteria\n(major: microbiology, imaging,\nsurgical findings)"];
    BC_sets [label="≥3 sets of blood cultures\nfrom separate sites,\nBEFORE antibiotics"];
    TTE [label="TTE — first-line; sensitivity\n~70% native, ~50% prosthetic"];
    TEE [label="TEE — sensitivity >90%;\nmandatory for PVE, abscess,\nand negative TTE with\nhigh suspicion", fillcolor="#d7ecd9"];
    PETCT [label="18F-FDG PET/CT — now a MAJOR\ncriterion for PVE/CIED\n(false negatives <3 mo\npost-op; false positives from\nsurgical inflammation)"];
    CardiacCT [label="Cardiac CT angiography —\nroot abscess, pseudoaneurysm,\npre-operative coronary map"];
    BrainMRI [label="Brain MRI — reclassifies\nstaging in ~25% via silent\nembolic lesions"];
    Serology_mol [label="Serology (Coxiella, Bartonella),\n16S/metagenomic sequencing of\nexcised valve"];
  }

  //=========================================================================
  subgraph cluster_surgery {
    label="18. Surgery & Source Control — the only intervention that changes N by orders of magnitude in minutes"; style=filled; color="#d0b8a8"; fillcolor="#f8f0ea"; fontsize=13;
    Surg_HF [label="INDICATION 1: heart failure\nfrom valve dysfunction (class I,\nurgent/emergency)", fillcolor="#f5c6c6"];
    Surg_uncontrolled [label="INDICATION 2: uncontrolled\ninfection — abscess, fistula,\nenlarging vegetation, persistent\nbacteraemia, fungal/MDR", fillcolor="#f5c6c6"];
    Surg_embolic [label="INDICATION 3: embolism prevention\n(vegetation >10 mm with prior\nembolus, or >15 mm)", fillcolor="#f0e0c0"];
    EASE [label="EASE trial (Kang, NEJM 2012):\nearly surgery cut EMBOLIC EVENTS\n(the composite driver) —\nnot all-cause mortality", fillcolor="#f0e0c0"];
    Debride [label="Radical debridement:\ninstantaneous log-reduction of\nN by ~3-5 logs; residual burden\ndecides relapse", fillcolor="#f5c6c6"];
    Valve_repl [label="Valve repair vs replacement\n(bioprosthesis / mechanical /\nhomograft for root destruction)"];
    Post_op_abx [label="Post-operative antibiotic clock:\nrestart the full course if\nvalve cultures/PCR are positive"];
    Op_risk [label="Operative risk (EuroSCORE II),\nstroke timing, coagulopathy,\nactive PWID"];
    Timing_paradox [label="TIMING PARADOX: the patients who\nbenefit most from early surgery\nare the ones least able to\ntolerate it", fillcolor="#f0e0c0"];
  }

  //=========================================================================
  subgraph cluster_pkphys {
    label="19. Host PK System & Covariates"; style=filled; color="#b0b8c8"; fillcolor="#eef0f5"; fontsize=13;
    CrCL [label="Creatinine clearance\n— the master covariate for\nvancomycin, gentamicin,\ndaptomycin, β-lactams", fillcolor="#f0e0c0"];
    ARC [label="Augmented renal clearance\n(young, septic, CrCL >130)\n→ UNDER-exposure", fillcolor="#f0d0d0"];
    Hypoalb [label="Hypoalbuminaemia in sepsis →\nFREE fraction ↑ → more drug\ndiffuses AND more is cleared\n(the two effects partly cancel)"];
    Vd_sepsis [label="Vd expansion in sepsis\n(capillary leak) → early\nunder-exposure of hydrophilic\nagents"];
    Obesity_pk [label="Obesity: dosing weight choices\n(vancomycin TBW, daptomycin TBW,\naminoglycoside AdjBW)"];
    CRRT_ECMO [label="CRRT / ECMO — extracorporeal\nclearance and circuit adsorption"];
    TDM [label="TDM: Bayesian AUC estimation\nfrom 1-2 samples (the modern\nstandard of care)", fillcolor="#d7ecd9"];
  }

  //=========================================================================
  subgraph cluster_tox {
    label="20. Drug Toxicity & the AKI Feedback Loop"; style=filled; color="#e0c0c0"; fillcolor="#fbf0f0"; fontsize=13;
    AKI_state [label="ACUTE KIDNEY INJURY\n(KDIGO stage from creatinine)", fillcolor="#f5c6c6"];
    AKI_feedback [label="AKI FEEDBACK LOOP:\nAKI → CrCL ↓ → vancomycin\nclearance ↓ → AUC ↑ → MORE AKI\n(a genuine positive feedback)", fillcolor="#f5c6c6"];
    Vanco_pip [label="Vancomycin + piperacillin-\ntazobactam: the best-documented\nadditive nephrotoxic pair", fillcolor="#f0d0d0"];
    CK_rise [label="CK rise / rhabdomyolysis\n(daptomycin; statin co-therapy)", fillcolor="#f0d0d0"];
    ALT_rise [label="Hepatotoxicity: rifampicin,\nnafcillin, oxacillin", fillcolor="#f0d0d0"];
    Cdiff [label="C. difficile infection —\n6 weeks of IV β-lactam is a\nsubstantial exposure", fillcolor="#f0d0d0"];
    Line_complic [label="Central line complications:\nthrombosis, secondary infection\n(the argument for POET/dalbavancin)"];
    Ototox [label="Ototoxicity / vestibulotoxicity\n(cumulative aminoglycoside)"];
  }

  //=========================================================================
  subgraph cluster_endpoints {
    label="21. Clinical Endpoints — what the model is asked to predict"; style=filled; color="#a8b8a0"; fillcolor="#eef2ea"; fontsize=13;
    EP_clear [label="Time to blood-culture\nsterilisation (days)", fillcolor="#d7ecd9"];
    EP_cure [label="MICROBIOLOGICAL CURE:\ntotal viable burden < 1 CFU\nin the whole vegetation", fillcolor="#d7ecd9"];
    EP_relapse [label="RELAPSE (same organism, <6 mo)\nvs REINFECTION (new organism)", fillcolor="#f0e0c0"];
    EP_emb [label="Symptomatic embolic event\n(cumulative incidence)"];
    EP_HF [label="Heart failure / valve surgery"];
    EP_mort [label="In-hospital and 6-month\nall-cause mortality\n(~20% and ~30%)", fillcolor="#f5c6c6"];
    EP_AKI [label="AKI incidence, dialysis"];
    EP_LOS [label="Length of stay, OPAT days,\nline-days avoided"];
    EP_logkill [label="THE LEDGER: log10 reduction\nDELIVERED vs the ~10.5 logs\nREQUIRED — the model's\ncentral accounting identity", fillcolor="#f5c6c6"];
  }

  //=========================================================================
  // ---- Edges: pathogenesis chain
  //=========================================================================
  Dental -> Inoculum_size; Skin_portal -> Inoculum_size; GI_portal -> Inoculum_size;
  GU_portal -> Inoculum_size; Prosthetic_portal -> Inoculum_size; CIED_portal -> Inoculum_size;
  Dental -> VGS; Skin_portal -> Saureus; GI_portal -> Efaecalis; GU_portal -> Efaecalis;
  Prosthetic_portal -> CoNS; Skin_portal -> Candida_ie;
  Saureus -> Adhesins; VGS -> Adhesins; Efaecalis -> Adhesins; CoNS -> Adhesins;
  HACEK -> Culture_neg;

  Jet_lesion -> NBTE_lesion; Degen_valve -> Jet_lesion; RHD -> Jet_lesion;
  Congenital -> Jet_lesion; Jet_lesion -> Shear_side;
  Jet_lesion -> TF_expose; Jet_lesion -> vWF_expose;
  TF_expose -> NBTE_lesion; vWF_expose -> Plt_adhere;
  Prosth_surface -> NBTE_lesion; Hypercoag -> NBTE_lesion;
  Endoth_activate -> Fibronectin; Fibronectin -> NBTE_lesion;
  Adhesins -> NBTE_lesion [label="colonise", color="#b03030"];
  Inoculum_size -> NBTE_lesion [label="seeding probability", color="#b03030"];

  NBTE_lesion -> Plt_adhere; Plt_adhere -> Plt_activate;
  Adhesins -> Plt_bridge; Plt_bridge -> Plt_activate;
  Plt_activate -> Alpha_granule; Alpha_granule -> Fibrin_polym;
  Saureus -> Thrombin_gen [label="coagulase / vWbp", color="#b03030"];
  Thrombin_gen -> Fibrin_polym; Fibrin_polym -> Veg_mass;
  Plt_activate -> Veg_mass; NETs -> Veg_mass;
  PMN_recruit -> NETs; Mono_TF -> Fibrin_polym;
  Veg_mass -> Veg_diam; Veg_mass -> Veg_avascular;
  Staphylokinase -> Fibrinolysis; Fibrinolysis -> Veg_mass [label="-", color="#3060b0"];
  Veg_mass -> Veg_positive_fb; Veg_positive_fb -> Veg_mass [color="#b03030"];

  //---- shells and physiology
  Veg_diam -> Shell_S; Veg_diam -> Shell_M; Veg_diam -> Shell_C;
  Shell_S -> Shell_M [label="growth inward"]; Shell_M -> Shell_C;
  Shell_C -> Anoxia; Shell_C -> Acid_core; Shell_C -> Stationary;
  Density -> Carrying_cap; Carrying_cap -> Stationary;
  Stationary -> Persister; Stationary -> SCV;
  Persister -> Switch_GD; Switch_GD -> Stationary;
  Biofilm_matrix -> Density; Shell_C -> Biofilm_matrix;
  Veg_avascular -> Diff_only; Veg_avascular -> PMN_excluded;
  Saureus -> Intracell;

  //---- diffusion physics
  Diff_only -> Thiele; MW_effect -> Thiele; Fibrin_bind -> Thiele;
  ProtBind -> Thiele; Consumption -> Thiele;
  Thiele -> Depth_exp; Depth_exp -> Lambda_rank;
  Depth_exp -> Core_AUC; Lag_time -> Peak_blunt; Peak_blunt -> Core_AUC;
  Veg_diam -> Depth_exp [label="path length L", color="#b03030"];
  Core_AUC -> Saturation;
  Lambda_rank -> Core_AUC;

  //---- beta-lactams
  Nafcillin -> PBP; Cefazolin -> PBP; Ceftriaxone -> PBP; Ampicillin -> PBP;
  Amp_Ctx -> PBP; PBP -> Autolysin;
  Autolysin -> Growth_dep; Growth_dep -> Shell_C [label="kill → 0 in core", color="#b03030"];
  Stationary -> Growth_dep [color="#b03030"];
  fT_MIC -> Growth_dep; Cont_inf -> fT_MIC;
  Inoc_effect -> Cefazolin [label="BlaZ type A", color="#b03030"];
  Density -> Inoc_effect; Density -> Eagle;
  Nafcillin -> BL_AIN; Nafcillin -> ALT_rise;
  Efaecalis -> Amp_Ctx; HLAR -> Amp_Ctx;

  //---- glyco/lipo
  Vanco -> Vanco_target; Vanco_target -> Growth_dep;
  Vanco -> Vanco_slow; Vanco_slow -> Time_to_clear [color="#b03030"];
  Vanco -> Vanco_MICcreep; Vanco_MICcreep -> Vanco_AKI;
  hVISA -> Vanco_MICcreep; Fibrin_bind -> Vanco_slow;
  Dapto -> Dapto_mech; Dapto_mech -> Dapto_stat;
  Dapto_stat -> Shell_C [label="kills NON-DIVIDING core", color="#2e8b57"];
  Dapto -> Dapto_mprF; Dapto_mprF -> Seesaw; Seesaw -> Ceftaroline;
  Dapto -> Dapto_CK; Dapto -> Dapto_surf;
  Dalba -> OPAT; Vanco -> Vanco_AKI;
  Density -> Dapto_mprF [label="high inoculum selects", color="#b03030"];

  //---- rifampicin / gentamicin
  Rif -> Rif_target; Rif_target -> Shell_C [label="penetrates + kills\nnon-growers", color="#2e8b57"];
  Rif -> Rif_mono_fail; Mut_freq -> Preexist; Preexist -> Rif_mono_fail;
  Rif_mono_fail -> rpoB; rpoB -> Fitness_cost;
  Rif -> Rif_induce; Rif_induce -> Vanco [label="clearance ↑ → AUC ↓", color="#b03030"];
  Rif_induce -> Dapto [label="clearance ↑", color="#b03030"];
  Rif -> Rif_PVE; Rif -> ARREST; Rif -> ALT_rise;
  Gent -> Gent_uptake; Anoxia -> Gent_uptake [label="no PMF → no uptake", color="#b03030"];
  Acid_core -> Gent_uptake [color="#b03030"];
  Gent -> Gent_synergy; PBP -> Gent_synergy;
  Gent -> Cosgrove; Gent -> Gent_ATN; Gent_ATN -> AKI_state;
  HLAR -> Gent_synergy [label="abolished", color="#b03030"];

  //---- newer agents / route
  Ceftaroline -> PBP; Ceftobiprole -> PBP;
  Linezolid -> EP_cure [label="bacteriostatic:\ninsufficient alone", color="#b03030"];
  Fosfomycin -> Dapto; Oral_stepdown -> EP_LOS; Oral_stepdown -> Line_complic;
  RODEO -> Oral_stepdown; Phage_lysin -> EP_cure;
  Antiplatelet -> Emb_hazard [label="NO effect (RCT)", color="#808080", style=dashed];
  Antiplatelet -> Haem_transf [label="bleeding ↑", color="#b03030"];
  Anticoag_ie -> Haem_transf;

  //---- resistance
  Density -> Mut_freq; Preexist -> MSW; MSW -> MPC;
  MPC -> Core_AUC [label="must be exceeded\nIN THE CORE", color="#b03030"];
  Hetero -> Tolerance; Stationary -> Tolerance;
  Tolerance -> EP_relapse [color="#b03030"];
  Comb_suppress -> Preexist [label="-", color="#3060b0"];
  Compensatory -> rpoB;

  //---- innate immunity
  TLR2 -> IL1b; TLR2 -> TNF_ie; IL1b -> IL6_ie; TNF_ie -> IL6_ie;
  Complement -> PMN_recruit; PMN_recruit -> Panton;
  PMN_recruit -> PMN_excluded; Macrophage -> Mono_TF;
  Shell_S -> TLR2; Shell_S -> Complement;
  IL6_ie -> CRP; IL6_ie -> PCT; IL6_ie -> ESR_WBC;
  Panton -> Leaflet_perf;

  //---- bacteraemia
  Shell_S -> Shedding; Shedding -> Blood_CFU;
  Blood_CFU -> RES_clear [label="-", color="#3060b0"];
  Blood_CFU -> BC_positive; BC_positive -> Time_to_clear;
  Time_to_clear -> Persistent_bact; Persistent_bact -> Metastatic;
  Persistent_bact -> Surg_uncontrolled;
  Blood_CFU -> Metastatic; Metastatic -> EP_mort;
  Blood_CFU -> Sepsis_ie;

  //---- valve destruction
  Shell_S -> Proteases; Proteases -> Leaflet_perf;
  Leaflet_perf -> Regurg; Chordal -> Regurg;
  Proteases -> Annular_abscess; Annular_abscess -> Fistula;
  Annular_abscess -> Conduction; Annular_abscess -> Surg_uncontrolled;
  Regurg -> Vol_overload; Regurg -> LAP_up;
  Vol_overload -> NTproBNP; LAP_up -> HF_ie;
  Vol_overload -> HF_ie; NTproBNP -> HF_ie;
  HF_ie -> Cardiogenic; HF_ie -> Surg_HF; Cardiogenic -> EP_mort;
  HF_ie -> EP_HF;

  //---- embolism
  Veg_diam -> Veg_size_risk; Veg_size_risk -> Emb_hazard;
  Organism_risk -> Emb_hazard; Staphylokinase -> Emb_hazard [label="fragmentation"];
  Emb_hazard -> Front_load; Emb_hazard -> Stroke_isch;
  Stroke_isch -> Haem_transf; Emb_hazard -> Mycotic;
  Emb_hazard -> Splenic_inf; Emb_hazard -> Septic_pulm;
  Emb_hazard -> Peripheral_signs; Emb_hazard -> EP_emb;
  Veg_size_risk -> Surg_embolic; Surg_embolic -> EASE;
  Front_load -> Emb_prevention; Emb_prevention -> Surg_embolic;
  Stroke_isch -> Op_risk;

  //---- immune complex
  Blood_CFU -> IC_form; IC_form -> GN_ie; IC_form -> Low_C3;
  IC_form -> RF_ie; IC_form -> ANCA_ie; GN_ie -> AKI_state;

  //---- diagnosis
  BC_positive -> Duke; TTE -> Duke; TEE -> Duke; PETCT -> Duke;
  Veg_diam -> TTE; Veg_diam -> TEE; Annular_abscess -> TEE;
  Prosth_surface -> PETCT; CardiacCT -> Annular_abscess;
  BrainMRI -> Stroke_isch; Serology_mol -> Culture_neg;
  BC_sets -> BC_positive; Duke -> Surg_HF;

  //---- surgery
  Surg_HF -> Debride; Surg_uncontrolled -> Debride; Surg_embolic -> Debride;
  Debride -> Veg_mass [label="−3 to −5 log10\nin minutes", color="#2e8b57"];
  Debride -> Valve_repl; Valve_repl -> Post_op_abx;
  Op_risk -> Timing_paradox; Timing_paradox -> EASE;
  EASE -> EP_emb; Debride -> EP_cure; Post_op_abx -> EP_relapse;

  //---- PK system
  CrCL -> Vanco; CrCL -> Gent; CrCL -> Dapto; CrCL -> Ampicillin;
  ARC -> CrCL; Hypoalb -> ProtBind; Vd_sepsis -> Vanco;
  Obesity_pk -> Vanco; CRRT_ECMO -> CrCL; TDM -> Vanco;
  TDM -> Core_AUC [label="optimises plasma,\nnot core", color="#808080", style=dashed];

  //---- toxicity loop
  Vanco_AKI -> AKI_state; AKI_state -> AKI_feedback;
  AKI_feedback -> CrCL [label="-", color="#b03030"];
  CrCL -> Vanco_AKI; Vanco_pip -> AKI_state;
  CK_rise -> Dapto; ALT_rise -> EP_LOS; Cdiff -> EP_LOS;
  Line_complic -> EP_LOS; Gent -> Ototox;
  AKI_state -> EP_AKI; AKI_state -> EP_mort;

  //---- endpoints ledger
  Core_AUC -> EP_logkill [color="#b03030"];
  Growth_dep -> EP_logkill; Dapto_stat -> EP_logkill;
  Density -> EP_logkill [label="10.5 logs REQUIRED", color="#b03030"];
  EP_logkill -> EP_cure; EP_cure -> EP_relapse [label="-", color="#3060b0"];
  Debride -> EP_logkill [color="#2e8b57"];
  Saturation -> EP_logkill;
  EP_clear -> EP_cure; Time_to_clear -> EP_clear;
  EP_relapse -> EP_mort; EP_emb -> EP_mort; EP_HF -> EP_mort;
  Oral_stepdown -> EP_cure [label="non-inferior (POET)", color="#2e8b57"];

  //=========================================================================
  // ---- Legend
  //=========================================================================
  subgraph cluster_legend {
    label="Legend"; style=filled; color="#999999"; fillcolor="#fafafa"; fontsize=13;
    L1 [label="Driver of pathology /\nrate-limiting obstacle", fillcolor="#f5c6c6"];
    L2 [label="Modifier, trade-off,\nor contested point", fillcolor="#f0e0c0"];
    L3 [label="Therapeutically favourable\nlever", fillcolor="#d7ecd9"];
    L4 [label="Toxicity / harm", fillcolor="#f0d0d0"];
    L5 [label="Neutral mechanism node"];
    L1 -> L2 [label="promotes", color="#b03030"];
    L2 -> L3 [label="inhibits (-)", color="#3060b0"];
    L3 -> L4 [label="no effect (RCT)", style=dashed, color="#808080"];
  }
}
