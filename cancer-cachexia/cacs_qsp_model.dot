        node [fillcolor = "#dde9ee", color = "#83a5b1"];

        NE_ACTH  [label = "ACTH"];
        NE_CORT  [label = "Cortisol (total, ug/dL)\nloss of diurnal rhythm, relative excess", peripheries = 2, fillcolor = "#cbdde5"];
        NE_GR    [label = "Glucocorticoid receptor in myofibre\n-> KLF15, REDD1, FoxO, MuRF1", shape = diamond, fillcolor = "#cbdde5"];
        NE_SNS   [label = "Sympathetic tone (NE spillover)", peripheries = 2, fillcolor = "#cbdde5"];
        NE_B2AR  [label = "Muscle beta2-adrenoceptor\n(chronic overdrive -> desensitisation)"];
        NE_T3    [label = "Low-T3 syndrome (rT3 up)\ncounter-regulatory, partly protective"];
        NE_HYPOG [label = "Hypogonadotropic hypogonadism"];
        NE_VITD  [label = "Vitamin D insufficiency"];
        NE_MELA  [label = "Circadian disruption / melatonin loss"];
