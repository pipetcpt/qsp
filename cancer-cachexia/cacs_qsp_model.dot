    /* ================================================================
       16. DRUGS AND THEIR TARGETS
       ================================================================ */
    subgraph cluster_pd {
        label = "16. 약물 · 표적 (Drugs and their molecular targets) — placed by WHICH ARM THEY CUT";
        style = "filled,rounded"; fillcolor = "#e9f7ef"; color = "#7dbf9a";
        fontsize = 13; fontcolor = "#26694a";
        node [shape = octagon, fillcolor = "#cdead9", color = "#6cae8a"];

        DR_ANAM [label = "ANAMORELIN\nGHSR-1a agonist\nARM A appetite + GH/IGF-1 mass"];
        DR_PONS [label = "PONSEGROMAB\nanti-GDF-15 mAb\nARM A at its source"];
        DR_MEG  [label = "MEGESTROL ACETATE\nprogestin: NPY up, cytokines down\nbut glucocorticoid-like on muscle"];
        DR_DEX  [label = "DEXAMETHASONE\nappetite now, myopathy later"];
        DR_OLZ  [label = "OLANZAPINE\nH1 / 5-HT2C / D2 / M-receptor\nappetite + antiemetic"];
        DR_ENO  [label = "ENOBOSARM\nselective androgen receptor modulator\nARM B synthesis"];
        DR_BIM  [label = "BIMAGRUMAB\nanti-ActRIIB mAb\nARM B SMAD blockade"];
        DR_TCZ  [label = "TOCILIZUMAB / CLAZAKIZUMAB\nIL-6R / IL-6 blockade\nARM B cytokine"];
        DR_ESP  [label = "ESPINDOLOL (MT-102)\nnon-selective beta-blocker + 5-HT1a\nARM B hypermetabolism, no dilution"];
        DR_EPA  [label = "EPA (n-3 PUFA)\nNF-kB / eicosanoid class switch"];
        DR_CEL  [label = "CELECOXIB / IBUPROFEN\nCOX-2 -> PGE2"];
        DR_MC4RA[label = "MC4R antagonist (investigational)\nreleases the melanocortin brake", style = "filled,dashed"];
        DR_GRLN [label = "Ghrelin / GHSR agonists (other)\nmacimorelin, ipamorelin", style = "filled,dashed"];
        DR_ACE  [label = "ACE inhibitor / ARB\nadjunct, angiotensin-II-driven atrophy", style = "filled,dashed"];
        DR_APEL [label = "Apelin / GDF-11 modulation (preclinical)", style = "filled,dashed"];
    }

    /* ================================================================
       17. NON-PHARMACOLOGIC INTERVENTIONS
       ================================================================ */
    subgraph cluster_nonpharm {
        label = "17. 비약물 중재 (Non-pharmacologic interventions)";
        style = "filled,rounded"; fillcolor = "#eaf5e6"; color = "#8dbd7c";
        fontsize = 13; fontcolor = "#3f6b31";
        node [shape = octagon, fillcolor = "#d5ebcd", color = "#7cae6b"];

        NP_RES  [label = "RESISTANCE EXERCISE\n2-3 x /week, progressive\nthe ONLY intervention that raises QUALITY"];
        NP_AER  [label = "Aerobic / interval training\nPGC-1alpha, mitochondrial biogenesis"];
        NP_NUTC [label = "Dietitian-led nutrition counselling\n(symptom-directed, not just calories)"];
        NP_PROT [label = "Protein / leucine / HMB bolus\n25-30 g with >= 2.5 g leucine per meal"];
        NP_PSY  [label = "Psychosocial support for patient AND family\ntargets eating-related distress"];
        NP_MULT [label = "MULTIMODAL PACKAGE (MENAC-style)\nexercise + nutrition + anti-inflammatory\n+ early oncological control"];
        NP_SYMP [label = "Symptom control: antiemetics, prokinetics,\npain, oral care, bowel regimen"];
    }

    /* ================================================================
       18. ANTICANCER THERAPY — CAUSE AND CURE
       ================================================================ */
    subgraph cluster_onc {
        label = "18. 항암치료 — 원인이자 치료 (Anticancer therapy: both aggravator and definitive cure)";
        style = "filled,rounded"; fillcolor = "#fdeeea"; color = "#dda28f";
        fontsize = 13; fontcolor = "#8c4630";
        node [fillcolor = "#f7ddd4", color = "#cf947f"];

        ON_CHEMO [label = "Cytotoxic chemotherapy", shape = octagon, fillcolor = "#f2cdc1"];
        ON_ICI   [label = "Immune checkpoint inhibitor", shape = octagon, fillcolor = "#f2cdc1"];
        ON_TARG  [label = "Targeted therapy / endocrine therapy", shape = octagon, fillcolor = "#f2cdc1"];
        ON_RESP  [label = "Tumour response (RECIST)\nBURDEN FALLS -> cachexia can reverse", shape = diamond, fillcolor = "#f2cdc1"];
        ON_MYOTX [label = "Direct chemo myotoxicity\ncisplatin, doxorubicin -> NF-kB, mito damage"];
        ON_TOXG  [label = "Grade 3-4 toxicity risk\nrises with low SMI (dose per kg lean, not per m2)", shape = hexagon, fillcolor = "#f6e0d8"];
        ON_DOSE  [label = "Relative dose intensity delivered", peripheries = 2, fillcolor = "#f2cdc1"];
        ON_STOP  [label = "Treatment discontinuation\nthe commonest proximate cause of death", shape = hexagon, fillcolor = "#f6e0d8"];
        ON_ICIRE [label = "Sarcopenia predicts POOR ICI response\n(muscle as an immune-competence surrogate)"];
    }

    /* ================================================================
       19. STAGING AND CLINICAL ENDPOINTS
       ================================================================ */
    subgraph cluster_end {
        label = "19. 병기 · 임상 엔드포인트 (Fearon staging & clinical endpoints)";
        style = "filled,rounded"; fillcolor = "#eef2f7"; color = "#96a7bd";
        fontsize = 13; fontcolor = "#3b4d66";
        node [shape = hexagon, fillcolor = "#dde5ef", color = "#8a9db4"];

        EP_PRECA [label = "PRECACHEXIA\n%WL <= 5%, anorexia, metabolic change"];
        EP_CACH  [label = "CACHEXIA (Fearon 2011)\n%WL > 5%, OR %WL > 2% with BMI < 20,\nOR %WL > 2% with sarcopenia"];
        EP_REFR  [label = "REFRACTORY CACHEXIA\nECOG 3-4, life expectancy < 3 months,\nunresponsive to anticancer therapy", shape = doubleoctagon, fillcolor = "#cfd9e6"];
        EP_WL    [label = "% weight loss over 6 months"];
        EP_BMI   [label = "Body mass index (kg/m2)"];
        EP_MARTIN[label = "Martin grade 0-4 (%WL x BMI grid)\nmedian OS 20.9 -> 4.3 months across grades"];
        EP_FAACT [label = "FAACT A/CS score (0-48)\n<= 37 defines anorexia"];
        EP_QOL   [label = "EORTC QLQ-C30 global health / physical function"];
        EP_SARCO [label = "CT-defined sarcopenia (L3 SMI)"];
        EP_HAZ   [label = "Instantaneous mortality hazard", peripheries = 2, fillcolor = "#cfd9e6"];
        EP_SURV  [label = "Overall survival"];
        EP_HOSP  [label = "Unplanned hospitalisation / infection"];
    }

    /* ================================================================
       EDGES
       ================================================================ */

    /* --- 1: tumour internals ---------------------------------------- */
    TU_TYPE  -> TU_BURD  [style = dashed, label = "growth rate"];
    TU_BURD  -> TU_PROL;
    TU_PROL  -> TU_BURD  [color = "#b04a4a", label = "Gompertz"];
    TU_BURD  -> TU_HYPOX;
    TU_HYPOX -> TU_WARB;
    TU_WARB  -> TU_LAC;
    TU_WARB  -> TU_GLUT;
    TU_BURD  -> TU_NECR;
    TU_BURD  -> TU_EXO;
    TU_BURD  -> TU_AAUP;
    TU_HYPOX -> TU_GDF15 [label = "HIF-1a, ATF4"];
    TU_BURD  -> TU_GDF15;
    TU_BURD  -> TU_IL6;
    TU_BURD  -> TU_LIF;
    TU_BURD  -> TU_TNF;
    TU_BURD  -> TU_IL1B;
    TU_BURD  -> TU_ACTA;
    TU_BURD  -> TU_PTHRP;
    TU_BURD  -> TU_TWEAK;
    TU_BURD  -> TU_ZAG;
    TU_BURD  -> TU_PIF  [style = dashed];
    TU_TYPE  -> TU_GDF15 [style = dashed];
    TU_NECR  -> IM_MAC;
    TU_EXO   -> MU_NFKB2 [style = dashed, label = "miR-21 -> TLR7"];

    /* --- 1 -> 2: cachexins into the circulation ---------------------- */
    TU_GDF15 -> IM_GDF15S [penwidth = 1.6];
    TU_IL6   -> IM_IL6S   [penwidth = 1.6];
    TU_LIF   -> IM_LIFS;
    TU_TNF   -> IM_TNFS;
    TU_ACTA  -> IM_ACTAS  [penwidth = 1.6];
    TU_IL1B  -> IM_NFKB;
    IM_MAC   -> IM_IL6S;
    IM_MAC   -> IM_TNFS;
    IM_MAC   -> IM_NFKB;
    IM_NFKB  -> IM_IL6S;
    IM_MDSC  -> IM_IL6S;
    TU_BURD  -> IM_MDSC;
    IM_LPS   -> IM_MAC;
    IM_IL6S  -> IM_IL10 [label = "counter-reg"];
    IM_IL10  -> IM_IL6S [color = "#2f7a3f", arrowhead = tee];
    IM_IL6S  -> IM_NLR;
    IM_TNFS  -> IM_NLR;
    BC_MUSC  -> IM_MSTN [color = "#2f7a3f", label = "muscle IS the source\n-> myostatin FALLS"];

    /* --- 2 -> 3: hepatic acute-phase response ------------------------ */
    IM_IL6S  -> LV_STAT3 [penwidth = 1.5];
    IM_LIFS  -> LV_STAT3;
    LV_STAT3 -> LV_CRP   [penwidth = 1.5];
    LV_STAT3 -> LV_FIB;
    LV_STAT3 -> LV_HEPC;
    LV_STAT3 -> LV_ALB   [color = "#b04a4a", arrowhead = tee, label = "transcription down"];
    LV_STAT3 -> LV_MASS;
    LV_FIB   -> LV_APRAA;
    LV_CRP   -> LV_APRAA;
    LV_APRAA -> MU_AAOUT [color = "#e07b1f", style = bold, penwidth = 1.6, label = "APR demands\nmuscle nitrogen"];
    LV_HEPC  -> LV_ANEM;
    LV_ANEM  -> FN_FATIG;
    LV_ANEM  -> EN_ACT [color = "#b04a4a", arrowhead = tee];
    TU_LAC   -> LV_GNG   [penwidth = 1.4];
    LV_GNG   -> EN_CORI  [penwidth = 1.4];
    MU_AAPL  -> LV_GNG;
    LV_GNG   -> LV_UREA;
    LV_UREA  -> EP_WL    [style = dashed, label = "N loss"];
    IM_IL6S  -> LV_KETO  [color = "#b04a4a", arrowhead = tee];
    LV_KETO  -> MU_AAOUT [color = "#b04a4a", arrowhead = tee, label = "no protein-sparing\nswitch"];
    LV_CRP   -> LV_MGPS;
    LV_ALB   -> LV_MGPS;
    LV_ALB   -> BC_EDEMA [color = "#b04a4a", arrowhead = tee, label = "oncotic pressure"];
    LV_ALB   -> PK_FCRN;
    LV_MASS  -> BC_OLBM  [color = "#2f7a3f"];

    /* --- ARM A-i: GDF-15 -> brainstem -------------------------------- */
    IM_GDF15S -> BS_AP    [penwidth = 1.8, color = "#2f5f9e"];
    BS_AP     -> BS_GFRAL [penwidth = 1.8, color = "#2f5f9e"];
    BS_GFRAL  -> BS_CALCR [penwidth = 1.6, color = "#2f5f9e"];
    BS_GFRAL  -> BS_DBH   [penwidth = 1.4, color = "#2f5f9e"];
    BS_CALCR  -> BS_PBN;
    BS_DBH    -> BS_PBN;
    BS_PBN    -> BS_SIG   [penwidth = 1.6, color = "#2f5f9e"];
    BS_5HT3   -> BS_AP;
    BS_VAGAL  -> BS_AP;
    BS_VAGAL  -> BS_SIG;
    BS_SIG    -> BS_NAUS  [penwidth = 1.5];
    BS_NAUS   -> BS_EMES;
    BS_NAUS   -> BS_CTA;
    BS_CTA    -> GI_INTAKE [color = "#b04a4a", arrowhead = tee, penwidth = 1.3];
    BS_SIG    -> HY_ANOR  [penwidth = 1.8, color = "#2f5f9e", label = "ARM A"];
    BS_PBN    -> HY_PVN;
    GI_MUC    -> BS_5HT3;
    ON_CHEMO  -> BS_5HT3;

    /* --- ARM A-ii: hypothalamic melanocortin -------------------------- */
    HY_ARC   -> HY_AGRP;
    HY_ARC   -> HY_POMC;
    HY_POMC  -> HY_MSH;
    HY_MSH   -> HY_MC4R  [penwidth = 1.4];
    HY_AGRP  -> HY_MC4R  [color = "#2f7a3f", arrowhead = tee, label = "inverse agonist"];
    HY_MC4R  -> HY_PVN   [penwidth = 1.4];
    HY_PVN   -> HY_ANOR  [penwidth = 1.6];
    HY_PVN   -> HY_CRHN;
    HY_PVN   -> NE_SNS;
    AD_LEPS  -> HY_LEP;
    HY_LEP   -> HY_AGRP  [color = "#b04a4a", arrowhead = tee];
    HY_LEP   -> HY_POMC;
    HY_INSC  -> HY_POMC;
    HY_GHRE  -> HY_GHSR;
    HY_GHSR  -> HY_AGRP  [color = "#2f7a3f", penwidth = 1.3];
    HY_LEAP2 -> HY_GHSR  [color = "#b04a4a", arrowhead = tee, label = "endogenous antagonist"];
    HY_IL1B  -> HY_POMC  [penwidth = 1.4, color = "#b04a4a"];
    HY_IL1B  -> HY_AGRP  [color = "#b04a4a", arrowhead = tee, penwidth = 1.6, label = "BLOCKS the\ncompensation"];
    HY_IL1B  -> HY_LEAP2;
    HY_5HT   -> HY_POMC;
    IM_IL6S  -> HY_IL1B;
    IM_TNFS  -> HY_IL1B;
    IM_IL6S  -> HY_5HT   [label = "IDO / free Trp"];
    HY_OREX  -> GI_INTAKE [color = "#2f7a3f"];
    HY_ANOR  -> HY_OREX  [color = "#b04a4a", arrowhead = tee];
    HY_CRHN  -> NE_ACTH;
    HY_ANOR  -> GI_INTAKE [color = "#b04a4a", arrowhead = tee, penwidth = 2.0, label = "ARM A output"];
    HY_ANOR  -> EP_FAACT [color = "#b04a4a", arrowhead = tee];

    /* --- 6: intake and GI barriers ------------------------------------ */
