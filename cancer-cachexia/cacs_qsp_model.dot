        PK_ENOD [label = "Enobosarm depot (3 mg PO qd)", peripheries = 2, fillcolor = "#c8dfea"];
        PK_ENOC [label = "Enobosarm plasma (t1/2 ~ 20 h)", peripheries = 2, fillcolor = "#c8dfea"];
        PK_ESPD [label = "Espindolol depot (10 mg PO bid)", peripheries = 2, fillcolor = "#c8dfea"];
        PK_ESPC [label = "Espindolol plasma (t1/2 ~ 4-6 h)", peripheries = 2, fillcolor = "#c8dfea"];
        PK_EPAD [label = "EPA depot (2 g/d)", peripheries = 2, fillcolor = "#c8dfea"];
        PK_EPAC [label = "EPA membrane enrichment\nslow, weeks-scale turnover", peripheries = 2, fillcolor = "#c8dfea"];
        PK_CELD [label = "Celecoxib depot (200 mg bid)", peripheries = 2, fillcolor = "#c8dfea"];
        PK_CELC [label = "Celecoxib plasma (t1/2 ~ 11 h)", peripheries = 2, fillcolor = "#c8dfea"];
        PK_CYP  [label = "CYP3A4 / CYP1A2 clearance\nDDI node (azoles, smoking)", shape = diamond, fillcolor = "#c8dfea"];
    }

