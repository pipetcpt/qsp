        PK_PONSC [label = "Ponsegromab central (IgG1 mAb)\nt1/2 ~ 3 weeks", peripheries = 2, fillcolor = "#e4d5ba"];
        PK_PONSP [label = "Ponsegromab peripheral", peripheries = 2, fillcolor = "#e4d5ba"];
