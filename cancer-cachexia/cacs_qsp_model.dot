       ================================================================ */
    subgraph cluster_func {
        label = "13. [축 C] 근육의 질 · 신체 기능 (AXIS C: muscle QUALITY & physical function) — the axis that mass-only drugs miss";
        style = "filled,rounded"; fillcolor = "#f4ecfb"; color = "#b48ad4";
        fontsize = 13; fontcolor = "#5f3583";
        node [fillcolor = "#e8daf5", color = "#a67cc6"];

        FN_MYOQ  [label = "MUSCLE QUALITY (force per kg)\ndriven DOWN by inflammation, UP by loading,\nDILUTED by fast mass accrual", peripheries = 2, fillcolor = "#dcc7ef"];
        FN_PGC1  [label = "PGC-1alpha / mitochondrial biogenesis\ncollapses early, before mass is lost", peripheries = 2, fillcolor = "#dcc7ef"];
        FN_MITO  [label = "Mitochondrial content & OXPHOS capacity", peripheries = 2, fillcolor = "#dcc7ef"];
        FN_MFN   [label = "Mitophagy imbalance (BNIP3, Fis1, OPA1 loss)\nfragmented network"];
        FN_ATP   [label = "ATP supply per gram of muscle"];
        FN_MHC   [label = "Myosin heavy-chain nitration / carbonylation\nforce lost WITHOUT mass lost", shape = diamond, fillcolor = "#dcc7ef"];
        FN_RYR   [label = "RyR1 oxidation -> Ca2+ leak\nexcitation-contraction uncoupling"];
        FN_FIBER [label = "Fibre-type shift IIa -> IIx, fatigue-prone"];
        FN_NMJ   [label = "Neuromuscular junction remodelling / denervation"];
        FN_DIL   [label = "QUALITY DILUTION of newly added mass\nmass added faster than mitochondria are built\n= low force-per-kg tissue", shape = parallelogram, fillcolor = "#e2d0f2"];
        FN_GRIP  [label = "Handgrip strength (kg)\nGRIP = mass x quality", shape = hexagon, fillcolor = "#eee2f8"];
        FN_STAIR [label = "Stair-climb power / 6MWT / SPPB", shape = hexagon, fillcolor = "#eee2f8"];
        FN_FATIG [label = "Fatigue (FACIT-F)", shape = hexagon, fillcolor = "#eee2f8"];
        FN_ECOG  [label = "ECOG performance status (0-4)", peripheries = 2, fillcolor = "#dcc7ef"];
    }

