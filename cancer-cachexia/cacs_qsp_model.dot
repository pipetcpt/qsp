        PK_ANAD [label = "Anamorelin gut depot\n100 mg PO qd, fasted; Tmax ~1 h", peripheries = 2, fillcolor = "#c8dfea"];
        PK_ANAC [label = "Anamorelin plasma\nt1/2 ~ 7 h · CYP3A4 substrate", peripheries = 2, fillcolor = "#c8dfea"];
        PK_MEGD [label = "Megestrol acetate depot\n400-800 mg/d oral suspension", peripheries = 2, fillcolor = "#c8dfea"];
        PK_MEGC [label = "Megestrol plasma\nt1/2 ~ 30 h, dose-saturable absorption", peripheries = 2, fillcolor = "#c8dfea"];
        PK_DEXD [label = "Dexamethasone depot\n4 mg PO qd", peripheries = 2, fillcolor = "#c8dfea"];
        PK_DEXC [label = "Dexamethasone plasma\nt1/2 ~ 4 h, biological t1/2 36-54 h", peripheries = 2, fillcolor = "#c8dfea"];
