    EP_HAZ   -> EP_SURV  [color = "#b04a4a", arrowhead = tee, penwidth = 1.8];
    EP_HOSP  -> EP_HAZ;
    EP_FAACT -> EP_QOL   [color = "#2f7a3f"];
    GI_INTAKE-> EP_FAACT [color = "#2f7a3f", penwidth = 1.3];
    BS_NAUS  -> EP_FAACT [color = "#b04a4a", arrowhead = tee];
    TU_BURD  -> EP_HAZ   [penwidth = 1.6, label = "tumour burden itself"];

    /* --- legend -------------------------------------------------------------- */
    subgraph cluster_legend {
        label = "Legend";
        style = "filled,rounded"; fillcolor = "#ffffff"; color = "#9aa3ab";
        fontsize = 12; fontcolor = "#444c54";
        node [shape = plaintext, fillcolor = "#ffffff", style = "", fontsize = 10];
        LEG [label = <<table border="0" cellborder="0" cellspacing="2">
            <tr><td align="left"><b>double border</b></td><td align="left">ODE state in cacs_mrgsolve_model.R</td></tr>
            <tr><td align="left"><b>octagon</b></td><td align="left">drug / intervention</td></tr>
            <tr><td align="left"><b>hexagon</b></td><td align="left">clinical endpoint / read-out</td></tr>
            <tr><td align="left"><b>diamond</b></td><td align="left">switch, moderator or decision node</td></tr>
            <tr><td align="left"><b>parallelogram</b></td><td align="left">flux / transfer process</td></tr>
            <tr><td align="left"><b>dashed box</b></td><td align="left">hypothesis or investigational agent</td></tr>
            <tr><td align="left"><font color="#b04a4a"><b>red / tee</b></font></td><td align="left">inhibition or antagonism</td></tr>
            <tr><td align="left"><font color="#2f7a3f"><b>green</b></font></td><td align="left">restorative / protective</td></tr>
            <tr><td align="left"><font color="#e07b1f"><b>bold orange</b></font></td><td align="left">the amino-acid vicious cycle (muscle feeds the tumour)</td></tr>
            <tr><td align="left"><font color="#7d3cb0"><b>bold purple</b></font></td><td align="left">Axis C — quality dilution of rapidly added mass</td></tr>
            <tr><td align="left"><font color="#c2568b"><b>pink</b></font></td><td align="left">contribution to resting energy expenditure</td></tr>
            <tr><td align="left"><b>ARM A</b></td><td align="left">intake / anorexia (GDF-15 &#8594; GFRAL &#8594; melanocortin)</td></tr>
            <tr><td align="left"><b>ARM B</b></td><td align="left">catabolism + hypermetabolism (STAT3 / SMAD &#8594; FoxO)</td></tr>
            <tr><td align="left"><b>AXIS C</b></td><td align="left">muscle quality — force per kilogram</td></tr>
            </table>>];
    }
}
