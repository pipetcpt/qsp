    subgraph cluster_body {
        label = "12. 체성분 · 장기 결과 (Body composition & organ-level consequences)";
        style = "filled,rounded"; fillcolor = "#f0f0f0"; color = "#a8a8a8";
        fontsize = 13; fontcolor = "#4d4d4d";
        node [fillcolor = "#e2e2e2", color = "#9a9a9a"];

        BC_MUSC  [label = "Skeletal muscle mass (kg)\n25 kg -> 18-20 kg", peripheries = 2, fillcolor = "#d2d2d2"];
        BC_OLBM  [label = "Non-muscle lean mass (viscera, skin, bone)\nrelatively spared; liver even grows", peripheries = 2, fillcolor = "#d2d2d2"];
        BC_EDEMA [label = "Extracellular fluid / oedema / ascites\nhypoalbuminaemia -> oncotic pressure falls\nMASKS true tissue loss on the scale", peripheries = 2, fillcolor = "#d2d2d2"];
        BC_BW    [label = "Body weight (kg)", shape = hexagon, fillcolor = "#e8e8e8"];
        BC_WLHIST[label = "Weight ~6 months ago (transit chain)\nthe denominator for %WL", peripheries = 2, fillcolor = "#d2d2d2"];
        BC_SMI   [label = "L3 skeletal muscle index (cm2/m2)\nsarcopenia cut-off 43-55 (M) / 39-41 (F)", shape = hexagon, fillcolor = "#e8e8e8"];
        BC_CARD  [label = "Cardiac atrophy / cachectic cardiomyopathy\nLV mass falls, fibrosis rises"];
        BC_DIAPH [label = "Diaphragm and intercostal wasting\n-> dyspnoea, weak cough, pneumonia"];
        BC_BONE  [label = "Bone loss / fracture risk"];
        BC_IMM   [label = "Immune incompetence, infection risk"];
    }

    /* ================================================================
