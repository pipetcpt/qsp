/* =====================================================================
   Cancer Anorexia-Cachexia Syndrome (CACS) — QSP Mechanistic Map
   ---------------------------------------------------------------------
   The organising idea of this map (and of cacs_mrgsolve_model.R):

     CACHEXIA IS NOT STARVATION.

   In simple starvation the body defends itself: intake falls, so resting
   energy expenditure falls with it, lipolysis spares protein, and refeeding
   restores what was lost. In cancer cachexia every one of those three
   compensations is broken, and it is the BREAKAGE, not the negative energy
   balance, that makes the syndrome refractory to food.

   The map is therefore drawn as TWO INDEPENDENT ARMS that converge on
   skeletal muscle, plus a THIRD axis that nutrition and most drugs never
   touch at all:

     ARM A  INTAKE      tumour -> GDF-15 -> GFRAL/RET on area postrema
       (anorexia)       -> CALCR/CGRP + DBH neurons -> nausea, conditioned
                        taste aversion -> hypothalamic melanocortin tone
                        shifts (POMC up, AgRP compensation BLOCKED by
                        central IL-1beta/PGE2) -> energy intake falls
                        AND the falling-leptin rescue signal fails.

     ARM B  CATABOLISM  tumour -> IL-6/LIF/TNF/TWEAK -> myocyte JAK-STAT3
       (+ hypermetab.)  and activin A -> ActRIIB -> SMAD2/3 -> FoxO
                        -> MAFbx/MuRF1 -> ubiquitin-proteasome + autophagy;
                        in parallel IGF-1/Akt/mTORC1 is suppressed
                        (ANABOLIC RESISTANCE), and PTHrP/IL-6 brown the
                        white adipose tissue so REE rises while intake falls.

     AXIS C MUSCLE      inflammation nitrates myosin, leaks RyR1, wrecks
       QUALITY          mitochondria and collapses PGC-1alpha, so FORCE PER
                        KILOGRAM falls independently of mass. Mass that is
                        added quickly without mitochondrial biogenesis is
                        DILUTED, low-quality mass.

   Axis C is why this map exists. It is the mechanistic explanation for the
   single most reproducible result in cachexia drug development:

       anamorelin (ROMANA 1/2) and enobosarm (POWER 1/2) BOTH met their
       lean-body-mass endpoints and BOTH missed their function endpoints
       (handgrip strength, stair-climb power).

   Every intervention on this map is placed by WHICH ARM IT CUTS, because
   that is what determines which endpoint it can possibly move:

     anamorelin (GHSR-1a)      ARM A appetite + GH/IGF-1 mass  -> LBM, weight; NOT grip
     megestrol acetate         ARM A appetite only, + glucocorticoid-like
                               catabolism                      -> fat and fluid, NOT LBM
     olanzapine (H1/5-HT2C/D2) ARM A appetite + antiemetic      -> weight, appetite
     dexamethasone             ARM A short-lived appetite, ARM B WORSENED
                               after ~3-4 weeks (steroid myopathy)
     ponsegromab (anti-GDF-15) ARM A at its source              -> intake, weight, activity
     tocilizumab (anti-IL-6R)  ARM B cytokine arm + APR         -> CRP, weight stabilisation
     bimagrumab (anti-ActRIIB) ARM B SMAD arm                   -> large LBM gain, fat loss
     enobosarm (SARM)          ARM B synthesis arm              -> LBM; NOT stair-climb power
     espindolol (beta-block)   ARM B hypermetabolism + catabolism, no
                               mass dilution                   -> weight AND grip
     EPA / celecoxib           ARM B upstream NF-kB / eicosanoid
     resistance exercise       AXIS C — the only arm that raises quality
     nutrition (ONS/EN/PN)     substrate only; cannot cross anabolic resistance
     effective anticancer Rx   removes the driver — the definitive therapy

   A fourth structural feature is the POINT OF NO RETURN. Sustained
   inflammation depletes the Pax7+ satellite-cell pool and myonuclei, and
   the depletion is drawn (and coded) as effectively irreversible. Once it
   has happened, cutting arms A and B no longer restores mass: this is
   refractory cachexia, and it is why the Fearon 2011 staging is a
   one-way street.

   Render:
     dot -Tsvg cacs_qsp_model.dot -o cacs_qsp_model.svg
     dot -Tpng -Gdpi=150 cacs_qsp_model.dot -o cacs_qsp_model.png
   ===================================================================== */

digraph CACS_QSP {
    rankdir = TB;
    compound = true;
    splines = spline;
    concentrate = false;
    nodesep = 0.28;
    ranksep = 0.55;
    fontname = "Helvetica";
    labelloc = "t";
    label = <<b>Cancer Anorexia-Cachexia Syndrome — Quantitative Systems Pharmacology Map</b><br/>
             <font point-size="13">tumour cachexins &#8594; (A) anorexia via GFRAL/melanocortin + (B) catabolism via STAT3/SMAD-FoxO + (C) loss of muscle QUALITY &#8594; mass, function and survival dissociate</font><br/>
             <font point-size="11">19 mechanistic modules · 247 nodes · 457 edges · states carried as ODEs in cacs_mrgsolve_model.R are drawn with a double border</font>>;
    fontsize = 22;
    bgcolor = "white";

    node [shape = box, style = "rounded,filled", fontname = "Helvetica",
          fontsize = 10, penwidth = 1.0, margin = "0.09,0.05"];
    edge [fontname = "Helvetica", fontsize = 8, color = "#5c6670",
          arrowsize = 0.62, penwidth = 0.9];

    /* ---------- shared visual vocabulary ------------------------------
       double border (peripheries=2) = ODE state in the mrgsolve model
       octagon                       = drug / intervention
       hexagon                       = clinical endpoint / read-out
       diamond                       = regulatory switch or moderator
       parallelogram                 = flux / transfer process
       red edge                      = inhibition / antagonism
       green edge                    = restorative / protective
       orange edge                   = the amino-acid vicious cycle
       purple edge                   = the quality-dilution path (Axis C)
       ---------------------------------------------------------------- */

    /* ================================================================
       1. TUMOUR COMPARTMENT AND TUMOUR-DERIVED CACHEXINS
       ================================================================ */
    subgraph cluster_tumor {
        label = "1. 종양 구획 · 종양 유래 카켁신 (Tumour compartment & tumour-derived cachexins)";
        style = "filled,rounded"; fillcolor = "#f7ecec"; color = "#c99a9a";
        fontsize = 13; fontcolor = "#7d4a4a";
        node [fillcolor = "#f0dcdc", color = "#c08a8a"];

        TU_BURD  [label = "Tumour burden (g)\nGompertz growth · TVOL0 x exp(ln(TMAX/TVOL0)(1-e^-kg t))\nthe single upstream driver of the whole map", peripheries = 2, fillcolor = "#e6c6c6"];
        TU_PROL  [label = "Proliferation / clonal expansion\ndoubling time 60-120 d (solid tumours)"];
        TU_TYPE  [label = "Histology moderator\npancreatic ~ 80% · gastro-oesophageal ~ 60%\nNSCLC ~ 45% · breast/prostate ~ 15-30%", shape = diamond, fillcolor = "#e0c0c0"];
        TU_HYPOX [label = "Intratumoural hypoxia\nHIF-1alpha stabilisation"];
        TU_WARB  [label = "Aerobic glycolysis (Warburg)\nglucose -> lactate even in O2"];
        TU_LAC   [label = "Lactate export (MCT4)\nsubstrate for hepatic Cori cycle"];
        TU_GLUT  [label = "Tumour glucose avidity\n(FDG-PET SUVmax correlates with weight loss)"];
        TU_AAUP  [label = "Tumour amino-acid uptake\nglutamine addiction · BCAA · LAT1/ASCT2", shape = parallelogram, fillcolor = "#e8d0d0"];
        TU_NECR  [label = "Tumour necrosis -> DAMPs\nHMGB1 · ATP · mtDNA"];
        TU_EXO   [label = "Tumour extracellular vesicles\nHsp70/Hsp90 · miR-21 -> TLR7 in myotubes"];
        TU_GDF15 [label = "GDF-15 / MIC-1 / NAG-1 secretion\nthe dominant anorexigenic cachexin\nhealthy ~ 0.5 ng/mL, cachexia 3-10 ng/mL"];
        TU_IL6   [label = "IL-6 secretion\ntumour + stroma + TAM"];
        TU_LIF   [label = "LIF (leukaemia inhibitory factor)\ngp130 ligand, potent in murine C26"];
        TU_TNF   [label = "TNF-alpha ('cachectin')\nlocal > systemic in humans"];
        TU_IL1B  [label = "IL-1beta\nalso acts centrally via PGE2"];
        TU_ACTA  [label = "Activin A (INHBA)\nrises in cachexia · ActRIIB ligand"];
        TU_PTHRP [label = "PTHrP\ndrives adipose browning via PTH1R"];
        TU_TWEAK [label = "TWEAK (TNFSF12)\n-> Fn14 on myofibre -> NF-kB"];
        TU_ZAG   [label = "ZAG / lipid-mobilising factor (AZGP1)\nbeta3-adrenergic-like lipolytic signal"];
        TU_PIF   [label = "Proteolysis-inducing factor (PIF/DAF)\ncontroversial in humans - drawn as hypothesis", style = "rounded,filled,dashed"];
    }

    /* ================================================================
       2. SYSTEMIC INFLAMMATION — THE CIRCULATING MEDIATOR POOL
       ================================================================ */
    subgraph cluster_infl {
        label = "2. 전신 염증 · 순환 매개체 풀 (Systemic inflammation — circulating mediator pool)";
        style = "filled,rounded"; fillcolor = "#fdf0e4"; color = "#e0ac72";
        fontsize = 13; fontcolor = "#8a5820";
        node [fillcolor = "#f8e2cc", color = "#d79c60"];

        IM_MAC    [label = "Tumour-associated macrophages / monocytes\nM1 skew · amplify IL-6 and TNF"];
        IM_MDSC   [label = "Myeloid-derived suppressor cells\nexpand with tumour burden"];
        IM_NFKB   [label = "Systemic NF-kB tone\nfeed-forward cytokine amplification"];
        IM_IL6S   [label = "Plasma IL-6 (pg/mL)\nbaseline ~2 · severe cachexia 20-60", peripheries = 2, fillcolor = "#f2d2b0"];
        IM_TNFS   [label = "Plasma TNF-alpha (pg/mL)\nmodest rise in humans", peripheries = 2, fillcolor = "#f2d2b0"];
        IM_GDF15S [label = "Plasma GDF-15 (ng/mL)\nstrongest single predictor of weight loss", peripheries = 2, fillcolor = "#f2d2b0"];
        IM_ACTAS  [label = "Plasma activin A (pg/mL)\nrises ~2-4x", peripheries = 2, fillcolor = "#f2d2b0"];
        IM_MSTN   [label = "Plasma myostatin (ng/mL)\nPARADOX: FALLS in human cachexia\n(muscle is the source; less muscle = less myostatin)", peripheries = 2, fillcolor = "#f2d2b0"];
        IM_LIFS   [label = "Plasma LIF / OSM\ngp130 family, shares STAT3"];
        IM_LPS    [label = "Gut barrier failure -> LPS / TLR4\nchemotherapy and mucositis amplify"];
        IM_NLR    [label = "Neutrophil-lymphocyte ratio\nsimple prognostic surrogate", shape = hexagon, fillcolor = "#f6dcc0"];
        IM_IL10   [label = "IL-10 / TGF-beta counter-regulation\ninsufficient to close the loop"];
    }

    /* ================================================================
       3. HEPATIC ACUTE-PHASE RESPONSE AND METABOLIC REPROGRAMMING
       ================================================================ */
    subgraph cluster_liver {
        label = "3. 간 급성기 반응 · 대사 재프로그래밍 (Hepatic acute-phase response & metabolic reprogramming)";
        style = "filled,rounded"; fillcolor = "#f2f5e9"; color = "#a9bd7e";
        fontsize = 13; fontcolor = "#5c6f33";
        node [fillcolor = "#e6edd6", color = "#9cb06e"];

        LV_STAT3 [label = "Hepatocyte gp130 / JAK1 / STAT3\nIL-6 + LIF converge"];
        LV_CRP   [label = "C-reactive protein (mg/L)\nbaseline <3 · cachexia 10-100", peripheries = 2, fillcolor = "#dbe6c4"];
        LV_FIB   [label = "Fibrinogen, SAA, haptoglobin\npositive acute-phase proteins"];
        LV_ALB   [label = "Serum albumin (g/L)\nNEGATIVE acute-phase protein\nfalls 42 -> 25-30", peripheries = 2, fillcolor = "#dbe6c4"];
        LV_APRAA [label = "Amino-acid diversion into APR\n~ 2.6 g muscle protein per 1 g fibrinogen", shape = parallelogram, fillcolor = "#e2ebd0"];
        LV_GNG   [label = "Hepatic gluconeogenesis\nCori cycle + glutamine + alanine"];
        LV_UREA  [label = "Ureagenesis -> obligatory nitrogen loss\nnegative nitrogen balance"];
        LV_HEPC  [label = "Hepcidin (IL-6/STAT3 driven)\nferroportin block -> functional iron deficiency"];
        LV_ANEM  [label = "Anaemia of inflammation\nHb falls, fatigue rises"];
        LV_MASS  [label = "Hepatomegaly\nliver mass RISES while muscle falls\n(masks weight loss on the scale)", peripheries = 2, fillcolor = "#dbe6c4"];
        LV_KETO  [label = "Impaired ketogenesis\nthe starvation protein-sparing switch FAILS", shape = diamond, fillcolor = "#dfe9c8"];
        LV_MGPS  [label = "modified Glasgow Prognostic Score\nCRP >10 (+1) and albumin <35 (+1) -> 0/1/2", shape = hexagon, fillcolor = "#e9f0da"];
    }

    /* ================================================================
       4. ARM A(i) — BRAINSTEM GFRAL / AREA POSTREMA
       ================================================================ */
    subgraph cluster_brainstem {
        label = "4. [팔 A-i] 뇌간 GFRAL · 최후영역 (ARM A-i: brainstem GFRAL / area postrema)";
        style = "filled,rounded"; fillcolor = "#eaf0f8"; color = "#89a5c9";
        fontsize = 13; fontcolor = "#39557d";
        node [fillcolor = "#d9e4f2", color = "#7d97bd"];

        BS_AP    [label = "Area postrema (circumventricular)\noutside the blood-brain barrier"];
        BS_GFRAL [label = "GFRAL - RET co-receptor complex\nEXCLUSIVE receptor for GDF-15\nexpressed ONLY in AP/NTS", shape = diamond, fillcolor = "#cbdaee"];
        BS_CALCR [label = "AP CALCR / CGRP neurons\nmeal termination + malaise"];
        BS_DBH   [label = "NTS DBH+ noradrenergic neurons\nproject to PBN and hypothalamus"];
        BS_PBN   [label = "Parabrachial nucleus CGRP relay\nfinal common path for aversive anorexia"];
        BS_5HT3  [label = "Enterochromaffin 5-HT -> 5-HT3\nvagal chemoreceptor trigger"];
        BS_VAGAL [label = "Vagal afferents\nCCK · PYY(3-36) · GLP-1 · distension"];
        BS_NAUS  [label = "Nausea (0-10)\ndose-limiting for intake", peripheries = 2, fillcolor = "#cbdaee"];
        BS_EMES  [label = "Emesis / retching"];
        BS_CTA   [label = "Conditioned taste aversion\nfood becomes a learned aversive cue", shape = diamond, fillcolor = "#cbdaee"];
        BS_SIG   [label = "Aversive brainstem drive (effect cmt)\nintegrates GDF-15 + 5-HT3 + vagal load", peripheries = 2, fillcolor = "#cbdaee"];
    }

    /* ================================================================
       5. ARM A(ii) — HYPOTHALAMIC MELANOCORTIN
       ================================================================ */
    subgraph cluster_hypo {
        label = "5. [팔 A-ii] 시상하부 멜라노코르틴 (ARM A-ii: hypothalamic melanocortin system)";
        style = "filled,rounded"; fillcolor = "#eef0fa"; color = "#9a9fd0";
        fontsize = 13; fontcolor = "#464a86";
        node [fillcolor = "#dfe2f5", color = "#8e93c8"];

        HY_ARC   [label = "Arcuate nucleus (median eminence, leaky BBB)\nfirst-order energy sensor"];
        HY_AGRP  [label = "AgRP / NPY neurons (orexigenic tone)\nSHOULD fire when fat mass falls\nbut are silenced in cachexia", peripheries = 2, fillcolor = "#d0d4ef"];
        HY_POMC  [label = "POMC / CART neurons (anorexigenic tone)\ninappropriately ACTIVE", peripheries = 2, fillcolor = "#d0d4ef"];
        HY_MSH   [label = "alpha-MSH release"];
        HY_MC4R  [label = "MC4R on PVN neurons\nthe anorexia switch", shape = diamond, fillcolor = "#d0d4ef"];
        HY_PVN   [label = "Paraventricular nucleus\nintegrates to feeding + CRH + sympathetic output"];
        HY_LEP   [label = "Leptin (falls with fat mass)\nthe rescue signal that FAILS to rescue"];
        HY_INSC  [label = "Central insulin signal"];
        HY_GHRE  [label = "Ghrelin (acyl) RISES in cachexia\nyet appetite does not - ghrelin resistance", shape = diamond, fillcolor = "#d0d4ef"];
        HY_LEAP2 [label = "LEAP2 / ghrelin ratio rises\nendogenous GHSR-1a antagonist"];
        HY_GHSR  [label = "GHSR-1a on ARC AgRP neurons\nanamorelin's target"];
        HY_OREX  [label = "Orexin / MCH lateral hypothalamus\narousal-linked feeding drive"];
        HY_5HT   [label = "Hypothalamic serotonin\nIDO/kynurenine shunt raises free Trp"];
        HY_IL1B  [label = "Central IL-1beta / COX-2 / PGE2 (EP4)\nBLOCKS the AgRP compensation", shape = diamond, fillcolor = "#d0d4ef"];
        HY_CRHN  [label = "CRH neurons -> HPA activation"];
        HY_ANOR  [label = "Integrated anorexia drive\n(the ARM A output)", peripheries = 2, fillcolor = "#d0d4ef"];
    }

    /* ================================================================
       6. INTAKE AND THE GASTROINTESTINAL TRACT
       ================================================================ */
    subgraph cluster_intake {
        label = "6. 섭취 · 위장관 (Energy intake & gastrointestinal barriers)";
        style = "filled,rounded"; fillcolor = "#f3f0fb"; color = "#b0a2d2";
        fontsize = 13; fontcolor = "#59477f";
        node [fillcolor = "#e6e0f4", color = "#a294c6";]

        GI_INTAKE [label = "Energy intake (kcal/d)\nweight-stable requirement ~ 30 kcal/kg", peripheries = 2, fillcolor = "#dbd2ee"];
        GI_PROT   [label = "Protein intake (g/kg/d)\ntarget 1.2-1.5 · typical achieved 0.7-0.9", peripheries = 2, fillcolor = "#dbd2ee"];
        GI_SATIETY[label = "Early satiety\nthe most reported single symptom"];
        GI_GASTRO [label = "Delayed gastric emptying / gastroparesis\nautonomic + opioid + tumour"];
        GI_TASTE  [label = "Dysgeusia / hyposmia\nzinc, chemotherapy, radiotherapy"];
        GI_MUC    [label = "Mucositis / odynophagia\nchemo- and radiation-induced"];
        GI_OBSTR  [label = "Mechanical: obstruction, ascites, dysphagia"];
        GI_MALAB  [label = "Malabsorption / exocrine insufficiency\n(pancreatic and upper-GI primaries)"];
        GI_CONST  [label = "Opioid-induced constipation"];
        GI_PAIN   [label = "Uncontrolled pain / symptom burden"];
        GI_DEPR   [label = "Depression, anxiety, eating-related distress\n'food becomes a battleground' (patient + family)"];
        GI_ONS    [label = "Oral nutritional supplement (ONS)\n+300 to +600 kcal/d, adherence-limited", shape = octagon, fillcolor = "#cfc3e6"];
        GI_ENPN   [label = "Enteral / parenteral nutrition\nbypasses intake, NOT anabolic resistance", shape = octagon, fillcolor = "#cfc3e6"];
    }

    /* ================================================================
       7. ARM B(i) — SKELETAL MUSCLE PROTEOLYSIS
       ================================================================ */
    subgraph cluster_prote {
        label = "7. [팔 B-i] 골격근 단백 이화 (ARM B-i: skeletal muscle proteolysis)";
        style = "filled,rounded"; fillcolor = "#fbeced"; color = "#d68f96";
        fontsize = 13; fontcolor = "#8e3d47";
        node [fillcolor = "#f4d9dc", color = "#c9848c"];

        MU_GP130  [label = "Myofibre gp130 / JAK2"];
        MU_STAT3  [label = "Muscle STAT3 activation (effect cmt)\nthe IL-6/LIF arm", peripheries = 2, fillcolor = "#eec6cb"];
        MU_ACTRIIB[label = "ActRIIB (ACVR2B) receptor\nshared by activin A, myostatin, GDF-11", shape = diamond, fillcolor = "#eec6cb"];
        MU_SMAD   [label = "SMAD2/3 phosphorylation (effect cmt)\nthe activin arm", peripheries = 2, fillcolor = "#eec6cb"];
        MU_FN14   [label = "Fn14 (TNFRSF12A) induction\nTWEAK receptor, appears only in atrophying muscle"];
        MU_NFKB2  [label = "Myofibre NF-kB (p65 / p50)\nTNF + TWEAK + TLR"];
        MU_FOXO   [label = "FoxO1 / FoxO3 nuclear activity\nthe atrogene master switch", peripheries = 2, fillcolor = "#eec6cb"];
        MU_KLF15  [label = "KLF15 (glucocorticoid-induced)\namplifies FoxO / branched-chain catabolism"];
        MU_MAFBX  [label = "MAFbx / atrogin-1 (FBXO32)\ntargets MyoD and eIF3f"];
        MU_MURF1  [label = "MuRF1 (TRIM63)\nubiquitinates myosin heavy chain"];
        MU_UPS    [label = "26S ubiquitin-proteasome flux\ndominant proteolytic route", peripheries = 2, fillcolor = "#eec6cb"];
        MU_AUTO   [label = "Autophagy-lysosome flux (LC3-II, p62, Bnip3)\ndisordered, not simply increased", peripheries = 2, fillcolor = "#eec6cb"];
        MU_CALP   [label = "Calpain-1/2 and caspase-3\nrelease myofilaments from the sarcomere\n(the rate-limiting first cut)", shape = parallelogram, fillcolor = "#f0cdd2"];
        MU_ROS    [label = "NOX2 / mitochondrial ROS\noxidative stress", peripheries = 2, fillcolor = "#eec6cb"];
        MU_AAOUT  [label = "Net amino-acid efflux from muscle\n(the vicious cycle currency)", shape = parallelogram, fillcolor = "#f0cdd2"];
        MU_AAPL   [label = "Plasma amino-acid / BCAA pool", peripheries = 2, fillcolor = "#eec6cb"];
    }

    /* ================================================================
       8. ARM B(ii) — ANABOLIC ARM AND ANABOLIC RESISTANCE
       ================================================================ */
    subgraph cluster_anab {
        label = "8. [팔 B-ii] 동화 신호 · 동화 저항 (ARM B-ii: anabolic signalling & anabolic resistance)";
        style = "filled,rounded"; fillcolor = "#eaf6f1"; color = "#7fb9a0";
        fontsize = 13; fontcolor = "#2f6b52";
        node [fillcolor = "#d5ebe1", color = "#6faa92"];

        AN_GH    [label = "GH secretion (pulse amplitude)\nRISES in cachexia", peripheries = 2, fillcolor = "#c2e0d3"];
        AN_GHR   [label = "Hepatic GH resistance (SOCS3 up, GHR down)\nGH rises but IGF-1 does not follow", shape = diamond, fillcolor = "#c2e0d3"];
        AN_IGF1  [label = "Plasma IGF-1 (ng/mL)\n150 -> 70-100 in cachexia", peripheries = 2, fillcolor = "#c2e0d3"];
        AN_IGFBP [label = "IGFBP-1/3 shift, reduced free IGF-1"];
        AN_IR    [label = "Insulin resistance (skeletal muscle)\nGLUT4 translocation impaired"];
        AN_AKT   [label = "PI3K / Akt (effect cmt)\nnode where anabolism and FoxO meet", peripheries = 2, fillcolor = "#c2e0d3"];
        AN_MTOR  [label = "mTORC1 activity (effect cmt)", peripheries = 2, fillcolor = "#c2e0d3"];
        AN_S6K   [label = "p70-S6K1 / rpS6 phosphorylation"];
        AN_4EBP  [label = "4E-BP1 release of eIF4E"];
        AN_REDD1 [label = "REDD1 / DDIT4 (glucocorticoid, hypoxia)\nbrakes mTORC1"];
        AN_GCN2  [label = "GCN2 / eIF2alpha / ATF4\namino-acid deprivation response"];
        AN_LEU   [label = "Leucine sensing (Sestrin2, CASTOR1, SLC38A9)\nthreshold ~ 2.5 g leucine per meal", shape = diamond, fillcolor = "#c2e0d3"];
        AN_AAT   [label = "Amino-acid transporters LAT1 / SNAT2"];
        AN_MPS   [label = "Muscle protein synthesis rate (FSR %/d)\n1.5 -> 0.9 %/d", shape = parallelogram, fillcolor = "#cbe5da"];
        AN_ARES  [label = "ANABOLIC RESISTANCE index\nthe fraction of a protein bolus that is WASTED\nWHY FOOD ALONE DOES NOT WORK", peripheries = 2, fillcolor = "#c2e0d3"];
        AN_SATC  [label = "Pax7+ satellite-cell pool / myonuclei\nDEPLETED, effectively irreversibly\n(the point of no return)", peripheries = 2, fillcolor = "#c2e0d3"];
        AN_MYOD  [label = "MyoD / myogenin differentiation block\nPax7 retained, fusion arrested"];
        AN_TEST  [label = "Testosterone (ng/dL)\nhypogonadism of chronic illness", peripheries = 2, fillcolor = "#c2e0d3"];
        AN_AR    [label = "Androgen receptor in myonuclei\nenobosarm's target"];
    }

    /* ================================================================
       9. ADIPOSE TISSUE — LIPOLYSIS AND BROWNING
       ================================================================ */
    subgraph cluster_fat {
        label = "9. 지방조직 · 지방분해 및 갈색화 (Adipose tissue: lipolysis & browning)";
        style = "filled,rounded"; fillcolor = "#fdf7e3"; color = "#d9c274";
        fontsize = 13; fontcolor = "#7f6a1c";
        node [fillcolor = "#f7eec9", color = "#cbb264"];

        AD_FAT   [label = "Fat mass (kg)\nLOST BEFORE MUSCLE - the earliest signal", peripheries = 2, fillcolor = "#f0e2ae"];
        AD_ATGL  [label = "ATGL (PNPLA2) - rate-limiting\nATGL-null mice are protected from cachexia"];
        AD_HSL   [label = "Hormone-sensitive lipase (LIPE)"];
        AD_LIPO  [label = "Lipolytic flux", shape = parallelogram, fillcolor = "#f4e8bd"];
        AD_LPL   [label = "Lipoprotein lipase suppression\nstorage arm switched off"];
        AD_FFA   [label = "Plasma free fatty acids / glycerol"];
        AD_UCP1  [label = "WAT browning: UCP1+ beige adipocytes\nfutile proton leak = pure heat", peripheries = 2, fillcolor = "#f0e2ae"];
        AD_PTH1R [label = "PTH1R (PTHrP receptor) on adipocyte"];
        AD_B3AR  [label = "beta3-adrenoceptor (sympathetic + ZAG)"];
        AD_LEPS  [label = "Leptin secretion falls with fat mass"];
        AD_ADIPO [label = "Adiponectin RISES (unlike obesity)"];
        AD_FIBR  [label = "Adipose fibrosis / ECM remodelling\nlimits refilling even after tumour control"];
        AD_ECTOP [label = "Ectopic lipid: myosteatosis, hepatic steatosis\nlow muscle radiodensity on CT"];
        AD_VAT   [label = "Visceral vs subcutaneous partition"];
    }

    /* ================================================================
       10. ENERGY BALANCE AND HYPERMETABOLISM
       ================================================================ */
    subgraph cluster_energy {
        label = "10. 에너지 균형 · 과대사 (Energy balance & hypermetabolism)";
        style = "filled,rounded"; fillcolor = "#fdeef4"; color = "#dba2bc";
        fontsize = 13; fontcolor = "#8b3f5f";
        node [fillcolor = "#f7dde8", color = "#cd93ac"];

        EN_REE   [label = "Resting energy expenditure (kcal/d)\nRISES while intake falls - the defining paradox", peripheries = 2, fillcolor = "#f2cbdc"];
        EN_PREE  [label = "Predicted REE (Harris-Benedict / Mifflin)"];
        EN_HYPERM[label = "Hypermetabolism: REE/pREE > 1.10\nseen in ~ 50% of advanced cancer", shape = hexagon, fillcolor = "#f6d7e4"];
        EN_AEE   [label = "Activity energy expenditure\nfalls with ECOG - partly offsets REE rise"];
        EN_DIT   [label = "Diet-induced thermogenesis (~10% of intake)"];
        EN_TEE   [label = "Total energy expenditure", shape = parallelogram, fillcolor = "#f4d3e0"];
        EN_CORI  [label = "Cori cycle futile flux\n6 ATP consumed per 2 ATP the tumour gains\n~ 250-300 kcal/d at high burden", shape = parallelogram, fillcolor = "#f4d3e0"];
        EN_FUT   [label = "Other futile cycles: triglyceride-FFA, protein turnover"];
        EN_BAL   [label = "Net energy balance (kcal/d)", shape = parallelogram, fillcolor = "#f4d3e0"];
        EN_ACT   [label = "Physical activity level (steps/d, PAL)", peripheries = 2, fillcolor = "#f2cbdc"];
    }

    /* ================================================================
       11. NEUROENDOCRINE AXES
       ================================================================ */
    subgraph cluster_neuro {
        label = "11. 신경내분비 축 (Neuroendocrine axes)";
