    c_Cpfc  -> m_phi      [color = "#C46A78", penwidth = 2.0, label = "denominator"];
    m_phi   -> c_worry    [color = "#A08A5E", label = "via z"];
    c_worry -> c_worry    [color = "#C46A78", label = "rho = 0.55 self-recruitment"];
    c_worry -> m_psy      [color = "#C46A78", penwidth = 1.6, label = "weight 0.62"];
    c_worry -> k_pswq     [color = "#C46A78"];
    c_Eamy  -> q_Sglu     [color = "#C46A78", label = "stress raises release prob."];

    /* --- 3 serotonin ------------------------------------------------------ */
    s_drn   -> s_rel      [color = "#C08A3E"];
    s_rel   -> s_ex       [color = "#C08A3E"];
    s_ex    -> s_sert     [color = "#C08A3E"];
    s_sert  -> s_ex       [color = "#C08A3E", arrowhead = tee, label = "reuptake"];
    s_ex    -> s_auto     [color = "#C08A3E", label = "sustained excess desensitises"];
    s_auto  -> s_drn      [color = "#C08A3E", arrowhead = tee, label = "negative feedback"];
    s_auto  -> s_gate     [color = "#C08A3E", penwidth = 1.6];
    s_gate  -> s_ex       [color = "#C08A3E", style = dashed];
    s_ex    -> s_post     [color = "#C08A3E", penwidth = 1.6];
