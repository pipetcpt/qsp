    d_esc   -> e_sex      [color = "#3E8F86", style = dashed];
    d_ven   -> e_act      [color = "#3E8F86", style = dashed];
    d_ven   -> e_disc     [color = "#3E8F86", style = dashed];

    /* --- 12 GABAergic / alpha2delta / multireceptor drugs ------------------------------ */
    d_pgb   -> d_pgbocc   [color = "#3E8F86", penwidth = 1.6];
    d_crcl  -> d_pgb      [color = "#3E8F86", label = "CL scales with CrCl"];
    d_pgbocc-> q_traf     [color = "#3E8F86", penwidth = 1.8];
    d_pgbocc-> e_dizz     [color = "#3E8F86"];
    d_pgbocc-> e_wt       [color = "#3E8F86"];
    d_lzp   -> d_bzocc    [color = "#3E8F86"];
    d_alp   -> d_bzocc    [color = "#3E8F86"];
    d_bzocc -> g_bzsite   [color = "#3E8F86", penwidth = 1.8];
    d_bzocc -> g_dep      [color = "#3E8F86", penwidth = 1.6];
    d_qtp   -> d_qtpocc   [color = "#3E8F86"];
    d_qtpocc-> z_h1       [color = "#3E8F86"];
    d_qtpocc-> e_sed      [color = "#3E8F86", penwidth = 1.6];
    d_qtpocc-> n_net      [color = "#3E8F86", arrowhead = tee, label = "norquetiapine"];
    d_qtpocc-> e_wt       [color = "#3E8F86"];
    d_hydrox-> z_h1       [color = "#3E8F86", style = dashed];
    d_adh   -> d_esc      [color = "#3E8F86", style = dashed];
    d_adh   -> d_pgb      [color = "#3E8F86", style = dashed];

    /* --- 13 non-pharmacological -------------------------------------------------------- */
    x_cbt   -> p_bdnf     [color = "#5E9E4E", label = "0.30"];
    x_cbt   -> c_Eamy     [color = "#5E9E4E", arrowhead = tee, penwidth = 1.6, label = "0.55 decay"];
    x_cbt   -> c_worry    [color = "#5E9E4E", arrowhead = tee, penwidth = 1.6, label = "0.80 decay"];
    x_expos -> p_ext      [color = "#5E9E4E"];
    x_relax -> a_sns      [color = "#5E9E4E", arrowhead = tee];
    x_mind  -> v_ie       [color = "#5E9E4E", arrowhead = tee];
    x_exer  -> p_bdnf     [color = "#5E9E4E", style = dashed];
    x_cbt   -> x_persist  [color = "#5E9E4E", penwidth = 1.6];
    x_persist-> k_relap   [color = "#5E9E4E", arrowhead = tee, style = dashed];

    /* --- 14 adverse effects ------------------------------------------------------------- */
    e_nau   -> e_burden   [color = "#C46A6A"];
    e_sex   -> e_burden   [color = "#C46A6A"];
    e_act   -> e_burden   [color = "#C46A6A"];
    e_sed   -> e_burden   [color = "#C46A6A", penwidth = 1.5];
    e_dizz  -> e_burden   [color = "#C46A6A", penwidth = 1.5];
    e_sed   -> e_cog      [color = "#C46A6A"];
    e_cog   -> e_falls    [color = "#C46A6A"];
    e_burden-> t_drop     [color = "#C46A6A", penwidth = 1.8];
    e_wt    -> t_drop     [color = "#C46A6A", style = dashed];
    e_disc  -> t_drop     [color = "#C46A6A", style = dashed];

    /* --- 15 trial machinery --------------------------------------------------------------- */
    t_enrol -> t_fluct    [color = "#7A7A93", penwidth = 1.6];
    t_fluct -> k_hama     [color = "#7A7A93", penwidth = 1.6, label = "ADDITIVE"];
    t_visit -> t_expect   [color = "#7A7A93", penwidth = 1.6];
    t_expect-> c_Cpfc     [color = "#7A7A93", penwidth = 1.8, label = "&#215; (1 + 0.55&#183;EXPECT)"];
    t_rater -> t_fluct    [color = "#7A7A93", style = dashed];
    m_sat   -> t_assay    [color = "#A08A5E", penwidth = 1.6];
    t_expect-> t_assay    [color = "#7A7A93", penwidth = 1.6];
    t_assay -> k_hama     [color = "#7A7A93", style = dashed, label = "shrinks the MEASURED delta"];
    t_drop  -> t_locf     [color = "#7A7A93", penwidth = 1.6];
    t_locf  -> k_hama     [color = "#7A7A93", label = "freezes early trajectory"];
    t_sever -> k_hama     [color = "#7A7A93", style = dashed];
    m_sat   -> t_sever    [color = "#A08A5E", style = dashed];

    /* --- 16 the equation ---------------------------------------------------------------- */
    m_phi   -> m_z        [color = "#A08A5E", penwidth = 2.0];
    m_z     -> m_psy      [color = "#A08A5E", label = "0.30 &#215; Phi_n"];
    m_phi   -> m_mult     [color = "#A08A5E", style = dashed];
    m_psy   -> m_sat      [color = "#A08A5E"];
    m_som   -> m_sat      [color = "#A08A5E"];
    m_psy   -> k_psy      [color = "#A08A5E", penwidth = 1.8];
    m_som   -> k_som      [color = "#A08A5E", penwidth = 1.8];
    k_psy   -> k_hama     [color = "#666666", penwidth = 1.8];
    k_som   -> k_hama     [color = "#666666", penwidth = 1.8];

    /* --- 17 endpoints -------------------------------------------------------------------- */
    k_hama  -> k_resp     [color = "#666666"];
    k_hama  -> k_rem      [color = "#666666"];
    k_hama  -> k_relap    [color = "#666666"];
    k_hama  -> k_cgi      [color = "#666666"];
    k_hama  -> k_gad7     [color = "#666666", style = dashed];
    k_hama  -> k_func     [color = "#666666"];
    k_func  -> k_qol      [color = "#666666"];
    k_madrs -> k_func     [color = "#666666", style = dashed];

    /* --- 18 comorbidity -------------------------------------------------------------------- */
    c_Cpfc  -> y_mdd      [color = "#8E6FB5", arrowhead = tee, style = dashed];
    y_mdd   -> k_madrs    [color = "#8E6FB5"];
    y_ins   -> z_deficit  [color = "#8E6FB5", style = dashed];
    y_pan   -> c_cea      [color = "#8E6FB5", style = dashed];
    y_sad   -> c_bnst     [color = "#8E6FB5", style = dashed];
    y_aud   -> g_Igaba    [color = "#8E6FB5", style = dashed, label = "acute up, chronic down"];
    y_bzdep -> g_dep      [color = "#8E6FB5", style = dashed];

    /* --- edges for the added nodes ------------------------------------------------------- */
    v_pregn  -> g_neuro   [color = "#8E6FB5", style = dashed];
    v_thyroid-> k_som     [color = "#8E6FB5", style = dashed, label = "inflates the score,\nnot the disease"];
    v_age    -> e_falls   [color = "#8E6FB5", style = dashed];
    v_age    -> e_hypona  [color = "#8E6FB5", style = dashed];
    c_thal   -> c_bla     [color = "#C46A78"];
    c_ofc    -> c_vmpfc   [color = "#C46A78"];
    c_dmn    -> c_worry   [color = "#C46A78"];
    c_stri   -> c_worry   [color = "#C46A78", label = "habit"];
    s_trp    -> s_tph2    [color = "#C08A3E"];
    s_tph2   -> s_rel     [color = "#C08A3E"];
    s_mao    -> s_ex      [color = "#C08A3E", arrowhead = tee];
    p_infl   -> s_trp     [color = "#4E9188", arrowhead = tee, label = "kynurenine shunt"];
    p_infl   -> p_bdnf    [color = "#4E9188", arrowhead = tee];
    p_epig   -> h_gr      [color = "#4E9188", arrowhead = tee, style = dashed];
    n_ex     -> n_iu      [color = "#B8A33A"];
    n_iu     -> c_Cpfc    [color = "#B8A33A", style = dashed];
    n_ex     -> n_bp      [color = "#B8A33A"];
    n_bp     -> e_burden  [color = "#B8A33A", style = dashed];
    g_gat    -> g_int     [color = "#4B87B8", arrowhead = tee];
    g_kcc2   -> g_int     [color = "#4B87B8", style = dashed];
    g_mrs    -> g_Igaba   [color = "#4B87B8", style = dashed];
    q_eaat   -> q_rel     [color = "#5E9E4E", arrowhead = tee];
    q_snare  -> q_rel     [color = "#5E9E4E"];
    h_gr     -> h_dst     [color = "#B85A8E"];
    h_gr     -> h_diur    [color = "#B85A8E"];
    a_vagal  -> a_hrv     [color = "#8F8B6A"];
    c_bnst   -> a_startle [color = "#C46A78", style = dashed];
    z_frag   -> z_rem     [color = "#7A6BB5"];
    d_2c19   -> d_esc     [color = "#3E8F86", label = "CL/F covariate"];
    d_vort   -> s_sert    [color = "#3E8F86", style = dashed, arrowhead = tee];
    d_agom   -> s_2c      [color = "#3E8F86", style = dashed, arrowhead = tee];
    d_clon   -> d_bzocc   [color = "#3E8F86", style = dashed];
    d_taper  -> g_reb     [color = "#3E8F86", arrowhead = tee, penwidth = 1.5];
    x_icbt   -> x_cbt     [color = "#5E9E4E", style = dashed];
    x_comb   -> x_cbt     [color = "#5E9E4E", style = dashed];
    x_comb   -> d_esc     [color = "#5E9E4E", style = dashed];
    e_qtc    -> e_burden  [color = "#C46A6A", style = dashed];
    e_metab  -> e_burden  [color = "#C46A6A", style = dashed];
    e_bleed  -> e_burden  [color = "#C46A6A", style = dashed];
    e_hypona -> e_burden  [color = "#C46A6A", style = dashed];
    t_multi  -> t_expect  [color = "#7A7A93", style = dashed];
    t_nma    -> t_assay   [color = "#7A7A93", style = dashed];
    k_hama   -> k_ntb     [color = "#666666", style = dashed];
    c_worry  -> k_hours   [color = "#C46A78", style = dashed];
    y_pain   -> q_a2d1    [color = "#8E6FB5", style = dashed];

    /* --- the four clocks, drawn as one comparison ------------------------------------------ */
    subgraph cluster_clock {
        label = <<b>The four clocks, side by side &#8212; and the fifth</b>>;
        style = "rounded,filled"; fillcolor = "#FAF5EC"; color = "#A08A5E";
        fontsize = 15; fontcolor = "#6B5A33";
        node [fillcolor = "#EFE2D0", color = "#A08A5E", shape = box];

        w_bz   [label = "I_gaba: hours\nbenzodiazepine\n(then -20% over ~40 d)"];
        w_pgb  [label = "S_glu: ~2 days\npregabalin\n(no tolerance term)"];
        w_ssri [label = "C_pfc: ~13 d gate + ~30 d growth\nSSRI / SNRI\n(sigmoid, not exponential)"];
        w_amy  [label = "E_amy: weeks\nCBT and sustained 5-HT\n(and it does not rebound)"];
        w_pbo  [label = "EXPECT + FLUCT: FASTEST OF ALL\n53% of the 8-week placebo effect is\nalready present at week 1 (Khan 2011)",
                shape = note, fillcolor = "#DCC79E", penwidth = 2.0];
        w_bz -> w_pgb -> w_ssri -> w_amy [style = invis];
        w_amy -> w_pbo [style = invis];
    }
    g_Igaba -> w_bz   [style = dashed, color = "#A08A5E"];
    q_Sglu  -> w_pgb  [style = dashed, color = "#A08A5E"];
    c_Cpfc  -> w_ssri [style = dashed, color = "#A08A5E"];
    c_Eamy  -> w_amy  [style = dashed, color = "#A08A5E"];
    t_expect-> w_pbo  [style = dashed, color = "#A08A5E"];
}
