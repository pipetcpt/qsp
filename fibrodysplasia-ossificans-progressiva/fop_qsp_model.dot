/* =====================================================================
   Fibrodysplasia Ossificans Progressiva (FOP) — QSP mechanistic map
   ACVR1/ALK2 R206H neofunction -> activin-A-driven heterotopic
   endochondral ossification -> irreversible cumulative bone stock ->
   joint ankylosis + thoracic insufficiency -> death.

   Structure: 21 clusters / 197 nodes.
   The four boxed AXIS nodes are the model's load-bearing quantitative
   claims; each is derived from published numbers, not asserted.
   Render:  dot -Tsvg fop_qsp_model.dot -o fop_qsp_model.svg
            dot -Tpng -Gdpi=150 fop_qsp_model.dot -o fop_qsp_model.png
   ===================================================================== */
digraph FOP_QSP {
  graph [rankdir=TB, splines=spline, overlap=false, compound=true,
         newrank=true, nodesep=0.28, ranksep=0.55, fontname="Helvetica",
         labelloc=t, fontsize=30, concentrate=false, pad=0.4,
         label="Fibrodysplasia Ossificans Progressiva (FOP) — Quantitative Systems Pharmacology Map\nACVR1(R206H) neofunction · activin A · heterotopic endochondral ossification · irreversible bone stock · thoracic insufficiency"];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11,
         color="#37474f", penwidth=1.1, margin="0.10,0.05"];
  edge  [color="#546e7a", arrowsize=0.65, penwidth=1.0, fontname="Helvetica", fontsize=9];

  /* ---------- 1. GENETICS ---------- */
  subgraph cluster_gen {
    label="1 · Genetics / receptor lesion";
    style="rounded,filled"; fillcolor="#eceff1"; fontsize=15; color="#90a4ae";
    ACVR1        [label="ACVR1 (2q24.1)\nBMP type I receptor ALK2", fillcolor="#cfd8dc"];
    R206H        [label="c.617G>A  p.Arg206His\nGS-domain · >95% of classic FOP", fillcolor="#ef9a9a"];
    VAR_OTHER    [label="Non-classic variants\nR258S · G328E/R/W · G356D · R375P", fillcolor="#ffcdd2"];
    MOSAIC       [label="Sporadic de novo\n(paternal age effect)", fillcolor="#eceff1"];
    HETERO       [label="Heterozygous\ngain-of-function (dominant)", fillcolor="#eceff1"];
    GS_DOMAIN    [label="Glycine-serine (GS) rich\nactivation domain destabilised", fillcolor="#ffcdd2"];
    FKBP12       [label="FKBP12 binding LOST\n(inhibitory clamp released)", fillcolor="#ffcdd2"];
    LEAK         [label="Ligand-independent\nBASAL leak signalling", fillcolor="#ef9a9a"];
    ACVR1 -> R206H; ACVR1 -> VAR_OTHER; MOSAIC -> R206H; R206H -> HETERO;
    R206H -> GS_DOMAIN -> FKBP12 -> LEAK;
    VAR_OTHER -> GS_DOMAIN [style=dashed, label="milder /\nvariable"];
  }

  /* ---------- 2. LIGANDS ---------- */
  subgraph cluster_lig {
    label="2 · Ligand field";
    style="rounded,filled"; fillcolor="#e8eaf6"; fontsize=15; color="#9fa8da";
    ACTA         [label="ACTIVIN A (INHBA)\nlocal lesion pool", fillcolor="#f48fb1"];
    ACTA_SERUM   [label="Serum activin A\n434 vs 364 pg/mL (NS)\nNOT a flare biomarker", fillcolor="#f8bbd0"];
    BMP2_4       [label="BMP2 / BMP4\n(physiological ALK2/ALK3 agonists)", fillcolor="#c5cae9"];
    BMP6         [label="BMP6", fillcolor="#c5cae9"];
    BMP9         [label="BMP9 (GDF2)\nendothelial, high-affinity ALK1/ALK2", fillcolor="#c5cae9"];
    TGFB         [label="TGF-beta 1\n(fibroblast activin A inducer)", fillcolor="#c5cae9"];
    ACTA_SRC     [label="Activin A sources\nmacrophage · lymphocyte\nfibroblast · lesion FAP", fillcolor="#e8eaf6"];
    NOGGIN       [label="Endogenous antagonists\nnoggin · gremlin · follistatin", fillcolor="#dcedc8"];
    TYPE2        [label="Type II receptors\nACVR2A / ACVR2B / BMPR2\n(obligate co-receptor)", fillcolor="#c5cae9"];
    ACTA_SRC -> ACTA; TGFB -> ACTA_SRC; ACTA -> ACTA_SERUM [style=dotted, label="spillover"];
    NOGGIN -> BMP2_4 [arrowhead=tee]; NOGGIN -> ACTA [arrowhead=tee, style=dashed, label="weak"];
  }

  /* ---------- 3. RECEPTOR NEOFUNCTION ---------- */
  subgraph cluster_rec {
    label="3 · Receptor neofunction — the single molecular switch";
    style="rounded,filled"; fillcolor="#fff3e0"; fontsize=15; color="#ffb74d";
    WT_ACTA      [label="WT ALK2 + activin A\n= NON-SIGNALLING complex\n(competitive INHIBITOR)", fillcolor="#dcedc8"];
    MUT_ACTA     [label="R206H ALK2 + activin A\n= SIGNALLING complex\nNEOFUNCTION", fillcolor="#ef5350", fontcolor=white];
    SMAD23       [label="Canonical activin route\npSMAD2/3 (ALK4/ALK7)", fillcolor="#e0e0e0"];
    SMAD158      [label="pSMAD1/5/8\n(BMP route — WRONG for activin)", fillcolor="#ef9a9a"];
    HYPERSENS    [label="Hypersensitivity to\nBMP2/4/6 (lower EC50)", fillcolor="#ffe0b2"];
    RECEPT_CPLX  [label="Heterotetramer\n2x ALK2(R206H) + 2x ActRII", fillcolor="#ffe0b2"];
    ANTI_ACVR1_X [label="ANTI-ACVR1 mAb PARADOX\nbivalent binding DIMERISES and\nACTIVATES mutant receptor\n-> HO is made WORSE", fillcolor="#b71c1c", fontcolor=white, shape=octagon];
    ACTA -> WT_ACTA [style=dashed]; ACTA -> MUT_ACTA [penwidth=2.4, color="#c62828"];
    R206H -> MUT_ACTA [penwidth=2.4, color="#c62828"]; TYPE2 -> RECEPT_CPLX;
    MUT_ACTA -> RECEPT_CPLX; WT_ACTA -> SMAD23 [style=dotted, arrowhead=tee];
    RECEPT_CPLX -> SMAD158 [penwidth=2.2]; LEAK -> SMAD158;
    BMP2_4 -> HYPERSENS; BMP6 -> HYPERSENS; BMP9 -> HYPERSENS;
    HYPERSENS -> SMAD158; ANTI_ACVR1_X -> RECEPT_CPLX [color="#b71c1c", penwidth=2.0, label="agonist\nconversion"];
  }

  /* ---------- 4. TRIGGERS ---------- */
  subgraph cluster_trig {
    label="4 · Triggers (episodic route)";
    style="rounded,filled"; fillcolor="#fbe9e7"; fontsize=15; color="#ff8a65";
    TRAUMA       [label="Soft-tissue trauma / fall\n48% of flares are trauma-related", fillcolor="#ffccbc"];
    SPONT        [label="SPONTANEOUS flare\n52% of flares", fillcolor="#ffab91"];
    IM_INJ       [label="Intramuscular injection\n25% -> immediate flare;\n84% of those ossify", fillcolor="#ff8a65"];
    DENTAL       [label="Mandibular block /\ndental procedure -> jaw ankylosis", fillcolor="#ffccbc"];
    BIOPSY       [label="Biopsy / excision surgery\n(iatrogenic; diagnostic error)", fillcolor="#ff8a65"];
    VIRAL        [label="Influenza-like viral illness", fillcolor="#ffccbc"];
    OVERUSE      [label="Muscle fatigue / stretching\nrange-of-motion therapy", fillcolor="#ffccbc"];
    NOTRIG       [label="NO identifiable trigger\n47% report progression\nwithout obvious flare-ups", fillcolor="#d84315", fontcolor=white];
    TRAUMA -> IM_INJ [style=invis];
  }

  /* ---------- 5. INNATE IMMUNITY ---------- */
  subgraph cluster_inf {
    label="5 · Innate inflammatory amplifier";
    style="rounded,filled"; fillcolor="#fce4ec"; fontsize=15; color="#f06292";
    MAST         [label="Mast cells\n(10-fold excess at lesion front)", fillcolor="#f8bbd0"];
    MACRO        [label="Macrophages\nM1 -> M2 switch", fillcolor="#f8bbd0"];
    LYMPH        [label="Lymphocyte infiltration\n(earliest histological stage)", fillcolor="#f8bbd0"];
    IL1B         [label="IL-1 beta / IL-1 alpha\nNLRP3 inflammasome", fillcolor="#f48fb1"];
    IL1RA_BM     [label="Serum IL-1Ra\ncandidate flare biomarker", fillcolor="#fce4ec"];
    TNF          [label="TNF-alpha · IL-6", fillcolor="#f8bbd0"];
    SUBP         [label="Substance P / CGRP\nsensory-neuron mast-cell axis", fillcolor="#f8bbd0"];
    MICROB       [label="Gut microbiome-dependent\nIL-1 signalling", fillcolor="#fce4ec"];
    EDEMA        [label="Interstitial oedema\nswelling · pain · warmth", fillcolor="#f48fb1"];
    MUSCLE_NEC   [label="Myocyte necrosis\nDAMPs / HMGB1", fillcolor="#f8bbd0"];
    TRAUMA -> MUSCLE_NEC; IM_INJ -> MUSCLE_NEC; BIOPSY -> MUSCLE_NEC; DENTAL -> MUSCLE_NEC;
    VIRAL -> IL1B; OVERUSE -> MUSCLE_NEC; SPONT -> LYMPH;
    MUSCLE_NEC -> MACRO; MUSCLE_NEC -> MAST; MACRO -> IL1B; MAST -> TNF; LYMPH -> MACRO;
    IL1B -> TNF; IL1B -> IL1RA_BM; MICROB -> IL1B; SUBP -> MAST; TNF -> EDEMA; IL1B -> EDEMA;
    MACRO -> ACTA_SRC [penwidth=2.0, color="#c2185b", label="activin A"];
    LYMPH -> ACTA_SRC [color="#c2185b"];
  }

  /* ---------- 6. HYPOXIA / mTOR ---------- */
  subgraph cluster_hyp {
    label="6 · Hypoxia · mTORC1 amplifiers";
    style="rounded,filled"; fillcolor="#e0f2f1"; fontsize=15; color="#4db6ac";
    HYPOXIA      [label="Lesion-core hypoxia\n(swelling + high O2 demand)", fillcolor="#b2dfdb"];
    HIF1A        [label="HIF-1 alpha stabilised", fillcolor="#80cbc4"];
    ALK2_STAB    [label="Blocks ALK2 lysosomal\ndegradation -> receptor pool UP", fillcolor="#80cbc4"];
    MTORC1       [label="mTORC1 activity", fillcolor="#80cbc4"];
    ROS          [label="ROS / oxidative stress", fillcolor="#b2dfdb"];
    VEGF_H       [label="VEGF-A (mesenchymal)", fillcolor="#b2dfdb"];
    EDEMA -> HYPOXIA -> HIF1A; HIF1A -> ALK2_STAB -> SMAD158 [penwidth=1.6];
    HIF1A -> MTORC1; ACTA -> MTORC1 [label="activin A ->\nmTOR"]; HIF1A -> VEGF_H;
    MTORC1 -> ROS;
  }

  /* ---------- 7. SMAD OUTPUT ---------- */
  subgraph cluster_smad {
    label="7 · Intracellular signal integration";
    style="rounded,filled"; fillcolor="#ede7f6"; fontsize=15; color="#9575cd";
    SMAD4        [label="SMAD1/5/8 - SMAD4\nnuclear translocation", fillcolor="#d1c4e9"];
    ID1          [label="ID1 / ID2 / ID3\n(canonical BMP readout)", fillcolor="#d1c4e9"];
    P38          [label="Non-canonical p38 / ERK\nTAK1", fillcolor="#d1c4e9"];
    SRC_K        [label="SRC / FYN kinase\n(saracatinib-sensitive node)", fillcolor="#b39ddb"];
    YAP_SHH      [label="YAP - SHH self-amplifying\nloop (lesion expansion)", fillcolor="#b39ddb"];
    NFKB         [label="NF-kB", fillcolor="#d1c4e9"];
    SMAD158 -> SMAD4 -> ID1; SMAD158 -> P38; SRC_K -> SMAD158 [label="permissive"];
    IL1B -> NFKB; NFKB -> ACTA_SRC; ID1 -> YAP_SHH; MTORC1 -> YAP_SHH;
  }

  /* ---------- 8. PROGENITORS ---------- */
  subgraph cluster_prog {
    label="8 · Cell of origin";
    style="rounded,filled"; fillcolor="#f1f8e9"; fontsize=15; color="#aed581";
    FAP          [label="FIBRO/ADIPOGENIC PROGENITORS\nPDGFRa+ Sca1+ Tie2+ interstitial\n= obligate cell of origin", fillcolor="#c5e1a5"];
    FAP_ACT      [label="Activated FAP\nrapid clonal expansion\n(peak number ~ HO severity)", fillcolor="#aed581"];
    FAP_POOL     [label="Resident FAP reserve\n(finite, muscle-bed specific)", fillcolor="#dcedc8"];
    ENDMT        [label="Endothelial-mesenchymal\ntransition (contested contribution)", fillcolor="#f1f8e9"];
    MUSCLE_SAT   [label="Satellite cells\nNOT the source", fillcolor="#eceff1"];
    FAP_POOL -> FAP -> FAP_ACT; ENDMT -> FAP_ACT [style=dashed];
    SMAD4 -> FAP_ACT [penwidth=2.2, color="#558b2f"];
    MUSCLE_SAT -> FAP_ACT [style=dotted, arrowhead=tee, label="excluded"];
  }

  /* ---------- 9. ENDOCHONDRAL CASCADE ---------- */
  subgraph cluster_endo {
    label="9 · Heterotopic ENDOCHONDRAL cascade — a one-way relay with a commitment checkpoint";
    style="rounded,filled"; fillcolor="#e3f2fd"; fontsize=15; color="#64b5f6";
    FIBRO        [label="Stage 1 · Fibroproliferative\nlesion (highly cellular)", fillcolor="#bbdefb"];
    CHOND        [label="Stage 2 · CHONDROGENESIS\nSOX9 · ACAN · COL2A1\n== POINT OF NO RETURN ==", fillcolor="#1565c0", fontcolor=white, shape=octagon];
    HYPT         [label="Stage 3 · Hypertrophic chondrocyte\nCOL10A1 · RUNX2 · MMP13 · IHH", fillcolor="#90caf9"];
    VASC         [label="Stage 4 · Vascular invasion\nVEGF-A · cartilage resorption", fillcolor="#90caf9"];
    OSTB         [label="Stage 5 · Osteoblast\nRUNX2 · SP7/OSX · COL1A1 · ALP", fillcolor="#64b5f6"];
    MINER        [label="Stage 6 · Mineralisation\nhydroxyapatite deposition", fillcolor="#42a5f5"];
    MARROW       [label="Stage 7 · Marrow + lamellar\nremodelling -> normal-appearing bone", fillcolor="#2196f3", fontcolor=white];
    FAP_ACT -> FIBRO -> CHOND -> HYPT -> VASC -> OSTB -> MINER -> MARROW [penwidth=2.0];
    VEGF_H -> VASC; MTORC1 -> CHOND [label="aberrant\nchondrogenesis"];
    YAP_SHH -> FIBRO [label="lesion\nexpansion"];
  }

  /* ---------- 10. REMODELLING / IRREVERSIBILITY ---------- */
  subgraph cluster_rem {
    label="10 · The ratchet — why nothing comes back";
    style="rounded,filled"; fillcolor="#efebe9"; fontsize=15; color="#a1887f";
    HO_STOCK     [label="CUMULATIVE HO STOCK (mL)\nnet resorption ~ 0", fillcolor="#8d6e63", fontcolor=white];
    OCL          [label="Osteoclasts · RANKL/OPG\n(remodel WITHIN the lesion,\ndo not remove it)", fillcolor="#d7ccc8"];
    PSEUDO       [label="Ectopic pseudojoints\n(rare partial mobility)", fillcolor="#efebe9"];
    SURG_FAIL    [label="Surgical excision\n-> explosive recurrence\n(contraindicated)", fillcolor="#bcaaa4"];
    BISPH        [label="Bisphosphonates / denosumab\nact HERE -> no effect on formation", fillcolor="#eceff1"];
    MARROW -> HO_STOCK [penwidth=2.4];
    OCL -> HO_STOCK [arrowhead=tee, style=dashed, label="~0 net"];
    HO_STOCK -> PSEUDO [style=dotted]; SURG_FAIL -> HO_STOCK [label="worsens"];
    BISPH -> OCL [arrowhead=tee]; ACTA -> OCL [style=dotted, label="large osteoclasts"];
  }

  /* ---------- 11. ANATOMY ---------- */
  subgraph cluster_anat {
    label="11 · Anatomic order of conquest";
    style="rounded,filled"; fillcolor="#fffde7"; fontsize=15; color="#fff176";
    AXIAL        [label="AXIAL FIRST\nneck · paraspinal · shoulder girdle", fillcolor="#fff59d"];
    AX2AP        [label="Progression rule:\naxial -> appendicular\ncranial -> caudal\nproximal -> distal", fillcolor="#fff176"];
    THORAX       [label="THORACIC CAGE\ncostovertebral + intercostal HO", fillcolor="#ffe082"];
    HIP_SH       [label="Hips / shoulders\n(most disabling flares)", fillcolor="#fff59d"];
    JAW          [label="Temporomandibular ankylosis\n-> feeding / airway risk", fillcolor="#fff59d"];
    CSPINE       [label="Cervical spine fusion\n(often congenital + acquired)", fillcolor="#fff59d"];
    LIMB_DIST    [label="Elbows · knees · wrists · ankles\n(later, risk rises with age)", fillcolor="#fff59d"];
    HO_STOCK -> AXIAL [penwidth=1.6]; AXIAL -> AX2AP -> THORAX; AX2AP -> HIP_SH;
    AX2AP -> JAW; AX2AP -> CSPINE; AX2AP -> LIMB_DIST;
  }

  /* ---------- 12. CONGENITAL / NON-HO ---------- */
  subgraph cluster_cong {
    label="12 · Congenital + non-HO features (present from birth, drug-untouchable)";
    style="rounded,filled"; fillcolor="#f3e5f5"; fontsize=15; color="#ba68c8";
    TOE          [label="Great-toe malformation\nhallux valgus (diagnostic sign)", fillcolor="#e1bee7"];
    DIGIT        [label="Impaired digit joint\ndevelopment (BMP dysregulation)", fillcolor="#e1bee7"];
    OSTEOCH      [label="Proximal tibial osteochondromas", fillcolor="#e1bee7"];
    HEARING      [label="Conductive hearing loss (~50%)", fillcolor="#e1bee7"];
    NEURO        [label="Neuropathic pain\nnerve compression", fillcolor="#e1bee7"];
    CARDCOND     [label="ECG conduction abnormality", fillcolor="#e1bee7"];
    STONES       [label="Nephrolithiasis (immobility)", fillcolor="#e1bee7"];
    SARCOP       [label="Muscle: reduced integrity\n(impedance myography)", fillcolor="#e1bee7"];
    R206H -> TOE; R206H -> DIGIT; R206H -> OSTEOCH; R206H -> CARDCOND;
    CSPINE -> HEARING [style=invis]; HO_STOCK -> NEURO; HO_STOCK -> STONES; HO_STOCK -> SARCOP;
  }

  /* ---------- 13. PK PALOVAROTENE ---------- */
  subgraph cluster_pkpalo {
    label="13 · PK/PD — palovarotene (RAR-gamma agonist, oral)";
    style="rounded,filled"; fillcolor="#e0f7fa"; fontsize=15; color="#4dd0e1";
    PALO_PO      [label="Palovarotene PO\nchronic 5 mg/d + flare 20 mg x4wk\nthen 10 mg x>=8wk", fillcolor="#b2ebf2"];
    PALO_GUT     [label="Gut depot (Ka)", fillcolor="#e0f7fa"];
    PALO_CEN     [label="Plasma (2-cpt, CYP3A4)", fillcolor="#b2ebf2"];
    PALO_TIS     [label="Lesion / cartilage tissue", fillcolor="#b2ebf2"];
    RARG         [label="RAR-gamma agonism", fillcolor="#4dd0e1"];
    PALO_MOA     [label="Suppresses chondrogenic\ncommitment + reduces local\nactivin-A-expressing cells", fillcolor="#4dd0e1"];
    PALO_PO -> PALO_GUT -> PALO_CEN -> PALO_TIS -> RARG -> PALO_MOA;
    PALO_MOA -> CHOND [arrowhead=tee, penwidth=2.4, color="#00838f"];
    PALO_MOA -> ACTA_SRC [arrowhead=tee, style=dashed, color="#00838f"];
  }

  /* ---------- 14. PK GARETOSMAB ---------- */
  subgraph cluster_pkgare {
    label="14 · PK/PD — garetosmab (anti-activin A mAb, IV)";
    style="rounded,filled"; fillcolor="#e8f5e9"; fontsize=15; color="#66bb6a";
    GARE_IV      [label="Garetosmab 10 mg/kg IV q4w\nCtrough 105 +/- 31 mg/L", fillcolor="#c8e6c9"];
    GARE_CEN     [label="Central (2-cpt mAb)", fillcolor="#c8e6c9"];
    GARE_TMDD    [label="Target-mediated disposition\n(saturated at 10 mg/kg)", fillcolor="#a5d6a7"];
    GARE_CPLX    [label="Garetosmab - activin A complex\n(total activin A rises)", fillcolor="#a5d6a7"];
    GARE_AE      [label="Epistaxis · madarosis\nskin abscess · 5 deaths in OLE", fillcolor="#ffcdd2"];
    GARE_IV -> GARE_CEN -> GARE_TMDD; GARE_CEN -> GARE_CPLX;
    ACTA -> GARE_CPLX [color="#2e7d32"]; GARE_CPLX -> ACTA [arrowhead=tee, penwidth=2.6, color="#2e7d32", label="neutralise\nBOTH routes"];
    GARE_CEN -> GARE_AE [style=dashed];
  }

  /* ---------- 15. PK ALK2 KINASE INHIBITORS ---------- */
  subgraph cluster_pkalk {
    label="15 · PK/PD — ALK2 kinase / SRC inhibitors (oral)";
    style="rounded,filled"; fillcolor="#fff8e1"; fontsize=15; color="#ffca28";
    ALK2I_PO     [label="Fidrisertib (IPN60130/BLU-782)\nZilurgisertib (INCB000928)\nKTI-2338 · LDN-212854", fillcolor="#ffecb3"];
    ALK2I_CEN    [label="Plasma", fillcolor="#ffecb3"];
    ALK2I_KIN    [label="ATP-competitive ALK2\nkinase-domain block", fillcolor="#ffca28"];
    SARA         [label="Saracatinib (AZD0530)\nSRC/ALK2 — STOPFOP", fillcolor="#ffecb3"];
    SEL_RISK     [label="Selectivity risk:\nALK1/ALK3 -> anaemia, vascular", fillcolor="#ffcdd2"];
    ALK2I_PO -> ALK2I_CEN -> ALK2I_KIN;
    ALK2I_KIN -> SMAD158 [arrowhead=tee, penwidth=2.4, color="#f57f17", label="blocks leak AND\nligand-driven"];
    SARA -> SRC_K [arrowhead=tee]; ALK2I_KIN -> SEL_RISK [style=dashed];
  }

  /* ---------- 16. OTHER DRUGS ---------- */
  subgraph cluster_pkoth {
    label="16 · PK/PD — anti-inflammatory + repurposed agents";
    style="rounded,filled"; fillcolor="#fafafa"; fontsize=15; color="#bdbdbd";
    PRED         [label="Prednisone 2 mg/kg/d x4d\n(75% of patients use it)", fillcolor="#e0e0e0"];
    PRED_LIM     [label="Complete flare resolution 12%\nrebound within 1-7 d in 43%", fillcolor="#ffcdd2"];
    NSAID        [label="NSAID / COX-2 · montelukast\ncromolyn (mast-cell stabiliser)", fillcolor="#e0e0e0"];
    ANAKIN       [label="IL-1 blockade\nanakinra / canakinumab", fillcolor="#e0e0e0"];
    SIRO         [label="Sirolimus / rapamycin\nmTORC1 inhibition", fillcolor="#e0e0e0"];
    IMAT         [label="Imatinib (multi-kinase)\noff-on-off-on case series", fillcolor="#e0e0e0"];
    RUXO         [label="Ruxolitinib (JAK1/2)\nsteroid-refractory flares", fillcolor="#e0e0e0"];
    GENE         [label="AAV / gene + cell therapy\n(pre-clinical)", fillcolor="#e0e0e0"];
    PRED -> IL1B [arrowhead=tee]; PRED -> EDEMA [arrowhead=tee]; PRED -> PRED_LIM [style=dotted];
    NSAID -> EDEMA [arrowhead=tee]; ANAKIN -> IL1B [arrowhead=tee]; RUXO -> TNF [arrowhead=tee];
    SIRO -> MTORC1 [arrowhead=tee, penwidth=1.8]; IMAT -> HIF1A [arrowhead=tee, style=dashed];
    GENE -> R206H [arrowhead=tee, style=dashed];
  }

  /* ---------- 17. GROWTH-PLATE TOXICITY ---------- */
  subgraph cluster_tox {
    label="17 · The collision — retinoid toxicity IS the mechanism of action";
    style="rounded,filled"; fillcolor="#ffebee"; fontsize=15; color="#e57373";
    PHYSIS       [label="Normal growth plate\n= PHYSIOLOGICAL chondrogenesis", fillcolor="#ffcdd2"];
    PPC          [label="PREMATURE PHYSEAL CLOSURE\n21/57 (36.8%) of patients <14 y", fillcolor="#c62828", fontcolor=white, shape=octagon];
    HEIGHT       [label="Growth arrest\nfinal height loss", fillcolor="#ef9a9a"];
    JOINT_OG     [label="Synovial joint overgrowth\n(pre-clinical)", fillcolor="#ffcdd2"];
    VBMD         [label="Vertebral BMD / strength DOWN\nfracture risk UP", fillcolor="#ffcdd2"];
    MUCOC        [label="Mucocutaneous retinoid AE\n97.0% of treated patients", fillcolor="#ffcdd2"];
    SKEL_MAT     [label="Skeletal maturity\n= the ONLY separation axis\n(time, not dose)", fillcolor="#ef5350", fontcolor=white];
    RARG -> PHYSIS [penwidth=2.0]; PHYSIS -> PPC [penwidth=2.0]; PPC -> HEIGHT;
    RARG -> JOINT_OG [style=dashed]; RARG -> VBMD; RARG -> MUCOC; SKEL_MAT -> PPC [arrowhead=tee];
  }

  /* ---------- 18. BIOMARKERS / IMAGING ---------- */
  subgraph cluster_bio {
    label="18 · Measurement layer (and what each endpoint actually integrates)";
    style="rounded,filled"; fillcolor="#e1f5fe"; fontsize=15; color="#4fc3f7";
    WBCT         [label="Low-dose whole-body CT\nHO VOLUME (mL) = the STOCK", fillcolor="#b3e5fc"];
    ANNHO        [label="Annualised NEW HO volume\n= the RATE (trial endpoint)", fillcolor="#81d4fa"];
    NAFPET       [label="18F-NaF PET/CT\nlesion ACTIVITY", fillcolor="#b3e5fc"];
    NAF_DILUT    [label="PET total activity is DILUTED by\nmaturation of pre-existing lesions\n-> LUMINA-1 primary missed (p=0.074)", fillcolor="#0277bd", fontcolor=white];
    US           [label="Ultrasound of flare\n(soft-tissue mass)", fillcolor="#b3e5fc"];
    ALP_BM       [label="Serum ALP · CRP · ESR\n(non-specific)", fillcolor="#b3e5fc"];
    LESCOUNT     [label="NEW LESION COUNT\n(discrete, compound-Poisson)", fillcolor="#81d4fa"];
    HO_STOCK -> WBCT [penwidth=1.8]; MINER -> ANNHO; MINER -> NAFPET; HYPT -> NAFPET;
    HO_STOCK -> NAF_DILUT [style=dashed]; NAFPET -> NAF_DILUT; FIBRO -> US; OSTB -> ALP_BM;
    CHOND -> LESCOUNT [style=dashed];
  }

  /* ---------- 19. CLINICAL ENDPOINTS ---------- */
  subgraph cluster_clin {
    label="19 · Function endpoints";
    style="rounded,filled"; fillcolor="#f9fbe7"; fontsize=15; color="#c0ca33";
    CAJIS        [label="CAJIS 0-30\ncumulative joint involvement", fillcolor="#f0f4c3"];
    PFQ          [label="FOP-PFQ physical function\nFOP-FLEX-R flare PRO", fillcolor="#f0f4c3"];
    ADL          [label="ADL loss · 70% report\nfunctional loss per flare", fillcolor="#f0f4c3"];
    AMBUL        [label="Loss of ambulation\n(wheelchair dependence)", fillcolor="#e6ee9c"];
    PAIN         [label="Chronic pain · analgesic use", fillcolor="#f0f4c3"];
    STAGE        [label="Clinical stage 1-5\n(early/mild -> late)", fillcolor="#e6ee9c"];
    QOL          [label="HRQoL · caregiver burden\neconomic burden", fillcolor="#f0f4c3"];
    HIP_SH -> CAJIS [penwidth=1.8]; LIMB_DIST -> CAJIS; JAW -> CAJIS; CSPINE -> CAJIS;
    CAJIS -> ADL -> AMBUL; CAJIS -> PFQ; EDEMA -> PAIN; NEURO -> PAIN;
    CAJIS -> STAGE; ADL -> QOL; PAIN -> QOL;
  }

  /* ---------- 20. THORACIC INSUFFICIENCY / SURVIVAL ---------- */
  subgraph cluster_surv {
    label="20 · Thoracic insufficiency syndrome — the terminal pathway";
    style="rounded,filled"; fillcolor="#ffebee"; fontsize=15; color="#ef9a9a";
    CHESTEXP     [label="Chest expansion 1.9 +/- 0.8 in\n(diaphragm-dependent breathing)", fillcolor="#ffcdd2"];
    RESTRICT     [label="Restrictive physiology\nTLC down · RV up · DLCO/VA normal", fillcolor="#ffcdd2"];
    FVC          [label="FVC 44 +/- 14 % predicted\nin advanced disease", fillcolor="#ef9a9a"];
    HYPOVENT     [label="Alveolar hypoventilation\nnocturnal desaturation", fillcolor="#ef9a9a"];
    PNEUM        [label="Recurrent pneumonia\n(15% of deaths)", fillcolor="#e57373", fontcolor=white];
    RVSTRAIN     [label="RV strain / ECG abnormality\n40% · cor pulmonale risk", fillcolor="#e57373", fontcolor=white];
    TIS          [label="THORACIC INSUFFICIENCY SYNDROME\n54% of all deaths, median age 42 y", fillcolor="#b71c1c", fontcolor=white, shape=octagon];
    DEATH        [label="Median lifespan 56 y\n(95% CI 51-60)", fillcolor="#7f0000", fontcolor=white];
    THORAX -> CHESTEXP -> RESTRICT -> FVC -> HYPOVENT;
    CSPINE -> RESTRICT [style=dashed]; JAW -> PNEUM [style=dashed, label="aspiration"];
    HYPOVENT -> PNEUM; FVC -> RVSTRAIN; RESTRICT -> TIS; FVC -> TIS [penwidth=2.2];
    PNEUM -> TIS; RVSTRAIN -> TIS; TIS -> DEATH [penwidth=2.4];
  }

  /* ---------- 21. MODEL AXES ---------- */
  subgraph cluster_axes {
    label="21 · The four quantitative axes of this model (each DERIVED from the cited numbers)";
    style="rounded,filled"; fillcolor="#212121"; fontsize=16; color="#000000"; fontcolor="#ffffff";
    node [fontcolor="#ffffff", color="#ffffff"];
    AXIS1 [label="AXIS 1 — THE ANTI-FLARE CEILING\n0.90 flares/pt-yr x 26.9% that ossify x 28.8 mL\n= 6.97 mL/yr of 23.6 mL/yr total\n=> phi_FL = 0.30\nA drug that abolishes 100% of flare-ups removes\nat most ~30% of new heterotopic bone.\nCorroborated: 47% report progression with no flare;\n59% of new adult lesions are not at a flare site.", fillcolor="#c62828", shape=note];
    AXIS2 [label="AXIS 2 — RATE vs STOCK (the ratchet)\nEndpoint = d(HO)/dt; disability = integral of it,\nwith net resorption ~ 0.\nMOVE 60% rate reduction over 18 mo at age 15\n= only ~12% less TOTAL ossified volume.\nThe same trial supports both numbers.", fillcolor="#4527a0", shape=note];
    AXIS3 [label="AXIS 3 — AGE IS STRONGER THAN POTENCY\nNHS velocity: 21.9 (8-15) · 41.5 (15-25) · 4.6 (25-65) mL/yr\n=> ~80% of lifetime HO is laid down before age 25.\nSame 57% efficacy prevents 52% of lifetime HO if\nstarted at 8, but only 10% if started at 25.", fillcolor="#00695c", shape=note];
    AXIS4 [label="AXIS 4 — EFFICACY AND TOXICITY SHARE ONE AXIS\nThe growth plate IS endochondral chondrogenesis.\n60% HO suppression came with PPC in 36.8% of\nchildren <14 y => implied selectivity ~4x only.\nNo dose separates them while physes are open;\nonly skeletal maturity does. But that is exactly\nwhen the remaining benefit has fallen to ~10%.", fillcolor="#bf360c", shape=note];
    AXIS1 -> AXIS2 [style=invis]; AXIS2 -> AXIS3 [style=invis]; AXIS3 -> AXIS4 [style=invis];
  }

  /* ---------- cross-cluster wiring ---------- */
  NOTRIG  -> FAP_ACT   [color="#d84315", penwidth=2.4, label="SMOULDERING route\n~70% of new HO"];
  SPONT   -> ACTA_SRC  [color="#c2185b"];
  EDEMA   -> FAP_ACT   [color="#c2185b", penwidth=1.8, label="episodic route\n~30%"];
  ANNHO   -> AXIS1     [style=dotted, color="#ffffff"];
  WBCT    -> AXIS2     [style=dotted, color="#ffffff"];
  HO_STOCK-> AXIS3     [style=dotted, color="#ffffff"];
  PPC     -> AXIS4     [style=dotted, color="#ffffff"];
  PALO_MOA-> AXIS4     [style=dotted, color="#ffffff"];
  GARE_CPLX -> NOTRIG  [arrowhead=tee, color="#2e7d32", style=dashed, label="only ligand/receptor\ndrugs reach this route"];
  ALK2I_KIN -> NOTRIG  [arrowhead=tee, color="#f57f17", style=dashed];
  PRED    -> AXIS1     [style=dotted, color="#ffffff", label="capped here"];
  ANAKIN  -> AXIS1     [style=dotted, color="#ffffff"];
  HO_STOCK -> THORAX   [style=invis];
}
