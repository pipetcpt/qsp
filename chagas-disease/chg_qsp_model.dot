  /* ---------- 26. TRIAL ANCHORS AND THE PAF ------------------------------ */
  subgraph cluster_trials {
    label="26 · Trial anchors and the parasite-attributable fraction"; style="rounded,filled"; fillcolor="#FFFDF0"; color="#C9B96A"; fontsize=11;
    PAF      [label="PAF\nparasite-attributable fraction\nof the INSTANTANEOUS damage rate\n= 1 - (rate with parasite removed)\n     / (rate with parasite)",
