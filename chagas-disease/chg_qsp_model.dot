    KILL_REP_N->P_BLOOD [arrowhead=odiamond]; KILL_REP_A->P_BLOOD [arrowhead=odiamond];
    KILL_DORM_N->P_DORM_H [arrowhead=odiamond, penwidth=2.0];
    KILL_DORM_N->P_DORM_X [arrowhead=odiamond, penwidth=2.0];
    KILL_DORM_A->P_DORM_H [arrowhead=odiamond, style=dotted];
