  /* ---------- 19-20. TRYPANOCIDAL PK / PD -------------------------------- */
  subgraph cluster_pk_tryp {
    label="19 · Trypanocidal drug PK"; style="rounded,filled"; fillcolor="#E7F7F7"; color="#66AFAF"; fontsize=11;
    BZN_D    [label="Benznidazole oral depot\nF ~0.92, ka ~1.2 /h"];
    BZN_C    [label="BZN_C central\nV/F ~0.56 L/kg\nCL/F ~2.1 L/h, t1/2 ~13 h", fillcolor="#C9EAEA"];
    BZN_P    [label="BZN peripheral"];
    NFX_C    [label="Nifurtimox\nt1/2 ~3 h, t.i.d.\nCNS + GI intolerance", fillcolor="#C9EAEA"];
    POS_C    [label="Posaconazole\nt1/2 ~25-31 h\nsaturable absorption", fillcolor="#C9EAEA"];
    RAV_C    [label="Ravuconazole\n(from fosravuconazole E1224)\nt1/2 ~100-200 h", fillcolor="#C9EAEA"];
    FEX_C    [label="Fexinidazole\n(5-nitroimidazole,\nactive metabolites)", fillcolor="#C9EAEA"];
    BZN_D->BZN_C; BZN_C->BZN_P [dir=both];
  }

  subgraph cluster_pd_tryp {
    label="20 · Trypanocidal PD — the asymmetry that explains everything"; style="rounded,filled"; fillcolor="#E7F7F7"; color="#66AFAF"; fontsize=11;
    TCNTR    [label="TcNTR-1 type I nitroreductase\n(parasite-specific)"];
    GLYOXAL  [label="Glyoxal / nitroso / reactive\nreduction products"];
    DNAADD   [label="DNA adducts, thiol depletion\n— damage does NOT require\nthe cell to be dividing", fillcolor="#C9EAEA", penwidth=2.0, color="#1F7A7A"];
    CYP51    [label="T. cruzi CYP51\nsterol 14-alpha-demethylase"];
    ERGO     [label="Ergosterol depletion\n— matters ONLY during\nmembrane synthesis, i.e.\nONLY during GROWTH", fillcolor="#C9EAEA", penwidth=2.0, color="#1F7A7A"];
    KILL_REP_N [label="KILL_REP (nitro class)\nEmax ~2.0 /day"];
    KILL_REP_A [label="KILL_REP (azole class)\nEmax ~3.5 /day, EC50 lower\n— MORE potent here", fillcolor="#C9EAEA"];
    KILL_DORM_N[label="KILL_DORM (nitro class)\n~0.06 /day  — SMALL BUT NONZERO", fillcolor="#8FD6D6", penwidth=2.4, color="#1F5C5C"];
    KILL_DORM_A[label="KILL_DORM (azole class)\n~0.0005 /day — EFFECTIVELY ZERO", fillcolor="#8FD6D6", penwidth=2.4, color="#1F5C5C"];
    BZN_C->TCNTR; NFX_C->TCNTR; FEX_C->TCNTR; TCNTR->GLYOXAL; GLYOXAL->DNAADD;
    POS_C->CYP51; RAV_C->CYP51; CYP51->ERGO;
    DNAADD->KILL_REP_N; DNAADD->KILL_DORM_N [penwidth=2.0];
