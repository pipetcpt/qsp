  QPCR->T_STOP [style=dotted, arrowhead=none];
  BZN_C->KILL_REP_N [style=dotted]; POS_C->KILL_REP_A [style=dotted];
  STERILISE->SEROL [style=dashed, label="seroreversion,\ndecades later"];
  PAF->COMPOS [style=dashed, label="sets the maximum\nachievable effect size"];
}
