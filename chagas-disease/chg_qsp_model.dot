    PAF_YOUNG[label="PAF at age 25, indeterminate\n≈ 0.8-0.9  → treatment prevents\nalmost everything", fillcolor="#F7F3D4"];
    PAF_OLD  [label="PAF at age 55, established CCC\n≈ 0.05-0.10 → treatment prevents\nalmost nothing", fillcolor="#F7F3D4"];
    T_BENEFIT[label="BENEFIT (n=2854, 5.4 y)\nPCR conversion 66.2% vs 33.5% (EOT)\n46.7% vs 33.1% (>=5 y)\nCOMPOSITE 27.5% vs 29.1%\nHR 0.93 (0.81-1.07), p=0.31", shape=note, fillcolor="#FFFFFF"];
    T_BENDITA[label="BENDITA (n=210, indeterminate)\nsustained clearance at 6 mo:\nplacebo 3% · 300mg x 8wk 89% ·\nx 4wk 89% · x 2wk 83% ·\n150mg x 4wk 83%", shape=note, fillcolor="#FFFFFF"];
    T_STOP   [label="STOP-CHAGAS (n=120)\nday 30 PCR-neg: posa 93.3% > BZN 89.7%\nday 180 sustained: posa 13.3% vs BZN 86.7%\nday 360: posa 16% vs BZN 96%", shape=note, fillcolor="#FFFFFF"];
    T_SABINO [label="Seropositive donor cohort\ncardiomyopathy incidence\n13.8 vs 4.6 /1000 py\n(attributable 9.2)", shape=note, fillcolor="#FFFFFF"];
    PWR      [label="POWER MISMATCH\nBENEFIT was powered for a ~25%\nrelative reduction; the structure\npermits ~2-4% at that stage", fillcolor="#F2EDBE", penwidth=2.0, color="#8A7A20"];
