/* ==========================================================================
   ============================  E D G E S  =================================
   ========================================================================== */

/* ---- 1 → 2 : genetics into transcription and splicing ---- */
G_MAPT_H1  -> MAPT_GENE   [label = "expression ↑", color = "#8a6d1d"];
G_MAPT_UTR -> MAPT_MRNA   [label = "stability ↑", color = "#8a6d1d"];
G_MAPT_H1  -> SPLICE_F    [label = "4R shift", color = "#8a6d1d"];
G_MAPT_RARE-> EX10_IN     [label = "4R ↑", color = "#8a6d1d"];
G_MOBP     -> OLIGO;
G_STX6     -> ENDOSOME    [label = "endosome-Golgi\nfusion defect"];
G_EIF2AK3  -> UPR;
G_TRIM11   -> TRIM11P     [label = "loss of function ⇒\ndisaggregase ↓"];
G_DUSP10   -> GSK3B;
G_SLCO1A2  -> MAPT_GENE   [style = "dotted"];
G_APOE     -> TAU_OLIG    [style = "dotted", label = "weak / absent"];
AGE        -> CLR_TOT     [label = "capacity ↓"];
AGE        -> L1_DEREP    [label = "heterochromatin ↓"];
SEX        -> PSPRS       [style = "dotted"];
ENVIR      -> CPLX1       [label = "annonacin:\nComplex I inhibition"];

/* ---- 2 : transcription → monomer ---- */
MAPT_GENE -> MAPT_MRNA;
SPLICE_F  -> EX10_IN;
SPLICE_F  -> EX10_OUT;
EX10_IN   -> R4R3;
EX10_OUT  -> R4R3;
R4R3      -> TAU_MON      [label = "4R monomer supply", color = "#b35c00", penwidth = 1.6];
MAPT_MRNA -> TRANSL;
TRANSL    -> TAU_MON      [label = "synthesis k_syn", color = "#b35c00", penwidth = 1.8];
RNASEH1   -> MAPT_MRNA    [label = "degrade", color = "#b02020", arrowhead = "tee", penwidth = 1.8];

/* ---- 3 : the intraneuronal aggregation cascade ---- */
TAU_MON  -> TAU_MT        [label = "binding"];
TAU_MT   -> TAU_MON       [label = "release"];
TAU_MON  -> TAU_MISF      [label = "conformational\nconversion"];
TAU_MISF -> TAU_DIM;
TAU_DIM  -> TAU_OLIG      [color = "#b35c00", penwidth = 1.6];
TAU_OLIG -> TAU_PFF       [color = "#b35c00", penwidth = 1.6];
TAU_PFF  -> NFT;
TAU_PFF  -> THREAD;
TAU_OLIG -> SEED_UNIT     [penwidth = 1.6];
TAU_PFF  -> SEED_UNIT     [label = "after fragmentation"];
SEED_UNIT-> TEMPLATE      [color = "#b35c00", penwidth = 2.0];
TEMPLATE -> A_LOAD        [color = "#b35c00", penwidth = 2.2];
TAU_MON  -> TEMPLATE      [label = "substrate M", color = "#b35c00", penwidth = 2.0];
A_LOAD   -> TAU_OLIG      [label = "AUTOCATALYSIS", style = "bold", color = "#b02020", penwidth = 2.0];
A_LOAD   -> NFT;
A_LOAD   -> TUFT;
A_LOAD   -> OCB;
OLIGO    -> OCB;
ASTRO    -> TUFT;

/* ---- 4 : PTM ---- */
GSK3B   -> PTAU  [color = "#7b3fa0", penwidth = 1.6];
CDK5    -> PTAU  [color = "#7b3fa0"];
DYRK1A  -> PTAU  [color = "#7b3fa0"];
CK1D    -> PTAU  [color = "#7b3fa0"];
MARK    -> DETACH[label = "KXGS → MT affinity ↓"];
PP2A    -> PTAU  [arrowhead = "tee", color = "#1c6b3a", label = "dephosphorylate"];
PTAU    -> DETACH[penwidth = 1.6];
DETACH  -> TAU_MON [label = "free monomer ↑", penwidth = 1.6];
PTAU    -> TAU_MISF [label = "aggregation\npropensity ↑", penwidth = 1.6];
OGT     -> OGLCNAC;
OGA     -> OGLCNAC [arrowhead = "tee", label = "removes"];
OGLCNAC -> PTAU    [arrowhead = "tee", label = "site competition"];
OGLCNAC -> TAU_MISF[arrowhead = "tee", label = "anti-aggregant"];
P300    -> ACTAU   [color = "#7b3fa0"];
SIRT1   -> ACTAU   [arrowhead = "tee"];
ACTAU   -> CLR_TOT [arrowhead = "tee", label = "blocks degradation"];
ACTAU   -> TAU_MISF[label = "aggregation ↑"];
CASP3   -> TRUNC   [label = "D421"];
CALPAIN -> NTFRAG;
CASP3   -> NTFRAG;
AEP     -> TRUNC   [label = "N368"];
AEP     -> NTFRAG;
TRUNC   -> SEED_UNIT [label = "seeding core", penwidth = 1.8, color = "#b35c00"];
NTFRAG  -> ETAU_N    [label = "released", penwidth = 2.0, color = "#8f2020"];
TRUNC   -> ETAU_S    [label = "released", penwidth = 2.0, color = "#8f2020"];
UBIQ    -> PROTEA;
SUMO    -> TRIM11P;
NITRO   -> TAU_MISF  [style = "dotted"];
APOP    -> CASP3;
CALPAIN -> CDK5      [label = "p35 → p25"];

/* ---- 5 : clearance ---- */
CHIP     -> PROTEA;
BAG3     -> MACROAUT;
MTORC1   -> MACROAUT [arrowhead = "tee"];
MTORC1   -> TFEB     [arrowhead = "tee"];
TFEB     -> LYSO;
MACROAUT -> LYSO;
CMA      -> LYSO;
PGRN     -> LYSO     [label = "CTSD maturation", penwidth = 1.8, color = "#1c6b3a"];
ROCK     -> MACROAUT [arrowhead = "tee"];
UPR      -> CLR_TOT  [arrowhead = "tee", style = "dotted"];
TRIM11P  -> A_LOAD   [arrowhead = "tee", label = "disaggregate"];
PROTEA   -> CLR_TOT;
LYSO     -> CLR_TOT;
CMA      -> CLR_TOT;
CLR_TOT  -> A_LOAD   [arrowhead = "tee", label = "intracellular clearance\n— the RIGHT compartment", penwidth = 2.0, color = "#1c6b3a"];
CLR_TOT  -> TAU_MON  [arrowhead = "tee", label = "monomer degradation"];
A_LOAD   -> LYSO     [arrowhead = "tee", label = "lysosomal\nstress", style = "dashed"];

/* ---- 6 : release into the exhaust pool ---- */
RELEASE_A -> ETAU_N;
RELEASE_A -> ETAU_S;
RELEASE_U -> ETAU_N;
RELEASE_U -> ETAU_S;
TAU_MON   -> RELEASE_A [label = "activity-dependent"];
A_LOAD    -> RELEASE_U [penwidth = 1.6];
A_LOAD    -> EXOSOME;
A_LOAD    -> TNT;
NEUR_R    -> DEATH_REL [arrowhead = "tee", style = "dashed"];
APOP      -> DEATH_REL [penwidth = 1.6];
DEATH_REL -> ETAU_N;
DEATH_REL -> ETAU_S;
ETAU_N    -> ISF_FLOW;
ETAU_S    -> ISF_FLOW;
ISF_FLOW  -> CSF_N;
GLYMPH    -> CSF_N;
ETAU_N    -> GLYMPH;
CSF_N     -> BLOOD_TAU;
ETAU_S    -> CSF_S     [penwidth = 1.6];
ETAU_N    -> F_EXT     [style = "dotted"];
TAU_MON   -> F_EXT     [style = "dotted"];
F_EXT     -> CEILING_EXT [penwidth = 2.0];
PHI_ACC   -> CEILING_EXT [penwidth = 2.0];
MG_PHAGO  -> ETAU_N   [arrowhead = "tee", label = "competing sink"];
MG_PHAGO  -> ETAU_S   [arrowhead = "tee"];

/* ---- 7 : uptake, seeding and the accessible fraction ---- */
ETAU_S   -> HSPG      [penwidth = 1.8, color = "#8f2020"];
ETAU_S   -> LRP1      [penwidth = 1.8, color = "#8f2020"];
ETAU_S   -> M1M3;
HSPG     -> MACROPIN;
LRP1     -> ENDOSOME  [penwidth = 1.8];
M1M3     -> ENDOSOME;
MACROPIN -> ENDOSOME;
ENDOSOME -> ESCAPE;
ESCAPE   -> TEMPLATE  [label = "cytoplasmic access", penwidth = 2.0, color = "#b35c00"];
EXOSOME  -> ENDOSOME  [label = "not antibody-accessible", style = "bold"];
TNT      -> TEMPLATE  [label = "not antibody-accessible", style = "bold"];
SYN_CLEFT-> LRP1       [label = "short residence"];
RELEASE_A-> SYN_CLEFT;
PHI_ACC  -> ETAU_S     [label = "gates the accessible\npart of the flux", penwidth = 2.0];
EXOSOME  -> PHI_ACC    [arrowhead = "tee", style = "dashed"];
TNT      -> PHI_ACC    [arrowhead = "tee", style = "dashed"];
SYN_CLEFT-> PHI_ACC    [arrowhead = "tee", style = "dashed"];
A_LOAD   -> FRAGMENT;
FRAGMENT -> SEED_UNIT;

/* ---- 8 : the wave ---- */
TEMPLATE  -> LOGISTIC  [penwidth = 1.6];
TAU_MON   -> LOGISTIC  [label = "finite substrate ⇒\nsaturation"];
LOGISTIC  -> SATURATED [penwidth = 2.0];
SATURATED -> VELOCITY  [label = "so v, not k, sets\nthe clinical slope", penwidth = 2.0];
CONNECTOME-> FRONT     [penwidth = 1.8];
ETAU_S    -> FRONT     [label = "inter-regional flux D", penwidth = 1.8, color = "#8f2020"];
EXOSOME   -> FRONT;
TNT       -> FRONT;
FRONT     -> VELOCITY  [penwidth = 2.0];
TAU_MON   -> VELOCITY  [label = "M", penwidth = 1.6];
VELOCITY  -> LINEARITY [penwidth = 2.0];
LOGISTIC  -> LINEARITY [label = "sum of saturating\nsigmoids", penwidth = 1.6];
VELOCITY  -> SQRT_LAW  [penwidth = 2.0];
LINEARITY -> PSPRS     [label = "10-11 pts/y", penwidth = 2.2, color = "#b02020"];
ORIGIN_RS -> R_MIDB    [penwidth = 1.6];
ORIGIN_P  -> R_SNC     [penwidth = 1.6];
ORIGIN_RS -> PSP_RS    [penwidth = 1.8];
ORIGIN_P  -> PSP_P     [penwidth = 1.8];

/* ---- 9 : the region chain (the front's path) ---- */
FRONT -> R_STN  [penwidth = 1.4];
R_STN -> R_GPI  [label = "W₂₁", penwidth = 1.8, color = "#b35c00"];
R_STN -> R_SNC  [label = "W₃₁", penwidth = 1.4, color = "#b35c00"];
R_GPI -> R_MIDB [label = "W₄₂", penwidth = 1.8, color = "#b35c00"];
R_SNC -> R_GPI  [label = "W₂₃", penwidth = 1.2, color = "#b35c00"];
R_MIDB-> R_PPN  [label = "W₅₄", penwidth = 1.8, color = "#b35c00"];
R_PPN -> R_DENT [label = "W₆₅", penwidth = 1.4, color = "#b35c00"];
R_MIDB-> R_FRONT[label = "W₇₄", penwidth = 1.4, color = "#b35c00"];
R_DENT-> R_FRONT[label = "W₇₆ (via thalamus)", penwidth = 1.2, color = "#b35c00"];
R_PPN -> R_LC   [label = "W₈₅", penwidth = 1.4, color = "#b35c00"];
R_MIDB-> MIDB_ATR [penwidth = 1.8];
R_GPI -> THAL;
STRI  -> R_GPI;
R_SNC -> STRI;
R_FRONT-> M1;
A_LOAD -> R_STN [style = "dotted"];

/* ---- 10 : region → neuron loss → the integrator ---- */
A_LOAD   -> SYNLOSS  [penwidth = 1.6];
A_LOAD   -> AXTRANS  [penwidth = 1.6];
TAU_MT   -> AXTRANS  [arrowhead = "tee", label = "MT integrity"];
AXTRANS  -> MITODYS;
MITODYS  -> ATP      [arrowhead = "tee"];
A_LOAD   -> DENDRIT;
SYNLOSS  -> NEUR_R   [arrowhead = "tee", penwidth = 1.6];
C1Q      -> SYNLOSS  [penwidth = 1.6];
A_LOAD   -> APOP     [penwidth = 1.8, color = "#b02020"];
CYTO     -> APOP     [penwidth = 1.4];
FERRO    -> APOP;
IFN1     -> APOP     [penwidth = 1.2];
APOP     -> NEUR_R   [arrowhead = "tee", penwidth = 2.0, color = "#b02020"];
NEUR_R   -> NFL_REL  [arrowhead = "tee", label = "loss ⇒ release", penwidth = 1.8];
NFL_REL  -> BM_NFL   [penwidth = 2.0];
NEUR_R   -> RESERVE  [penwidth = 2.0];
RESERVE  -> LAG1     [penwidth = 2.0];

/* ---- 11 : glia ---- */
ETAU_S   -> MG_HOM   [label = "DAMP"];
A_LOAD   -> MG_HOM;
MG_HOM   -> MG_ACT   [penwidth = 1.6];
TREM2    -> MG_ACT;
MG_ACT   -> NLRP3;
NLRP3    -> IL1B;
MG_ACT   -> TNFA;
MG_ACT   -> IL6;
IL1B     -> CYTO;
TNFA     -> CYTO;
IL6      -> CYTO;
MG_ACT   -> C1Q;
MG_ACT   -> MG_PHAGO;
CYTO     -> ASTRO    [penwidth = 1.4];
ASTRO    -> GFAP_R;
GFAP_R   -> BM_GFAP;
MG_ACT   -> BM_STREM2;
MG_ACT   -> TSPO     [penwidth = 1.4];
CYTO     -> GSK3B    [label = "kinase tone ↑", style = "dashed"];
CYTO     -> ROS;

/* ---- 12 : LINE-1 / interferon ---- */
L1_DEREP -> L1_RT    [penwidth = 1.6];
L1_RT    -> CYTO_DNA [penwidth = 1.6];
CYTO_DNA -> CGAS;
CGAS     -> STING;
STING    -> IFN1     [penwidth = 1.6];
IFN1     -> ISG;
IFN1     -> MG_ACT   [penwidth = 1.6];
A_LOAD   -> L1_DEREP [style = "dashed", label = "chromatin\nrelaxation"];

/* ---- 13 : bioenergetics ---- */
CPLX1  -> ATP      [penwidth = 1.4];
CPLX1  -> ROS      [arrowhead = "tee", style = "dashed"];
ROS    -> LPO      [penwidth = 1.4];
PUFA   -> LPO;
GPX4   -> LPO      [arrowhead = "tee"];
NRF2   -> GPX4;
LPO    -> FERRO    [penwidth = 1.4];
ATP    -> MACROAUT [label = "energy for\nclearance"];
ATP    -> PROTEA;
ROS    -> TAU_MISF [style = "dashed"];
LPO    -> SYNLOSS  [style = "dashed"];

/* ---- 14 : circuits and cardinal signs ---- */
NEUR_R  -> BG_LOOP    [arrowhead = "tee"];
R_GPI   -> BG_LOOP    [penwidth = 1.4];
R_STN   -> BG_LOOP;
R_SNC   -> DOPA_DEF   [penwidth = 1.6];
DOPA_DEF-> BG_LOOP;
R_MIDB  -> SACC_GEN   [penwidth = 2.0];
R_MIDB  -> OMNIP      [penwidth = 1.6];
SACC_GEN-> SACC_VEL   [penwidth = 2.2];
OMNIP   -> SQ_WAVE    [penwidth = 1.4];
SACC_VEL-> PSPRS_O    [penwidth = 1.8];
SACC_VEL-> VOG        [penwidth = 2.0];
R_PPN   -> PPN_LOCO   [penwidth = 2.0];
PPN_LOCO-> POST_INST  [penwidth = 2.0];
POST_INST-> FALLS     [penwidth = 2.0];
POST_INST-> PSPRS_G   [penwidth = 2.0];
R_LC    -> BULBAR     [penwidth = 1.6];
BULBAR  -> DYSPH      [penwidth = 2.0];
BULBAR  -> DYSARTH;
DYSPH   -> PSPRS_B    [penwidth = 1.8];
DYSARTH -> PSPRS_B;
R_FRONT -> FRONT_EXEC [penwidth = 1.6];
FRONT_EXEC-> PSPRS_M  [penwidth = 1.6];
FRONT_EXEC-> MOCA     [penwidth = 1.6];
FRONT_EXEC-> PSEUDOB;
R_DENT  -> CEREB      [penwidth = 1.4];
CEREB   -> PSP_C;
R_LC    -> NORAD;
BG_LOOP -> PSPRS_L    [penwidth = 1.6];
DOPA_DEF-> PSPRS_L;

/* ---- 15 : the endpoint chain ---- */
LAG1    -> LAG2       [penwidth = 2.0];
LAG2    -> PSPRS      [penwidth = 2.2];
PSPRS_H -> PSPRS      [label = "×1"];
PSPRS_M -> PSPRS;
PSPRS_B -> PSPRS;
PSPRS_O -> PSPRS;
PSPRS_L -> PSPRS;
PSPRS_G -> PSPRS      [penwidth = 1.8, label = "dominant"];
PSPRS   -> MPSPRS10   [label = "10/15-item subset", penwidth = 1.6];
PSPRS   -> SEADL      [penwidth = 1.4];
PSPRS   -> CGI;
PSPRS   -> PSPQOL;
MCID    -> PSPRS      [style = "dotted"];
RESERVE -> POWER_TRAP [penwidth = 2.0];
LAG2    -> POWER_TRAP [penwidth = 2.0];
POWER_TRAP -> MPSPRS10[label = "partially mitigated by\nlower measurement noise", style = "dashed"];

/* ---- 16 : imaging ---- */
MIDB_ATR -> MIDB_AREA [penwidth = 1.8];
MIDB_AREA-> MRPI      [penwidth = 1.8];
SCP_W    -> MRPI;
V3       -> MRPI;
R_DENT   -> SCP_W     [arrowhead = "tee"];
NEUR_R   -> VBM       [arrowhead = "tee"];
NEUR_R   -> FDG       [arrowhead = "tee", penwidth = 1.4];
A_LOAD   -> TAUPET    [penwidth = 1.8];
DTI_SCP  -> MRPI      [style = "dotted"];
R_DENT   -> DTI_SCP   [arrowhead = "tee"];

/* ---- 17 : biomarkers and the decoy ---- */
CSF_N    -> BM_NTAU   [penwidth = 2.2];
CSF_N    -> BM_TTAU   [penwidth = 1.6];
PTAU     -> BM_P181   [penwidth = 1.6];
PTAU     -> BM_P217   [style = "dotted"];
TRUNC    -> BM_MTBR   [penwidth = 2.0];
CSF_S    -> BM_SEED   [penwidth = 2.2];
BM_NTAU  -> ASSAY_WRONG [penwidth = 2.2];
NTFRAG   -> ASSAY_WRONG [penwidth = 1.8];
BM_MTBR  -> ASSAY_RIGHT [penwidth = 2.0];
BM_SEED  -> ASSAY_RIGHT [penwidth = 2.0];
BM_NFL   -> ASSAY_RIGHT [penwidth = 2.0];
ASSAY_WRONG -> T_PASSPORT [label = "what was measured", style = "dashed"];
ASSAY_RIGHT -> T_PRESERVE [label = "what to measure", style = "dashed"];

/* ---- 18 : mAb PK and the ceiling ---- */
D_GOSU  -> AB_CENT [penwidth = 1.8];
D_TILA  -> AB_CENT [penwidth = 1.8];
D_MID   -> AB_CENT [penwidth = 1.8];
AB_CENT -> AB_PER  [dir = "both"];
FCRN    -> AB_CENT [label = "recycling"];
AB_CENT -> BBB_TC  [penwidth = 1.8];
BBB_TC  -> AB_ISF  [label = "0.1-0.2%", penwidth = 2.0, color = "#b02020"];
AB_ISF  -> AB_CSF  [dir = "both"];
AB_ISF  -> CPLX_N  [label = "high affinity", penwidth = 2.2, color = "#b02020"];
ETAU_N  -> CPLX_N  [penwidth = 2.2];
AB_ISF  -> CPLX_S  [label = "≈ no affinity for\nN-terminally cleaved seeds", style = "dashed"];
ETAU_S  -> CPLX_S  [style = "dashed"];
CPLX_N  -> BM_NTAU [arrowhead = "tee", label = "−98% of the\nmeasured pool", penwidth = 2.2, color = "#b02020"];
CPLX_S  -> ETAU_S  [arrowhead = "tee", label = "≈0 for N-terminal mAb;\nthe whole effect for a\nmid-domain mAb", penwidth = 1.8];
ADA     -> AB_CENT [arrowhead = "tee"];
AB_ISF  -> ENGAGE_PARADOX [penwidth = 2.0];
ETAU_N  -> ENGAGE_PARADOX [penwidth = 2.0];
ENGAGE_PARADOX -> CEILING_EXT [penwidth = 2.2];
CEILING_EXT -> PSPRS [arrowhead = "tee", label = "why Δ = −0.2 points", style = "bold", color = "#b02020", penwidth = 2.2];
D_MID   -> PHI_ACC [label = "effect bounded by Φ_ACC,\nnot by F_EXT", style = "dashed", penwidth = 1.6];

/* ---- 19 : ASO PK ---- */
D_ASO   -> ASO_CSF [penwidth = 1.8];
ASO_CSF -> ASO_TIS [penwidth = 1.8];
ASO_TIS -> ASO_GRAD;
ASO_GRAD-> RNASEH1 [label = "deep-nucleus exposure\nis the limiting factor", penwidth = 1.8];
ASO_TIS -> RNASEH1 [penwidth = 1.8];
ASO_CSF -> ASO_TOX [style = "dashed"];
RNASEH1 -> TAU_MON [arrowhead = "tee", label = "M ↓ — the ONLY node\nupstream of the wave", penwidth = 2.2, color = "#1c6b3a"];
TAU_MON -> SQRT_LAW [label = "v ∝ √M", penwidth = 2.0];
SQRT_LAW-> PSPRS    [arrowhead = "tee", label = "20% tau ⇒ ~10-20%\nslope reduction", penwidth = 2.0, color = "#1c6b3a"];

/* ---- 20 : small molecules, vaccine, symptomatic ---- */
D_TIDE -> GUT;
D_OGA  -> GUT;
D_SALS -> GUT;
D_TPN  -> GUT;
D_LM11 -> GUT;
D_EZE  -> GUT;
D_RILU -> GUT;
D_LDOPA-> GUT;
D_ZOLP -> GUT;
D_AMAN -> GUT;
D_COQ  -> GUT;
GUT    -> CYP;
CYP    -> KP_BRAIN;
GUT    -> KP_BRAIN;
D_DAVU -> KP_BRAIN [label = "intranasal"];
D_FASU -> KP_BRAIN;
KP_BRAIN -> GSK3B   [arrowhead = "tee", label = "tideglusib", color = "#b02020"];
KP_BRAIN -> OGA     [arrowhead = "tee", label = "OGA inhibitor", color = "#b02020"];
KP_BRAIN -> TAU_MT  [label = "davunetide: MT\nstabilisation", color = "#1c6b3a"];
KP_BRAIN -> P300    [arrowhead = "tee", label = "salsalate", color = "#b02020"];
KP_BRAIN -> ROCK    [arrowhead = "tee", label = "fasudil", color = "#b02020"];
KP_BRAIN -> L1_RT   [arrowhead = "tee", label = "TPN-101", color = "#b02020"];
KP_BRAIN -> ACTAU   [arrowhead = "tee", label = "LM11A-31 (p75NTR)", color = "#b02020"];
KP_BRAIN -> PGRN    [label = "ezeprogind", color = "#1c6b3a"];
KP_BRAIN -> DOPA_DEF[arrowhead = "tee", label = "levodopa\n(modest, transient)"];
KP_BRAIN -> BG_LOOP [arrowhead = "tee", label = "zolpidem\n(GABA-A α1 on GPi)"];
KP_BRAIN -> APOP    [arrowhead = "tee", label = "riluzole", style = "dashed"];
KP_BRAIN -> LPO     [arrowhead = "tee", label = "CoQ10 / RT001", style = "dashed"];
D_AAD  -> VAX_TITR  [penwidth = 1.6];
VAX_TITR -> AB_ISF  [label = "same 0.1-0.2% ceiling", penwidth = 1.8, color = "#b02020"];
D_BTX  -> SQ_WAVE   [arrowhead = "tee", label = "blepharospasm / ALO"];
D_PEG  -> ASPIR     [arrowhead = "tee", label = "hazard modifier, not\ndisease modifier", penwidth = 1.6];

/* ---- inertness statements: three nulls from one structure ---- */
GSK3B   -> SATURATED [style = "dashed", label = "acts on k — INERT", color = "#7a7a7a"];
OGA     -> SATURATED [style = "dashed", label = "acts on k — INERT", color = "#7a7a7a"];
TAU_MT  -> SATURATED [style = "dashed", label = "acts on k — INERT", color = "#7a7a7a"];
SATURATED -> T_TAUROS  [style = "dashed", label = "predicts"];
SATURATED -> T_AL108   [style = "dashed", label = "predicts"];
CEILING_EXT -> T_PASSPORT [style = "dashed", label = "predicts"];
CEILING_EXT -> T_ARISE    [style = "dashed", label = "predicts"];
SQRT_LAW -> T_NIO1        [style = "dashed", label = "predicts"];
SQRT_LAW -> T_PRESERVE    [style = "dashed", label = "predicts effect size"];
LINEARITY -> T_GOLBE      [style = "dashed", label = "reproduces"];
POWER_TRAP -> T_PLATFORM  [style = "dashed", label = "design implication"];
KP_BRAIN -> T_NNIPPS      [style = "dashed", label = "riluzole null"];

/* ---- 21 : subtypes ---- */
MDS_CRIT -> PSP_RS;
MDS_CRIT -> PSP_P;
MDS_CRIT -> PSP_PGF;
MDS_CRIT -> PSP_CBS;
MDS_CRIT -> PSP_F;
MDS_CRIT -> PSP_SL;
MDS_CRIT -> PSP_C;
SACC_VEL -> MDS_CRIT [label = "O domain"];
FALLS    -> MDS_CRIT [label = "P domain"];
FRONT_EXEC-> MDS_CRIT[label = "C domain"];
PSP_RS   -> PSPRS    [label = "slope ≈ 11", style = "dotted"];
PSP_P    -> PSPRS    [label = "slope ≈ 5", style = "dotted"];

/* ---- 22 : survival, competing risks ---- */
DYSPH  -> ASPIR    [penwidth = 2.0];
POST_INST -> IMMOB [penwidth = 1.6];
DYSPH  -> NUTR;
ASPIR  -> PNEUM    [penwidth = 2.0];
IMMOB  -> PNEUM    [penwidth = 1.4];
NUTR   -> H_OTHER;
PNEUM  -> H_PNEU   [penwidth = 2.0];
IMMOB  -> H_OTHER;
PSPRS  -> H_OTHER  [label = "global severity", style = "dashed"];
H_PNEU -> CIF_P    [label = "dCIF/dt = h·S", penwidth = 2.0];
H_OTHER-> CIF_O    [label = "dCIF/dt = h·S", penwidth = 2.0];
CIF_P  -> SURV     [arrowhead = "tee", penwidth = 2.0];
CIF_O  -> SURV     [arrowhead = "tee", penwidth = 2.0];
PSP_RS -> SURV     [label = "≈7 y", style = "dotted"];
PSP_P  -> SURV     [label = "≈9-12 y", style = "dotted"];

}
