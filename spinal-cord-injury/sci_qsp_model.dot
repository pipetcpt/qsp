    Two_clocks [label="Two clocks: neuroprotection (h)\nvs plasticity (weeks–months)", shape=note, fillcolor="#f5c6c6"];
    Recovery_creates_pathology [label="Reflex return creates NEW pathology\n(spasticity, AD)", shape=note, fillcolor="#f5c6c6"];
