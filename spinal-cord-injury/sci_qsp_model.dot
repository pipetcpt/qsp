digraph SCI_QSP {
  rankdir=LR;
  fontname="Helvetica";
  labelloc="t";
  fontsize=20;
  label="Traumatic Spinal Cord Injury (SCI) — Mechanistic QSP Map\nPrimary Mechanical Insult → Time-Windowed Secondary Injury Cascade → Axonal Sparing → Plasticity → ISNCSCI Motor Recovery";
  node [style=filled, fontname="Helvetica", fontsize=10, shape=box];
  edge [fontname="Helvetica", fontsize=8];
  newrank=true;

  /* ======================================================================
     1. PRIMARY MECHANICAL INJURY  (t = 0, irreversible, no drug target)
     ====================================================================== */
  subgraph cluster_primary {
    label="1. Primary Mechanical Injury (t=0, irreversible — NOT a drug target)";
    style=filled; color="#d8d8d8"; fillcolor="#efefef";
    Trauma_event [label="Trauma\n(fall, MVC, sport, violence)", fillcolor="#f5c6c6"];
    Injury_mechanism [label="Mechanism\nflexion-distraction / burst /\nfracture-dislocation / SCIWORA"];
    Impact_energy [label="Impact energy\n& velocity"];
    Cord_compression [label="Persistent cord\ncompression (mm, %)", fillcolor="#f5c6c6"];
    Cord_contusion [label="Cord contusion\n(central gray matter)"];
    Shear_stretch [label="Axonal shear /\nstretch injury"];
    Neuro_level [label="Neurological level\n(C1–S5; C5 & T12 modal)"];
    AIS_grade_initial [label="Initial AIS grade\n(A/B/C/D — baseline severity)", fillcolor="#f5c6c6"];
    Cord_diameter_ratio [label="Maximum canal\ncompromise / cord ratio"];
    Membrane_disruption [label="Immediate membrane\ndisruption & necrosis"];
    Microvascular_rupture [label="Microvascular rupture\n& petechial hemorrhage"];
    Central_hemorrhagic_necrosis [label="Central hemorrhagic\nnecrosis (core)"];
    Primary_axon_loss [label="Primary axonal\nloss (mechanical)", fillcolor="#f5c6c6"];
    Spared_rim [label="Subpial spared\nwhite-matter rim", fillcolor="#cfe8cf"];
  }

  /* ======================================================================
     2. HEMODYNAMICS / CORD PERFUSION
     ====================================================================== */
  subgraph cluster_perf {
    label="2. Systemic Hemodynamics & Cord Perfusion (modifiable within hours–days)";
    style=filled; color="#cddff0"; fillcolor="#e7f0fa";
    Neurogenic_shock [label="Neurogenic shock\n(lesion above T6)"];
    Sympathectomy [label="Descending sympathetic\noutflow interruption"];
    Bradycardia [label="Bradycardia\n(unopposed vagal tone)"];
    Vasodilation [label="Systemic\nvasodilation"];
    MAP [label="Mean arterial\npressure (MAP)", fillcolor="#bfd8f0"];
    Hemorrhagic_shock_polytrauma [label="Concomitant hemorrhagic\nshock (polytrauma)"];
    Vasopressor_support [label="Vasopressor support\n(norepinephrine / dopamine)"];
    MAP_target_protocol [label="MAP ≥ 85–90 mmHg\n× 7 days protocol", fillcolor="#bfe3f5"];
    Intraspinal_pressure [label="Intraspinal / intrathecal\npressure (ISP)"];
    Cord_perfusion_pressure [label="Spinal cord perfusion\npressure (SCPP = MAP − ISP)", fillcolor="#bfd8f0"];
    Autoregulation_loss [label="Loss of cord\nautoregulation"];
    Cord_blood_flow [label="Spinal cord\nblood flow (SCBF)"];
    Ischemia [label="Ischemic burden\n(penumbra)", fillcolor="#f5d5a8"];
    Reperfusion [label="Reperfusion\n(post-decompression)"];
    Venous_congestion [label="Venous outflow\nobstruction"];
    Duraplasty_CSF_drainage [label="Expansile duraplasty /\nCSF drainage (investigational)"];
  }

  /* ======================================================================
     3. EDEMA & IONIC DYSREGULATION
     ====================================================================== */
  subgraph cluster_edema {
    label="3. Cord Swelling & Ionic Dysregulation (the compression–edema–ischemia vicious cycle)";
    style=filled; color="#cfe6e0"; fillcolor="#e6f5f1";
    ATP_depletion [label="ATP depletion\n(mitochondrial failure)"];
    NaK_ATPase_failure [label="Na⁺/K⁺-ATPase\nfailure"];
    SUR1_TRPM4 [label="SUR1–TRPM4 channel\nupregulation", fillcolor="#bfe3d8"];
    Na_influx [label="Na⁺ influx\n(cytotoxic edema)"];
    AQP4 [label="AQP4 aquaporin\nupregulation"];
    Water_influx [label="Astrocyte water\ninflux & swelling"];
    Cord_edema [label="Cord edema\n(T2 signal, swelling)", fillcolor="#f5d5a8"];
    BSCB_breakdown [label="Blood–spinal-cord barrier\n(BSCB) breakdown", fillcolor="#f5d5a8"];
    MMP9 [label="MMP-9\n(tight-junction proteolysis)"];
    Tight_junction_loss [label="Claudin-5 / occludin\nloss"];
    Capillary_endothelial_death [label="Capillary endothelial\ncell death"];
    Cord_swelling_against_dura [label="Cord swelling against\nnon-compliant dura"];
    K_efflux [label="Extracellular K⁺\naccumulation"];
    Acidosis [label="Tissue lactic\nacidosis"];
    Ascending_edema [label="Rostral ascending edema\n(delayed respiratory failure)"];
  }

  /* ======================================================================
     4. EXCITOTOXICITY
     ====================================================================== */
  subgraph cluster_excito {
    label="4. Glutamatergic Excitotoxicity (minutes–hours: the narrowest window)";
    style=filled; color="#e6d5ef"; fillcolor="#f3ecf9";
    Glutamate_release [label="Presynaptic glutamate\nrelease (vesicular)"];
    EAAT_reversal [label="EAAT/GLT-1 transporter\nreversal & failure"];
    Extracellular_glutamate [label="Extracellular\nglutamate ↑↑", fillcolor="#e3c9f0"];
    NMDA_receptor [label="NMDA receptor\nactivation"];
    AMPA_kainate [label="AMPA / kainate\nreceptor activation"];
    Na_channel_persistent [label="Persistent Na⁺\ncurrent (NaV1.6)"];
    Ca_influx [label="Ca²⁺ influx\n(NMDA / VGCC / reverse NCX)"];
    Ca_overload [label="Intracellular Ca²⁺\noverload", fillcolor="#e3c9f0"];
    Calpain [label="Calpain activation\n(cytoskeletal proteolysis)"];
    Spectrin_breakdown [label="α-II-spectrin\nbreakdown products"];
    Mito_Ca_uptake [label="Mitochondrial Ca²⁺\nuptake & mPTP opening"];
    Cyt_c_release [label="Cytochrome-c\nrelease"];
    Nitric_oxide_nNOS [label="nNOS activation\n→ NO"];
    Axonal_degeneration_acute [label="Acute axonal\ndegeneration"];
    Oligodendrocyte_excitotox [label="Oligodendrocyte\nAMPA excitotoxicity"];
  }

  /* ======================================================================
     5. OXIDATIVE STRESS
     ====================================================================== */
  subgraph cluster_ox {
    label="5. Oxidative Stress & Lipid Peroxidation (hours — the methylprednisolone target)";
    style=filled; color="#f0dcc8"; fillcolor="#fbf1e6";
    Superoxide [label="Superoxide (O₂⁻)\nmitochondrial leak"];
    Peroxynitrite [label="Peroxynitrite\n(ONOO⁻)"];
    Hydroxyl_radical [label="Hydroxyl radical\n(Fenton, heme iron)"];
    Free_iron [label="Free iron from\nhemorrhage / hemoglobin"];
    Lipid_peroxidation [label="Membrane lipid\nperoxidation", fillcolor="#f0c9a8"];
    HNE_MDA [label="4-HNE / MDA\nadducts (biomarker)"];
    Protein_nitration [label="Protein 3-nitrotyrosine\nnitration"];
    Ferroptosis [label="Ferroptosis\n(GPX4 depletion)"];
    Nrf2_HO1 [label="Nrf2 / HO-1\nantioxidant response"];
    SOD_catalase [label="SOD / catalase /\nglutathione defense"];
    ROS_burden [label="Net oxidative\nburden", fillcolor="#f0c9a8"];
    Mito_dysfunction [label="Mitochondrial\ndysfunction"];
  }

  /* ======================================================================
     6. INNATE IMMUNE RESPONSE
     ====================================================================== */
  subgraph cluster_inflam {
    label="6. Neuroinflammation (days–weeks: neutrophils → microglia/macrophage M1/M2 balance)";
    style=filled; color="#f0d2d2"; fillcolor="#fbe9e9";
    DAMPs [label="DAMPs\n(HMGB1, ATP, DNA)"];
    TLR4_NFkB [label="TLR4 → NF-κB\nsignaling"];
    NLRP3_inflammasome [label="NLRP3 inflammasome\n→ caspase-1"];
    IL1b [label="IL-1β"];
    TNFa [label="TNF-α"];
    IL6 [label="IL-6"];
    CXCL1_CCL2 [label="CXCL1 / CCL2\nchemokines"];
    Neutrophil_infiltration [label="Neutrophil infiltration\n(peak 24 h)", fillcolor="#f0b8b8"];
    Neutrophil_elastase_MPO [label="Elastase / MPO /\nNADPH oxidase burst"];
    Monocyte_recruitment [label="Blood monocyte\nrecruitment (peak 3–7 d)"];
    Microglia_activation [label="Resident microglia\nactivation (min–hours)"];
    M1_phenotype [label="M1 pro-inflammatory\nmacrophage/microglia", fillcolor="#f0b8b8"];
    M2_phenotype [label="M2 pro-repair\nmacrophage/microglia", fillcolor="#cfe8cf"];
    IL4_IL10_TGFb [label="IL-4 / IL-10 / TGF-β\n(anti-inflammatory)"];
    Lymphocyte_infiltration [label="T / B lymphocyte\ninfiltration (weeks)"];
    Autoantibody_response [label="Anti-CNS autoantibody\nresponse (chronic)"];
    Systemic_immune_depression [label="SCI-induced immune\ndepression syndrome"];
    Cytokine_pool [label="Net pro-inflammatory\ncytokine burden", fillcolor="#f0b8b8"];
    Phagocytic_debris_clearance [label="Myelin-debris\nphagocytic clearance", fillcolor="#cfe8cf"];
  }

  /* ======================================================================
     7. CELL DEATH
     ====================================================================== */
  subgraph cluster_death {
    label="7. Cell Death Programs (the integrator of clusters 3–6)";
    style=filled; color="#dcd2ea"; fillcolor="#efe9f7";
    Caspase8 [label="Caspase-8\n(extrinsic, TNF-R/Fas)"];
    Caspase9 [label="Caspase-9\n(intrinsic, apoptosome)"];
    Caspase3 [label="Caspase-3 activation\n(common effector)", fillcolor="#d3c4e8"];
    Bax_Bcl2 [label="Bax / Bcl-2\nratio"];
    Necroptosis [label="Necroptosis\n(RIPK1/RIPK3/MLKL)"];
    Autophagy_flux [label="Autophagy flux\n(dual role)"];
    Neuron_death [label="Gray-matter neuron\ndeath (irreversible)", fillcolor="#f0b8b8"];
    Oligodendrocyte_apoptosis [label="Oligodendrocyte apoptosis\n(continues weeks)", fillcolor="#f0b8b8"];
    Wallerian_degeneration [label="Wallerian degeneration\n(distal axon)"];
    Retrograde_dieback [label="Retrograde axonal\ndieback"];
    Cystic_cavitation [label="Cystic cavity /\nlesion volume (MRI surrogate)", fillcolor="#f5d5a8"];
    Syringomyelia_late [label="Post-traumatic\nsyringomyelia (late)"];
  }

  /* ======================================================================
     8. DEMYELINATION & REMYELINATION
     ====================================================================== */
  subgraph cluster_myelin {
    label="8. Demyelination & Endogenous Remyelination";
    style=filled; color="#d2e6ea"; fillcolor="#e9f5f7";
    Myelin_sheath_loss [label="Myelin sheath\nloss"];
    Conduction_block [label="Conduction block /\nslowing", fillcolor="#f5d5a8"];
    K_channel_exposure [label="Juxtaparanodal K⁺\nchannel exposure"];
    Nav_redistribution [label="Nav channel\nredistribution"];
    OPC_NG2 [label="OPC / NG2⁺ cell\nproliferation", fillcolor="#cfe8cf"];
    Schwann_infiltration [label="Peripheral Schwann-cell\nremyelination"];
    Remyelination [label="Partial\nremyelination", fillcolor="#cfe8cf"];
    Thin_myelin [label="Thin / dysmyelinated\nsheaths"];
  }

  /* ======================================================================
     9. GLIAL SCAR & REGENERATION FAILURE
     ====================================================================== */
  subgraph cluster_scar {
    label="9. Astrogliosis, Glial Scar & Intrinsic Regeneration Failure (weeks — closes the window)";
    style=filled; color="#e0e0c8"; fillcolor="#f3f3e4";
    Astrocyte_reactivity [label="Reactive astrogliosis\n(GFAP, vimentin)", fillcolor="#e4e4b8"];
    Pericyte_fibroblast [label="Pericyte / fibroblast\nfibrotic core"];
    CSPG_deposition [label="CSPG deposition\n(neurocan, brevican, NG2)", fillcolor="#e4e4b8"];
    PTPsigma_LAR [label="PTPσ / LAR\nCSPG receptors"];
    Nogo_A [label="Nogo-A\n(oligodendrocyte myelin)", fillcolor="#e4e4b8"];
    MAG_OMgp [label="MAG / OMgp"];
    NgR1_p75 [label="NgR1 / p75 / LINGO-1\nreceptor complex"];
    RhoA_ROCK [label="RhoA–ROCK\nsignaling", fillcolor="#e4e4b8"];
    Growth_cone_collapse [label="Growth-cone\ncollapse"];
    PTEN_mTOR [label="PTEN ↑ / mTOR ↓\n(intrinsic growth failure)"];
    KLF_RAG_program [label="KLF / regeneration-associated\ngene program (silenced)"];
    Dystrophic_endball [label="Dystrophic axonal\nend-bulbs"];
    Scar_maturation [label="Scar maturation\n(2–6 weeks)"];
    Perineuronal_nets [label="Perineuronal net\nrestabilization"];
  }

  /* ======================================================================
     10. SPARED CIRCUITRY, PLASTICITY & FUNCTIONAL RECOVERY
     ====================================================================== */
  subgraph cluster_plast {
    label="10. Spared Descending Tracts, Plasticity & Circuit Reorganization (weeks–months)";
    style=filled; color="#cfe8cf"; fillcolor="#e8f5e8";
    CST_spared [label="Corticospinal tract\nspared fraction", fillcolor="#b8e0b8"];
    Reticulospinal_spared [label="Reticulospinal /\nvestibulospinal sparing", fillcolor="#b8e0b8"];
    Propriospinal_relay [label="Propriospinal relay\ndetour circuits"];
    Descending_drive [label="Effective descending\ndrive (CONN)", fillcolor="#b8e0b8"];
    Collateral_sprouting [label="Collateral sprouting\n& bouton formation"];
    Synaptogenesis [label="Synaptogenesis /\nsynaptic strengthening"];
    Critical_period [label="Heightened-plasticity\ncritical period (~0–3 mo)", fillcolor="#b8e0b8"];
    BDNF_NT3 [label="BDNF / NT-3\nneurotrophin tone"];
    CPG_locomotor [label="Lumbar locomotor\nCPG excitability"];
    Motoneuron_pool [label="Sublesional motoneuron\npool integrity"];
    Cortical_remap [label="Cortical / brainstem\nremapping"];
    Use_dependent_plasticity [label="Use-dependent\nHebbian plasticity", fillcolor="#b8e0b8"];
    Maladaptive_plasticity [label="Maladaptive plasticity\n(pain, spasticity)", fillcolor="#f0b8b8"];
    Muscle_atrophy [label="Sublesional muscle\natrophy & fiber-type shift"];
    Spontaneous_recovery [label="Spontaneous recovery\n(EMSCI trajectory)"];
  }

  /* ======================================================================
     11. METHYLPREDNISOLONE PK/PD
     ====================================================================== */
  subgraph cluster_mp {
    label="11. Drug PK/PD — Methylprednisolone sodium succinate (NASCIS II/III; window ≤ 8 h)";
    style=filled; color="#cddff0"; fillcolor="#e7f0fa";
    MP_dose [label="MPSS 30 mg/kg bolus\n+ 5.4 mg/kg/h × 23 h (or 47 h)", shape=oval, fillcolor="#bfd8f0"];
    MP_central [label="MP central\ncompartment"];
    MP_peripheral [label="MP peripheral\ncompartment"];
    MP_start_time [label="Time from injury\nto first dose (h)", shape=diamond, fillcolor="#f5c6c6"];
    MP_lipid_perox_inhibition [label="Lipid-peroxidation\ninhibition (high-dose, non-genomic)"];
    MP_GR_genomic [label="Glucocorticoid-receptor\ngenomic NF-κB suppression"];
    MP_cytokine_suppression [label="IL-1β / TNF-α\nsuppression"];
    MP_neutrophil_suppression [label="Neutrophil recruitment\nsuppression"];
    MP_cumulative_exposure [label="Cumulative MP\nexposure (AUC)"];
    MP_hyperglycemia [label="Hyperglycemia"];
    MP_pneumonia [label="Pneumonia /\nsepsis risk", fillcolor="#f0b8b8"];
    MP_GI_hemorrhage [label="GI hemorrhage", fillcolor="#f0b8b8"];
    MP_myopathy [label="Steroid myopathy /\nAVN (48-h regimen)", fillcolor="#f0b8b8"];
    MP_wound_healing [label="Impaired wound\nhealing"];
  }

  /* ======================================================================
     12. RILUZOLE PK/PD
     ====================================================================== */
  subgraph cluster_ril {
    label="12. Drug PK/PD — Riluzole (RISCIS; enteral 50 mg q12h × 14 d)";
    style=filled; color="#e6d5ef"; fillcolor="#f3ecf9";
    RIL_dose [label="Riluzole 100 mg q12h × 24 h\nthen 50 mg q12h × 13 d", shape=oval, fillcolor="#e3c9f0"];
    RIL_depot [label="Enteral / NG\nabsorption depot"];
    RIL_central [label="Riluzole plasma\ncompartment"];
    RIL_CYP1A2 [label="CYP1A2 metabolism\n(smoking, caffeine)"];
    RIL_Na_block [label="Persistent Na⁺-current\nblockade"];
    RIL_glutamate_release_block [label="Presynaptic glutamate\nrelease inhibition"];
    RIL_EAAT_uptake [label="Enhanced astrocytic\nglutamate uptake"];
    RIL_hepatotoxicity [label="ALT elevation\n(hepatotoxicity)", fillcolor="#f0b8b8"];
  }

  /* ======================================================================
     13. MINOCYCLINE / GLIBENCLAMIDE PK/PD
     ====================================================================== */
  subgraph cluster_other {
    label="13. Drug PK/PD — Minocycline & Glibenclamide (edema- and microglia-directed)";
    style=filled; color="#f0dcc8"; fillcolor="#fbf1e6";
    MINO_dose [label="Minocycline IV 800 mg\ntapering × 7 d", shape=oval, fillcolor="#f0c9a8"];
    MINO_central [label="Minocycline\nplasma"];
    MINO_M1_inhibition [label="M1 microglial activation\ninhibition"];
    MINO_MMP_inhibition [label="MMP-9 / MMP-2\ninhibition"];
    MINO_caspase_inhibition [label="Cytochrome-c release /\ncaspase inhibition"];
    MINO_vestibular [label="Vestibular / hepatic\nadverse effects", fillcolor="#f0b8b8"];
    GLY_dose [label="Glibenclamide low-dose IV\n(investigational)", shape=oval, fillcolor="#f0c9a8"];
    GLY_central [label="Glibenclamide\nplasma"];
    GLY_SUR1_block [label="SUR1–TRPM4\nchannel blockade"];
    GLY_hypoglycemia [label="Hypoglycemia\nrisk", fillcolor="#f0b8b8"];
  }

  /* ======================================================================
     14. REGENERATIVE / NEUROMODULATION INTERVENTIONS
     ====================================================================== */
  subgraph cluster_regen {
    label="14. Regenerative & Neuromodulation Interventions (plasticity-directed, weeks–months)";
    style=filled; color="#cfe8cf"; fillcolor="#e8f5e8";
    NOGO_dose [label="Anti-Nogo-A antibody\nintrathecal (NISCI)", shape=oval, fillcolor="#b8e0b8"];
    NOGO_ith [label="Intrathecal / CSF\nantibody compartment"];
    NOGO_target_binding [label="Nogo-A\nneutralization"];
    ROCK_inhibitor [label="Rho-ROCK inhibitor\n(VX-210 / fasudil)", shape=oval, fillcolor="#b8e0b8"];
    Chondroitinase [label="Chondroitinase ABC\n(preclinical)", shape=oval, fillcolor="#b8e0b8"];
    Rehab_intensity [label="Activity-based rehabilitation\nintensity & timing", shape=oval, fillcolor="#b8e0b8"];
    Body_weight_support_training [label="Body-weight-supported\ntreadmill / robotic gait"];
    Epidural_stimulation [label="Epidural electrical\nstimulation (eSCS)", shape=oval, fillcolor="#b8e0b8"];
    FES_cycling [label="Functional electrical\nstimulation cycling"];
    Cell_therapy [label="Cell transplantation\n(Schwann, OPC, MSC — investigational)", shape=oval];
    Surgical_decompression [label="Surgical decompression\n& stabilization", shape=oval, fillcolor="#bfd8f0"];
    Decompression_timing [label="Time to decompression\n(< 24 h vs later)", shape=diamond, fillcolor="#f5c6c6"];
  }

  /* ======================================================================
     15. SYMPTOMATIC PHARMACOLOGY
     ====================================================================== */
  subgraph cluster_symptom {
    label="15. Symptomatic Pharmacology (does not alter motor recovery)";
    style=filled; color="#e0d2e8"; fillcolor="#f0e9f5";
    BAC_dose [label="Baclofen PO / intrathecal", shape=oval, fillcolor="#d3c4e8"];
    BAC_central [label="Baclofen\ncompartment"];
    BAC_GABAB [label="GABA-B presynaptic\ninhibition"];
    BAC_weakness [label="Weakness / sedation\n(functional trade-off)", fillcolor="#f0b8b8"];
    PGB_dose [label="Pregabalin 150–600 mg/d", shape=oval, fillcolor="#d3c4e8"];
    PGB_central [label="Pregabalin\nplasma"];
    PGB_a2d [label="α2δ (CaV) subunit\nbinding"];
    PGB_sedation [label="Somnolence / edema /\nweight gain", fillcolor="#f0b8b8"];
    Antimuscarinic_onabotA [label="Antimuscarinic /\nonabotulinumtoxinA", shape=oval, fillcolor="#d3c4e8"];
    Alpha_blocker [label="α-blocker for\ndetrusor-sphincter dyssynergia", shape=oval, fillcolor="#d3c4e8"];
  }

  /* ======================================================================
     16. SECONDARY SYSTEMIC COMPLICATIONS
     ====================================================================== */
  subgraph cluster_systemic {
    label="16. Secondary Systemic & Organ-System Complications (months–years)";
    style=filled; color="#f0d2d2"; fillcolor="#fbe9e9";
    Reflex_reorganization [label="Sublesional reflex-arc\nreorganization (weeks)", fillcolor="#f0b8b8"];
    Spasticity [label="Spasticity\n(modified Ashworth)", fillcolor="#f0b8b8"];
    Clonus_spasms [label="Clonus / flexor\nspasms"];
    Neuropathic_pain [label="At/below-level neuropathic\npain (NRS 0–10)", fillcolor="#f0b8b8"];
    Central_sensitization [label="Dorsal-horn central\nsensitization"];
    Ectopic_firing [label="Ectopic afferent firing\n(partially spared axons)"];
    Neurogenic_bladder [label="Neurogenic detrusor\noveractivity", fillcolor="#f0b8b8"];
    DSD [label="Detrusor–sphincter\ndyssynergia"];
    UTI_risk [label="Recurrent UTI /\nupper-tract damage"];
    Autonomic_dysreflexia [label="Autonomic dysreflexia\n(lesion ≥ T6)", fillcolor="#f0b8b8"];
    AD_trigger [label="Noxious sublesional trigger\n(bladder / bowel distension)", shape=oval];
    AD_SBP_surge [label="Paroxysmal SBP surge\n(> +40 mmHg)", fillcolor="#f0b8b8"];
    Respiratory_function [label="Vital capacity / respiratory\nfunction (cervical lesions)", fillcolor="#f5d5a8"];
    Ventilator_dependence [label="Ventilator\ndependence"];
    Sublesional_osteoporosis [label="Sublesional bone-mineral-density\nloss (~1%/month early)", fillcolor="#f5d5a8"];
    Fragility_fracture [label="Fragility fracture\nrisk"];
    Pressure_injury [label="Pressure injury"];
    VTE_risk [label="DVT / pulmonary\nembolism risk"];
    Cardiometabolic [label="Cardiometabolic decline\n(insulin resistance, lipids)"];
    Orthostatic_hypotension [label="Orthostatic\nhypotension"];
    Heterotopic_ossification [label="Heterotopic\nossification"];
    Sexual_reproductive [label="Sexual / reproductive\ndysfunction"];
    Bowel_dysfunction [label="Neurogenic bowel\ndysfunction"];
  }

  /* ======================================================================
     17. CLINICAL ENDPOINTS
     ====================================================================== */
  subgraph cluster_endpoint {
    label="17. Clinical Endpoints & Outcome Measures";
    style=filled; color="#cddff0"; fillcolor="#e7f0fa";
    ISNCSCI_motor [label="ISNCSCI total motor\nscore (0–100)", fillcolor="#bfd8f0", shape=doubleoctagon];
    ISNCSCI_sensory [label="ISNCSCI light-touch /\npinprick score"];
    UEMS_LEMS [label="Upper- / lower-extremity\nmotor score (UEMS/LEMS)"];
    AIS_conversion [label="AIS grade conversion\n(≥1 or ≥2 grade)", fillcolor="#bfd8f0", shape=doubleoctagon];
    SCIM_III [label="SCIM III independence\nscore (0–100)"];
    WISCI_II [label="WISCI II walking\nindex"];
    Ten_meter_walk [label="10-m walk test /\n6-min walk"];
    GRASSP [label="GRASSP hand function\n(cervical)"];
    Pain_NRS [label="Pain NRS /\nNPSI"];
    Ashworth_score [label="Modified Ashworth\nscore"];
    Lesion_volume_MRI [label="MRI lesion volume /\nspared tissue bridges", fillcolor="#f5d5a8", shape=doubleoctagon];
    MEP_SSEP [label="MEP / SSEP\nneurophysiology"];
    NfL_GFAP_biomarker [label="CSF/serum NfL, GFAP,\nS100β biomarkers"];
    QoL_SF36 [label="QoL (SF-36, WHOQOL)\n& participation"];
    Mortality_LOS [label="Mortality / ICU\nlength of stay"];
  }

  /* ======================================================================
     18. MODEL-LEVEL QUANTITATIVE CONCEPTS
     ====================================================================== */
  subgraph cluster_concept {
    label="18. Quantitative Concepts Encoded in the mrgsolve Model";
    style=filled; color="#d8d8d8"; fillcolor="#efefef";
    Cascade_flux [label="Secondary-injury flux\nΦ(t): decaying pulse", shape=note, fillcolor="#f5d5a8"];
    Window_integral [label="Efficacy ∝ ∫ E(t)·Φ(t) dt\n→ TIMING dominates DOSE", shape=note, fillcolor="#f5c6c6"];
    Threshold_map [label="MOTOR = f(CONN) is a steep\nsaturating Hill function\n(TH50 ≈ 0.12)", shape=note, fillcolor="#f5c6c6"];
