digraph NTM_MAC_QSP_Model {
  graph [
    label=<<B>Nontuberculous Mycobacterial Lung Disease (MAC-PD) — QSP Mechanistic Map</B><BR/><FONT POINT-SIZE="14">Four physically separate bacterial niches × four drug-delivery routes: why the drug that reaches the phagosome is inactivated there,<BR/>and why inhaled liposomal amikacin is the only agent that crosses barrier 1 and barrier 3 at the same time</FONT>>
    labelloc=t fontsize=22 fontname="Helvetica"
    rankdir=LR bgcolor="#F7F8FA"
    splines=spline nodesep=0.35 ranksep=1.15
    newrank=true
    compound=true concentrate=false
  ]
  node [fontname="Helvetica" fontsize=10 style="filled,rounded" shape=box margin="0.14,0.05"]
  edge [fontname="Helvetica" fontsize=8 arrowsize=0.65 color="#5A6270"]

  //=========================================================
  // CLUSTER 1 : Host susceptibility — the "Lady Windermere" phenotype
  //=========================================================
  subgraph cluster_host {
    label="🧍 Host Susceptibility Phenotype (why MAC-PD picks its patients)"
    style=filled fillcolor="#EDE7F6" color="#5E35B1" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    H_body     [label="Slender body habitus\nBMI < 18.5 kg/m²\n(postmenopausal ♀)" fillcolor="#D1C4E9" color="#4527A0"]
    H_thorax   [label="Thoracic cage anomaly\nPectus excavatum · Scoliosis\nMVP · ↑AP-diameter ratio" fillcolor="#D1C4E9" color="#4527A0"]
    H_adipo    [label="↑ Adiponectin\n↓ Leptin\n(adipokine reversal)" fillcolor="#E1BEE7" color="#4527A0"]
    H_estr     [label="↓ Estradiol\n(post-menopause)" fillcolor="#E1BEE7" color="#4527A0"]
    H_cftr     [label="CFTR heterozygosity\n(≈ 17–36% of MAC-PD)" fillcolor="#D1C4E9" color="#4527A0"]
    H_pcd      [label="Ciliary dyskinesia variants\nDNAH5 · HYDIN · CCDC39" fillcolor="#D1C4E9" color="#4527A0"]
    H_a1at     [label="α1-antitrypsin\nheterozygote (MZ/SZ)" fillcolor="#D1C4E9" color="#4527A0"]
    H_tgfb     [label="TGF-β pathway variants\nMarfanoid / CTD spectrum" fillcolor="#E1BEE7" color="#4527A0"]
    H_gerd     [label="GERD · micro-aspiration\nAchalasia" fillcolor="#EDE7F6" color="#4527A0"]
    H_ics      [label="Inhaled corticosteroid use\n(HR ≈ 2–3, dose-dependent)" fillcolor="#FFCDD2" color="#C62828"]
    H_antiifng [label="Anti-IFN-γ autoantibody\n(disseminated NTM, E-Asian)" fillcolor="#FFCDD2" color="#C62828"]
    H_ifngr    [label="MSMD axis defects\nIFNGR1/2 · IL12RB1 · STAT1\nGATA2 · NEMO" fillcolor="#FFCDD2" color="#C62828"]
    H_suscep   [label="Composite susceptibility\nindex  S_host" shape=diamond fillcolor="#B39DDB" color="#311B92"]
  }

  //=========================================================
  // CLUSTER 2 : Exposure, mucociliary clearance, biofilm formation
  //=========================================================
  subgraph cluster_airway {
    label="🌬️ Exposure & First-Line Airway Defence"
    style=filled fillcolor="#E0F7FA" color="#00838F" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    E_water    [label="Environmental reservoir\nShowerhead · Hot tub · Soil\nMunicipal water biofilm" fillcolor="#B2EBF2" color="#006064"]
    E_aerosol  [label="Aerosolised MAC\n(1–5 µm droplet nuclei)" fillcolor="#B2EBF2" color="#006064"]
    E_deposit  [label="Right-middle-lobe / lingula\ndeposition (gravity + short,\npoorly-drained bronchi)" fillcolor="#80DEEA" color="#006064"]
    A_ciliary  [label="Ciliary beat frequency\nCBF (Hz)" fillcolor="#B2EBF2" color="#006064"]
    A_asl      [label="Airway surface liquid\ndepth · periciliary layer" fillcolor="#B2EBF2" color="#006064"]
    A_mucus    [label="Mucus burden MUC\nMUC5B/MUC5AC ratio↑\nviscoelasticity↑" fillcolor="#80DEEA" color="#006064"]
    A_mcc      [label="Mucociliary clearance\ncapacity  MCC" shape=diamond fillcolor="#26C6DA" fontcolor=white color="#006064"]
    A_cough    [label="Cough clearance\n(secondary, effort-dependent)" fillcolor="#E0F7FA" color="#006064"]
    A_defens   [label="β-defensin · LL-37\nlactoferrin · lysozyme" fillcolor="#E0F7FA" color="#006064"]
    A_no       [label="Airway nitric oxide\n(nNOS, ↓ in NTM/PCD)" fillcolor="#E0F7FA" color="#006064"]
  }

  //=========================================================
  // CLUSTER 3 : The four bacterial niches  (structural core of the model)
  //=========================================================
  subgraph cluster_niche {
    label="🦠 MAC Bacterial Niches — 4 physically separate compartments, 4 different drug accesses"
    style=filled fillcolor="#FFF3E0" color="#EF6C00" penwidth=3 fontsize=13 fontname="Helvetica-Bold"

    B_lumen    [label="① B_E  EXTRACELLULAR PLANKTONIC\nairway lumen / ELF\nfast-replicating (td ≈ 20 h)\nfully drug-accessible" fillcolor="#FFB74D" color="#E65100"]
    B_biofilm  [label="② B_B  BIOFILM-EMBEDDED\nbronchiectatic airway · mucus plug\nEPS + GPL matrix, slow growth\nphenotypic tolerance (persisters)" fillcolor="#FF8A65" color="#BF360C"]
    B_intra    [label="③ B_I  INTRACELLULAR\nmacrophage phagosome, pH 5.0–5.5\nnon-acidifying arrested phagosome\nreplication td ≈ 48–72 h" fillcolor="#FF7043" fontcolor=white color="#BF360C"]
    B_caseum   [label="④ B_C  CAVITY WALL / CASEUM\nnutrient- & O₂-starved, non-replicating\nlipid-rich caseous debris\nrelapse reservoir" fillcolor="#D84315" fontcolor=white color="#BF360C"]
    B_gpl      [label="GPL (glycopeptidolipid)\nsmooth ⇄ rough morphotype switch\nrough = ↑virulence, ↓biofilm" fillcolor="#FFE0B2" color="#E65100"]
    B_eps      [label="EPS matrix thickness\n→ drug diffusion barrier\nD_eff / D_water ≈ 0.2–0.6" fillcolor="#FFE0B2" color="#E65100"]
    B_efflux   [label="Efflux pumps\nMAV_1406 · Mmr · WhiB7 regulon\n(macrolide + aminoglycoside)" fillcolor="#FFCCBC" color="#BF360C"]
    B_wall     [label="Mycobacterial cell wall\nmycolic acid · arabinogalactan\n(≈ 20× permeability barrier)" fillcolor="#FFE0B2" color="#E65100"]
    B_total    [label="Total burden\nlog₁₀ CFU (sputum)" shape=diamond fillcolor="#FFA726" color="#E65100"]
    B_species  [label="Species / subspecies\nM. avium · M. intracellulare\nM. chimaera · M. abscessus" fillcolor="#FFF8E1" color="#E65100"]
  }

  //=========================================================
  // CLUSTER 4 : Resistant subpopulations & resistance genetics
  //=========================================================
  subgraph cluster_res {
    label="⚠️ Resistance Evolution — MAC carries a SINGLE rrl copy, so one point mutation = full resistance"
    style=filled fillcolor="#FFEBEE" color="#C62828" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    R_rrl      [label="rrl 23S rRNA\nA2058G / A2059G\nSINGLE-copy gene → dominant\nMIC ≥ 32 µg/mL" fillcolor="#EF9A9A" color="#B71C1C"]
    R_rrs      [label="rrs 16S rRNA A1408G\n→ amikacin MIC ≥ 64 µg/mL" fillcolor="#EF9A9A" color="#B71C1C"]
    R_embB     [label="embB codon 306\n(ethambutol, partial)" fillcolor="#FFCDD2" color="#B71C1C"]
    R_erm      [label="erm(41) inducible macrolide R\n(M. abscessus subsp. abscessus;\nabsent in MAC)" fillcolor="#FFCDD2" color="#B71C1C"]
    R_pre      [label="Pre-existing mutant fraction\nf₀ ≈ 10⁻⁸ – 10⁻⁹" fillcolor="#FFCDD2" color="#B71C1C"]
    R_BRE      [label="B_RE  resistant extracellular" fillcolor="#E57373" fontcolor=white color="#B71C1C"]
    R_BRI      [label="B_RI  resistant intracellular\n← born HERE (macrolide is\nfunctional monotherapy in phagosome)" fillcolor="#C62828" fontcolor=white color="#B71C1C"]
    R_gate     [label="Selection gate\nΦ = k_macro / (k_macro + k_companion)\nper niche" shape=diamond fillcolor="#EF5350" fontcolor=white color="#B71C1C"]
    R_outcome  [label="Macrolide-resistant MAC-PD\nculture conversion ≈ 5–36%\n5-y mortality ≈ 47%" fillcolor="#B71C1C" fontcolor=white]
    R_fitness  [label="Fitness cost of rrl mutation\n(low → little reversion)" fillcolor="#FFCDD2" color="#B71C1C"]
  }

  //=========================================================
  // CLUSTER 5 : Innate immunity / macrophage biology
  //=========================================================
  subgraph cluster_innate {
    label="🛡️ Innate Immunity & the Macrophage Phagosome"
    style=filled fillcolor="#E3F2FD" color="#1565C0" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    I_AM       [label="Alveolar macrophage\npool  M_AM" fillcolor="#BBDEFB" color="#0D47A1"]
    I_Minf     [label="Infected macrophage\nM_inf" fillcolor="#90CAF9" color="#0D47A1"]
    I_recruit  [label="Monocyte recruitment\nCCL2 / CCR2" fillcolor="#BBDEFB" color="#0D47A1"]
    I_phago    [label="Phagosome maturation ARREST\n(Rab5 retained, Rab7 excluded,\nv-ATPase exclusion)" fillcolor="#64B5F6" color="#0D47A1"]
    I_pH       [label="Phagosomal pH ≈ 5.0–5.5\n(vs cytosol 7.2)" shape=diamond fillcolor="#42A5F5" fontcolor=white color="#0D47A1"]
    I_ros      [label="ROS / RNS burst\nNOX2 · iNOS" fillcolor="#BBDEFB" color="#0D47A1"]
    I_auto     [label="Autophagy / LC3-associated\nphagocytosis (LAP)" fillcolor="#BBDEFB" color="#0D47A1"]
    I_vitD     [label="Vitamin D → cathelicidin\n(LL-37) induction" fillcolor="#E3F2FD" color="#0D47A1"]
    I_neut     [label="Neutrophil influx\nNE · MPO · NETs" fillcolor="#B3E5FC" color="#0277BD"]
    I_TLR      [label="TLR2 / TLR9 · NOD2\n· Dectin-1 sensing" fillcolor="#E3F2FD" color="#0D47A1"]
    I_inflam   [label="NLRP3 inflammasome\n→ caspase-1 → IL-1β" fillcolor="#B3E5FC" color="#0277BD"]
  }

  //=========================================================
  // CLUSTER 6 : Adaptive immunity / cytokine network
  //=========================================================
  subgraph cluster_adapt {
    label="🧬 Adaptive Immunity — IL-12/IFN-γ Axis"
    style=filled fillcolor="#E8F5E9" color="#2E7D32" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    C_DC       [label="Dendritic cell\nantigen presentation" fillcolor="#C8E6C9" color="#1B5E20"]
    C_IL12     [label="IL-12p70" fillcolor="#A5D6A7" color="#1B5E20"]
    C_Th1      [label="Th1 / CD4⁺ effector" fillcolor="#A5D6A7" color="#1B5E20"]
    C_IFNg     [label="IFN-γ\n(macrophage activation)" fillcolor="#66BB6A" fontcolor=white color="#1B5E20"]
    C_CD8      [label="CD8⁺ CTL · γδ T · MAIT" fillcolor="#C8E6C9" color="#1B5E20"]
    C_Th17     [label="Th17 / IL-17A\n→ neutrophil chemotaxis" fillcolor="#C8E6C9" color="#1B5E20"]
    C_Treg     [label="Treg / IL-10 · TGF-β\n(immunosuppressive brake)" fillcolor="#DCEDC8" color="#558B2F"]
    C_gran     [label="Granuloma formation\n(poorly organised in MAC-PD)" fillcolor="#A5D6A7" color="#1B5E20"]
    C_TNF      [label="TNF-α\n(granuloma maintenance)" fillcolor="#81C784" color="#1B5E20"]
    C_antiTNF  [label="Anti-TNF biologics\n→ granuloma dissolution\n(iatrogenic NTM risk)" fillcolor="#FFCDD2" color="#C62828"]
  }

  //=========================================================
  // CLUSTER 7 : Tissue destruction — the Cole vicious cycle & cavitation
  //=========================================================
  subgraph cluster_damage {
    label="🫁 Structural Damage — Cole Vicious Cycle & Cavitation"
    style=filled fillcolor="#FCE4EC" color="#AD1457" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    D_NE       [label="Neutrophil elastase\n(free, sputum activity)" fillcolor="#F8BBD0" color="#880E4F"]
    D_MMP1     [label="MMP-1 (collagenase-1)\ntype-I collagen cleavage" fillcolor="#F48FB1" color="#880E4F"]
    D_MMP9     [label="MMP-9 (gelatinase-B)\nbasement-membrane breakdown" fillcolor="#F48FB1" color="#880E4F"]
    D_TIMP     [label="TIMP-1/2\n(protease brake)" fillcolor="#FCE4EC" color="#880E4F"]
    D_airway   [label="Airway wall destruction\nBRONCH (bronchiectasis score)" fillcolor="#F06292" fontcolor=white color="#880E4F"]
    D_cavity   [label="CAVITY volume\n(cm³, thin- vs thick-walled)" fillcolor="#EC407A" fontcolor=white color="#880E4F"]
    D_nodule   [label="Nodular-bronchiectatic burden\ntree-in-bud · centrilobular nodules" fillcolor="#F8BBD0" color="#880E4F"]
    D_fib      [label="Fibrotic scarring · traction\nbronchiectasis · volume loss" fillcolor="#F8BBD0" color="#880E4F"]
    D_cycle    [label="COLE VICIOUS CYCLE\ninfection → inflammation →\ndamage → impaired clearance →\ninfection" shape=diamond fillcolor="#C2185B" fontcolor=white color="#880E4F"]
    D_hemop    [label="Haemoptysis\n(bronchial artery hypertrophy)" fillcolor="#FCE4EC" color="#880E4F"]
    D_asperg   [label="Chronic pulmonary aspergillosis\nin the residual cavity" fillcolor="#FCE4EC" color="#880E4F"]
  }

  //=========================================================
  // CLUSTER 8 : Macrolide PK/PD  (azithromycin / clarithromycin)
  //=========================================================
  subgraph cluster_macro {
    label="💊 Macrolide (Azithromycin / Clarithromycin) — the anchor drug"
    style=filled fillcolor="#E1F5FE" color="#0277BD" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    M_dose     [label="AZM 250–500 mg qd\nor 500 mg TIW\nCLR 500 mg BID" fillcolor="#B3E5FC" color="#01579B"]
    M_gut      [label="Gut depot\nF ≈ 0.37 (AZM) / 0.55 (CLR)" fillcolor="#B3E5FC" color="#01579B"]
    M_plasma   [label="Plasma C_AZM\nCmax ≈ 0.4 mg/L (500 mg)\nt½ ≈ 68 h" fillcolor="#81D4FA" color="#01579B"]
    M_elf      [label="ELF concentration\nELF:plasma ≈ 10–30×" fillcolor="#4FC3F7" color="#01579B"]
    M_mac      [label="INTRACELLULAR (macrophage)\nAUC ratio ≈ 100–1000× plasma\nion-trapping in acidic lysosome" fillcolor="#0288D1" fontcolor=white color="#01579B"]
    M_50S      [label="Target: 23S rRNA\npeptidyl-transferase (50S)\n→ protein-synthesis arrest" fillcolor="#B3E5FC" color="#01579B"]
    M_pH       [label="⚠️ pH PENALTY\nmacrolide is a weak base:\nMIC ↑ 4–16× at pH 5.5\n(active fraction ∝ 1/(1+10^(pKa−pH)))" fillcolor="#FFE0B2" color="#E65100"]
    M_paradox  [label="STRUCTURAL PARADOX\nthe drug that best REACHES the\nphagosome is most INACTIVATED there" shape=diamond fillcolor="#FF7043" fontcolor=white color="#BF360C"]
    M_immuno   [label="Immunomodulation\n↓IL-8 ↓neutrophil influx\n↓mucin secretion" fillcolor="#E1F5FE" color="#01579B"]
    M_cyp      [label="CLR = CYP3A4 inhibitor\nAZM = negligible\n(→ choice matters with RIF)" fillcolor="#E1F5FE" color="#01579B"]
    M_qt       [label="hERG block → QTc↑\n(CLR > AZM)" fillcolor="#FFCDD2" color="#C62828"]
  }

  //=========================================================
  // CLUSTER 9 : Ethambutol
  //=========================================================
  subgraph cluster_emb {
    label="💊 Ethambutol — a permeabiliser, not a killer"
    style=filled fillcolor="#F1F8E9" color="#558B2F" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    E_dose     [label="EMB 15 mg/kg qd\nor 25 mg/kg TIW" fillcolor="#DCEDC8" color="#33691E"]
    E_plasma   [label="Plasma C_EMB\nCmax ≈ 2–5 mg/L, t½ ≈ 10 h\nrenally cleared" fillcolor="#C5E1A5" color="#33691E"]
    E_elf      [label="ELF C_EMB\n(ELF:plasma ≈ 1–4×)" fillcolor="#AED581" color="#33691E"]
    E_embB     [label="Target: EmbA/EmbB\narabinosyltransferase\n→ arabinogalactan synthesis block" fillcolor="#DCEDC8" color="#33691E"]
    E_perm     [label="⇒ CELL-WALL PERMEABILISATION\nmultiplies macrolide & amikacin\nentry (SYNERGY term, not additive)" shape=diamond fillcolor="#8BC34A" fontcolor=white color="#33691E"]
    E_supp     [label="⇒ RESISTANCE SUPPRESSION\ndropping EMB converts the regimen\nto functional macrolide monotherapy" fillcolor="#C5E1A5" color="#33691E"]
    E_optic    [label="Optic neuritis\n(dose × duration dependent,\n≈1%/y at 15 mg/kg)" fillcolor="#FFCDD2" color="#C62828"]
  }

  //=========================================================
  // CLUSTER 10 : Rifamycin + the CYP3A drug–drug interaction loop
  //=========================================================
  subgraph cluster_rif {
    label="💊 Rifampicin / Rifabutin — and the CYP3A interaction that eats the anchor drug"
    style=filled fillcolor="#FFF8E1" color="#F9A825" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    F_dose     [label="RIF 10 mg/kg (max 600 mg) qd\nor RFB 150–300 mg" fillcolor="#FFECB3" color="#F57F17"]
    F_plasma   [label="Plasma C_RIF\nCmax ≈ 8–12 mg/L, t½ ≈ 3 h\n(auto-induction over 1–2 wk)" fillcolor="#FFE082" color="#F57F17"]
    F_elf      [label="ELF C_RIF\n(ELF:plasma ≈ 0.2–0.7)" fillcolor="#FFD54F" color="#F57F17"]
    F_rpoB     [label="Target: RNA polymerase β\n(rpoB) — but MAC rpoB is\nintrinsically low-affinity" fillcolor="#FFECB3" color="#F57F17"]
    F_pxr      [label="PXR / CAR activation\n→ CYP3A4 + P-gp induction\n(t½ of induction ≈ 7 d)" fillcolor="#FFE082" color="#F57F17"]
    F_ddi      [label="⚠️ DDI LOOP\nRIF ↓ CLR AUC by ≈ 70%\nCLR ↑ RFB AUC → uveitis\n(AZM is the escape hatch)" shape=diamond fillcolor="#FFB300" color="#F57F17"]
    F_hepa     [label="Hepatotoxicity\nALT↑ · hyperbilirubinaemia" fillcolor="#FFCDD2" color="#C62828"]
    F_util     [label="Contested clinical utility:\nRIF adds toxicity + DDI,\nEMB carries the synergy" fillcolor="#FFF8E1" color="#F57F17"]
  }

  //=========================================================
  // CLUSTER 11 : Amikacin — IV vs inhaled liposomal (ALIS). The delivery argument.
  //=========================================================
  subgraph cluster_amk {
    label="💉 Amikacin — IV vs Liposomal Inhaled (ALIS): the same molecule, three different fates"
    style=filled fillcolor="#EDE7F6" color="#4527A0" penwidth=3 fontsize=13 fontname="Helvetica-Bold"

    K_iv       [label="IV amikacin 15 mg/kg\n(or 10–15 mg/kg TIW)" fillcolor="#D1C4E9" color="#311B92"]
    K_plasma   [label="Plasma C_AMK\nCmax ≈ 35–45 mg/L\nt½ ≈ 2–3 h, renal" fillcolor="#B39DDB" color="#311B92"]
    K_elf_iv   [label="ELF from systemic route\nELF:plasma ≈ 0.1–0.3\n(polycation, poor partition)" fillcolor="#D1C4E9" color="#311B92"]
    K_nocell   [label="✗ INTRACELLULAR ≈ 0\npolycation cannot cross\nthe plasma membrane" fillcolor="#FFCDD2" color="#C62828"]
    K_alis     [label="ALIS 590 mg qd inhaled\n(liposome, ~0.3 µm, neutral\ncharge DPPC/cholesterol)" fillcolor="#9575CD" fontcolor=white color="#311B92"]
    K_lipo     [label="Lung liposome depot\nsustained release, slow\nmucus/biofilm penetration" fillcolor="#B39DDB" color="#311B92"]
    K_elf_al   [label="ELF C_AMK (ALIS)\n≈ 100–1000× IV-derived ELF" fillcolor="#7E57C2" fontcolor=white color="#311B92"]
    K_uptake   [label="✓ MACROPHAGE UPTAKE of the\nliposome → intraphagosomal amikacin\n(barrier 1 AND barrier 3 crossed)" shape=diamond fillcolor="#5E35B1" fontcolor=white color="#311B92"]
    K_30S      [label="Target: 16S rRNA A-site (30S)\n→ mistranslation, membrane damage" fillcolor="#D1C4E9" color="#311B92"]
    K_pH       [label="⚠️ pH PENALTY (opposite sign\nto macrolide's cause, same effect):\naminoglycoside uptake is PMF-driven\n→ near-inactive below pH 6.0" fillcolor="#FFE0B2" color="#E65100"]
    K_syst     [label="Systemic spill-over from ALIS\n(≈ 1–2% of dose)\n→ low but non-zero plasma AUC" fillcolor="#EDE7F6" color="#311B92"]
    K_oto      [label="Ototoxicity: cochlear hair-cell\nloss ∝ cumulative PERILYMPH AUC\n(tracks PLASMA, not lung)" fillcolor="#FFCDD2" color="#C62828"]
    K_neph     [label="Nephrotoxicity: proximal-tubule\nmegalin uptake ∝ plasma trough" fillcolor="#FFCDD2" color="#C62828"]
    K_local    [label="ALIS-specific local AE\ndysphonia 47% · cough 39%\nbronchospasm 29%" fillcolor="#FFCDD2" color="#C62828"]
    K_decouple [label="⇒ ALIS DECOUPLES efficacy\n(lung AUC) from ototoxicity\n(plasma AUC) — the whole point" shape=diamond fillcolor="#7B1FA2" fontcolor=white color="#4A148C"]
  }

  //=========================================================
  // CLUSTER 12 : Salvage / investigational agents
  //=========================================================
  subgraph cluster_salv {
    label="🧪 Salvage & Investigational Agents"
    style=filled fillcolor="#ECEFF1" color="#455A64" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    S_clof     [label="Clofazimine 100 mg qd\nVd ≈ 1000 L, t½ ≈ 25–70 d\nlipophilic → caseum-seeking" fillcolor="#CFD8DC" color="#263238"]
    S_clof_mx  [label="↑ROS + membrane destabilisation;\nsynergy with amikacin\n(replaces RIF in NTM-NET regimens)" fillcolor="#ECEFF1" color="#263238"]
    S_bdq      [label="Bedaquiline\nATP-synthase (atpE) inhibitor\nlong terminal t½ ≈ 5.5 mo" fillcolor="#CFD8DC" color="#263238"]
    S_lzd      [label="Linezolid / Tedizolid\n(23S, distinct site from macrolide)\nmyelosuppression · neuropathy" fillcolor="#CFD8DC" color="#263238"]
    S_oma      [label="Omadacycline\n(aminomethylcycline, M. abscessus)" fillcolor="#CFD8DC" color="#263238"]
    S_epeti    [label="Epetraborole (LeuRS inhibitor)\ninvestigational MAC-PD" fillcolor="#ECEFF1" color="#263238"]
    S_surg     [label="Adjunctive surgical resection\n(focal cavitary / refractory)" fillcolor="#ECEFF1" color="#263238"]
    S_airway   [label="Airway clearance therapy\nHFCWO · 7% hypertonic saline\n(the non-drug MCC lever)" fillcolor="#B0BEC5" color="#263238"]
    S_nutr     [label="Nutritional repletion\n(reverses the wasting loop)" fillcolor="#B0BEC5" color="#263238"]
  }

  //=========================================================
  // CLUSTER 13 : Clinical endpoints
  //=========================================================
  subgraph cluster_end {
    label="🩺 Clinical Endpoints"
    style=filled fillcolor="#E8EAF6" color="#283593" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    O_conv     [label="Sputum culture conversion\n(3 consecutive negatives)\nPRIMARY ENDPOINT" fillcolor="#9FA8DA" color="#1A237E"]
    O_sscc     [label="Sustained conversion\nthrough 12 mo of therapy\n(ATS/ERS/ESCMID/IDSA 2020)" fillcolor="#9FA8DA" color="#1A237E"]
    O_relapse  [label="Relapse / reinfection\n(≈ 25–48% at 3 y;\ngenotyping distinguishes)" fillcolor="#C5CAE9" color="#1A237E"]
    O_qolb     [label="QOL-B respiratory domain\n(MCID ≈ 10 points)" fillcolor="#C5CAE9" color="#1A237E"]
    O_6mwd     [label="6-minute walk distance" fillcolor="#E8EAF6" color="#1A237E"]
    O_bmi      [label="Body weight / BMI\n(wasting ← TNF-α)" fillcolor="#C5CAE9" color="#1A237E"]
    O_ct       [label="HRCT score\ncavity size · nodule extent" fillcolor="#C5CAE9" color="#1A237E"]
    O_fev1     [label="FEV₁ decline\n(mL/y)" fillcolor="#E8EAF6" color="#1A237E"]
    O_mort     [label="All-cause 5-y mortality\n≈ 25% (cavitary ≫ nodular)" fillcolor="#9FA8DA" color="#1A237E"]
    O_symp     [label="Symptom score\ncough · sputum · fatigue · fever" fillcolor="#E8EAF6" color="#1A237E"]
  }

  //=========================================================
  // CLUSTER 14 : Monitoring / diagnostics / covariates
  //=========================================================
  subgraph cluster_dx {
    label="🔬 Diagnosis & Monitoring"
    style=filled fillcolor="#FAFAFA" color="#616161" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    X_crit     [label="ATS/IDSA 2020 criteria\n2 sputum OR 1 BAL culture\n+ radiology + symptoms" fillcolor="#EEEEEE" color="#424242"]
    X_ast      [label="Antimicrobial susceptibility\nclarithromycin + amikacin ONLY\n(CLSI M24 — others don't predict)" fillcolor="#EEEEEE" color="#424242"]
    X_ddPCR    [label="Molecular load / ddPCR\n· NGS rrl surveillance" fillcolor="#F5F5F5" color="#424242"]
    X_audio    [label="Serial audiometry\n(pure-tone + high-frequency)" fillcolor="#F5F5F5" color="#424242"]
    X_visual   [label="Visual acuity + colour vision\n(EMB monitoring)" fillcolor="#F5F5F5" color="#424242"]
    X_ecg      [label="ECG QTc monitoring" fillcolor="#F5F5F5" color="#424242"]
    X_tdm      [label="Therapeutic drug monitoring\n(low serum levels are common\nand predict failure)" fillcolor="#EEEEEE" color="#424242"]
    X_watch    [label="'Watchful waiting' option\n(non-cavitary, minimal symptoms)" fillcolor="#F5F5F5" color="#424242"]
  }

  //---------------------------------------------------------
  // EDGES — host susceptibility → airway defence
  //---------------------------------------------------------
  H_body -> H_suscep
  H_thorax -> H_suscep
  H_adipo -> H_suscep
  H_estr -> H_adipo
  H_cftr -> A_asl [label="↓ ASL depth" color="#00838F"]
  H_pcd -> A_ciliary [label="↓ CBF" color="#00838F"]
  H_a1at -> D_NE [label="↓ antiprotease shield" color="#AD1457"]
  H_tgfb -> H_thorax
  H_gerd -> E_deposit
  H_ics -> I_AM [label="↓ macrophage function" color="#C62828"]
  H_antiifng -> C_IFNg [label="neutralises" color="#C62828" arrowhead=tee]
  H_ifngr -> C_IFNg [color="#C62828" arrowhead=tee]
  H_suscep -> A_mcc [arrowhead=tee color="#00838F"]
  H_body -> O_bmi

  E_water -> E_aerosol -> E_deposit
  E_deposit -> B_lumen
  A_ciliary -> A_mcc
  A_asl -> A_ciliary
  A_mucus -> A_mcc [arrowhead=tee]
  A_cough -> A_mcc
  A_mcc -> B_lumen [label="clearance k_mcc" arrowhead=tee color="#00838F" penwidth=2]
  A_defens -> B_lumen [arrowhead=tee]
  A_no -> B_lumen [arrowhead=tee]
  B_species -> B_gpl

  //---------------------------------------------------------
  // EDGES — niche interconversion (the structural core)
  //---------------------------------------------------------
  B_lumen -> B_biofilm [label="k_bf (adhesion, EPS)" color="#E65100" penwidth=2]
  B_biofilm -> B_lumen [label="k_disp (dispersal)" color="#E65100"]
  B_lumen -> B_intra [label="phagocytosis k_ph" color="#E65100" penwidth=2]
  B_intra -> B_lumen [label="macrophage lysis / egress" color="#E65100"]
  B_intra -> B_caseum [label="necrosis → caseum" color="#BF360C" penwidth=2]
  B_caseum -> B_lumen [label="cavity shedding\n(→ high sputum CFU)" color="#BF360C" penwidth=2]
  B_gpl -> B_biofilm [label="smooth → biofilm"]
  B_gpl -> B_intra [label="rough → ↑intracellular"]
  B_eps -> B_biofilm
  B_wall -> B_eps
  B_lumen -> B_total
  B_biofilm -> B_total
  B_intra -> B_total
  B_caseum -> B_total
  B_total -> O_conv [arrowhead=tee color="#1A237E" penwidth=2]

  //---------------------------------------------------------
  // EDGES — immune response
  //---------------------------------------------------------
  B_lumen -> I_TLR
  I_TLR -> I_AM
  I_AM -> I_Minf [label="uptake"]
  B_intra -> I_Minf
  I_Minf -> I_phago -> I_pH
  I_pH -> B_intra [label="acid stress (partial)"]
  I_Minf -> I_recruit -> I_AM
  I_Minf -> I_inflam -> C_TNF
  I_ros -> B_intra [arrowhead=tee]
  I_auto -> B_intra [arrowhead=tee]
  I_vitD -> I_auto
  C_IFNg -> I_ros [penwidth=2 color="#2E7D32"]
  C_IFNg -> I_auto [color="#2E7D32"]
  C_IFNg -> I_phago [label="restores maturation" arrowhead=tee color="#2E7D32"]
  I_TLR -> C_DC -> C_IL12 -> C_Th1 -> C_IFNg
  C_Th1 -> C_CD8
  C_Th17 -> I_neut
  C_TNF -> C_gran
  C_gran -> B_caseum [label="containment ⇄ caseation"]
  C_Treg -> C_IFNg [arrowhead=tee]
  C_antiTNF -> C_TNF [arrowhead=tee color="#C62828"]
  C_antiTNF -> C_gran [arrowhead=tee color="#C62828"]
  I_inflam -> I_neut
  I_neut -> D_NE
  I_neut -> D_MMP9

  //---------------------------------------------------------
  // EDGES — tissue damage and the Cole cycle
  //---------------------------------------------------------
  D_NE -> D_airway [penwidth=2 color="#AD1457"]
  D_MMP1 -> D_cavity [penwidth=2 color="#AD1457"]
  D_MMP9 -> D_airway
  D_TIMP -> D_MMP1 [arrowhead=tee]
  D_TIMP -> D_MMP9 [arrowhead=tee]
  C_TNF -> D_MMP1
  I_Minf -> D_MMP1 [label="macrophage-derived"]
  D_airway -> A_mucus [label="goblet-cell hyperplasia"]
  D_airway -> A_ciliary [arrowhead=tee]
  D_airway -> D_cycle
  A_mcc -> D_cycle [arrowhead=tee]
  D_cycle -> B_biofilm [label="stagnant secretions" penwidth=2 color="#C2185B"]
  D_cavity -> B_caseum [label="expands the refractory niche" penwidth=2 color="#C2185B"]
  D_cavity -> D_hemop
  D_cavity -> D_asperg
  D_nodule -> D_airway
  D_airway -> D_fib
  D_fib -> O_fev1
  D_cavity -> O_ct
  D_nodule -> O_ct
  D_cavity -> O_mort [penwidth=2 color="#1A237E"]
  C_TNF -> O_bmi [label="cachexia" arrowhead=tee]
  O_bmi -> H_suscep [label="wasting loop" color="#5E35B1"]

  //---------------------------------------------------------
  // EDGES — macrolide PK/PD
  //---------------------------------------------------------
  M_dose -> M_gut -> M_plasma
  M_plasma -> M_elf -> M_mac
  M_plasma -> M_mac [label="lysosomotropic trapping" penwidth=2 color="#0277BD"]
  M_mac -> M_50S
  M_elf -> M_50S
  I_pH -> M_pH [penwidth=2 color="#E65100"]
  M_pH -> M_50S [label="↓ active fraction" arrowhead=tee penwidth=2 color="#E65100"]
  M_mac -> M_paradox
  M_pH -> M_paradox
  M_paradox -> R_BRI [label="sub-MIC intracellular exposure" penwidth=2 color="#B71C1C"]
  M_50S -> B_lumen [arrowhead=tee penwidth=2 color="#0277BD"]
  M_50S -> B_intra [arrowhead=tee color="#0277BD"]
  M_50S -> B_biofilm [arrowhead=tee style=dashed]
  M_immuno -> I_neut [arrowhead=tee]
  M_immuno -> A_mucus [arrowhead=tee]
  M_plasma -> M_qt -> X_ecg
  M_cyp -> F_ddi

  //---------------------------------------------------------
  // EDGES — ethambutol
  //---------------------------------------------------------
  E_dose -> E_plasma -> E_elf -> E_embB
  E_embB -> B_wall [arrowhead=tee penwidth=2 color="#558B2F"]
  E_embB -> E_perm
  E_perm -> M_50S [label="↑ macrolide entry (synergy)" penwidth=2 color="#558B2F"]
  E_perm -> K_30S [label="↑ amikacin entry (synergy)" penwidth=2 color="#558B2F"]
  E_perm -> E_supp
  E_supp -> R_gate [arrowhead=tee penwidth=2 color="#558B2F"]
  E_plasma -> E_optic -> X_visual
  E_embB -> B_lumen [arrowhead=tee style=dashed]

  //---------------------------------------------------------
  // EDGES — rifamycin and the DDI loop
  //---------------------------------------------------------
  F_dose -> F_plasma -> F_elf -> F_rpoB
  F_rpoB -> B_lumen [arrowhead=tee style=dashed]
  F_plasma -> F_pxr -> F_ddi
  F_ddi -> M_plasma [label="↓ CLR AUC ≈ 70%" arrowhead=tee penwidth=2 color="#F57F17"]
  F_pxr -> F_plasma [label="auto-induction" arrowhead=tee]
  F_plasma -> F_hepa
  F_ddi -> F_util
  F_util -> S_clof [label="substitution strategy" style=dashed]

  //---------------------------------------------------------
  // EDGES — amikacin: the two routes
  //---------------------------------------------------------
  K_iv -> K_plasma
  K_plasma -> K_elf_iv
  K_plasma -> K_nocell [style=dashed color="#C62828"]
  K_plasma -> K_oto [penwidth=2 color="#C62828"]
  K_plasma -> K_neph [penwidth=2 color="#C62828"]
  K_alis -> K_lipo
  K_lipo -> K_elf_al [label="sustained release" penwidth=2 color="#4527A0"]
  K_lipo -> K_uptake [label="phagocytosed intact" penwidth=2 color="#4527A0"]
  K_lipo -> B_biofilm [label="liposome penetrates EPS" penwidth=2 color="#4527A0"]
  K_elf_al -> K_30S
  K_uptake -> K_30S [penwidth=2]
  K_30S -> B_lumen [arrowhead=tee penwidth=2 color="#4527A0"]
  K_30S -> B_intra [arrowhead=tee penwidth=2 color="#4527A0"]
  K_30S -> B_biofilm [arrowhead=tee color="#4527A0"]
  K_elf_iv -> K_30S [style=dashed label="weak"]
  I_pH -> K_pH [penwidth=2 color="#E65100"]
  K_pH -> K_30S [arrowhead=tee penwidth=2 color="#E65100"]
  K_alis -> K_syst -> K_plasma [style=dashed label="≈1–2% of dose"]
  K_alis -> K_local
  K_elf_al -> K_decouple
  K_syst -> K_decouple
  K_decouple -> O_conv [penwidth=2 color="#4A148C"]
  K_oto -> X_audio
  K_neph -> K_plasma [label="↓CL → accumulation" color="#C62828"]

  //---------------------------------------------------------
  // EDGES — resistance
  //---------------------------------------------------------
  R_pre -> R_BRE
  R_pre -> R_BRI
  B_lumen -> R_BRE [label="mutation μ" style=dashed color="#B71C1C"]
  B_intra -> R_BRI [label="mutation μ" style=dashed color="#B71C1C"]
  R_rrl -> R_BRE
  R_rrl -> R_BRI
  R_rrs -> B_intra [label="amikacin escape" style=dashed color="#B71C1C"]
  R_embB -> E_embB [arrowhead=tee]
  R_erm -> B_species
  R_gate -> R_BRE [penwidth=2 color="#B71C1C"]
  R_gate -> R_BRI [penwidth=2 color="#B71C1C"]
  B_efflux -> R_gate
  B_biofilm -> B_efflux
  R_BRE -> B_total
  R_BRI -> B_total
  R_BRE -> R_outcome
  R_BRI -> R_outcome [penwidth=2]
  R_fitness -> R_BRE [arrowhead=tee style=dashed]
  R_outcome -> O_mort [penwidth=2 color="#1A237E"]
  R_outcome -> S_bdq [style=dashed]
  R_outcome -> S_lzd [style=dashed]

  //---------------------------------------------------------
  // EDGES — salvage agents
  //---------------------------------------------------------
  S_clof -> S_clof_mx
  S_clof_mx -> B_caseum [label="lipophilic → reaches caseum" arrowhead=tee penwidth=2 color="#263238"]
  S_clof_mx -> K_30S [label="synergy"]
  S_bdq -> B_intra [arrowhead=tee]
  S_bdq -> B_caseum [arrowhead=tee style=dashed label="ATP-depletion kills non-replicators"]
  S_lzd -> B_lumen [arrowhead=tee]
  S_oma -> B_lumen [arrowhead=tee style=dashed]
  S_epeti -> B_lumen [arrowhead=tee style=dashed]
  S_surg -> D_cavity [arrowhead=tee penwidth=2]
  S_airway -> A_mcc [penwidth=2 color="#00838F"]
  S_airway -> A_mucus [arrowhead=tee]
  S_nutr -> O_bmi
  S_bdq -> M_qt [label="additive QT"]

  //---------------------------------------------------------
  // EDGES — endpoints & monitoring
  //---------------------------------------------------------
  O_conv -> O_sscc -> O_relapse [arrowhead=tee]
  B_caseum -> O_relapse [label="the reservoir that relapses" penwidth=2 color="#BF360C"]
  B_biofilm -> O_relapse [color="#BF360C"]
  O_symp -> O_qolb [arrowhead=tee]
  D_airway -> O_symp
  A_mucus -> O_symp
  C_TNF -> O_symp
  O_qolb -> O_6mwd
  O_bmi -> O_mort [arrowhead=tee]
  O_fev1 -> O_mort [arrowhead=tee]
  X_crit -> M_dose [label="treatment decision" style=dashed]
  X_watch -> X_crit [style=dashed]
  X_ast -> M_dose [style=dashed]
  X_ast -> K_alis [style=dashed]
  X_ddPCR -> B_total [style=dashed]
  X_tdm -> M_plasma [style=dashed]
  X_tdm -> E_plasma [style=dashed]
  X_audio -> K_alis [label="dose hold" arrowhead=tee style=dashed]
  X_visual -> E_dose [label="dose hold" arrowhead=tee style=dashed]
  X_ecg -> M_dose [arrowhead=tee style=dashed]

  //---------------------------------------------------------
  // Legend
  //---------------------------------------------------------
  subgraph cluster_legend {
    label="Legend"
    style=filled fillcolor="#FFFFFF" color="#9E9E9E" fontsize=12 fontname="Helvetica-Bold"
    L1 [label="→  activation / flux" shape=plaintext fillcolor="#FFFFFF"]
    L2 [label="⊣  inhibition / killing" shape=plaintext fillcolor="#FFFFFF"]
    L3 [label="◇  derived quantity / structural result" shape=plaintext fillcolor="#FFFFFF"]
    L4 [label="orange node  =  pH penalty (the two drugs fail\nat acid pH for opposite biophysical reasons)" shape=plaintext fillcolor="#FFF3E0"]
    L5 [label="red node  =  toxicity / adverse outcome" shape=plaintext fillcolor="#FFEBEE"]
    L1 -> L2 [style=invis]
    L2 -> L3 [style=invis]
    L3 -> L4 [style=invis]
    L4 -> L5 [style=invis]
  }
}
