  SURGERY -> SPHEN  [style=dashed, color="#2e7d32", constraint=false];
  PUMPB  -> FACT2 [style=dotted, constraint=false, label="pool removed\nfrom service"];
  DOSET  -> SPHEN [style=dashed, color="#2e7d32", constraint=false];
  ULCD   -> SURV  [style=dotted, constraint=false];
  CAION  -> PRODUCT [style=dotted, constraint=false];
  GNET   -> SURV  [style=dotted, constraint=false];
  NETAZ  -> PRODUCT [style=dashed, color="#2e7d32", constraint=false];
}
