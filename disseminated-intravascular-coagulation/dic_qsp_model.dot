digraph DIC_QSP_Model {
  graph [
    label=<<B>Disseminated Intravascular Coagulation (DIC) — QSP Mechanistic Map</B><BR/><FONT POINT-SIZE="14">One consumption process, two independently-set clocks: (1) the sign of the acute-phase term on each protein's synthesis, and (2) the PAI-1 : tPA molar ratio.<BR/>Thrombotic (sepsis) and haemorrhagic (APL / obstetric) DIC are not two diseases but the same equations read at two settings of those two clocks.</FONT>>
    labelloc=t fontsize=22 fontname="Helvetica"
    rankdir=LR bgcolor="#F7F8FA"
    splines=spline nodesep=0.32 ranksep=1.05
    newrank=true
    compound=true concentrate=false
  ]
  node [fontname="Helvetica" fontsize=10 style="filled,rounded" shape=box margin="0.14,0.05"]
  edge [fontname="Helvetica" fontsize=8 arrowsize=0.65 color="#5A6270"]

  //=========================================================
  // CLUSTER 1 : Triggers — five aetiologies that enter the SAME equation
  //=========================================================
  subgraph cluster_trigger {
    label="⚡ Trigger — five aetiologies, one common input (TF exposure rate)"
    style=filled fillcolor="#FFEBEE" color="#B71C1C" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    T_sepsis   [label="Sepsis / septic shock\nGram−ve LPS · Gram+ve LTA\n(≈35% of severe sepsis develops DIC)" fillcolor="#FFCDD2" color="#B71C1C"]
    T_apl      [label="Acute promyelocytic leukaemia\nPML-RARα blasts\n(90% coagulopathic at diagnosis)" fillcolor="#FFCDD2" color="#B71C1C"]
    T_trauma   [label="Major trauma / burns\nTissue factor from crushed brain,\nplacenta-like TF-rich tissue" fillcolor="#FFCDD2" color="#B71C1C"]
    T_obst     [label="Obstetric catastrophe\nAbruption · Amniotic fluid embolism\nRetained dead fetus · HELLP" fillcolor="#FFCDD2" color="#B71C1C"]
    T_solid    [label="Solid tumour (chronic DIC)\nMucin+ adenocarcinoma\nTrousseau syndrome" fillcolor="#FFCDD2" color="#B71C1C"]
    T_aneur    [label="Giant haemangioma · AAA\nKasabach-Merritt\n(localised consumption)" fillcolor="#FFCDD2" color="#B71C1C"]
    T_pamp     [label="PAMP / DAMP load\nP(t)" shape=diamond fillcolor="#EF9A9A" color="#7F0000"]
    T_tfrate   [label="TF exposure rate\nkTF · P(t)   ← the single\ncommon entry point" shape=diamond fillcolor="#E57373" color="#7F0000" fontcolor="white"]
  }

  //=========================================================
  // CLUSTER 2 : Innate immune amplification
  //=========================================================
  subgraph cluster_innate {
    label="🔥 Innate Immune Amplification (thromboinflammation)"
    style=filled fillcolor="#FFF3E0" color="#E65100" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    I_tlr4     [label="TLR4 / TLR2 · MD-2 · CD14\nMyD88 → NF-κB" fillcolor="#FFE0B2" color="#E65100"]
    I_nlrp3    [label="NLRP3 inflammasome\nCaspase-1 · Caspase-11" fillcolor="#FFE0B2" color="#E65100"]
    I_gsdmd    [label="Gasdermin-D pores\nPyroptosis of monocytes" fillcolor="#FFE0B2" color="#E65100"]
    I_il6      [label="IL-6 (pg/mL)\n★ sets the SIGN of the\nacute-phase term" fillcolor="#FFB74D" color="#BF360C"]
    I_tnf      [label="TNF-α (pg/mL)" fillcolor="#FFE0B2" color="#E65100"]
    I_il1b     [label="IL-1β" fillcolor="#FFE0B2" color="#E65100"]
    I_c5a      [label="Complement C5a / C5b-9\n(cross-talk to TF)" fillcolor="#FFE0B2" color="#E65100"]
    I_monoTF   [label="Monocyte tissue factor\nF3 transcription ↑↑" fillcolor="#FFCC80" color="#BF360C"]
    I_nets     [label="NETs (cf-DNA, µg/mL)\nPAD4 · citH3" fillcolor="#FFCC80" color="#BF360C"]
    I_hist     [label="Circulating histones H3/H4\n10–50 µg/mL in septic shock\n(cytotoxic + platelet-activating)" fillcolor="#FFAB91" color="#BF360C"]
    I_elast    [label="Neutrophil elastase\ncleaves TFPI, AT, PC" fillcolor="#FFCC80" color="#BF360C"]
    I_mv       [label="TF-bearing microvesicles\nPS+ procoagulant surface" fillcolor="#FFCC80" color="#BF360C"]
  }

  //=========================================================
  // CLUSTER 3 : Endothelium & glycocalyx — where the brakes live
  //=========================================================
  subgraph cluster_endo {
    label="🩸 Endothelium & Glycocalyx (the anticoagulant surface is itself a target)"
    style=filled fillcolor="#E8EAF6" color="#283593" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    E_glyx     [label="Glycocalyx integrity  GLX\nheparan sulfate · syndecan-1\n(shed → serum syndecan-1 ↑)" fillcolor="#C5CAE9" color="#1A237E"]
    E_tm       [label="Thrombomodulin  TM\nsurface density (frac. normal)\n↓ 50–80% in sepsis" fillcolor="#9FA8DA" color="#1A237E"]
    E_epcr     [label="EPCR  (endothelial PC receptor)\nshed by ADAM17 → sEPCR" fillcolor="#C5CAE9" color="#1A237E"]
    E_shed     [label="ADAM17 / MMP shedding\nsTM · sEPCR · syndecan-1" fillcolor="#C5CAE9" color="#1A237E"]
    E_wpb      [label="Weibel-Palade body exocytosis\nUL-vWF multimers + P-selectin" fillcolor="#C5CAE9" color="#1A237E"]
    E_adamts   [label="ADAMTS13 activity\n↓ to 40–60% in sepsis\n(→ UL-vWF persists)" fillcolor="#C5CAE9" color="#1A237E"]
    E_apop     [label="Endothelial apoptosis\n→ subendothelial collagen/TF" fillcolor="#C5CAE9" color="#1A237E"]
    E_perm     [label="Capillary leak\n(albumin, AT, PC lost to\ninterstitium)" fillcolor="#C5CAE9" color="#1A237E"]
    E_no       [label="↓ eNOS-derived NO\n↓ prostacyclin" fillcolor="#E8EAF6" color="#1A237E"]
  }

  //=========================================================
  // CLUSTER 4 : Extrinsic / common coagulation cascade
  //=========================================================
  subgraph cluster_casc {
    label="🧬 Extrinsic & Common Pathway — the thrombin generator"
    style=filled fillcolor="#FCE4EC" color="#AD1457" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    C_tf       [label="Tissue factor  TF\n(monocyte + endothelium + MV)" fillcolor="#F8BBD0" color="#880E4F"]
    C_f7a      [label="TF · FVIIa complex\n(extrinsic tenase)" fillcolor="#F8BBD0" color="#880E4F"]
    C_f7       [label="FVII  (t½ ≈ 5 h)\n★ shortest-lived procoagulant" fillcolor="#F48FB1" color="#880E4F"]
    C_f9       [label="FIX → FIXa" fillcolor="#F8BBD0" color="#880E4F"]
    C_f8       [label="FVIII : vWF\n(t½ ≈ 10 h) — acute-phase ↑" fillcolor="#F8BBD0" color="#880E4F"]
    C_tenase   [label="Intrinsic tenase\nFIXa · FVIIIa · PS surface" fillcolor="#F8BBD0" color="#880E4F"]
    C_f10      [label="FX → FXa" fillcolor="#F48FB1" color="#880E4F"]
    C_f5       [label="FV → FVa  (t½ ≈ 15 h)" fillcolor="#F8BBD0" color="#880E4F"]
    C_pro      [label="Prothrombinase\nFXa · FVa · Ca²⁺ · PS surface\n(×300 000 rate gain)" fillcolor="#F06292" color="#880E4F"]
    C_f2       [label="Prothrombin FII\n1.4 µM  (t½ ≈ 65 h)" fillcolor="#F8BBD0" color="#880E4F"]
    C_thr      [label="THROMBIN  (nM)\n★ the single hub variable" shape=doubleoctagon fillcolor="#E91E63" color="#880E4F" fontcolor="white" fontsize=13]
    C_f13      [label="FXIII → FXIIIa\nγ-γ cross-linking\n(makes D-dimer possible)" fillcolor="#F8BBD0" color="#880E4F"]
    C_par      [label="PAR-1 / PAR-4 signalling\n(low thrombin: cytoprotective\nhigh thrombin: inflammatory)" fillcolor="#F8BBD0" color="#880E4F"]
  }

  //=========================================================
  // CLUSTER 5 : Contact / intrinsic amplification
  //=========================================================
  subgraph cluster_contact {
    label="🔗 Contact Activation (NET-DNA and polyP amplification loop)"
    style=filled fillcolor="#F3E5F5" color="#6A1B9A" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    K_f12      [label="FXII → FXIIa\non anionic surfaces" fillcolor="#E1BEE7" color="#4A148C"]
    K_dna      [label="cf-DNA / NET scaffold\n(anionic surface)" fillcolor="#E1BEE7" color="#4A148C"]
    K_polyp    [label="Platelet polyphosphate\n(FXII activator + FV cofactor)" fillcolor="#E1BEE7" color="#4A148C"]
    K_pk       [label="Prekallikrein → Kallikrein\nHMWK → bradykinin" fillcolor="#E1BEE7" color="#4A148C"]
    K_f11      [label="FXI → FXIa\n(also thrombin-activated:\nfeedback loop)" fillcolor="#E1BEE7" color="#4A148C"]
    K_c1inh    [label="C1-inhibitor\n(consumed in sepsis)" fillcolor="#F3E5F5" color="#4A148C"]
  }

  //=========================================================
  // CLUSTER 6 : Natural anticoagulants — the brakes that fail first
  //=========================================================
  subgraph cluster_anticoag {
    label="🛑 Natural Anticoagulant Brakes (three multiplied fractions, not one)"
    style=filled fillcolor="#E0F2F1" color="#00695C" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    N_at       [label="ANTITHROMBIN  AT\n2.4 µM · t½ ≈ 65 h\n★ heparin's obligate cofactor\n→ 40–60% in septic DIC" fillcolor="#80CBC4" color="#004D40"]
    N_atc      [label="AT–IIa / AT–Xa complexes\n(TAT = consumption marker)" fillcolor="#B2DFDB" color="#004D40"]
    N_pc       [label="Protein C zymogen  PC\n65 nM · t½ ≈ 6 h\n(negative acute-phase reactant)" fillcolor="#80CBC4" color="#004D40"]
    N_apc      [label="Activated protein C  APC\ngeneration = kPCA·THR·TM·EPCR·PC\n★ PRODUCT OF FOUR TERMS" shape=octagon fillcolor="#4DB6AC" color="#004D40"]
    N_ps       [label="Protein S (free)\ncofactor; bound by C4BP\n(C4BP ↑ acute phase → free PS ↓)" fillcolor="#B2DFDB" color="#004D40"]
    N_va       [label="FVa / FVIIIa inactivation\nby APC (Arg306/506/679)" fillcolor="#B2DFDB" color="#004D40"]
    N_tfpi     [label="TFPI\ninhibits TF·FVIIa·Xa\n(cleaved by elastase)" fillcolor="#B2DFDB" color="#004D40"]
    N_hcii     [label="Heparin cofactor II\n(dermatan-sulfate dependent)" fillcolor="#E0F2F1" color="#004D40"]
    N_apccyt   [label="APC cytoprotective arm\nPAR-1/EPCR biased signalling\n(anti-apoptotic, barrier-stabilising)" fillcolor="#B2DFDB" color="#004D40"]
  }

  //=========================================================
  // CLUSTER 7 : Platelets
  //=========================================================
  subgraph cluster_plt {
    label="🟣 Platelets (count, activation state, and the PS surface they provide)"
    style=filled fillcolor="#EDE7F6" color="#4527A0" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    P_count    [label="Platelet count  PLT\n150–400 ×10⁹/L · t½ ≈ 8–10 d\n★ ISTH's heaviest-weighted item" fillcolor="#D1C4E9" color="#311B92"]
    P_act      [label="Activation (GPIIb/IIIa,\nP-selectin, PS flip)" fillcolor="#D1C4E9" color="#311B92"]
    P_ps       [label="Procoagulant PS surface\n(the platform prothrombinase\nneeds)" fillcolor="#D1C4E9" color="#311B92"]
    P_consume  [label="Consumption into microthrombi\n+ UL-vWF strings" fillcolor="#D1C4E9" color="#311B92"]
    P_marrow   [label="Megakaryocyte output\n(TPO-driven; suppressed by\nsepsis / chemotherapy)" fillcolor="#D1C4E9" color="#311B92"]
    P_hlh      [label="Haemophagocytosis\n(sepsis-associated HLH overlap)" fillcolor="#EDE7F6" color="#311B92"]
    P_func     [label="Acquired platelet dysfunction\n(FDP coating GPIIb/IIIa)" fillcolor="#EDE7F6" color="#311B92"]
  }

  //=========================================================
  // CLUSTER 8 : Fibrin formation & deposition
  //=========================================================
  subgraph cluster_fibrin {
    label="🕸️ Fibrin — the distinction between the RATE and the STOCK"
    style=filled fillcolor="#FFFDE7" color="#F57F17" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    F_fib      [label="FIBRINOGEN  (mg/dL)\n200–400 · t½ ≈ 100 h\n★ POSITIVE acute-phase reactant" fillcolor="#FFF59D" color="#F57F17"]
    F_apsyn    [label="IL-6 → hepatic fibrinogen\nsynthesis ×2–5\n(the sign-flipping term)" fillcolor="#FFF176" color="#F57F17"]
    F_fpa      [label="Fibrinopeptide A/B release\nby thrombin" fillcolor="#FFF9C4" color="#F57F17"]
    F_mono     [label="Soluble fibrin monomer\n(SFMC — earliest marker)" fillcolor="#FFF9C4" color="#F57F17"]
    F_dep      [label="DEPOSITED microvascular fibrin\nFdep  ← a STOCK, not a rate\n★ no drug acting on the rate\ncan reduce an existing stock" shape=octagon fillcolor="#FFD54F" color="#E65100"]
    F_xlink    [label="FXIIIa cross-linking\n(D-dimer only arises from\nCROSS-LINKED fibrin)" fillcolor="#FFF9C4" color="#F57F17"]
    F_rbc      [label="Microangiopathic haemolysis\nschistocytes · LDH ↑ · Hp ↓" fillcolor="#FFF9C4" color="#F57F17"]
  }

  //=========================================================
  // CLUSTER 9 : Fibrinolysis — clock #2
  //=========================================================
  subgraph cluster_fibrinolysis {
    label="✂️ Fibrinolysis — CLOCK 2: the PAI-1 : tPA molar ratio decides the phenotype"
    style=filled fillcolor="#E1F5FE" color="#01579B" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    L_tpa      [label="t-PA  (ng/mL)\n5 → 20–30 in sepsis\n68 kDa → 20 ng/mL = 0.29 nM" fillcolor="#B3E5FC" color="#01579B"]
    L_upa      [label="u-PA / uPAR\n(blast-derived in APL)" fillcolor="#B3E5FC" color="#01579B"]
    L_pai      [label="PAI-1  (ng/mL)\n5–50 → 200–1000 in sepsis\n45 kDa → 400 ng/mL = 8.9 nM\n★ 30 : 1 molar excess over tPA" fillcolor="#4FC3F7" color="#01579B"]
    L_free     [label="FREE t-PA = max(0, tPA − PAI-1)\n≈ 0 in sepsis → SHUTDOWN\n≫ 0 in APL → HYPERFIBRINOLYSIS" shape=octagon fillcolor="#29B6F6" color="#01579B" fontcolor="white"]
    L_plg      [label="Plasminogen  2 µM\n(consumed in APL)" fillcolor="#B3E5FC" color="#01579B"]
    L_pln      [label="PLASMIN  (nM)" fillcolor="#81D4FA" color="#01579B"]
    L_a2ap     [label="α2-antiplasmin  1 µM\n(PIC = plasmin·α2AP complex)" fillcolor="#B3E5FC" color="#01579B"]
    L_tafi     [label="TAFI → TAFIa\nactivated by THROMBIN·TM\n★ the SAME complex that\nmakes APC" fillcolor="#81D4FA" color="#01579B"]
    L_anx      [label="Annexin A2 · S100A10\non APL blasts → tPA-dependent\nplasmin generation ↑↑" fillcolor="#B3E5FC" color="#01579B"]
    L_dd       [label="D-DIMER  (mg/L FEU)\n< 0.5 normal · > 5 in DIC\n★ requires BOTH cross-linking\nAND plasmin — a product" fillcolor="#4FC3F7" color="#01579B"]
    L_fdp      [label="FDP (X, Y, D, E fragments)\ncoat platelets, impair\npolymerisation" fillcolor="#B3E5FC" color="#01579B"]
    L_fgnlysis [label="Direct fibrinogenolysis\nby free plasmin\n(APL only — bypasses thrombin)" fillcolor="#81D4FA" color="#01579B"]
  }

  //=========================================================
  // CLUSTER 10 : Organ microthrombosis and injury
  //=========================================================
  subgraph cluster_organ {
    label="🫀 Organ Microthrombosis (the stock Fdep, distributed)"
    style=filled fillcolor="#EFEBE9" color="#4E342E" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    O_kid      [label="Kidney — glomerular /\nperitubular microthrombi\n→ AKI, creatinine ↑" fillcolor="#D7CCC8" color="#3E2723"]
    O_liv      [label="Liver — sinusoidal fibrin\n→ ↓ synthesis of AT, PC,\nfibrinogen  ★ FEEDBACK LOOP" fillcolor="#BCAAA4" color="#3E2723"]
    O_lung     [label="Lung — alveolar capillary\nfibrin → ARDS, ↑ dead space" fillcolor="#D7CCC8" color="#3E2723"]
    O_cns      [label="CNS — encephalopathy,\nmicroinfarcts" fillcolor="#D7CCC8" color="#3E2723"]
    O_adr      [label="Adrenal haemorrhagic infarction\n(Waterhouse-Friderichsen)" fillcolor="#D7CCC8" color="#3E2723"]
    O_skin     [label="Purpura fulminans ·\nacral gangrene\n(PC pathway failure)" fillcolor="#D7CCC8" color="#3E2723"]
    O_gi       [label="Gut — mucosal ischaemia,\nbarrier failure → 2nd hit" fillcolor="#D7CCC8" color="#3E2723"]
    O_sofa     [label="SOFA score\n(derived output)" shape=diamond fillcolor="#A1887F" color="#3E2723" fontcolor="white"]
  }

  //=========================================================
  // CLUSTER 11 : Haemostatic failure / bleeding
  //=========================================================
  subgraph cluster_bleed {
    label="🩸 Haemostatic Failure — a PRODUCT of three independent deficits"
    style=filled fillcolor="#FFEBEE" color="#C62828" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    B_plt      [label="Platelet-limited hazard\nh_plt = f(PLT)" fillcolor="#FFCDD2" color="#B71C1C"]
    B_fib      [label="Fibrinogen-limited hazard\nh_fib = f(FIB)\n(the usual rate-limiter in APL)" fillcolor="#FFCDD2" color="#B71C1C"]
    B_pt       [label="Factor-limited hazard\nh_pt = f(PT / INR)" fillcolor="#FFCDD2" color="#B71C1C"]
    B_lysis    [label="Lysis-limited hazard\nh_lys = f(plasmin)\n(clot dissolves as fast as\nit forms)" fillcolor="#FFCDD2" color="#B71C1C"]
    B_index    [label="Bleeding index\nB = 1 − Π(1 − hᵢ)\n★ the WORST term dominates —\nso correct the worst first" shape=octagon fillcolor="#EF5350" color="#B71C1C" fontcolor="white"]
    B_site     [label="Clinical bleeding\nOozing from lines · GI · CNS\n(CNS bleed = APL early death)" fillcolor="#FFCDD2" color="#B71C1C"]
  }

  //=========================================================
  // CLUSTER 12 : Heparins — PK/PD whose EFFECT IS A PRODUCT WITH AT
  //=========================================================
  subgraph cluster_hep {
    label="💉 Heparins — pharmacology whose cofactor is the thing the disease destroys"
    style=filled fillcolor="#E8F5E9" color="#1B5E20" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    D_ufh      [label="UFH infusion\nIV bolus + 18 U/kg/h\nt½ 60–90 min (dose-dependent)" fillcolor="#C8E6C9" color="#1B5E20"]
    D_ufhpk    [label="UFH central compartment\nMichaelis-Menten + linear CL\n(anti-Xa IU/mL)" fillcolor="#C8E6C9" color="#1B5E20"]
    D_lmwh     [label="Enoxaparin SC\n1 mg/kg q12h · t½ 4.5 h\n(renally cleared → accumulates\nin DIC-associated AKI)" fillcolor="#C8E6C9" color="#1B5E20"]
    D_fonda    [label="Fondaparinux\npure anti-Xa · t½ 17 h" fillcolor="#C8E6C9" color="#1B5E20"]
    D_danap    [label="Danaparoid\n(HIT-compatible)" fillcolor="#E8F5E9" color="#1B5E20"]
    D_arg      [label="Argatroban / bivalirudin\nDIRECT thrombin inhibitors —\n★ AT-independent (no product)" fillcolor="#A5D6A7" color="#1B5E20"]
    D_hepEff   [label="Heparin effect\nE = AT_frac × (1 + Emax·C/(EC50+C))\n★ AT_frac multiplies the CEILING,\nnot just the potency" shape=octagon fillcolor="#66BB6A" color="#1B5E20" fontcolor="white"]
    D_pf4      [label="PF4 / histone / fibrinogen binding\n→ non-AT heparin resistance" fillcolor="#E8F5E9" color="#1B5E20"]
    D_hit      [label="HIT (PF4-heparin IgG)\n— a DIC mimic" fillcolor="#E8F5E9" color="#1B5E20"]
  }

  //=========================================================
  // CLUSTER 13 : Protein therapeutics
  //=========================================================
  subgraph cluster_protein {
    label="🧪 Protein Therapeutics (each one enters a DIFFERENT factor of the product)"
    style=filled fillcolor="#E0F7FA" color="#006064" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    R_atc      [label="Antithrombin concentrate\n1 IU/kg raises AT ≈ 1.4%\nKyberSept: 38.9% vs 38.7%\n(no-heparin subgroup benefited)" fillcolor="#B2EBF2" color="#006064"]
    R_rtm      [label="Thrombomodulin alfa (ART-123)\n0.06 mg/kg/d × 6 d\nSCARLET: 26.8% vs 29.4%, p=0.32" fillcolor="#B2EBF2" color="#006064"]
    R_apc      [label="Drotrecogin alfa (rhAPC)\n24 µg/kg/h × 96 h\nPROWESS 24.7 vs 30.8 →\nPROWESS-SHOCK 26.4 vs 24.2 →\nWITHDRAWN 2011" fillcolor="#B2EBF2" color="#006064"]
    R_f7a      [label="rFVIIa (off-label rescue)\nneeds PLT and FIB present\nto work at all" fillcolor="#B2EBF2" color="#006064"]
    R_pcc      [label="4-factor PCC\n(FII, VII, IX, X — no FV,\nno fibrinogen)" fillcolor="#B2EBF2" color="#006064"]
    R_pcconc   [label="Protein C concentrate\n(purpura fulminans,\nmeningococcaemia)" fillcolor="#B2EBF2" color="#006064"]
  }

  //=========================================================
  // CLUSTER 14 : Antifibrinolytics and blood products
  //=========================================================
  subgraph cluster_products {
    label="🧊 Antifibrinolytics & Blood Products (the same drug with opposite sign in the two phenotypes)"
    style=filled fillcolor="#F1F8E9" color="#33691E" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    S_txa      [label="Tranexamic acid\n1 g + 1 g/8 h · blocks plasminogen\nlysine-binding site\n★ SIGN FLIPS between phenotypes" fillcolor="#DCEDC8" color="#33691E"]
    S_eaca     [label="ε-aminocaproic acid" fillcolor="#F1F8E9" color="#33691E"]
    S_cryo     [label="Cryoprecipitate\n10 U ≈ +70–100 mg/dL fibrinogen" fillcolor="#DCEDC8" color="#33691E"]
    S_fibcon   [label="Fibrinogen concentrate\n1 g ≈ +25–30 mg/dL" fillcolor="#DCEDC8" color="#33691E"]
    S_ffp      [label="FFP 15 mL/kg\n≈ +20–25% of all factors\n(volume-limited)" fillcolor="#DCEDC8" color="#33691E"]
    S_plt      [label="Platelet apheresis unit\n≈ +30–50 ×10⁹/L\n(much less if consumption\ncontinues)" fillcolor="#DCEDC8" color="#33691E"]
    S_prbc     [label="pRBC · massive transfusion\n(dilutional coagulopathy,\nhypocalcaemia, hypothermia)" fillcolor="#F1F8E9" color="#33691E"]
  }

  //=========================================================
  // CLUSTER 15 : APL-specific arm
  //=========================================================
  subgraph cluster_apl {
    label="🧫 APL-specific arm (the second clock setting)"
    style=filled fillcolor="#FBE9E7" color="#BF360C" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    A_blast    [label="PML-RARα promyelocyte burden" fillcolor="#FFCCBC" color="#BF360C"]
    A_anx2     [label="Annexin A2 overexpression\n→ tPA-dependent plasmin ↑" fillcolor="#FFCCBC" color="#BF360C"]
    A_upa      [label="Blast u-PA / uPAR release" fillcolor="#FFCCBC" color="#BF360C"]
    A_elast    [label="Blast elastase / cathepsin G\ndegrades fibrinogen directly" fillcolor="#FFCCBC" color="#BF360C"]
    A_noil6    [label="NO IL-6 acute-phase surge\n→ acute-phase term ≈ 0\n★ fibrinogen has no rescue" fillcolor="#FFAB91" color="#BF360C"]
    A_atra     [label="ATRA (45 mg/m²/d)\ndifferentiates blasts →\ncoagulopathy resolves in 2–5 d" fillcolor="#FFCCBC" color="#BF360C"]
    A_ato      [label="Arsenic trioxide\n(APL0406: 2-y EFS 97 vs 86%)" fillcolor="#FFCCBC" color="#BF360C"]
    A_ds       [label="Differentiation syndrome\n(the price of ATRA)" fillcolor="#FBE9E7" color="#BF360C"]
  }

  //=========================================================
  // CLUSTER 16 : Diagnostics and endpoints
  //=========================================================
  subgraph cluster_score {
    label="📊 Diagnostic Scores & Clinical Endpoints (OUTPUTS of the state vector, not inputs)"
    style=filled fillcolor="#ECEFF1" color="#37474F" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    Z_pt       [label="PT / INR\nPT = PT₀ · f_min^(−0.289)\ncalibrated: f = 0.30 → +5 s" fillcolor="#CFD8DC" color="#263238"]
    Z_aptt     [label="aPTT (s)" fillcolor="#CFD8DC" color="#263238"]
    Z_isth     [label="ISTH overt-DIC score\nPLT + D-dimer + PT + fibrinogen\n≥ 5 = overt DIC" shape=diamond fillcolor="#B0BEC5" color="#263238"]
    Z_sic      [label="SIC score (Iba 2017)\nPLT + INR + SOFA — deliberately\nOMITS fibrinogen\n★ and the model shows why" shape=diamond fillcolor="#90A4AE" color="#263238"]
    Z_jaam     [label="JAAM DIC score\n(SIRS-weighted, more sensitive)" fillcolor="#CFD8DC" color="#263238"]
    Z_tat      [label="TAT · PIC · SFMC\n(molecular markers)" fillcolor="#CFD8DC" color="#263238"]
    Z_mort     [label="28-day mortality\n(DIC ≈ doubles sepsis mortality)" shape=diamond fillcolor="#78909C" color="#263238" fontcolor="white"]
    Z_amp      [label="Amputation / limb loss\n(purpura fulminans survivors)" fillcolor="#CFD8DC" color="#263238"]
    Z_tf       [label="Transfusion burden\n(units of product)" fillcolor="#CFD8DC" color="#263238"]
  }

  //=========================================================
  // EDGES — triggers
  //=========================================================
  T_sepsis -> T_pamp
  T_apl    -> T_pamp [style=dashed]
  T_trauma -> T_pamp
  T_obst   -> T_pamp
  T_solid  -> T_pamp [style=dashed]
  T_aneur  -> T_pamp [style=dashed]
  T_pamp   -> T_tfrate [penwidth=2]
  T_pamp   -> I_tlr4 [penwidth=2]
  T_apl    -> A_blast [penwidth=2 color="#BF360C"]
  T_apl    -> A_noil6 [color="#BF360C"]

  // innate cascade
  I_tlr4  -> I_il6 [penwidth=2]
  I_tlr4  -> I_tnf
  I_tlr4  -> I_nlrp3
  I_nlrp3 -> I_il1b
  I_nlrp3 -> I_gsdmd
  I_gsdmd -> I_mv
  I_gsdmd -> I_monoTF
  I_tnf   -> I_monoTF [penwidth=2]
  I_il1b  -> I_monoTF
  I_c5a   -> I_monoTF
  T_pamp  -> I_c5a
  I_tnf   -> I_nets
  I_nets  -> I_hist [penwidth=2]
  I_nets  -> K_dna [penwidth=2]
  I_nets  -> I_elast
  I_hist  -> P_act [penwidth=2 color="#BF360C"]
  I_hist  -> E_apop [color="#BF360C"]
  I_elast -> N_tfpi [arrowhead=tee color="#C62828"]
  I_elast -> N_at   [arrowhead=tee color="#C62828"]
  I_elast -> N_pc   [arrowhead=tee color="#C62828"]
  I_monoTF -> C_tf [penwidth=2]
  I_mv     -> C_tf [penwidth=2]
  T_tfrate -> C_tf [penwidth=2]
  I_il6   -> F_apsyn [penwidth=3 color="#F57F17"]
  I_il6   -> L_pai   [penwidth=3 color="#01579B"]
  I_tnf   -> L_pai   [penwidth=2 color="#01579B"]
  I_il6   -> N_ps    [arrowhead=tee color="#00695C" label="via C4BP ↑"]
  I_il6   -> P_marrow [arrowhead=tee]

  // endothelium
  I_tnf  -> E_shed [penwidth=2]
  I_hist -> E_shed
  I_elast-> E_glyx [arrowhead=tee]
  E_shed -> E_tm   [arrowhead=tee penwidth=2 color="#C62828"]
  E_shed -> E_epcr [arrowhead=tee penwidth=2 color="#C62828"]
  E_shed -> E_glyx [arrowhead=tee]
  E_glyx -> N_at   [label="surface HS is AT's\nphysiological activator"]
  E_glyx -> E_perm [arrowhead=tee]
  E_perm -> N_at [arrowhead=tee style=dashed label="capillary loss"]
  E_perm -> N_pc [arrowhead=tee style=dashed]
  I_tnf  -> E_wpb
  E_wpb  -> C_f8
  E_wpb  -> P_consume [label="UL-vWF strings"]
  E_adamts -> E_wpb [arrowhead=tee label="cleaves UL-vWF"]
  I_hist -> E_adamts [arrowhead=tee]
  E_apop -> C_tf
  E_apop -> E_no [arrowhead=tee]

  // cascade
  C_tf  -> C_f7a [penwidth=2]
  C_f7  -> C_f7a
  C_f7a -> C_f10 [penwidth=2]
  C_f7a -> C_f9
  C_f9  -> C_tenase
  C_f8  -> C_tenase
  C_tenase -> C_f10 [penwidth=2]
  C_f10 -> C_pro [penwidth=2]
  C_f5  -> C_pro [penwidth=2]
  P_ps  -> C_pro [penwidth=2 label="the surface"]
  C_f2  -> C_pro
  C_pro -> C_thr [penwidth=3 color="#880E4F"]
  C_thr -> C_f5  [label="+ feedback" color="#2E7D32"]
  C_thr -> C_f8  [label="+ feedback" color="#2E7D32"]
  C_thr -> K_f11 [label="+ feedback" color="#2E7D32"]
  K_f11 -> C_f9
  C_thr -> C_f13
  C_f13 -> F_xlink [penwidth=2]
  C_thr -> C_par
  C_par -> I_il6 [style=dashed label="thromboinflammation"]
  C_thr -> P_act [penwidth=2]

  // contact loop
  K_dna  -> K_f12 [penwidth=2]
  K_polyp-> K_f12
  P_act  -> K_polyp
  K_f12  -> K_f11 [penwidth=2]
  K_f12  -> K_pk
  K_pk   -> K_f12 [label="reciprocal"]
  K_c1inh-> K_f12 [arrowhead=tee]
  K_c1inh-> K_pk  [arrowhead=tee]

  // anticoagulant brakes
  N_at  -> C_thr [arrowhead=tee penwidth=3 color="#00695C"]
  N_at  -> C_f10 [arrowhead=tee penwidth=2 color="#00695C"]
  N_at  -> N_atc
  C_thr -> N_at [arrowhead=tee style=dashed label="consumed → TAT"]
  C_thr -> N_apc [penwidth=2 label="substrate"]
  E_tm  -> N_apc [penwidth=3 color="#00695C" label="factor 2"]
  E_epcr-> N_apc [penwidth=2 color="#00695C" label="factor 3"]
  N_pc  -> N_apc [penwidth=2 label="factor 4"]
  N_apc -> N_va  [penwidth=2]
  N_ps  -> N_va
  N_va  -> C_f5  [arrowhead=tee penwidth=2 color="#00695C"]
  N_va  -> C_f8  [arrowhead=tee color="#00695C"]
  N_apc -> N_apccyt
  N_apccyt -> E_perm [arrowhead=tee color="#00695C"]
  N_apccyt -> E_apop [arrowhead=tee color="#00695C"]
  N_apc -> L_pai [arrowhead=tee color="#01579B" label="APC also\ninhibits PAI-1"]
  N_tfpi -> C_f7a [arrowhead=tee penwidth=2 color="#00695C"]
  N_hcii -> C_thr [arrowhead=tee style=dashed]
  E_tm  -> C_thr [arrowhead=tee label="TM-bound thrombin cannot\ncleave fibrinogen"]

  // platelets
  P_marrow -> P_count [penwidth=2]
  C_thr    -> P_consume [penwidth=2]
  E_wpb    -> P_act
  P_act    -> P_ps [penwidth=2]
  P_consume-> P_count [arrowhead=tee penwidth=2 color="#C62828"]
  P_hlh    -> P_count [arrowhead=tee]
  I_il6    -> P_hlh [style=dashed]
  L_fdp    -> P_func [penwidth=2]
  P_func   -> B_plt [style=dashed]
  P_count  -> B_plt [penwidth=2]
  F_dep    -> P_consume

  // fibrin
  F_apsyn -> F_fib [penwidth=3 color="#F57F17" label="×2–5 synthesis"]
  C_thr   -> F_fpa [penwidth=2]
  F_fib   -> F_fpa [penwidth=2]
  F_fpa   -> F_mono [penwidth=2]
  F_fpa   -> F_fib [arrowhead=tee penwidth=2 color="#C62828" label="consumption"]
  F_mono  -> F_dep [penwidth=2]
  F_xlink -> F_dep [penwidth=2]
  F_dep   -> F_rbc [penwidth=2]
  F_rbc   -> O_kid [style=dashed]
  F_dep   -> O_kid [penwidth=2]
  F_dep   -> O_liv [penwidth=2]
  F_dep   -> O_lung [penwidth=2]
  F_dep   -> O_cns
  F_dep   -> O_adr
  F_dep   -> O_skin [penwidth=2]
  F_dep   -> O_gi
  F_fib   -> B_fib [penwidth=2]

  // fibrinolysis — clock 2
  E_apop -> L_tpa [penwidth=2 label="WPB release"]
  I_tnf  -> L_tpa
  L_tpa  -> L_free [penwidth=2]
  L_pai  -> L_free [arrowhead=tee penwidth=3 color="#01579B" label="1:1 irreversible;\nmolar excess wins"]
  L_free -> L_pln [penwidth=3]
  L_upa  -> L_pln [penwidth=2]
  L_plg  -> L_pln [penwidth=2]
  L_anx  -> L_free [penwidth=2 color="#BF360C" label="APL: cofactor for\ntPA on blast surface"]
  L_a2ap -> L_pln [arrowhead=tee penwidth=2]
  L_tafi -> L_pln [arrowhead=tee penwidth=2 label="removes C-terminal\nlysines from fibrin"]
  C_thr  -> L_tafi [penwidth=2]
  E_tm   -> L_tafi [penwidth=2 color="#01579B" label="★ the SAME complex\nthat makes APC"]
  L_pln  -> F_dep [arrowhead=tee penwidth=3 color="#01579B" label="the ONLY route\nout of the stock"]
  L_pln  -> L_dd  [penwidth=2]
  F_xlink-> L_dd  [penwidth=2 label="the other half\nof the product"]
  L_pln  -> L_fdp [penwidth=2]
  L_pln  -> L_fgnlysis [penwidth=2]
  L_fgnlysis -> F_fib [arrowhead=tee penwidth=3 color="#01579B" label="APL: bypasses thrombin"]
  L_pln  -> L_plg [arrowhead=tee style=dashed]
  L_pln  -> B_lysis [penwidth=2]

  // APL arm
  A_blast -> A_anx2 [penwidth=2]
  A_blast -> A_upa [penwidth=2]
  A_blast -> A_elast [penwidth=2]
  A_blast -> C_tf [penwidth=2 label="blast TF + cancer\nprocoagulant"]
  A_anx2  -> L_anx [penwidth=2]
  A_upa   -> L_upa [penwidth=2]
  A_elast -> F_fib [arrowhead=tee penwidth=2 color="#BF360C"]
  A_noil6 -> F_apsyn [arrowhead=tee penwidth=3 color="#BF360C"]
  A_atra  -> A_blast [arrowhead=tee penwidth=3 color="#2E7D32"]
  A_ato   -> A_blast [arrowhead=tee penwidth=2 color="#2E7D32"]
  A_atra  -> A_ds [style=dashed]
  A_ds    -> O_lung [style=dashed]

  // organs and the feedback loop
  O_liv -> F_fib [arrowhead=tee penwidth=3 color="#3E2723" label="★ synthesis feedback"]
  O_liv -> N_at  [arrowhead=tee penwidth=2 color="#3E2723"]
  O_liv -> N_pc  [arrowhead=tee penwidth=2 color="#3E2723"]
  O_liv -> C_f2  [arrowhead=tee]
  O_kid -> D_lmwh [style=dashed label="↓ CL → accumulation"]
  O_kid -> O_sofa [penwidth=2]
  O_liv -> O_sofa [penwidth=2]
  O_lung-> O_sofa [penwidth=2]
  O_cns -> O_sofa
  P_count -> O_sofa [penwidth=2]
  O_gi  -> T_pamp [style=dashed color="#C62828" label="second hit"]
  O_sofa-> Z_mort [penwidth=3]
  O_skin-> Z_amp

  // bleeding
  B_plt   -> B_index [penwidth=2]
  B_fib   -> B_index [penwidth=2]
  B_pt    -> B_index [penwidth=2]
  B_lysis -> B_index [penwidth=2]
  B_index -> B_site [penwidth=2]
  B_site  -> Z_mort [penwidth=2]
  B_site  -> Z_tf [penwidth=2]
  Z_pt    -> B_pt [penwidth=2]

  // heparin pharmacology — the product
  D_ufh   -> D_ufhpk [penwidth=2]
  D_ufhpk -> D_hepEff [penwidth=2]
  D_lmwh  -> D_hepEff [penwidth=2]
  D_fonda -> D_hepEff
  D_danap -> D_hepEff
  N_at    -> D_hepEff [penwidth=3 color="#C62828" label="★ multiplies the CEILING"]
  D_pf4   -> D_hepEff [arrowhead=tee label="non-AT resistance"]
  I_hist  -> D_pf4 [style=dashed]
  P_act   -> D_pf4 [style=dashed label="PF4 release"]
  D_hepEff-> C_thr [arrowhead=tee penwidth=3 color="#1B5E20"]
  D_hepEff-> C_f10 [arrowhead=tee penwidth=2 color="#1B5E20"]
  D_hepEff-> B_index [penwidth=2 color="#C62828" label="and the bleeding\nhazard, by the same\nproduct"]
  D_arg   -> C_thr [arrowhead=tee penwidth=3 color="#1B5E20" label="no AT term"]
  D_ufh   -> D_hit [style=dashed]
  D_hit   -> P_count [arrowhead=tee style=dashed]

  // protein therapeutics — each enters a different factor
  R_atc  -> N_at [penwidth=3 color="#006064" label="factor: AT level"]
  R_rtm  -> E_tm [penwidth=3 color="#006064" label="factor: TM"]
  R_rtm  -> L_tafi [penwidth=2 color="#01579B" label="…and TAFI, the\nsame complex"]
  R_apc  -> N_apc [penwidth=3 color="#006064" label="bypasses ALL\nthree factors"]
  R_pcconc -> N_pc [penwidth=2 color="#006064"]
  R_f7a  -> C_f7a [penwidth=2]
  R_f7a  -> B_index [arrowhead=tee style=dashed label="only if PLT and\nFIB are adequate"]
  R_pcc  -> C_f2 [penwidth=2]
  R_pcc  -> C_f10
  R_pcc  -> C_f7

  // products and antifibrinolytics
  S_txa  -> L_pln [arrowhead=tee penwidth=3 color="#33691E" label="★ helps APL,\nharms septic shutdown"]
  S_eaca -> L_pln [arrowhead=tee]
  S_cryo -> F_fib [penwidth=2 color="#33691E"]
  S_fibcon -> F_fib [penwidth=2 color="#33691E"]
  S_ffp  -> C_f5 [penwidth=2 color="#33691E"]
  S_ffp  -> N_at [color="#33691E"]
  S_ffp  -> F_fib [color="#33691E"]
  S_plt  -> P_count [penwidth=2 color="#33691E"]
  S_prbc -> F_fib [arrowhead=tee style=dashed label="dilution"]
  S_txa  -> F_dep [style=dashed color="#C62828" label="raises the STOCK\nin shutdown"]

  // diagnostics as outputs
  C_f2 -> Z_pt [penwidth=2]
  C_f5 -> Z_pt [penwidth=2]
  C_f7 -> Z_pt [penwidth=2]
  C_f10-> Z_pt [penwidth=2]
  F_fib-> Z_pt [penwidth=2]
  C_f8 -> Z_aptt
  N_at -> Z_tat
  C_thr-> Z_tat [penwidth=2]
  L_pln-> Z_tat
  F_mono -> Z_tat
  P_count -> Z_isth [penwidth=2]
  L_dd    -> Z_isth [penwidth=2]
  Z_pt    -> Z_isth [penwidth=2]
  F_fib   -> Z_isth [penwidth=2 label="1 point only\nbelow 100 mg/dL"]
  P_count -> Z_sic [penwidth=2]
  Z_pt    -> Z_sic [penwidth=2]
  O_sofa  -> Z_sic [penwidth=2]
  Z_isth  -> Z_mort [penwidth=2]
  Z_sic   -> Z_mort [penwidth=2]
  T_pamp  -> Z_jaam [style=dashed label="SIRS terms"]
  P_count -> Z_jaam
  L_dd    -> Z_jaam
  Z_tf    -> Z_mort [style=dashed]

  //=========================================================
  // The two clocks — annotation nodes
  //=========================================================
  subgraph cluster_thesis {
    label="🕐 The two clocks that separate the phenotypes"
    style=filled fillcolor="#FFFFFF" color="#000000" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    X_clock1 [shape=note fillcolor="#FFF9C4" color="#F57F17" fontsize=11 label=<<B>CLOCK 1 — the sign of the acute-phase term</B><BR ALIGN="LEFT"/>Fibrinogen synthesis is multiplied by (1 + A·IL6/(K+IL6)).<BR ALIGN="LEFT"/>Antithrombin and protein C synthesis are multiplied by 1/(1 + A'·IL6/(K+IL6)).<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>SEPSIS: A ≈ 3 → the substrate is replenished while the brakes are not.<BR ALIGN="LEFT"/>  ⇒ unopposed thrombin with NORMAL fibrinogen ⇒ microthrombosis, not bleeding.<BR ALIGN="LEFT"/>APL: A ≈ 0 → nothing replenishes fibrinogen while plasmin eats it.<BR ALIGN="LEFT"/>  ⇒ fibrinogen &lt; 100 mg/dL ⇒ bleeding.<BR ALIGN="LEFT"/>>]
    X_clock2 [shape=note fillcolor="#B3E5FC" color="#01579B" fontsize=11 label=<<B>CLOCK 2 — the PAI-1 : tPA molar ratio</B><BR ALIGN="LEFT"/>Free tPA = max(0, [tPA] − [PAI-1]); binding is 1:1 and effectively irreversible.<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>SEPSIS: tPA 0.29 nM vs PAI-1 8.9 nM (30:1) ⇒ free tPA ≈ 0 ⇒ fibrinolytic SHUTDOWN<BR ALIGN="LEFT"/>  ⇒ the deposited stock has no exit ⇒ organ failure.<BR ALIGN="LEFT"/>APL: PAI-1 normal, annexin-A2 cofactor on blasts ⇒ free tPA ≫ 0 ⇒ HYPERFIBRINOLYSIS<BR ALIGN="LEFT"/>  ⇒ fibrinogen destroyed systemically ⇒ CNS haemorrhage.<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/><B>Consequence:</B> tranexamic acid enters ONE equation with ONE sign, and its clinical<BR ALIGN="LEFT"/>benefit changes sign automatically. It is not two rules; it is one term.<BR ALIGN="LEFT"/>>]
    X_product [shape=note fillcolor="#C8E6C9" color="#1B5E20" fontsize=11 label=<<B>WHY THE TRIALS READ THE WAY THEY DO — three products</B><BR ALIGN="LEFT"/>1. Heparin effect = AT_frac × (1 + Emax·C/(EC50+C)). At AT = 40% the CEILING is 40%<BR ALIGN="LEFT"/>   of normal — a dose increase cannot recover it. Heparin resistance is structural.<BR ALIGN="LEFT"/>2. APC generation = k · THR × TM × EPCR × PC. Sepsis multiplies three fractions<BR ALIGN="LEFT"/>   (0.6 × 0.3 × 0.5 ≈ 0.09) — hence the pharmacological logic of giving APC itself.<BR ALIGN="LEFT"/>3. But APC acts on the RATE of deposition; organ failure is driven by the STOCK.<BR ALIGN="LEFT"/>   A rate-acting drug given after the stock exists cannot reverse it — which is<BR ALIGN="LEFT"/>   exactly the PROWESS → PROWESS-SHOCK difference in enrolment timing.<BR ALIGN="LEFT"/>>]
  }
}
