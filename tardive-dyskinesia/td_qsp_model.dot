digraph TD_QSP {
    rankdir=LR;
    compound=true;
    fontname="NanumGothic";
    labelloc="t";
    fontsize=28;
    label="지연성 운동이상증 (Tardive Dyskinesia, TD) — Mechanistic QSP Map\nD2 차단 → 시냅스후 초민감성 → 산화 손상 → 구조적 가소성 잠금(latch) · VMAT2 소포 수송 · 기저핵 직접/간접로 · 약물 PK/PD\n(20 clusters · 200 nodes · 272 edges) — 핵심 구조: 가역적 수용체 상향조절(RUP, τ≈300 d) 과 준-비가역 구조 손상(SDAM, 이중안정) 의 분리 = '가역성 창(reversibility window)'\n두 개의 치료 레버는 같은 시냅스의 반대편에 있다: D2 차단↓(원인약물 감량) vs 도파민 공급↓(VMAT2 억제)";
    node [style=filled, fontname="NanumGothic", fontsize=11, shape=box, margin="0.12,0.08"];
    edge [fontname="NanumGothic", fontsize=9, color="gray35"];
    graph [fontname="NanumGothic"];

    /* ===================================================================
       1. 위험인자 및 취약성
       =================================================================== */
    subgraph cluster_risk {
        label="1. 위험인자 및 숙주 취약성 (Risk Factors & Host Vulnerability)";
        style=filled; color="#f3e5c0"; node [fillcolor="#f7d896"];
        Age          [label="고령 (최강 위험인자)\n55세 이상 연간 발생률 25-30%/년\n(청년 3-5%/년)"];
        Sex_post     [label="여성 · 폐경 후\n에스트로겐 신경보호 소실"];
        Ethnicity    [label="아프리카계 혈통\n(위험 1.5-2배 보고)"];
        DM_risk      [label="당뇨병 · 대사증후군\n(미토콘드리아·산화 스트레스 취약)"];
        Smoking      [label="흡연 · 알코올/물질사용장애"];
        EPS_early    [label="조기 급성 EPS/파킨슨증 발생\n(= 개체 D2 민감성 표지, 예측인자)"];
        Mood_dx      [label="기분장애 진단 (조현병 대비 위험↑)"];
        DRD2_Taq     [label="DRD2 Taq1A (rs1800497) A1 대립유전자"];
        SOD2_gene    [label="MnSOD (SOD2) Ala9Val · CYP1A2·CYP2D6 변이"];
        VMAT2_gene   [label="SLC18A2 (VMAT2) 프로모터 다형성\nHTR2A/HTR2C · GRIN2B 변이"];
        Cog_impair   [label="인지 저하 · 뇌 구조 이상 (기저 취약성)"];
        Prior_TD     [label="과거 TD 병력 (재발/누적 손상)"];
    }

    /* ===================================================================
       2. 원인 약물 노출
       =================================================================== */
    subgraph cluster_exposure {
        label="2. 원인 약물 노출 (Offending Exposure) — 누적·강도·기간";
        style=filled; color="#e7dccd"; node [fillcolor="#dfc9a6"];
        FGA          [label="1세대 항정신병제 (FGA)\n할로페리돌·플루페나진 등\n연간 TD 발생 ~5-6%/년"];
        SGA          [label="2세대 항정신병제 (SGA)\n리스페리돈·팔리페리돈·올란자핀\n연간 ~3-4%/년 (0은 아님)"];
        Metoclo      [label="메토클로프라마이드 · 프로클로르페라진\n(위장관 적응증, 비정신과 노출)"];
        LAI_form     [label="장기지속형 주사제 (LAI)\n방출 반감기 수주 (flip-flop)"];
        CumDose      [label="누적 노출량\n(chlorpromazine 등가 · mg·년)"];
        DurExp       [label="노출 기간 (년)"];
        Anticholin   [label="항콜린제 병용 (벤즈트로핀·트리헥시페니딜)\n= TD 악화 인자"];
        DoseEsc      [label="임상적 용량 증량 (증상 악화 대응)"];
        Intermittent [label="간헐적 투여 · 반복 중단/재시작\n(약물 휴일 → 위험↑)"];
        Polypharm    [label="다제 병용 (항정신병제 2제 이상)"];
    }

    /* ===================================================================
       3. 항정신병제 PK
       =================================================================== */
    subgraph cluster_appk {
        label="3. 항정신병제 PK (Antipsychotic Pharmacokinetics)";
        style=filled; color="#d7e4f2"; node [fillcolor="#a8c6e8"];
        AP_gut       [label="경구 흡수 구획\nKA_AP = 20 /일"];
        AP_lai       [label="LAI 저장 구획\nKA_LAI = 0.16 /일"];
        AP_cen       [label="중심 구획 (혈장)\nV2 = 100 L, CL = 120 L/일"];
        AP_per       [label="말초 구획\nV3 = 80 L, Q = 30 L/일"];
        CYP_AP       [label="CYP2D6 / CYP3A4 대사\n(활성 대사체 포함 활성분획)"];
        BBB_AP       [label="혈액-뇌장벽 통과 · P-gp"];
        CE_AP        [label="효과 부위 (선조체) 농도\nKE0 = 12 /일"];
        Adher        [label="복약 순응도 (ADHER, 동적 상태)\n이상반응 → 순응도↓ → 노출 변동"];
        CLZ_pk       [label="클로자핀 PK\nCL = 900 L/일, V = 500 L"];
        Quet_pk      [label="쿠에티아핀/클로자핀류\n= 낮은 D2 점유 + 빠른 해리"];
    }

    /* ===================================================================
       4. D2 수용체 점유
       =================================================================== */
    subgraph cluster_occ {
        label="4. D2 수용체 점유 (Striatal D2 Occupancy) — 임상 창과 가소성 문턱";
        style=filled; color="#cfe3e0"; node [fillcolor="#96c9bf"];
        OCC          [label="선조체 D2 점유율 OCC\nOCC = C^1.25/(C^1.25 + 12^1.25)"];
        Occ_thr_eff  [label="치료 문턱 ~65%\n(정신증 조절 시작)"];
        Occ_thr_eps  [label="EPS 문턱 ~78-80%\n(급성 파킨슨증·좌불안석)"];
        Occ_thr_plast[label="가소성 문턱 ~70% (모델 OCC50_R)\nHill n=4 → 문턱 위에서만 상향조절 구동"];
        Fast_off     [label="빠른 해리 (koff↑, 클로자핀/쿠에티아핀)\n= 같은 평균 점유에서 가소성 구동↓"];
        D2_partial   [label="D2 부분작용제 (아리피프라졸·브렉스피프라졸)\n내재활성 → 완전 차단 회피"];
        OCC_int      [label="점유-시간 적분 ∫OCC dt\n(누적 노출 대리지표)"];
        Drive_days   [label="가소성 구동-일수 ∫Hill(OCC) dt\n= 모델이 예측하는 진짜 노출 지표"];
    }

    /* ===================================================================
       5. 흑질선조체 도파민 처리
       =================================================================== */
    subgraph cluster_da {
        label="5. 흑질선조체 도파민 처리 (Nigrostriatal DA Handling) — VMAT2 표적 경로";
        style=filled; color="#fbe6cf"; node [fillcolor="#f6c48c"];
        TH_enz       [label="티로신 수산화효소 (TH)\n합성 SYN = 1 + 0.6·OCC"];
        DA_cyt       [label="세포질 도파민 DA_CYT\n(자동산화 → 퀴논, ROS 원천)"];
        VMAT2        [label="VMAT2 (SLC18A2)\n소포 내 적재 KVES = 5 /일"];
        DA_ves       [label="소포 도파민 저장 DA_VES"];
        DA_syn       [label="시냅스 도파민 DA_SYN\n(방출 KREL·발화율 의존)"];
        DAT          [label="DAT 재흡수 (KDAT = 8 /일)"];
        MAO_B        [label="MAO-B / COMT 분해\nKMAO = 3 /일 → H2O2 생성"];
        D2_auto      [label="D2 자가수용체 (전시냅스)\n차단 → 합성·발화 증가"];
        Firing       [label="흑질 도파민 뉴런 발화\nFIRE = 1 + 0.5·OCC − DEPOL"];
        Depol_block  [label="탈분극 차단 (DEPOL)\n만성 노출 후 발화 억제 (τ ≈ 60 d)"];
        DA_turnover  [label="도파민 회전율↑ (HVA/DA 비↑)"];
        Presyn_pool  [label="방출 가능 풀 크기\n(VMAT2 억제 시 감소)"];
    }

    /* ===================================================================
       6. 시냅스후 D2 초민감성
       =================================================================== */
    subgraph cluster_super {
        label="6. 시냅스후 D2 초민감성 (Postsynaptic D2 Supersensitivity) — 가역 상태 RUP";
        style=filled; color="#f7d9e6"; node [fillcolor="#eda6c4"];
        RUP          [label="D2 수용체 상향조절 RUP\nKIN = 0.0035, KOUT = 1/300 d\n= 수개월 시상수의 가역 상태"];
        D2_high      [label="D2High 고친화도 상태 분획↑\n(작용제 친화도 2-3배)"];
        D2_density   [label="D2 수용체 밀도↑ (PET Bmax 20-30%↑)"];
        D3_up        [label="D3 수용체 상향조절 (직접로 우세)"];
        Garrestin    [label="β-arrestin2 / GRK6 신호 편향\ncAMP·PKA 하류 이득↑"];
        Gi_gain      [label="Gi/o 결합 효율↑ → D2 신호 이득↑"];
        Homer_shank  [label="시냅스후 골격 재구성 (Homer1a·Shank)"];
        DeltaFosB    [label="ΔFosB · CREB 유도\n(장기 전사 재프로그래밍)"];
        Recovery_slow[label="탈약 후 회복\nτ = 300 d /(1 + 0.8·SDAM)\n= 손상이 있으면 회복이 더 느리다"];
        D2STIM       [label="유효 D2 자극 지표 D2STIM\n= DA_SYN×(1+2.2·RUP)×(1−0.55·OCC)"];
    }

    /* ===================================================================
       7. 산화 스트레스 · 미토콘드리아
       =================================================================== */
    subgraph cluster_ros {
        label="7. 산화 스트레스 · 미토콘드리아 손상 (Oxidative & Mitochondrial Injury)";
        style=filled; color="#e8dff0"; node [fillcolor="#c3aede"];
        ROS          [label="선조체 산화 스트레스 지수 ROS\nτ = 30 d (빠른 상태)"];
        DA_quinone   [label="도파민 퀴논 · 아미노크롬\n(세포질 DA 자동산화 산물)"];
        H2O2         [label="MAO 유래 H2O2 · 하이드록실 라디칼"];
        Neuromel     [label="뉴로멜라닌 · 철 축적"];
        GSH_dep      [label="글루타티온(GSH) 고갈 · SOD2 활성 저하"];
        Complex1     [label="미토콘드리아 복합체 I 억제\n(항정신병제 직접 효과, FGA > SGA)"];
        ATP_fail     [label="ATP 생산 저하 · 칼슘 완충 실패"];
        Lipid_perox  [label="지질 과산화 (MDA·4-HNE) · 8-OHdG↑"];
        Microglia    [label="미세아교세포 활성 · IL-1β/TNF-α"];
        NFkB_ox      [label="NF-κB / Nrf2 불균형"];
        Excitotox    [label="흥분독성 (피질선조체 글루타메이트 · NMDA)"];
        FGA_extra    [label="FGA 추가 산화 부담 (RISK_FGA = 1.6)"];
    }

    /* ===================================================================
       8. 구조적 손상 · 가소성 잠금 (모델의 핵심)
       =================================================================== */
    subgraph cluster_latch {
        label="8. 구조적 손상 · 가소성 잠금 (Structural Damage Latch, SDAM) — 이중안정 상태";
        style=filled; color="#f6cccc"; node [fillcolor="#ef9a9a"];
        SDAM         [label="구조적 손상 SDAM (0-1)\nKIN = 0.0025, KOUT = 0.0003 (τ ≈ 9 년)\n이중안정: 0 · 문턱 0.50-0.55 · 상위 0.85-0.90"];
        SDAM_fb      [label="양성 피드백 (잠금 기구)\nSDAM → 미토콘드리아 ROS\nW = 2.2 · Hill(SDAM; 0.5, n=4)"];
        Chol_loss    [label="선조체 콜린성 개재뉴런 소실\n(사후 뇌 연구)"];
        PV_loss      [label="파브알부민 FSI 소실 · GAD67 mRNA↓"];
        Spine_loss   [label="MSN 수상돌기 가시 소실\n· 시냅스 재구성"];
        GABA_def     [label="선조체 GABA 전달 결핍\n(간접로 출력 약화)"];
        Gliosis      [label="반응성 성상교세포증"];
        Irrev        [label="비가역성 (지속성 TD)\n원인약물 중단에도 잔존"];
        Latch_thr    [label="잠금 문턱 SDAM* ≈ 0.50-0.55\n(무약물 nullcline 해석)"];
        No_return    [label="되돌릴 수 없는 지점 t*\n중단 시점 285 d 성공 / 290 d 실패\n(SDAM 0.34에서 이미 결정)"];
    }

    /* ===================================================================
       9. 선조체 미세회로
       =================================================================== */
    subgraph cluster_striatum {
        label="9. 선조체 미세회로 (Striatal Microcircuit) — 직접로/간접로 균형";
        style=filled; color="#dff0d8"; node [fillcolor="#a9d6a0"];
        MSN_D2       [label="간접로 MSN (D2 발현, 선조담창구)\nIND = 1/(1 + 0.8·EXC)"];
        MSN_D1       [label="직접로 MSN (D1 발현, 선조흑질)"];
        Chol_inter   [label="콜린성 개재뉴런 (TAN)\nM1/M4 무스카린 신호"];
        FSI          [label="파브알부민 FSI (전방 억제)"];
        A2A          [label="아데노신 A2A 수용체 (간접로 MSN)\nD2와 상반 작용"];
        Glu_cortico  [label="피질선조체 글루타메이트 입력\nAMPA/NMDA"];
        Ach_DA_bal   [label="아세틸콜린-도파민 균형\n항콜린제 → 균형 이동 → TD 악화"];
        Enkephalin   [label="엔케팔린 (간접로) · 다이노르핀 (직접로) 발현 변화"];
        EXC_node     [label="유효 과잉자극 EXC\n= (D2STIM − 1) + 1.2·SDAM\n(구조 손상은 점유와 무관한 하한을 만든다)"];
        DA_mismatch  [label="도파민-수용체 부정합\n(공급↓ + 민감도↑ 동시 발생)"];
    }

    /* ===================================================================
       10. 기저핵-시상-피질 루프
       =================================================================== */
    subgraph cluster_bg {
        label="10. 기저핵-시상-피질 루프 (Basal Ganglia-Thalamo-Cortical Loop)";
        style=filled; color="#d5e8f7"; node [fillcolor="#8fbcdd"];
        GPe          [label="외측 창백핵 GPe\nGPe = 2 − IND"];
        STN          [label="시상하핵 STN\nSTN = 1/(0.5 + 0.5·GPe)"];
        GPi          [label="내측 창백핵 / SNr (출력핵)\nGPi = 0.55·STN + 0.45/(1+0.5·EXC)"];
        Thal         [label="시상 VA/VL\nTHAL = 1/(0.2 + 0.8·GPi)"];
        Motor_ctx    [label="운동 피질 · SMA 과활성"];
        Hyperkin     [label="과운동성 출력 (탈억제)\nTHAL > 1 = 불수의 운동 발생"];
        Cereb_loop   [label="소뇌-시상 루프 보상"];
        Sensor_gate  [label="감각운동 관문 결손 (PPI↓)"];
        Cortico_plast[label="피질 가소성 재구성 (장기)"];
        BG_time      [label="루프 시상수 KBG = 0.5 /일\n(신경생리 적응은 일 단위)"];
    }

    /* ===================================================================
       11. 임상 표현형
       =================================================================== */
    subgraph cluster_pheno {
        label="11. 임상 표현형 (Clinical Phenotypes of Tardive Syndromes)";
        style=filled; color="#fdf0d5"; node [fillcolor="#f5d98b"];
        Orofacial    [label="구강-안면 운동증 (가장 흔함)\n혀 내밀기·씹기·입술 오물거림"];
        Buccoling    [label="구강-혀-씹기 3징후 (BLM syndrome)"];
        Limb_trunc   [label="사지-체간 무도성 운동증\n손가락 꼬기·발가락 굽힘·체간 흔들림"];
        Tard_dyst    [label="지연성 근긴장이상 (후굴·사경)\n젊은 남성에 상대적으로 흔함"];
        Tard_akath   [label="지연성 좌불안석"];
        Tard_trem    [label="지연성 떨림 · 미오클로누스"];
        Resp_dysk    [label="호흡성 운동이상 (불규칙 호흡·발성)"];
        Withdraw_emg [label="금단 유발성 운동이상\n(중단/감량 직후 발현, 모델 피크 +30 d)"];
        Covert_TD    [label="가면화된 TD (masked TD)\n지속 차단이 증상을 덮고 있는 상태"];
        Tard_pain    [label="지연성 통증·감각 증상"];
        Ocular       [label="안구 운동증 · 눈꺼풀 연축"];
        Severity_var [label="증상 변동성 (스트레스·수면·주의)"];
    }

    /* ===================================================================
       12. 임상 척도 및 진단
       =================================================================== */
    subgraph cluster_scale {
        label="12. 평가 척도 및 진단 기준 (Rating Scales & Diagnosis)";
        style=filled; color="#e2e2e2"; node [fillcolor="#c0c0c0"];
        AIMS         [label="AIMS 총점 (항목 1-7 운동증 0-28)\n모델 출력: 최대 26, 측정 지연 τ = 7 d"];
        AIMS_items   [label="AIMS 항목별 (안면·입술·턱·혀·상지·하지·체간)"];
