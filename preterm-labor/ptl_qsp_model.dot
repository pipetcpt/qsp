/* ===========================================================================
   Preterm Labor / Spontaneous Preterm Birth (sPTB) — QSP Mechanistic Map
   ---------------------------------------------------------------------------
   Organising idea:  Parturition is not a switch that is thrown but the
   COMMON TERMINAL PATHWAY of uterine activation, and preterm birth is that
   pathway entered EARLY by any of several upstream causes.  The map is drawn
   so that four independent "ignition" arms — (1) the placental CRH clock,
   (2) functional progesterone withdrawal, (3) intra-amniotic infection /
   sterile inflammation, and (4) decidual haemorrhage & uterine overdistension
   — all converge on ONE set of three effector organs:
        MYOMETRIUM (activation -> contraction),
        CERVIX     (softening -> ripening -> dilation),
        MEMBRANES  (weakening -> rupture).
   Every tocolytic in clinical use acts on the LAST of those three, which is
   the structural reason tocolysis buys 48 hours and not weeks: it silences
   the contraction limb while the cervical and membrane limbs keep running.
   The drugs that change outcome (antenatal corticosteroids, MgSO4) do not
   treat the uterus at all — they treat the FETUS.

   Render:
     dot -Tsvg ptl_qsp_model.dot -o ptl_qsp_model.svg
     dot -Tpng -Gdpi=150 ptl_qsp_model.dot -o ptl_qsp_model.png
   =========================================================================== */

digraph PretermLabor_QSP {
  graph [ rankdir      = LR,
          splines      = spline,
          nodesep      = 0.26,
          ranksep      = 0.70,
          fontname     = "Helvetica",
          fontsize     = 11,
          compound     = true,
          newrank      = true,
          bgcolor      = "white",
          label        = "Preterm Labor / Spontaneous Preterm Birth — Integrated QSP Mechanistic Map\l22 clusters · 264 nodes · 408 edges · four ignition arms converging on one common terminal pathway (myometrium · cervix · membranes)\lQSP Disease Model Library — research/education only\l",
          labelloc     = "t",
          fontcolor    = "#1a1a2e" ];

  node [ shape = box, style = "rounded,filled", fontname = "Helvetica",
         fontsize = 9, penwidth = 0.8, margin = "0.07,0.04" ];
  edge [ fontname = "Helvetica", fontsize = 7.5, penwidth = 0.9,
         arrowsize = 0.6, color = "#4a4a5a" ];

  /* ======================= 1. RISK ARCHITECTURE ========================= */
  subgraph cluster_risk {
    label = "1. Risk architecture & aetiologic heterogeneity";
    style = "filled,rounded"; color = "#cfd8dc"; fillcolor = "#eceff1"; fontsize = 12;
    node [fillcolor = "#cfd8dc", color = "#78909c"];

    R_PRIOR   [label = "Prior spontaneous PTB\n(strongest predictor, RR 2.5–6)"];
    R_CL      [label = "Short mid-trimester cervix\n(CL < 25 mm at 18–24 wk)"];
    R_MULTI   [label = "Multifetal gestation\n(twins 60% deliver < 37 wk)"];
    R_ANOM    [label = "Müllerian anomaly /\nprior cervical excision (LEEP, cone)"];
    R_IPI     [label = "Short interpregnancy\ninterval (< 6 mo)"];
    R_BMI     [label = "Low pre-pregnancy BMI\n· poor nutrition"];
    R_SMOKE   [label = "Smoking · substance use"];
    R_PERIO   [label = "Periodontal disease ·\nremote infection"];
    R_SDOH    [label = "Social determinants ·\nracial disparity · chronic stress"];
    R_ART     [label = "ART conception ·\nnulliparity extremes of age"];
    R_GEN     [label = "GWAS loci: EBF1 · EEFSEC ·\nAGTR2 · WNT4 · ADCY5 · RAP2C"];
    R_PROG    [label = "PGR / OXTR / IL6 / TNF\npromoter polymorphism"];
    R_PHENO   [label = "Aetiologic phenotype assignment\n(infection · vascular · stretch · cervical · idiopathic)",
               fillcolor = "#b0bec5", penwidth = 1.6];
  }

  /* ==================== 2. PLACENTAL CRH CLOCK ========================== */
  subgraph cluster_crh {
    label = "2. Placental CRH clock (endocrine timer of parturition)";
    style = "filled,rounded"; color = "#ce93d8"; fillcolor = "#f3e5f5"; fontsize = 12;
    node [fillcolor = "#e1bee7", color = "#8e24aa"];

    C_TROPH   [label = "Syncytiotrophoblast"];
    C_CRH     [label = "Placental CRH\nexponential rise, doubling t ≈ 3.3 wk",
               fillcolor = "#ce93d8", penwidth = 1.6];
    C_CRHBP   [label = "CRH-binding protein\n(falls in last 3 wk → free CRH ↑↑)"];
    C_FREE    [label = "Free bioactive CRH"];
    C_CRHR1   [label = "CRHR1 (myometrium, fetal adrenal)"];
    C_CRHR2   [label = "CRHR2 (quiescence-associated)"];
    C_ACTHF   [label = "Fetal pituitary ACTH"];
    C_ZONE    [label = "Fetal adrenal fetal zone\n(DHEA-S factory)"];
    C_DHEAS   [label = "Fetal DHEA-S"];
    C_16OH    [label = "16α-OH-DHEA-S (fetal liver)"];
    C_AROM    [label = "Placental aromatase / sulfatase"];
    C_E3      [label = "Estriol (E3) surge\n(3-week pre-labour rise)"];
    C_CORTF   [label = "Fetal cortisol"];
    C_FEEDF   [label = "Cortisol → CRH POSITIVE feedback\n(placenta, unlike hypothalamus)",
               fillcolor = "#ba68c8", fontcolor = "white"];
    C_STRESS  [label = "Maternal / fetal stress ·\nhypoxia · ischaemia"];
    C_SETPT   [label = "Clock set-point advanced\n→ early terminal cascade"];
  }

  /* ============== 3. PROGESTERONE & FUNCTIONAL WITHDRAWAL =============== */
  subgraph cluster_p4 {
    label = "3. Progesterone quiescence & FUNCTIONAL withdrawal";
    style = "filled,rounded"; color = "#a5d6a7"; fillcolor = "#e8f5e9"; fontsize = 12;
    node [fillcolor = "#c8e6c9", color = "#388e3c"];

    P_SYN     [label = "Placental P4 synthesis\n(no systemic fall in humans)"];
    P_PLASMA  [label = "Maternal plasma progesterone"];
    P_PRB     [label = "PR-B (transcriptionally ACTIVE)\n→ quiescence programme"];
    P_PRA     [label = "PR-A (dominant-negative repressor)"];
    P_RATIO   [label = "PR-A / PR-B ratio ↑\n= FUNCTIONAL P4 WITHDRAWAL",
               fillcolor = "#81c784", penwidth = 1.8];
    P_PRC     [label = "PR-C truncated isoform"];
    P_20HSD   [label = "Myometrial 20α-HSD\n(local P4 catabolism)"];
    P_MIR     [label = "miR-200 family ↑ / miR-199a-214 ↓"];
    P_ZEB     [label = "ZEB1 / ZEB2 repressors ↓\n(release CAP genes)"];
    P_STAT5   [label = "STAT5B–PR co-activation loss"];
    P_PGRMC   [label = "Membrane PGRMC1/2 ·\nmPRα non-genomic quiescence"];
    P_NFKBX   [label = "PR ⟷ NF-κB mutual\ntrans-repression (broken by inflammation)",
               fillcolor = "#a5d6a7"];
    P_QUIES   [label = "Myometrial quiescence programme\n(PGDH ↑, CAPs ↓, cAMP tone ↑)"];
  }

  /* ================== 4. OESTROGEN ACTIVATION ARM ======================= */
  subgraph cluster_e2 {
    label = "4. Oestrogen activation arm";
    style = "filled,rounded"; color = "#f48fb1"; fillcolor = "#fce4ec"; fontsize = 12;
    node [fillcolor = "#f8bbd0", color = "#c2185b"];

    E_E2      [label = "Estradiol (E2)"];
    E_E1      [label = "Estrone (E1)"];
    E_ERA     [label = "Myometrial ERα ↑\n(de-repressed by PR-A dominance)"];
    E_GPER    [label = "GPER / GPR30"];
    E_CAPGENE [label = "CAP gene transcription\n(OXTR · GJA1 · PTGS2 · CACNA1C)",
               fillcolor = "#f06292", fontcolor = "white", penwidth = 1.6];
    E_E2P4    [label = "Effective E2 : P4 activity ratio"];
  }

  /* ============= 5. INTRA-AMNIOTIC INFECTION / INFLAMMATION ============= */
  subgraph cluster_infect {
    label = "5. Microbial invasion of the amniotic cavity (MIAC) & intra-amniotic inflammation";
    style = "filled,rounded"; color = "#ef9a9a"; fillcolor = "#ffebee"; fontsize = 12;
    node [fillcolor = "#ffcdd2", color = "#c62828"];

    I_LACTO   [label = "Vaginal Lactobacillus\ndominance (CST I/II/III/V)"];
    I_BV      [label = "Dysbiosis / bacterial vaginosis\n(CST IV, Gardnerella, Atopobium)"];
    I_ASCEND  [label = "Ascending colonisation\n(choriodecidual → amnion)"];
    I_UREA    [label = "Ureaplasma parvum / urealyticum ·\nMycoplasma hominis (most common)"];
    I_FUSO    [label = "Fusobacterium nucleatum\n(haematogenous, oral origin)"];
    I_GBS     [label = "Group B Streptococcus · E. coli"];
    I_MIAC    [label = "MIAC — amniotic fluid culture /\nPCR positive", fillcolor = "#e57373", fontcolor = "white"];
    I_TLR     [label = "TLR2 / TLR4 on amnion,\nchorion, decidua"];
    I_LPS     [label = "LPS · lipoteichoic acid · PAMPs"];
    I_DAMP    [label = "DAMPs: HMGB1 · S100B ·\ncell-free fetal DNA · uric acid"];
    I_STERILE [label = "STERILE intra-amniotic inflammation\n(≈ 2× more common than MIAC)",
               fillcolor = "#e57373", fontcolor = "white"];
    I_NLRP3   [label = "NLRP3 inflammasome → caspase-1"];
    I_NFKB    [label = "NF-κB (p65) nuclear translocation",
               fillcolor = "#d32f2f", fontcolor = "white", penwidth = 1.8];
    I_IL1     [label = "IL-1β"];
    I_IL6     [label = "IL-6 (amniotic fluid > 2.6 ng/mL\n= intra-amniotic inflammation)"];
    I_IL8     [label = "IL-8 / CXCL8 → neutrophil chemotaxis"];
    I_TNF     [label = "TNF-α"];
    I_MIF     [label = "MIF · MCP-1 / CCL2"];
    I_NEUT    [label = "Neutrophil influx\n(maternal AND fetal origin)"];
    I_CHORIO  [label = "Histologic chorioamnionitis ·\nfunisitis"];
    I_FIRS    [label = "FIRS — fetal inflammatory response syndrome\n(cord IL-6 > 11 pg/mL)",
               fillcolor = "#e57373", fontcolor = "white"];
    I_MICROB  [label = "Fetal microglial activation"];
  }

  /* ============ 6. DECIDUAL ACTIVATION, SENESCENCE, HAEMORRHAGE ========= */
  subgraph cluster_decidua {
    label = "6. Decidual activation · senescence · haemorrhage (thrombin arm)";
    style = "filled,rounded"; color = "#ffcc80"; fillcolor = "#fff3e0"; fontsize = 12;
    node [fillcolor = "#ffe0b2", color = "#ef6c00"];

    D_SENESC  [label = "Decidual / amnion cellular senescence\n(telomere shortening, oxidative stress)"];
    D_P38     [label = "p38 MAPK stress kinase"];
    D_SASP    [label = "SASP secretome\n(IL-6, IL-8, GM-CSF, MMPs)"];
    D_EXO     [label = "Senescence-derived exosomes\n(fetal → maternal signalling)"];
    D_ABRUPT  [label = "Decidual haemorrhage / abruption ·\nvascular malperfusion"];
    D_TF      [label = "Tissue factor exposure"];
    D_THROMB  [label = "Thrombin generation"];
    D_PAR1    [label = "PAR-1 / PAR-3 on myometrium\n& membranes"];
    D_TAT     [label = "Thrombin–antithrombin complex\n(maternal plasma biomarker)"];
    D_UPI     [label = "Uteroplacental ischaemia ·\nangiogenic imbalance (sFlt-1/PlGF)"];
  }

  /* =============== 7. UTERINE OVERDISTENSION (STRETCH) ================== */
  subgraph cluster_stretch {
    label = "7. Uterine overdistension / mechanotransduction";
    style = "filled,rounded"; color = "#b39ddb"; fillcolor = "#ede7f6"; fontsize = 12;
    node [fillcolor = "#d1c4e9", color = "#5e35b1"];

    S_MULTI   [label = "Multifetal gestation ·\npolyhydramnios · macrosomia"];
    S_WALL    [label = "Myometrial wall tension\n(Laplace: T = P·r / 2h)"];
    S_PIEZO   [label = "Piezo1 · TRPV4 stretch-activated channels"];
    S_INTEG   [label = "Integrin–FAK–Src mechanosome"];
    S_AP1     [label = "AP-1 (c-Fos / c-Jun) ↑"];
    S_STRCAP  [label = "Stretch-induced CAP expression\n(GJA1, PTGS2, OXTR, IL-8)"];
    S_MEMBST  [label = "Membrane tensile stress\n(supracervical weak zone)"];
  }

  /* ============= 8. PROSTAGLANDIN BIOSYNTHESIS & DISPOSAL =============== */
  subgraph cluster_pg {
    label = "8. Prostaglandin biosynthesis & the PGDH disposal barrier";
    style = "filled,rounded"; color = "#80deea"; fillcolor = "#e0f7fa"; fontsize = 12;
    node [fillcolor = "#b2ebf2", color = "#00838f"];

    G_PLA2    [label = "cPLA2-α / sPLA2 activation"];
    G_AA      [label = "Arachidonic acid liberation"];
    G_COX1    [label = "COX-1 / PTGS1 (constitutive)"];
    G_COX2    [label = "COX-2 / PTGS2 (inducible, NF-κB-driven)",
               fillcolor = "#4dd0e1", penwidth = 1.6];
    G_PGH2    [label = "PGH2"];
    G_PGES    [label = "mPGES-1 → PGE2"];
    G_PGFS    [label = "AKR1C3 → PGF2α"];
    G_PGE2    [label = "PGE2 (cervical ripening dominant)"];
    G_PGF2    [label = "PGF2α (myometrial contraction dominant)"];
    G_PGI2    [label = "PGI2 (relaxant, IP receptor)"];
    G_EP1     [label = "EP1 / EP3 (contractile, Gq / Gi)"];
    G_EP2     [label = "EP2 / EP4 (relaxant, Gs → cAMP)"];
    G_FP      [label = "FP receptor (Gq) on myometrium"];
    G_PGDH    [label = "Chorionic 15-PGDH barrier\n(inactivates PG crossing to myometrium)"];
    G_PGDHD   [label = "PGDH ↓ (infection, P4 withdrawal)\n→ barrier BREACHED",
               fillcolor = "#4dd0e1", penwidth = 1.6];
    G_AFPG    [label = "Amniotic fluid PGE2 / PGFM ↑"];
  }

  /* ================= 9. MYOMETRIAL ACTIVATION (CAPs) ==================== */
  subgraph cluster_activation {
    label = "9. Myometrial ACTIVATION — contraction-associated protein programme";
    style = "filled,rounded"; color = "#ffab91"; fillcolor = "#fbe9e7"; fontsize = 12;
    node [fillcolor = "#ffccbc", color = "#d84315"];

    M_PHASE0  [label = "Phase 0 QUIESCENCE\n(P4, PGI2, relaxin, NO, CRH-R2)"];
    M_PHASE1  [label = "Phase 1 ACTIVATION\n(CAP induction — reversible)",
               fillcolor = "#ff8a65", penwidth = 1.6];
    M_PHASE2  [label = "Phase 2 STIMULATION\n(uterotonin-driven — clinical labour)",
               fillcolor = "#ff7043", fontcolor = "white", penwidth = 1.6];
    M_PHASE3  [label = "Phase 3 INVOLUTION"];
    M_OXTR    [label = "OXTR density ↑ 100–200×\n(late-gestation upregulation)"];
    M_CX43    [label = "Connexin-43 (GJA1) gap junctions →\nelectrical syncytium"];
    M_CAV     [label = "CACNA1C (Cav1.2) L-type Ca²⁺ channel ↑"];
    M_KCNMB   [label = "BK-Ca β1 subunit ↓ (loss of brake)"];
    M_HCN     [label = "HCN / T-type pacemaker currents"];
    M_ICC     [label = "Interstitial Cajal-like pacemaker cells"];
    M_HYPERT  [label = "Myocyte hypertrophy ·\nSR Ca²⁺ store loading"];
  }

  /* ============ 10. EXCITATION–CONTRACTION COUPLING ===================== */
  subgraph cluster_ecc {
    label = "10. Myometrial excitation–contraction coupling";
    style = "filled,rounded"; color = "#ffe082"; fillcolor = "#fffde7"; fontsize = 12;
    node [fillcolor = "#fff59d", color = "#f9a825"];

    X_VM      [label = "Resting membrane potential\n(−55 → −45 mV depolarisation)"];
    X_CAIN    [label = "Ca²⁺ influx via Cav1.2"];
    X_SR      [label = "SR release: IP3R / RyR"];
    X_SOCE    [label = "STIM1 / Orai1 store-operated entry"];
    X_CAI     [label = "[Ca²⁺]ᵢ transient", fillcolor = "#ffd54f", penwidth = 1.6];
    X_CAM     [label = "Ca²⁺–calmodulin"];
    X_MLCK    [label = "MLCK activation"];
    X_MLC20   [label = "MLC20 phosphorylation"];
    X_MLCP    [label = "MLCP (MYPT1) dephosphorylation"];
    X_RHOA    [label = "RhoA / ROCK → CPI-17 →\nCa²⁺ SENSITISATION"];
    X_ACTIN   [label = "Actin–myosin cross-bridge cycling"];
    X_CONTR   [label = "Contraction amplitude × frequency\n(Montevideo units)",
               fillcolor = "#ffca28", penwidth = 1.8];
    X_SERCA   [label = "SERCA / PMCA Ca²⁺ extrusion"];
    X_KATP    [label = "K-ATP · SK3 hyperpolarising currents"];
  }

  /* ================ 11. RELAXATION / QUIESCENCE PATHWAYS ================ */
  subgraph cluster_relax {
    label = "11. Relaxation pathways (targets of tocolysis)";
    style = "filled,rounded"; color = "#90caf9"; fillcolor = "#e3f2fd"; fontsize = 12;
    node [fillcolor = "#bbdefb", color = "#1565c0"];

    Q_B2     [label = "β2-adrenoceptor (Gs)"];
    Q_AC     [label = "Adenylyl cyclase"];
    Q_CAMP   [label = "cAMP", fillcolor = "#64b5f6", penwidth = 1.6];
    Q_PKA    [label = "PKA → MLCK phosphorylation (inhibitory)"];
    Q_DESENS [label = "β2 desensitisation (GRK / β-arrestin)\n→ TACHYPHYLAXIS in 18–48 h"];
    Q_NO     [label = "NO (eNOS / iNOS, donors)"];
    Q_SGC    [label = "Soluble guanylyl cyclase → cGMP"];
    Q_PKG    [label = "PKG"];
    Q_PDE4   [label = "PDE4 / PDE5 hydrolysis"];
    Q_RELAX  [label = "Relaxin – RXFP1"];
    Q_MG     [label = "Mg²⁺ — competitive Ca²⁺ antagonism\nat Cav1.2 & MLCK"];
  }

  /* ==================== 12. OXYTOCIN SYSTEM ============================= */
  subgraph cluster_ot {
    label = "12. Oxytocin system";
    style = "filled,rounded"; color = "#a5d6a7"; fillcolor = "#f1f8e9"; fontsize = 12;
    node [fillcolor = "#dcedc8", color = "#558b2f"];

    O_PIT    [label = "Maternal posterior pituitary OT"];
    O_FET    [label = "Fetal pituitary OT (fetal contribution)"];
    O_DEC    [label = "Local decidual / amnion OT synthesis"];
    O_OXTP   [label = "Placental leucine aminopeptidase\n(oxytocinase) — OT t½ ≈ 3–5 min"];
    O_GQ     [label = "OXTR–Gq → PLC-β → IP3 + DAG"];
    O_PKC    [label = "PKC / CaMKII"];
    O_FERG   [label = "Ferguson reflex\n(cervical stretch → OT release)"];
    O_V1A    [label = "V1a vasopressin receptor cross-talk"];
    O_PULSE  [label = "Pulsatile OT secretion pattern"];
  }

  /* ================= 13. CERVICAL REMODELLING =========================== */
  subgraph cluster_cervix {
    label = "13. Cervical remodelling — softening · ripening · dilation";
    style = "filled,rounded"; color = "#ce93d8"; fillcolor = "#f8f0fc"; fontsize = 12;
    node [fillcolor = "#e1bee7", color = "#6a1b9a"];

    V_SOFT   [label = "Phase 1 SOFTENING (from 1st trimester,\ncompliance ↑ with strength retained)"];
    V_RIPEN  [label = "Phase 2 RIPENING (weeks before labour)",
              fillcolor = "#ba68c8", fontcolor = "white", penwidth = 1.6];
    V_DILAT  [label = "Phase 3 DILATION"];
    V_REPAIR [label = "Phase 4 POSTPARTUM REPAIR"];
    V_COL1   [label = "Collagen I / III fibril architecture"];
    V_XLINK  [label = "Cross-link density (LOX, HTRA1) ↓"];
    V_DECOR  [label = "Decorin · lumican · fibromodulin\nre-organisation"];
    V_HAS2   [label = "HAS2 → hyaluronan ↑ → water imbibition"];
    V_HYAL   [label = "Hyaluronidase / low-MW HA\n(pro-inflammatory)"];
    V_MMP1   [label = "MMP-1 / MMP-8 (collagenases)"];
    V_MMP29  [label = "MMP-2 / MMP-9 (gelatinases)"];
    V_TIMP   [label = "TIMP-1 / TIMP-2 ↓"];
    V_NEUTC  [label = "Cervical neutrophil / macrophage influx\n+ elastase"];
    V_SMOOTH [label = "Cervical smooth muscle (internal os sphincter)"];
    V_LEN    [label = "Sonographic cervical length (mm)",
              fillcolor = "#ab47bc", fontcolor = "white", penwidth = 1.8];
    V_FUNNEL [label = "Funnelling · sludge · dynamic shortening"];
    V_BISHOP [label = "Bishop score"];
  }

  /* ============ 14. FETAL MEMBRANES & PPROM ============================= */
  subgraph cluster_memb {
    label = "14. Fetal membranes — weakening & PPROM";
    style = "filled,rounded"; color = "#80cbc4"; fillcolor = "#e0f2f1"; fontsize = 12;
    node [fillcolor = "#b2dfdb", color = "#00695c"];

    B_AMNION [label = "Amnion epithelium + compact layer"];
    B_CHOR   [label = "Chorion laeve + trophoblast"];
    B_ZAM    [label = "ZAM — zone of altered morphology\n(supracervical weak zone)"];
    B_GDF15  [label = "GDF-15 · senescence markers"];
    B_APOP   [label = "Amniocyte apoptosis · EMT"];
    B_MMP9   [label = "MMP-9 ↑↑ / TIMP-1 ↓"];
    B_TENS   [label = "Membrane tensile strength ↓",
              fillcolor = "#4db6ac", penwidth = 1.6];
    B_PPROM  [label = "PPROM — preterm prelabour\nrupture of membranes (≈30% of sPTB)",
              fillcolor = "#26a69a", fontcolor = "white", penwidth = 1.8];
    B_LATENT [label = "Latency period after PPROM\n(median 2–7 d; shorter at later GA)"];
    B_OLIGO  [label = "Oligohydramnios → cord compression ·\npulmonary hypoplasia"];
  }

  /* ================ 15. BIOMARKERS & DIAGNOSTICS ======================== */
  subgraph cluster_biomarker {
    label = "15. Biomarkers & bedside prediction";
    style = "filled,rounded"; color = "#c5e1a5"; fillcolor = "#f9fbe7"; fontsize = 12;
    node [fillcolor = "#dcedc8", color = "#689f38"];

    K_FFN    [label = "Cervicovaginal fetal fibronectin (fFN)\nquantitative 10/50/200/500 ng/mL"];
    K_NPV    [label = "fFN NPV for delivery < 7 d ≈ 99%\n(rules OUT, not in)"];
    K_PAMG   [label = "PAMG-1 (PartoSure) ·\nphIGFBP-1 (Actim Partus)"];
    K_AFIL6  [label = "Amniotic fluid IL-6 · glucose ·\nWBC · LDH (amniocentesis)"];
    K_MMPAF  [label = "Amniotic fluid MMP-8 rapid test"];
    K_CLUS   [label = "Serial transvaginal cervical length"];
    K_TAT    [label = "Maternal plasma TAT · CRH ·\nsFlt-1/PlGF"];
    K_CFRNA  [label = "Cell-free RNA / exosomal miRNA\ngestational-age clock"];
    K_RISK   [label = "Composite short-term delivery risk\n(QUiPP-style)", fillcolor = "#aed581"];
  }

  /* ============== 16. PROGESTOGEN PHARMACOLOGY ========================== */
  subgraph cluster_drugP4 {
    label = "16. PREVENTION — progestogen pharmacology";
    style = "filled,rounded"; color = "#a5d6a7"; fillcolor = "#e8f5e9"; fontsize = 12;
    node [fillcolor = "#a5d6a7", color = "#2e7d32", shape = box];

    DP_VAG   [label = "Vaginal micronized P4\n90 mg gel / 200 mg capsule qhs", shape = "box3d"];
    DP_FUP   [label = "FIRST UTERINE PASS effect —\nendometrial ≫ plasma concentration"];
    DP_OHPC  [label = "17-OHPC 250 mg IM weekly\n(16–36 wk)", shape = "box3d"];
    DP_OHPCPK[label = "17-OHPC PK: flip-flop IM depot,\nt½ ≈ 16 d, CYP3A4 metabolism"];
    DP_P4PK  [label = "Vaginal P4 PK: Tmax ≈ 3–6 h,\nplasma 10–20 ng/mL, high local ratio"];
    DP_MECH  [label = "Mechanism: PR-B signalling ↑ ·\nNF-κB trans-repression · PGDH maintenance"];
    DP_TRIAL [label = "Evidence: PREGNANT & OPPTIMUM & EPPPIC —\nbenefit concentrated in SHORT CERVIX"];
    DP_NULL  [label = "PROLONG null vs MEIS positive →\n17-OHPC withdrawn (US, 2023)"];
  }

  /* ================= 17. TOCOLYTIC PHARMACOLOGY ========================= */
  subgraph cluster_toco {
    label = "17. ACUTE TOCOLYSIS — pharmacology (buys 48 h, does not prevent PTB)";
    style = "filled,rounded"; color = "#90caf9"; fillcolor = "#e1f5fe"; fontsize = 12;
    node [fillcolor = "#81d4fa", color = "#0277bd"];

    T_ATO    [label = "ATOSIBAN — OXTR/V1a competitive antagonist\n6.75 mg bolus → 300 → 100 µg/min", shape = "box3d"];
    T_ATOPK  [label = "Atosiban PK: 2-cmt, CL ≈ 42 L/h,\nVc ≈ 18 L, t½α 13 min / t½β 1.7 h"];
    T_NIF    [label = "NIFEDIPINE — L-type Ca²⁺ channel blocker\n20 mg PO load → 10–20 mg q4–6h", shape = "box3d"];
    T_NIFPK  [label = "Nifedipine PK: CYP3A4, t½ 2–3 h,\nhigh first-pass, IR capsule"];
    T_IND    [label = "INDOMETHACIN — non-selective COX inhibitor\n100 mg PR load → 25 mg q6h ≤ 48 h", shape = "box3d"];
    T_INDPK  [label = "Indomethacin PK: t½ 4.5 h,\nplacental transfer ≈ 50%"];
    T_MG     [label = "MgSO4 — 4–6 g IV load + 1–2 g/h", shape = "box3d"];
    T_MGPK   [label = "Mg PK: renal elimination only,\nCL ∝ CrCl; target 4–7 mg/dL"];
    T_BETA   [label = "β2-agonists (terbutaline · ritodrine)\n— FDA boxed warning, largely abandoned", shape = "box3d"];
    T_NTG    [label = "Nitroglycerin patch (NO donor)\n— weak evidence"];
    T_48H    [label = "GOAL: 48-hour window for steroids\n+ in-utero transfer",
              fillcolor = "#29b6f6", fontcolor = "white", penwidth = 1.8];
    T_MAINT  [label = "Maintenance tocolysis: NO benefit\n(do not continue past 48 h)"];
  }

  /* ============= 18. TOCOLYTIC ADVERSE EFFECTS ========================== */
  subgraph cluster_ae {
    label = "18. Tocolytic & steroid adverse effects (the safety ledger)";
    style = "filled,rounded"; color = "#ef9a9a"; fillcolor = "#fff1f0"; fontsize = 12;
    node [fillcolor = "#ffcdd2", color = "#b71c1c"];

    A_PULM   [label = "Maternal pulmonary oedema\n(β-agonist ≫ others; fluid + steroids)"];
    A_TACHY  [label = "Maternal tachycardia · palpitations ·\nhypokalaemia · hyperglycaemia (β2)"];
    A_HYPO   [label = "Maternal hypotension · flushing ·\nheadache (nifedipine)"];
    A_MGTOX  [label = "Mg toxicity ladder: DTR loss 9–12 mg/dL →\nresp. depression 12–18 → arrest > 18"];
    A_DUCT   [label = "Fetal ductus arteriosus constriction\n(indomethacin; risk ↑↑ after 32 wk)"];
    A_OLIG2  [label = "Fetal oliguria → oligohydramnios\n(indomethacin, reversible)"];
    A_NEC    [label = "Neonatal NEC · IVH signal\n(prolonged indomethacin)"];
    A_HYPERG [label = "Maternal hyperglycaemia\n(betamethasone, 24–72 h)"];
    A_NEOHYP [label = "Neonatal hypoglycaemia\n(ALPS late-preterm steroids: 24% vs 15%)"];
    A_REPEAT [label = "Repeat steroid courses →\nbirthweight ↓, head circumference ↓"];
    A_ATOSAF [label = "Atosiban: best maternal safety profile,\nfewest treatment discontinuations"];
  }

  /* ========== 19. ANTENATAL CORTICOSTEROIDS & FETAL LUNG ================ */
  subgraph cluster_acs {
    label = "19. ANTENATAL CORTICOSTEROIDS — fetal lung maturation (the intervention that changes outcome)";
    style = "filled,rounded"; color = "#ffe082"; fillcolor = "#fff8e1"; fontsize = 12;
    node [fillcolor = "#ffe082", color = "#ff8f00"];

    F_BET    [label = "Betamethasone 12 mg IM ×2, 24 h apart\n(phosphate + acetate biphasic)", shape = "box3d"];
    F_DEX    [label = "Dexamethasone 6 mg IM ×4, 12 h apart\n(equivalent alternative)", shape = "box3d"];
    F_BETPK  [label = "Betamethasone PK: phosphate ester rapid,\nacetate slow depot; maternal t½ ≈ 5.5 h"];
    F_TRANS  [label = "Transplacental transfer\n(betamethasone escapes 11β-HSD2)"];
    F_HSD2   [label = "Placental 11β-HSD2 barrier\n(inactivates cortisol, not betamethasone)"];
    F_GR     [label = "Fetal lung GR (NR3C1) activation"];
    F_ATII   [label = "Alveolar type II cell maturation"];
    F_SPB    [label = "SP-A / SP-B / SP-C + ABCA3\nsurfactant synthesis ↑"];
    F_ENAC   [label = "ENaC + Na⁺/K⁺-ATPase →\nfetal lung liquid clearance"];
    F_ANTIOX [label = "Antioxidant enzyme induction ·\nthinning of mesenchyme"];
    F_WINDOW [label = "OPTIMAL WINDOW: delivery 24 h – 7 d\nafter first dose",
              fillcolor = "#ffb300", penwidth = 1.8];
    F_ALPS   [label = "ALPS: late-preterm 34⁰–36⁶ wk benefit\nwith hypoglycaemia trade-off"];
    F_ACTION [label = "WHO ACTION-I: benefit confirmed in\nlow-resource settings"];
  }

  /* ========== 20. MgSO4 NEUROPROTECTION & ADJUNCTS ====================== */
  subgraph cluster_neuro {
    label = "20. Fetal neuroprotection, antibiotics & mechanical adjuncts";
    style = "filled,rounded"; color = "#b39ddb"; fillcolor = "#f3e5f5"; fontsize = 12;
    node [fillcolor = "#d1c4e9", color = "#4527a0"];

    N_MGN    [label = "MgSO4 for NEUROPROTECTION < 32 wk\n(distinct indication from tocolysis)", shape = "box3d"];
    N_NMDA   [label = "NMDA receptor blockade ·\nexcitotoxicity ↓ · Ca²⁺ influx ↓"];
    N_CBF    [label = "Cerebral blood-flow stabilisation ·\nanti-inflammatory · antioxidant"];
    N_CP     [label = "Cerebral palsy RR ≈ 0.68 (NNT ≈ 63)\nBEAM / ACTOMgSO4 / PREMAG"];
    N_ERY    [label = "Erythromycin 250 mg qid × 10 d for PPROM\n(ORACLE-I: latency ↑)", shape = "box3d"];
    N_COAMOX [label = "Co-amoxiclav AVOIDED — NEC signal\n(ORACLE-I)"];
    N_GBSPRO [label = "Intrapartum GBS prophylaxis\n(penicillin G)"];
    N_AZI    [label = "Azithromycin ± anti-Ureaplasma\nintra-amniotic eradication (investigational)"];
    N_CERC   [label = "Cervical cerclage —\nhistory- / ultrasound- / exam-indicated", shape = "box3d"];
    N_PESS   [label = "Arabin cervical pessary\n(heterogeneous trial results)", shape = "box3d"];
    N_PROGX  [label = "Cerclage + vaginal P4 combination\n(observational benefit)"];
    N_TRANSF [label = "In-utero transfer to level-III centre\n(largest single outcome lever)"];
  }

  /* ================= 21. DELIVERY & NEONATAL OUTCOMES =================== */
  subgraph cluster_outcome {
    label = "21. Delivery timing & neonatal outcomes";
    style = "filled,rounded"; color = "#ffab91"; fillcolor = "#fbe9e7"; fontsize = 12;
    node [fillcolor = "#ffab91", color = "#bf360c"];

    Z_HAZ    [label = "Instantaneous delivery hazard λ(t)\n= f(contractions, cervix, membranes)",
              fillcolor = "#ff7043", fontcolor = "white", penwidth = 1.8];
    Z_GA     [label = "GESTATIONAL AGE AT DELIVERY (wk)\n— the master outcome variable",
              fillcolor = "#e64a19", fontcolor = "white", penwidth = 2.0];
    Z_EXTREM [label = "Extremely preterm < 28 wk"];
    Z_VERY   [label = "Very preterm 28–31⁺⁶ wk"];
    Z_MOD    [label = "Moderate/late preterm 32–36⁺⁶ wk"];
    Z_TERM   [label = "Term ≥ 37 wk"];
    Z_RDS    [label = "Respiratory distress syndrome\n(≈60% at 28 wk → 6% at 34 wk)"];
    Z_BPD    [label = "Bronchopulmonary dysplasia"];
    Z_IVH    [label = "IVH grade III–IV · PVL"];
    Z_NEC2   [label = "Necrotising enterocolitis"];
    Z_SEPSIS [label = "Early-onset neonatal sepsis"];
    Z_ROP    [label = "Retinopathy of prematurity"];
    Z_DEATH  [label = "Neonatal mortality\n(GA-dependent survival curve)"];
    Z_CP     [label = "Cerebral palsy · neurodevelopmental impairment"];
    Z_NICU   [label = "NICU length of stay · cost"];
    Z_COMPOS [label = "Composite severe neonatal morbidity",
              fillcolor = "#ff8a65", penwidth = 1.6];
  }

  /* ============ 22. MODEL OUTPUTS / DECISION LAYER ====================== */
  subgraph cluster_model {
    label = "22. QSP model observables & decision layer";
    style = "filled,rounded"; color = "#b0bec5"; fillcolor = "#eceff1"; fontsize = 12;
    node [fillcolor = "#b0bec5", color = "#37474f", shape = note];

    Y_CL     [label = "Simulated cervical length trajectory"];
    Y_MVU    [label = "Simulated contraction index (MVU)"];
    Y_IL6    [label = "Simulated amniotic IL-6"];
    Y_FFN    [label = "Simulated fFN"];
    Y_SURF   [label = "Simulated surfactant / lung-maturity index"];
    Y_PDEL   [label = "Cumulative delivery probability curve"];
    Y_LEDGER [label = "PTL_ledger(): per-arm accounting of\ndays gained vs neonatal outcome shift",
              fillcolor = "#90a4ae", penwidth = 1.6];
    Y_NNT    [label = "Scenario NNT / harm-benefit comparison"];
  }

  /* ############################ EDGES ################################### */

  /* --- risk → arms --- */
  R_PRIOR  -> R_PHENO;   R_CL -> R_PHENO;   R_MULTI -> R_PHENO;
  R_ANOM   -> R_PHENO;   R_IPI -> R_PHENO;  R_BMI -> R_PHENO;
  R_SMOKE  -> R_PHENO;   R_PERIO -> R_PHENO; R_SDOH -> R_PHENO;
  R_ART    -> R_PHENO;   R_GEN -> R_PHENO;  R_PROG -> R_PHENO;
  R_PERIO  -> I_FUSO   [label = "haematogenous", style = dashed];
  R_SDOH   -> C_STRESS [style = dashed];
  R_MULTI  -> S_MULTI;
  R_ANOM   -> V_SMOOTH [label = "structural\ninsufficiency", style = dashed];
  R_PHENO  -> C_SETPT;
  R_PHENO  -> I_BV      [style = dashed];
  R_PROG   -> P_RATIO   [style = dashed];
  R_GEN    -> V_COL1    [label = "EBF1/WNT4 →\ncervical stroma", style = dashed];

  /* --- CRH clock --- */
  C_TROPH -> C_CRH;   C_CRH -> C_FREE;  C_CRHBP -> C_FREE [label = "buffers", color = "#8e24aa", arrowhead = tee];
  C_FREE -> C_CRHR1;  C_FREE -> C_CRHR2;
  C_CRHR1 -> C_ACTHF; C_ACTHF -> C_ZONE; C_ZONE -> C_DHEAS; C_ZONE -> C_CORTF;
  C_DHEAS -> C_16OH;  C_16OH -> C_AROM; C_AROM -> C_E3;  C_DHEAS -> C_AROM;
  C_AROM -> E_E2;     C_E3 -> E_ERA;
  C_CORTF -> C_FEEDF; C_FEEDF -> C_CRH [label = "amplifying loop", color = "#8e24aa", penwidth = 1.6];
  C_CORTF -> F_ATII   [label = "endogenous\nlung maturation", style = dashed];
  C_STRESS -> C_CRH;  C_SETPT -> C_CRH [label = "advances clock", penwidth = 1.4];
  C_CRHR1 -> X_CAI    [label = "Gq at term", style = dashed];
  C_CRHR2 -> Q_CAMP   [label = "Gs, quiescent phase", style = dashed];
  C_FREE  -> G_COX2;
  C_CRH   -> K_TAT    [style = dotted];

  /* --- progesterone --- */
  P_SYN -> P_PLASMA;  P_PLASMA -> P_PRB;  P_PLASMA -> P_PRA;
  P_PRA -> P_RATIO;   P_PRB -> P_RATIO [arrowhead = tee, color = "#388e3c"];
  P_20HSD -> P_RATIO [label = "local P4 ↓"];
  P_MIR -> P_ZEB [arrowhead = tee]; P_ZEB -> E_CAPGENE [arrowhead = tee, color = "#388e3c"];
  P_RATIO -> P_MIR;  P_RATIO -> P_STAT5 [arrowhead = tee];
  P_PRB -> P_QUIES;  P_PGRMC -> P_QUIES;  P_QUIES -> M_PHASE0;
  P_PRB -> P_NFKBX;  P_NFKBX -> I_NFKB [arrowhead = tee, color = "#388e3c", penwidth = 1.4];
  I_NFKB -> P_NFKBX  [arrowhead = tee, color = "#c62828", label = "reciprocal\nrepression"];
  P_RATIO -> E_ERA [label = "de-represses"];
  P_RATIO -> G_PGDHD;
  P_QUIES -> G_PGDH;
  P_RATIO -> M_PHASE1 [penwidth = 1.4];
  I_IL1  -> P_20HSD;  I_TNF -> P_RATIO [label = "PR-A ↑"];
  D_THROMB -> P_RATIO [style = dashed];

  /* --- oestrogen --- */
  E_E2 -> E_ERA;  E_E1 -> E_E2;  E_E2 -> E_GPER;
  E_ERA -> E_CAPGENE [penwidth = 1.4];
  E_E2P4 -> E_CAPGENE;  P_RATIO -> E_E2P4;  E_E2 -> E_E2P4;
  E_CAPGENE -> M_OXTR;  E_CAPGENE -> M_CX43;  E_CAPGENE -> M_CAV;  E_CAPGENE -> G_COX2;
  E_ERA -> V_HAS2 [label = "cervical\nripening", style = dashed];

  /* --- infection / inflammation --- */
  I_LACTO -> I_BV [arrowhead = tee, color = "#c62828"];
  I_BV -> I_ASCEND;  I_ASCEND -> I_UREA;  I_ASCEND -> I_GBS;  I_FUSO -> I_MIAC;
  I_UREA -> I_MIAC;  I_GBS -> I_MIAC;
  I_MIAC -> I_LPS;   I_LPS -> I_TLR;  I_DAMP -> I_TLR;
  I_STERILE -> I_DAMP;  D_SENESC -> I_DAMP;  S_WALL -> I_DAMP [style = dashed];
  I_TLR -> I_NFKB [penwidth = 1.4];  I_TLR -> I_NLRP3;  I_NLRP3 -> I_IL1 [penwidth = 1.4];
  I_NFKB -> I_IL6;  I_NFKB -> I_IL8;  I_NFKB -> I_TNF;  I_NFKB -> I_MIF;  I_IL1 -> I_NFKB;
  I_TNF -> I_NFKB;  I_IL8 -> I_NEUT;  I_NEUT -> I_CHORIO;  I_NEUT -> V_NEUTC;
  I_CHORIO -> I_FIRS;  I_IL6 -> I_FIRS;  I_FIRS -> I_MICROB;  I_MICROB -> Z_CP [penwidth = 1.4];
  I_FIRS -> Z_BPD;  I_FIRS -> Z_NEC2;  I_MIAC -> Z_SEPSIS;
  I_NFKB -> G_COX2 [penwidth = 1.6];  I_NFKB -> G_PGDHD;
  I_IL1 -> M_OXTR;  I_TNF -> M_CX43;  I_IL1 -> B_MMP9;  I_TNF -> B_MMP9;
  I_IL6 -> V_MMP1;  I_IL8 -> V_MMP29;  I_NEUT -> V_MMP29;
  I_IL6 -> K_AFIL6;  I_MIAC -> K_MMPAF;
  I_NFKB -> M_PHASE1 [penwidth = 1.6];

  /* --- decidual / thrombin --- */
  D_SENESC -> D_P38;  D_P38 -> D_SASP;  D_SASP -> I_NFKB;  D_SENESC -> D_EXO;
  D_EXO -> D_SASP;  D_ABRUPT -> D_TF;  D_TF -> D_THROMB;  D_THROMB -> D_PAR1;
  D_PAR1 -> X_CAI [label = "direct uterotonic"];  D_PAR1 -> B_MMP9;  D_PAR1 -> V_MMP29;
  D_THROMB -> D_TAT;  D_TAT -> K_TAT;  D_UPI -> D_ABRUPT;  D_UPI -> D_SENESC;
  D_UPI -> C_STRESS;  D_SASP -> B_GDF15;

  /* --- stretch --- */
  S_MULTI -> S_WALL;  S_WALL -> S_PIEZO;  S_WALL -> S_INTEG;
  S_PIEZO -> X_CAI;   S_INTEG -> S_AP1;   S_AP1 -> S_STRCAP;
  S_STRCAP -> M_CX43; S_STRCAP -> G_COX2; S_STRCAP -> M_OXTR; S_STRCAP -> I_IL8;
  S_WALL -> S_MEMBST; S_MEMBST -> B_ZAM;  S_MEMBST -> B_TENS [arrowhead = tee, color = "#5e35b1"];
  S_WALL -> V_LEN [arrowhead = tee, label = "dynamic shortening", style = dashed];

  /* --- prostaglandins --- */
  G_PLA2 -> G_AA;  I_NFKB -> G_PLA2;  G_AA -> G_COX1;  G_AA -> G_COX2;
  G_COX1 -> G_PGH2; G_COX2 -> G_PGH2 [penwidth = 1.4];
  G_PGH2 -> G_PGES; G_PGH2 -> G_PGFS; G_PGH2 -> G_PGI2;
  G_PGES -> G_PGE2; G_PGFS -> G_PGF2;
  G_PGE2 -> G_EP1;  G_PGE2 -> G_EP2;  G_PGF2 -> G_FP;   G_PGI2 -> Q_CAMP;
  G_EP1 -> X_CAI;   G_EP2 -> Q_AC;    G_FP -> X_CAI [penwidth = 1.4];
  G_PGDH -> G_PGE2 [arrowhead = tee, color = "#00838f", label = "disposal barrier"];
  G_PGDHD -> G_PGDH [arrowhead = tee, penwidth = 1.4];
  G_PGE2 -> G_AFPG; G_PGF2 -> G_AFPG;
  G_PGE2 -> V_RIPEN [penwidth = 1.6];  G_PGE2 -> V_HAS2;  G_PGF2 -> M_CX43;
  G_AFPG -> B_APOP;

  /* --- myometrial activation --- */
  M_PHASE0 -> M_PHASE1 [label = "activation"];
  M_PHASE1 -> M_PHASE2 [label = "uterotonins"];
  M_PHASE2 -> M_PHASE3;
  M_PHASE1 -> M_OXTR;  M_PHASE1 -> M_CX43;  M_PHASE1 -> M_CAV;  M_PHASE1 -> M_KCNMB;
  M_PHASE1 -> M_HYPERT;  M_HCN -> M_ICC;  M_ICC -> X_VM;
  M_CX43 -> X_VM [label = "syncytium"];
  M_CAV -> X_CAIN;  M_KCNMB -> X_VM [arrowhead = tee, color = "#d84315"];
  M_HYPERT -> X_SR;

  /* --- E-C coupling --- */
  X_VM -> X_CAIN;  X_CAIN -> X_CAI;  X_SR -> X_CAI;  X_SOCE -> X_CAI;
  X_CAI -> X_CAM;  X_CAM -> X_MLCK; X_MLCK -> X_MLC20;
  X_MLCP -> X_MLC20 [arrowhead = tee, color = "#f9a825"];
  X_RHOA -> X_MLCP [arrowhead = tee];  X_MLC20 -> X_ACTIN; X_ACTIN -> X_CONTR [penwidth = 1.6];
  X_SERCA -> X_CAI [arrowhead = tee];  X_KATP -> X_VM [arrowhead = tee];
  X_CONTR -> V_DILAT [penwidth = 1.4];  X_CONTR -> O_FERG;  X_CONTR -> Y_MVU;
  X_CONTR -> Z_HAZ [penwidth = 1.6];

  /* --- relaxation --- */
  Q_B2 -> Q_AC;  Q_AC -> Q_CAMP;  Q_CAMP -> Q_PKA;  Q_PKA -> X_MLCK [arrowhead = tee, color = "#1565c0", penwidth = 1.4];
  Q_PKA -> X_SERCA;  Q_B2 -> Q_DESENS;  Q_DESENS -> Q_B2 [arrowhead = tee, color = "#1565c0"];
  Q_NO -> Q_SGC;  Q_SGC -> Q_PKG;  Q_PKG -> X_MLCP;  Q_PKG -> X_KATP;
  Q_PDE4 -> Q_CAMP [arrowhead = tee];  Q_RELAX -> Q_AC;
  Q_MG -> X_CAIN [arrowhead = tee, penwidth = 1.4];  Q_MG -> X_MLCK [arrowhead = tee];
  Q_CAMP -> X_CONTR [arrowhead = tee, color = "#1565c0", penwidth = 1.4];

  /* --- oxytocin --- */
  O_PIT -> O_GQ;  O_FET -> O_GQ;  O_DEC -> O_GQ;
  O_OXTP -> O_PIT [arrowhead = tee, label = "degrades"];
  M_OXTR -> O_GQ [penwidth = 1.4];  O_GQ -> X_SR;  O_GQ -> O_PKC;  O_PKC -> X_RHOA;
  O_FERG -> O_PIT [label = "positive feedback", color = "#558b2f", penwidth = 1.4];
  O_V1A -> X_CAI;  O_PULSE -> O_PIT;  V_DILAT -> O_FERG;

  /* --- cervix --- */
  V_SOFT -> V_RIPEN; V_RIPEN -> V_DILAT; V_DILAT -> V_REPAIR;
  V_COL1 -> V_LEN;  V_XLINK -> V_LEN [penwidth = 1.4];
  V_XLINK -> V_COL1;  V_DECOR -> V_COL1;  V_HAS2 -> V_RIPEN [penwidth = 1.4];
  V_HYAL -> I_DAMP;  V_HAS2 -> V_HYAL;
  V_MMP1 -> V_COL1 [arrowhead = tee, color = "#6a1b9a", penwidth = 1.4];
  V_MMP29 -> V_COL1 [arrowhead = tee];  V_TIMP -> V_MMP29 [arrowhead = tee];
  V_NEUTC -> V_MMP1;  V_NEUTC -> V_MMP29;
  V_RIPEN -> V_LEN [arrowhead = tee, penwidth = 1.6];
  V_LEN -> V_FUNNEL [arrowhead = tee];  V_LEN -> V_BISHOP [arrowhead = tee];
  V_LEN -> K_CLUS;  V_LEN -> Y_CL;  V_LEN -> Z_HAZ [arrowhead = tee, penwidth = 1.6];
  V_SMOOTH -> V_LEN;  V_FUNNEL -> B_ZAM;  V_DILAT -> Z_HAZ [penwidth = 1.4];
  V_RIPEN -> K_FFN;

  /* --- membranes --- */
  B_AMNION -> B_TENS; B_CHOR -> B_TENS; B_ZAM -> B_TENS [arrowhead = tee, penwidth = 1.4];
  B_GDF15 -> B_APOP;  B_APOP -> B_TENS [arrowhead = tee];
  B_MMP9 -> B_TENS [arrowhead = tee, penwidth = 1.6];
  B_TENS -> B_PPROM [arrowhead = tee, penwidth = 1.6];
  B_PPROM -> B_LATENT; B_PPROM -> B_OLIGO; B_PPROM -> I_ASCEND [label = "loss of barrier", color = "#c62828"];
  B_PPROM -> Z_HAZ [penwidth = 1.6];  B_OLIGO -> Z_DEATH;
  B_PPROM -> K_PAMG;  B_CHOR -> G_PGDH;

  /* --- biomarkers --- */
  K_FFN -> K_NPV;  K_FFN -> K_RISK;  K_PAMG -> K_RISK;  K_CLUS -> K_RISK;
  K_AFIL6 -> K_RISK; K_TAT -> K_RISK; K_CFRNA -> K_RISK;
  K_RISK -> T_48H [label = "triage", style = dashed];  K_FFN -> Y_FFN;
  K_NPV -> N_TRANSF [label = "avoids unnecessary\ntransfer", style = dashed];

  /* --- progestogen therapy --- */
  DP_VAG -> DP_FUP;  DP_FUP -> DP_P4PK;  DP_P4PK -> DP_MECH;
  DP_OHPC -> DP_OHPCPK; DP_OHPCPK -> DP_MECH;
  DP_MECH -> P_PRB [color = "#2e7d32", penwidth = 1.6];
  DP_MECH -> P_RATIO [arrowhead = tee, color = "#2e7d32", penwidth = 1.6];
  DP_MECH -> I_NFKB [arrowhead = tee, color = "#2e7d32"];
  DP_MECH -> G_PGDH [color = "#2e7d32"];
  DP_MECH -> V_RIPEN [arrowhead = tee, color = "#2e7d32", penwidth = 1.4];
  DP_TRIAL -> DP_VAG [style = dashed];  DP_NULL -> DP_OHPC [style = dashed];
  R_CL -> DP_VAG [label = "indication", style = dashed];
  R_PRIOR -> DP_OHPC [label = "indication", style = dashed];

  /* --- tocolysis --- */
  T_ATO -> T_ATOPK;  T_ATOPK -> M_OXTR [arrowhead = tee, color = "#0277bd", penwidth = 1.6, label = "competitive"];
  T_ATOPK -> O_V1A [arrowhead = tee, color = "#0277bd"];
  T_NIF -> T_NIFPK;  T_NIFPK -> X_CAIN [arrowhead = tee, color = "#0277bd", penwidth = 1.6];
  T_IND -> T_INDPK;  T_INDPK -> G_COX2 [arrowhead = tee, color = "#0277bd", penwidth = 1.6];
  T_INDPK -> G_COX1 [arrowhead = tee, color = "#0277bd"];
  T_MG -> T_MGPK;    T_MGPK -> Q_MG [color = "#0277bd", penwidth = 1.4];
  T_BETA -> Q_B2 [color = "#0277bd"];  T_BETA -> Q_DESENS;
  T_NTG -> Q_NO [color = "#0277bd"];
  T_ATOPK -> T_48H; T_NIFPK -> T_48H; T_INDPK -> T_48H; T_MGPK -> T_48H;
  T_48H -> F_BET [label = "enables", penwidth = 1.6];
  T_48H -> N_TRANSF [penwidth = 1.4];
  T_MAINT -> T_48H [arrowhead = tee, style = dashed, label = "no added benefit"];
  X_CONTR -> T_48H [style = dotted, label = "treatment trigger"];

  /* --- adverse effects --- */
  T_BETA -> A_PULM; T_BETA -> A_TACHY; T_NIFPK -> A_HYPO; T_MGPK -> A_MGTOX;
  T_MGPK -> A_PULM [style = dashed]; T_INDPK -> A_DUCT [penwidth = 1.4];
  T_INDPK -> A_OLIG2; T_INDPK -> A_NEC; F_BET -> A_HYPERG;
  F_ALPS -> A_NEOHYP; A_REPEAT -> Z_GA [style = dashed];
  T_ATO -> A_ATOSAF; A_DUCT -> Z_DEATH [style = dashed];
  A_NEC -> Z_NEC2;  A_MGTOX -> A_PULM [style = dashed];

  /* --- antenatal corticosteroids --- */
  F_BET -> F_BETPK; F_DEX -> F_BETPK; F_BETPK -> F_TRANS;
  F_HSD2 -> F_TRANS [arrowhead = tee, label = "does NOT block\nbetamethasone", color = "#ff8f00"];
  F_TRANS -> F_GR [penwidth = 1.4]; F_GR -> F_ATII; F_ATII -> F_SPB [penwidth = 1.6];
  F_GR -> F_ENAC;  F_GR -> F_ANTIOX;
  F_SPB -> Y_SURF; F_SPB -> Z_RDS [arrowhead = tee, penwidth = 1.8];
  F_ENAC -> Z_RDS [arrowhead = tee];  F_ANTIOX -> Z_BPD [arrowhead = tee];
  F_WINDOW -> F_SPB [penwidth = 1.6]; F_BETPK -> F_WINDOW;
  F_ALPS -> F_BET [style = dashed];  F_ACTION -> F_BET [style = dashed];
  F_GR -> Z_IVH [arrowhead = tee];  F_GR -> Z_DEATH [arrowhead = tee, penwidth = 1.4];

  /* --- neuroprotection & adjuncts --- */
  N_MGN -> N_NMDA;  N_MGN -> N_CBF;  N_NMDA -> N_CP [arrowhead = tee, penwidth = 1.6];
  N_CBF -> Z_IVH [arrowhead = tee];  N_CP -> Z_CP [arrowhead = tee, penwidth = 1.6];
  T_MGPK -> N_NMDA [style = dashed, label = "same exposure,\ndifferent indication"];
  N_ERY -> I_MIAC [arrowhead = tee, color = "#4527a0"];
  N_ERY -> B_LATENT [label = "prolongs", penwidth = 1.4];
  N_COAMOX -> Z_NEC2 [label = "AVOID", color = "#b71c1c", style = dashed];
  N_GBSPRO -> Z_SEPSIS [arrowhead = tee];
  N_AZI -> I_UREA [arrowhead = tee, color = "#4527a0"];
  N_CERC -> V_LEN [label = "mechanical support", color = "#4527a0", penwidth = 1.4];
  N_PESS -> V_LEN [color = "#4527a0"];  N_PESS -> S_WALL [arrowhead = tee, label = "redirects axis"];
  N_PROGX -> N_CERC [style = dashed];  N_PROGX -> DP_VAG [style = dashed];
  N_TRANSF -> Z_NICU [style = dashed]; N_TRANSF -> Z_DEATH [arrowhead = tee, penwidth = 1.4];

  /* --- outcomes --- */
  Z_HAZ -> Z_GA [arrowhead = tee, penwidth = 1.8];
  Z_GA -> Z_EXTREM; Z_GA -> Z_VERY; Z_GA -> Z_MOD; Z_GA -> Z_TERM;
  Z_EXTREM -> Z_RDS; Z_EXTREM -> Z_IVH; Z_EXTREM -> Z_DEATH; Z_EXTREM -> Z_ROP;
  Z_VERY -> Z_RDS;  Z_VERY -> Z_BPD;  Z_VERY -> Z_NEC2;
  Z_MOD -> Z_RDS [style = dashed];
  Z_RDS -> Z_BPD;  Z_RDS -> Z_COMPOS; Z_IVH -> Z_CP; Z_IVH -> Z_COMPOS;
  Z_NEC2 -> Z_COMPOS; Z_SEPSIS -> Z_COMPOS; Z_BPD -> Z_COMPOS;
  Z_GA -> Y_PDEL;

  /* --- model observables --- */
  Y_CL -> Y_LEDGER; Y_MVU -> Y_LEDGER; Y_IL6 -> Y_LEDGER; Y_FFN -> Y_LEDGER;
  Y_SURF -> Y_LEDGER; Y_PDEL -> Y_LEDGER; Y_LEDGER -> Y_NNT;
  Z_COMPOS -> Y_LEDGER [style = dotted];

  /* --- the structural punchline: tocolysis touches only ONE of three limbs --- */
  T_48H -> X_CONTR [arrowhead = tee, color = "#d81b60", penwidth = 2.0,
                    label = "tocolysis silences the CONTRACTION limb only"];
  V_RIPEN -> Z_HAZ [color = "#d81b60", penwidth = 1.4, style = bold,
                    label = "cervical limb keeps running"];
  B_TENS  -> Z_HAZ [arrowhead = tee, color = "#d81b60", penwidth = 1.4, style = bold,
                    label = "membrane limb keeps running"];
  I_MIAC  -> T_48H [arrowhead = tee, color = "#d81b60", penwidth = 1.6, style = bold,
                    label = "infection makes tocolysis futile"];
}
