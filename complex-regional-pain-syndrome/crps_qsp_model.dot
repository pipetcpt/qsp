digraph CRPS_QSP {
    rankdir=LR;
    compound=true;
    fontname="NanumGothic";
    labelloc="t";
    fontsize=28;
    label="복합부위통증증후군 (CRPS) — Mechanistic QSP Map\nNeurogenic Inflammation · Autoimmunity · Sympatho-Afferent Coupling · Tissue Hypoxia · Central Sensitization · Cortical Reorganization · Disuse-Bone Loop · Drug PK/PD\n(20 clusters · 178 nodes · 263 edges) — 핵심 구조: 빠른 말초 염증 노드(가역) → 느린 중추/불용 양성피드백 노드(준-비가역) 로의 상태 이동 = '치료 창(therapeutic window)'";
    node [style=filled, fontname="NanumGothic", fontsize=11, shape=box, margin="0.12,0.08"];
    edge [fontname="NanumGothic", fontsize=9, color="gray35"];
    graph [fontname="NanumGothic"];

    /* ===================================================================
       1. 유발사건 / 위험인자
       =================================================================== */
    subgraph cluster_trigger {
        label="1. 유발사건 및 위험인자 (Inciting Event & Risk Factors)";
        style=filled; color="#f2e2c4"; node [fillcolor="#f7d896"];
        Fracture     [label="원위 요골 골절 (가장 흔한 유발사건)\n골절 후 CRPS 발생 ~7% (3.8-26%)"];
        Surgery      [label="수술/외상 (수근관 감압술, 족부 수술,\n관절경, 관절치환술)"];
        Immobil      [label="석고고정·부동(immobilization)\n(실험적 4주 부동만으로도 유사 표현형)"];
        MinorTrauma  [label="경미 손상/염좌 (10-20%)\n또는 유발사건 불명 (~5-10%)"];
        Sex_age      [label="여성 3-4:1, 최고 발생 50-70세\n발생률 5.5-26.2 / 100,000 인-년"];
        Genetics     [label="유전 소인 (HLA-B62, HLA-DQ8,\nHLA-DRB1*13, TNF-α 다형성)"];
        Baseline_pain[label="초기 통증 강도 高 (NRS>5)\n= 최강 예측인자 (예측 위험인자)"];
        ACEi_use     [label="ACE 억제제 사용\n(브라디키닌/SP 분해↓ → 위험↑)"];
        Psych_pre    [label="선행 심리적 취약성\n(재난적 사고, 불안, PTSD 병력)"];
        Migraine_hx  [label="편두통/천식 병력 (신경성 염증 소인)"];
    }

    /* ===================================================================
       2. 조직·신경 손상 및 아형
       =================================================================== */
    subgraph cluster_injury {
        label="2. 조직·신경 손상 및 아형 분류 (Tissue/Nerve Injury & Subtypes)";
        style=filled; color="#e6dccd"; node [fillcolor="#e0c9a6"];
        TissueInjury [label="국소 조직 손상\n(DAMPs 방출: HMGB1, ATP, HSP)"];
        CRPS_I       [label="CRPS Type I (~90%)\n확인 가능한 주신경 손상 없음"];
        CRPS_II      [label="CRPS Type II (~10%)\n주신경 손상 확인 (causalgia)"];
        SmallFiber   [label="소섬유 신경병증\n표피내 신경섬유밀도(IENFD) ↓ 29-30%"];
        NerveSprout  [label="비정상 축삭 재생/발아 (aberrant sprouting)"];
        TLR4_act     [label="TLR4 / RAGE 활성화 (선천면역 점화)"];
    }

    /* ===================================================================
       3. 신경성 염증 (핵심 말초 노드)
       =================================================================== */
    subgraph cluster_neuroinflam {
        label="3. 신경성 염증 (Neurogenic Inflammation) — 빠른 말초 노드";
        style=filled; color="#fbdcdc"; node [fillcolor="#f4a5a5"];
        Cfiber       [label="C-섬유 / 펩티드성 구심신경 활성화"];
        SubP         [label="Substance P ↑ (NK1 수용체)"];
        CGRP_pep     [label="CGRP ↑ (CLR/RAMP1 수용체)"];
        NKA          [label="Neurokinin A / VIP"];
        PlasmaExtrav [label="혈관투과성↑ · 혈장 유출\n(plasma extravasation)"];
        Vasodil_neuro[label="신경성 혈관확장 (warm phase)"];
        Edema        [label="부종 (patchy, 원위부 우세)"];
        Keratinocyte [label="케라티노사이트 증식·활성화\n(IL-6/TNF-α 국소 생산원)"];
        MastCell     [label="비만세포 탈과립 (tryptase, 히스타민)"];
        NGF_node     [label="NGF ↑ → TrkA 신호\n(감작 + sprouting 유도)"];
        BK_node      [label="브라디키닌 (B2 수용체)"];
        PGE2_node    [label="PGE2 / COX-2 유도"];
    }

    /* ===================================================================
       4. 선천면역 / 사이토카인
       =================================================================== */
    subgraph cluster_cytokine {
        label="4. 선천면역 · 사이토카인 프로파일 (Innate Immunity & Cytokines)";
        style=filled; color="#fce4d0"; node [fillcolor="#f6b978"];
        IL1b         [label="IL-1β ↑ (수포액 blister fluid)"];
        IL6          [label="IL-6 ↑ (수포액/혈청, 급성기 우세)"];
        TNFa         [label="TNF-α ↑ (수포액 patient/control 비 ↑)"];
        IL8          [label="IL-8 / CXCL8 ↑ (호중구 유인)"];
        IL10_low     [label="IL-10 · TGF-β ↓ (항염 균형 붕괴)"];
        Monocyte     [label="CD14+CD16+ 단핵구 증가"];
        NFkB         [label="NF-κB / MAPK 전사 활성화"];
        Complement   [label="보체 활성화 (C5a-C5aR)"];
        SolubleTNFR  [label="가용성 TNF-R1 ↑ (전신 지표)"];
    }

    /* ===================================================================
       5. 자가면역 기전
       =================================================================== */
    subgraph cluster_autoimmune {
        label="5. 자가면역 성분 (Autoimmune Component)";
        style=filled; color="#e0e8d5"; node [fillcolor="#b6cf92"];
        B2AR_Ab      [label="항 β2-아드레날린 수용체 자가항체"];
        M2_Ab        [label="항 무스카린 M2 수용체 자가항체"];
        AT1R_Ab      [label="항 AT1R (안지오텐신 II 1형) 자가항체"];
        Bcell        [label="B세포 / 형질세포 클론 확장"];
        PassiveTrans [label="수동 이전(passive transfer) 실험:\n환자 IgG → 마우스 통증 표현형 재현"];
        AutoAgTarget [label="자가항체 표적 = 말초 신경/혈관 수용체\n(기능 조절형 항체)"];
        IVIG_node    [label="IVIG (면역글로불린 정주)\n소규모 양성(2010) / LIPS RCT 음성(2017)"];
        Rituximab_n  [label="리툭시맙 / 형질세포 표적 (탐색적)"];
    }

    /* ===================================================================
       6. 산화 스트레스
       =================================================================== */
    subgraph cluster_ros {
        label="6. 산화 스트레스 · 자유라디칼 (Oxidative Stress)";
        style=filled; color="#e6e0f0"; node [fillcolor="#bfb0dd"];
        ROS_node     [label="ROS (O2•-, H2O2) ↑"];
        OH_radical   [label="히드록실 라디칼 (•OH)"];
        ONOO         [label="퍼옥시나이트라이트 (ONOO-)\nNO + O2•- 반응"];
        LipidPerox   [label="지질 과산화 (MDA, 8-iso-PGF2α ↑)"];
        Antiox_low   [label="내인성 항산화 방어 ↓ (SOD/GSH)"];
        Mito_dys     [label="미토콘드리아 기능이상\n(근육 생검: 산화적 인산화 ↓)"];
    }

    /* ===================================================================
       7. 교감신경-구심신경 결합
       =================================================================== */
    subgraph cluster_sympathetic {
        label="7. 교감신경-구심신경 결합 (Sympatho-Afferent Coupling)";
        style=filled; color="#d9e4f5"; node [fillcolor="#a9c6ec"];
        SympOutflow  [label="교감신경 유출 (환측 국소 조절 이상)"];
        NE_local     [label="국소 노르에피네프린 (초기↓ 후기 정상/↑)"];
        Alpha1_up    [label="α1-아드레날린 수용체 상향조절\n(노시셉터·피부 세포)"];
        SympSprout   [label="DRG 내 교감신경 발아 (sympathetic sprouting)"];
        DRG_node     [label="배근신경절 (DRG) — 통합 지점"];
        AdrenSens    [label="아드레날린 민감성 통증\n(phentolamine/노르에피네프린 시험)"];
        SympBlock    [label="교감신경 차단술\n(성상신경절 / 요부 교감신경절)"];
        CatecholSupers[label="카테콜아민 초민감성\n(수용체 상향조절 + 순환 NE↓)"];
    }

    /* ===================================================================
       8. 미세혈관 / 조직 저산소 (warm→cold 전환)
       =================================================================== */
    subgraph cluster_vascular {
        label="8. 미세혈관 기능이상 · 조직 저산소 (Microvascular Dysfunction & Hypoxia)";
        style=filled; color="#d6ecec"; node [fillcolor="#93cfcf"];
        EndoDys      [label="내피 기능이상"];
        NO_low       [label="NO 생체이용률 ↓ (eNOS 탈결합)"];
        ET1_high     [label="엔도텔린-1 ↑ (수포액 ET-1 상승)"];
        Shunt        [label="영양혈관 우회 (AV shunting)\n= 피부 온난 + 심부 허혈 공존"];
        Hypoxia      [label="조직 저산소증 (경피 pO2 ↓)"];
        Lactate      [label="젖산 ↑ · 조직 pH ↓ (근육 산증)"];
        WarmPhase    [label="온난형 (warm CRPS)\n조기·염증 우세 표현형"];
        ColdPhase    [label="한랭형 (cold CRPS)\n후기·허혈/중추 우세 표현형"];
        TempAsym     [label="온도 비대칭 >1°C (진단 기준 항목)"];
        LaserDoppler [label="레이저 도플러 / 적외선 체열 (측정)"];
        Tadalafil_n  [label="타달라필 (PDE5i) — 한랭형 탐색 RCT"];
    }

    /* ===================================================================
       9. 말초 감작
       =================================================================== */
    subgraph cluster_periphsens {
        label="9. 말초 감작 (Peripheral Sensitization)";
        style=filled; color="#f5dede"; node [fillcolor="#eda9a9"];
        TRPV1        [label="TRPV1 감작 (열 이질통)"];
        TRPA1        [label="TRPA1 (한랭·화학 자극)"];
        Nav17_18     [label="Nav1.7 / Nav1.8 발현·인산화 ↑"];
        ASIC3        [label="ASIC3 (산증 감지, 젖산 연계)"];
        P2X3         [label="P2X3 (ATP 수용체)"];
        PeriphSensNode[label="말초 노시셉터 흥분성 ↑\n(역치↓ · 자발 방전)"];
        MechAllod    [label="기계적 이질통 (동적 붓 자극)"];
        ColdAllod    [label="한랭 이질통 / 열 과민통"];
    }

    /* ===================================================================
       10. 척수 중추 감작
       =================================================================== */
    subgraph cluster_spinal {
        label="10. 척수 중추 감작 (Spinal Central Sensitization) — 느린 노드";
        style=filled; color="#e3d3ef"; node [fillcolor="#c9a8e3"];
        Glutamate    [label="글루타메이트 방출 ↑ (일차 구심 종말)"];
        NMDA_NR2B    [label="NMDA-NR2B 수용체 활성화\n(Mg2+ 차단 해제 · CaMKII)"];
        AMPA_traf    [label="AMPA GluA1 시냅스 이동"];
        WindUp       [label="Wind-up / 시간적 총화(temporal summation)"];
        WDR          [label="광범위 반응 뉴런(WDR) 수용야 확대"];
        Disinhib     [label="탈억제 (GABA/glycine 개재뉴런 소실)"];
        PKC_ERK      [label="PKC / ERK1-2 인산화 (LTP-유사)"];
        Dynorphin    [label="다이노르핀 · NK1 발현 뉴런 증가"];
        SpinalSens   [label="척수 감작 상태 변수\n(2차 이질통 · 확산 통증)"];
        SpreadPain   [label="통증 확산 (환측 전체·거울/대측 확산)"];
    }

    /* ===================================================================
       11. 신경면역: 교세포
       =================================================================== */
    subgraph cluster_glia {
        label="11. 척수 신경면역 (Spinal Neuroimmune / Glia)";
        style=filled; color="#f0e2f7"; node [fillcolor="#d9b8ea"];
        Microglia    [label="미세아교세포 활성화 (P2X4, TLR4)"];
        BDNF_TrkB    [label="BDNF → TrkB → KCC2 ↓\n(억제성 음이온 구배 붕괴)"];
        Astrocyte    [label="성상교세포 활성화 (GFAP↑, GLT-1↓)"];
        CCL2         [label="CCL2 / CX3CL1 뉴런-교세포 신호"];
        SpinalTNF    [label="척수 내 TNF-α / IL-1β"];
        GliaState    [label="교세포 활성 상태 변수\n(느린 시상수, 약물 저항성)"];
    }

    /* ===================================================================
       12. 하행 조절
       =================================================================== */
    subgraph cluster_descend {
        label="12. 하행 통증 조절 (Descending Modulation)";
        style=filled; color="#dfe9f7"; node [fillcolor="#9fbde5"];
        PAG_RVM      [label="PAG-RVM 축"];
        OnCells      [label="RVM ON-세포 촉진 우세"];
        OffCells     [label="RVM OFF-세포 억제 ↓"];
        LC_NE        [label="청반(LC)-척수 노르아드레날린 α2 억제"];
        Serotonin_5HT[label="세로토닌성 하행 (5-HT3 촉진 / 5-HT7 억제)"];
        DNIC_loss    [label="조건화 통증조절(CPM/DNIC) 손실\n(내인성 억제능 저하)"];
        DescInhib    [label="하행 억제 톤 상태 변수 ↓"];
    }

    /* ===================================================================
       13. 대뇌 재구성 / 신체지각
       =================================================================== */
    subgraph cluster_cortex {
        label="13. 대뇌 재구성 · 신체지각 장애 (Cortical Reorganization)";
        style=filled; color="#fdf0c9"; node [fillcolor="#f2d97a"];
        S1_shrink    [label="S1 체감각 지도 축소·왜곡\n(환측 손 표상 면적 ↓)"];
        M1_reorg     [label="M1 운동 지도 재구성 · 억제 이상"];
        TwoPoint     [label="2점 식별역 ↑ (촉각 정밀도 ↓)"];
        BPD          [label="신체지각 장애(BPD)\n'내 손이 아닌 것 같다'"];
        NeglectLike  [label="무시-유사 증상 (neglect-like)\n의도적 주의 필요"];
        Laterality   [label="좌우 판별 과제 반응시간 ↑"];
        GMI          [label="단계적 운동 상상(GMI)\n(좌우판별→상상→거울치료)"];
        MirrorTx     [label="거울치료 (mirror therapy)"];
        CorticalState[label="피질 지도 열화 상태 변수\n(사용 의존적 회복 = 느림)"];
        Prefrontal   [label="전전두-편도 통증 정서 회로"];
    }

    /* ===================================================================
       14. 골 재형성 / 불용성 골소실
       =================================================================== */
    subgraph cluster_bone {
        label="14. 골 재형성 · 불용성 골소실 (Bone Remodeling & Disuse Osteopenia)";
        style=filled; color="#e8e3dc"; node [fillcolor="#c9bda8"];
        Osteoclast   [label="골흡수 파골세포 활성 ↑"];
        RANKL_OPG    [label="RANKL/OPG 비 ↑ (CGRP·SP·불용 매개)"];
        CTX_marker   [label="혈청 CTX-I / TRAP5b ↑ (골흡수 표지자)"];
        BMD_loss     [label="환측 국소 BMD ↓ (반점형 골감소)"];
        BoneScan     [label="3상 골스캔 흡수 증가 (진단 보조)"];
        PatchyOP     [label="단순촬영 반점형 골위축\n(Sudeck atrophy)"];
        BoneMarrow   [label="골수 부종 (MRI STIR 신호↑)"];
        Neridronate  [label="네리드로네이트 100mg IV x4\n(Varenna 2013 RCT 양성)"];
        Pamidronate  [label="파미드로네이트 60mg IV\n(Robinson 2004 RCT)"];
        Alendronate  [label="알렌드로네이트 40mg/일 경구\n(Manicourt 2004 RCT)"];
        BoneAcidLink [label="골 산증-노시셉터 연결\n(ASIC3/TRPV1 골내 신경 종말)"];
    }

    /* ===================================================================
       15. 운동 장애 · 영양 변화
       =================================================================== */
    subgraph cluster_motor {
        label="15. 운동 장애 · 영양 변화 (Motor & Trophic Changes)";
        style=filled; color="#dcefe2"; node [fillcolor="#a5d6b7"];
        Dystonia     [label="고정 자세 이상운동증(dystonia)\n(주로 만성·젊은 환자)"];
        TremorMyo    [label="떨림 / 근경련 (myoclonus)"];
        Weakness     [label="근력 저하 · 협조 운동 이상"];
        ROM_loss     [label="관절 운동범위(ROM) ↓"];
        Contracture  [label="관절 구축 · 연부조직 섬유화"];
        TrophicSkin  [label="피부 위축 · 발한 이상 · 털/손톱 변화"];
        BoNT_A       [label="보툴리눔 독소 A (국소 이상운동)"];
        ITB          [label="척수강내 바클로펜\n(van Rijn 2009, 이상운동증)"];
        PT_node      [label="물리치료 · 단계적 하중\n(pain exposure PT)"];
    }

    /* ===================================================================
       16. 심리-행동 불용 루프 (양성 피드백의 핵심)
       =================================================================== */
    subgraph cluster_behavior {
        label="16. 심리-행동 불용 루프 (Fear-Avoidance / Disuse Loop) — 양성 피드백";
        style=filled; color="#fbe0ee"; node [fillcolor="#eea5cd"];
        Catastroph   [label="통증 재난적 사고 (PCS ↑)"];
        Kinesio      [label="운동 공포 (kinesiophobia, TSK ↑)"];
        Avoidance    [label="회피 행동 · 환측 비사용"];
        DisuseState  [label="불용 상태 변수 (disuse)\n= 루프의 느린 축"];
        DeconditionM [label="근위축 · 심혈관 탈조건화"];
        DepAnx       [label="우울 · 불안 · 수면 장애"];
        CBT_GE       [label="인지행동치료 · 단계적 노출\n(graded exposure in vivo)"];
        SelfEfficacy [label="자기효능감 (회복 방향 구동)"];
    }

    /* ===================================================================
       17. 약물 PK
       =================================================================== */
    subgraph cluster_pk {
        label="17. 약물 PK (Pharmacokinetics)";
        style=filled; color="#dbe6f6"; node [fillcolor="#8fb4e3"];
        KET_PK       [label="케타민 IV 지속주입\n2구획 · CL~80 L/h · t1/2β ~2-3h"];
        NORKET_PK    [label="노르케타민 (CYP3A4/2B6 활성 대사체)"];
        PRED_PK      [label="프레드니솔론 경구\nF~0.8 · t1/2 2-3h · 수용체 점유 지속"];
        NER_PK       [label="네리드로네이트 IV\n혈장 급속 소실 + 골 결합(장기 잔류)"];
        GBP_PK       [label="가바펜틴 (LAT1 포화 흡수)\n용량 증가 시 F ↓"];
        AMT_PK       [label="아미트립틸린 → 노르트립틸린\nCYP2D6 다형성"];
        NAC_PK       [label="N-아세틸시스테인 경구/DMSO 국소\n(자유라디칼 소거)"];
        LIDO_PK      [label="리도카인 IV (Nav 차단, 단기)"];
        VitC_PK      [label="비타민 C 500mg/일 (예방, 골절 후)"];
        IVIG_PK      [label="IVIG PK (t1/2 ~3-4주, IgG 풀 희석)"];
    }

    /* ===================================================================
       18. 약물 PD (표적 결합)
       =================================================================== */
    subgraph cluster_pd {
        label="18. 약물 PD 및 표적 (Pharmacodynamics & Targets)";
        style=filled; color="#cfe0ee"; node [fillcolor="#7ba7cf"];
        KET_PD       [label="케타민 → NMDA 개방채널 차단\n(척수 wind-up 리셋)"];
        PRED_PD      [label="글루코코르티코이드 → NF-κB 억제\n(조기 온난형에서 효과 집중)"];
        NER_PD       [label="비스포스포네이트 → 파골세포 FPPS 억제\n(+ 골 산증/노시셉터 입력 감소)"];
        GBP_PD       [label="가바펜티노이드 → α2δ-1 결합\n(전시냅스 Ca2+ 유입↓)"];
        AMT_PD       [label="TCA → NE/5-HT 재흡수 억제\n(하행 억제 톤 회복)"];
        NAC_PD       [label="항산화 → ROS/•OH 소거\n(한랭형 표적)"];
        IVIG_PD      [label="IVIG → 자가항체 중화/FcRn 경쟁"];
        SympBlock_PD [label="교감신경 차단 → α1 구동 차단\n(반응은 아형 의존적, 단기)"];
        Rehab_PD     [label="재활/GMI → 사용 의존적 피질 재지도화\n(느린 상태 변수를 직접 되돌림)"];
        NSAID_PD     [label="NSAID / COX-2 억제 (제한적 효과)"];
    }

    /* ===================================================================
       19. 중재 / 신경조절
       =================================================================== */
    subgraph cluster_intervention {
        label="19. 중재적 치료 · 신경조절 (Interventional & Neuromodulation)";
        style=filled; color="#efe1d1"; node [fillcolor="#dcb98c"];
        SCS          [label="척수자극(SCS) — Kemler NEJM 2000 양성\n5년 추적 시 효과 감쇠"];
        DRG_stim     [label="DRG 자극 — ACCURATE RCT (2017)\nSCS 대비 우월(하지 CRPS)"];
        SympBlockInt [label="교감신경 차단/절제술"];
        ITB_Int      [label="척수강내 약물 주입"];
        Amputation   [label="절단 (극단적 불응·감염 사례)"];
        MultiDisc    [label="다학제 재활 프로그램 (표준 골격)"];
        Ketamine_inf [label="케타민 입원 지속주입 프로토콜\n(Sigtermans 2009: 100시간)"];
    }

    /* ===================================================================
       20. 임상 엔드포인트 · 자연경과
       =================================================================== */
    subgraph cluster_endpoint {
        label="20. 임상 엔드포인트 · 자연경과 (Clinical Endpoints & Natural History)";
        style=filled; color="#e2e2e2"; node [fillcolor="#bdbdbd"];
        Budapest     [label="Budapest(IASP) 진단 기준\n감각·혈관운동·발한/부종·운동/영양 4범주"];
        NRS_pain     [label="통증 NRS 0-10 (일차 결과)"];
        CSS_score    [label="CRPS Severity Score (CSS 0-16)"];
        ROM_end      [label="ROM · 악력 · 기능(DASH/PSFS)"];
        Edema_end    [label="부종 용적 (수용적 측정)"];
        TempAsym_end [label="온도 비대칭 (°C)"];
        QoL_end      [label="삶의 질 (EQ-5D, SF-36)"];
        WorkStatus   [label="직업 복귀 · 장애 등급"];
        Remission    [label="관해율 (1차 의료 코호트: 1년 내 다수 개선)"];
        Chronic      [label="만성 지속 (3차 의료 코호트:\n수년 지속 · 확산 · 이상운동증)"];
        Recurrence   [label="재발 / 대측 확산"];
        Window       [label="치료 창(therapeutic window)\n조기 개입 시 가역, 지연 시 준-비가역"];
    }

    /* ===================================================================
       EDGES — 유발 → 말초
       =================================================================== */
    Fracture -> TissueInjury;
    Surgery -> TissueInjury;
    MinorTrauma -> TissueInjury;
    Immobil -> DisuseState [color="#c2185b", penwidth=2, label="부동 자체가 루프 진입"];
    Sex_age -> TissueInjury [style=dashed, label="감수성"];
    Genetics -> IL1b [style=dashed, label="사이토카인 반응성"];
    Baseline_pain -> SpinalSens [style=dashed, color="#c2185b", label="최강 예측인자"];
    ACEi_use -> SubP [style=dashed, label="펩티드 분해 ↓"];
    Psych_pre -> Catastroph [style=dashed];
    Migraine_hx -> CGRP_pep [style=dashed];

    TissueInjury -> CRPS_I;
    TissueInjury -> CRPS_II;
    CRPS_II -> NerveSprout;
    CRPS_I -> SmallFiber;
    CRPS_II -> SmallFiber;
    TissueInjury -> TLR4_act;
    TLR4_act -> NFkB;
    SmallFiber -> Cfiber;
    NerveSprout -> PeriphSensNode;

    /* 신경성 염증 내부 */
    Cfiber -> SubP;
    Cfiber -> CGRP_pep;
    Cfiber -> NKA;
    SubP -> PlasmaExtrav;
    SubP -> MastCell;
    CGRP_pep -> Vasodil_neuro;
    NKA -> PlasmaExtrav;
    PlasmaExtrav -> Edema;
    Vasodil_neuro -> WarmPhase;
    Edema -> ROM_loss;
    MastCell -> NGF_node;
    Keratinocyte -> IL6;
    Keratinocyte -> TNFa;
    TissueInjury -> Keratinocyte;
    BK_node -> Cfiber;
    TissueInjury -> BK_node;
    PGE2_node -> PeriphSensNode;
    IL1b -> PGE2_node;
    NGF_node -> TRPV1;
    NGF_node -> Nav17_18;
    NGF_node -> Cfiber [label="양성 피드백"];

    /* 사이토카인 */
    NFkB -> IL1b;
    NFkB -> IL6;
    NFkB -> TNFa;
    NFkB -> IL8;
    IL1b -> PeriphSensNode;
    IL6 -> PeriphSensNode;
    TNFa -> PeriphSensNode;
    TNFa -> Osteoclast;
    IL6 -> Osteoclast;
    IL8 -> Monocyte;
    Monocyte -> TNFa;
    IL10_low -> NFkB [label="억제 소실"];
    Complement -> MastCell;
    TNFa -> SolubleTNFR;
    MastCell -> TNFa;

    /* 자가면역 */
    Bcell -> B2AR_Ab;
    Bcell -> M2_Ab;
    Bcell -> AT1R_Ab;
    B2AR_Ab -> AutoAgTarget;
    M2_Ab -> AutoAgTarget;
    AT1R_Ab -> AutoAgTarget;
    AutoAgTarget -> PeriphSensNode;
    AutoAgTarget -> EndoDys;
    AutoAgTarget -> PassiveTrans [style=dashed, label="인과성 증거"];
    TissueInjury -> Bcell [style=dashed, label="자가항원 노출"];
    IVIG_node -> AutoAgTarget [color="#1565c0", arrowhead=tee, label="중화"];
    Rituximab_n -> Bcell [color="#1565c0", arrowhead=tee];

    /* 산화 스트레스 */
    IL1b -> ROS_node;
    TNFa -> ROS_node;
    Hypoxia -> ROS_node;
    ROS_node -> OH_radical;
    ROS_node -> ONOO;
    NO_low -> ONOO [style=dashed];
    OH_radical -> LipidPerox;
    ONOO -> LipidPerox;
    ONOO -> EndoDys;
    LipidPerox -> PeriphSensNode;
    Antiox_low -> ROS_node;
    ROS_node -> Mito_dys;
    Mito_dys -> Lactate;

    /* 교감신경 */
    SympOutflow -> NE_local;
    NE_local -> Alpha1_up [style=dashed, label="탈신경 초민감성"];
    Alpha1_up -> PeriphSensNode [color="#c2185b", penwidth=2];
    SympSprout -> DRG_node;
    DRG_node -> PeriphSensNode;
    NGF_node -> SympSprout;
    Alpha1_up -> AdrenSens;
    CatecholSupers -> AdrenSens;
    NE_local -> CatecholSupers;
    SympBlock -> NE_local [color="#1565c0", arrowhead=tee];
    SympOutflow -> ColdPhase [label="후기 혈관수축"];
    Alpha1_up -> EndoDys;

    /* 혈관/저산소 */
    EndoDys -> NO_low;
    EndoDys -> ET1_high;
    ET1_high -> ColdPhase;
    NO_low -> ColdPhase;
    Shunt -> Hypoxia;
    EndoDys -> Shunt;
    Hypoxia -> Lactate;
    Lactate -> ASIC3;
    ASIC3 -> PeriphSensNode;
    WarmPhase -> TempAsym;
    ColdPhase -> TempAsym;
    TempAsym -> TempAsym_end;
    LaserDoppler -> TempAsym [style=dotted, label="측정"];
    WarmPhase -> ColdPhase [color="#6a1b9a", penwidth=2, label="시간 경과에 따른 표현형 전환"];
    Tadalafil_n -> NO_low [color="#1565c0", arrowhead=tee, label="cGMP↑"];
    Hypoxia -> BoneMarrow;

    /* 말초 감작 → 척수 */
    TRPV1 -> PeriphSensNode;
    TRPA1 -> ColdAllod;
    TRPA1 -> PeriphSensNode;
    Nav17_18 -> PeriphSensNode;
    P2X3 -> PeriphSensNode;
    PeriphSensNode -> MechAllod;
    PeriphSensNode -> Glutamate [color="#6a1b9a", penwidth=2];

    /* 척수 */
    Glutamate -> NMDA_NR2B;
    Glutamate -> AMPA_traf;
    NMDA_NR2B -> WindUp;
    AMPA_traf -> WindUp;
    NMDA_NR2B -> PKC_ERK;
    PKC_ERK -> SpinalSens;
    WindUp -> SpinalSens;
    WDR -> SpinalSens;
    NMDA_NR2B -> WDR;
    Disinhib -> SpinalSens;
    Dynorphin -> SpinalSens;
    SpinalSens -> SpreadPain;
    SpinalSens -> MechAllod;
    SpinalSens -> NRS_pain [color="#c2185b", penwidth=2];

    /* 교세포 */
    Microglia -> BDNF_TrkB;
    BDNF_TrkB -> Disinhib;
    Microglia -> SpinalTNF;
    Astrocyte -> SpinalTNF;
    CCL2 -> Microglia;
    Glutamate -> CCL2;
    Astrocyte -> Glutamate [label="GLT-1↓ 재흡수 실패"];
    Microglia -> GliaState;
    Astrocyte -> GliaState;
    GliaState -> SpinalSens [color="#6a1b9a", penwidth=2, label="느린 시상수"];
    SpinalTNF -> SpinalSens;

    /* 하행 조절 */
    SpinalSens -> PAG_RVM [style=dashed, label="상행 구동"];
    PAG_RVM -> OnCells;
    PAG_RVM -> OffCells;
    OnCells -> SpinalSens [label="촉진"];
    OffCells -> DescInhib;
    LC_NE -> DescInhib;
    Serotonin_5HT -> DescInhib;
    DescInhib -> SpinalSens [arrowhead=tee, label="억제"];
    DNIC_loss -> DescInhib [arrowhead=tee];
    SpinalSens -> DNIC_loss [style=dashed, label="악순환"];
    Prefrontal -> PAG_RVM;
    Catastroph -> Prefrontal;

    /* 피질 재구성 */
    SpinalSens -> S1_shrink [color="#6a1b9a"];
    DisuseState -> S1_shrink [color="#c2185b", penwidth=2, label="사용 의존적 열화"];
    S1_shrink -> TwoPoint;
    S1_shrink -> BPD;
    S1_shrink -> CorticalState;
    M1_reorg -> Dystonia;
    S1_shrink -> M1_reorg;
    BPD -> NeglectLike;
    NeglectLike -> Avoidance;
    Laterality -> CorticalState [style=dotted, label="측정"];
    CorticalState -> NRS_pain [color="#c2185b", penwidth=2];
    CorticalState -> BPD;
    GMI -> CorticalState [color="#1565c0", arrowhead=tee, penwidth=2, label="재지도화"];
    MirrorTx -> CorticalState [color="#1565c0", arrowhead=tee];
    GMI -> MirrorTx [style=dotted];

    /* 골 */
    RANKL_OPG -> Osteoclast;
    CGRP_pep -> RANKL_OPG;
    SubP -> RANKL_OPG;
    DisuseState -> RANKL_OPG [color="#c2185b", penwidth=2, label="기계적 자극 소실"];
    Osteoclast -> CTX_marker;
    Osteoclast -> BMD_loss;
    BMD_loss -> PatchyOP;
    Osteoclast -> BoneAcidLink;
    BoneAcidLink -> PeriphSensNode [color="#6a1b9a", label="골내 노시셉터"];
    BoneScan -> Osteoclast [style=dotted, label="측정"];
    BoneMarrow -> Osteoclast;
    Neridronate -> Osteoclast [color="#1565c0", arrowhead=tee, penwidth=2];
    Pamidronate -> Osteoclast [color="#1565c0", arrowhead=tee];
    Alendronate -> Osteoclast [color="#1565c0", arrowhead=tee];

    /* 운동/영양 */
    SpinalSens -> Weakness;
    Dystonia -> ROM_loss;
    TremorMyo -> ROM_loss;
    Weakness -> ROM_loss;
    ROM_loss -> Contracture;
    Contracture -> DisuseState;
    ROM_loss -> ROM_end;
    TrophicSkin -> Budapest;
    Hypoxia -> TrophicSkin;
    BoNT_A -> Dystonia [color="#1565c0", arrowhead=tee];
    ITB -> Dystonia [color="#1565c0", arrowhead=tee];
    PT_node -> DisuseState [color="#1565c0", arrowhead=tee, penwidth=2];
    PT_node -> ROM_loss [color="#1565c0", arrowhead=tee];

    /* 심리-행동 루프 (핵심 양성 피드백) */
    NRS_pain -> Catastroph [color="#c2185b", penwidth=2];
    Catastroph -> Kinesio;
    Kinesio -> Avoidance;
    Avoidance -> DisuseState [color="#c2185b", penwidth=2];
    DisuseState -> DeconditionM;
    DisuseState -> NRS_pain [color="#c2185b", penwidth=2, label="루프 폐합 (양성 피드백)"];
    DepAnx -> Catastroph;
    NRS_pain -> DepAnx;
    CBT_GE -> Kinesio [color="#1565c0", arrowhead=tee, penwidth=2];
    CBT_GE -> SelfEfficacy;
    SelfEfficacy -> Avoidance [arrowhead=tee];
    DisuseState -> Hypoxia [style=dashed, label="근육 탈조건화"];

    /* PK → PD */
    KET_PK -> NORKET_PK;
    KET_PK -> KET_PD;
    NORKET_PK -> KET_PD [style=dashed, label="기여 소"];
    PRED_PK -> PRED_PD;
    NER_PK -> NER_PD;
    GBP_PK -> GBP_PD;
    AMT_PK -> AMT_PD;
    NAC_PK -> NAC_PD;
    LIDO_PK -> Nav17_18 [color="#1565c0", arrowhead=tee];
    VitC_PK -> ROS_node [color="#1565c0", arrowhead=tee, label="골절 후 예방"];
    IVIG_PK -> IVIG_PD;
    IVIG_PD -> IVIG_node;
    Ketamine_inf -> KET_PK;

    /* PD → 표적 */
    KET_PD -> NMDA_NR2B [color="#1565c0", arrowhead=tee, penwidth=2];
    KET_PD -> GliaState [color="#1565c0", arrowhead=tee, style=dashed];
    PRED_PD -> NFkB [color="#1565c0", arrowhead=tee, penwidth=2];
    PRED_PD -> PlasmaExtrav [color="#1565c0", arrowhead=tee];
    NER_PD -> Osteoclast [color="#1565c0", arrowhead=tee];
    NER_PD -> Neridronate [style=dotted];
    GBP_PD -> Glutamate [color="#1565c0", arrowhead=tee];
    AMT_PD -> DescInhib [color="#1565c0", penwidth=2, label="톤 회복"];
    NAC_PD -> ROS_node [color="#1565c0", arrowhead=tee];
    NSAID_PD -> PGE2_node [color="#1565c0", arrowhead=tee];
    SympBlock_PD -> Alpha1_up [color="#1565c0", arrowhead=tee];
    SympBlock -> SympBlock_PD [style=dotted];
    Rehab_PD -> CorticalState [color="#1565c0", arrowhead=tee, penwidth=2];
    Rehab_PD -> DisuseState [color="#1565c0", arrowhead=tee, penwidth=2];
    GMI -> Rehab_PD [style=dotted];
    PT_node -> Rehab_PD [style=dotted];

    /* 중재 */
    SCS -> SpinalSens [color="#1565c0", arrowhead=tee, label="분절 억제 (효과 감쇠)"];
    DRG_stim -> DRG_node [color="#1565c0", arrowhead=tee];
    SympBlockInt -> SympBlock [style=dotted];
    ITB_Int -> ITB [style=dotted];
    MultiDisc -> PT_node [style=dotted];
    MultiDisc -> CBT_GE [style=dotted];
    Amputation -> Chronic [style=dashed, label="최후 수단"];

    /* 엔드포인트 */
    NRS_pain -> CSS_score;
    Edema -> Edema_end;
    Edema_end -> CSS_score;
    TempAsym_end -> CSS_score;
    ROM_end -> CSS_score;
    Budapest -> CSS_score [style=dotted];
    CSS_score -> QoL_end;
    NRS_pain -> QoL_end;
    ROM_end -> WorkStatus;
    QoL_end -> WorkStatus;
    CSS_score -> Remission;
    CSS_score -> Chronic;
    CorticalState -> Chronic [color="#6a1b9a", penwidth=2, label="준-비가역 축"];
    DisuseState -> Chronic [color="#6a1b9a", penwidth=2];
    GliaState -> Chronic [color="#6a1b9a"];
    Remission -> Recurrence [style=dashed];
    Window -> Remission [color="#2e7d32", penwidth=2, label="조기 개입"];
    Window -> Chronic [color="#b71c1c", penwidth=2, label="지연 개입"];
    PRED_PD -> Window [style=dashed, color="#2e7d32", label="조기 전용 효과"];
    Rehab_PD -> Window [style=dashed, color="#2e7d32", label="지연에도 루프를 직접 겨냥"];
    Neridronate -> Window [style=dashed, color="#2e7d32", label="발병 <6-12개월에서 효과"];
}
