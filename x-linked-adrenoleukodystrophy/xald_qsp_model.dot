/* ============================================================================
   X-linked Adrenoleukodystrophy (X-ALD) — QSP mechanistic map
   X-연관 부신백질형성장애 · 기계론적 지도

   ORGANISING THESIS (조직 원리)
   -----------------------------------------------------------------------------
   One lesion (ABCD1 loss) -> TWO INDEPENDENT VARIABLES:

     (1) VLCFA accumulation      : deterministic, dose-graded, MEASURABLE,
                                   and reachable from the periphery.
     (2) Cerebral inflammation   : BISTABLE (a switch, not a rate),
                                   UNMEASURABLE until MRI, and reachable
                                   ONLY from inside the CNS.

   The coupling (1) -> (2) is drawn as a THRESHOLD gated by a stochastic
   susceptibility term, not as a rate constant.  That single structural
   choice is why:

     * plasma C26:0 does not predict phenotype (brothers, identical
       mutation, CCALD at 6 vs pure AMN at 40);
     * Lorenzo's oil normalises the biomarker and does not stop the disease
       (it cannot cross the BBB and it does not touch variable 2);
     * HSCT / eli-cel stops the disease and barely moves the biomarker
       (it replaces microglia, i.e. variable 2, and does not touch 1);
     * the ~12-18 month post-transplant "lag window" exists at all
       (microglial replacement is slow; the switch keeps running).

   THE DRUG THAT FIXES THE BIOMARKER DOES NOT FIX THE DISEASE, AND THE DRUG
   THAT FIXES THE DISEASE DOES NOT FIX THE BIOMARKER.

   Nodes 169 · Edges 265 · Clusters 19 (18 mechanism + 1 legend)
   Render:  dot -Tsvg xald_qsp_model.dot -o xald_qsp_model.svg
            dot -Tpng -Gdpi=150 xald_qsp_model.dot -o xald_qsp_model.png
   ========================================================================== */

digraph XALD_QSP {
    graph [rankdir=TB, splines=spline, overlap=false, nodesep=0.28,
           ranksep=0.55, compound=true, concentrate=false,
           fontname="NanumGothic", fontsize=13, labelloc="t",
           bgcolor="white", pad=0.4,
           label=<<b>X-연관 부신백질형성장애 (X-ALD) — 정량적 시스템 약리학 지도</b><br/>
<i>X-linked Adrenoleukodystrophy · Quantitative Systems Pharmacology map</i><br/>
<font point-size="11">하나의 병변(ABCD1 소실), 두 개의 독립 변수 — 측정 가능한 VLCFA 축적(주변부에서 도달 가능) vs 측정 불가능한 이중안정 뇌염증 스위치(CNS 내부에서만 도달 가능)</font><br/>
<font point-size="10">169 nodes · 265 edges · 18 mechanism clusters</font>>];

    node [shape=box, style="rounded,filled", fontname="NanumGothic",
          fontsize=10, margin="0.10,0.055", penwidth=1.0, color="#555555"];
    edge [fontname="NanumGothic", fontsize=8, arrowsize=0.65,
          color="#666666", penwidth=1.0];

    /* ---------- edge semantics legend --------------------------------- */
    subgraph cluster_legend {
        label=<<b>범례 (Legend)</b>>;
        style="rounded,filled"; fillcolor="#fafafa"; color="#bbbbbb";
        fontsize=11;
        node [shape=plaintext, style="", fillcolor="none", fontsize=9];
        LEG [label=<<table border="0" cellborder="0" cellspacing="1">
<tr><td align="left"><font color="#1a7f37">━━▶</font></td><td align="left">활성화 / 촉진 (activation)</td></tr>
<tr><td align="left"><font color="#c0392b">━━⊣</font></td><td align="left">억제 / 차단 (inhibition)</td></tr>
<tr><td align="left"><font color="#8e44ad">┅┅▶</font></td><td align="left">약물 작용 (drug action)</td></tr>
<tr><td align="left"><font color="#e67e22">━━▶</font></td><td align="left">임상 판독값 (clinical readout)</td></tr>
<tr><td align="left"><font color="#2471a3">━━▶</font></td><td align="left">질량 흐름 / 수송 (mass flux)</td></tr>
<tr><td align="left"><b>굵은 테두리</b></td><td align="left">ODE 상태변수 (state variable)</td></tr>
</table>>];
    }

    /* ================================================================== *
     * 1. 유전자 · 전사 · 벡터                                             *
     * ================================================================== */
    subgraph cluster_gene {
        label=<<b>1. ABCD1 유전자 · 상동체 중복성 · 유전자치료 벡터</b><br/><i>Gene, paralogue redundancy, vector</i>>;
        style="rounded,filled"; fillcolor="#eef4fb"; color="#7fa8d4"; fontsize=11;
        node [fillcolor="#d6e6f7"];

        ABCD1     [label="ABCD1 유전자 (Xq28)\nABCD1 locus"];
        MUT       [label="병원성 변이 900+ 종\nmissense·nonsense·frameshift·del"];
        ALDP      [label="ALDP 반수송체\n(ABCD1 단백, 이량체)", penwidth=2.2];
        ALDPD     [label="ALDP 기능 소실\n(불안정·미스폴딩·부재)", penwidth=2.2, fillcolor="#f7d6d6"];
        ABCD2     [label="ABCD2 / ALDRP\n상동체 — 부분 중복 기능", penwidth=2.2];
        ABCD3     [label="ABCD3 / PMP70"];
        PEXMEM    [label="퍼옥시좀 막 온전성\nperoxisome membrane"];
        LENTID    [label="Lenti-D 렌티바이러스\nABCD1 cDNA 벡터"];
        VCN       [label="벡터 카피수 VCN\n(copies/genome)", penwidth=2.2];
        XINACT    [label="X 불활성화 편향\nskewed X-inactivation"];
        MOSAIC    [label="ALDP 결핍 세포 분율\n(여성 보유자 모자이크)", penwidth=2.2];
        CROSSC    [label="세포 간 대사 상보\nmetabolic cross-correction"];
    }

    /* ================================================================== *
     * 2. 퍼옥시좀 β-산화 vs 미세소체 신장 — 질량 균형                      *
     * ================================================================== */
    subgraph cluster_perox {
        label=<<b>2. VLCFA 질량 균형 — 퍼옥시좀 분해 vs ELOVL1 신장</b><br/><i>Peroxisomal degradation vs microsomal elongation</i>>;
        style="rounded,filled"; fillcolor="#eefbf3"; color="#63b98a"; fontsize=11;
        node [fillcolor="#d3f0e0"];

        DIET      [label="식이 VLCFA 유입\n(전체의 약 20%)"];
        DENOVO    [label="내인성 신생 신장\n(약 80% — 지배적 유입)"];
        ELOVL1    [label="ELOVL1 신장효소\nC22:0→C24:0→C26:0", penwidth=2.2];
        ELONG     [label="신장 flux (elongation)", penwidth=2.2];
        ACSVL1    [label="ACSVL1 / SLC27A2\nVLCFA→VLCFA-CoA 활성화"];
        VLCFACOA  [label="VLCFA-CoA 세포질 풀\nC24:0/C26:0-CoA", penwidth=2.2];
        IMPORT    [label="퍼옥시좀 내 수송\n(ALDP 절대 의존 단계)", penwidth=2.2, fillcolor="#f9e5c4"];
        ACOX1     [label="ACOX1 아실-CoA 산화효소"];
        DBP       [label="D-이중기능 단백 (HSD17B4)"];
        SCPX      [label="SCPx 티올분해효소"];
        BETAOX    [label="퍼옥시좀 β-산화 flux", penwidth=2.2];
        SREBP     [label="SREBP / 지질생성 전사조절"];
    }

    /* ================================================================== *
     * 3. VLCFA 조직 분포 · 지질종                                          *
     * ================================================================== */
    subgraph cluster_lipid {
        label=<<b>3. VLCFA 조직 축적과 지질종 (lipidome)</b><br/><i>Tissue distribution and lipid species</i>>;
        style="rounded,filled"; fillcolor="#fdf6e9"; color="#d9a94c"; fontsize=11;
        node [fillcolor="#faeaca"];

        C26PL     [label="혈장 C26:0\n정상 0.35 → ALD 1.3 μmol/L", penwidth=2.2, fillcolor="#f6d98a"];
        C26LPC    [label="C26:0-lysoPC\n(DBS 선별 표지자, 약 10배)", penwidth=2.2, fillcolor="#f6d98a"];
        C24C22    [label="C24:0/C22:0 비\n(진단 보조 지표)"];
        C26CE     [label="콜레스테롤 에스터-C26:0\n(부신·뇌 저장 형태)", penwidth=2.2];
        C26GANG   [label="강글리오사이드-C26:0"];
        C26PC     [label="막 인지질-C26:0\n(PC/PE 아실 사슬)", penwidth=2.2];
        C26ADR    [label="부신피질 VLCFA", penwidth=2.2];
        C26BR     [label="뇌 백질 VLCFA", penwidth=2.2];
        C26SC     [label="척수 백질 VLCFA", penwidth=2.2];
        C26TEST   [label="고환 VLCFA"];
        MEMB      [label="막 유동성 저하\n미세도메인(raft) 붕괴", penwidth=2.2];
        LAMEL     [label="판상 세포질 봉입체\nlamellar inclusions"];
    }

    /* ================================================================== *
     * 4. 세포 스트레스 — 산화 · 미토콘드리아 · 자가포식                     *
     * ================================================================== */
    subgraph cluster_stress {
        label=<<b>4. 세포 스트레스 — 미토콘드리아 · ROS · 자가포식 · Nrf2</b><br/><i>Redox and organelle stress</i>>;
        style="rounded,filled"; fillcolor="#fdeeee"; color="#d98080"; fontsize=11;
        node [fillcolor="#f9d8d8"];

        MITO      [label="미토콘드리아 막전위 탈분극", penwidth=2.2];
        NOX       [label="NADPH 산화효소 (NOX2)"];
        ROS       [label="ROS / 산화 스트레스", penwidth=2.2];
        OXPROT    [label="산화 단백·8-OHdG\n(전임상 단계에서 이미 상승)"];
        CA        [label="세포내 Ca²⁺ 항상성 붕괴", penwidth=2.2];
        ER        [label="ER 스트레스 / UPR"];
        AUTOPH    [label="자가포식 흐름 차단\n(autophagy block)", penwidth=2.2];
        NRF2      [label="Nrf2-ARE 항산화 반응\n(X-ALD에서 감쇠)", penwidth=2.2];
        SIRT1     [label="SIRT1 / PGC-1α\n미토콘드리아 생합성"];
        ATPX      [label="축삭 ATP 결핍", penwidth=2.2];
    }

    /* ================================================================== *
     * 5. 부신피질 축 — 세 번째 독립 축                                     *
     * ================================================================== */
    subgraph cluster_adrenal {
        label=<<b>5. 부신피질 축 — CNS와 완전히 독립된 세 번째 축</b><br/><i>Adrenocortical axis: an independent third axis</i>>;
        style="rounded,filled"; fillcolor="#f3eefb"; color="#9b7fd4"; fontsize=11;
        node [fillcolor="#e2d6f7"];

        CRH       [label="시상하부 CRH"];
        ACTHP     [label="뇌하수체 ACTH", penwidth=2.2, fillcolor="#cfc0f0"];
        MC2R      [label="MC2R / MRAP 수용체\n(막 미세도메인 의존)", penwidth=2.2];
        STAR      [label="StAR 콜레스테롤 수송"];
        STEROID   [label="스테로이드 생성 flux", penwidth=2.2];
        ADMASS    [label="기능성 부신피질 질량", penwidth=2.2, fillcolor="#cfc0f0"];
        CORT      [label="코르티솔", penwidth=2.2, fillcolor="#cfc0f0"];
        ALDOS     [label="알도스테론", penwidth=2.2];
        RENIN     [label="레닌-안지오텐신 반응성 상승", penwidth=2.2];
        NAK       [label="Na⁺ 소실 · K⁺ 상승\n저혈압 · 탈수"];
        MSH       [label="POMC / α-MSH\n→ 피부·점막 색소침착"];
        ADCRISIS  [label="부신 위기 (adrenal crisis)\n— 첫 증상인 경우 다수", fillcolor="#f5b7b1"];
        ACTHTESTR [label="ACTH 자극 최대 코르티솔\n< 500 nmol/L = 부신부족"];
    }

    /* ================================================================== *
     * 6. 고환 · 기타 내분비                                                *
     * ================================================================== */
    subgraph cluster_gonad {
        label=<<b>6. 고환 축</b><br/><i>Testicular axis</i>>;
        style="rounded,filled"; fillcolor="#f3eefb"; color="#9b7fd4"; fontsize=11;
        node [fillcolor="#e8dff8"];

        LEYDIG    [label="라이디히 세포 기능", penwidth=2.2];
        LH        [label="LH 상승 (보상)"];
        TESTO     [label="테스토스테론", penwidth=2.2];
        HYPOG     [label="성기능 저하 · 발기부전"];
        SPERM     [label="정자형성 장애"];
    }

    /* ================================================================== *
     * 7. 미세아교세포 — 스위치의 방아쇠                                     *
     * ================================================================== */
    subgraph cluster_mgl {
        label=<<b>7. 미세아교세포 — 탈수초보다 먼저 죽는다 (병변 전 사건)</b><br/><i>Microglia: apoptosis PRECEDES demyelination</i>>;
        style="rounded,filled"; fillcolor="#eaf6f8"; color="#5aa9b8"; fontsize=11;
        node [fillcolor="#cfeaf0"];

        MGL       [label="ALDP 결핍 상주 미세아교세포", penwidth=2.2, fillcolor="#aadbe6"];
        TREM2     [label="TREM2 / 지질 감지 신호"];
        MGLPHAG   [label="수초 잔해 포식 능력", penwidth=2.2];
        MGLAP     [label="미세아교세포 세포자멸사\n(병변 전 단계, pre-lesional)", penwidth=2.2, fillcolor="#f5b7b1"];
        MGLDEP    [label="병변 주변부 미세아교세포 고갈\nperi-lesional depletion", penwidth=2.2];
        MGLPRO    [label="전염증 표현형 전환\n(pro-inflammatory switch)", penwidth=2.2];
        DEBRIS    [label="처리되지 않은 수초 잔해 축적", penwidth=2.2];
    }

    /* ================================================================== *
     * 8. 신경염증 자기증폭 루프 — 이중안정 코어                             *
     * ================================================================== */
    subgraph cluster_inflam {
        label=<<b>8. 자기증폭 신경염증 루프 — 이중안정 스위치의 실체</b><br/><i>Self-amplifying loop = the bistable core</i>>;
        style="rounded,filled"; fillcolor="#fdecec"; color="#cc5555"; fontsize=11;
        node [fillcolor="#fad4d4"];

        TNFA      [label="TNF-α", penwidth=2.2];
        IL1B      [label="IL-1β", penwidth=2.2];
        MCP1      [label="CCL2 / MCP-1", penwidth=2.2];
        IFNG      [label="IFN-γ"];
        INOS      [label="iNOS / NO·과산화아질산"];
        MONOIN    [label="말초 단핵구 침윤", penwidth=2.2];
        CD8T      [label="CD8⁺ 세포독성 T 침윤", penwidth=2.2];
        PERF      [label="퍼포린 / 그랜자임 세포독성"];
        MMP9      [label="MMP-9 (기저막 분해)"];
        COMPL     [label="보체 활성 (C3d/C9)"];
        ASTRO     [label="반응성 성상교세포", penwidth=2.2];
        LOOP      [label="◆ 자기증폭 루프 이득 (loop gain)\nG > 1 이면 되돌릴 수 없다",
                   shape=octagon, penwidth=3.0, fillcolor="#e74c3c", fontcolor="white"];
    }

    /* ================================================================== *
     * 9. 혈액뇌장벽                                                        *
     * ================================================================== */
    subgraph cluster_bbb {
        label=<<b>9. 혈액뇌장벽 — 약물이 넘지 못하는 선</b><br/><i>The line most drugs cannot cross</i>>;
        style="rounded,filled"; fillcolor="#eef0fb"; color="#7f88d4"; fontsize=11;
        node [fillcolor="#d8dcf7"];

        TJ        [label="밀착연접 (claudin-5·occludin)", penwidth=2.2];
        BBBP      [label="BBB 투과성", penwidth=2.2, fillcolor="#c2c8f0"];
        VEGF      [label="VEGF / 혈관 투과 인자"];
        GDENH     [label="가돌리늄 조영증강\n(활성 병변의 유일한 생체 표지)", penwidth=2.2, fillcolor="#f6d98a"];
        PERIV     [label="혈관주위 림프구 침윤 (cuffing)"];
    }

    /* ================================================================== *
     * 10. 수초 · 축삭 (대뇌)                                               *
     * ================================================================== */
    subgraph cluster_myelin {
        label=<<b>10. 대뇌 수초 · 축삭 — Schaumburg 3구역 병변</b><br/><i>Cerebral myelin and axons</i>>;
        style="rounded,filled"; fillcolor="#f0f0f0"; color="#888888"; fontsize=11;
        node [fillcolor="#e0e0e0"];

        OLG       [label="희소교세포 풀", penwidth=2.2];
        OLGAP     [label="희소교세포 사멸", penwidth=2.2];
        MYE       [label="대뇌 수초량", penwidth=2.2, fillcolor="#cccccc"];
        DEMY      [label="탈수초 부피", penwidth=2.2, fillcolor="#cccccc"];
        ZONE      [label="3구역 구조\n중심 반흔 / 활성 염증 / 외곽 탈수초"];
        SPLENIUM  [label="뇌량 팽대부 (splenium)\n— 병변 시작점 (80%)"];
        FRONTAL   [label="전두엽 우세 아형 (약 15%)"];
        AXBR      [label="대뇌 축삭 완전성", penwidth=2.2];
        GLIOSIS   [label="교세포 반흔 (gliosis)", penwidth=2.2];
    }

    /* ================================================================== *
     * 11. 척수 축삭병증 (AMN)                                              *
     * ================================================================== */
    subgraph cluster_cord {
        label=<<b>11. 척수 축삭병증 (AMN) — 길이 의존적 dying-back</b><br/><i>Adrenomyeloneuropathy: length-dependent axonopathy</i>>;
        style="rounded,filled";
        fillcolor="#eef8ee"; color="#77b877"; fontsize=11;
        node [fillcolor="#d5edd5"];

        CST       [label="피질척수로 (corticospinal)", penwidth=2.2];
        DC        [label="후주 (dorsal column)", penwidth=2.2];
        LENGTH    [label="길이 의존적 취약성\n(가장 긴 축삭이 먼저)"];
        DISTAX    [label="원위부 축삭 변성 (dying-back)", penwidth=2.2];
        MYESC     [label="척수 수초 (2차적 소실)", penwidth=2.2];
        SPAST     [label="경직 · 보행장애"];
        BLADDER   [label="배뇨 · 배변 장애"];
        PERIPH    [label="말초신경 침범 (경증)"];
    }

    /* ================================================================== *
     * 12. 표현형 결정 — 왜 형제가 다른 병에 걸리는가                        *
     * ================================================================== */
    subgraph cluster_pheno {
        label=<<b>12. 표현형 결정 — 같은 변이, 다른 병 (모델의 핵심 주장)</b><br/><i>Phenotype determination: same mutation, different disease</i>>;
        style="rounded,filled"; fillcolor="#fff4e6"; color="#e08a2e"; fontsize=11;
        node [fillcolor="#ffe0b8"];

        SWITCH    [label="◆ 뇌형 전환 스위치 (threshold)\nVLCFA는 필요조건, 충분조건이 아니다",
                   shape=doubleoctagon, penwidth=3.0, fillcolor="#e67e22", fontcolor="white"];
        SUSC      [label="감수성 계수 (susceptibility)\n수정유전자 + 환경 + 확률", penwidth=2.2, fillcolor="#ffd08a"];
        MODGEN    [label="수정 유전자 후보\n(면역·산화·지질 경로)"];
        HEADTR    [label="두부 외상 · 감염\n(전환 촉발 보고)"];
        CONCORD   [label="일란성 쌍둥이 불일치\n= 유전자만으로 결정되지 않는다"];
        NOCORR    [label="◆ 혈장 C26:0 ↔ 표현형 무상관\n(이 질환 최대의 음성 결과)",
                   shape=note, penwidth=2.4, fillcolor="#fdebd0"];
        CCALD     [label="소아 뇌형 (CCALD)\n약 35-40%, 4-8세 발병", penwidth=2.2, fillcolor="#f5b7b1"];
        AMN       [label="AMN (성인 척수형)\n20-40대, 수십 년 경과", penwidth=2.2];
        AMNCONV   [label="AMN → 뇌형 전환\n성인 AMN의 약 20%", penwidth=2.2, fillcolor="#f5b7b1"];
        ADDIONLY  [label="애디슨 단독형\n(소아기 첫 표현형)"];
        FEMALE    [label="여성 보유자 척수형\n60세까지 약 80%", penwidth=2.2];
    }

    /* ================================================================== *
     * 13. 임상 판독값                                                      *
     * ================================================================== */
    subgraph cluster_clin {
        label=<<b>13. 임상 엔드포인트</b><br/><i>Clinical endpoints</i>>;
