    /* ================================================================== *
     * 17. HSCT / 유전자치료 — 변수 (2)를 실제로 고치는 유일한 수단           *
     * ================================================================== */
    subgraph cluster_hsct {
        label=<<b>17. HSCT / 자가 유전자치료 — 대사가 아니라 미세아교세포를 바꾼다</b><br/><i>HSCT / ex-vivo gene therapy: replaces microglia, not metabolism</i>>;
        style="rounded,filled"; fillcolor="#e9f0f7"; color="#4a7fb8"; fontsize=11;
        node [fillcolor="#cfdff0"];

        CD34      [label="자가 CD34⁺ 채집 (동원)"];
        TRANSD    [label="Lenti-D 체외 형질도입"];
        ALLOHSCT  [label="동종 HSCT (형제/비혈연)"];
        BUSU      [label="부설판 조건화\n(AUC 목표 관리)", penwidth=2.2];
        MYELOAB   [label="골수 제거 (myeloablation)", penwidth=2.2];
        NEUT      [label="호중구 생착 (중간 약 13일)", penwidth=2.2];
        HSCE      [label="교정 조혈모세포 생착", penwidth=2.2];
        MONOCH    [label="말초 단핵구 키메리즘", penwidth=2.2];
        MGLREP    [label="미세아교세포 치환\n(반감기 수개월~년 — 느리다)", penwidth=2.2, fillcolor="#f9e5c4"];
        LAG       [label="◆ 치료 지체 창 12-18개월\n이식 후에도 Loes는 계속 오른다",
                   shape=octagon, penwidth=2.8, fillcolor="#e67e22", fontcolor="white"];
        GVHD      [label="이식편대숙주병 (동종 한정)", fillcolor="#f5b7b1"];
        CLONAL    [label="삽입 돌연변이 클론 확장", penwidth=2.2, fillcolor="#f5b7b1"];
        MDS       [label="MDS / AML (실측 안전성 신호)", fillcolor="#e74c3c", fontcolor="white"];
        TRM       [label="이식 관련 사망률", fillcolor="#f5b7b1"];
    }

    /* ================================================================== *
     * 18. 호르몬 보충 — 부신은 고치고 CNS는 못 고친다                       *
     * ================================================================== */
    subgraph cluster_horm {
        label=<<b>18. 호르몬 보충 — 부신 축만 되돌린다</b><br/><i>Replacement: reverses the adrenal axis only</i>>;
        style="rounded,filled"; fillcolor="#f7f2e9" ; color="#b89a5a"; fontsize=11;
        node [fillcolor="#eee0c4", style="filled,rounded,bold"];

        HC        [label="하이드로코르티손 (경구/응급 IV)", penwidth=2.2];
        FLUDRO    [label="플루드로코르티손"];
        TESTOR    [label="테스토스테론 보충"];
        CORTREP   [label="총 코르티솔 노출 (대체 포함)", penwidth=2.2];
    }

    /* ================================================================================
       EDGES
       ================================================================================ */

    /* ---- 1. gene -> protein ---- */
    ABCD1  -> MUT      [label="변이", color="#2471a3"];
    MUT    -> ALDPD    [label="기능 소실", color="#c0392b", arrowhead=tee];
    ABCD1  -> ALDP     [label="전사·번역", color="#1a7f37"];
    ALDPD  -> ALDP     [label="유효 ALDP 감소", color="#c0392b", arrowhead=tee, penwidth=1.8];
    LENTID -> VCN      [label="형질도입", color="#8e44ad", style=dashed];
    VCN    -> ALDP     [label="교정 ALDP 발현", color="#8e44ad", style=dashed, penwidth=1.8];
    ABCD2  -> IMPORT   [label="부분 대체 수송", color="#1a7f37"];
    ABCD3  -> PEXMEM   [color="#1a7f37"];
    PEXMEM -> IMPORT   [color="#2471a3"];
    ALDP   -> IMPORT   [label="C26:0-CoA 수송", color="#2471a3", penwidth=2.2];
    XINACT -> MOSAIC   [label="편향 정도", color="#2471a3"];
    MOSAIC -> ALDP     [label="세포 집단 평균 기능", color="#c0392b", arrowhead=tee];
    MOSAIC -> CROSSC   [color="#1a7f37"];
    CROSSC -> BETAOX   [label="정상 세포가 일부 보상", color="#1a7f37"];
    MOSAIC -> FEMALE   [label="편향이 클수록 발현", color="#e67e22"];

    /* ---- 2. mass balance ---- */
    DIET     -> VLCFACOA [label="약 20%", color="#2471a3"];
    DENOVO   -> ELONG    [color="#2471a3"];
    ELOVL1   -> ELONG    [label="속도 결정", color="#1a7f37", penwidth=1.8];
    ELONG    -> VLCFACOA [label="약 80% (지배적)", color="#2471a3", penwidth=2.2];
    ACSVL1   -> VLCFACOA [label="CoA 활성화", color="#1a7f37"];
    SREBP    -> ELOVL1   [label="전사 유도", color="#1a7f37"];
    VLCFACOA -> IMPORT   [color="#2471a3", penwidth=2.0];
    IMPORT   -> BETAOX   [label="기질 공급", color="#2471a3", penwidth=2.2];
    ACOX1    -> BETAOX   [color="#1a7f37"];
    DBP      -> BETAOX   [color="#1a7f37"];
    SCPX     -> BETAOX   [color="#1a7f37"];
    BETAOX   -> VLCFACOA [label="분해 (제거)", color="#c0392b", arrowhead=tee, penwidth=2.2];
    LOWFAT   -> DIET     [label="식이 차단", color="#8e44ad", style=dashed, arrowhead=tee];

    /* ---- 2->3 accumulation ---- */
    VLCFACOA -> C26PL   [label="유출·혈장 평형", color="#2471a3", penwidth=2.2];
    C26PL    -> C26LPC  [label="PC 리모델링 → lysoPC", color="#2471a3", penwidth=1.8];
    C26PL    -> C24C22  [color="#e67e22"];
    C26PL    -> C26CE   [label="에스터화", color="#2471a3"];
    C26PL    -> C26PC   [color="#2471a3"];
    C26PL    -> C26GANG [color="#2471a3"];
    C26PL    -> C26ADR  [label="조직 분배", color="#2471a3", penwidth=1.8];
    C26PL    -> C26BR   [label="조직 분배 (느림)", color="#2471a3", penwidth=1.8];
    C26PL    -> C26SC   [color="#2471a3", penwidth=1.8];
    C26PL    -> C26TEST [color="#2471a3"];
    C26BR    -> C26PC   [color="#2471a3"];
    C26CE    -> LAMEL   [label="봉입체 형성", color="#2471a3"];
    C26PC    -> MEMB    [label="아실 사슬 길이 → 막 물성", color="#c0392b", penwidth=2.0];
    C26GANG  -> MEMB    [color="#c0392b"];
    LAMEL    -> MEMB    [color="#c0392b"];

    /* ---- 3->4 stress ---- */
    C26PC  -> MITO   [label="탈분극", color="#c0392b", penwidth=1.8];
    MEMB   -> MITO   [color="#c0392b"];
    MEMB   -> CA     [color="#c0392b"];
    C26PL  -> NOX    [label="NOX2 활성화", color="#1a7f37"];
    NOX    -> ROS    [color="#1a7f37", penwidth=1.8];
    MITO   -> ROS    [color="#1a7f37", penwidth=1.8];
    ROS    -> OXPROT [color="#e67e22"];
    ROS    -> MITO   [label="양성 되먹임", color="#c0392b", style=bold, penwidth=1.6];
    ROS    -> ER     [color="#1a7f37"];
    ER     -> AUTOPH [color="#c0392b"];
    ROS    -> AUTOPH [label="흐름 차단", color="#c0392b", arrowhead=tee];
    AUTOPH -> C26CE  [label="제거 실패 → 축적", color="#c0392b", penwidth=1.6];
    ROS    -> NRF2   [label="정상이면 유도되나\nX-ALD에서는 감쇠", color="#1a7f37", style=dotted];
    NRF2   -> ROS    [label="항산화 방어", color="#c0392b", arrowhead=tee, penwidth=1.6];
    SIRT1  -> MITO   [label="생합성 회복", color="#c0392b", arrowhead=tee];
    MITO   -> ATPX   [color="#c0392b", penwidth=1.8];
    CA     -> ATPX   [color="#c0392b"];
    ROS    -> CA     [color="#1a7f37"];

    /* ---- 5. adrenal axis ---- */
    C26ADR  -> C26CE    [label="부신 저장 (최고 농도 조직)", color="#2471a3"];
    C26ADR  -> MEMB     [color="#c0392b"];
    MEMB    -> MC2R     [label="미세도메인 붕괴 → 수용체 커플링 저하",
                         color="#c0392b", arrowhead=tee, penwidth=2.0];
    C26ADR  -> ADMASS   [label="세포 손상·위축", color="#c0392b", arrowhead=tee, penwidth=2.0];
    ROS     -> ADMASS   [color="#c0392b", arrowhead=tee];
    CRH     -> ACTHP    [color="#1a7f37"];
    ACTHP   -> MC2R     [label="리간드", color="#1a7f37"];
    MC2R    -> STAR     [label="cAMP/PKA", color="#1a7f37", penwidth=1.8];
    STAR    -> STEROID  [color="#1a7f37", penwidth=1.8];
    ADMASS  -> STEROID  [label="용량 제한", color="#1a7f37", penwidth=2.0];
    STEROID -> CORT     [color="#2471a3", penwidth=2.2];
    STEROID -> ALDOS    [color="#2471a3"];
    CORT    -> ACTHP    [label="음성 되먹임", color="#c0392b", arrowhead=tee, penwidth=2.0];
    CORT    -> CRH      [label="음성 되먹임", color="#c0392b", arrowhead=tee];
    ACTHP   -> MSH      [label="POMC 공통 전구체", color="#1a7f37", penwidth=1.6];
    ALDOS   -> NAK      [label="Na⁺ 보존", color="#c0392b", arrowhead=tee, penwidth=1.8];
    ALDOS   -> RENIN    [label="음성 되먹임", color="#c0392b", arrowhead=tee];
    RENIN   -> ALDOS    [label="자극 (보상)", color="#1a7f37"];
    CORT    -> ACTHTESTR[label="자극 후 최대치", color="#e67e22", penwidth=1.8];
    NAK     -> ADCRISIS [color="#e67e22", penwidth=1.8];
    CORT    -> ADCRISIS [label="결핍 시", color="#e67e22", arrowhead=tee, penwidth=1.8];
    ADCRISIS-> DEATH    [label="미치료 시", color="#e67e22"];
    HC      -> CORTREP  [label="대체", color="#8e44ad", style=dashed, penwidth=2.0];
    CORT    -> CORTREP  [color="#2471a3"];
    CORTREP -> ADCRISIS [label="예방", color="#8e44ad", style=dashed, arrowhead=tee, penwidth=1.8];
    FLUDRO  -> NAK      [label="광질코르티코이드 대체", color="#8e44ad", style=dashed, arrowhead=tee];
    CORTREP -> MSH      [label="색소침착 소실", color="#8e44ad", style=dashed, arrowhead=tee];
    ACTHTEST-> ACTHTESTR[label="검사", color="#e67e22"];

    /* ---- 6. gonad ---- */
    C26TEST -> LEYDIG  [color="#c0392b", arrowhead=tee, penwidth=1.6];
    LEYDIG  -> TESTO   [color="#2471a3", penwidth=1.8];
    TESTO   -> LH      [label="음성 되먹임", color="#c0392b", arrowhead=tee];
    LH      -> LEYDIG  [label="자극", color="#1a7f37"];
    TESTO   -> HYPOG   [color="#e67e22", arrowhead=tee];
    LEYDIG  -> SPERM   [color="#1a7f37"];
    TESTOR  -> TESTO   [label="보충", color="#8e44ad", style=dashed, penwidth=1.8];

    /* ---- 7. microglia: the trigger ---- */
    C26BR   -> MGL     [label="ALDP 결핍 + VLCFA 부하", color="#c0392b", penwidth=2.0];
    MGL     -> MGLPHAG [color="#1a7f37", penwidth=1.6];
    TREM2   -> MGLPHAG [color="#1a7f37"];
    C26BR   -> MGLAP   [label="세포자멸사 유도", color="#1a7f37", penwidth=2.2];
    ROS     -> MGLAP   [color="#1a7f37", penwidth=1.6];
    MGLAP   -> MGL     [label="상주 풀 소실", color="#c0392b", arrowhead=tee, penwidth=2.2];
    MGLAP   -> MGLDEP  [color="#1a7f37", penwidth=2.0];
    MGLDEP  -> MGLPHAG [label="잔해 처리 능력 붕괴", color="#c0392b", arrowhead=tee, penwidth=2.0];
    MGLPHAG -> DEBRIS  [label="제거", color="#c0392b", arrowhead=tee, penwidth=2.0];
    DEBRIS  -> MGLPRO  [label="잔해가 표현형을 전환", color="#1a7f37", penwidth=2.0];
    C26BR   -> MGLPRO  [color="#1a7f37"];
    MGL     -> MGLPRO  [color="#2471a3"];

    /* ---- 8. inflammatory loop ---- */
    MGLPRO -> TNFA   [color="#1a7f37", penwidth=2.0];
    MGLPRO -> IL1B   [color="#1a7f37", penwidth=2.0];
    MGLPRO -> MCP1   [color="#1a7f37", penwidth=1.8];
    MGLPRO -> INOS   [color="#1a7f37"];
    MCP1   -> MONOIN [label="주화성", color="#1a7f37", penwidth=2.0];
    MONOIN -> TNFA   [label="증폭", color="#1a7f37", penwidth=1.8];
    TNFA   -> MMP9   [color="#1a7f37"];
    TNFA   -> TJ     [label="연접 붕괴", color="#c0392b", arrowhead=tee, penwidth=2.0];
    IL1B   -> VEGF   [color="#1a7f37"];
    MMP9   -> TJ     [label="기저막 분해", color="#c0392b", arrowhead=tee, penwidth=1.8];
    VEGF   -> BBBP   [color="#1a7f37", penwidth=1.8];
    TJ     -> BBBP   [label="장벽 유지", color="#c0392b", arrowhead=tee, penwidth=2.2];
    BBBP   -> MONOIN [label="유입 통로", color="#1a7f37", penwidth=2.2];
    BBBP   -> CD8T   [color="#1a7f37", penwidth=1.8];
    BBBP   -> GDENH  [label="조영제 누출", color="#e67e22", penwidth=2.2];
    BBBP   -> PERIV  [color="#1a7f37"];
    CD8T   -> PERF   [color="#1a7f37", penwidth=1.8];
    CD8T   -> IFNG   [color="#1a7f37"];
    IFNG   -> MGLPRO [label="증폭", color="#1a7f37", penwidth=1.8];
    PERF   -> OLGAP  [label="세포독성 사멸", color="#1a7f37", penwidth=2.2];
    TNFA   -> OLGAP  [color="#1a7f37", penwidth=2.0];
    IL1B   -> OLGAP  [color="#1a7f37", penwidth=1.6];
    INOS   -> OLGAP  [color="#1a7f37"];
    COMPL  -> OLGAP  [color="#1a7f37"];
    TNFA   -> ASTRO  [color="#1a7f37", penwidth=1.6];
    ASTRO  -> MCP1   [label="증폭", color="#1a7f37", penwidth=1.8];
    ASTRO  -> GLIOSIS[color="#1a7f37", penwidth=1.8];
    MGLPRO -> COMPL  [color="#1a7f37"];

    /* the loop-gain node: gathers the amplifying arms */
    TNFA   -> LOOP   [color="#c0392b", penwidth=1.6];
    MONOIN -> LOOP   [color="#c0392b", penwidth=1.6];
    CD8T   -> LOOP   [color="#c0392b", penwidth=1.6];
    DEBRIS -> LOOP   [color="#c0392b", penwidth=1.6];
    ASTRO  -> LOOP   [color="#c0392b", penwidth=1.2];
    LOOP   -> MGLPRO [label="G > 1 → 폭주", color="#c0392b", style=bold, penwidth=2.6];
    LOOP   -> SWITCH [label="스위치 상태 결정", color="#e67e22", style=bold, penwidth=2.6];

    /* ---- 10. myelin / axon ---- */
    OLGAP    -> OLG      [color="#c0392b", arrowhead=tee, penwidth=2.2];
    OLG      -> MYE      [label="수초 유지·재생", color="#1a7f37", penwidth=2.2];
    MYE      -> DEMY     [label="소실 → 탈수초 부피", color="#c0392b", penwidth=2.2];
    OLGAP    -> DEBRIS   [label="잔해 생성", color="#1a7f37", penwidth=2.0];
    DEMY     -> ZONE     [color="#2471a3"];
    ZONE     -> GLIOSIS  [color="#2471a3"];
    SPLENIUM -> DEMY     [label="시작 부위", color="#2471a3"];
    FRONTAL  -> DEMY     [label="아형", color="#2471a3", style=dotted];
    DEMY     -> AXBR     [label="축삭 절단·손상", color="#c0392b", arrowhead=tee, penwidth=2.0];
    ATPX     -> AXBR     [color="#c0392b", arrowhead=tee, penwidth=1.8];
    PERF     -> AXBR     [color="#c0392b", arrowhead=tee];
    DEMY     -> LOES     [label="부피·부위 가중", color="#e67e22", penwidth=2.4];
    GLIOSIS  -> LOES     [color="#e67e22"];
    GDENH    -> LOES     [label="조영증강 가점", color="#e67e22", penwidth=1.6];
    AXBR     -> NFS      [label="기능 소실", color="#e67e22", arrowhead=tee, penwidth=2.4];
    AXBR     -> COGN     [color="#e67e22", arrowhead=tee, penwidth=1.8];
    DEMY     -> VISUAL   [color="#e67e22", penwidth=1.6];
    DEMY     -> SEIZ     [color="#e67e22"];
    NFS      -> MFD      [label="역치 통과", color="#e67e22", penwidth=2.2];
    MFD      -> SURV     [color="#e67e22", arrowhead=tee, penwidth=2.2];
    NFS      -> DEATH    [label="말기", color="#e67e22", penwidth=1.8];

    /* ---- 11. cord / AMN ---- */
    C26SC  -> ATPX    [label="축삭 에너지 대사 손상", color="#c0392b", penwidth=1.8];
    LENGTH -> CST     [label="가장 긴 축삭 우선", color="#2471a3", penwidth=1.8];
    LENGTH -> DC      [color="#2471a3", penwidth=1.8];
    ATPX   -> DISTAX  [label="원위부부터", color="#1a7f37", penwidth=2.2];
    ROS    -> DISTAX  [color="#1a7f37", penwidth=1.6];
    DISTAX -> CST     [color="#c0392b", arrowhead=tee, penwidth=2.2];
    DISTAX -> DC      [color="#c0392b", arrowhead=tee, penwidth=2.2];
    CST    -> MYESC   [label="2차 수초 소실", color="#c0392b", arrowhead=tee];
    CST    -> SPAST   [color="#e67e22", arrowhead=tee, penwidth=2.0];
    DC     -> SPAST   [color="#e67e22", arrowhead=tee];
    CST    -> BLADDER [color="#e67e22", arrowhead=tee, penwidth=1.6];
    DISTAX -> PERIPH  [color="#e67e22"];
    SPAST  -> EDSS    [color="#e67e22", penwidth=2.2];
    BLADDER-> EDSS    [color="#e67e22"];
    SPAST  -> SIXMWT  [color="#e67e22", arrowhead=tee, penwidth=1.8];
    EDSS   -> MFD     [color="#e67e22", style=dotted];

    /* ---- 12. phenotype determination — the central claim ---- */
    C26BR    -> SWITCH  [label="필요조건 (necessary)", color="#e67e22", penwidth=2.4];
    SUSC     -> SWITCH  [label="충분조건을 결정 (sufficient)", color="#e67e22", penwidth=2.6];
    MODGEN   -> SUSC    [color="#2471a3"];
    HEADTR   -> SUSC    [label="촉발", color="#2471a3"];
    HEADTR   -> BBBP    [label="장벽 일시 파괴", color="#1a7f37", style=dotted];
    CONCORD  -> SUSC    [label="확률 성분의 증거", color="#2471a3", style=dotted];
    SWITCH   -> MGLPRO  [label="점화 (ignition)", color="#e67e22", style=bold, penwidth=2.6];
    SWITCH   -> CCALD   [label="ON (소아)", color="#e67e22", penwidth=2.2];
    SWITCH   -> AMNCONV [label="ON (성인 AMN)", color="#e67e22", penwidth=2.0];
    DISTAX   -> AMN     [label="OFF 경로", color="#e67e22", penwidth=2.2];
    ADMASS   -> ADDIONLY[label="부신 단독 표현형", color="#e67e22", arrowhead=tee, penwidth=1.8];
    CCALD    -> DEMY    [color="#e67e22", penwidth=2.2];
    AMNCONV  -> DEMY    [color="#e67e22", penwidth=1.8];
    AMN      -> EDSS    [color="#e67e22", penwidth=1.8];
    FEMALE   -> DISTAX  [color="#e67e22", penwidth=1.6];
    C26PL    -> NOCORR  [label="측정된다", color="#e67e22", style=dashed];
    SWITCH   -> NOCORR  [label="측정되지 않는다", color="#e67e22", style=dashed];
    NOCORR   -> MRISURV [label="그래서 MRI 감시가\n대체 불가능하다", color="#e67e22", penwidth=2.0];

    /* ---- 14. screening ---- */
    C26LPC   -> NBS      [label="DBS 정량", color="#e67e22", penwidth=2.2];
    NBS      -> RUSP     [color="#2471a3", style=dotted];
    NBS      -> ABCD1SEQ [label="2차 확진", color="#2471a3", penwidth=1.8];
    NBS      -> FALSEPOS [label="타 퍼옥시좀 질환", color="#2471a3", style=dotted];
    ABCD1SEQ -> MRISURV  [label="감시 등록", color="#2471a3", penwidth=1.8];
    ABCD1SEQ -> ACTHTEST [color="#2471a3", penwidth=1.8];
    MRISURV  -> LOES     [label="조기 포착", color="#e67e22", penwidth=1.8];
    LOES     -> WINDOW   [label="≤ 9 이면 창 안", color="#e67e22", penwidth=2.2];
    NFS      -> WINDOW   [label="≤ 1 이면 창 안", color="#e67e22", penwidth=2.2];
    WINDOW   -> CD34     [label="이식 적응", color="#4a7fb8", penwidth=2.2];
    WINDOW   -> ALLOHSCT [color="#4a7fb8", penwidth=1.8];
    ACTHTEST -> HC       [label="조기 보충 개시", color="#8e44ad", style=dashed, penwidth=1.8];

    /* ---- 15. metabolic drugs ---- */
    LO      -> ERUC     [label="흡수·에스터 가수분해", color="#8e44ad", style=dashed, penwidth=2.0];
    LO      -> OLEIC    [color="#8e44ad", style=dashed];
    ERUC    -> COMPINH  [label="기질 경쟁", color="#8e44ad", style=dashed, penwidth=2.2];
    OLEIC   -> COMPINH  [color="#8e44ad", style=dashed];
    COMPINH -> ELOVL1   [label="경쟁적 저해 → 신장 flux 감소",
                         color="#c0392b", arrowhead=tee, penwidth=2.4];
    ERUC    -> LOBBB    [label="뇌로 가지 않는다", color="#c0392b", style=dashed, penwidth=2.0];
    LOBBB   -> C26BR    [label="변화 없음 (효과 부재)", color="#c0392b", style=dotted, penwidth=2.0];
    ELOVLI  -> ELOVL1   [label="직접 저해", color="#8e44ad", style=dashed, arrowhead=tee, penwidth=1.8];
    BEZA    -> ABCD2    [label="유도 시도", color="#8e44ad", style=dashed];
    PBA     -> ABCD2    [label="유도 시도", color="#8e44ad", style=dashed];
    SOBE    -> ABCD2    [label="CNS 내 유도", color="#8e44ad", style=dashed, penwidth=2.0];
    SOBE    -> C26BR    [label="뇌 VLCFA 직접 감소", color="#c0392b", style=dashed, arrowhead=tee, penwidth=2.0];
    ABCD2   -> BETAOX   [label="대체 수송 → 분해 회복", color="#1a7f37", penwidth=1.8];

    /* ---- 16. CNS drugs ---- */
    LERI   -> LERIB   [label="BBB 통과 (설계된 침투)", color="#8e44ad", style=dashed, penwidth=2.2];
    LERIB  -> PPARG   [color="#8e44ad", style=dashed, penwidth=2.0];
    PPARG  -> SIRT1   [label="미토콘드리아 생합성", color="#1a7f37", penwidth=1.8];
    PPARG  -> NRF2    [color="#1a7f37", penwidth=1.6];
    PPARG  -> TNFA    [label="전사 억제", color="#c0392b", arrowhead=tee, penwidth=1.8];
    PPARG  -> MCP1    [color="#c0392b", arrowhead=tee];
    PPARG  -> TJ      [label="장벽 안정화", color="#1a7f37", penwidth=1.8];
    DMF    -> NRF2    [color="#8e44ad", style=dashed, penwidth=1.8];
    NAC    -> ROS     [color="#8e44ad", style=dashed, arrowhead=tee, penwidth=1.8];
    STEROIDX-> TNFA   [label="일시적 감소, 진행은 못 막음",
                       color="#8e44ad", style=dotted, arrowhead=tee];
    IMMSUPX -> CD8T   [label="루프를 끊지 못함", color="#8e44ad", style=dotted, arrowhead=tee];
    LERIB  -> LOOP    [label="이득 G 감소 (부분적)", color="#c0392b", arrowhead=tee, penwidth=1.8];

    /* ---- 17. HSCT / gene therapy ---- */
    CD34    -> TRANSD  [color="#4a7fb8", penwidth=1.8];
    TRANSD  -> LENTID  [label="벡터 도입", color="#4a7fb8", penwidth=1.8];
    TRANSD  -> HSCE    [color="#4a7fb8", penwidth=1.8];
    ALLOHSCT-> HSCE    [label="공여자 세포", color="#4a7fb8", penwidth=1.8];
    ALLOHSCT-> GVHD    [color="#4a7fb8"];
    BUSU    -> MYELOAB [label="노출(AUC) 의존", color="#4a7fb8", penwidth=2.0];
    MYELOAB -> NEUT    [label="일시적 무과립구증", color="#c0392b", arrowhead=tee, penwidth=1.8];
    MYELOAB -> HSCE    [label="생착 공간 확보", color="#1a7f37", penwidth=2.0];
    MYELOAB -> TRM     [label="독성", color="#c0392b"];
    GVHD    -> TRM     [color="#c0392b"];
    NEUT    -> TRM     [label="감염 위험", color="#c0392b", arrowhead=tee];
    HSCE    -> MONOCH  [label="말초 재구성", color="#4a7fb8", penwidth=2.2];
    HSCE    -> VCN     [color="#4a7fb8", penwidth=1.8];
    MONOCH  -> MGLREP  [label="느린 치환 (율속 단계)", color="#4a7fb8", penwidth=2.4];
    MGLREP  -> MGL     [label="교정 미세아교세포 공급", color="#1a7f37", penwidth=2.4];
    MGLREP  -> MGLPHAG [label="잔해 처리 능력 회복", color="#1a7f37", penwidth=2.4];
    MGLREP  -> LAG     [label="지체의 원인", color="#e67e22", penwidth=2.2];
    LAG     -> LOES    [label="이식 후에도 상승", color="#e67e22", penwidth=2.2];
    LAG     -> NFS     [color="#e67e22", penwidth=1.8];
    MGLREP  -> LOOP    [label="이득 G < 1 로 되돌림", color="#c0392b", arrowhead=tee, penwidth=2.6];
    VCN     -> CLONAL  [label="삽입 부위 의존", color="#c0392b", penwidth=1.8];
    CLONAL  -> MDS     [color="#c0392b", penwidth=2.0];
    MDS     -> DEATH   [color="#e67e22"];
    TRM     -> DEATH   [color="#e67e22"];
    HSCE    -> ALDP    [label="조혈계 한정 교정", color="#1a7f37", style=dashed];
    MGLREP  -> C26BR   [label="뇌 VLCFA는 거의 그대로",
                        color="#c0392b", style=dotted, penwidth=1.6];

    /* ---- the two dissociation statements, drawn explicitly ---- */
    COMPINH -> C26PL   [label="표지자는 정상화된다", color="#8e44ad", arrowhead=tee, penwidth=2.4];
    COMPINH -> SWITCH  [label="스위치는 건드리지 못한다",
                        color="#c0392b", style=dotted, penwidth=2.4];
    MGLREP  -> SURV    [label="질병은 멈춘다", color="#1a7f37", penwidth=2.4];
    MGLREP  -> C26PL   [label="표지자는 거의 그대로",
                        color="#c0392b", style=dotted, penwidth=2.0];

}
