        LOES      [label="Loes MRI 중증도 (0-34)", penwidth=2.2];
        NFS       [label="신경기능점수 NFS (0-25)", penwidth=2.2];
        MFD       [label="주요 기능장애 MFD (6항목)", penwidth=2.2];
        SURV      [label="무MFD 생존 (MFD-free survival)", penwidth=2.2];
        EDSS      [label="EDSS / SSPROM (척수형)", penwidth=2.2];
        SIXMWT    [label="6분 보행 거리 (6MWT)"];
        COGN      [label="인지·행동 저하 (ADHD 유사 초기)"];
        VISUAL    [label="시력 · 청력 저하"];
        SEIZ      [label="경련"];
        DEATH     [label="사망 / 식물상태", fillcolor="#e74c3c", fontcolor="white"];
    }

    /* ================================================================== *
     * 14. 신생아 선별 · 진단                                               *
