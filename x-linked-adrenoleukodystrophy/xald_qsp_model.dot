    subgraph cluster_dx {
        label=<<b>14. 신생아 선별 · 감시 (조기 진단이 유일한 치료 창을 만든다)</b><br/><i>Newborn screening and surveillance</i>>;
        style="rounded,filled"; fillcolor="#e9f7f4"; color="#4aa899"; fontsize=11;
