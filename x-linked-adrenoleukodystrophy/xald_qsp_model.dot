    subgraph cluster_drugmet {
        label=<<b>15. 대사 표적 약물 — 변수 (1)에만 도달한다</b><br/><i>Metabolic drugs: reach variable (1) only</i>>;
        style="rounded,filled"; fillcolor="#f5eafd"; color="#a05fd0"; fontsize=11;
        node [fillcolor="#e7d0f7", shape=box, style="filled,rounded,bold"];

        LO        [label="로렌조 오일\nGTE:GTO 4:1 (경구)", penwidth=2.2];
        ERUC      [label="에루크산 C22:1\n(혈장, 활성 성분)", penwidth=2.2];
        OLEIC     [label="올레산 C18:1"];
        COMPINH   [label="ELOVL1 경쟁적 저해\n(기질 경쟁)", penwidth=2.2];
        LOBBB     [label="⊘ BBB 통과 못함\n뇌 VLCFA 변화 없음",
                   shape=note, fillcolor="#f5b7b1", penwidth=2.2];
        ELOVLI    [label="ELOVL1 직접 저해제\n(전임상)"];
        BEZA      [label="베자피브레이트 (ABCD2 유도 시도)"];
        SOBE      [label="소베티롬 / Sob-AM2\nCNS 침투 티로미메틱", penwidth=2.2];
        PBA       [label="4-페닐부티레이트 (ABCD2 유도)"];
        LOWFAT    [label="VLCFA 제한식 (식이 유입 차단)"];
