        ABCD1SEQ  [label="ABCD1 시퀀싱 확진"];
        MRISURV   [label="6-12개월 간격 MRI 감시", penwidth=2.2];
        ACTHTEST  [label="연 1-2회 ACTH 자극검사"];
        WINDOW    [label="◆ 치료 창 (therapeutic window)\nLoes ≤ 9 · NFS ≤ 1",
                   shape=octagon, penwidth=2.6, fillcolor="#48c9b0"];
        FALSEPOS  [label="위양성/불확정 (ACOX1·PEX 등)"];
