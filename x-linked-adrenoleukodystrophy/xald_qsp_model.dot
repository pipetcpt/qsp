    /* ================================================================== *
     * 16. CNS · 항염 약물                                                  *
     * ================================================================== */
    subgraph cluster_drugcns {
        label=<<b>16. CNS 침투 · 항염 약물 — 변수 (2)를 겨눈다</b><br/><i>CNS-penetrant / anti-inflammatory: aimed at variable (2)</i>>;
        style="rounded,filled"; fillcolor="#eaf2fd"; color="#5f8fd0"; fontsize=11;
        node [fillcolor="#d0e0f7", style="filled,rounded,bold"];

        LERI      [label="레리글리타존 (MIN-102)\n혈장", penwidth=2.2];
        LERIB     [label="레리글리타존 뇌 노출\n(CNS 침투 설계)", penwidth=2.2];
        PPARG     [label="PPARγ 활성화", penwidth=2.2];
        DMF       [label="디메틸푸마레이트 (Nrf2)"];
        NAC       [label="항산화 3제\nNAC + α-토코페롤 + 리포산"];
        STEROIDX  [label="⊘ 고용량 스테로이드\n뇌형 진행 억제 실패",
