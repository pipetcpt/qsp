    ISHAM_CRIT    [label = "ISHAM/ABPA criteria\npredisposing (asthma/CF) +\nobligatory (Af-IgE, total IgE > 500–1000) +\n≥ 2 of (Af-IgG, eos > 500, radiology)", shape = note, style = "filled", fillcolor = "#dddddd"];
    E_TOTIGE      [label = "Endpoint: total IgE\n(the trap-laden one)"];
    E_EOS         [label = "Endpoint: blood eosinophils"];
    E_FENO        [label = "Endpoint: FeNO"];
    E_PLUG        [label = "Endpoint: mucus-plug score"];
    E_BRONCH      [label = "Endpoint: bronchiectasis extent"];
