    STAGING       [label = "Patterson/ISHAM stages\nI acute · II remission · III exacerbation ·\nIV steroid-dependent · V fibrotic", shape = note, style = "filled", fillcolor = "#dddddd"];
    NET_UTILITY   [label = "Net utility\nbenefit − toxicity currency"];
  }

