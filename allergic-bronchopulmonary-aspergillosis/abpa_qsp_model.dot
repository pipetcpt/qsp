  INFECTION -> NET_UTILITY [style = dotted];

  /* --- c17 endpoints into utility --- */
  E_EXAC -> NET_UTILITY [penwidth = 1.8];
  E_FEV1 -> NET_UTILITY [penwidth = 1.6];
  E_BRONCH -> NET_UTILITY [penwidth = 1.8];
  E_OCS -> NET_UTILITY [style = dotted, penwidth = 1.8];
  E_REMISSION -> NET_UTILITY [penwidth = 1.6];
  ISHAM_CRIT -> STAGING [style = dashed];
  E_PLUG -> NET_UTILITY [style = dashed];
  E_TOTIGE -> STAGING [style = dashed];

  /* --- cross-cluster feedbacks that make the model a loop --- */
  ALLERGENS -> B_CELL [style = dashed, penwidth = 1.5];
  EOS_AIRWAY -> HYPHAL_KILL [style = dashed, label = "EPX is fungistatic\nbut not fungicidal"];
  IGG_SPEC -> F_LUM [style = dotted, label = "opsonisation\n(weak)"];
  GR_TRANSREP -> PLUG [style = dotted, penwidth = 1.8, label = "the only\nfast plug therapy"];
  GR_TRANSACT -> F_LUM [penwidth = 1.6, label = "immunosuppression\n↑ fungal growth"];
  BIOFILM -> HYPHAL_KILL [style = dotted, penwidth = 1.6];

  /* --- legend --- */
  subgraph cluster_legend {
    label = "Legend / model bookkeeping";
    style = "filled"; fillcolor = "#ffffff"; color = "#999999"; fontsize = 15; fontcolor = "#444444";
    node [shape = plaintext, style = "", fillcolor = "#ffffff", fontsize = 11];
    LEG [label = <<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#eeeeee"><B>element</B></TD><TD BGCOLOR="#eeeeee"><B>meaning</B></TD></TR>
      <TR><TD>solid arrow</TD><TD ALIGN="LEFT">mass flux or activation</TD></TR>
      <TR><TD>dashed arrow</TD><TD ALIGN="LEFT">modulation / permissive influence</TD></TR>
      <TR><TD>dotted arrow</TD><TD ALIGN="LEFT">inhibition / reduction</TD></TR>
      <TR><TD>bold crimson</TD><TD ALIGN="LEFT">the sanctuary loop F_LUM ⇄ F_PLUG (cluster ⑨)</TD></TR>
      <TR><TD>bold green</TD><TD ALIGN="LEFT">the CYP3A4 drug-interaction path (cluster ⑬→⑫)</TD></TR>
      <TR><TD>octagon</TD><TD ALIGN="LEFT">structural trap / derived condition, not a state variable</TD></TR>
      <TR><TD>box3d</TD><TD ALIGN="LEFT">integrating compartment (plug, fungal pools, bronchiectasis)</TD></TR>
      <TR><TD>diamond</TD><TD ALIGN="LEFT">clinical endpoint read out by the mrgsolve model</TD></TR>
      <TR><TD>note</TD><TD ALIGN="LEFT">criteria / staging definition (not dynamic)</TD></TR>
      </TABLE>>];
    LEG2 [label = <<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR><TD BGCOLOR="#eeeeee"><B>therapy</B></TD><TD BGCOLOR="#eeeeee"><B>which partition term it moves</B></TD></TR>
      <TR><TD ALIGN="LEFT">itraconazole / voriconazole</TD><TD ALIGN="LEFT">E_af in F_LUM fully, in F_PLUG × f_pen ≈ 0.10</TD></TR>
      <TR><TD ALIGN="LEFT">nebulised amphotericin B</TD><TD ALIGN="LEFT">E_af at the mucosal surface; no CYP3A4 DDI</TD></TR>
      <TR><TD ALIGN="LEFT">corticosteroid</TD><TD ALIGN="LEFT">PLUG down fast, F_LUM <B>up</B> (immunosuppression)</TD></TR>
      <TR><TD ALIGN="LEFT">omalizumab</TD><TD ALIGN="LEFT">FcεRI occupancy only; PLUG barely, F_PLUG not at all</TD></TR>
      <TR><TD ALIGN="LEFT">mepolizumab / benralizumab</TD><TD ALIGN="LEFT">EPX → disulphide cross-linking → k_out up</TD></TR>
      <TR><TD ALIGN="LEFT">dupilumab</TD><TD ALIGN="LEFT">MUC5AC drive down → PLUG down → k_out up → lowers<BR/>the azole eradication threshold E* (not Bliss synergy)</TD></TR>
      <TR><TD ALIGN="LEFT">bronchoscopic toilet</TD><TD ALIGN="LEFT">sets F_PLUG and PLUG to ~0 instantaneously</TD></TR>
      </TABLE>>];
  }
}
