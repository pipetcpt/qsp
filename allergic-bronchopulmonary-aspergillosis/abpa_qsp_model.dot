/*
 * Allergic Bronchopulmonary Aspergillosis (ABPA) — QSP mechanistic map
 * -------------------------------------------------------------------
 * The map is drawn around ONE structural claim, cluster c09:
 *   the Aspergillus population lives in TWO compartments — the airway
 *   lumen (drug-accessible) and the inside of a high-attenuation mucus
 *   plug (drug-sanctuary) — and the drug that kills the fungus cannot
 *   reach the plug while the drug that dissolves the plug cannot kill
 *   the fungus.  Every therapy in cluster c12-c15 is therefore
 *   classified by WHICH TERM of that partition it touches, not by
 *   potency.
 *
 * Two further structural traps are drawn explicitly:
 *   c06/c15  total IgE RISES on omalizumab while free IgE falls, so the
 *            ABPA response criterion ("total IgE down 35-50%") moves
 *            OPPOSITE to the pharmacology  (node BIOMARKER_TRAP)
 *   c13/c12  itraconazole inhibits CYP3A4, so part of its apparent
 *            steroid-sparing effect is a DDI that makes each mg of
 *            steroid act like several  (node DDI_CONFOUND)
 *
 * Render:  dot -Tsvg abpa_qsp_model.dot -o abpa_qsp_model.svg
 *          dot -Tpng -Gdpi=150 abpa_qsp_model.dot -o abpa_qsp_model.png
 */

digraph ABPA_QSP {
  rankdir = TB;
  compound = true;
  newrank = true;
  splines = spline;
  concentrate = false;
  nodesep = 0.22;
  ranksep = 0.52;
  fontname = "Helvetica";
  labelloc = "t";
  labeljust = "l";
  label = <<FONT POINT-SIZE="34"><B>Allergic Bronchopulmonary Aspergillosis — Quantitative Systems Pharmacology Map</B></FONT><BR/>
           <FONT POINT-SIZE="19">the fungal population is partitioned into a drug-accessible lumen and a drug-inaccessible mucus plug;<BR/>
           every therapy is classified by which term of that partition it touches</FONT><BR/>
           <FONT POINT-SIZE="15">solid = mass flux / activation &nbsp;·&nbsp; dashed = modulation &nbsp;·&nbsp; dotted = inhibition &nbsp;·&nbsp; bold red = the sanctuary loop &nbsp;·&nbsp; diamond = clinical endpoint</FONT>>;

  node [shape = box, style = "rounded,filled", fontname = "Helvetica",
        fontsize = 11, penwidth = 1.1, margin = "0.09,0.05"];
  edge [fontname = "Helvetica", fontsize = 9, arrowsize = 0.62, penwidth = 1.0];

  /* ============================================================ */
  /* c01  EXPOSURE AND FUNGAL BIOLOGY                             */
  /* ============================================================ */
  subgraph cluster_c01 {
    label = "① Exposure · Aspergillus fumigatus biology";
    style = "filled"; fillcolor = "#f3ede2"; color = "#8d7b5e"; fontsize = 17; fontcolor = "#5d4e33";
    node [fillcolor = "#e6dcc6", color = "#8d7b5e"];

    CONIDIA_AIR   [label = "Airborne conidia\n1–100 /m³ outdoor, ↑ compost,\ndamp housing, autumn spores"];
    INHALED_DOSE  [label = "Inhaled conidial dose\n~10²–10³ conidia/day\n2–3 µm → alveolar & bronchial deposition"];
    CONIDIA_LUM   [label = "Luminal conidia\n(dormant, RodA hydrophobin masked)"];
    SWELLING      [label = "Conidial swelling\nRodA shed → β-glucan/chitin unmasked"];
    GERM          [label = "Germination\n(37 °C, ≥ 4–6 h, requires nutrient + O₂)"];
    HYPHAE_LUM    [label = "Luminal hyphae\n(non-invasive, mucosa-adherent)"];
    GAG           [label = "Galactosaminogalactan (GAG)\nadhesive exopolysaccharide"];
    BIOFILM       [label = "Hyphal biofilm / ECM\nextracellular matrix, ↓ diffusion,\nhypoxic core"];
    PROTEASE      [label = "Secreted proteases\nAlp1/Asp f13, Asp f1 ribotoxin,\nAsp f2, Asp f4, Asp f6"];
    GLIOTOXIN     [label = "Gliotoxin · secondary metabolites\nciliostasis, epithelial damage"];
    ALLERGENS     [label = "Allergen panel\nAsp f1–f6, f22, f23\n(f4/f6 = ABPA-specific)"];
    ERG_PATH      [label = "Ergosterol biosynthesis\nCYP51A/B (14-α-demethylase)"];
    CYP51_MUT     [label = "cyp51A mutation\nTR34/L98H · TR46/Y121F/T289A\n→ azole resistance"];
    HYPOXIA_PLUG  [label = "Intra-plug hypoxia\n→ ↓ azole potency, ↑ tolerance,\nsterol pathway shift"];
    PERSISTER     [label = "Biofilm persister phenotype\nphenotypic azole tolerance (not MIC)"];
  }

  /* ============================================================ */
  /* c02  EPITHELIUM AND BARRIER                                  */
  /* ============================================================ */
  subgraph cluster_c02 {
    label = "② Airway epithelium · barrier · alarmins";
    style = "filled"; fillcolor = "#e8f1ec"; color = "#4f8467"; fontsize = 17; fontcolor = "#2f5a44";
    node [fillcolor = "#cfe4d8", color = "#4f8467"];

    EPI           [label = "Bronchial epithelium\n(ciliated · goblet · basal · club)"];
    TJ            [label = "Tight junctions\nZO-1 · occludin · claudin-18"];
    PAR2          [label = "PAR-2 cleavage\n(protease-activated receptor 2)"];
    EGFR_EPI      [label = "EGFR / ERK activation\n→ goblet metaplasia"];
    ATP_REL       [label = "ATP release · P2Y₂\ndanger signal"];
    TSLP          [label = "TSLP"];
    IL25          [label = "IL-25 (IL-17E)"];
    IL33          [label = "IL-33\n(nuclear alarmin, released on necrosis)"];
    GMCSF_EPI     [label = "GM-CSF (epithelial)"];
    CCL17_22      [label = "CCL17 / CCL22 (TARC/MDC)\nTh2 chemotaxis"];
    CCL11_24_26   [label = "CCL11 / CCL24 / CCL26\n(eotaxin-1/2/3)"];
    MCC           [label = "Mucociliary clearance\nCBF · periciliary layer depth"];
    CILIOSTASIS   [label = "Ciliostasis\n(gliotoxin, EPX, dehydration)"];
    CFTR_NODE     [label = "CFTR function\nCF & CFTR-heterozygote ABPA risk"];
    ENAC          [label = "ENaC / ASL volume\nairway surface liquid depth"];
    EPI_APOP      [label = "Epithelial injury / shedding"];
    SPD           [label = "Surfactant protein D · pentraxin-3\nconidial opsonins"];
  }

  /* ============================================================ */
  /* c03  INNATE IMMUNITY                                         */
  /* ============================================================ */
  subgraph cluster_c03 {
    label = "③ Innate recognition · phagocyte clearance";
    style = "filled"; fillcolor = "#eaf0f8"; color = "#4a6e9c"; fontsize = 17; fontcolor = "#2c4a71";
    node [fillcolor = "#d3e1f2", color = "#4a6e9c"];

    DECTIN1       [label = "Dectin-1 (CLEC7A)\nβ-1,3-glucan sensing"];
    TLR24         [label = "TLR2 / TLR4 / TLR9"];
    CARD9         [label = "CARD9 → Syk → NF-κB"];
    AM            [label = "Alveolar macrophage\nconidial killing"];
    NEUT_REC      [label = "Neutrophil recruitment\nIL-8/CXCL8 · IL-17"];
    NADPH_OX      [label = "NADPH oxidase burst\n(NOX2 — CGD risk gene)"];
    NET           [label = "Neutrophil extracellular traps"];
    NE_MMP        [label = "Neutrophil elastase · MMP-9\nairway wall proteolysis"];
    HYPHAL_KILL   [label = "Hyphal killing capacity\n(effective only extracellularly)"];
    INFLAMMASOME  [label = "NLRP3 inflammasome\n→ IL-1β · IL-18"];
    PTX3_DEF      [label = "PTX3 / TLR polymorphism\n(ABPA susceptibility)"];
  }

  /* ============================================================ */
  /* c04  ADAPTIVE PRIMING                                        */
  /* ============================================================ */
  subgraph cluster_c04 {
    label = "④ Antigen presentation · T-cell polarisation";
    style = "filled"; fillcolor = "#f6ecf4"; color = "#8a5382"; fontsize = 17; fontcolor = "#63305c";
    node [fillcolor = "#e9d3e5", color = "#8a5382"];

    DC            [label = "Conventional DC (cDC2)\nallergen uptake · migration"];
    HLA_RISK      [label = "HLA-DR2 / DR5 restriction\n(DQ2 protective)"];
    NAIVE_T       [label = "Naïve CD4⁺ T cell"];
    TH2           [label = "Th2 cell (Af-specific)\nGATA-3⁺"];
    TH17          [label = "Th17 cell\nIL-17A · IL-22"];
    TH1           [label = "Th1 cell\nIFN-γ (protective arm)"];
    TREG          [label = "Treg (FOXP3⁺)\nreduced/dysfunctional in ABPA"];
    ILC2          [label = "ILC2\nalarmin-driven, antigen-independent"];
    IL10_TGF      [label = "IL-10 · TGF-β\n(tolerance arm)"];
    TFH           [label = "Tfh cell → germinal centre"];
  }

  /* ============================================================ */
  /* c05  TYPE-2 CYTOKINE AXIS                                    */
  /* ============================================================ */
  subgraph cluster_c05 {
    label = "⑤ Type-2 cytokine axis (the amplifier)";
    style = "filled"; fillcolor = "#fdf0e3"; color = "#b3743a"; fontsize = 17; fontcolor = "#8a5423";
    node [fillcolor = "#f8ddbf", color = "#b3743a"];

    IL4           [label = "IL-4\nclass switching · Th2 commitment"];
    IL5           [label = "IL-5\neosinophilopoiesis · survival"];
    IL13          [label = "IL-13\nmucin · AHR · remodelling"];
    IL4RA         [label = "IL-4Rα\n(shared IL-4 type-II & IL-13 receptor)"];
    IL5RA         [label = "IL-5Rα (CD125)"];
    JAK_STAT6     [label = "JAK1/JAK3 → STAT6"];
    GATA3         [label = "GATA-3"];
    IL9           [label = "IL-9 (mast-cell growth)"];
    IL31          [label = "IL-31"];
    FENO_NODE     [label = "iNOS → FeNO\n(IL-13/STAT6-driven)"];
  }

  /* ============================================================ */
  /* c06  B CELL AND IgE                                          */
  /* ============================================================ */
  subgraph cluster_c06 {
    label = "⑥ B cell · IgE — where the biomarker breaks";
    style = "filled"; fillcolor = "#fdeaea"; color = "#b04747"; fontsize = 17; fontcolor = "#8a2f2f";
    node [fillcolor = "#f8cccc", color = "#b04747"];

    B_CELL        [label = "Af-specific B cell"];
    CSR           [label = "Class-switch recombination\nAID · ε germline transcription"];
    PLASMA        [label = "IgE⁺ plasma cell\n(bone marrow, long-lived)"];
    IGE_FREE      [label = "FREE serum IgE\nthe pharmacologically active species\nt½ ≈ 2.5 d", penwidth = 2.4];
    IGE_CX        [label = "Omalizumab:IgE complex\ncleared like IgG, t½ ≈ 20–26 d", penwidth = 2.4];
    IGE_TOTAL     [label = "TOTAL IgE (measured)\n= free + complexed", shape = box, style = "rounded,filled,bold", penwidth = 2.4];
    IGE_SPEC      [label = "Af-specific IgE\n(> 0.35 kUA/L = ISHAM criterion)"];
    IGG_SPEC      [label = "Af-specific IgG\n(> 27 mgA/L = ISHAM criterion)"];
    PRECIP        [label = "Precipitating IgG\n→ immune complexes (type III)"];
    BIOMARKER_TRAP [label = "STRUCTURAL TRAP\nomalizumab ↓ free IgE ~96%\nand ↑ TOTAL IgE ~2–3×;\nthe ABPA response criterion\n(total IgE ↓ 35–50%) therefore\nmoves OPPOSITE to the pharmacology",
                    shape = octagon, style = "filled,bold", fillcolor = "#ffd9d9", color = "#a01818", fontcolor = "#7a1010", fontsize = 13, penwidth = 3];
  }

  /* ============================================================ */
  /* c07  EFFECTOR CELLS                                          */
  /* ============================================================ */
  subgraph cluster_c07 {
    label = "⑦ Effector cells · granule chemistry";
    style = "filled"; fillcolor = "#fff6e0"; color = "#a8892c"; fontsize = 17; fontcolor = "#7d6516";
    node [fillcolor = "#faeab6", color = "#a8892c"];

    FCER1         [label = "FcεRI (mast cell / basophil)\noccupancy = IgE_f/(IgE_f+Kd)"];
    MAST          [label = "Mast cell"];
    BASO          [label = "Basophil\n(FcεRI down-modulated by anti-IgE)"];
    DEGRAN        [label = "Degranulation\nhistamine · tryptase · PGD₂ · LTC₄"];
    EOS_BM        [label = "Bone-marrow eosinophilopoiesis\nIL-5/IL-5Rα"];
    EOS_BLOOD     [label = "Blood eosinophils\n(ISHAM: > 500 /µL)"];
    EOS_AIRWAY    [label = "Airway eosinophils\n(sputum, BAL, tissue)"];
    EOS_APOP      [label = "Eosinophil apoptosis\n(↑ by CS, by anti-IL-5)"];
    ADCC          [label = "NK-cell ADCC\n(afucosylated anti-IL-5Rα)"];
    EPX_MBP       [label = "EPX · MBP · ECP · EDN\ncationic granule proteins"];
    EETOSIS       [label = "EETosis\n(cytolytic eosinophil death)"];
    CLC_GAL10     [label = "Charcot–Leyden crystals\ngalectin-10 crystallisation"];
    LTC4_CYS      [label = "Cysteinyl leukotrienes\nLTC₄/D₄/E₄"];
    IL6_TNF       [label = "IL-6 · TNF-α\n(systemic inflammation)"];
  }

  /* ============================================================ */
  /* c08  MUCUS AND THE PLUG                                      */
  /* ============================================================ */
  subgraph cluster_c08 {
    label = "⑧ Mucin production · plug formation";
    style = "filled"; fillcolor = "#ecebf7"; color = "#5b569b"; fontsize = 17; fontcolor = "#3a3675";
    node [fillcolor = "#d6d4ee", color = "#5b569b"];

    GOBLET        [label = "Goblet-cell metaplasia\n(SPDEF · FOXA3)"];
    MUC5AC        [label = "MUC5AC secretion\nIL-13/STAT6-driven"];
    MUC5B         [label = "MUC5B secretion\n(constitutive, clearance mucin)"];
    SUBMUCOSAL    [label = "Submucosal gland hypertrophy"];
    DISULFIDE     [label = "Mucin disulphide cross-linking\n(oxidative, EPX/H₂O₂-driven)"];
    MUC_RIGID     [label = "Rigid mucin gel\n↑ elastic modulus, ↓ transportability"];
    PLUG          [label = "MUCUS PLUG\nhigh-attenuation mucus (HAM)\nCT attenuation > paraspinal muscle",
                   shape = box3d, style = "filled,bold", fillcolor = "#b9b5e8", penwidth = 2.6];
    PLUG_SCORE    [label = "Mucus plug score\n(segmental plug count, 0–18)"];
    PLUG_CLEAR    [label = "Plug clearance flux\nmucociliary + cough + dissolution"];
    HYPER_TONIC   [label = "Airway dehydration\n↓ ASL → ↑ mucus concentration"];
    EXPECTORATE   [label = "Brownish mucus plug expectoration\n(classical ABPA symptom)"];
    ATELECTASIS   [label = "Lobar / segmental collapse\n(plug occlusion)"];
  }

  /* ============================================================ */
  /* c09  THE SANCTUARY PARTITION — the structural core           */
  /* ============================================================ */
  subgraph cluster_c09 {
    label = "⑨ THE SANCTUARY PARTITION — the structural core of the model";
    style = "filled"; fillcolor = "#fde8ee"; color = "#a01a45"; fontsize = 19; fontcolor = "#7d0f33";
    node [fillcolor = "#f7c3d3", color = "#a01a45"];

    F_LUM         [label = "F_LUM — luminal fungal burden\nDRUG-ACCESSIBLE\nfree drug ≈ plasma unbound",
                   shape = box3d, style = "filled,bold", penwidth = 2.6, fillcolor = "#f9aec5"];
    F_PLUG        [label = "F_PLUG — plug-embedded burden\nDRUG-SANCTUARY\nfree drug ≈ f_pen × plasma unbound (f_pen ≈ 0.10)",
                   shape = box3d, style = "filled,bold", penwidth = 2.6, fillcolor = "#f9aec5"];
    ENTRAP        [label = "Entrapment flux\nk_in · PLUG · F_LUM", penwidth = 2.0];
    RELEASE       [label = "Release flux\nk_out(PLUG) · F_PLUG", penwidth = 2.0];
    F_PEN         [label = "Penetration factor f_pen\nplug matrix diffusion + protein binding\n+ hypoxia-driven potency loss"];
    G_PLUG        [label = "Intra-plug growth rate g_p\n(nutrient-rich, immune-excluded)"];
    ERAD_COND     [label = "ERADICATION CONDITION\nsanctuary self-sustains unless\nE_af > (g_p − k_out)/f_pen\n→ a threshold no antifungal dose\ncan reach when k_out is small",
                   shape = octagon, style = "filled,bold", fillcolor = "#ffcfdd", color = "#7d0f33", fontcolor = "#6b0c2b", fontsize = 13, penwidth = 3];
    REL_ANTIGEN   [label = "Antigen release flux\n(fungal turnover → allergen load)"];
  }

  /* ============================================================ */
  /* c10  REMODELLING AND IRREVERSIBILITY                         */
  /* ============================================================ */
  subgraph cluster_c10 {
    label = "⑩ Remodelling · the irreversible clock";
    style = "filled"; fillcolor = "#efeae4"; color = "#7a6a58"; fontsize = 17; fontcolor = "#54473a";
    node [fillcolor = "#ded3c5", color = "#7a6a58"];

    TGFB          [label = "TGF-β1 activation"];
    MMP9_TIMP     [label = "MMP-9 / TIMP-1 imbalance"];
    ASM           [label = "Airway smooth-muscle hyperplasia"];
    SUBEPI_FIB    [label = "Subepithelial fibrosis\ncollagen I/III deposition"];
    WALL_THICK    [label = "Bronchial wall thickening"];
    CARTILAGE     [label = "Cartilage & elastin destruction\n(proteolytic)"];
    BRONCHIECT    [label = "CENTRAL BRONCHIECTASIS\nirreversible — an integrator, never a state that falls",
                   shape = box3d, style = "filled,bold", fillcolor = "#cbbba4", penwidth = 2.4];
    TRACTION      [label = "Traction bronchiectasis / fibrosis\n(Stage V, end-stage)"];
    CAVITY        [label = "Cavitation · aspergilloma\n(chronic colonisation)"];
    BACT_COLON    [label = "Secondary bacterial colonisation\nP. aeruginosa · NTM"];
    VICIOUS       [label = "Cole vicious vortex\ninfection ⇄ inflammation ⇄ damage ⇄ ↓clearance"];
  }

  /* ============================================================ */
  /* c11  PHYSIOLOGY AND SYMPTOMS                                 */
  /* ============================================================ */
  subgraph cluster_c11 {
    label = "⑪ Airway physiology · symptoms";
    style = "filled"; fillcolor = "#e6f3f7"; color = "#3d7f92"; fontsize = 17; fontcolor = "#245868";
    node [fillcolor = "#c7e5ee", color = "#3d7f92"];

    AHR           [label = "Airway hyper-responsiveness\n(PC₂₀ methacholine)"];
    BRONCHOSPASM  [label = "Bronchoconstriction\n(reversible component)"];
    LUMEN_OBSTR   [label = "Luminal obstruction\n(plug + oedema + secretions)"];
    FIXED_OBSTR   [label = "Fixed obstruction\n(remodelling + bronchiectasis)"];
    FEV1          [label = "FEV₁ % predicted", shape = diamond, style = "filled,bold", fillcolor = "#a8d6e4", penwidth = 2.2];
    FVC_RATIO     [label = "FEV₁/FVC · air trapping (RV/TLC)"];
    VQ            [label = "V/Q mismatch → hypoxaemia"];
    WHEEZE        [label = "Wheeze · dyspnoea · cough"];
    HAEMOPTYSIS   [label = "Haemoptysis"];
    EXAC          [label = "ABPA exacerbation\n(≥ 50% ↑ total IgE + clinical/radiological worsening)",
                   shape = diamond, style = "filled,bold", fillcolor = "#a8d6e4", penwidth = 2.2];
    ACT_SCORE     [label = "Symptom control (ACT / SGRQ)", shape = diamond, style = "filled", fillcolor = "#a8d6e4"];
  }

  /* ============================================================ */
  /* c12  CORTICOSTEROID PK/PD                                    */
  /* ============================================================ */
  subgraph cluster_c12 {
    label = "⑫ Corticosteroid PK/PD — three steroids, three CYP3A4 sensitivities";
    style = "filled"; fillcolor = "#e9f7ea"; color = "#3f8446"; fontsize = 17; fontcolor = "#26592c";
    node [fillcolor = "#c9ecce", color = "#3f8446"];

    PRED_DOSE     [label = "Prednisolone PO\n0.5 mg/kg/d × 2 wk → taper\n(ISHAM medium-dose protocol)"];
    PRED_PK       [label = "Prednisolone PK\nF ≈ 0.8, t½ ≈ 3 h, nonlinear\ntranscortin binding; CYP3A4 share ≈ 0.15"];
    MPRED_DOSE    [label = "Methylprednisolone PO/IV\n(pulse regimens)"];
    MPRED_PK      [label = "Methylprednisolone PK\nCYP3A4 share ≈ 0.75\n→ AUC ↑ ~2.6× with itraconazole"];
    BUD_DOSE      [label = "Inhaled budesonide / ciclesonide\n(± high-dose ICS)"];
    BUD_PK        [label = "Budesonide PK\nswallowed fraction, first-pass\nCYP3A4 share ≈ 0.90 → AUC ↑ ~4×"];
    GR            [label = "Glucocorticoid receptor (NR3C1)\noccupancy = C_u/(C_u+EC₅₀)"];
    GR_TRANSREP   [label = "Transrepression\nNF-κB · AP-1 · GATA-3 ↓"];
    GR_TRANSACT   [label = "Transactivation\nmetabolic & HPA effects"];
    CS_RESIST     [label = "Steroid resistance\nGRβ · IL-2/IL-4 · neutrophilic switch"];
    DDI_CONFOUND  [label = "STRUCTURAL TRAP\nitraconazole inhibits CYP3A4, so part of its\napparent steroid-sparing effect is a DDI —\neach mg of steroid acts like several.\nThe magnitude depends on WHICH steroid,\nwhich makes it testable.",
                   shape = octagon, style = "filled,bold", fillcolor = "#d8f2dc", color = "#1f5a27", fontcolor = "#164420", fontsize = 13, penwidth = 3];
  }

  /* ============================================================ */
  /* c13  AZOLE PK AND THE DDI                                    */
  /* ============================================================ */
  subgraph cluster_c13 {
    label = "⑬ Azole PK · CYP interactions";
    style = "filled"; fillcolor = "#fff0f0"; color = "#a4443c"; fontsize = 17; fontcolor = "#7d2b25";
    node [fillcolor = "#f9d4d1", color = "#a4443c"];

    ITRA_DOSE     [label = "Itraconazole 200 mg BID PO\n(capsule vs oral solution)"];
    ITRA_ABS      [label = "Absorption\ncapsule needs gastric acid + food;\nsolution/SUBA ↑ F ~1.5–1.8×"];
    ITRA_PK       [label = "Itraconazole PK — NONLINEAR\nsaturable CYP3A4 clearance,\nautoinhibition → supra-proportional AUC"];
    OH_ITRA       [label = "Hydroxy-itraconazole\nactive metabolite, ≈ equipotent,\nAUC ≈ 1.5–2× parent"];
    ITRA_PPB      [label = "Protein binding 99.8%\nf_u ≈ 0.002"];
    CYP3A4_INH    [label = "CYP3A4 inhibition\nI = 1/(1 + C_u/Ki + C_u,OH/Ki,OH)", penwidth = 2.2];
    PGP_INH       [label = "P-gp inhibition"];
    VORI_DOSE     [label = "Voriconazole 200 mg BID PO"];
    VORI_PK       [label = "Voriconazole PK — NONLINEAR\nMichaelis–Menten CYP2C19/3A4"];
    CYP2C19       [label = "CYP2C19 genotype\nPM/IM ↑ trough 2–4× · UM ↓ trough"];
    VORI_TDM      [label = "TDM target trough\n1–5.5 mg/L (efficacy vs toxicity)"];
    POSA_ISAV     [label = "Posaconazole / isavuconazole\n(alternative, ↓ or no 3A4 induction of self)"];
    NEB_AMB       [label = "Nebulised liposomal amphotericin B\nhigh airway conc., negligible systemic\nAUC → NO CYP3A4 DDI"];
    ITRA_TDM      [label = "Itraconazole TDM\ntrough ≥ 0.5–1 mg/L (parent + OH)"];
  }

  /* ============================================================ */
  /* c14  ANTIFUNGAL PD                                           */
  /* ============================================================ */
  subgraph cluster_c14 {
    label = "⑭ Antifungal PD — where the exposure meets the sanctuary";
    style = "filled"; fillcolor = "#f2f0e6"; color = "#7d7534"; fontsize = 17; fontcolor = "#585220";
    node [fillcolor = "#e3dfc2", color = "#7d7534"];

    CYP51_TARGET  [label = "Target: CYP51A/B\n14-α-demethylase inhibition"];
    ERG_DEPLETE   [label = "Ergosterol depletion\n+ toxic 14-methyl sterol accumulation"];
    MIC_NODE      [label = "MIC / MEC distribution\nA. fumigatus ECV itraconazole 1 mg/L"];
    AUC_MIC       [label = "Exposure index AUC_u/MIC\n(azoles are AUC-driven)"];
    E_AF_LUM      [label = "E_af,LUM — kill rate in lumen\nEmax·C_u/(C_u+EC₅₀)", penwidth = 2.0];
    E_AF_PLUG     [label = "E_af,PLUG — kill rate in plug\n= f_pen · E_af,LUM  (≈ 10%)", penwidth = 2.0];
    AMB_PD        [label = "Amphotericin B PD\nergosterol pore, concentration-dependent,\nacts at the mucosal surface"];
    RESIST_SEL    [label = "Resistance selection\nsub-MIC exposure inside the plug"];
  }

  /* ============================================================ */
  /* c15  BIOLOGICS PK/PD                                         */
  /* ============================================================ */
  subgraph cluster_c15 {
    label = "⑮ Biologics — classified by which partition term they move";
    style = "filled"; fillcolor = "#eef2fb"; color = "#41579b"; fontsize = 17; fontcolor = "#293b76";
    node [fillcolor = "#d4ddf4", color = "#41579b"];

    OMA_DOSE      [label = "Omalizumab SC\ntable capped at IgE ≤ 1500 IU/mL —\nABPA baseline is 1000–20000,\nso ABPA is dosed OFF the table"];
    OMA_PK        [label = "Omalizumab PK\nt½ ≈ 26 d, F ≈ 0.62, TMDD"];
    OMA_BIND      [label = "1:1 / 2:1 omalizumab:IgE binding\nKd ≈ 1 nM", penwidth = 2.0];
    FCER1_DOWN    [label = "FcεRI down-regulation on basophils\n(slow, weeks)"];
    MEPO          [label = "Mepolizumab 100 mg q4w SC\nanti-IL-5 (ligand)"];
    BENRA         [label = "Benralizumab 30 mg q4w×3 → q8w\nanti-IL-5Rα + ADCC → near-total\neosinophil depletion"];
    DUPI          [label = "Dupilumab 300 mg q2w SC\nanti-IL-4Rα → blocks IL-4 AND IL-13"];
    DUPI_EOS      [label = "Transient blood eosinophilia\n(blocked tissue egress)"];
    TEZE          [label = "Tezepelumab (anti-TSLP)\nupstream alarmin block"];
    BIO_MUC       [label = "Mucin-drive reduction\n(IL-13 axis → MUC5AC ↓ → k_out ↑)", penwidth = 2.0];
    SYNERGY       [label = "THRESHOLD-LOWERING, NOT BLISS SYNERGY\nthe biologic raises k_out and lowers PLUG,\nlowering the azole's eradication threshold E*.\nThe model finds NO Bliss synergy on burden\n(A9 reports the negative); what moves is the\nTHRESHOLD and the sanctuary SHARE",
                   shape = octagon, style = "filled,bold", fillcolor = "#c9d6f5", color = "#22356b", fontcolor = "#1a2a57", fontsize = 13, penwidth = 3];
  }

  /* ============================================================ */
  /* c16  SYSTEMIC TOXICITY                                       */
  /* ============================================================ */
  subgraph cluster_c16 {
    label = "⑯ Systemic toxicity — the currency each therapy is paid in";
    style = "filled"; fillcolor = "#f7f0f0"; color = "#8b5b5b"; fontsize = 17; fontcolor = "#653c3c";
    node [fillcolor = "#e8d2d2", color = "#8b5b5b"];

    HPA           [label = "HPA axis\nCRH → ACTH → cortisol"];
    CORTISOL      [label = "Endogenous cortisol\n(morning serum, µg/dL)", shape = diamond, style = "filled", fillcolor = "#dcc0c0"];
    ADRENAL_SUP   [label = "Adrenal suppression\n(iatrogenic Cushing — the budesonide+itraconazole trap)"];
    BMD           [label = "Bone mineral density\nlumbar-spine T-score", shape = diamond, style = "filled", fillcolor = "#dcc0c0"];
    FRACTURE      [label = "Fragility fracture hazard", shape = diamond, style = "filled", fillcolor = "#dcc0c0"];
    HBA1C         [label = "Glucose / HbA1c\nsteroid-induced diabetes", shape = diamond, style = "filled", fillcolor = "#dcc0c0"];
    WEIGHT_BP     [label = "Weight gain · hypertension · myopathy"];
    CATARACT      [label = "Cataract · glaucoma"];
    HEPATOTOX     [label = "Azole hepatotoxicity\nALT/AST elevation", shape = diamond, style = "filled", fillcolor = "#dcc0c0"];
    ITRA_CHF      [label = "Itraconazole negative inotropy\n→ heart-failure warning · oedema"];
    VORI_TOX      [label = "Voriconazole toxicity\nvisual · photosensitivity · SCC\nperiostitis · encephalopathy"];
    INFECTION     [label = "Immunosuppression\n→ infection risk, PJP, TB reactivation"];
    HELMINTH      [label = "Anti-IL-5 caveat\nhelminth clearance"];
  }

