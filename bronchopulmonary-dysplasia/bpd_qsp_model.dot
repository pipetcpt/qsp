digraph BPD_QSP {
  rankdir=LR;
  fontname="Helvetica";
  labelloc="t";
  fontsize=20;
  label="Bronchopulmonary Dysplasia (BPD) — Mechanistic QSP Map\nAlveolarisation is a SCHEDULED programme, not a repairable tissue: injury does not destroy alveoli, it ARRESTS the septation clock while the window S_dev(PMA) keeps running out.\nAntenatal hit + ventilator/oxygen exposure → NF-kB / IL-1b / TGF-b1 → suppression of the VEGF-NO-IGF1-retinoate growth gate G → alveolar + microvascular arrest → 36-week PMA support grade, BPD-PH, and the neurodevelopmental price of buying lung with steroid";
  node [style=filled, fontname="Helvetica", fontsize=10, shape=box];
  edge [fontname="Helvetica", fontsize=8];
  compound=true;
  newrank=true;
  ranksep=0.5;
  nodesep=0.22;
  concentrate=false;

  //==========================================================================
  subgraph cluster_antenatal {
    label="1. Antenatal Substrate — the head start the infant is born with (HIT #1)"; style=filled; color="#e8ddf0"; fillcolor="#f4eefa";
    GA_birth [label="Gestational age at birth\n(22-32 wk; the single\nstrongest determinant)", fillcolor="#e0c9f5"];
    Birthweight [label="Birth weight /\nz-score for GA"];
    IUGR [label="IUGR / SGA\n(placental insufficiency)", fillcolor="#f7d6d6"];
    Placental_sFlt1 [label="Placental sFlt-1 / sEng\n(anti-angiogenic milieu)", fillcolor="#f7d6d6"];
    Preeclampsia_mat [label="Maternal preeclampsia /\nhypertensive disorder"];
    Chorioamnionitis [label="Histologic chorioamnionitis /\nfunisitis (antenatal IL-6, IL-8)", fillcolor="#f7d6d6"];
    Amniotic_IL6 [label="Amniotic fluid IL-6 /\nfetal inflammatory response"];
    Antenatal_steroid [label="Antenatal corticosteroid\n(betamethasone; matures\nsurfactant, not septation)", fillcolor="#d6f5d6"];
    MgSO4_ante [label="Antenatal MgSO4\n(neuroprotection)"];
    Maternal_smoking [label="Maternal smoking /\nnicotine exposure"];
    Male_sex [label="Male sex\n(~1.3-1.5x risk)"];
    Genetic_var [label="Genetic variance\n(SPOCK2, CRP, NFKBIA,\nheritability ~50-80%)"];
    Surfactant_def [label="Primary surfactant\ndeficiency (RDS)"];
    Fetal_lung_stage [label="Lung stage at birth:\ncanalicular (<24 wk) /\nsaccular (24-32 wk)", fillcolor="#e0c9f5"];
    Antenatal_G_suppr [label="Antenatal suppression of\ngrowth gate G(0) < 1", fillcolor="#f2b8b8"];
  }

  //==========================================================================
  subgraph cluster_program {
    label="2. The Developmental Programme and its Clock — S_dev(PMA), a finite integral"; style=filled; color="#d7ecd7"; fillcolor="#ecf8ec";
    S_dev [label="S_dev(PMA)\nSeptation drive window\n(peaks ~30-36 wk PMA,\ndecays into infancy)", fillcolor="#a8e6a8", shape=octagon];
    Window_integral [label="INTEGRAL of S_dev is FINITE\n=> every arrested day is\nirrecoverable surface", fillcolor="#7fd97f", shape=doubleoctagon];
    Saccular_stage [label="Saccular stage\n(primitive saccules,\nthick double capillary bed)"];
    Alveolar_stage [label="Alveolar stage\n(secondary crest formation,\n85% of alveoli postnatal)"];
    Microvasc_stage [label="Microvascular maturation\n(double -> single\ncapillary network)"];
    Secondary_septa [label="Secondary septal\ncrest formation", fillcolor="#a8e6a8"];
    PDGFA_myofib [label="PDGF-A / PDGFRa+\nalveolar myofibroblast\n(crest tip engine)"];
    FGF10_meso [label="FGF10 / FGFR2b\nmesenchymal signalling"];
    Wnt_bcat [label="Wnt / beta-catenin\n(AT2 progenitor niche)"];
    NOTCH_epi [label="Notch / Hes1\nepithelial patterning"];
    AT2_progenitor [label="AT2 progenitor pool\n(SFTPC+; self-renewal)"];
    AT1_spread [label="AT1 cell spreading\n(gas-exchange surface)"];
    Elastin_dep [label="Tropoelastin deposition\nAT SEPTAL TIPS\n(spatially specific)", fillcolor="#a8e6a8"];
    LOX_crosslink [label="LOX / LOXL1\nelastin cross-linking"];
    Capillary_sprout [label="Angiogenic sprouting\n(alveolarisation REQUIRES\nangiogenesis)", fillcolor="#a8e6a8"];
    Program_arrest [label="PROGRAMME ARREST\n(not destruction)", fillcolor="#f2b8b8", shape=doubleoctagon];
  }

  //==========================================================================
  subgraph cluster_support {
    label="3. Respiratory Support — the mechanical exposure term (HIT #2a)"; style=filled; color="#dbe8f5"; fillcolor="#eaf3fb";
    Delivery_room [label="Delivery-room stabilisation\n(sustained inflation,\nT-piece, PEEP)"];
    LISA_MIST [label="LISA / MIST surfactant\n(surfactant WITHOUT\nintubation)", fillcolor="#d6f5d6"];
    nCPAP [label="nCPAP / NIPPV\n(non-invasive)", fillcolor="#d6f5d6"];
    HFNC [label="High-flow nasal cannula"];
    Invasive_MV [label="Invasive mechanical\nventilation (days on ETT)", fillcolor="#f7d6d6"];
    HFOV [label="HFOV / HFJV\n(open-lung strategy)"];
    Tidal_volume [label="Delivered tidal volume\n(4-6 mL/kg target)"];
    VTV_mode [label="Volume-targeted ventilation\n(vs pressure-limited)", fillcolor="#d6f5d6"];
    MAP_airway [label="Mean airway pressure\n(MAP)"];
    PEEP_level [label="PEEP / lung recruitment"];
    Volutrauma [label="Volutrauma\n(overdistension of\ncompliant units)", fillcolor="#f7d6d6"];
    Atelectrauma [label="Atelectrauma\n(cyclic recruitment of\nderecruited units)", fillcolor="#f7d6d6"];
    Shear_hetero [label="Regional heterogeneity:\ninterdependence shear\nstress at unit borders"];
    Biotrauma [label="Biotrauma\n(mechanotransduction ->\ncytokine release)", fillcolor="#f2b8b8"];
    Perm_hypercapnia [label="Permissive hypercapnia\n(pCO2 55-65 mmHg)", fillcolor="#d6f5d6"];
    Hypocapnia [label="Inadvertent hypocapnia\n(pCO2 <35; cerebral\nvasoconstriction)", fillcolor="#f7d6d6"];
    Extubation_fail [label="Extubation failure /\nreintubation cycles"];
    Support_escalation [label="CLINICIAN ESCALATION LOOP\nworse gas exchange ->\nmore support", fillcolor="#f2b8b8", shape=octagon];
    Tracheostomy [label="Tracheostomy /\nchronic ventilation"];
  }

  //==========================================================================
  subgraph cluster_redox {
    label="4. Oxygen and Redox — the U-shaped exposure term (HIT #2b)"; style=filled; color="#fbe6d4"; fillcolor="#fdf2e8";
    FiO2 [label="FiO2 requirement\n(0.21 - 1.0)", fillcolor="#f9d5ae"];
    SpO2_target [label="SpO2 target band\n(85-89% vs 91-95%)", fillcolor="#f9d5ae", shape=octagon];
    Hyperoxia [label="Relative hyperoxia\n(fetal PaO2 ~25 mmHg ->\npostnatal 60-80)", fillcolor="#f7d6d6"];
    Hypoxia_episodes [label="Intermittent hypoxaemia\n(desaturation episodes)", fillcolor="#f7d6d6"];
    NOX_activity [label="NADPH oxidase\n(NOX1/2/4) activation"];
    Mito_ROS [label="Mitochondrial ROS /\ncomplex I-III leak"];
    XO_activity [label="Xanthine oxidase\n(ischaemia-reperfusion)"];
    ROS_burden [label="ROS burden\n(O2-, H2O2, OH-)", fillcolor="#f2b8b8"];
    Peroxynitrite [label="Peroxynitrite (ONOO-)\nnitrotyrosine adducts"];
    AOX_immature [label="IMMATURE antioxidant defence\n(SOD, catalase, GSH all\nlow before 34 wk)", fillcolor="#f7d6d6"];
    NRF2_axis [label="Nrf2 / HO-1 / NQO1\nadaptive response"];
    Lipid_perox [label="Lipid peroxidation /\nMDA, isoprostanes"];
    DNA_ox [label="8-OHdG / oxidative\nDNA damage"];
    HIF_axis [label="HIF-1a / HIF-2a\nstabilisation (hypoxic arm)"];
    Hyperoxia_G_block [label="Hyperoxic block of\nVEGF-VEGFR2 signalling", fillcolor="#f2b8b8"];
    ROP_link [label="Retinopathy of prematurity\n(shared oxygen exposure)"];
  }

  //==========================================================================
  subgraph cluster_inflam {
    label="5. Innate Immune Amplification — the transduction stage"; style=filled; color="#f7dede"; fillcolor="#fdeeee";
    TLR2_4 [label="TLR2 / TLR4\n(PAMP + DAMP sensing)"];
    HMGB1 [label="HMGB1 / S100A8-A9\nalarmins"];
    NFkB_act [label="NF-kB activation\n(p65 nuclear translocation)", fillcolor="#f2b8b8"];
    NLRP3 [label="NLRP3 inflammasome /\ncaspase-1", fillcolor="#f2b8b8"];
    IL1B [label="IL-1beta\n(the canonical\nalveolarisation BLOCKER)", fillcolor="#ef9c9c", shape=octagon];
    IL6 [label="IL-6"];
    IL8_CXCL8 [label="IL-8 / CXCL8\n(neutrophil chemoattractant)"];
    TNFa [label="TNF-alpha"];
    MCP1 [label="MCP-1 / CCL2"];
    Neutrophil_influx [label="Airway neutrophil influx\n(tracheal aspirate PMN)", fillcolor="#f7d6d6"];
    NE_elastase [label="Neutrophil elastase\n(degrades septal elastin)", fillcolor="#f7d6d6"];
    MPO_burden [label="Myeloperoxidase /\nHOCl burden"];
    Mac_M1 [label="Macrophage M1\npolarisation"];
    Mac_M2 [label="Macrophage M2 /\npro-resolving (reparative)", fillcolor="#d6f5d6"];
    Treg_deficit [label="Treg / IL-10 deficit\n(impaired resolution)"];
    IL10_resolve [label="IL-10 / lipoxin\nresolution programme", fillcolor="#d6f5d6"];
    Endothelial_perm [label="Endothelial barrier\ndisruption -> proteinaceous\nalveolar oedema"];
  }

  //==========================================================================
  subgraph cluster_infection {
    label="6. Infection — a discrete, drug-addressable driver"; style=filled; color="#efe0f5"; fillcolor="#f8f0fb";
    Ureaplasma [label="Ureaplasma urealyticum /\nparvum airway colonisation", fillcolor="#f7d6d6"];
    Mycoplasma_hom [label="Mycoplasma hominis"];
    LOS_sepsis [label="Late-onset sepsis\n(CoNS, gram-negative)", fillcolor="#f7d6d6"];
    VAP [label="Ventilator-associated\npneumonia / tracheitis"];
    NEC_event [label="Necrotising enterocolitis\n(systemic inflammatory hit)"];
    RSV_viral [label="Postnatal viral infection\n(RSV, rhinovirus)"];
    Dysbiosis [label="Airway / gut dysbiosis\n(Lactobacillus loss)"];
    Cumulative_hits [label="Cumulative inflammatory\nhit count (dose-response\nto BPD grade)", fillcolor="#f2b8b8"];
  }

  //==========================================================================
  subgraph cluster_matrix {
    label="7. Matrix Remodelling and Fibrosis — the septal-thickening arm"; style=filled; color="#e3e3f5"; fillcolor="#eeeefa";
    TGFB1 [label="TGF-beta1 (latent -> active;\nmechanically activated)", fillcolor="#ef9c9c", shape=octagon];
    Smad23 [label="Smad2/3 phosphorylation"];
    CTGF_CCN2 [label="CTGF / CCN2"];
    Myofibroblast [label="alpha-SMA+ myofibroblast\n(MISLOCALISED: interstitium\ninstead of crest tip)", fillcolor="#f7d6d6"];
    Collagen_dep [label="Collagen I / III\ndeposition"];
    Septal_thick [label="Septal thickening\n(diffusion distance up)", fillcolor="#f7d6d6"];
    MMP2_9 [label="MMP-2 / MMP-9\n(matrix degradation)"];
    TIMP1 [label="TIMP-1 (MMP/TIMP\nimbalance)"];
    Elastin_frag [label="Elastin fragmentation /\ndesmosine release", fillcolor="#f7d6d6"];
    Elastin_mislocal [label="Tropoelastin MISLOCALISATION\n(thick septa, not crest tips)", fillcolor="#f7d6d6"];
    Fibronectin [label="Fibronectin / tenascin-C"];
    EMT_epi [label="Epithelial-mesenchymal\ntransition (AT2 loss)"];
    Senescence [label="Cellular senescence /\np21, p16, SASP"];
  }

  //==========================================================================
  subgraph cluster_growth {
    label="8. The Growth Gate G — VEGF x NO x IGF-1 x Retinoate (the therapeutic target)"; style=filled; color="#d7ecf5"; fillcolor="#ecf7fb";
    VEGFA [label="VEGF-A (isoform 164/165)\nfalls in BPD lung", fillcolor="#a8dcf0"];
    VEGFR2 [label="VEGFR2 / KDR\nphosphorylation"];
    ANG1_Tie2 [label="Angiopoietin-1 / Tie2\n(vessel stabilisation)"];
    ANG2 [label="Angiopoietin-2\n(destabilising)"];
    sFlt1_local [label="Local sFlt-1\n(VEGF trap)"];
    eNOS_NO [label="eNOS / NO bioavailability", fillcolor="#a8dcf0"];
    ADMA [label="ADMA / DDAH imbalance\n(eNOS uncoupling)"];
    sGC_cGMP [label="sGC / cGMP / PKG"];
    PDE5 [label="PDE5 (cGMP breakdown)"];
    IGF1_axis [label="IGF-1 / IGFBP-3\n(low in IUGR and\nafter birth)", fillcolor="#a8dcf0"];
    Retinol_store [label="Hepatic retinol store\n(preterm born deficient)", fillcolor="#a8dcf0"];
    RA_RAR [label="Retinoic acid / RAR-beta\n(drives septation +\ntropoelastin)", fillcolor="#a8dcf0"];
    HGF_axis [label="HGF / c-Met\n(epithelial-mesenchymal\ncrosstalk)"];
    EPC_pool [label="Endothelial progenitor /\nECFC pool (reduced,\nhyperoxia-sensitive)"];
    G_gate [label="G = growth gate\n(geometric composite,\n0 = fully arrested)", fillcolor="#5cc6e8", shape=doubleoctagon];
    Cortisol_adrenal [label="Relative adrenal\ninsufficiency of prematurity"];
  }

  //==========================================================================
  subgraph cluster_structure {
    label="9. Structural Outcome — alveolar simplification + microvascular arrest"; style=filled; color="#f5e8d0"; fillcolor="#fbf4e8";
    ALV_surface [label="Alveolar gas-exchange\nSURFACE AREA\n(the deliverable)", fillcolor="#f0c674", shape=doubleoctagon];
    RAC_count [label="Radial alveolar count\n(histologic readout)"];
    Alv_simplify [label="Alveolar simplification:\nfewer, larger airspaces", fillcolor="#f7d6d6"];
    CAP_density [label="Pulmonary microvascular\nDENSITY", fillcolor="#f0c674", shape=doubleoctagon];
    Dysmorphic_vasc [label="Dysmorphic, distally\nmalpositioned vessels"];
    Emphys_hetero [label="Heterogeneous emphysematous\n+ atelectatic regions"];
    Compliance [label="Lung compliance\n(Crs, mL/cmH2O/kg)"];
    FRC_vol [label="FRC / lung volume\n(gas trapping)"];
    Deadspace [label="Alveolar dead space\n(VD/VT up)"];
    VQ_mismatch [label="V/Q mismatch + shunt", fillcolor="#f7d6d6"];
    Diff_limit [label="Diffusion limitation\n(DLCO down)"];
    LOSTW [label="LOST-WINDOW COUNTER\ncumulative integral of\nS_dev x (1 - G) dt", fillcolor="#e8983c", shape=doubleoctagon];
  }

  //==========================================================================
  subgraph cluster_airway {
    label="10. Airway Disease — the wheeze / obstruction arm"; style=filled; color="#e8f0d8"; fillcolor="#f3f8ea";
    ASM_hyperplasia [label="Airway smooth muscle\nhyperplasia"];
    Bronch_hyperreact [label="Bronchial hyperreactivity\n(bronchodilator response)"];
    Goblet_mucus [label="Goblet cell metaplasia /\nmucus hypersecretion"];
    Tracheobronchomal [label="Tracheobronchomalacia\n(dynamic collapse)"];
    Subglottic_sten [label="Subglottic stenosis\n(intubation trauma)"];
    Airway_resist [label="Airway resistance up /\nflow limitation"];
    Small_airway_fib [label="Peribronchiolar fibrosis"];
    Cilia_dysfunc [label="Ciliary dysfunction /\nimpaired clearance"];
  }

  //==========================================================================
  subgraph cluster_hemo {
    label="11. Hemodynamics — PDA, overcirculation, fluid"; style=filled; color="#f5dbe8"; fillcolor="#fbeef4";
    hsPDA [label="Haemodynamically significant\nPDA (ductal steal)", fillcolor="#f7d6d6"];
    Qp_Qs [label="Qp/Qs pulmonary\novercirculation"];
    Pulm_edema [label="Pulmonary interstitial /\nalveolar oedema", fillcolor="#f7d6d6"];
    Lung_water [label="Extravascular lung water"];
    Fluid_intake [label="Total fluid intake\n(mL/kg/d)"];
    Na_balance [label="Sodium load / balance"];
    LV_preload [label="LV volume loading"];
    Systemic_steal [label="Systemic diastolic steal\n(gut, brain, kidney)"];
    PDA_duration [label="Duration of PDA exposure\n(days, not presence)", fillcolor="#f7d6d6"];
    Colloid_onc [label="Hypoproteinaemia /\nlow oncotic pressure"];
  }

  //==========================================================================
  subgraph cluster_ph {
    label="12. BPD-associated Pulmonary Hypertension — the SHARED-ROOT comorbidity"; style=filled; color="#e0d8f0"; fillcolor="#efeaf9";
    PVR_total [label="Pulmonary vascular\nresistance (PVR)", fillcolor="#c4b0e8"];
    Cross_section [label="Total pulmonary vascular\nCROSS-SECTIONAL AREA\n(= f(CAP_density))", fillcolor="#c4b0e8"];
    HPV_tone [label="Hypoxic pulmonary\nvasoconstriction tone"];
    Vasc_remodel [label="Medial hypertrophy /\nadventitial thickening"];
    ET1_axis [label="Endothelin-1 / ETA\nreceptor signalling"];
    Rho_kinase [label="RhoA / ROCK\nvasoconstrictor sensitisation"];
    BPD_PH [label="BPD-PH (14-25% of\nsevere BPD)", fillcolor="#f2b8b8"];
    RVH [label="RV hypertrophy /\nFulton index"];
    RV_function [label="RV dysfunction\n(TAPSE, RV strain)"];
    Cor_pulmonale [label="Cor pulmonale /\ndeath (up to 40%\nmortality in BPD-PH)", fillcolor="#ef9c9c"];
    PVS_stenosis [label="Pulmonary vein stenosis\n(distinct phenotype)"];
    Collaterals [label="Systemic-to-pulmonary\ncollaterals"];
  }

  //==========================================================================
  subgraph cluster_nutrition {
    label="13. Nutrition, Growth and the Systemic Cost"; style=filled; color="#dff0ea"; fillcolor="#eef8f4";
    Energy_expend [label="Increased work of\nbreathing / energy\nexpenditure (+25%)"];
    Protein_energy [label="Cumulative protein-energy\ndeficit (first weeks)", fillcolor="#f7d6d6"];
    Weight_gain [label="Postnatal weight gain\nvelocity (g/kg/d)", fillcolor="#f0c674"];
    Growth_failure [label="Postnatal growth failure\n(itself a BPD risk factor)"];
    VitA_status [label="Vitamin A / retinol\nstatus (<20 ug/dL common)"];
    VitD_status [label="Vitamin D status"];
    Inositol_status [label="Myo-inositol"];
    Anemia_transf [label="Anaemia of prematurity /\ntransfusion exposure"];
    Steroid_catabolic [label="Steroid catabolic effect\n(growth arrest, hyperglycaemia)", fillcolor="#f7d6d6"];
    Weight_dosing [label="WEIGHT drives mg/kg dosing\nAND clearance scaling", fillcolor="#f0c674", shape=octagon];
  }

  //==========================================================================
  subgraph cluster_pharm {
    label="14. Pharmacology — PK/PD of the whole BPD armamentarium"; style=filled; color="#d8e8f8"; fillcolor="#eaf3fc";
    Caffeine_dose [label="CAFFEINE citrate\n20 mg/kg load +\n5-10 mg/kg/d", fillcolor="#a8d8f5"];
    Caffeine_PK [label="Caffeine PK: Vd 0.8-0.9 L/kg,\nCL matures 0.0087 ->\n0.1 L/h/kg; t1/2 100 h -> 5 h"];
    Caffeine_A1A2 [label="Adenosine A1 / A2A\nreceptor antagonism"];
    Caffeine_drive [label="Central respiratory drive up,\napnoea down, EXTUBATION\nEARLIER (exposure arm)", fillcolor="#d6f5d6"];
    Caffeine_alv [label="Direct A2A effect on\nalveolarisation (small\nbiology arm)"];
    Dexamethasone [label="DEXAMETHASONE (DART:\n0.15 -> 0.02 mg/kg/d,\ncumulative 0.89 mg/kg)", fillcolor="#f9d5ae"];
    Dex_PK [label="Dex PK: Vd ~1 L/kg,\nCL ~0.15 L/h/kg,\nt1/2 4-9 h"];
    Hydrocortisone [label="HYDROCORTISONE (PREMILOC:\n0.5 mg/kg BID x7d + 0.5\nx3d = 8.5 mg/kg)", fillcolor="#a8d8f5"];
    HC_PK [label="HC PK: t1/2 2-4 h;\n~25-30x less potent\nthan dexamethasone"];
    GR_binding [label="Glucocorticoid receptor\n(NR3C1) occupancy"];
    GR_transrepress [label="GR transrepression of\nNF-kB / AP-1", fillcolor="#d6f5d6"];
    GR_antiprolif [label="GR antiproliferative effect\nON SEPTATION ITSELF\n(the hidden cost)", fillcolor="#f7d6d6"];
    Budesonide_IT [label="BUDESONIDE + surfactant\nintratracheal 0.25 mg/kg\n(lung-targeted)", fillcolor="#a8d8f5"];
    Budeso_lung [label="High lung / low systemic\nexposure ratio"];
    VitaminA_IM [label="VITAMIN A 5000 IU IM\n3x/wk x 4 wk\n(Tyson regimen)", fillcolor="#a8d8f5"];
    VitA_PK [label="Retinyl palmitate ->\nhepatic store -> retinol/RBP\n-> RA_RAR"];
    Azithromycin [label="AZITHROMYCIN 10 mg/kg/d\n(Ureaplasma-directed)", fillcolor="#a8d8f5"];
    Azithro_dual [label="Anti-Ureaplasma +\nanti-inflammatory\n(subgroup drug)"];
    Sildenafil [label="SILDENAFIL 0.5-2 mg/kg\nq6-8h (BPD-PH)", fillcolor="#a8d8f5"];
    Sild_PK [label="CYP3A4 / high first-pass;\nimmature CL -> long t1/2"];
    iNO [label="INHALED NO 5-20 ppm\n(no 36-wk BPD benefit)", fillcolor="#f9d5ae"];
    Bosentan_ERA [label="BOSENTAN / ambrisentan\n(ETA blockade)"];
    Furosemide [label="FUROSEMIDE 1 mg/kg /\nchlorothiazide", fillcolor="#f9d5ae"];
    Furo_effect [label="Lung water down, FiO2 down\nWITHIN HOURS; 36-wk\nsurface UNCHANGED", fillcolor="#f7d6d6"];
    Bronchodilator [label="Albuterol / ipratropium\n(symptomatic only)"];
    Surfactant_rx [label="SURFACTANT (poractant,\nberactant) +/- LISA", fillcolor="#a8d8f5"];
    PDA_rx [label="INDOMETHACIN / IBUPROFEN /\nACETAMINOPHEN (PDA closure)"];
    MSC_therapy [label="MSC / PNEUMOSTEM\n(intratracheal, phase II)", fillcolor="#d6f5d6"];
    rhIGF1_BP3 [label="rhIGF-1 / rhIGFBP-3\n(mecasermin rinfabate,\nphase II)", fillcolor="#d6f5d6"];
    IL1Ra [label="IL-1Ra / anakinra\n(preclinical)", fillcolor="#d6f5d6"];
    Nutrition_rx [label="Aggressive early protein /\nenergy + fortified milk"];
  }

  //==========================================================================
  subgraph cluster_endpoints {
    label="15. Clinical Endpoints, Trade-offs and the Long Trajectory"; style=filled; color="#f0e0e0"; fillcolor="#faf0f0";
    PMA36 [label="36 WEEKS PMA\n(the definitional clock stop)", fillcolor="#e8983c", shape=octagon];
    Grade1 [label="BPD grade 1\n(nasal cannula <=2 L/min)"];
    Grade2 [label="BPD grade 2\n(>2 L/min or nCPAP/NIPPV)", fillcolor="#f9d5ae"];
    Grade3 [label="BPD grade 3\n(invasive MV)", fillcolor="#f7d6d6"];
    Death_before36 [label="Death before 36 wk PMA\n(competing risk -\nMUST be a composite)", fillcolor="#ef9c9c"];
    BPDfree_surv [label="Survival WITHOUT BPD\n(the trial endpoint)", fillcolor="#d6f5d6", shape=doubleoctagon];
    Vent_days [label="Ventilator days /\ndays of supplemental O2"];
    LOS_days [label="Length of stay"];
    Home_O2 [label="Discharge on home oxygen"];
    ROP_severe [label="Severe ROP\n(shared O2 exposure)"];
    IVH_PVL [label="IVH grade 3-4 / PVL"];
    CP_NDI [label="Cerebral palsy /\nneurodevelopmental impairment\nat 18-24 months", fillcolor="#ef9c9c", shape=octagon];
    NDI_cost [label="NDI COST ACCUMULATOR\ndexamethasone-equivalent x\nearly-window weight", fillcolor="#e8983c", shape=doubleoctagon];
    Net_utility [label="NET UTILITY = BPD-free survival\nMINUS w x NDI\n(why early high-dose dex\nwas abandoned)", fillcolor="#e8983c", shape=doubleoctagon];
    Rehosp [label="Rehospitalisation in\nfirst 2 years (RSV,\nwheeze)"];
    Child_asthma [label="Childhood asthma-like\nphenotype / reduced FEV1"];
    Adult_COPD [label="Adult COPD-like trajectory\n(lower FEV1 plateau,\nnever caught up)", fillcolor="#f7d6d6"];
    Exercise_cap [label="Reduced exercise capacity /\nVO2max in adolescence"];
    PH_mortality [label="BPD-PH attributable\nmortality"];
  }

  //==========================================================================
  // ---- 1. Antenatal substrate -> programme + gate ------------------------
  GA_birth -> Fetal_lung_stage [label="determines stage"];
  GA_birth -> Surfactant_def;
  GA_birth -> AOX_immature [label="<34 wk"];
  GA_birth -> Window_integral [label="how much programme\nis still ahead"];
  Fetal_lung_stage -> Saccular_stage;
  Fetal_lung_stage -> S_dev;
  Birthweight -> Weight_dosing;
  IUGR -> IGF1_axis [label="-", color=blue];
