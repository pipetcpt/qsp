  // Legend
  subgraph cluster_legend {
    label="Legend / Reading the map"; style=filled; color="#dddddd"; fillcolor="#f7f7f7"; fontsize=12;
    L1 [label="Octagon / double octagon =\nSTATE VARIABLE with a\ncorresponding ODE or counter", shape=doubleoctagon, fillcolor="#ffffff"];
    L2 [label="Red edge = injury / arrest\nBlue edge = suppression by\ntherapy or physiology\nGreen edge = growth-promoting", fillcolor="#ffffff"];
    L3 [label="Dashed edge = trialled but\nNULL or unproven effect\n(kept in the map on purpose)", fillcolor="#ffffff"];
    L4 [label="Blue box = therapy with a\npositive 36-wk trial signal\nOrange box = therapy that moves\na number but not the endpoint", fillcolor="#ffffff"];
    L5 [label="THE CENTRAL CLAIM:\nBPD outcome = INTEGRAL of\nS_dev(PMA) x G(t) dt,\nso TIMING beats POTENCY", fillcolor="#ffe9c9"];
    L1 -> L2 [style=invis]; L2 -> L3 [style=invis]; L3 -> L4 [style=invis]; L4 -> L5 [style=invis];
  }
