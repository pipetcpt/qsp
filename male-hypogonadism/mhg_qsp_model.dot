        LIBIDO    [label="성적 욕구 (libido)\nT·E2 모두 의존 · 용량 연속적", fillcolor="#b9e0e0", penwidth=1.3];
        MPOA      [label="내측 시삭전야 (MPOA)\n도파민 · 옥시토신"];
