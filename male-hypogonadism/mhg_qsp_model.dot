    GC_SUPP -> CRH_N; PROLACT -> PRL_S; PITAD -> GONADO [label="−", color="#c0392b"];
    AAS_PRIOR -> AR_HYPO [label="장기 억제", color="#c0392b"];

    /* ===================== 11. FUNCTIONAL / OBESITY CYCLE ===================== */
    subgraph cluster_func {
        label="⑪ 기능성 성선기능저하증 — 비만·염증 자기강화 고리 (가역적)";
        style="rounded,filled"; fillcolor="#fdf6e8"; color="#d9b45a"; fontsize=11; fontcolor="#8a6a10";
        node [fillcolor="#faeccc"];
        OBESITY   [label="내장 비만 (BMI ≥30)\n기능성 성선저하의 최대 원인", penwidth=1.4];
        AROM_UP   [label="지방 아로마타제 활성 ↑\n→ E2 ↑"];
        IR_FUNC   [label="인슐린 저항성"];
        TNF_IL6   [label="TNF-α / IL-6 / 지방조직 대식세포\n→ KNDy 직접 억제"];
        LEP_RES   [label="렙틴 저항성\n→ kisspeptin 자극 소실"];
        OSA_F     [label="폐쇄성 수면무호흡 (OSA)\n수면분절 → 야간 LH 박동 소실"];
        SLEEP     [label="수면부족 / 교대근무\nTT −10-15%"];
        T2DM_F    [label="제2형 당뇨병\n남성의 ~30-40%에서 저 TT 동반"];
        VICIOUS   [label="⚑ 악순환 고리\n비만 → E2↑·염증↑ → LH↓ → T↓\n→ 제지방↓·지방↑ → 비만 ↑", shape=note, fillcolor="#f9e0a0", penwidth=1.6, fontsize=8];
        WT_LOSS   [label="체중 감량 / 대사수술\n10% 감량당 TT +2-3 nmol/L", fillcolor="#d5efd0"];
