/*
 * mhg_qsp_model.dot — Male Hypogonadism (남성 성선기능저하증)
 * Quantitative Systems Pharmacology mechanistic map
 *
 * ORGANISING IDEA
 * ---------------
 * The quantity that is measured (total testosterone) is not the quantity that
 * acts (free testosterone), and the map between them is a nonlinear mass-action
 * binding equilibrium whose dominant partner — SHBG — is itself a regulated
 * state variable, driven in opposite directions by the disease (obesity,
 * insulin resistance -> SHBG down), by ageing (SHBG up ~1%/yr) and by the
 * treatment (androgen -> SHBG down). Two consequences propagate through this
 * whole map and are what the accompanying mrgsolve model computes:
 *
 *   (1) FREE T IS A CONVEX FUNCTION OF TOTAL T. The SHBG buffer saturates, so
 *       free fraction rises from 1.75% at TT 100 ng/dL to 2.75% at TT 2000.
 *       By Jensen's inequality a peaky regimen delivers MORE time-averaged
 *       free T than a flat regimen at the same mean total T. Verified in the
 *       mrgsolve model: every second difference of FT(TT) is positive.
 *   (2) BUT THE CONVEXITIES DO NOT STACK, AND THE MODEL SAYS SO AGAINST THE
 *       HYPOTHESIS IT WAS BUILT TO EXPRESS. The erythropoietic response is
 *       convex only in its lower limb; supraphysiologic peaks overshoot the
 *       Hill midpoint into the CONCAVE upper limb, so the response step
 *       contributes a Jensen gap of ~zero or slightly NEGATIVE for exactly
 *       the peaky regimens that were supposed to benefit. At matched weekly
 *       dose the whole waveform effect on haematocrit is ~0.1 points.
 *       What actually manufactures the ~3x excess of erythrocytosis on IM
 *       versus transdermal is a FIXED THRESHOLD (Hct > 54%) applied to a
 *       spread-out population — a property of the stopping rule, not of the
 *       molecule. The pink notes in cluster 12 carry this result.
 *
 * The third axis of the map is the FEEDBACK LOOP that exogenous androgen
 * breaks: LH -> Leydig -> intratesticular testosterone (ITT, ~35-100x serum)
 * -> spermatogenesis. Serum T can be normalised while ITT collapses, which is
 * why "replacement" and "fertility" are different therapeutic problems.
 *
 * Clusters: 22 (+ legend) · Nodes: 224 · Edges: 268
 * Render:  dot -Tsvg mhg_qsp_model.dot -o mhg_qsp_model.svg
 *          dot -Tpng -Gdpi=150 mhg_qsp_model.dot -o mhg_qsp_model.png
 */

digraph MaleHypogonadism_QSP {
    graph [rankdir=TB, splines=spline, overlap=false, nodesep=0.30, ranksep=0.55,
           fontname="Helvetica", fontsize=11, compound=true,
           labelloc="t", fontcolor="#1a1a1a",
           label="남성 성선기능저하증 (Male Hypogonadism) — QSP Mechanistic Map\nHPG axis · SHBG binding equilibrium · intratesticular testosterone · erythropoiesis · bone · body composition · 7 testosterone formulations + 5 non-androgen strategies"];
    node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=9,
           penwidth=0.8, color="#5a5a5a", margin="0.07,0.045"];
    edge  [fontname="Helvetica", fontsize=7.5, arrowsize=0.6, penwidth=0.9, color="#666666"];

    /* ===================== 1. HYPOTHALAMUS / KNDy ===================== */
    subgraph cluster_hypo {
        label="① 시상하부 — GnRH 박동 생성기 (KNDy neurons)";
        style="rounded,filled"; fillcolor="#f2f6fd"; color="#7fa6d9"; fontsize=11; fontcolor="#28496f";
        node [fillcolor="#dde9f9"];
        KISS1     [label="KISS1 뉴런 (ARC/AVPV)\nkisspeptin-54/10"];
        NKB       [label="Neurokinin B (TAC3)\n→ NK3R 자가자극"];
        DYN       [label="Dynorphin (PDYN)\n→ KOR 자가억제"];
        KNDy      [label="KNDy 박동 생성기\npulse generator"];
        KISS1R    [label="KISS1R (GPR54)\nGnRH 뉴런 표면"];
        GNRH_N    [label="GnRH 뉴런 (~2,000개)\n중격-시삭전야"];
        GNRH_PULS [label="GnRH 박동\n빈도 ~8-14 pulse/24h\n진폭"];
        PORTAL    [label="시상하부-뇌하수체\n문맥 순환"];
        AR_HYPO   [label="AR (시상하부)\n음성 되먹임 수용체"];
        ERA_HYPO  [label="ERα (ESR1, 시상하부)\nE2 음성 되먹임 — 지배적"];
        LEP_HYPO  [label="Leptin 신호 (LEPR)\n대사적 관문 (permissive)"];
        GHRELIN   [label="Ghrelin / 에너지 결핍\nGnRH 억제"];
        CRH_N     [label="CRH / 스트레스 축\nGnRH 억제"];
        OPIOID_R  [label="μ-opioid 수용체\n(외인성 아편유사제)"];
        KNDy -> KISS1R [label="kisspeptin"];
        KISS1 -> KNDy; NKB -> KNDy [label="+ (NK3R)"];
        DYN -> KNDy [label="− (KOR)", color="#c0392b"];
        KISS1R -> GNRH_N; GNRH_N -> GNRH_PULS -> PORTAL;
        AR_HYPO -> KNDy [label="− DHT/T", color="#c0392b"];
        ERA_HYPO -> KNDy [label="−− E2 (지배적)", color="#c0392b", penwidth=1.4];
        LEP_HYPO -> KISS1 [label="+ permissive"];
        GHRELIN -> KISS1 [label="−", color="#c0392b"];
        CRH_N -> GNRH_PULS [label="−", color="#c0392b"];
        OPIOID_R -> DYN [label="+ KOR/MOR", color="#c0392b"];
    }

    /* ===================== 2. PITUITARY ===================== */
    subgraph cluster_pit {
        label="② 뇌하수체 전엽 — 성선자극세포 (gonadotrope)";
        style="rounded,filled"; fillcolor="#f2f6fd"; color="#7fa6d9"; fontsize=11; fontcolor="#28496f";
        node [fillcolor="#dde9f9"];
        GNRHR     [label="GnRH 수용체 (GNRHR)\nGq/11 → PLC → Ca²⁺/PKC"];
        GONADO    [label="성선자극세포\n(전엽의 ~10%)"];
        LHB       [label="LHB 전사\n(고빈도 박동 선호)"];
        FSHB      [label="FSHB 전사\n(저빈도 박동 선호)"];
        CGA       [label="CGA (공통 α-subunit)"];
        LH_S      [label="혈청 LH\n1-9 IU/L · t½ ~30-60 min\n박동성"];
        FSH_S     [label="혈청 FSH\n1-12 IU/L · t½ ~3-4 h\n비박동성"];
        PRL_S     [label="혈청 프로락틴\n(고프로락틴혈증 → GnRH 억제)"];
        AR_PIT    [label="AR (뇌하수체)\n음성 되먹임"];
        FOLLI     [label="Follistatin (국소)\nactivin 중화"];
        ACTIVIN   [label="Activin B (국소)\nFSHB 자극"];
        GNRHR -> GONADO; GONADO -> LHB; GONADO -> FSHB; CGA -> LH_S; CGA -> FSH_S;
        LHB -> LH_S; FSHB -> FSH_S;
        AR_PIT -> LHB [label="−", color="#c0392b"];
        ACTIVIN -> FSHB [label="+"]; FOLLI -> ACTIVIN [label="−", color="#c0392b"];
        PRL_S -> GNRHR [label="− (via KNDy)", style=dashed, color="#c0392b"];
    }
    PORTAL -> GNRHR [label="GnRH 박동"];

    /* ===================== 3. LEYDIG / STEROIDOGENESIS ===================== */
    subgraph cluster_leydig {
        label="③ 고환 — Leydig 세포 스테로이드생성";
        style="rounded,filled"; fillcolor="#fdf4ee"; color="#dd9a6a"; fontsize=11; fontcolor="#8a4f1d";
        node [fillcolor="#fbe6d6"];
        LHCGR     [label="LHCGR (LH/hCG 수용체)\nGs 공유 — hCG t½ 훨씬 김"];
        CAMP      [label="cAMP / PKA"];
        STAR      [label="StAR 단백\n율속 단계: 콜레스테롤 미토콘드리아 유입"];
        CHOL_L    [label="세포내 콜레스테롤 풀\n(LDLR / de novo / CE)"];
        CYP11A1   [label="CYP11A1 (P450scc)\n→ 프레그네놀론"];
        CYP17A1   [label="CYP17A1 (17α-OH/17,20-lyase)"];
        HSD3B2    [label="HSD3B2"];
        HSD17B3   [label="HSD17B3\n→ 테스토스테론"];
        LEYDIG_M  [label="Leydig 세포 질량/기능\n(노화·화학요법·방사선에 취약)"];
        ITT       [label="고환내 테스토스테론 (ITT)\n~600-1,250 nmol/L\n혈청의 ~35-100배", fillcolor="#f6c9a2", penwidth=1.6];
        INSL3     [label="INSL3\nLeydig 기능 바이오마커"];
        LHCGR -> CAMP -> STAR -> CYP11A1 -> CYP17A1 -> HSD3B2 -> HSD17B3 -> ITT;
        CHOL_L -> STAR; LEYDIG_M -> LHCGR; LEYDIG_M -> INSL3;
        CAMP -> CHOL_L [label="+ HSL/LDLR"];
    }
    LH_S -> LHCGR [label="박동성 자극", penwidth=1.3];

    /* ===================== 4. SERTOLI / SPERMATOGENESIS ===================== */
    subgraph cluster_sertoli {
        label="④ 고환 — Sertoli 세포 및 정자형성 (74일 주기 + 부고환 통과)";
        style="rounded,filled"; fillcolor="#fdf4ee"; color="#dd9a6a"; fontsize=11; fontcolor="#8a4f1d";
        node [fillcolor="#fbe6d6"];
        FSHR      [label="FSHR (Sertoli 세포)"];
        SERTOLI   [label="Sertoli 세포 지지 능력\n(정자 생산의 상한 결정)"];
        ABP       [label="Androgen-binding protein\n(고환 SHBG) → ITT 농축"];
        AR_SERT   [label="AR (Sertoli)\nITT 의존 — 필수"];
        BTB       [label="혈액-고환 장벽\n(tight junction)"];
        SPGONIA   [label="정조세포 (spermatogonia)\nA_dark / A_pale / B"];
        SPCYTE    [label="정모세포 (spermatocyte)\n감수분열 I/II"];
        SPTID     [label="정자세포 (spermatid)\n정자변태 spermiogenesis"];
        SPZOA     [label="정자 (spermatozoa)\n정세관 방출"];
        EPIDID    [label="부고환 통과\n~10-14일 성숙"];
        SPERM_OUT [label="사정 정자 농도\n정상 ≥16 M/mL (WHO 6판)", fillcolor="#f6c9a2", penwidth=1.4];
        INHB      [label="Inhibin B\nSertoli 유래 · FSH 음성 되먹임"];
        AMH_S     [label="AMH (미성숙 Sertoli 표지)"];
        SPERM_THR [label="ITT 역치\n정상의 ~20-30% 미만 → 정자형성 정지", shape=note, fillcolor="#fdebd0"];
        FSHR -> SERTOLI -> ABP; SERTOLI -> BTB; SERTOLI -> INHB; SERTOLI -> AMH_S;
        AR_SERT -> SPGONIA [label="+ 필수"];
        SPGONIA -> SPCYTE -> SPTID -> SPZOA -> EPIDID -> SPERM_OUT;
        SERTOLI -> SPCYTE [label="지지 용량"];
        SPERM_THR -> SPGONIA [style=dashed, color="#c0392b"];
        ABP -> AR_SERT;
    }
    FSH_S -> FSHR [penwidth=1.2];
    ITT -> AR_SERT [label="ITT → AR 점유", penwidth=1.6, color="#b9770e"];
    ITT -> SPERM_THR [style=dashed];
    INHB -> FSHB [label="− 선택적", color="#c0392b", lhead=cluster_pit];

    /* ===================== 5. BINDING EQUILIBRIUM (CORE) ===================== */
    subgraph cluster_bind {
        label="⑤ 순환 결합 평형 — 이 지도의 수학적 중심 (Vermeulen 질량작용)";
        style="rounded,filled"; fillcolor="#fdf2f6"; color="#d98cae"; fontsize=11; fontcolor="#8e2f5a";
        node [fillcolor="#fadbe8"];
        T_TOT     [label="총 테스토스테론 (TT)\n측정되는 값 · 정상 300-1,000 ng/dL", penwidth=1.5];
        T_FREE    [label="유리 테스토스테론 (FT)\n작용하는 값 · ~2% · 50-210 pg/mL", fillcolor="#f2a7c9", penwidth=1.8];
        T_ALB     [label="알부민 결합 T (~44%)\nK_A ≈ 3.6×10⁴ M⁻¹ · 저친화·고용량"];
        T_SHBG    [label="SHBG 결합 T (~54%)\nK_S ≈ 1.0×10⁹ M⁻¹ · 고친화·포화성"];
        T_BIO     [label="생체이용 T (FT + 알부민결합)\n≈ 46%"];
        SHBG_P    [label="혈청 SHBG\n10-80 nmol/L — 조절되는 상태변수", penwidth=1.5];
        ALB_P     [label="혈청 알부민 (4.3 g/dL)"];
        VERM      [label="Vermeulen 2차방정식\naFT² + bFT − T = 0\na = N·K_S,  b = N + K_S·S − K_S·T\nN = 1 + K_A·[Alb]", shape=note, fillcolor="#fce4ec", fontsize=8];
        CONVEX    [label="⚑ 볼록성 (CONVEXITY)\n유리분율: TT 300 → 1.9%\nTT 1000 → 2.3% · TT 2000 → 2.8%\n⇒ FT는 TT의 볼록함수", shape=note, fillcolor="#f8bbd0", penwidth=1.6, fontsize=8];
        JENSEN    [label="⚑ Jensen 부등식\nE[FT(TT)] ≥ FT(E[TT])\n같은 평균 TT라도 진폭이 큰 요법이\n시간평균 유리 T를 더 많이 전달", shape=note, fillcolor="#f8bbd0", penwidth=1.6, fontsize=8];
        T_TOT -> T_FREE; T_TOT -> T_ALB; T_TOT -> T_SHBG;
        SHBG_P -> T_SHBG [penwidth=1.4]; ALB_P -> T_ALB;
        T_FREE -> T_BIO; T_ALB -> T_BIO;
        VERM -> T_FREE [style=dashed]; CONVEX -> JENSEN [style=dashed];
        T_SHBG -> CONVEX [style=dashed, label="포화"];
    }
    ITT -> T_TOT [label="혈류 유출 · 생산 ~6 mg/day", penwidth=1.4];

    /* ===================== 6. SHBG REGULATION ===================== */
    subgraph cluster_shbg {
        label="⑥ SHBG 조절 — 질환·치료·노화가 서로 반대로 민다";
        style="rounded,filled"; fillcolor="#fdf2f6"; color="#d98cae"; fontsize=11; fontcolor="#8e2f5a";
        node [fillcolor="#fadbe8"];
        HNF4A     [label="간세포 HNF-4α\nSHBG 프로모터 주 조절자"];
        SHBG_SYN  [label="간 SHBG 합성 (SHBG 유전자 17p13)"];
        INS_SHBG  [label="인슐린 / 인슐린 저항성\n→ HNF-4α ↓ → SHBG ↓", fillcolor="#f7c6d9"];
        DNL_SHBG  [label="간 de novo 지방생성 / 단당류\n→ SHBG ↓"];
        T4_SHBG   [label="갑상선호르몬 (T3/T4)\n→ SHBG ↑"];
        E2_SHBG   [label="에스트로겐 (E2)\n→ SHBG ↑"];
        AND_SHBG  [label="안드로겐 (T/DHT)\n→ SHBG ↓ (치료 효과)", fillcolor="#f7c6d9"];
        AGE_SHBG  [label="노화\n→ SHBG ↑ 약 1%/년", fillcolor="#f7c6d9"];
        CIRR_SHBG [label="간경변 / 알코올\n→ SHBG ↑"];
        OPP       [label="⚑ 반대 방향 이동\n비만 치료 시 TT↑ 와 SHBG↓ 가 동시에\n⇒ FT 상승폭 > TT 상승폭", shape=note, fillcolor="#f8bbd0", penwidth=1.5, fontsize=8];
        HNF4A -> SHBG_SYN;
        INS_SHBG -> HNF4A [label="−", color="#c0392b"]; DNL_SHBG -> HNF4A [label="−", color="#c0392b"];
        T4_SHBG -> SHBG_SYN [label="+"]; E2_SHBG -> SHBG_SYN [label="+"];
        AND_SHBG -> SHBG_SYN [label="−", color="#c0392b"]; AGE_SHBG -> SHBG_SYN [label="+"];
        CIRR_SHBG -> SHBG_SYN [label="+"];
        INS_SHBG -> OPP [style=dashed]; AND_SHBG -> OPP [style=dashed];
    }
    SHBG_SYN -> SHBG_P [label="분비", penwidth=1.3];

    /* ===================== 7. PERIPHERAL METABOLISM ===================== */
    subgraph cluster_metab {
        label="⑦ 말초 대사 — 하나의 호르몬이 세 갈래로 갈린다";
        style="rounded,filled"; fillcolor="#f5f9f0"; color="#8fbc6b"; fontsize=11; fontcolor="#4a6b2a";
        node [fillcolor="#e3f0d5"];
        SRD5A1    [label="SRD5A1 (간·피부)"];
        SRD5A2    [label="SRD5A2 (전립선·생식기)\n→ 피나스테리드/두타스테리드 표적"];
        DHT_S     [label="DHT (5α-DHT)\nAR 친화도 T의 ~2-5배\n방향화 불가", fillcolor="#cfe4bb", penwidth=1.3];
        CYP19A1   [label="CYP19A1 (아로마타제)\n지방조직 우세 — 지방량에 비례", penwidth=1.3];
        E2_S      [label="에스트라디올 (E2)\n남성 20-40 pg/mL\n골·지방·성욕에 필수", fillcolor="#cfe4bb", penwidth=1.4];
        ARO_FAT   [label="지방조직 질량\n= 아로마타제 용량", fillcolor="#dbead0"];
        HSD3A     [label="3α-HSD → 안드로스탄디올\n글루쿠로나이드 (5α 활성 표지)"];
        UGT2B17   [label="UGT2B17 글루쿠로닌화\n(아시아인 결손 다형성 흔함)"];
        HEP_CL    [label="간 청소 (CL)\n생체이용 분획에만 작용\n⇒ SHBG↓ 시 CL↑", shape=note, fillcolor="#eef7e4", fontsize=8];
        URINE_T   [label="요중 T/E 비\n(도핑 검사)"];
        SRD5A1 -> DHT_S; SRD5A2 -> DHT_S; DHT_S -> HSD3A -> UGT2B17 -> URINE_T;
        CYP19A1 -> E2_S; ARO_FAT -> CYP19A1 [label="+ 용량", penwidth=1.3];
    }
    T_FREE -> SRD5A1; T_FREE -> SRD5A2; T_FREE -> CYP19A1 [penwidth=1.2];
    T_BIO -> HEP_CL [label="청소 기질"]; HEP_CL -> T_TOT [label="− 제거", color="#c0392b"];
    E2_S -> ERA_HYPO [label="주 되먹임 신호", penwidth=1.5, color="#c0392b"];
    E2_S -> E2_SHBG; DHT_S -> AND_SHBG; T_FREE -> AND_SHBG;
    T_FREE -> AR_HYPO; T_FREE -> AR_PIT;

    /* ===================== 8. RECEPTOR SIGNALLING ===================== */
    subgraph cluster_ar {
        label="⑧ 수용체 신호전달 — AR / ER";
        style="rounded,filled"; fillcolor="#f5f9f0"; color="#8fbc6b"; fontsize=11; fontcolor="#4a6b2a";
        node [fillcolor="#e3f0d5"];
        AR        [label="안드로겐 수용체 (AR, Xq12)"];
        CAG       [label="CAG 반복 길이 (exon 1)\n짧을수록 전사활성 ↑ — 개체간 변이"];
        HSP90     [label="HSP90 샤페론 복합체"];
        AR_NUC    [label="AR 이량체 핵 전위"];
        ARE       [label="ARE (androgen response element)\n표적 유전자 전사"];
        COACT     [label="공활성자 (SRC-1/ARA70/p160)"];
        AR_NG     [label="비유전체 AR 신호\nSrc/MAPK · 초 단위"];
        ESR1_P    [label="ERα (ESR1) — 골·지방·되먹임"];
        ESR2_P    [label="ERβ (ESR2)"];
        GPER      [label="GPER1 (막 ER)"];
        AIS       [label="AR 변이 (부분 안드로겐 불응증)\n표적 저항성", shape=note, fillcolor="#eef7e4", fontsize=8];
        AR -> HSP90 -> AR_NUC -> ARE; CAG -> AR [label="전사활성 조절"];
        COACT -> ARE; AR -> AR_NG; AIS -> AR [style=dashed, color="#c0392b"];
    }
    T_FREE -> AR [penwidth=1.4]; DHT_S -> AR [label="고친화", penwidth=1.4];
    E2_S -> ESR1_P; E2_S -> ESR2_P; E2_S -> GPER;

    /* ===================== 9. PRIMARY (TESTICULAR) AETIOLOGY ===================== */
    subgraph cluster_prim {
        label="⑨ 원발성(고환성) 성선기능저하증 — LH/FSH ↑";
        style="rounded,filled"; fillcolor="#fbf1f1"; color="#d98080"; fontsize=11; fontcolor="#8e2323";
        node [fillcolor="#f7dcdc"];
        KLINE     [label="클라인펠터 증후군 47,XXY\n남성 1/600 · 최다 유전 원인"];
        CRYPT     [label="정류고환 (cryptorchidism)"];
        ORCHITIS  [label="이하선염 고환염 / 외상"];
        CHEMO     [label="알킬화 항암제 / 방사선\nLeydig·정조세포 소실"];
        VARICO    [label="정계정맥류"];
