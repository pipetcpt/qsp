        RETIC     [label="망상적혈구 (~1-2일)"];
        RBC_M     [label="적혈구 질량\n수명 ~120일 — 신호를 적분", penwidth=1.4];
        HCT       [label="헤마토크리트 (Hct)\n중지 기준 >54%", fillcolor="#f2b8c0", penwidth=1.5];
        VISCOS    [label="혈액 점도 ↑\n(Hct에 초선형)"];
        PHLEB     [label="치료적 사혈 / 용량 감량 / 제형 변경", fillcolor="#d5efd0"];
        CONVEX2   [label="⚑ 두 번째 볼록성은 합성되지 않는다\n적혈구 반응은 낮은 구간에서만 볼록하고\n초생리적 첨두는 Hill의 오목한 상단으로 넘어간다\n⇒ 모델 결과: 첨두 이득 ≈ 0 또는 음수\n(가설을 반증한 지점 — 숨기지 않고 출력)", shape=note, fillcolor="#f8bbd0", penwidth=1.6, fontsize=8];
        THRESH    [label="⚑ 격차를 만드는 것은 판정 규칙\nHct>54% 고정 역치를 집단 분포에 적용하면\n평균 ~1점 이동이 발생률 ~2.5배 차이가 된다\n⇒ 분자가 아니라 중지 기준의 성질", shape=note, fillcolor="#f8bbd0", penwidth=1.6, fontsize=8];
        HEPCIDIN -> FPN [label="− 분해", color="#c0392b"]; FPN -> IRON_AV;
        ERFE -> HEPCIDIN [label="−", color="#c0392b"];
        IRON_AV -> BFUE; EPO_K -> BFUE -> RETIC -> RBC_M -> HCT -> VISCOS;
        BFUE -> ERFE; PHLEB -> HCT [label="−", color="#1e8449"];
        CONVEX2 -> HEPCIDIN [style=dashed];
        HCT -> THRESH [style=dashed, penwidth=1.3];
    }
    T_FREE -> HEPCIDIN [label="− 억제", color="#c0392b", penwidth=1.4];
    T_FREE -> EPO_K [label="+ 설정점", penwidth=1.3];
    JENSEN -> CONVEX2 [style=dashed, label="합성되지 않음", penwidth=1.3, color="#c0392b"];

    /* ===================== 13. BONE ===================== */
    subgraph cluster_bone {
        label="⑬ 골 — 효과는 대부분 T가 아니라 E2를 통한다";
