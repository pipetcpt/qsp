    /* ===================== 18. TESTOSTERONE FORMULATION PK ===================== */
    subgraph cluster_pk {
        label="⑱ 테스토스테론 제형 PK — 같은 주간 용량, 다른 파형";
        style="rounded,filled"; fillcolor="#eef0f4"; color="#8a93a8"; fontsize=11; fontcolor="#39415a";
        node [fillcolor="#dbe0e8"];
        TE_IM     [label="테스토스테론 에난트산/시피온산 IM\n100-200 mg q1-2wk · ka ~0.15/day\n첨두 1,100-1,500 → 저점 300 ng/dL", penwidth=1.3];
        TU_IM     [label="테스토스테론 운데칸산 IM (Nebido/Aveed)\n750-1,000 mg q10-12wk · 매우 느린 방출\n⚠ 폐 오일 미세색전 (POME)"];
        TU_PO     [label="경구 테스토스테론 운데칸산\n(Jatenzo/Kyzatrex) 158-396 mg BID\n림프 흡수 · 지방식 의존 · 첨두 높음"];
        GEL_TD    [label="경피 겔 1.62% 20.25-81 mg/day\n준정상상태 · 일중 변동 작음\n⚠ 이차 전이 (secondary transfer)", penwidth=1.3];
        SC_AI     [label="피하 자동주사기 (Xyosted)\n50-100 mg 주 1회 · 파형 완만", penwidth=1.2];
        PELLET    [label="피하 펠릿 (Testopel)\n6-12개 q3-6개월 · 준영차 방출"];
        NASAL_T   [label="비강 겔 (Natesto) 11 mg TID\n짧은 첨두 · LH 억제 최소"];
        ESTER_H   [label="에스테르 가수분해 (혈장/조직 에스터라제)\n시피온산 mol 환산 계수 0.70\n에난트산 0.72 · 운데칸산 0.63"];
        FLIPFLOP  [label="흡수율속 (flip-flop) 동태\n겉보기 t½ = 흡수 t½", shape=note, fillcolor="#e8ebf0", fontsize=8];
        WAVEFORM  [label="⚑ 파형: 예상보다 작다\n같은 주간 용량에서 진폭을 2배로 해도\nHct 차이는 ~0.1점에 불과 (모델 결과)\n제형 간 격차의 대부분은 용량 차이다", shape=note, fillcolor="#f8bbd0", penwidth=1.6, fontsize=8];
        TE_IM -> ESTER_H; TU_IM -> ESTER_H; TU_PO -> ESTER_H; PELLET -> ESTER_H;
        TE_IM -> FLIPFLOP; TU_IM -> FLIPFLOP;
        TE_IM -> WAVEFORM; GEL_TD -> WAVEFORM; SC_AI -> WAVEFORM; TU_PO -> WAVEFORM;
    }
    ESTER_H -> T_TOT [penwidth=1.5]; GEL_TD -> T_TOT [penwidth=1.3]; NASAL_T -> T_TOT;
    WAVEFORM -> JENSEN [style=dashed, penwidth=1.3];

    /* ===================== 19. NON-ANDROGEN THERAPY ===================== */
    subgraph cluster_alt {
        label="⑲ 비안드로겐 전략 — 축을 끄지 않고 올리기 (생식능 보존)";
        style="rounded,filled"; fillcolor="#eef0f4"; color="#8a93a8"; fontsize=11; fontcolor="#39415a";
        node [fillcolor="#dbe0e8"];
        HCG_D     [label="hCG 500-3,000 IU SC 주 2-3회\nLHCGR 작용제 · t½ ~24-36 h", penwidth=1.3];
        HMG_FSH   [label="hMG / 재조합 FSH 75-150 IU\n(Sertoli 지지 — 정자형성 유도)"];
        CLOMI     [label="클로미펜 시트르산염 25-50 mg\nSERM — 시상하부 ERα 차단 → LH↑\nzuclomiphene 축적 (t½ 수 주)", penwidth=1.2];
        ENCLOMI   [label="엔클로미펜 (trans 이성질체)\n축적 적음 · 정자수 보존"];
        ANAST     [label="아나스트로졸 1 mg/day\n아로마타제 억제 → E2↓ → LH↑\n⚠ 골 손실 대가", penwidth=1.2];
        KISSPEP   [label="Kisspeptin-54 유사체 (연구단계)\n상류에서 축 재기동"];
        GNRH_PUMP [label="박동성 GnRH 펌프\n(칼만/nIHH — 생리적 재현)"];
        SARM      [label="선택적 AR 조절제 (SARM, 미승인)\n조직 선택성 주장 · 간독성 신호"];
        FERT_NOTE [label="⚑ 두 개의 다른 문제\n혈청 T 정상화 ≠ ITT 유지.\n생식능이 목표면 LH 신호를 끄면 안 된다.", shape=note, fillcolor="#f8bbd0", penwidth=1.6, fontsize=8];
        HCG_D -> FERT_NOTE [style=dashed]; CLOMI -> ENCLOMI [style=dotted];
    }
    HCG_D -> LHCGR [label="직접 작용 (LH 우회)", penwidth=1.5, color="#1e8449"];
    HMG_FSH -> FSHR [label="+", color="#1e8449", penwidth=1.2];
    CLOMI -> ERA_HYPO [label="− 차단 → LH↑", color="#1e8449", penwidth=1.3];
    ENCLOMI -> ERA_HYPO [label="− 차단", color="#1e8449"];
    ANAST -> CYP19A1 [label="− 억제", color="#c0392b", penwidth=1.3];
    KISSPEP -> KISS1R [color="#1e8449"]; GNRH_PUMP -> GNRHR [color="#1e8449"];
    SARM -> AR [label="부분 작용제"];
    ANAST -> SCLERO [label="E2↓ → 스클레로스틴↑ → 골손실", style=dashed, color="#c0392b"];

    /* ===================== 20. AXIS SUPPRESSION BY EXOGENOUS T ===================== */
    subgraph cluster_supp {
        label="⑳ 외인성 안드로겐에 의한 축 차단 — 치료가 만드는 병태생리";
        style="rounded,filled"; fillcolor="#fdf6e8"; color="#d9b45a"; fontsize=11; fontcolor="#8a6a10";
        node [fillcolor="#faeccc"];
        SUPP_LH   [label="LH 억제 (수일 내 검출한계 이하)"];
        SUPP_FSH  [label="FSH 억제"];
        ITT_CRASH [label="ITT 붕괴 — 정상의 ~2-6%\n(TE 200 mg 주 1회에서 −94%)", fillcolor="#f2c6c6", penwidth=1.5];
        AZOO      [label="무정자증/희소정자증\n노출 3-6개월 후"];
        TEST_ATR  [label="고환 용적 감소 (기저의 20-30%)"];
        RECOVERY  [label="중단 후 회복\nLiu 2006 풀분석: 20 M/mL 도달\n6개월 67% · 12개월 90% · 24개월 100%", fillcolor="#d5efd0"];
        HCG_RESCUE[label="hCG 병용 구제 (250-500 IU EOD)\nITT를 기저 근처로 유지", fillcolor="#d5efd0", penwidth=1.3];
        RESTART   [label="회복 프로토콜\nhCG ± SERM ± FSH"];
        SUPP_LH -> ITT_CRASH [penwidth=1.4, color="#c0392b"]; SUPP_FSH -> AZOO;
        ITT_CRASH -> AZOO [penwidth=1.4, color="#c0392b"]; ITT_CRASH -> TEST_ATR;
        AZOO -> RECOVERY; RECOVERY -> RESTART [style=dashed];
        HCG_RESCUE -> ITT_CRASH [label="− 방지", color="#1e8449", penwidth=1.4];
    }
    T_FREE -> SUPP_LH [label="음성 되먹임", penwidth=1.5, color="#c0392b"];
    E2_S -> SUPP_LH [label="강력 (아로마타제 경유)", penwidth=1.4, color="#c0392b"];
    SUPP_LH -> LH_S [style=dashed, color="#c0392b"]; SUPP_FSH -> FSH_S [style=dashed, color="#c0392b"];
    ITT_CRASH -> ITT [style=dashed, color="#c0392b"]; HCG_D -> HCG_RESCUE;
    AZOO -> SPERM_OUT [style=dashed, color="#c0392b"];

    /* ===================== 21. DIAGNOSIS & MONITORING ===================== */
    subgraph cluster_dx {
        label="㉑ 진단·모니터링 — 역치가 SHBG에 의존한다는 문제";
        style="rounded,filled"; fillcolor="#f7f7f2"; color="#a8a88a"; fontsize=11; fontcolor="#5a5a39";
        node [fillcolor="#e9e9d9"];
        MORNING   [label="아침(오전 7-10시) 공복 TT\n서로 다른 날 2회 확인"];
        LCMS      [label="LC-MS/MS 기준법\n(면역측정법은 저농도에서 부정확)"];
        CUTOFF    [label="진단 역치 TT <300 ng/dL (10.4 nmol/L)\nCDC 조화화 기준"];
        FT_CUT    [label="유리 T 역치 <65 pg/mL\n(평형투석 또는 Vermeulen 계산)"];
        MISCLASS  [label="⚑ 오분류\nSHBG 낮으면 TT는 낮으나 FT 정상\nSHBG 높으면 TT 정상이나 FT 낮음\n⇒ 단일 TT 역치는 양방향으로 틀린다", shape=note, fillcolor="#f8bbd0", penwidth=1.6, fontsize=8];
        SYMPT     [label="증상 확인 필수\n(성욕저하·조조발기 소실·여성유방증)"];
        MONITOR   [label="모니터링: 3·6·12개월 후 매년\nTT · Hct · PSA · 증상"];
        STOPRULE  [label="중지/감량 규칙\nHct >54% · PSA 속도 · 미해결 LUTS", fillcolor="#f2dede"];
        MORNING -> LCMS -> CUTOFF; CUTOFF -> MISCLASS [style=dashed]; FT_CUT -> MISCLASS [style=dashed];
        SYMPT -> CUTOFF; MONITOR -> STOPRULE;
    }
    SHBG_P -> MISCLASS [penwidth=1.5, color="#8e2f5a"];
    T_TOT -> MORNING; T_FREE -> FT_CUT; HCT -> STOPRULE [penwidth=1.3]; PSA -> STOPRULE;

    /* ===================== 22. CLINICAL ENDPOINTS ===================== */
    subgraph cluster_end {
        label="㉒ 임상 종점 및 주요 시험 (모델 보정 표적)";
        style="rounded,filled"; fillcolor="#f7f7f2"; color="#a8a88a"; fontsize=11; fontcolor="#5a5a39";
        node [fillcolor="#e9e9d9"];
        TTRIAL_S  [label="T-Trials 성기능 (NEJM 2016)\nPDQ-Q4 +0.58 vs +0.10"];
        TTRIAL_B  [label="T-Trials 골 (JAMA IM 2017)\n요추 해면골 vBMD +7.5%"];
        TTRIAL_A  [label="T-Trials 빈혈 (JAMA IM 2017)\n원인불명 빈혈 교정 54% vs 15%"];
        TTRIAL_V  [label="T-Trials 활력/보행: 1차 종점 미달"];
        TRAVERSE  [label="TRAVERSE (NEJM 2023) n=5,246\nMACE HR 0.96 — 비열등", penwidth=1.4];
        TRAV_FX   [label="TRAVERSE 골절 (NEJM 2024)\n3.50% vs 2.46% · HR 1.43", penwidth=1.3];
        FINK_T    [label="Finkelstein (NEJM 2013)\nT vs E2 기여 해리"];
        LIU_REC   [label="Liu 2006 (Lancet) 회복 풀분석"];
        HCT_INC   [label="적혈구증가증 발생률\nIM ~35-40% vs 겔 ~10-15%"];
        QOL       [label="환자 보고 결과 (PRO)\n성욕·활력·기분"];
        TTRIAL_S -> QOL; TTRIAL_V -> QOL;
    }
    PDQ4 -> TTRIAL_S; BMD_TRAB -> TTRIAL_B; HCT -> TTRIAL_A [style=dashed];
    VITAL -> TTRIAL_V; MACE -> TRAVERSE; FX_RISK -> TRAV_FX;
    FINK -> FINK_T; RECOVERY -> LIU_REC; HCT -> HCT_INC [penwidth=1.3];
    WAVEFORM -> HCT_INC [style=dashed, label="제형 격차의 설명 대상", penwidth=1.2];

    /* ===================== CROSS-CUTTING LEGEND ===================== */
    subgraph cluster_legend {
        label="범례 (Legend)";
        style="rounded,filled"; fillcolor="#ffffff"; color="#999999"; fontsize=10; fontcolor="#444444";
        node [shape=plaintext, fillcolor="#ffffff", fontsize=8];
        LEG1 [label="검은 화살표 = 활성화/흐름   빨간 화살표 = 억제   초록 화살표 = 치료적 개입"];
        LEG2 [label="⚑ 표시 = 이 모델의 정량적 핵심 주장 (mrgsolve 모델의 분석 함수가 계산)"];
        LEG3 [label="분홍 노트 = 볼록성·Jensen·오분류 — 서로 연결된 하나의 논증"];
        LEG1 -> LEG2 [style=invis]; LEG2 -> LEG3 [style=invis];
    }
}
