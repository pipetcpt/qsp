        MYOTONIC  [label="근긴장성 이영양증 (DM1)"];
        HEMO_T    [label="혈색소증 — 고환 철 침착"];
        AR_MUT    [label="AR/LHCGR/HSD17B3 변이"];
        PRIM_LAB  [label="검사 소견: TT ↓, LH ↑, FSH ↑\ninhibin B ↓", shape=note, fillcolor="#fdeaea", fontsize=8];
        KLINE -> PRIM_LAB; CRYPT -> PRIM_LAB; ORCHITIS -> PRIM_LAB; CHEMO -> PRIM_LAB;
        VARICO -> PRIM_LAB; AGE_TEST -> PRIM_LAB; MYOTONIC -> PRIM_LAB; HEMO_T -> PRIM_LAB;
    }
    KLINE -> LEYDIG_M [label="−−", color="#c0392b"]; CHEMO -> LEYDIG_M [label="−", color="#c0392b"];
    CHEMO -> SERTOLI [label="−−", color="#c0392b"]; AGE_TEST -> LEYDIG_M [label="−", color="#c0392b"];

    /* ===================== 10. SECONDARY (CENTRAL) AETIOLOGY ===================== */
    subgraph cluster_sec {
        label="⑩ 이차성(중추성) 성선기능저하증 — LH/FSH 정상 또는 ↓";
        style="rounded,filled"; fillcolor="#fbf1f1"; color="#d98080"; fontsize=11; fontcolor="#8e2323";
        node [fillcolor="#f7dcdc"];
        KALL      [label="칼만 증후군\nANOS1/FGFR1/PROKR2/CHD7\nGnRH 뉴런 이동 실패 · 후각소실"];
