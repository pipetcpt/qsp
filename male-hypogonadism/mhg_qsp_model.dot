        GC_SUPP   [label="글루코코르티코이드 / 쿠싱"];
        AAS_PRIOR [label="과거 단백동화 스테로이드 남용\n(ASIH — 지속적 억제)", fillcolor="#f2c6c6"];
        SEC_LAB   [label="검사 소견: TT ↓, LH 정상/↓, FSH 정상/↓\n⇒ 가역성 · 생식능 회복 가능", shape=note, fillcolor="#fdeaea", fontsize=8];
        KALL -> SEC_LAB; IHH -> SEC_LAB; PITAD -> SEC_LAB; PROLACT -> SEC_LAB;
        HEMO_P -> SEC_LAB; TBI -> SEC_LAB; OPIOID -> SEC_LAB; GC_SUPP -> SEC_LAB; AAS_PRIOR -> SEC_LAB;
    }
