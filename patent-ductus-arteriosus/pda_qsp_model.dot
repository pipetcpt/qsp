/* =====================================================================
   PATENT DUCTUS ARTERIOSUS OF PREMATURITY (PDA) -- QSP mechanistic map
   ---------------------------------------------------------------------
   The ductus arteriosus is not a lesion.  It is a normal fetal vessel
   held open by prostaglandin E2 acting through EP4 -> Gs -> cAMP in its
   own smooth muscle.  Everything on this map follows from four facts
   that the graph is drawn to make visible:

   (1) TWO ENZYME SITES, NOT ONE DRUG CLASS.  Indomethacin and ibuprofen
       compete with arachidonate in the CYCLOOXYGENASE CHANNEL.
       Acetaminophen reduces the ferryl-protoporphyrin radical at the
       physically separate PEROXIDASE SITE, so it competes with
       PEROXIDE, not with substrate.  The two inhibition nodes are drawn
       separately and converge multiplicatively on one catalytic cycle.
       Consequence, and a prediction: raising ductal peroxide tone
       (chorioamnionitis, sepsis) raises acetaminophen's apparent IC50
       and leaves ibuprofen untouched.

   (2) CONSTRICTION IS NOT CLOSURE.  Permanent closure requires ductal
       WALL hypoxia: the constricted lumen stops supplying O2 by
       diffusion, the media becomes hypoxic, and HIF-1a/VEGF/TGF-b1
       build a neointimal cushion.  A preterm ductal wall is THIN
       enough to stay oxygenated by diffusion even while constricted,
       so the remodelling signal never fires and the duct REOPENS when
       drug clears.  WALL_O2 is therefore the bistability switch of this
       whole map, and it is why ~1 in 4 preterm ducts reopens while a
       term duct essentially never does.

   (3) SPONTANEOUS CLOSURE IS THE COMPETING PROCESS.  The PGE2_SYN_INVOL
       node (postnatal involution of local prostanoid synthesis) closes
       almost every preterm duct eventually -- median ~71 days below
       26 weeks.  Any drug effect on a fixed-time closure endpoint is
       therefore bounded above by the untreated non-closure fraction at
       that time.  This ceiling, not drug potency, is what the negative
       trials measured.

   (4) EFFICACY AND TOXICITY ARE ONE MOLECULAR EVENT IN FOUR ORGANS.
       COX is drawn FOUR times -- ductus, kidney, gut mucosa, platelet.
       The same inhibition that closes the duct drops GFR, thins the
       mucosal defence and abolishes thromboxane.  The only things that
       separate the drugs are organ-specific prostanoid dependence and
       the non-COX vasoconstriction that indomethacin has and ibuprofen
       does not.

   Nodes marked [S] are state variables of pda_mrgsolve_model.R,
   [P] are parameters, [E] are clinical endpoints, [X] are toxicities.
   ===================================================================== */
digraph PDA_QSP {
  graph [rankdir=TB, splines=true, newrank=true, nodesep=0.20, ranksep=0.48,
         fontname="Helvetica", fontsize=11, compound=true,
         label="Patent Ductus Arteriosus of Prematurity — Quantitative Systems Pharmacology map\nTwo COX sites · constriction ≠ closure (wall-O₂ switch) · spontaneous closure as competing risk · one enzyme in four organs   ·   [S] = mrgsolve state · [P] = parameter · [E] = endpoint · [X] = toxicity",
         labelloc=t, fontcolor="#1a1a1a"];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10,
         color="#555555", penwidth=1.0, margin="0.08,0.045"];
  edge  [color="#666666", penwidth=1.0, arrowsize=0.7, fontname="Helvetica", fontsize=8];

  /* ---------- colour key -------------------------------------------- */
  subgraph cluster_key {
    label="Key"; style="rounded,filled"; fillcolor="#fafafa"; color="#bbbbbb"; fontsize=11;
    k1 [label="prostanoid / enzyme", fillcolor="#ffe0b2"];
    k2 [label="ductal smooth muscle · signalling", fillcolor="#c5cae9"];
    k3 [label="drug · dose · PK", fillcolor="#b2dfdb"];
    k4 [label="haemodynamic variable", fillcolor="#ffcdd2"];
    k5 [label="structure · remodelling", fillcolor="#d7ccc8"];
    k6 [label="organ injury / toxicity", fillcolor="#ffab91"];
    k7 [label="clinical endpoint", fillcolor="#cfd8dc"];
    k8 [label="maturational modifier", fillcolor="#f0f4c3"];
    k1->k2->k3->k4 [style=invis];
    k5->k6->k7->k8 [style=invis];
  }

  /* ================================================================= */
  /* 1. PERINATAL TRANSITION -- what changes at the moment of birth     */
  /* ================================================================= */
  subgraph cluster_transition {
    label="1 · Perinatal transition: loss of the placental PGE₂ source";
    style="rounded,filled"; fillcolor="#fffde7"; color="#c0ca33";
    PLACENTA   [label="Placental circulation\n(major fetal PGE₂ source)", fillcolor="#f0f4c3"];
    CORDCLAMP  [label="Cord clamping\nt = 0", fillcolor="#f0f4c3", shape=hexagon];
    FETALPO2   [label="Fetal PaO₂ 20–25 mmHg", fillcolor="#f0f4c3"];
    LUNGAER    [label="Lung aeration ·\nfirst breaths", fillcolor="#f0f4c3"];
    PAO2       [label="Postnatal PaO₂ [P]\n(45–70 mmHg targeted)", fillcolor="#f0f4c3"];
    PGDH       [label="Pulmonary 15-PGDH [S]\nPGE₂-degrading capacity", fillcolor="#ffe0b2"];
    PGE2P      [label="Circulating PGE₂ [S]\n700 → <100 pg/mL", fillcolor="#ffe0b2"];
    GAWK       [label="Gestational age [P]\n23–40 wk", fillcolor="#f0f4c3", shape=hexagon];
    ANTESTER   [label="Antenatal corticosteroids [P]", fillcolor="#f0f4c3"];
    CHORIO     [label="Chorioamnionitis /\nearly-onset sepsis [P]", fillcolor="#f0f4c3"];
    PLACENTA -> PGE2P [label="fetal supply"];
    CORDCLAMP -> PLACENTA [label="removes", color="#c62828", arrowhead=tee];
    FETALPO2 -> LUNGAER [style=invis];
    LUNGAER -> PAO2 [label="↑"];
    LUNGAER -> PGDH [label="perfused lung"];
    PGDH -> PGE2P [label="degrades", color="#c62828", arrowhead=tee];
    GAWK -> PGDH [label="immature lung\n→ low capacity"];
  }

  /* ================================================================= */
  /* 2. PROSTANOID BIOSYNTHESIS IN THE DUCTAL WALL                      */
  /* ================================================================= */
  subgraph cluster_prostanoid {
    label="2 · Prostanoid biosynthesis in the ductal wall";
    style="rounded,filled"; fillcolor="#fff8e1"; color="#ffa000";
    PLIPID   [label="Membrane phospholipid", fillcolor="#ffe0b2"];
    PLA2     [label="cPLA₂ / sPLA₂", fillcolor="#ffe0b2"];
    AA       [label="Arachidonic acid\n(substrate)", fillcolor="#ffe0b2"];
    COX1     [label="COX-1 (PTGS1)\nconstitutive", fillcolor="#ffe0b2"];
    COX2     [label="COX-2 (PTGS2)\ninducible, high in fetal ductus", fillcolor="#ffe0b2"];
    CHANNEL  [label="Arachidonate channel\n(Arg120 / Ser530)", fillcolor="#ffcc80", shape=octagon];
    POXSITE  [label="Peroxidase site\nferryl-protoporphyrin radical", fillcolor="#ffcc80", shape=octagon];
    PEROX    [label="Ductal peroxide tone [S]\n(inflammation-driven)", fillcolor="#ffe0b2"];
    PGG2     [label="PGG₂", fillcolor="#ffe0b2"];
    PGH2     [label="PGH₂", fillcolor="#ffe0b2"];
    PTGES    [label="mPGES-1", fillcolor="#ffe0b2"];
    PGIS     [label="PGI₂ synthase", fillcolor="#ffe0b2"];
    TXAS     [label="TXA₂ synthase", fillcolor="#ffe0b2"];
    PGE2D    [label="Ductal PGE₂ [S]\nthe vessel's own dilator", fillcolor="#ffb74d"];
    PGI2D    [label="Ductal PGI₂", fillcolor="#ffe0b2"];
    SYNINVOL [label="PGE₂_SYN_INVOL [P]\npostnatal involution of local\nsynthesis — faster at higher GA", fillcolor="#f0f4c3", shape=hexagon];
    PLIPID -> PLA2 -> AA;
    AA -> CHANNEL [label="binds"];
    CHANNEL -> COX1; CHANNEL -> COX2;
    COX1 -> PGG2; COX2 -> PGG2;
    PGG2 -> POXSITE [label="reduced at"];
    POXSITE -> PGH2;
    PEROX -> POXSITE [label="sustains radical"];
    PGH2 -> PTGES -> PGE2D;
    PGH2 -> PGIS -> PGI2D;
    PGH2 -> TXAS;
    SYNINVOL -> COX2 [label="↓ expression\nover days–weeks", color="#c62828", arrowhead=tee];
    PGE2P -> PGE2D [label="uptake"];
  }

  /* ================================================================= */
  /* 3. IBUPROFEN                                                       */
  /* ================================================================= */
  subgraph cluster_ibu {
    label="3 · Ibuprofen lysine — arachidonate-channel inhibitor";
    style="rounded,filled"; fillcolor="#e0f2f1"; color="#00796b";
    IBUDOSE  [label="Dose [P] 10–5–5 mg/kg IV q24h\n(high dose 20–10–10; or infusion)", fillcolor="#b2dfdb", shape=note];
    IBU1     [label="Ibuprofen central [S]", fillcolor="#b2dfdb"];
    IBU2     [label="Ibuprofen peripheral [S]", fillcolor="#b2dfdb"];
    IBUALB   [label="Albumin binding ~98.8%\nf_u 0.4–1.5% (preterm)", fillcolor="#b2dfdb"];
    IBUFREE  [label="Unbound ibuprofen\n(the only species at COX)", fillcolor="#80cbc4"];
    IBUCL    [label="Clearance [P] 1.4–4.5 mL/h/kg\n+20%/day maturation", fillcolor="#b2dfdb"];
    IBUE     [label="Ductal effect site [S]", fillcolor="#b2dfdb"];
    IBUDOSE -> IBU1 -> IBU2 [dir=both];
    IBU1 -> IBUALB -> IBUFREE;
    IBU1 -> IBUCL [label="eliminated"];
    IBUFREE -> IBUE;
  }

  /* ================================================================= */
  /* 4. INDOMETHACIN                                                    */
  /* ================================================================= */
  subgraph cluster_ind {
    label="4 · Indomethacin — potent, slowly-reversible channel inhibitor";
    style="rounded,filled"; fillcolor="#e0f7fa"; color="#00838f";
    INDDOSE  [label="Dose [P] 0.2–0.1–0.1 mg/kg IV\n(prophylaxis 0.1 q24h ×3)", fillcolor="#b2dfdb", shape=note];
    IND1     [label="Indomethacin central [S]", fillcolor="#b2dfdb"];
    IND2     [label="Indomethacin peripheral [S]", fillcolor="#b2dfdb"];
    INDFREE  [label="Unbound indomethacin\nf_u ~1%", fillcolor="#80cbc4"];
    INDCL    [label="Clearance [P] t½ 11–36 h\nenterohepatic recycling", fillcolor="#b2dfdb"];
    INDE     [label="Ductal effect site [S]\nslow offset = tight binding", fillcolor="#b2dfdb"];
    INDNONCOX [label="NON-COX vasoconstriction [P]\nthe drug-class discriminator", fillcolor="#4db6ac", shape=octagon];
    INDDOSE -> IND1 -> IND2 [dir=both];
    IND1 -> INDFREE; IND1 -> INDCL;
    INDFREE -> INDE;
    IND1 -> INDNONCOX;
  }

  /* ================================================================= */
  /* 5. ACETAMINOPHEN                                                   */
  /* ================================================================= */
  subgraph cluster_apap {
    label="5 · Acetaminophen — peroxidase-site reductant (a different enzyme site)";
    style="rounded,filled"; fillcolor="#f1f8e9"; color="#558b2f";
    APAPDOSE [label="Dose [P] 15 mg/kg q6h\nIV or enteral, 3–7 days", fillcolor="#b2dfdb", shape=note];
    APAPG    [label="Enteral depot [S]", fillcolor="#b2dfdb"];
    APAP1    [label="Acetaminophen central [S]", fillcolor="#b2dfdb"];
    APAP2    [label="Acetaminophen peripheral [S]", fillcolor="#b2dfdb"];
    APAPFREE [label="Unbound acetaminophen\nf_u ~85% — barely bound", fillcolor="#80cbc4"];
    APAPCL   [label="Glucuronide + sulfate\nt½ 4–11 h (preterm)", fillcolor="#b2dfdb"];
    APAPCYP  [label="CYP2E1/3A4 oxidation\n(~3% in the neonate)", fillcolor="#b2dfdb"];
    NAPQI    [label="NAPQI", fillcolor="#ffab91"];
    GSH      [label="Hepatic glutathione [S]", fillcolor="#b2dfdb"];
    APAPDOSE -> APAPG -> APAP1 -> APAP2 [dir=both];
    APAP1 -> APAPFREE; APAP1 -> APAPCL; APAP1 -> APAPCYP -> NAPQI;
    GSH -> NAPQI [label="quenches", color="#2e7d32", arrowhead=tee];
  }

  /* ================================================================= */
  /* 6. THE TWO INHIBITION NODES CONVERGE                               */
  /* ================================================================= */
  subgraph cluster_inhib {
    label="6 · Two sites, one catalytic cycle — where the drug classes differ";
    style="rounded,filled"; fillcolor="#fbe9e7"; color="#d84315";
    ICHAN   [label="Channel occupancy\nΣ Cᵤ/Kᵢ / (1 + Σ Cᵤ/Kᵢ)\nibuprofen + indomethacin", fillcolor="#ffcc80", shape=octagon];
    IPEROX  [label="Peroxidase-site inhibition\nCᵤ/(Cᵤ + IC₅₀·(1+peroxide/K))\nacetaminophen only", fillcolor="#ffcc80", shape=octagon];
    ICOXD   [label="Net ductal COX inhibition\n1 − (1−I_chan)(1−I_perox)", fillcolor="#ff8a65", shape=octagon];
    IBUE -> ICHAN; INDE -> ICHAN;
    APAPFREE -> IPEROX;
    PEROX -> IPEROX [label="raises apparent IC₅₀\n→ acetaminophen fails\nin sepsis", color="#c62828", arrowhead=tee, style=bold];
    CHORIO -> PEROX [label="↑↑"];
    ICHAN -> ICOXD; IPEROX -> ICOXD;
    ICOXD -> PGE2D [label="↓ synthesis", color="#c62828", arrowhead=tee, penwidth=2.0];
  }

  /* ================================================================= */
  /* 7. DUCTAL SMOOTH MUSCLE SIGNALLING                                 */
  /* ================================================================= */
  subgraph cluster_smc {
    label="7 · Ductal smooth-muscle signalling — relaxation vs contraction";
    style="rounded,filled"; fillcolor="#e8eaf6"; color="#3949ab";
    EP4     [label="EP4 receptor [S]\ndensity ↓ postnatally,\n↑↑ at low GA", fillcolor="#c5cae9"];
    EP2     [label="EP2 receptor", fillcolor="#c5cae9"];
    IP      [label="IP receptor (PGI₂)", fillcolor="#c5cae9"];
    GS      [label="Gs α", fillcolor="#c5cae9"];
    AC      [label="Adenylyl cyclase", fillcolor="#c5cae9"];
    CAMP    [label="cAMP [S]", fillcolor="#9fa8da"];
    PKA     [label="PKA", fillcolor="#c5cae9"];
    KATP    [label="K_ATP / K_v channels", fillcolor="#c5cae9"];
    MEMPOT  [label="Membrane potential", fillcolor="#c5cae9"];
    CAL     [label="L-type Ca²⁺ channel", fillcolor="#c5cae9"];
    CASMC   [label="Cytosolic Ca²⁺ [S]", fillcolor="#9fa8da"];
    MLCK    [label="MLCK", fillcolor="#c5cae9"];
    MLCP    [label="MLC phosphatase", fillcolor="#c5cae9"];
    ROCK    [label="RhoA / ROCK\nCa²⁺-sensitisation", fillcolor="#c5cae9"];
    MLC20   [label="MLC₂₀ phosphorylation", fillcolor="#c5cae9"];
    O2SENSE [label="O₂ sensing\nmito ROS · CYP450 · ET-1", fillcolor="#c5cae9", shape=octagon];
    P50     [label="O₂ sensitivity P₅₀ [P]\nHIGHER (less sensitive)\nat lower GA", fillcolor="#f0f4c3", shape=hexagon];
    RELAXP  [label="PGE₂/EP4 relaxation\nE_max·drive/(EC₅₀+drive)", fillcolor="#9fa8da", shape=octagon];
    RELAXN  [label="NO/cGMP relaxation", fillcolor="#9fa8da", shape=octagon];
    MATCONTR [label="Postnatal contractile\nmaturation [S]", fillcolor="#f0f4c3"];
    NETDRIVE [label="NET constrictor drive\nO₂ + maturation − PGE₂ − NO", fillcolor="#7986cb", shape=octagon];
    TMAXGA  [label="Maximal achievable occlusion [P]\nthin immature media cannot\nfully occlude the lumen", fillcolor="#f0f4c3", shape=hexagon];
    TONE    [label="Ductal tone [S] 0–1", fillcolor="#5c6bc0", fontcolor=white];
    PGE2D -> EP4 -> GS -> AC -> CAMP -> PKA;
    PGE2D -> EP2 -> GS;
    PGI2D -> IP -> GS;
    PKA -> KATP -> MEMPOT;
    MEMPOT -> CAL [label="hyperpolarised → shut", color="#c62828", arrowhead=tee];
    CAL -> CASMC -> MLCK -> MLC20;
    PKA -> MLCP [label="↑"]; MLCP -> MLC20 [color="#c62828", arrowhead=tee];
    ROCK -> MLCP [color="#c62828", arrowhead=tee];
    PAO2 -> O2SENSE; P50 -> O2SENSE [color="#c62828", arrowhead=tee];
    GAWK -> P50;
    O2SENSE -> MEMPOT [label="K_v inhibition\n→ depolarise"];
    O2SENSE -> ROCK;
    CAMP -> RELAXP; EP4 -> RELAXP;
    RELAXP -> NETDRIVE [color="#c62828", arrowhead=tee];
    RELAXN -> NETDRIVE [color="#c62828", arrowhead=tee];
    O2SENSE -> NETDRIVE; MATCONTR -> NETDRIVE;
    NETDRIVE -> TONE; TMAXGA -> TONE [label="ceiling"];
    GAWK -> TMAXGA; GAWK -> MATCONTR;
    MLC20 -> TONE;
  }

  /* ================================================================= */
  /* 8. NO AND THE OTHER DILATORS                                       */
  /* ================================================================= */
  subgraph cluster_no {
    label="8 · NO / cGMP and CO — the dilator reserve COX inhibition cannot touch";
    style="rounded,filled"; fillcolor="#ede7f6"; color="#5e35b1";
    ENOS   [label="eNOS (ductal endothelium)", fillcolor="#d1c4e9"];
    NOD    [label="Ductal NO tone [S]\nhigher at lower GA", fillcolor="#b39ddb"];
    SGC    [label="Soluble guanylyl cyclase", fillcolor="#d1c4e9"];
    CGMP   [label="cGMP", fillcolor="#d1c4e9"];
    PKG    [label="PKG", fillcolor="#d1c4e9"];
    PDE5   [label="PDE5", fillcolor="#d1c4e9"];
    HO1    [label="Heme oxygenase-1 → CO", fillcolor="#d1c4e9"];
    NOSINH [label="NOS inhibition\n(tested, not adopted)", fillcolor="#b2dfdb", shape=note];
    ENOS -> NOD -> SGC -> CGMP -> PKG;
    PDE5 -> CGMP [color="#c62828", arrowhead=tee];
    HO1 -> SGC;
    CGMP -> RELAXN;
    NOD -> RELAXN;
    NOSINH -> ENOS [color="#c62828", arrowhead=tee];
    GAWK -> ENOS [label="↑ NO dependence\nat low GA"];
  }

  /* ================================================================= */
  /* 9. WALL O2 AND REMODELLING -- THE BISTABILITY SWITCH               */
  /* ================================================================= */
  subgraph cluster_remodel {
    label="9 · Wall O₂ gates permanent closure — why preterm ducts REOPEN";
    style="rounded,filled"; fillcolor="#efebe9"; color="#5d4037";
    WALLTH  [label="Ductal wall thickness [S]\nthin at low GA", fillcolor="#d7ccc8"];
    LUMO2   [label="Luminal O₂ diffusion\n∝ residual lumen", fillcolor="#d7ccc8"];
    VASA    [label="Vasa vasorum supply\n(sparse in the preterm duct)", fillcolor="#d7ccc8"];
    WALLO2  [label="WALL PO₂ [S]\nTHE SWITCH", fillcolor="#a1887f", fontcolor=white, shape=octagon];
    HYPOXIA [label="Profound medial hypoxia\n(PO₂ < ~16 mmHg)", fillcolor="#bcaaa4"];
    HIF1A   [label="HIF-1α", fillcolor="#d7ccc8"];
    VEGFD   [label="VEGF [S]", fillcolor="#d7ccc8"];
    TGFBD   [label="TGF-β1 [S]", fillcolor="#d7ccc8"];
    ECMIGR  [label="Endothelial migration ·\nhyaluronan-rich mounds", fillcolor="#d7ccc8"];
    SMCMIGR [label="SMC migration into\nsubendothelial space", fillcolor="#d7ccc8"];
    ELASTIN [label="Elastin fragmentation ·\ncollagen deposition", fillcolor="#d7ccc8"];
    NEOINT  [label="Neointimal cushion [S]\nanatomic remodelling", fillcolor="#8d6e63", fontcolor=white];
    PERMCLOSE [label="PERMANENT closure [E]\nligamentum arteriosum", fillcolor="#cfd8dc"];
    REOPEN  [label="REOPENING [E]\ntone lost when drug clears,\nno cushion built (~25% <28 wk)", fillcolor="#ffab91"];
    TONE -> LUMO2 [label="constriction ↓ lumen", color="#c62828", arrowhead=tee];
    LUMO2 -> WALLO2; VASA -> WALLO2;
    WALLTH -> WALLO2 [label="thicker wall →\ndiffusion cannot reach media", color="#c62828", arrowhead=tee];
    GAWK -> WALLTH;
    PAO2 -> LUMO2;
    WALLO2 -> HYPOXIA [color="#c62828", arrowhead=tee];
    HYPOXIA -> HIF1A -> VEGFD -> ECMIGR;
    HIF1A -> TGFBD -> SMCMIGR;
    TGFBD -> ELASTIN;
    ECMIGR -> NEOINT; SMCMIGR -> NEOINT; ELASTIN -> NEOINT;
    NEOINT -> PERMCLOSE;
    NEOINT -> REOPEN [label="ABSENT → ", color="#c62828", arrowhead=tee, style=bold];
    TONE -> REOPEN [label="lost on drug\nwashout", style=bold];
  }

  /* ================================================================= */
  /* 10. DUCTAL GEOMETRY AND SHUNT HYDRAULICS                           */
  /* ================================================================= */
  subgraph cluster_hydraulic {
    label="10 · Shunt hydraulics — why 1.5 mm is a real threshold, not a convention";
    style="rounded,filled"; fillcolor="#ffebee"; color="#c62828";
    DMAX    [label="Unconstricted diameter [P]\n≈ 2.2 mm at 26 wk", fillcolor="#ffcdd2"];
    DDUCT   [label="Ductal diameter [S] (mm)\nd = d_max(1−remodel)(1−α·tone)", fillcolor="#ef9a9a"];
    RDUCT   [label="Ductal resistance\nR ∝ 1/d⁴  (Poiseuille)", fillcolor="#ffcdd2", shape=octagon];
    GRAD    [label="Aorta − pulmonary artery\nmean gradient", fillcolor="#ffcdd2"];
    QSH     [label="Left-to-right shunt [S]\nQ_sh = ΔP/R_duct", fillcolor="#e57373"];
    DALPA   [label="Duct : left-pulmonary-artery\nratio (echo)", fillcolor="#cfd8dc"];
    DPERKG  [label="Duct diameter / kg\n> 1.4 mm/kg = large", fillcolor="#cfd8dc"];
    DMAX -> DDUCT; TONE -> DDUCT [color="#c62828", arrowhead=tee, penwidth=2.0];
    NEOINT -> DDUCT [color="#c62828", arrowhead=tee, penwidth=2.0];
    DDUCT -> RDUCT [label="4th power", style=bold];
    RDUCT -> QSH [color="#c62828", arrowhead=tee]; GRAD -> QSH;
    DDUCT -> DALPA; DDUCT -> DPERKG;
  }

  /* ================================================================= */
  /* 11. TRANSITIONAL CIRCULATION                                       */
  /* ================================================================= */
  subgraph cluster_circ {
    label="11 · Transitional circulation — the falling PVR that UNMASKS the shunt";
    style="rounded,filled"; fillcolor="#fce4ec"; color="#ad1457";
    PVR     [label="Pulmonary vascular resistance [S]\nfalls over 2–5 days", fillcolor="#f8bbd0"];
    SVR     [label="Systemic vascular resistance [S]", fillcolor="#f8bbd0"];
    PLA     [label="Left atrial pressure [S]", fillcolor="#f8bbd0"];
    QP      [label="Pulmonary blood flow [S]", fillcolor="#f8bbd0"];
    QS      [label="Systemic blood flow [S]", fillcolor="#f8bbd0"];
    QPQS    [label="Q_p : Q_s ratio\n2–3 : 1 when large", fillcolor="#f48fb1"];
    LVRES   [label="LV output reserve [P]\nlimited in the preterm heart", fillcolor="#f8bbd0"];
    LVDIL   [label="LV dilation · volume load [S]", fillcolor="#f8bbd0"];
    LAAO    [label="LA : Ao ratio > 1.4 (echo)", fillcolor="#cfd8dc"];
    PDIA    [label="Diastolic blood pressure [S]\nfalls with runoff", fillcolor="#f8bbd0"];
    PAO     [label="Mean arterial pressure", fillcolor="#f8bbd0"];
    PVR -> GRAD [color="#c62828", arrowhead=tee, penwidth=2.0, label="high PVR at birth\nhides the duct"];
    SVR -> GRAD;
    QSH -> QP [label="recirculates"];
    QSH -> PLA; PLA -> GRAD [color="#c62828", arrowhead=tee];
    QP -> PVR [style=dashed, label="overcirculation\n→ PVR ↑"];
    LVRES -> QS [label="ceiling"];
    QSH -> QS [label="steal when reserve\nexhausted", color="#c62828", arrowhead=tee, style=bold];
    QP -> QPQS; QS -> QPQS;
    QSH -> LVDIL -> LAAO;
    QSH -> PDIA [color="#c62828", arrowhead=tee, penwidth=2.0];
    QS -> PAO;
    GAWK -> LVRES;
  }

  /* ================================================================= */
  /* 12. PULMONARY CONSEQUENCES                                         */
  /* ================================================================= */
  subgraph cluster_lung {
    label="12 · Pulmonary overcirculation → mechanics → ventilator exposure";
    style="rounded,filled"; fillcolor="#e1f5fe"; color="#0277bd";
    EVLW    [label="Extravascular lung water [S]", fillcolor="#b3e5fc"];
    SURFINACT [label="Surfactant inactivation\nby plasma proteins", fillcolor="#b3e5fc"];
    CRS     [label="Respiratory compliance [S]", fillcolor="#b3e5fc"];
    VENTSEV [label="Ventilator severity index [S]", fillcolor="#81d4fa"];
    FIO2    [label="FiO₂ requirement [E]", fillcolor="#cfd8dc"];
    MV      [label="Mechanical ventilation days [E]", fillcolor="#cfd8dc"];
    VOLU    [label="Volutrauma · atelectrauma [X]", fillcolor="#ffab91"];
    PULMHEM [label="Pulmonary haemorrhage [X]", fillcolor="#ffab91"];
    QP -> EVLW [label="↑ filtration"]; PLA -> EVLW;
    EVLW -> SURFINACT -> CRS [color="#c62828", arrowhead=tee];
    EVLW -> CRS [color="#c62828", arrowhead=tee];
    ANTESTER -> CRS [label="↑ surfactant"];
    CRS -> VENTSEV [color="#c62828", arrowhead=tee];
    VENTSEV -> FIO2; VENTSEV -> MV; VENTSEV -> VOLU;
    QSH -> PULMHEM [label="massive shunt"];
  }

  /* ================================================================= */
  /* 13. SYSTEMIC STEAL                                                 */
  /* ================================================================= */
  subgraph cluster_steal {
    label="13 · Diastolic runoff — the same shunt seen from downstream";
    style="rounded,filled"; fillcolor="#fff3e0"; color="#e65100";
    RUNOFF  [label="Diastolic runoff into\nthe pulmonary artery", fillcolor="#ffe0b2"];
    QCER    [label="Cerebral blood flow [S]", fillcolor="#ffcc80"];
    QMES    [label="Mesenteric blood flow [S]", fillcolor="#ffcc80"];
    QREN    [label="Renal blood flow [S]", fillcolor="#ffcc80"];
    ABSDIAST [label="Absent / reversed diastolic flow\n(SMA · ACM Doppler)", fillcolor="#cfd8dc"];
    AUTOREG [label="Impaired cerebral\nautoregulation", fillcolor="#ffcc80"];
    QSH -> RUNOFF -> PDIA [color="#c62828", arrowhead=tee];
    PDIA -> QCER; PDIA -> QMES; PDIA -> QREN;
    RUNOFF -> ABSDIAST;
    QCER -> AUTOREG [color="#c62828", arrowhead=tee];
    INDNONCOX -> QCER [label="−20 to −40%\nacutely", color="#c62828", arrowhead=tee, style=bold, penwidth=2.0];
    INDNONCOX -> QMES [color="#c62828", arrowhead=tee, style=bold];
    INDNONCOX -> QREN [color="#c62828", arrowhead=tee, style=bold];
  }

  /* ================================================================= */
  /* 14. RENAL COX -- THE SAME ENZYME, A DIFFERENT ORGAN                */
  /* ================================================================= */
  subgraph cluster_kidney {
    label="14 · Renal COX — efficacy and nephrotoxicity are one event";
    style="rounded,filled"; fillcolor="#f3e5f5"; color="#6a1b9a";
    COXK    [label="Renal COX-1/COX-2\n(macula densa · medulla)", fillcolor="#ffe0b2"];
    PGE2K   [label="Renal PGE₂ / PGI₂ [S]", fillcolor="#ffe0b2"];
    AFFER   [label="Afferent arteriolar\nvasodilatation", fillcolor="#e1bee7"];
    GFR     [label="GFR [S]", fillcolor="#ce93d8"];
    UO      [label="Urine output [S]", fillcolor="#ce93d8"];
    SCR     [label="Serum creatinine [S]", fillcolor="#ce93d8"];
    OLIG    [label="Oliguria [X]\n(indomethacin 20–25%)", fillcolor="#ffab91"];
    HYPONA  [label="Hyponatraemia [X]", fillcolor="#ffab91"];
    FLUID   [label="Fluid balance [S]", fillcolor="#ce93d8"];
    AKI     [label="Transient renal insufficiency [X]", fillcolor="#ffab91"];
    IBUFREE -> COXK [color="#c62828", arrowhead=tee];
    INDFREE -> COXK [color="#c62828", arrowhead=tee];
    APAPFREE -> COXK [label="weak: renal peroxide\ntone is high", style=dashed];
    COXK -> PGE2K -> AFFER -> GFR;
    QREN -> GFR;
    GFR -> UO; GFR -> SCR [color="#c62828", arrowhead=tee];
    UO -> FLUID; UO -> OLIG [color="#c62828", arrowhead=tee];
    PGE2K -> HYPONA [color="#c62828", arrowhead=tee];
    SCR -> AKI;
  }

  /* ================================================================= */
  /* 15. GUT COX                                                        */
  /* ================================================================= */
  subgraph cluster_gut {
    label="15 · Gut mucosal COX — NEC and spontaneous intestinal perforation";
    style="rounded,filled"; fillcolor="#fbe9e7"; color="#bf360c";
    COXG   [label="Gut mucosal COX", fillcolor="#ffe0b2"];
    PGE2G  [label="Mucosal PGE₂ [S]\nbarrier · bicarbonate · flow", fillcolor="#ffe0b2"];
    MUCOSA [label="Mucosal integrity", fillcolor="#ffccbc"];
    NEC    [label="NEC ≥ stage 2 [E][X]", fillcolor="#ff8a65"];
    SIP    [label="Spontaneous intestinal\nperforation [X]", fillcolor="#ff8a65"];
    HCORT  [label="Early hydrocortisone [P]", fillcolor="#b2dfdb", shape=note];
    FEED   [label="Enteral feeding\nsplanchnic demand", fillcolor="#ffccbc"];
    IBUFREE -> COXG [color="#c62828", arrowhead=tee];
    INDFREE -> COXG [color="#c62828", arrowhead=tee];
    COXG -> PGE2G -> MUCOSA;
    QMES -> MUCOSA;
    MUCOSA -> NEC [color="#c62828", arrowhead=tee];
    MUCOSA -> SIP [color="#c62828", arrowhead=tee];
    INDNONCOX -> SIP [style=bold];
    HCORT -> SIP [label="synergistic with\nindomethacin", style=bold];
    FEED -> NEC;
  }

  /* ================================================================= */
  /* 16. PLATELET COX, CNS AND IVH                                      */
  /* ================================================================= */
  subgraph cluster_ivh {
    label="16 · Platelet COX-1 and the germinal matrix — two OPPOSING drug effects";
    style="rounded,filled"; fillcolor="#e8f5e9"; color="#2e7d32";
    COXPLT [label="Platelet COX-1", fillcolor="#ffe0b2"];
    TXA2   [label="Thromboxane A₂ [S]", fillcolor="#ffe0b2"];
    PLTAGG [label="Platelet aggregation", fillcolor="#c8e6c9"];
    BTIME  [label="Bleeding time [S]", fillcolor="#c8e6c9"];
    GERMMAT [label="Germinal matrix\nfragile immature vessels", fillcolor="#c8e6c9"];
    INDMAT [label="Indomethacin-induced\ngerminal-matrix vessel maturation", fillcolor="#a5d6a7", shape=octagon];
    IVH    [label="Severe (grade 3–4) IVH [E][X]", fillcolor="#ff8a65"];
    PVL    [label="Periventricular leukomalacia [X]", fillcolor="#ffab91"];
    NDI    [label="Neurodevelopmental impairment\nat 18–24 months [E]", fillcolor="#cfd8dc"];
    IBUFREE -> COXPLT [color="#c62828", arrowhead=tee];
    INDFREE -> COXPLT [color="#c62828", arrowhead=tee];
    COXPLT -> TXA2 -> PLTAGG;
    PLTAGG -> BTIME [color="#c62828", arrowhead=tee];
    BTIME -> IVH [label="HARM", style=bold];
    GAWK -> GERMMAT;
    GERMMAT -> IVH;
    AUTOREG -> IVH;
    INDE -> INDMAT;
    INDMAT -> IVH [label="BENEFIT — the two\nsigns nearly cancel", color="#2e7d32", arrowhead=tee, style=bold, penwidth=2.0];
    QCER -> PVL [color="#c62828", arrowhead=tee];
    IVH -> NDI; PVL -> NDI;
  }

  /* ================================================================= */
  /* 17. OTHER TOXICITY                                                 */
  /* ================================================================= */
  subgraph cluster_tox {
    label="17 · Other drug toxicity";
    style="rounded,filled"; fillcolor="#fff8e1"; color="#f57f17";
    ALT     [label="ALT [S]\nacetaminophen hepatotoxicity", fillcolor="#ffab91"];
    TBILI   [label="Total bilirubin [S]", fillcolor="#ffab91"];
    BFREE   [label="FREE bilirubin [S]\nibuprofen displaces it\nfrom albumin", fillcolor="#ff8a65"];
    KERN    [label="Kernicterus risk [X]", fillcolor="#ff8a65"];
    PPHTN   [label="Pulmonary hypertension [X]\n(reported with ibuprofen)", fillcolor="#ffab91"];
    GIBLEED [label="GI bleeding [X]", fillcolor="#ffab91"];
    NAPQI -> ALT;
    IBU1 -> BFREE [label="albumin displacement", style=bold];
    TBILI -> BFREE; BFREE -> KERN;
    IBU1 -> PPHTN [style=dashed];
    COXG -> GIBLEED [color="#c62828", arrowhead=tee];
    BTIME -> GIBLEED;
  }

  /* ================================================================= */
  /* 18. PDA BURDEN AND OUTCOME                                         */
  /* ================================================================= */
  subgraph cluster_burden {
    label="18 · PDA BURDEN, not closure, is what the outcomes see";
    style="rounded,filled"; fillcolor="#eceff1"; color="#37474f";
    PDABUR  [label="PDA BURDEN [S]\n∫ (shunt above threshold) dt\ndays × mL/min/kg", fillcolor="#90a4ae", fontcolor=white, shape=octagon];
    VENTIX  [label="Cumulative ventilator\nseverity [S]", fillcolor="#b0bec5"];
    ALV     [label="Alveolarisation [S]\nsecondary septation arrest", fillcolor="#b0bec5"];
    BPD     [label="Moderate/severe BPD\nat 36 wk PMA [E]", fillcolor="#cfd8dc"];
    DEATH   [label="Death before 36 wk [E]", fillcolor="#cfd8dc"];
    COMPOS  [label="Death or moderate/severe BPD [E]\nthe primary endpoint of the\nmodern trials", fillcolor="#78909c", fontcolor=white];
    ROP     [label="Retinopathy of prematurity [E]", fillcolor="#cfd8dc"];
    LIGATE  [label="Surgical ligation /\ntranscatheter device closure [E]", fillcolor="#cfd8dc"];
    POSTLIG [label="Post-ligation cardiac\nsyndrome [X]", fillcolor="#ffab91"];
    QSH -> PDABUR [label="only above the\nsignificance threshold", penwidth=2.0];
    VENTSEV -> VENTIX;
    PDABUR -> BPD [penwidth=2.0]; VENTIX -> BPD [penwidth=2.0];
    VENTSEV -> ALV [color="#c62828", arrowhead=tee]; EVLW -> ALV [color="#c62828", arrowhead=tee];
    ALV -> BPD [color="#c62828", arrowhead=tee];
    GAWK -> BPD [color="#c62828", arrowhead=tee, penwidth=2.0, label="dominates"];
    QS -> DEATH [color="#c62828", arrowhead=tee];
    PDABUR -> DEATH;
    BPD -> COMPOS; DEATH -> COMPOS;
    FIO2 -> ROP;
    PDABUR -> LIGATE; REOPEN -> LIGATE;
    LIGATE -> POSTLIG;
    NEC -> DEATH; IVH -> DEATH;
  }

  /* ================================================================= */
  /* 19. TRIAL EVIDENCE ANCHORS                                         */
  /* ================================================================= */
  subgraph cluster_trials {
    label="19 · Calibration and falsification anchors";
    style="rounded,filled"; fillcolor="#f5f5f5"; color="#9e9e9e"; fontsize=11;
    T_SEMB [label="Semberova 2017\n85% closed before discharge\nmedians 71 d (<26+0 wk) but\n13 d (26+0–27+6)\n→ fixes PGE₂_SYN_INVOL", fillcolor="#ffffff", shape=note];
    T_BOSC [label="Baby-OSCAR 2024\nearly ibuprofen vs expectant\ndeath/BPD 69.2% vs 63.5%\n→ fits H_BPD0 + B_BPD_COX", fillcolor="#ffffff", shape=note];
    T_BENE [label="BeNeDuctus 2023\nexpectant non-inferior\n46.3% vs 63.5% composite\n→ PREDICTION, not fitted", fillcolor="#ffffff", shape=note];
    T_TIPP [label="TIPP 2001\nprophylactic indomethacin\nPDA 24% vs 50%, severe IVH\n9% vs 13%, 18-mo death/disability\n47% vs 46%\n→ PREDICTION", fillcolor="#ffffff", shape=note];
    T_PDAT [label="PDA-TOLERATE 2019\nno benefit of early routine\ntreatment at 6–14 days", fillcolor="#ffffff", shape=note];
    T_COCH [label="Cochrane / NMA\nibuprofen ≈ indomethacin ≈\nacetaminophen for closure;\nibuprofen less NEC/AKI", fillcolor="#ffffff", shape=note];
    T_SEMB -> SYNINVOL [style=dotted, arrowhead=none];
    T_BOSC -> COMPOS [style=dotted, arrowhead=none];
    T_BENE -> COMPOS [style=dotted, arrowhead=none];
    T_TIPP -> INDMAT [style=dotted, arrowhead=none];
    T_PDAT -> PDABUR [style=dotted, arrowhead=none];
    T_COCH -> NEC [style=dotted, arrowhead=none];
  }

  /* ================================================================= */
  /* 20. MANAGEMENT STRATEGY NODES                                      */
  /* ================================================================= */
  subgraph cluster_strategy {
    label="20 · Strategy — where the treatment decision actually lives";
    style="rounded,filled"; fillcolor="#e0f2f1"; color="#00695c";
    EXPECT  [label="Expectant management", fillcolor="#b2dfdb", shape=note];
    PROPHY  [label="Prophylaxis (<24 h,\nbefore the duct matters)", fillcolor="#b2dfdb", shape=note];
    EARLY   [label="Early treatment (day 2–3)", fillcolor="#b2dfdb", shape=note];
    TARGET  [label="Targeted / echo-guided:\ntreat only predicted\nHIGH-BURDEN ducts", fillcolor="#4db6ac", shape=note];
    FLUIDR  [label="Fluid restriction · diuretics", fillcolor="#b2dfdb", shape=note];
    PEEPADJ [label="↑ PEEP · permissive\nhypercapnia", fillcolor="#b2dfdb", shape=note];
    SCORE   [label="PDA severity score\n(echo + clinical)", fillcolor="#cfd8dc"];
    NNT     [label="Number needed to harm:\nducts treated that would\nhave closed anyway", fillcolor="#ffab91", shape=octagon];
    EXPECT -> SYNINVOL [label="relies on"];
    PROPHY -> INDDOSE; EARLY -> IBUDOSE; TARGET -> SCORE;
    SCORE -> PDABUR [style=dashed, label="predicts"];
    TARGET -> NNT [color="#2e7d32", arrowhead=tee, label="minimises"];
    BURDENWIN [label="THE BURDEN WINDOW IS THE FIRST WEEK\nBy day 7 the untreated shunt has already\nfallen below the significance threshold, so\nlate or echo-CONFIRMED treatment removes\nno burden and delivers the COX exposure in\nfull.  Targeting therefore needs early\nPREDICTION, not late confirmation.", fillcolor="#ffcdd2", shape=octagon];
    BURDENWIN -> TARGET [style=dashed, arrowhead=none];
    BURDENWIN -> SCORE [style=dashed, arrowhead=none];
    EARLY -> NNT [label="maximises", color="#c62828"];
    FLUIDR -> EVLW [color="#c62828", arrowhead=tee];
    PEEPADJ -> QSH [color="#c62828", arrowhead=tee];
    DPERKG -> SCORE; DALPA -> SCORE; LAAO -> SCORE; ABSDIAST -> SCORE;
  }

  /* ---------- cross-cluster edges that carry the theses ------------- */
  ICOXD -> PGE2K [style=invis];
  PGE2P -> PGE2D [constraint=false];
  PERMCLOSE -> PDABUR [label="ends burden accrual", color="#2e7d32",
                        arrowhead=tee, constraint=false, style=bold];
  SYNINVOL -> PERMCLOSE [label="the untreated route\nto the same place",
                        style=dashed, constraint=false];
}
