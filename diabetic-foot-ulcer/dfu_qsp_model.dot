digraph DFU_QSP {
  rankdir=LR;
  fontname="Helvetica";
  labelloc="t";
  fontsize=20;
  label="Diabetic Foot Ulcer (DFU) — Mechanistic QSP Map\nNeuropathy + Ischaemia + Repetitive Pressure → Ulceration → Protease-Dominant Stalled Wound → Closure, Recurrence or Amputation";
  node [style=filled, fontname="Helvetica", fontsize=10, shape=box];
  edge [fontname="Helvetica", fontsize=8];
  nodesep=0.28;
  ranksep=1.05;
  newrank=true;
  concentrate=false;

  //=========================================================================
  subgraph cluster_sys {
    label="1. Systemic Diabetic Milieu (slow axis — sets the substrate, not this week's wound)";
    style=filled; color="#e6d9ef"; fillcolor="#f4ecfa";
    Hyperglycaemia      [label="Chronic hyperglycaemia\n(T1D / T2D)"];
    HbA1c               [label="HbA1c\n(90-day glycaemic integral)"];
    GlycVariability     [label="Glycaemic variability\n(MAGE, time-in-range)"];
    Polyol              [label="Polyol flux\naldose reductase → sorbitol"];
    HexosaminePath      [label="Hexosamine pathway\nO-GlcNAc"];
    PKCbeta             [label="PKC-β activation\n(DAG)"];
    Methylglyoxal       [label="Methylglyoxal\n(dicarbonyl stress)"];
    AGE                 [label="Advanced glycation\nend-products (AGE)"];
    RAGE                [label="RAGE receptor\nsignalling"];
    NFkB_sys            [label="Systemic NF-κB\nactivation"];
    InsulinResistance   [label="Insulin resistance /\nhyperinsulinaemia"];
    Dyslipidaemia       [label="Dyslipidaemia\n(LDL, TG, small dense LDL)"];
    Obesity_BMI         [label="Obesity / BMI\n(loading + adipokines)"];
    Smoking             [label="Smoking\n(CO, nicotine vasoconstriction)"];
    CKD_eGFR            [label="Diabetic CKD\n(eGFR ↓, uraemic toxins)"];
    Dialysis            [label="Dialysis status\n(intradialytic hypotension)"];
    Albumin_Nutr        [label="Serum albumin /\nprotein-calorie nutrition"];
    Anaemia_Hb          [label="Anaemia\n(O2-carrying capacity ↓)"];
    VitD_Zinc           [label="Vitamin D / zinc /\nvitamin C status"];
    DiabetesDuration    [label="Diabetes duration\n(years)"];
  }

  //=========================================================================
  subgraph cluster_neuro {
    label="2. Diabetic Peripheral Neuropathy — Loss of Protective Sensation (LOPS)";
    style=filled; color="#d6e4f5"; fillcolor="#eaf2fc";
    NerveOxStress       [label="Endoneurial oxidative\nstress (ROS, ONOO⁻)"];
    VasaNervorum        [label="Vasa nervorum\nischaemia"];
    NGF_deficit         [label="NGF / neurotrophin\ndeficit"];
    SmallFibre          [label="Small-fibre (C, Aδ)\ndegeneration"];
    LargeFibre          [label="Large-fibre\ndemyelination"];
    IENFD               [label="Intraepidermal nerve\nfibre density ↓"];
    NCV                 [label="Nerve conduction\nvelocity ↓"];
    Monofilament        [label="10-g Semmes-Weinstein\nmonofilament INSENSATE"];
    VPT                 [label="Vibration perception\nthreshold >25 V"];
    LOPS                [label="LOSS OF PROTECTIVE\nSENSATION (LOPS)", fillcolor="#ffd9d9"];
    PainfulNeuropathy   [label="Painful neuropathy\n(paradoxical: pain ≠ protection)"];
    MotorNeuropathy     [label="Motor neuropathy\n(intrinsic muscle atrophy)"];
    AutonomicNeuro      [label="Autonomic neuropathy\n(sudomotor failure)"];
    Anhidrosis          [label="Anhidrosis → dry skin,\nfissuring"];
    AVShunt             [label="Arteriovenous shunting\n(warm but ischaemic foot)"];
    NeurogenicInflam    [label="Loss of neurogenic\ninflammation (SP, CGRP ↓)"];
    SubstanceP          [label="Substance P / CGRP\nwound signalling ↓"];
    NoWarningSignal     [label="No pain warning →\nundetected tissue injury", fillcolor="#ffd9d9"];
  }

  //=========================================================================
  subgraph cluster_biomech {
    label="3. Biomechanics — Repetitive Stress is the Proximate Cause";
    style=filled; color="#f5e6cc"; fillcolor="#fdf4e5";
    LJM                 [label="Limited joint mobility\n(collagen glycation)"];
    EquinusAchilles     [label="Achilles contracture /\nankle equinus"];
    ClawToe             [label="Claw / hammer toe\ndeformity"];
    MTHeadProminence    [label="Metatarsal head\nprominence, fat-pad migration"];
    HalluxValgus        [label="Hallux valgus /\nprevious amputation geometry"];
    Charcot             [label="Charcot neuro-\narthropathy (rocker-bottom)"];
    PeakPlantarPressure [label="PEAK PLANTAR PRESSURE\n(kPa)", fillcolor="#ffe9c9"];
    ShearStress         [label="Shear / friction\nstress"];
    PressureTimeInteg   [label="Pressure-time integral\n(cumulative stress)"];
    StepCount           [label="Daily step count /\nactivity level"];
    Callus              [label="Callus (hyperkeratosis)\n→ 26× ulcer risk"];
    SubcallusHaematoma  [label="Subkeratotic\nhaematoma"];
    RepetitiveStress    [label="Repetitive moderate stress\n(not single trauma)", fillcolor="#ffe9c9"];
    IllFittingFootwear  [label="Ill-fitting footwear /\nforeign body"];
    ThermalTrauma       [label="Thermal / chemical\ntrauma (unfelt)"];
  }

  //=========================================================================
  subgraph cluster_pad {
    label="4. Peripheral Arterial Disease & Macrovascular Perfusion";
    style=filled; color="#f2d5d5"; fillcolor="#fbeaea";
    Atherosclerosis     [label="Infrapopliteal\natherosclerosis"];
    Monckeberg          [label="Mönckeberg medial\ncalcification"];
    ABI                 [label="ABI (falsely normal/high\nif calcified)"];
    ToePressure         [label="Toe pressure\n(mmHg)"];
    TBI                 [label="Toe-brachial index"];
    TcPO2               [label="TcPO₂ (mmHg)\nperfusion gate", fillcolor="#ffd9d9"];
    SkinPerfPressure    [label="Skin perfusion\npressure"];
    WIfI                [label="WIfI stage\n(Wound-Ischaemia-foot Infection)"];
    CollateralFlow      [label="Collateral / angiosome\nflow"];
    CLTI                [label="Chronic limb-threatening\nischaemia (CLTI)"];
    Endovascular        [label="Endovascular\nrevascularisation (PTA)"];
    DistalBypass        [label="Distal bypass\ngraft"];
    RestenosisRate      [label="Restenosis /\ngraft failure"];
    Cilostazol          [label="Cilostazol / antiplatelet\n+ statin"];
    PerfusionIndex      [label="EFFECTIVE WOUND\nPERFUSION", fillcolor="#ffd9d9"];
  }

  //=========================================================================
  subgraph cluster_micro {
    label="5. Microvascular & Endothelial Dysfunction";
    style=filled; color="#e0d5f2"; fillcolor="#f0eafb";
    CapBMThickening     [label="Capillary basement\nmembrane thickening"];
    eNOS_uncoupling     [label="eNOS uncoupling\n(BH4 depletion)"];
    NO_bioavail         [label="NO bioavailability ↓"];
    ET1                 [label="Endothelin-1 ↑\n(vasoconstriction)"];
    PericyteLoss        [label="Pericyte dropout"];
    MicroReactivity     [label="Microvascular reactivity ↓\n(post-occlusive hyperaemia)"];
    CapRecruitFail      [label="Capillary recruitment\nfailure on demand"];
    FunctionalIschaemia [label="Functional microvascular\nischaemia (normal ABI)"];
    EndoGlycocalyx      [label="Endothelial glycocalyx\nshedding"];
    LeukoAdhesion       [label="Leukocyte-endothelial\nadhesion (ICAM-1, VCAM-1)"];
    Oedema_Interstitial [label="Interstitial oedema →\ndiffusion distance ↑"];
  }

  //=========================================================================
  subgraph cluster_o2 {
    label="6. Wound Tissue Oxygenation & HIF Signalling";
    style=filled; color="#cfe8e2"; fillcolor="#e7f7f2";
    WoundPO2            [label="WOUND TISSUE pO₂", fillcolor="#d5f0e6"];
    O2_gradient         [label="Radial O₂ gradient\nfrom wound edge"];
    HIF1a               [label="HIF-1α stabilisation"];
    HIF1a_MGO_block     [label="Methylglyoxal adduction of\nHIF-1α/p300 → HIF FAILS\ndespite hypoxia", fillcolor="#ffd9d9"];
    PHD_ProlylHydrox    [label="Prolyl hydroxylase\n(O₂-dependent, collagen)"];
    CollagenHydroxy     [label="Collagen proline/lysine\nhydroxylation (needs O₂)"];
    OxidativeBurst_O2   [label="Neutrophil oxidative burst\n(needs pO₂ >30 mmHg)"];
    HBOT                [label="Hyperbaric O₂\n2.4 ATA × 90 min"];
    TopicalO2           [label="Topical / continuous-\ndiffusion oxygen"];
    O2_Toxicity         [label="O₂ toxicity: seizure,\nbarotrauma, myopia"];
  }

  //=========================================================================
  subgraph cluster_init {
    label="7. Ulcer Initiation, Anatomy & Classification";
    style=filled; color="#f0dcc8"; fillcolor="#fbefe2";
    SkinBreak           [label="Skin breakdown /\nulcer onset"];
    UlcerLocation       [label="Location (plantar MT head,\nhallux, heel, dorsum)"];
    WoundArea           [label="WOUND AREA (cm²)", fillcolor="#ffe0b3"];
    WoundPerimeter      [label="Wound perimeter\nP ≈ 2√(πA)"];
    WoundDepth          [label="Wound depth /\ntissue level"];
    Undermining         [label="Undermining /\nsinus tract"];
    ProbeToBone         [label="Probe-to-bone test\npositive"];
    WagnerGrade         [label="Wagner grade\n0-5"];
    UT_Classification   [label="University of Texas\ngrade/stage"];
    SINBAD              [label="SINBAD score\n(0-6)"];
    IWGDF_Class         [label="IWGDF/IDSA\nclassification"];
    WoundDuration       [label="Ulcer duration at\npresentation (>2 mo = poor)"];
    NecroticEschar      [label="Necrotic slough /\neschar burden"];
  }

  //=========================================================================
  subgraph cluster_hemo {
    label="8. Haemostasis & Acute Inflammatory Onset (Normal Phase 1)";
    style=filled; color="#f5d5d9"; fillcolor="#fceaec";
    PlateletPlug        [label="Platelet plug /\ndegranulation"];
    FibrinClot          [label="Fibrin provisional\nmatrix"];
    PDGF_release        [label="α-granule PDGF-BB\nrelease"];
    TGFb_release        [label="Latent TGF-β1\nrelease"];
    DAMPs               [label="DAMPs (HMGB1, mtDNA,\nS100A8/A9)"];
    TLR4                [label="TLR2/TLR4 →\nMyD88 → NF-κB"];
    ComplementC5a       [label="Complement C3a/C5a\nchemotaxis"];
    NeutRecruit         [label="Neutrophil\nrecruitment"];
    MonoRecruit         [label="Monocyte recruitment\n(CCL2/MCP-1)"];
  }

  //=========================================================================
  subgraph cluster_inflam {
    label="9. Chronic Stalled Inflammation — the DFU Lesion (Phase 1 never ends)";
    style=filled; color="#f7d1c4"; fillcolor="#fdeae2";
    NeutPersist         [label="Persistent neutrophil\ninfiltrate"];
    NETosis             [label="NETosis (PAD4, citH3)\n↑ in diabetes", fillcolor="#ffd9d9"];
    NET_DNA             [label="NET DNA/histone\nwound burden"];
    NeutElastase        [label="Neutrophil elastase\n+ cathepsin G"];
    M1_Macrophage       [label="M1 pro-inflammatory\nmacrophage"];
    M2_Macrophage       [label="M2 reparative\nmacrophage"];
    M1M2_SwitchFail     [label="M1→M2 SWITCH FAILURE\n(the central defect)", fillcolor="#ffcccc"];
    EfferocytosisFail   [label="Impaired efferocytosis\n(apoptotic cell clearance)"];
    NLRP3               [label="NLRP3 inflammasome\n→ caspase-1"];
    IL1b                [label="IL-1β\n(self-amplifying loop)", fillcolor="#ffd9d9"];
    TNFa                [label="TNF-α"];
    IL6_w               [label="IL-6"];
    IL8_CXCL8           [label="IL-8 / CXCL8"];
    MCP1                [label="MCP-1 / CCL2"];
    IL10                [label="IL-10\n(resolution signal, ↓)"];
    NOX2_ROS            [label="NOX2-derived ROS\nwound burden"];
    iNOS                [label="iNOS / peroxynitrite"];
    FOXO1_dysreg        [label="FOXO1 dysregulation\n(keratinocyte apoptosis)"];
    MicroRNA_dysreg     [label="miR-146a ↓ / miR-155 ↑\n(inflammation brake lost)"];
  }

  //=========================================================================
  subgraph cluster_prot {
    label="10. Protease / Anti-Protease Imbalance — Why Biologics Fail";
    style=filled; color="#e4d9c2"; fillcolor="#f5efe1";
    MMP1                [label="MMP-1\n(interstitial collagenase)"];
    MMP2                [label="MMP-2 (gelatinase A)"];
    MMP8                [label="MMP-8 (neutrophil\ncollagenase) — ~65× ↑"];
    MMP9                [label="MMP-9 (gelatinase B)\n↑↑ in non-healing DFU", fillcolor="#ffd9d9"];
    TIMP1               [label="TIMP-1 ↓"];
    TIMP2               [label="TIMP-2 ↓"];
    MMP9_TIMP1_ratio    [label="MMP-9/TIMP-1 RATIO\n= healing predictor", fillcolor="#ffd9d9"];
    ECM_Degradation     [label="Net ECM degradation\n> deposition"];
    GF_Proteolysis      [label="PROTEOLYSIS OF APPLIED\nGROWTH FACTORS", fillcolor="#ffcccc"];
    FN_Fragmentation    [label="Fibronectin\nfragmentation"];
    Receptor_Shedding   [label="Growth-factor receptor\nectodomain shedding"];
    ProteaseMod_Dressing[label="Protease-modulating dressing\n(ORC/collagen, TLC-NOSF)"];
  }

  //=========================================================================
  subgraph cluster_gf {
    label="11. Growth-Factor Axis (endogenous, deficient and degraded)";
    style=filled; color="#d5eccd"; fillcolor="#ecf8e8";
    PDGF_BB             [label="PDGF-BB\n(fibroblast mitogen/chemoattractant)"];
    PDGFR_b             [label="PDGFR-β signalling"];
    VEGFA               [label="VEGF-A"];
    FGF2                [label="FGF-2 / bFGF"];
    EGF_w               [label="EGF / HB-EGF"];
    KGF_FGF7            [label="KGF / FGF-7\n(keratinocyte)"];
    IGF1_w              [label="IGF-1"];
    TGFb1               [label="TGF-β1\n(fibroblast → myofibroblast)"];
    TGFb3               [label="TGF-β3\n(scarless bias)"];
    SDF1_CXCL12         [label="SDF-1α / CXCL12"];
    DPP4_cleavage       [label="DPP-4 cleaves SDF-1α\n(inactivation)", fillcolor="#ffd9d9"];
    CXCR4               [label="CXCR4 on EPC /\nstem cells"];
    GF_Sequestration    [label="GF sequestration in\nfibrin/senescent matrix"];
  }

  //=========================================================================
  subgraph cluster_angio {
    label="12. Angiogenesis & Progenitor Mobilisation";
    style=filled; color="#f2ccd8"; fillcolor="#fbe6ec";
    TipCell             [label="Endothelial tip cell\n(DLL4/Notch)"];
    StalkCell           [label="Stalk cell\nproliferation"];
    VEGFR2              [label="VEGFR2 signalling"];
    Ang1_Tie2           [label="Ang-1 / Tie2\n(vessel maturation)"];
    Ang2                [label="Ang-2\n(destabilisation)"];
    EPC_BoneMarrow      [label="Bone-marrow EPC pool"];
    EPC_MobilisationFail[label="EPC mobilisation FAILURE\n(diabetic stem-cell mobilopathy)", fillcolor="#ffd9d9"];
    EPC_Homing          [label="EPC homing to wound\n(SDF-1α/CXCR4)"];
    Sprouting           [label="Capillary sprouting"];
    GranulationVasc     [label="GRANULATION TISSUE\nVASCULAR DENSITY", fillcolor="#f9d6e2"];
    VesselMaturation    [label="Pericyte coverage /\nvessel maturation"];
    Lymphangiogenesis   [label="Lymphangiogenesis\n(oedema clearance)"];
  }

  //=========================================================================
  subgraph cluster_fib {
    label="13. Fibroblast, Myofibroblast, ECM & Granulation";
    style=filled; color="#d8e6c8"; fillcolor="#eef5e6";
    DermalFibroblast    [label="Dermal fibroblast\npool"];
    FibProliferation    [label="Fibroblast proliferation"];
    FibMigration        [label="Fibroblast migration\ninto wound bed"];
    FibSenescence       [label="FIBROBLAST SENESCENCE\n(p16^INK4a, SA-β-gal)", fillcolor="#ffd9d9"];
    SASP                [label="SASP secretome\n(IL-6, IL-8, MMPs)"];
    FibUnresponsive     [label="Blunted response to\nPDGF/TGF-β (receptor ↓)"];
    Myofibroblast       [label="Myofibroblast\n(α-SMA⁺)"];
    WoundContraction    [label="Wound contraction"];
    CollagenI           [label="Collagen type I\nsynthesis"];
    CollagenIII         [label="Collagen type III\n(early granulation)"];
    Fibronectin         [label="Fibronectin\nprovisional matrix"];
    Hyaluronan          [label="Hyaluronan /\nproteoglycan"];
    LOX_Crosslink       [label="LOX collagen\ncross-linking"];
    GranulationFill     [label="GRANULATION TISSUE\nFILL (depth ↓)", fillcolor="#e2f0d0"];
    ECM_Remodelling     [label="ECM remodelling\n(III → I)"];
    TensileStrength     [label="Scar tensile strength\n(plateaus ~80%)"];
  }

  //=========================================================================
  subgraph cluster_epi {
    label="14. Keratinocyte Biology & Re-Epithelialisation";
    style=filled; color="#cdd9f0"; fillcolor="#e8eefb";
    KeratinoProlif      [label="Keratinocyte\nproliferation (present!)"];
    KeratinoMigration   [label="Keratinocyte MIGRATION\n(absent — the DFU paradox)", fillcolor="#ffd9d9"];
    cMyc_overexp        [label="c-Myc overexpression\n→ blocks migration"];
    NuclearBcatenin     [label="Nuclear β-catenin\n(K6/K16 dysregulation)"];
    EpidermalStemCell   [label="Epidermal stem-cell\nexhaustion"];
    Integrin_a6b4       [label="Integrin α6β4 /\nlaminin-332"];
    EMT_partial         [label="Partial EMT program\nfor migration"];
    EpithelialFront     [label="EPITHELIAL EDGE\nADVANCE RATE (mm/day)", fillcolor="#d3ddf7"];
    Epibole             [label="Epibole / rolled\nhyperkeratotic edge"];
    EdgeCallus          [label="Peri-wound callus\n(mechanical barrier)"];
    BasementMembrane    [label="Basement membrane\nreconstitution"];
    Reepithelialisation [label="Complete\nre-epithelialisation"];
  }

  //=========================================================================
  subgraph cluster_inf {
    label="15. Infection, Biofilm & Osteomyelitis";
    style=filled; color="#e8dcc0"; fillcolor="#f7f0dd";
    Colonisation        [label="Surface colonisation\n(all DFUs)"];
    BacterialLoad       [label="Bacterial load\n(log₁₀ CFU/g; 10⁵ threshold)"];
    S_aureus            [label="S. aureus / MRSA"];
    Strep               [label="β-haemolytic\nstreptococci"];
    Pseudomonas         [label="P. aeruginosa\n(moist/tropical wounds)"];
    Anaerobes           [label="Anaerobes\n(deep/necrotic)"];
    Polymicrobial       [label="Polymicrobial\ncommunity"];
    Biofilm_EPS         [label="BIOFILM EPS MATRIX\n(≥60% of chronic wounds)", fillcolor="#ffd9d9"];
    QuorumSensing       [label="Quorum sensing\n(agr, las/rhl)"];
    PersisterCells      [label="Persister cells /\nmetabolic dormancy"];
    AbxTolerance        [label="Biofilm antibiotic tolerance\n(100-1000× MIC)", fillcolor="#ffcccc"];
    BiofilmReform48h    [label="Biofilm reforms to tolerance\nin 24-72 h post-debridement", fillcolor="#ffcccc"];
    HostDefenceEvasion  [label="Phagocyte frustration /\nevasion"];
    SoftTissueInfection [label="Soft-tissue infection\n(IWGDF grade 2-3)"];
    SpreadingCellulitis [label="Spreading cellulitis /\nsystemic sepsis"];
    Osteomyelitis       [label="OSTEOMYELITIS\n(~20% of infected DFU)", fillcolor="#ffd9d9"];
    BoneNecrosis        [label="Bone necrosis /\nsequestrum"];
    BoneAbxPenetration  [label="Antibiotic bone\npenetration (rifampicin ↑)"];
    WetGangrene         [label="Wet gangrene /\nnecrotising infection"];
  }

  //=========================================================================
  subgraph cluster_immune {
    label="16. Hyperglycaemia-Impaired Innate Defence";
    style=filled; color="#dcd0e8"; fillcolor="#efe8f6";
    NeutChemotaxis      [label="Neutrophil chemotaxis ↓"];
    NeutPhagocytosis    [label="Phagocytosis ↓"];
    NeutKilling         [label="Intracellular killing ↓\n(glucose-impaired burst)"];
    ComplementGlyc      [label="Glycated complement →\nopsonisation ↓"];
    MacrophagePlast     [label="Macrophage plasticity ↓\n(epigenetic memory)"];
    AMP_Defensins       [label="β-defensin / cathelicidin\nLL-37 ↓"];
    TcellDysfunc        [label="T-cell / γδ-T dendritic\nepidermal cell dysfunction"];
    ImmuneParadox       [label="Paradox: inflamed wound,\nincompetent defence", fillcolor="#ffd9d9"];
  }

  //=========================================================================
  subgraph cluster_offload {
    label="17. Offloading & Mechanical Intervention (largest single effect)";
    style=filled; color="#c9e2ea"; fillcolor="#e4f4f8";
    TCC                 [label="Total contact cast (TCC)\nIRREMOVABLE", fillcolor="#cdeef7"];
    iTCC_Walker         [label="Instant TCC\n(rendered irremovable walker)"];
    RemovableWalker     [label="Removable cast walker\n(RCW)"];
    HalfShoe            [label="Half-shoe /\ntherapeutic shoe"];
    Adherence_Wear      [label="ADHERENCE: RCW worn only\n~28% of daily activity", fillcolor="#ffd9d9"];
    EffectiveOffload    [label="EFFECTIVE OFFLOADING\n= efficacy × adherence", fillcolor="#cdeef7"];
    Felted_Foam         [label="Felted foam /\naccommodative padding"];
    AchillesLengthening [label="Achilles tendon\nlengthening"];
    CustomInsole        [label="Custom insole /\npressure-guided orthosis"];
    TherapeuticFootwear [label="Therapeutic footwear\n(post-healing)"];
  }

  //=========================================================================
  subgraph cluster_pkpd {
    label="18. Pharmacology, Devices & Procedures (PK/PD)";
    style=filled; color="#cbd8e8"; fillcolor="#e6edf7";
    SharpDebridement    [label="Sharp/surgical debridement\n(scheduled, q1-2 wk)", fillcolor="#dbe6f5"];
    DebridementFreq     [label="Debridement FREQUENCY\n(more = faster healing)"];
    Becaplermin_gel     [label="Becaplermin 0.01% gel\n(rhPDGF-BB, topical qd)"];
    Becaplermin_wound   [label="Becaplermin wound-tissue\nconcentration"];
    TLC_NOSF            [label="TLC-NOSF sucrose octasulfate\ndressing (protease/MMP mod.)"];
    Esmolol_gel         [label="Esmolol 14% topical gel\n(β2-AR block → keratinocyte migration)"];
    NPWT                [label="NPWT (−125 mmHg)\nmacro/microdeformation"];
    CTP_BLCC            [label="Bilayered living cellular\nconstruct (Apligraf)"];
    CTP_dHACM           [label="Dehydrated human amnion/\nchorion membrane"];
    LeucoPatch          [label="Autologous leucocyte-platelet-\nfibrin patch"];
    Abx_Central         [label="Systemic antibiotic\ncentral PK"];
    Abx_Wound           [label="Antibiotic wound-tissue\nconcentration"];
    Abx_Bone            [label="Antibiotic bone\nconcentration"];
    Rifampicin_adj      [label="Rifampicin adjunct\n(biofilm-active)"];
    Ertapenem_Dalba     [label="Ertapenem / dalbavancin /\namox-clav / vancomycin"];
    Metformin_sys       [label="Metformin"];
    GLP1_RA             [label="GLP-1 RA (semaglutide)\nweight + glycaemia"];
    SGLT2i              [label="SGLT2 inhibitor\n(amputation-signal debate)"];
    Insulin_sys         [label="Insulin therapy"];
    DPP4i               [label="DPP-4 inhibitor\n(↑ intact SDF-1α)"];
    Statin_ACEi         [label="Statin / ACE-inhibitor\n(vascular substrate)"];
    SurgicalResection   [label="Surgical bone resection\n(osteomyelitis)"];
    MinorAmputation     [label="Minor (transmetatarsal/\ndigital) amputation"];
    MajorAmputation     [label="Major (BKA/AKA)\namputation", fillcolor="#ffcccc"];
  }

  //=========================================================================
  subgraph cluster_endpoint {
    label="19. Clinical Endpoints";
    style=filled; color="#f0e2b8"; fillcolor="#faf3dc";
    AreaTrajectory      [label="Wound-area trajectory\nA(t)"];
    PAR4                [label="PAR₄ — % area reduction\nat 4 weeks", fillcolor="#ffeeb8"];
    HealingRate_mm      [label="Linear edge advance\n(mm/day)"];
    Closure12wk         [label="COMPLETE CLOSURE\nat 12 / 20 weeks", fillcolor="#ffeeb8"];
    TimeToHeal          [label="Time to healing\n(days)"];
    UlcerFreeDays       [label="Ulcer-free days\n(patient-centred)"];
    Recurrence12mo      [label="Recurrence at 12 mo\n(~40%)", fillcolor="#ffd9d9"];
    Recurrence36mo      [label="Recurrence at 36 mo\n(~60%)"];
    AmputationFree      [label="Amputation-free\nsurvival"];
    Hospitalisation     [label="Hospitalisation /\nIV antibiotic days"];
    InfectionEpisode    [label="Infection episode\nrate"];
    QoL_EQ5D            [label="Quality of life\n(EQ-5D, DFS-SF)"];
    PainScore           [label="Pain / discomfort\nscore"];
    Cost                [label="Direct cost /\nresource use"];
    Mortality5yr        [label="5-year mortality\n(~30%; >50% post-major-amp)", fillcolor="#ffcccc"];
    CompositeBenefit    [label="Composite clinical\nbenefit index"];
