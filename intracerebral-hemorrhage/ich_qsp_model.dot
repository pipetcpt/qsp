digraph ICH_QSP {
  rankdir=LR;
  fontname="Helvetica";
  labelloc="t";
  fontsize=20;
  label="Spontaneous Intracerebral Haemorrhage (ICH) — Mechanistic QSP Map\nBleeding rate = driving pressure × hemostatic incompetence  |  Outcome = mass effect ⊕ heme-iron toxicity  |  MAP enters twice with opposite sign (CPP = MAP − ICP)";
  node [style=filled, fontname="Helvetica", fontsize=10, shape=box];
  edge [fontname="Helvetica", fontsize=8];
  compound=true;
  newrank=true;   /* required: 20 mutually-cyclic clusters break dot's default init_rank */
  nodesep=0.22;
  ranksep=0.58;

  /* ============================================================
     1. Aetiology & small-vessel vasculopathy
     ============================================================ */
  subgraph cluster_aetio {
    label="1. 원인 · 소혈관 병변 (Aetiology & Small-Vessel Vasculopathy)";
    style=filled; color="#e0dcf0"; fillcolor="#f3f0fb";
    HTN_chronic [label="Chronic hypertension\n(dominant risk, deep ICH)", fillcolor="#d9d2f2"];
    Lipohyalinosis [label="Lipohyalinosis /\narteriolosclerosis"];
    CharcotBouchard [label="Charcot-Bouchard\nmicroaneurysm"];
    Perforator [label="Lenticulostriate /\nthalamoperforate arteriole\n(50-200 µm)", fillcolor="#d9d2f2"];
    CAA [label="Cerebral amyloid angiopathy\n(Aβ40 in leptomeningeal /\ncortical vessels) → lobar ICH", fillcolor="#d9d2f2"];
    APOE [label="APOE ε2 / ε4\n(CAA rupture risk)"];
    Microbleeds [label="Cerebral microbleeds\n(SWI burden)"];
    cSS [label="Cortical superficial\nsiderosis (Boston v2.0)"];
    WMH_burden [label="White-matter hyperintensity\n(SVD burden score)"];
    AVM_cavernoma [label="AVM / cavernoma /\ndural AV fistula (secondary)"];
    Tumour_bleed [label="Haemorrhagic metastasis\n(secondary)"];
    Sympathomimetic [label="Cocaine / amphetamine\nsurge (secondary)"];
    Location_deep [label="Deep location:\nbasal ganglia / thalamus / pons", fillcolor="#eae5f8"];
    Location_lobar [label="Lobar location:\ncortico-subcortical", fillcolor="#eae5f8"];
    Location_cbl [label="Cerebellar\n(≥3 cm → surgical)", fillcolor="#eae5f8"];
    Vessel_rupture [label="ARTERIOLAR RUPTURE\n(N open bleeding sites)", shape=octagon, fillcolor="#f0a0a0"];
  }

  /* ============================================================
     2. Haematoma growth (the integral, not the state)
     ============================================================ */
  subgraph cluster_growth {
    label="2. 혈종 성장 — 상태가 아니라 적분 (Haematoma Growth as an Integral)";
    style=filled; color="#f2c8c8"; fillcolor="#fdeeee";
    BleedRate [label="dV/dt bleeding flux\n= ΔP × (1 − clot competence)\n× N_open × conductance", shape=octagon, fillcolor="#f08585"];
    VHEM [label="V_HEM  Haematoma volume\n(ABC/2 or planimetry, mL)", shape=doubleoctagon, fillcolor="#e05555", fontcolor=white];
    Expansion [label="HAEMATOMA EXPANSION\n(>33% or >6 mL @24 h;\n~20-38% untreated)", shape=octagon, fillcolor="#f0a0a0"];
    Avalanche [label="Mechanical avalanche:\nhaematoma shears\nadjacent arterioles\n→ N_open ↑ (positive feedback)", fillcolor="#f6c0c0"];
    SpotSign [label="CTA spot sign /\nBAT score\n(active extravasation)"];
    TimeToCT [label="Onset-to-CT interval\n(earlier = more to expand)"];
    Resorption [label="Clot resorption\n(erythrophagocytosis,\nt½ ≈ 8-14 d)"];
    Tamponade [label="Local tamponade:\ntissue pressure ↑\n→ bleeding flux ↓\n(self-limiting term)", fillcolor="#f6d5d5"];
    VIVH [label="V_IVH Intraventricular\nextension (Graeb / mIVH;\n~40% of ICH)", shape=doubleoctagon, fillcolor="#e57373"];
    SAH_ext [label="Subarachnoid\nextension"];
  }

  /* ============================================================
     3. Haemostasis: the clot-competence factor
     ============================================================ */
  subgraph cluster_hemostasis {
    label="3. 지혈 — 클롯 경쟁력 인자 (Haemostasis at the Rupture Site)";
    style=filled; color="#c9d9f0"; fillcolor="#eef3fb";
    TF_brain [label="Brain tissue factor\n(highest TF content\nof any organ)", fillcolor="#b8cdec"];
    FVIIa_TF [label="TF-FVIIa complex\n(extrinsic initiation)"];
    FX_FXa [label="FX → FXa"];
    Prothrombinase [label="FXa-FVa-Ca-PL\nprothrombinase"];
    FII [label="Prothrombin (FII)\nactivity", fillcolor="#b8cdec"];
    Thrombin [label="THROMBIN burst\n(peak / ETP)", shape=octagon, fillcolor="#8fb4e0"];
    Fibrinogen [label="Fibrinogen\n(<200 mg/dL → expansion)"];
    Fibrin [label="Fibrin polymer\ncross-linked by FXIII"];
    Platelet [label="Platelet count ×\nfunction (VerifyNow /\nPFA closure time)", fillcolor="#b8cdec"];
    vWF_GPIb [label="vWF-GPIbα adhesion /\nGPIIb-IIIa aggregation"];
    CLOT [label="CLOT COMPETENCE\n(0 = free flow, 1 = sealed)", shape=doubleoctagon, fillcolor="#5b8fd0", fontcolor=white];
    Plasmin [label="Plasmin\n(tPA/uPA-driven lysis)", fillcolor="#b8cdec"];
    PAI1 [label="PAI-1 / α2-antiplasmin"];
    Hyperfibrinolysis [label="Local hyperfibrinolysis\n(ROTEM LY30 ↑)"];
    Uraemia [label="Uraemic / hepatic\nplatelet dysfunction"];
  }

  /* ============================================================
     4. Antithrombotic drug exposure (the cause of incompetence)
     ============================================================ */
  subgraph cluster_antithrombotic {
    label="4. 항응고 · 항혈소판 노출 (Antithrombotic Exposure — 12-20% of ICH)";
    style=filled; color="#d8cbb8"; fillcolor="#f7f2e9";
    Warfarin [label="Warfarin (VKA)\nVKORC1 inhibition", fillcolor="#e3d3b8"];
    INR [label="INR (surrogate of\nFII/VII/IX/X activity)", shape=octagon, fillcolor="#e0cfae"];
    VitK_cycle [label="Vitamin K epoxide\nreductase cycle\n→ γ-carboxylation"];
    Apixaban [label="Apixaban / rivaroxaban\n(direct FXa inhibitor)", fillcolor="#e3d3b8"];
    AntiXa [label="Anti-Xa activity\n(ng/mL calibrated)"];
    Dabigatran [label="Dabigatran\n(direct thrombin inhibitor)", fillcolor="#e3d3b8"];
    dTT [label="Dilute thrombin time /\necarin clotting time"];
    Heparin_LMWH [label="UFH / LMWH\n(antithrombin-mediated)"];
    Aspirin [label="Aspirin\n(COX-1 → TXA2 ↓)", fillcolor="#e3d3b8"];
    Clopidogrel [label="Clopidogrel / ticagrelor\n(P2Y12 blockade)", fillcolor="#e3d3b8"];
    TXA2 [label="Thromboxane A2\ngeneration"];
    OAC_ICH_pheno [label="OAC-associated ICH:\nlarger baseline volume,\nlonger expansion window\n(up to 48-72 h)", fillcolor="#e8d8bd"];
  }

  /* ============================================================
     5. Haemostatic / reversal pharmacology
     ============================================================ */
  subgraph cluster_reversal {
    label="5. 역전 · 지혈 약물 PK/PD (Reversal & Haemostatic Pharmacology)";
    style=filled; color="#b9dcc4"; fillcolor="#eef8f1";
    PCC4F [label="4F-PCC 25-50 IU/kg\n(II, VII, IX, X + protein C/S)", fillcolor="#a3d4b3"];
    PCC_effect [label="INR normalisation\n<1.3 within 10-30 min\n(INCH trial vs FFP)"];
    VitK_IV [label="Vitamin K 10 mg IV\n(sustains correction, 6-24 h)"];
    FFP [label="Fresh frozen plasma\n(volume load, slow)"];
    Andexanet [label="Andexanet alfa\n(modified FXa decoy;\nbolus + 2 h infusion)", fillcolor="#a3d4b3"];
    Andex_rebound [label="Anti-Xa rebound after\ninfusion stop (~2 h)\n+ thrombotic signal\n(ANNEXA-I)", fillcolor="#f6d5d5"];
    Idarucizumab [label="Idarucizumab 5 g\n(dabigatran Fab,\nKd ≈ 350× thrombin)", fillcolor="#a3d4b3"];
    TXA [label="Tranexamic acid\n1 g bolus + 1 g/8 h\n(lysine analogue)", fillcolor="#a3d4b3"];
    TXA_mech [label="Blocks plasminogen\nlysine-binding site\n→ fibrinolysis ↓"];
    rFVIIa [label="rFVIIa 80 µg/kg\n(FAST: expansion ↓,\noutcome flat, thrombosis ↑)", fillcolor="#f6d5d5"];
    PlateletTx [label="Platelet transfusion\n(PATCH: HARM in\nantiplatelet ICH)", fillcolor="#f6a5a5"];
    DDAVP [label="Desmopressin 0.4 µg/kg\n(vWF/FVIII release)"];
    Protamine [label="Protamine\n(heparin reversal)"];
    Cryo [label="Cryoprecipitate /\nfibrinogen concentrate"];
  }

  /* ============================================================
     6. Blood-pressure control & autonomic drive
     ============================================================ */
  subgraph cluster_bp {
    label="6. 혈압 · 자율신경 구동 (Blood Pressure & Autonomic Drive)";
    style=filled; color="#f0d9b8"; fillcolor="#fdf5e9";
    SNS [label="Sympathetic surge\n(catecholamine storm,\nCushing response)", fillcolor="#eecfa0"];
    Baroreflex [label="Baroreflex\n(impaired by brainstem\n/ insular lesion)"];
    RAAS [label="RAAS activation\n(renin-Ang II-aldosterone)"];
    Pain_agitation [label="Pain / agitation /\nurinary retention"];
    SBP [label="SBP (mmHg)\nadmission median 150-200", shape=doubleoctagon, fillcolor="#e8b878"];
    MAP [label="MAP = DBP + (SBP−DBP)/3", shape=octagon, fillcolor="#e8b878"];
    SBPV [label="SBP variability\n(SD / successive variation)\n— independent harm signal", fillcolor="#f6d5d5"];
    Insular [label="Insular / hypothalamic\nautonomic lesion"];
    StressCardio [label="Neurogenic stress\ncardiomyopathy, troponin ↑,\nECG repolarisation"];
    HR [label="Heart rate"];
  }

  /* ============================================================
     7. Antihypertensive pharmacology
     ============================================================ */
  subgraph cluster_antihtn {
    label="7. 강압제 PK/PD (Antihypertensive Pharmacology)";
    style=filled; color="#e6cdd8"; fillcolor="#faeef3";
    Nicardipine [label="Nicardipine IV\n5-15 mg/h titrated\n(L-type DHP CCB)", fillcolor="#dcb3c4"];
    Nica_PK [label="Nicardipine 2-cmt PK\n(CL ≈ 0.4 L/min,\ncontext-sensitive t½)"];
    Nica_effect [label="Effect compartment\nke0 ≈ 1.4 /h\n(hysteresis)"];
    Clevidipine [label="Clevidipine\n(ester, t½ ≈ 1 min,\nblood-esterase cleared)", fillcolor="#dcb3c4"];
    Labetalol [label="Labetalol bolus 10-20 mg\n(α1 + β blockade)", fillcolor="#dcb3c4"];
    Urapidil [label="Urapidil\n(α1 + 5-HT1A)"];
    Esmolol [label="Esmolol\n(rate control)"];
    SVR [label="Systemic vascular\nresistance ↓"];
    CerebralVSM [label="Cerebral arteriolar\nsmooth-muscle tone"];
    TargetAch [label="Time-to-target &\ntarget depth\n(INTERACT3: <1 h, <140)", fillcolor="#e6c2d0"];
  }

  /* ============================================================
     8. Monro-Kellie, ICP and cerebral perfusion
     ============================================================ */
  subgraph cluster_icp {
    label="8. Monro-Kellie · ICP · 관류 (Intracranial Volume Budget & Perfusion)";
    style=filled; color="#c8d6dc"; fillcolor="#eef4f6";
    MonroKellie [label="V_brain + V_blood + V_CSF\n+ V_HEM + V_EDEMA + V_IVH\n= const (rigid vault)", shape=octagon, fillcolor="#a9c3cd"];
    Compliance [label="Craniospinal compliance\n(exponential P-V curve,\nPVI)"];
    ICP [label="ICP (mmHg)\n= residual of volume budget", shape=doubleoctagon, fillcolor="#7fa8b8", fontcolor=white];
    CPP [label="CPP = MAP − ICP", shape=doubleoctagon, fillcolor="#7fa8b8", fontcolor=white];
    Autoreg [label="Cerebral autoregulation\n(plateau shifted right in HTN,\nimpaired peri-haematomally)", fillcolor="#a9c3cd"];
    PRx [label="PRx / pressure reactivity\n(dynamic autoregulation index)"];
    CBF_peri [label="Perihaematomal CBF\n(oligaemia without\ntrue ischaemic core)", shape=octagon, fillcolor="#a9c3cd"];
    Midline [label="Midline shift (mm) /\npineal displacement"];
    Herniation [label="Uncal / central /\ntonsillar herniation", fillcolor="#f6a5a5"];
    Hydroceph [label="Obstructive hydrocephalus\n(3rd/4th ventricle cast)"];
    CSF_out [label="CSF outflow resistance\n(arachnoid granulation\nblockade by blood)"];
    Osmotherapy [label="Mannitol 0.5-1 g/kg /\n23.4% NaCl\n(osmotic gradient)", fillcolor="#a9c3cd"];
    Hypervent [label="Hyperventilation\n(PaCO2 30-35 → vasoconstriction,\ntemporary only)"];
    Sedation [label="Sedation / analgesia\n(CMRO2 ↓)"];
  }

  /* ============================================================
     9. Perihaematomal oedema — three sequential mechanisms
     ============================================================ */
  subgraph cluster_edema {
    label="9. 혈종주변 부종 — 3단계 (Perihaematomal Oedema: Ionic → Vasogenic → Cytotoxic)";
    style=filled; color="#cfe0c0"; fillcolor="#f2f7ec";
    ClotRetract [label="Clot retraction &\nserum extrusion\n(0-4 h, hydrostatic)"];
    OED_EARLY [label="V_EDEMA_early\nionic + vasogenic\n(peak 3-5 d)", shape=doubleoctagon, fillcolor="#a8c98f"];
    OED_LATE [label="V_EDEMA_late\ncytotoxic / iron-driven\n(peak 7-14 d)", shape=doubleoctagon, fillcolor="#a8c98f"];
    Thrombin_tissue [label="Extravasated thrombin\n→ PAR-1 on astrocytes\n/ endothelium", fillcolor="#b8d4a0"];
    PAR1 [label="PAR-1 signalling\n→ Src → RhoA\n→ junction disassembly"];
    SUR1_TRPM4 [label="SUR1-TRPM4 channel\n(glibenclamide-sensitive\noncotic swelling)", fillcolor="#b8d4a0"];
    AQP4 [label="AQP4 astrocytic\nwater flux"];
    NKCC1 [label="NKCC1 / SLC12A2\nionic uptake"];
    Complement [label="Complement C3a/C5a,\nMAC assembly"];
    BBB [label="BBB permeability\n(Ktrans, tight-junction\nZO-1/claudin-5 loss)", shape=octagon, fillcolor="#a8c98f"];
    MMP9 [label="MMP-9 / MMP-3\n(basal-lamina digestion)", fillcolor="#b8d4a0"];
    VEGF_local [label="VEGF-A\n(permeability factor)"];
    PHE_rel [label="Relative PHE growth\n(PHE/V_HEM — outcome\npredictor independent of V)"];
  }

  /* ============================================================
     10. Haem & iron toxicity — the delayed, chemical channel
     ============================================================ */
  subgraph cluster_iron {
    label="10. 헴 · 철 독성 — 지연성 화학 손상 (Haem & Iron Toxicity)";
    style=filled; color="#dcc2b0"; fillcolor="#f8efe8";
    RBC_lysis [label="Erythrocyte lysis in clot\n(days 1-7, complement +\nmechanical)", fillcolor="#d3ab93"];
    FreeHb [label="Free haemoglobin\n(oxyHb → metHb)", fillcolor="#d3ab93"];
    Haptoglobin [label="Haptoglobin\n(Hp1-1/2-2 genotype)\nscavenging capacity"];
    CD163 [label="CD163 macrophage\nHb-Hp uptake"];
    FreeHeme [label="Free haem\n(TLR4 agonist, oxidant)", shape=octagon, fillcolor="#c99a7c"];
    Hemopexin [label="Hemopexin / LRP1\nhaem clearance"];
    HO1 [label="Haem oxygenase-1\n(inducible; releases Fe2+,\nCO, biliverdin)", fillcolor="#d3ab93"];
    FeII [label="Labile Fe2+ pool\n(non-transferrin bound)", shape=doubleoctagon, fillcolor="#b8845f", fontcolor=white];
    Ferritin [label="Ferritin sequestration\n(and ferritin ↑ = expansion\nrisk marker)"];
    Transferrin [label="Transferrin / TfR1\nefflux"];
    Fenton [label="Fenton reaction\nFe2+ + H2O2 → •OH", fillcolor="#c99a7c"];
    LipidPerox [label="Lipid peroxidation\n(4-HNE, MDA, F2-isoprostane)", fillcolor="#c99a7c"];
    GPX4 [label="GPX4 / GSH axis"];
    Ferroptosis [label="FERROPTOSIS\n(ACSL4-dependent\nneuronal death)", shape=octagon, fillcolor="#f0a0a0"];
    DFO [label="Deferoxamine mesylate\n32 mg/kg/d × 3 d\n(i-DEF: mRS shift, V unchanged)", fillcolor="#a3d4b3"];
    Feroxamine [label="Feroxamine complex\n→ renal excretion"];
    Nrf2 [label="Nrf2-ARE antioxidant\nprogramme (HO-1, NQO1, FTH)"];
  }

  /* ============================================================
     11. Neuroinflammation & clot clearance
     ============================================================ */
  subgraph cluster_inflam {
    label="11. 신경염증 · 혈종 청소 (Neuroinflammation & Haematoma Clearance)";
    style=filled; color="#f0cfd8"; fillcolor="#fceff3";
    DAMPs [label="DAMPs: haem, Hb, HMGB1,\nperoxiredoxin-2, ATP", fillcolor="#e5b3c2"];
    TLR4 [label="TLR4-MyD88\n→ NF-κB"];
    NLRP3 [label="NLRP3 inflammasome\n→ caspase-1 → IL-1β", fillcolor="#e5b3c2"];
    Microglia_M1 [label="Microglia / macrophage\npro-inflammatory state", shape=octagon, fillcolor="#e5b3c2"];
    Microglia_M2 [label="Reparative / phagocytic\nstate (CD36, Nrf2, PPARγ)", fillcolor="#c8e6c9"];
    Neutrophil [label="Neutrophil infiltration\n(MPO, NETs, elastase)", fillcolor="#e5b3c2"];
    Tcell [label="T-lymphocyte /\nTreg (IL-10, TGF-β)"];
    IL6 [label="IL-6 / TNF-α / IL-1β\n(perihaematomal + serum)", shape=octagon, fillcolor="#e5b3c2"];
    IL10 [label="IL-10 / TGF-β\nresolution signals", fillcolor="#c8e6c9"];
    Erythrophago [label="Erythrophagocytosis\n(CD36-mediated;\nrate-limits clot clearance)", fillcolor="#c8e6c9"];
    Astrogliosis [label="Reactive astrogliosis\n(GFAP ↑) & glial scar"];
    PPARg [label="PPARγ agonism\n(pioglitazone, SHRINC)"];
    Fingolimod [label="Fingolimod / natalizumab\n(lymphocyte trafficking ↓;\npilot only)"];
  }

  /* ============================================================
     12. Neuronal & white-matter injury
     ============================================================ */
  subgraph cluster_neuro {
    label="12. 신경세포 · 백질 손상 (Neuronal & White-Matter Injury)";
    style=filled; color="#cdd3ea"; fillcolor="#eff1f9";
    MassEffect [label="Mechanical mass effect\n(tissue strain, axonal\ndisplacement)", shape=octagon, fillcolor="#b2bade"];
    Glutamate [label="Glutamate excitotoxicity\n(NMDA / AMPA, Ca2+ influx)"];
    MitoDys [label="Mitochondrial\ndepolarisation, ATP ↓"];
    Apoptosis [label="Caspase-3 apoptosis /\nnecroptosis (RIPK1/3)"];
    Autophagy [label="Autophagy flux\n(dual role)"];
    NEURON [label="Viable perihaematomal\nneuron fraction", shape=doubleoctagon, fillcolor="#8f9bd0", fontcolor=white];
    WM_tract [label="Corticospinal-tract\nintegrity (DTI FA at\nposterior limb of IC)", shape=doubleoctagon, fillcolor="#8f9bd0", fontcolor=white];
    Disconnect [label="Network disconnection\n(lesion-symptom mapping)"];
    Diaschisis [label="Contralateral / cerebellar\ndiaschisis"];
    Plasticity [label="Contralesional\nreorganisation & recovery\n(τ ≈ 30-90 d)", fillcolor="#c8e6c9"];
    Rehab [label="Early mobilisation &\nintensive rehabilitation", fillcolor="#c8e6c9"];
  }

  /* ============================================================
     13. IVH, hydrocephalus & CSF interventions
     ============================================================ */
  subgraph cluster_ivh {
    label="13. 뇌실내출혈 · 수두증 (IVH, Hydrocephalus & CSF Interventions)";
    style=filled; color="#c9d6e8"; fillcolor="#eef2f9";
    IVH_cast [label="Ventricular blood cast\n(Graeb / LeRoux score)"];
    EVD [label="External ventricular drain\n(ICP relief, CSF diversion)", fillcolor="#a3d4b3"];
    IVH_tPA [label="Intraventricular alteplase\n1 mg q8h (CLEAR III:\nmortality ↓, mRS 0-3 flat)", fillcolor="#a3d4b3"];
    IVH_clear_rate [label="IVH clearance rate\n(>85% removal → outcome\nbenefit threshold)"];
    Ependymal [label="Ependymal injury &\nsubventricular inflammation"];
    ShuntDep [label="Permanent shunt\ndependency"];
    VentDrainInf [label="Drain-related\nventriculitis"];
    LumbarDrain [label="Lumbar drainage\n(communicating only)"];
  }

  /* ============================================================
     14. Surgical strategies
     ============================================================ */
  subgraph cluster_surgery {
    label="14. 수술 전략 (Surgical Strategies)";
    style=filled; color="#b8d8d8"; fillcolor="#ecf7f7";
    Craniotomy [label="Open craniotomy\n(STICH I/II: no overall\nbenefit in supratentorial)", fillcolor="#f6d5d5"];
    MISTIE [label="MISTIE III: image-guided\ncatheter + alteplase\n(mRS benefit only if\nEOT volume ≤15 mL)", fillcolor="#a3d4b3"];
    ENRICH [label="ENRICH: early (<24 h)\ntrans-sulcal parafascicular\nevacuation, lobar\n(utility-weighted mRS ↑)", fillcolor="#a3d4b3"];
    EOT_vol [label="End-of-treatment volume\n(the actual mediator —\nnot the incision)", shape=octagon, fillcolor="#8fc3c3"];
    DecompCranx [label="Decompressive craniectomy\n(ICP salvage)"];
    Cbl_evac [label="Cerebellar ICH ≥3 cm\nor brainstem compression\n→ evacuation (class I)"];
    SurgicalRebleed [label="Procedural re-bleed\n(N_open ↑)", fillcolor="#f6d5d5"];
    Timing [label="Timing paradox: early =\nmore rebleed, late = more\nsecondary injury already fixed"];
  }

  /* ============================================================
     15. Systemic complications & physiological targets
     ============================================================ */
  subgraph cluster_systemic {
    label="15. 전신 합병증 · 생리 목표 (Systemic Complications & Physiological Targets)";
    style=filled; color="#ded8c8"; fillcolor="#f8f6ef";
    Fever [label="Fever / temperature\n(>37.5 °C — bundle target)", fillcolor="#e8dfc8"];
    Hyperglycaemia [label="Hyperglycaemia\n(bundle target 6.1-7.8 /\n7.8-10.0 mmol/L)", fillcolor="#e8dfc8"];
    Dysphagia [label="Dysphagia → aspiration\npneumonia"];
    VTE_risk [label="DVT / PE\n(IPC ± delayed LMWH)"];
    AKI [label="AKI (contrast, ATACH-2\nrenal signal with\naggressive BP drop)", fillcolor="#f6d5d5"];
    Seizure [label="Acute symptomatic seizure\n(lobar > deep; ~8-16%)"];
    ASM [label="Levetiracetam / lacosamide\n(treat, not prophylax)"];
    NSE [label="Na+ disturbance:\nSIADH / cerebral salt wasting"];
    Sepsis [label="Nosocomial infection\n(HAP, CAUTI)"];
    DNR_bias [label="Early DNR / withdrawal\n→ self-fulfilling prophecy\n(confounds all trials)", fillcolor="#f6d5d5"];
  }

  /* ============================================================
     16. Care bundle & systems of care
     ============================================================ */
  subgraph cluster_bundle {
    label="16. 통합 치료 묶음 (Care Bundle — the multiplicative logic)";
    style=filled; color="#c0dcc0"; fillcolor="#eef7ee";
    Bundle [label="INTERACT3 care bundle:\nBP + glucose + fever +\nanticoagulation reversal\n(mRS OR 0.86)", shape=octagon, fillcolor="#8fc98f"];
    Protocol_adherence [label="Protocol adherence /\nimplementation fidelity"];
    StrokeUnit [label="Dedicated stroke /\nneurocritical care unit"];
    Prehospital [label="Prehospital MSU BP lowering\n(INTERACT4: earlier is\nbetter in haemorrhage)", fillcolor="#8fc98f"];
    Telemedicine [label="Telestroke &\ntransfer pathways"];
  }

  /* ============================================================
     17. Secondary prevention
     ============================================================ */
  subgraph cluster_prevention {
    label="17. 이차 예방 (Secondary Prevention)";
    style=filled; color="#d0d8e8"; fillcolor="#f1f4f9";
    BP_longterm [label="Long-term BP control\n(SPS3/PROGRESS; SBP <130)", fillcolor="#b8c8e0"];
    Recurrence [label="Recurrence risk\n(lobar/CAA ~7%/yr >\ndeep ~2%/yr)", shape=octagon, fillcolor="#b8c8e0"];
    OAC_restart [label="OAC restart dilemma\n(APACHE-AF / SoSTART /\nENRICH-AF)"];
    LAAO [label="LAA occlusion\nalternative"];
    Statin_q [label="Statin continuation\nin lobar ICH (uncertain)"];
    Antiplatelet_restart [label="Antiplatelet restart\n(RESTART: no excess\nrecurrence)"];
    Alcohol_smoke [label="Alcohol / smoking\ncessation"];
  }

  /* ============================================================
     18. Biomarkers & imaging
     ============================================================ */
  subgraph cluster_biomarker {
    label="18. 바이오마커 · 영상 (Biomarkers & Imaging)";
    style=filled; color="#e0d8ea"; fillcolor="#f5f1fa";
    NCCT [label="Non-contrast CT\n(ABC/2 volume, IVH, shift)"];
    CT_markers [label="Blend sign, black hole,\nirregular shape,\nheterogeneous density"];
    CTA_spot [label="CTA spot sign\n(PPV for expansion)"];
    GFAP_ratio [label="GFAP ↑ / Aβ42 ↓ ratio\n(hyperacute ICH vs\nischaemia discrimination)"];
    Dimer [label="D-dimer, fibrin\ndegradation products"];
    NLR [label="Neutrophil-lymphocyte\nratio (outcome marker)"];
    Copeptin [label="Copeptin / MR-proADM\n(stress axis)"];
    Serum_ferritin [label="Serum ferritin\n(iron-load proxy)"];
    MRI_SWI [label="MRI SWI / T2* iron\nquantification"];
    ICH_score [label="ICH score / max-ICH /\nFUNC score"];
  }

  /* ============================================================
     19. Clinical endpoints
     ============================================================ */
  subgraph cluster_endpoint {
    label="19. 임상 결과지표 (Clinical Endpoints)";
    style=filled; color="#f0c8b0"; fillcolor="#fdf0e8";
    GCS [label="GCS / consciousness\n(hourly)", shape=doubleoctagon, fillcolor="#e8a878"];
    NIHSS [label="NIHSS (0-42)", shape=doubleoctagon, fillcolor="#e8a878"];
    END [label="Early neurological\ndeterioration (NIHSS ≥4 /\nGCS ≥2 within 24-72 h)", shape=octagon, fillcolor="#f0a0a0"];
    mRS90 [label="mRS at 90 days\n(ordinal shift analysis)", shape=doubleoctagon, fillcolor="#e08050", fontcolor=white];
    Mortality30 [label="30-day / 90-day\nmortality (~30-40%)", shape=doubleoctagon, fillcolor="#e08050", fontcolor=white];
    UWmRS [label="Utility-weighted mRS\n(ENRICH primary)"];
    Barthel [label="Barthel index /\nindependence (mRS 0-2)"];
    Cognition [label="Post-ICH cognitive\nimpairment / dementia"];
    Depression [label="Post-stroke depression\n& fatigue"];
    QALY [label="QALY / cost-effectiveness"];
  }

  /* ============================================================
     20. Model exposure accumulators (observables, not parameters)
     ============================================================ */
  subgraph cluster_accum {
    label="20. 노출 누적 지표 — 파라미터가 아닌 관측량 (Exposure Accumulators)";
    style=filled; color="#d8d8d8"; fillcolor="#f4f4f4";
    AUC_SBP140 [label="AUC of SBP above 140\n(hypertensive load, mmHg·h)", shape=octagon];
    T_CPP60 [label="Time with CPP <60 mmHg\n(hypoperfusion dose)", shape=octagon];
    T_ICP20 [label="Time with ICP >20 mmHg\n(intracranial dose)", shape=octagon];
    AUC_FeII [label="AUC of labile Fe2+\n(iron-exposure dose)", shape=octagon];
    AUC_IL6 [label="AUC of IL-6\n(inflammatory dose)", shape=octagon];
    dV24 [label="ΔV at 24 h\n(expansion magnitude)", shape=octagon];
  }

  /* ============================================================
     EDGES — 1. Aetiology → rupture
     ============================================================ */
  HTN_chronic -> Lipohyalinosis;
  HTN_chronic -> CharcotBouchard;
  HTN_chronic -> WMH_burden;
  HTN_chronic -> SBP [style=dashed];
  Lipohyalinosis -> Perforator;
  CharcotBouchard -> Perforator;
  Perforator -> Vessel_rupture [penwidth=2];
  CAA -> Location_lobar;
  CAA -> Vessel_rupture [penwidth=2];
  APOE -> CAA;
  APOE -> Microbleeds;
  CAA -> Microbleeds;
  CAA -> cSS;
  Microbleeds -> Recurrence;
  cSS -> Recurrence;
  WMH_burden -> Autoreg [label="SVD impairs"];
  WMH_burden -> mRS90 [style=dashed];
  AVM_cavernoma -> Vessel_rupture;
  Tumour_bleed -> Vessel_rupture;
  Sympathomimetic -> SBP;
  Sympathomimetic -> Vessel_rupture;
  Perforator -> Location_deep;
  Location_deep -> WM_tract [label="internal capsule"];
  Location_lobar -> Seizure;
  Location_lobar -> Cognition;
  Location_cbl -> Cbl_evac;
  Location_cbl -> Hydroceph;

  /* 2. Rupture → bleeding flux → volume */
  Vessel_rupture -> BleedRate [penwidth=3];
  MAP -> BleedRate [label="ΔP driving term", penwidth=3, color="#c05050"];
  CLOT -> BleedRate [label="(1 − competence)", penwidth=3, color="#3060b0", arrowhead=tee];
  BleedRate -> VHEM [penwidth=3];
  VHEM -> Expansion;
  dV24 -> Expansion;
  BleedRate -> dV24;
  VHEM -> Avalanche;
  Avalanche -> Vessel_rupture [label="+feedback", color="#c05050", penwidth=2];
  VHEM -> Tamponade;
  Tamponade -> BleedRate [arrowhead=tee, color="#3060b0"];
  VHEM -> Resorption;
  Resorption -> VHEM [arrowhead=tee];
  SpotSign -> Expansion [style=dashed, label="predicts"];
  BleedRate -> SpotSign;
  TimeToCT -> Expansion [style=dashed];
  VHEM -> VIVH [label="ventricular rupture"];
  VHEM -> SAH_ext;
  VIVH -> IVH_cast;
  Expansion -> END [penwidth=2];
  Expansion -> mRS90 [penwidth=2];

  /* 3. Haemostasis → clot competence */
  TF_brain -> FVIIa_TF;
  FVIIa_TF -> FX_FXa;
  FX_FXa -> Prothrombinase;
  Prothrombinase -> Thrombin [penwidth=2];
  FII -> Thrombin [penwidth=2];
  Thrombin -> Fibrin [penwidth=2];
  Fibrinogen -> Fibrin;
  Thrombin -> Platelet [label="activation"];
  Platelet -> vWF_GPIb;
  vWF_GPIb -> CLOT;
  Fibrin -> CLOT [penwidth=3];
  Platelet -> CLOT [penwidth=2];
  Plasmin -> Fibrin [arrowhead=tee, label="lysis", color="#c05050"];
  Plasmin -> CLOT [arrowhead=tee, color="#c05050"];
  PAI1 -> Plasmin [arrowhead=tee];
  Hyperfibrinolysis -> Plasmin;
  Thrombin -> Thrombin_tissue [label="extravasation", style=dashed];
  Uraemia -> Platelet [arrowhead=tee];

  /* 4. Antithrombotics → incompetence */
  Warfarin -> VitK_cycle [arrowhead=tee];
  VitK_cycle -> FII [label="γ-carboxylation"];
  Warfarin -> INR;
  INR -> FII [arrowhead=tee, style=dashed, label="surrogate"];
  FII -> INR [arrowhead=tee, style=dashed];
  Apixaban -> AntiXa;
  AntiXa -> FX_FXa [arrowhead=tee, penwidth=2, color="#c05050"];
  Dabigatran -> dTT;
  Dabigatran -> Thrombin [arrowhead=tee, penwidth=2, color="#c05050"];
  Heparin_LMWH -> Thrombin [arrowhead=tee];
  Aspirin -> TXA2 [arrowhead=tee];
  TXA2 -> Platelet;
  Clopidogrel -> Platelet [arrowhead=tee, color="#c05050"];
  Warfarin -> OAC_ICH_pheno;
  Apixaban -> OAC_ICH_pheno;
  Dabigatran -> OAC_ICH_pheno;
  OAC_ICH_pheno -> VHEM [style=dashed, label="larger, longer window"];
  OAC_ICH_pheno -> Mortality30 [style=dashed];

  /* 5. Reversal pharmacology */
  PCC4F -> FII [penwidth=2, color="#2e8b57"];
  PCC4F -> PCC_effect;
  PCC_effect -> INR [arrowhead=tee];
  VitK_IV -> VitK_cycle;
  FFP -> FII;
  FFP -> ICP [style=dashed, label="volume load"];
  Andexanet -> AntiXa [arrowhead=tee, penwidth=2, color="#2e8b57"];
  Andexanet -> Andex_rebound;
  Andex_rebound -> AntiXa [label="rebound"];
  Andex_rebound -> VTE_risk;
  Idarucizumab -> Dabigatran [arrowhead=tee, penwidth=2, color="#2e8b57"];
  TXA -> TXA_mech;
  TXA_mech -> Plasmin [arrowhead=tee, penwidth=2, color="#2e8b57"];
  rFVIIa -> Thrombin;
  rFVIIa -> VTE_risk;
  PlateletTx -> Platelet;
  PlateletTx -> Mortality30 [label="PATCH harm", color="#c05050", style=dashed];
  DDAVP -> vWF_GPIb;
  Protamine -> Heparin_LMWH [arrowhead=tee];
  Cryo -> Fibrinogen;

  /* 6-7. BP control */
  SNS -> SBP [penwidth=2];
  SNS -> HR;
  SNS -> StressCardio;
  Baroreflex -> SBP [arrowhead=tee];
  Insular -> Baroreflex [arrowhead=tee];
  Insular -> SNS;
  RAAS -> SBP;
  Pain_agitation -> SNS;
  ICP -> SNS [label="Cushing reflex", color="#c05050"];
  SBP -> MAP [penwidth=2];
  SBP -> SBPV;
  SBPV -> mRS90 [style=dashed, color="#c05050"];
  Nicardipine -> Nica_PK;
  Nica_PK -> Nica_effect;
  Nica_effect -> SVR [arrowhead=tee];
  Nica_effect -> CerebralVSM [arrowhead=tee];
  Clevidipine -> SVR [arrowhead=tee];
  Labetalol -> SVR [arrowhead=tee];
  Labetalol -> HR [arrowhead=tee];
  Urapidil -> SVR [arrowhead=tee];
  Esmolol -> HR [arrowhead=tee];
  SVR -> SBP [arrowhead=tee, penwidth=2, color="#2e8b57"];
  Nicardipine -> TargetAch;
  TargetAch -> AUC_SBP140 [arrowhead=tee];
  CerebralVSM -> CBF_peri;

  /* 8. ICP / CPP — the double role of MAP */
  VHEM -> MonroKellie [penwidth=2];
  OED_EARLY -> MonroKellie [penwidth=2];
  OED_LATE -> MonroKellie;
  VIVH -> MonroKellie;
  Hydroceph -> MonroKellie;
  MonroKellie -> ICP [penwidth=3];
  Compliance -> ICP [arrowhead=tee];
  MonroKellie -> Compliance [arrowhead=tee];
  MAP -> CPP [penwidth=3, color="#2e8b57", label="+"];
  ICP -> CPP [arrowhead=tee, penwidth=3, color="#c05050", label="−"];
  CPP -> CBF_peri [penwidth=2];
  Autoreg -> CBF_peri [penwidth=2];
  PRx -> Autoreg [style=dashed];
  CPP -> T_CPP60 [arrowhead=tee];
  ICP -> T_ICP20;
  ICP -> Midline;
  VHEM -> Midline [penwidth=2];
  Midline -> Herniation;
  ICP -> Herniation [penwidth=2];
  Herniation -> Mortality30 [penwidth=3, color="#c05050"];
  VIVH -> Hydroceph;
  VIVH -> CSF_out [arrowhead=tee];
  CSF_out -> Hydroceph;
  Osmotherapy -> OED_EARLY [arrowhead=tee, color="#2e8b57"];
  Osmotherapy -> ICP [arrowhead=tee, color="#2e8b57"];
  Osmotherapy -> NSE;
  Hypervent -> ICP [arrowhead=tee];
  Hypervent -> CBF_peri [arrowhead=tee, color="#c05050", label="over-constriction"];
  Sedation -> ICP [arrowhead=tee];
  Sedation -> MAP [arrowhead=tee];
  ICP -> GCS [arrowhead=tee, penwidth=2];

  /* 9. Oedema cascade */
  VHEM -> ClotRetract;
  ClotRetract -> OED_EARLY [penwidth=2];
  Thrombin -> PAR1;
  Thrombin_tissue -> PAR1 [penwidth=2];
  PAR1 -> BBB [penwidth=2];
  PAR1 -> OED_EARLY [penwidth=2];
  SUR1_TRPM4 -> OED_EARLY [penwidth=2];
  NLRP3 -> SUR1_TRPM4;
  AQP4 -> OED_EARLY;
  AQP4 -> OED_LATE;
  NKCC1 -> OED_EARLY;
  Complement -> BBB;
  Complement -> RBC_lysis;
  MMP9 -> BBB [penwidth=2, color="#c05050"];
  VEGF_local -> BBB;
  BBB -> OED_EARLY [penwidth=3];
  BBB -> OED_LATE [penwidth=2];
  BBB -> Neutrophil [label="entry"];
  OED_EARLY -> PHE_rel;
  OED_LATE -> PHE_rel;
  PHE_rel -> mRS90 [style=dashed, penwidth=2];
  OED_EARLY -> MassEffect [penwidth=2];
  OED_LATE -> MassEffect;

  /* 10. Haem-iron axis */
  VHEM -> RBC_lysis [penwidth=2];
  RBC_lysis -> FreeHb [penwidth=3];
  FreeHb -> Haptoglobin;
  Haptoglobin -> CD163 [arrowhead=tee, label="scavenged"];
  Haptoglobin -> FreeHeme [arrowhead=tee, color="#2e8b57"];
  FreeHb -> FreeHeme [penwidth=2];
  Hemopexin -> FreeHeme [arrowhead=tee, color="#2e8b57"];
  FreeHeme -> HO1 [penwidth=2];
  FreeHeme -> TLR4 [penwidth=2];
  HO1 -> FeII [penwidth=3];
  Nrf2 -> HO1;
  Nrf2 -> Ferritin;
  FeII -> Ferritin [arrowhead=tee];
  Ferritin -> FeII [arrowhead=tee, color="#2e8b57"];
  Transferrin -> FeII [arrowhead=tee];
  FeII -> Fenton [penwidth=3];
  Fenton -> LipidPerox [penwidth=3];
  LipidPerox -> Ferroptosis [penwidth=3];
  GPX4 -> LipidPerox [arrowhead=tee, color="#2e8b57"];
  LipidPerox -> GPX4 [arrowhead=tee];
  Ferroptosis -> NEURON [arrowhead=tee, penwidth=3, color="#c05050"];
  DFO -> FeII [arrowhead=tee, penwidth=3, color="#2e8b57"];
  DFO -> Feroxamine;
  FeII -> AUC_FeII;
  FeII -> OED_LATE [penwidth=2];
  LipidPerox -> BBB;
  FeII -> Seizure [style=dashed, label="cortical iron"];
  FeII -> MRI_SWI [style=dashed];
  Ferritin -> Serum_ferritin [style=dashed];
  DFO -> mRS90 [label="i-DEF shift\nwithout ΔV", color="#2e8b57", style=dashed, penwidth=2];

  /* 11. Inflammation */
  FreeHeme -> DAMPs [penwidth=2];
  RBC_lysis -> DAMPs;
  MassEffect -> DAMPs;
  DAMPs -> TLR4 [penwidth=2];
  TLR4 -> Microglia_M1 [penwidth=2];
  TLR4 -> NLRP3;
  NLRP3 -> IL6 [penwidth=2];
  Microglia_M1 -> IL6 [penwidth=3];
  Microglia_M1 -> MMP9 [penwidth=2];
  IL6 -> Neutrophil;
  Neutrophil -> MMP9 [penwidth=2];
  Neutrophil -> LipidPerox;
  IL6 -> AUC_IL6;
  IL6 -> Fever [penwidth=2];
  IL6 -> Hyperglycaemia;
  Tcell -> IL10;
  IL10 -> Microglia_M1 [arrowhead=tee, color="#2e8b57"];
  IL10 -> Microglia_M2 [color="#2e8b57"];
  Microglia_M2 -> Erythrophago [penwidth=2, color="#2e8b57"];
  Erythrophago -> Resorption [penwidth=2, color="#2e8b57"];
  Erythrophago -> FreeHeme [arrowhead=tee, color="#2e8b57"];
  PPARg -> Microglia_M2 [color="#2e8b57"];
  Nrf2 -> Microglia_M2;
  CD163 -> Erythrophago;
  Fingolimod -> Tcell [arrowhead=tee];
  Fingolimod -> OED_EARLY [arrowhead=tee];
  Microglia_M1 -> Astrogliosis;
  Astrogliosis -> GFAP_ratio;
  IL6 -> NLR [style=dashed];
  Neutrophil -> NLR [style=dashed];

  /* 12. Neuronal injury & recovery */
  MassEffect -> NEURON [arrowhead=tee, penwidth=3];
  MassEffect -> Glutamate;
  CBF_peri -> MitoDys [arrowhead=tee, penwidth=2];
  Glutamate -> MitoDys;
  MitoDys -> Apoptosis;
  MitoDys -> Fenton [label="H2O2 source"];
  Apoptosis -> NEURON [arrowhead=tee, penwidth=2];
  Autophagy -> NEURON [style=dashed];
  IL6 -> NEURON [arrowhead=tee];
  VHEM -> WM_tract [arrowhead=tee, penwidth=3];
  OED_EARLY -> WM_tract [arrowhead=tee, penwidth=2];
  LipidPerox -> WM_tract [arrowhead=tee];
  NEURON -> NIHSS [arrowhead=tee, penwidth=3];
  WM_tract -> NIHSS [arrowhead=tee, penwidth=3];
  WM_tract -> Disconnect [arrowhead=tee];
  Disconnect -> Cognition;
  Disconnect -> Diaschisis;
  Plasticity -> NIHSS [arrowhead=tee, color="#2e8b57", penwidth=2];
  Rehab -> Plasticity [color="#2e8b57", penwidth=2];
  NEURON -> Plasticity;

  /* 13. IVH interventions */
  IVH_cast -> Hydroceph [penwidth=2];
  IVH_cast -> GCS [arrowhead=tee, penwidth=2];
  EVD -> ICP [arrowhead=tee, penwidth=2, color="#2e8b57"];
  EVD -> Hydroceph [arrowhead=tee, color="#2e8b57"];
  EVD -> VentDrainInf;
  IVH_tPA -> IVH_clear_rate [penwidth=2, color="#2e8b57"];
  IVH_clear_rate -> VIVH [arrowhead=tee, penwidth=2];
  IVH_tPA -> BleedRate [label="rebleed risk", color="#c05050", style=dashed];
  IVH_clear_rate -> Mortality30 [arrowhead=tee, color="#2e8b57", penwidth=2];
  Ependymal -> ShuntDep;
  IVH_cast -> Ependymal;
  Hydroceph -> ShuntDep;
  LumbarDrain -> Hydroceph [arrowhead=tee];
  VentDrainInf -> Sepsis;

  /* 14. Surgery */
  Craniotomy -> EOT_vol [arrowhead=tee];
  MISTIE -> EOT_vol [arrowhead=tee, penwidth=3, color="#2e8b57"];
  ENRICH -> EOT_vol [arrowhead=tee, penwidth=3, color="#2e8b57"];
  EOT_vol -> VHEM [arrowhead=tee, penwidth=3];
  EOT_vol -> mRS90 [arrowhead=tee, penwidth=2, label="≤15 mL threshold"];
  Craniotomy -> SurgicalRebleed;
  MISTIE -> SurgicalRebleed;
  SurgicalRebleed -> Vessel_rupture [color="#c05050"];
  DecompCranx -> ICP [arrowhead=tee, color="#2e8b57"];
  DecompCranx -> MonroKellie [label="vault opened"];
  Cbl_evac -> ICP [arrowhead=tee];
  Cbl_evac -> Mortality30 [arrowhead=tee, color="#2e8b57"];
  Timing -> SurgicalRebleed [style=dashed];
  Timing -> EOT_vol [style=dashed];
  ENRICH -> UWmRS [color="#2e8b57"];

  /* 15. Systemic */
  Fever -> IL6;
  Fever -> NEURON [arrowhead=tee];
  Hyperglycaemia -> LipidPerox;
  Hyperglycaemia -> mRS90 [style=dashed, color="#c05050"];
  Dysphagia -> Sepsis;
  Sepsis -> Fever;
  Sepsis -> mRS90 [color="#c05050", style=dashed];
  VTE_risk -> Mortality30;
  Nica_effect -> AKI [style=dashed];
  MAP -> AKI [arrowhead=tee, style=dashed, label="renal perfusion"];
  Seizure -> ICP;
  Seizure -> Glutamate;
  ASM -> Seizure [arrowhead=tee, color="#2e8b57"];
  NSE -> OED_EARLY;
  DNR_bias -> Mortality30 [color="#c05050", penwidth=2];
  DNR_bias -> mRS90 [color="#c05050"];

  /* 16. Bundle */
  Bundle -> TargetAch [penwidth=2, color="#2e8b57"];
  Bundle -> Hyperglycaemia [arrowhead=tee, color="#2e8b57"];
  Bundle -> Fever [arrowhead=tee, color="#2e8b57"];
  Bundle -> PCC4F [color="#2e8b57"];
  Bundle -> mRS90 [arrowhead=tee, penwidth=3, color="#2e8b57"];
  Protocol_adherence -> Bundle [penwidth=2];
  StrokeUnit -> Protocol_adherence;
  Prehospital -> TargetAch [color="#2e8b57", penwidth=2];
  Prehospital -> TimeToCT [arrowhead=tee];
  Telemedicine -> StrokeUnit;

  /* 17. Prevention */
  BP_longterm -> Recurrence [arrowhead=tee, penwidth=2, color="#2e8b57"];
  Recurrence -> Mortality30 [style=dashed];
  OAC_restart -> Recurrence [color="#c05050"];
  LAAO -> OAC_restart [arrowhead=tee];
  Statin_q -> Recurrence [style=dashed];
  Antiplatelet_restart -> Recurrence [style=dashed];
  Alcohol_smoke -> BP_longterm;
  Alcohol_smoke -> Recurrence [arrowhead=tee];
  CAA -> OAC_restart [style=dashed, label="highest risk"];

  /* 18. Biomarkers / imaging → decisions */
  NCCT -> VHEM [style=dashed, label="measures"];
  NCCT -> Midline [style=dashed];
  CT_markers -> Expansion [style=dashed];
  CTA_spot -> SpotSign [style=dashed];
  GFAP_ratio -> Prehospital [style=dashed, label="triage"];
  Dimer -> Hyperfibrinolysis [style=dashed];
  Copeptin -> SNS [style=dashed];
  MRI_SWI -> CAA [style=dashed];
  ICH_score -> Mortality30 [style=dashed, penwidth=2];
  VHEM -> ICH_score [style=dashed];
  VIVH -> ICH_score [style=dashed];
  GCS -> ICH_score [style=dashed];

  /* 19. Endpoint integration */
  GCS -> NIHSS [style=dashed];
  NIHSS -> mRS90 [penwidth=3];
  NIHSS -> END;
  END -> mRS90 [penwidth=2];
  END -> Mortality30;
  mRS90 -> Barthel [style=dashed];
  mRS90 -> UWmRS [style=dashed];
  mRS90 -> QALY [style=dashed];
  Cognition -> mRS90;
  Depression -> mRS90 [style=dashed];
  Cognition -> QALY;
  Mortality30 -> mRS90 [label="mRS 6"];

  /* 20. Accumulator consequences */
  AUC_SBP140 -> Expansion [penwidth=2, color="#c05050"];
  AUC_SBP140 -> BleedRate [style=dashed];
  T_CPP60 -> NEURON [arrowhead=tee, penwidth=2, color="#c05050"];
  T_CPP60 -> AKI [style=dashed];
  T_ICP20 -> Mortality30 [penwidth=2, color="#c05050"];
  AUC_FeII -> mRS90 [penwidth=2, color="#c05050"];
  AUC_IL6 -> OED_LATE [penwidth=2];
  AUC_IL6 -> mRS90 [color="#c05050"];
  dV24 -> NIHSS [penwidth=2];

  /* Cross-cluster: the U-shape of blood pressure, stated explicitly */
  MAP -> CBF_peri [label="U-shape: same MAP\nlowers bleeding but\nlowers perfusion",
                   color="#8000a0", penwidth=3, fontcolor="#8000a0"];
}
