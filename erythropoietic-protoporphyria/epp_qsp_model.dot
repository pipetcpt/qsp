digraph EPP_QSP {
  rankdir=LR;
  newrank=true;          /* global ranking: the photobiology cluster must rank against both erythron and skin */
  compound=true;
  fontname="Helvetica";
  labelloc="t";
  label="Erythropoietic Protoporphyria (EPP) / X-Linked Protoporphyria (XLP) — Mechanistic QSP Map\nFECH loss-of-function (EPP) or ALAS2 gain-of-function (XLP) → protoporphyrin IX OVERFLOW → 400-410 nm photoexcitation → ¹O₂ → burning pain\nTHE CENTRAL TENSION: PPIX is simultaneously the PRODUCT of the pathway and the SUBSTRATE of the broken enzyme,\nso every intervention acts on a RATIO (supply ÷ disposal) and the SIGN of its effect is a property of WHICH ARM IS RATE-LIMITING, NOT OF THE DRUG.\nThree sign flips fall out and are computed, not assumed:  (1) Zn-protoporphyrin rises in XLP but not in EPP  ·  (2) iron helps XLP and harms EPP  ·  (3) shielding × source-reduction is MULTIPLICATIVE, not additive.\nTherapy axes: MC1R agonists raise the OPTICAL DENOMINATOR (afamelanotide implant, dersimelagon PO) · GlyT1 inhibition lowers the SUBSTRATE NUMERATOR (bitopertin) · hepatobiliary rescue interrupts a SADDLE-NODE runaway";
  node [style=filled, fontname="Helvetica", fontsize=10, shape=box, fillcolor="#ffffff"];
  edge [fontname="Helvetica", fontsize=8];

  /* =======================================================================
     1. GENETIC LESION — two different genes, one shared overflow phenotype
     EPP is almost never a simple homozygous null. The commonest genotype is
     one severe FECH allele TRANS to the hypomorphic IVS3-48T>C low-expression
     allele carried by ~10% of Europeans. Disease requires residual activity
     to fall BELOW a threshold (~35% of normal), which is why the same null
     allele is silent in a parent and causal in a child.
     ======================================================================= */
  subgraph cluster_genetics {
    label="1. Genetic lesion — a THRESHOLD disease, not a dosage disease (penetrance needs the low-expression allele in trans)";
    style=filled; color="#d8c9e8"; fillcolor="#f2ecf9";
    FECH_gene [label="★ FECH (18q21.31)\nferrochelatase, 2Fe-2S mitochondrial enzyme\n>190 LoF variants (missense/nonsense/splice)", fillcolor="#e3cdea", penwidth=2];
    FECH_null [label="Severe FECH allele\n(null / near-null, inherited from one parent)"];
    IVS3_48 [label="★ FECH c.315-48T>C (IVS3-48T>C)\nHYPOMORPHIC low-expression allele\n~10% Europeans, ~45% E/SE Asians\naberrant 3' splice site → NMD", fillcolor="#e3cdea", penwidth=2];
    FECH_trans [label="Compound heterozygosity IN TRANS\n(null | IVS3-48T>C)\n≈95% of clinical EPP"];
    FECH_biallelic [label="Rare biallelic severe FECH\n→ very low activity + hepatopathy risk ↑↑"];
    FECH_threshold [label="★ ACTIVITY THRESHOLD ≈ 35% of normal\nabove: silent carrier   below: overflow\n(explains autosomal-RECESSIVE-like pedigrees\nfrom two DOMINANT-looking alleles)", fillcolor="#e3cdea", penwidth=2];
    ALAS2_gene [label="ALAS2 (Xp11.21)\nerythroid δ-aminolevulinate synthase\nRATE-LIMITING step of erythroid heme"];
    ALAS2_GOF [label="★ ALAS2 GAIN-of-function (XLP)\nC-terminal truncations\n(c.1706-1709delAGTG etc.)\nloss of C-terminal autoinhibition → activity ↑↑", fillcolor="#e3cdea", penwidth=2];
    XLP_male [label="XLP: X-linked, males hemizygous\nfemales variable (X-inactivation skewing)"];
    CLPX_gene [label="CLPX (mitochondrial AAA+ unfoldase)\nrare variant → ALAS activation → PPIX ↑"];
    MMAB_mod [label="Modifier loci (MMAB, GWAS)\nmodulate PPIX level at fixed genotype"];
    Genotype_load [label="★ NET PORPHYRIN SUPPLY : DISPOSAL RATIO\nthe single number the whole model turns on", fillcolor="#e3cdea", penwidth=2];
  }

  /* =======================================================================
     2. ERYTHROID HEME BIOSYNTHESIS — eight enzymes, one bottleneck
     ~80% of body heme synthesis occurs in the erythron; the terminal step is
     the one that fails. Upstream flux is NOT reduced, so the pathway keeps
     delivering substrate to a closed door.
     ======================================================================= */
  subgraph cluster_heme {
    label="2. Erythroid heme biosynthesis — upstream flux is INTACT and keeps pushing against a closed terminal step";
    style=filled; color="#c9d8e8"; fillcolor="#eef4fa";
    Glycine [label="Glycine (mitochondrial matrix)\nsupplied by GlyT1/SLC6A9 import\n★ BITOPERTIN TARGET", fillcolor="#d7e6f5"];
    SuccCoA [label="Succinyl-CoA\n(TCA cycle, α-ketoglutarate DH)"];
    ALAS2_enz [label="ALAS2 enzyme (mitochondrion)\nPLP-dependent\nRATE-LIMITING in erythron"];
    ALA [label="5-Aminolevulinic acid (ALA)"];
    ALAD [label="ALAD (porphobilinogen synthase)\nZn-dependent, cytosol\n(lead-sensitive)"];
    PBG [label="Porphobilinogen (PBG)"];
    HMBS [label="HMBS / PBG deaminase\n(erythroid isoform)"];
    HMB [label="Hydroxymethylbilane"];
    UROS [label="UROS (uroporphyrinogen III synthase)\n(loss → CEP / Günther disease)"];
    UPGIII [label="Uroporphyrinogen III"];
    UROD [label="UROD (decarboxylase)\n(loss → PCT)"];
    CPGIII [label="Coproporphyrinogen III"];
    CPOX [label="CPOX (oxidase, IMS)\n(loss → hereditary coproporphyria)"];
    PPGIX [label="Protoporphyrinogen IX"];
    PPOX [label="PPOX (oxidase, inner membrane)\n(loss → variegate porphyria)"];
    PPIX_pool [label="★ PROTOPORPHYRIN IX (PPIX)\nthe photosensitiser — and the substrate\nof the enzyme that is broken", fillcolor="#f7d5d5", penwidth=2];
    FECH_enz [label="★ FERROCHELATASE (FECH)\nPPIX + Fe²⁺ → heme\nALSO inserts Zn²⁺ when Fe is scarce", fillcolor="#f7d5d5", penwidth=2];
    Heme_e [label="Heme b (erythroid)"];
    ZnPP [label="★ Zinc protoporphyrin (Zn-PP)\nmade BY FECH — therefore a REPORTER\nof residual FECH activity, not of overload", fillcolor="#f7d5d5", penwidth=2];
    Globin [label="α/β-globin chains\n(HRI/eIF2α coupled to heme supply)"];
    Hb [label="Haemoglobin A\n→ reticulocyte → erythrocyte"];
    HRI_eIF2a [label="HRI kinase / eIF2α\nheme-deficiency sensor\nuncouples globin from porphyrin"];
    Heme_fb [label="Heme negative feedback on ALAS2\n(weak in erythron vs hepatic ALAS1)"];
    Mitoferrin [label="Mitoferrin-1 (SLC25A37)\nmitochondrial Fe²⁺ import"];
    ABCB10_TMEM14C [label="ABCB10 · TMEM14C\nPPIX / intermediate transport"];
    FLVCR1b [label="FLVCR1b (heme export)\nFLVCR1a plasma-membrane heme efflux"];
  }

  /* =======================================================================
     3. IRON HOMEOSTASIS — the reason iron has NO fixed sign in this disease
     Iron enters the model at THREE points with different signs:
       (+ supply) IRE/IRP de-repression of ALAS2 translation raises the numerator
       (+ disposal) Fe²⁺ is the FECH co-substrate → raises the denominator
       (+ disposal) 2Fe-2S cluster availability sets FECH Vmax
     Net sign therefore depends on WHICH arm is limiting → flips between EPP and XLP.
     ======================================================================= */
  subgraph cluster_iron {
    label="3. Iron — enters at THREE points with OPPOSITE signs; the net effect is computed, never assumed";
    style=filled; color="#e8d8c9"; fillcolor="#faf3ee";
    Dietary_Fe [label="Dietary / supplemental iron\n(oral ferrous sulfate, IV ferric carboxymaltose)"];
    DMT1_Fpn [label="DMT1 / ferroportin\nenterocyte absorption & efflux"];
    Hepcidin [label="Hepcidin (HAMP)\nerythroferrone-suppressed"];
    ERFE [label="Erythroferrone (ERFE)\nfrom erythroblasts"];
    Tf_sat [label="Transferrin saturation (TSAT)\nlow in ~20-45% of EPP"];
    TfR1 [label="TfR1 / transferrin cycle\nerythroblast iron uptake"];
    LIP [label="Labile iron pool (erythroblast)"];
    Ferritin [label="Ferritin (storage)\noften LOW in EPP"];
    IRE_IRP [label="★ IRE / IRP1-IRP2 switch\nALAS2 mRNA 5'UTR IRE\nLOW iron → IRP binds → ALAS2 translation ↓\nHIGH iron → de-repression → ALAS2 ↑", fillcolor="#f0dcc4", penwidth=2];
    ISCU_cluster [label="ISCU / NFS1 → 2Fe-2S cluster\nrequired for FECH stability & Vmax"];
    Fe_paradox [label="★ THE IRON PARADOX\nEPP: FECH broken → extra Fe mostly feeds ALAS2 → PPIX ↑ (HARM)\nXLP: FECH intact but starved → extra Fe feeds disposal → PPIX ↓ (BENEFIT)", fillcolor="#f0dcc4", penwidth=2];
    Anemia_micro [label="Mild microcytic anaemia\n(~20-40%), rarely transfusion-dependent"];
  }

  /* =======================================================================
     4. PPIX DISTRIBUTION — a hydrophobic molecule with exactly ONE exit
     PPIX is not water-soluble and is NOT renally cleared. Its only route out
     of the body is bile. That single-exit topology is what makes the liver
     the site of the catastrophic complication.
     ======================================================================= */
  subgraph cluster_distribution {
    label="4. PPIX distribution — hydrophobic, ZERO renal clearance, exactly ONE exit (bile): a single-exit topology";
    style=filled; color="#c9e8e4"; fillcolor="#eef9f7";
    PPIX_erythroblast [label="PPIX in erythroblast / reticulocyte\n(site of synthesis)"];
    PPIX_rbc [label="★ Erythrocyte PPIX (metal-free)\nTHE measured biomarker\nnormal <1.5 · EPP 10-40 µmol/L", fillcolor="#c9e8e4", penwidth=2];
    RBC_lifespan [label="Erythrocyte lifespan ~120 d\n(PPIX efflux is FASTER than this:\nyoung reticulocytes leak PPIX)"];
    PPIX_plasma [label="Plasma PPIX\nalbumin-bound, freely exchangeable"];
    Albumin [label="Albumin binding\n(free fraction sets tissue delivery)"];
    PPIX_skin [label="★ Dermal capillary / perivascular PPIX\nTHE PHOTOACTIVE POOL\n(superficial vascular plexus, 0.2-0.5 mm)", fillcolor="#c9e8e4", penwidth=2];
    PPIX_liver [label="Hepatocyte PPIX\n(OATP/passive uptake from plasma)"];
    PPIX_bile [label="Canalicular / biliary PPIX\n(MRP2 / BCRP-assisted)"];
    PPIX_gut [label="Intestinal luminal PPIX"];
    Enterohepatic [label="★ ENTEROHEPATIC RECIRCULATION\n(the loop cholestyramine breaks)", fillcolor="#c9e8e4"];
    Faecal_PPIX [label="Faecal PPIX excretion\nTHE ONLY ELIMINATION ROUTE"];
    No_renal [label="✗ NO renal clearance\n(urinary porphyrins NORMAL —\nthe diagnostic discriminator vs AIP/PCT)"];
  }

  /* =======================================================================
     5. PHOTOPHYSICS — the part of this disease that is pure spectroscopy
     PPIX is a textbook type-II photosensitiser. Everything clinical follows
     from an absorption spectrum and a triplet yield.
     ======================================================================= */
  subgraph cluster_photophysics {
    label="5. Photophysics — a Soret band at 400-410 nm is why window glass, clouds and sunscreen all fail";
    style=filled; color="#e8e2c9"; fillcolor="#faf8ee";
    Solar_irr [label="Solar spectral irradiance\n(zenith angle · season · latitude · altitude)"];
    Visible_violet [label="★ 400-410 nm VIOLET / VISIBLE light\nNOT ultraviolet", fillcolor="#e6dcb0", penwidth=2];
    Soret [label="★ PPIX SORET BAND ε ≈ 1.7×10⁵ M⁻¹cm⁻¹\nat 400-410 nm; weak Q-bands 500-630 nm\naction spectrum matches EXACTLY", fillcolor="#e6dcb0", penwidth=2];
    Window_glass [label="★ Window glass TRANSMITS 400-410 nm\n(blocks UVB only)\n→ reactions indoors, in cars, under cloud", fillcolor="#e6dcb0"];
    Cloud_pass [label="Cloud / shade attenuate only ~50%\nof visible → 'overcast day' reactions"];
    Sunscreen_fail [label="✗ Chemical UV filters (SPF) INEFFECTIVE\n(they absorb UVB/UVA, not violet)"];
    Opaque_screen [label="✓ Reflectant / opaque screens\n(iron oxide tint, TiO₂, ZnO)\nclothing, films on glass"];
    PPIX_S1 [label="PPIX excited singlet ¹PPIX*"];
    ISC [label="Intersystem crossing (Φ_ISC ≈ 0.6)"];
    PPIX_T1 [label="PPIX triplet ³PPIX* (long-lived)"];
    O2_ground [label="Ground-state ³O₂ (tissue pO₂)"];
    Singlet_O2 [label="★ SINGLET OXYGEN ¹O₂ (type II)\nΦ_Δ ≈ 0.5-0.6, τ ≈ 3 µs in cells\ndiffusion radius ~100-200 nm", fillcolor="#e6dcb0", penwidth=2];
    Type_I [label="Type I radicals (O₂•⁻, •OH)\nminor contributor at physiologic pO₂"];
    Photobleach [label="PPIX photobleaching\n(self-consumption during exposure)"];
    Beta_carotene_q [label="β-carotene / cysteine\n¹O₂ physical quenchers\n(weak: quenching competes with a 3 µs lifetime)"];
    Melanin_abs [label="★ EPIDERMAL EUMELANIN\nbroadband absorber, strong at 400-410 nm\nTHE ONLY MODIFIABLE OPTICAL DENOMINATOR", fillcolor="#e6dcb0", penwidth=2];
    Optical_depth [label="Effective epidermal transmittance T\nT = exp(−OD_melanin) · geometry"];
    Photodyn_dose [label="★ PHOTODYNAMIC DOSE\nD = ∫ E(λ,t)·T·[PPIX]_skin·Φ_Δ dt\nA PRODUCT — which is why interventions MULTIPLY", fillcolor="#e6dcb0", penwidth=2];
  }

  /* =======================================================================
     6. CUTANEOUS INJURY CASCADE — why the pain outlives the sunlight by days
     ¹O₂ has a 3 µs lifetime; the pain lasts 3 days. The persistence lives in
     downstream state variables with slow time constants, NOT in the photon.
     ======================================================================= */
  subgraph cluster_injury {
    label="6. Cutaneous injury cascade — ¹O₂ lasts 3 µs, the pain lasts 3 days: persistence lives in SLOW state variables, not in the photon";
    style=filled; color="#e8c9c9"; fillcolor="#faeeee";
    Lipid_perox [label="Membrane lipid peroxidation\n→ 4-HNE, malondialdehyde"];
    Endothelial_dmg [label="★ Dermal capillary ENDOTHELIAL injury\n(the primary lesion — vascular, not epidermal)", fillcolor="#f0c9c9", penwidth=2];
    Basement_memb [label="Perivascular hyaline deposition\n(PAS+ cuffing; chronic, cumulative)"];
    Mast_cell [label="Mast cell degranulation\n→ histamine, tryptase, TNF-α"];
    Complement [label="★ Complement activation C3a / C5a\n(measurable in plasma after irradiation)", fillcolor="#f0c9c9"];
    Neutrophil [label="Neutrophil chemotaxis & influx\n(C5a, LTB₄, IL-8)"];
    Eicosanoid [label="Eicosanoids: PGE₂, PGD₂, LTB₄\n(COX/LOX)"];
    ROS_amplify [label="Secondary ROS / NADPH oxidase\nself-amplifying loop"];
    Vascular_leak [label="Vascular permeability ↑\n→ oedema, erythema"];
    TRPA1 [label="★ TRPA1 on C-fibres\nDIRECTLY gated by 4-HNE / oxidants\n(a chemical, not a thermal, nociceptor)", fillcolor="#f0c9c9", penwidth=2];
    TRPV1 [label="TRPV1 sensitisation\n(PGE₂/EP-receptor → PKA/PKC)"];
    Nav17_18 [label="Naᵥ1.7 / Naᵥ1.8 excitability ↑"];
    SubP_CGRP [label="Substance P · CGRP release\n→ NEUROGENIC inflammation (positive feedback)"];
    Central_sens [label="Dorsal-horn central sensitisation\n(wind-up; explains days-long pain)"];
    Opioid_refract [label="★ OPIOID-REFRACTORY pain\n(a peripheral chemical-nociceptor drive\nthat µ-agonists poorly reach)", fillcolor="#f0c9c9"];
  }

  /* =======================================================================
     7. CLINICAL PHENOTYPE & ENDPOINTS
     ======================================================================= */
  subgraph cluster_clinical {
    label="7. Clinical phenotype & trial endpoints — every one of these is a THRESHOLD-CROSSING TIME, not a level";
    style=filled; color="#c9e8c9"; fillcolor="#eef9ee";
    Prodrome [label="★ PRODROME: tingling / itching / burning\nafter MINUTES of exposure\nTHE PATIENT'S ONLY WARNING SIGNAL", fillcolor="#cfe8cf", penwidth=2];
    Tolerance_time [label="★ SUNLIGHT TOLERANCE TIME (min)\nTIME TO FIRST PRODROME\n≈ D_crit / (E · T · PPIX_skin)", fillcolor="#cfe8cf", penwidth=2];
    Phototox_rxn [label="Full phototoxic reaction\nburning pain, oedema, erythema\npeaks 12-24 h, lasts 1-7 d"];
    Pain_NRS [label="Pain NRS 0-10\n(often 8-10; described as 'boiling oil')"];
    Reaction_count [label="Annual phototoxic reaction count"];
    Sun_hours [label="★ HOURS IN DIRECT SUNLIGHT\nwithout pain, 10:00-18:00\nTHE REGISTRATIONAL ENDPOINT (censored at daylight!)", fillcolor="#cfe8cf", penwidth=2];
    Chronic_skin [label="Chronic signs: knuckle lichenification,\nwaxy scars on nose/cheeks, nail changes,\nshallow linear scars — NOT blisters"];
    No_blister [label="✗ NO true bullae / no skin fragility\n(distinguishes EPP from PCT / VP)"];
    QoL [label="EPP-QoL · DLQI\nlifelong sun avoidance → school/work loss,\nvitamin D deficiency, anxiety/depression"];
    VitD_def [label="Vitamin D deficiency (>60%)\n→ osteoporosis risk"];
    Onset_infancy [label="Onset in infancy/early childhood\n(crying in the pram — pre-verbal presentation;\nmedian diagnostic delay >10 y)"];
  }

  /* =======================================================================
     8. HEPATOBILIARY COMPLICATION — a saddle-node, not a slow accumulation
     PPIX excreted in bile is itself cholestatic. Cholestasis reduces the
     only elimination route. That is a POSITIVE FEEDBACK on a single-exit
     system: below a critical erythron flux the liver is stable; above it,
     there is no steady state at all and the system runs away in weeks.
     ======================================================================= */
  subgraph cluster_liver {
    label="8. Protoporphyric hepatopathy — a SADDLE-NODE BIFURCATION on the only exit route (2-5% lifetime, but ~1/5 of those die)";
    style=filled; color="#d8d8c0"; fillcolor="#f7f7ee";
    Hep_uptake [label="Hepatocyte PPIX uptake from plasma\n(concentration-driven, unsaturable)"];
    Canalic_transport [label="Canalicular secretion (MRP2/ABCC2, BCRP)\nSATURABLE — the choke point"];
    PPIX_crystal [label="★ PPIX crystal / birefringent Maltese-cross\ndeposition in canaliculi & Kupffer cells", fillcolor="#e4e4c0", penwidth=2];
    Cholestasis [label="★ CHOLESTASIS: bile flow ↓", fillcolor="#e4e4c0", penwidth=2];
    Vicious_loop [label="★★ VICIOUS CYCLE\ncholestasis ↓ the ONLY exit → plasma & hepatic PPIX ↑\n→ more crystals → more cholestasis\nPOSITIVE FEEDBACK ON A SINGLE-EXIT SYSTEM", fillcolor="#e4e4c0", penwidth=3];
    Hepatocyte_inj [label="Hepatocyte injury: ALT/AST ↑, bilirubin ↑"];
    Stellate [label="Stellate-cell activation → periportal fibrosis"];
    Cirrhosis [label="Cirrhosis / acute liver failure\n(can be the presenting event)"];
    Motor_neuropathy [label="Acute motor neuropathy\n(a peri-transplant EPP-specific catastrophe)"];
    Gallstones [label="Protoporphyrin gallstones\ncholecystectomy in ~20%"];
    Photo_surgical [label="★ INTRAOPERATIVE PHOTOTOXICITY\ntheatre lights → bowel/peritoneal burns,\nendotracheal-tube-site necrosis\n(needs amber filters — a real perioperative rule)", fillcolor="#e4e4c0"];
    Liver_tx [label="Liver transplantation\n(does NOT correct the erythroid source →\nDISEASE RECURS IN THE GRAFT)"];
    BMT_curative [label="★ Bone-marrow transplant IS curative\n(the defect is erythroid, not hepatic)", fillcolor="#e4e4c0"];
  }

  /* =======================================================================
     9. MC1R / MELANOGENESIS — the pharmacological denominator
     ======================================================================= */
  subgraph cluster_mc1r {
    label="9. MC1R → eumelanin — the ONLY drug axis that changes the optical denominator (and it never touches PPIX)";
    style=filled; color="#d8c0d8"; fillcolor="#f7eef7";
    POMC [label="POMC → α-MSH (endogenous)"];
    MC1R [label="★ MC1R (Gs-coupled, melanocyte)\nred-hair variants = loss-of-function\n→ predicted non-responders", fillcolor="#e8cfe8", penwidth=2];
    cAMP_mel [label="Adenylyl cyclase → cAMP → PKA"];
    CREB_MITF [label="CREB → MITF transcription"];
    TYR_enz [label="Tyrosinase · TYRP1 · DCT"];
    Eumelanin [label="★ EUMELANIN synthesis in melanosomes\n(eumelanin, NOT pheomelanin — the black/brown\npolymer is the one that absorbs violet)", fillcolor="#e8cfe8", penwidth=2];
    Melanosome_tx [label="Melanosome transfer to keratinocytes\n+ supranuclear capping"];
    Epidermal_OD [label="★ Epidermal optical density at 405 nm\nturnover ~4-8 weeks → PD LONG-OUTLASTS PK", fillcolor="#e8cfe8", penwidth=2];
    MED_up [label="Minimal erythema/phototoxic dose ↑\nmelanin index ↑ (objective read-out)"];
    Nevus_watch [label="Safety: naevus darkening, new naevi\n→ mandatory skin surveillance"];
  }

  /* =======================================================================
     10. DRUG PK — four independent absorption/disposition topologies
     ======================================================================= */
  subgraph cluster_pk {
    label="10. Drug pharmacokinetics — an implant, two oral small molecules, an IV, and two non-absorbed gut agents";
    style=filled; color="#c0d0e8"; fillcolor="#eef2fa";
    Afa_implant [label="★ AFAMELANOTIDE 16 mg s.c. IMPLANT\n[Nle⁴-D-Phe⁷]-α-MSH, q60 days\nbioresorbable poly(D,L-lactide-co-glycolide) rod", fillcolor="#cfdcf0", penwidth=2];
    Afa_release [label="Depot release over ~2-5 d\n(plasma undetectable after ~5 d —\nyet the effect lasts 60 d: EXTREME HYSTERESIS)"];
    Afa_plasma [label="Afamelanotide plasma conc.\nt½ ~30 min, peptidase cleared"];
    Der_dose [label="★ DERSIMELAGON (MT-7117) 100/300 mg PO od\nnon-peptide selective MC1R agonist", fillcolor="#cfdcf0", penwidth=2];
    Der_abs [label="Oral absorption ka; CYP3A4 metabolism\nt½ ~ 1 day → daily dosing, steady state ~1 wk"];
    Der_plasma [label="Dersimelagon plasma conc."];
    Bit_dose [label="★ BITOPERTIN 20-60 mg PO od\nGlyT1 (SLC6A9) inhibitor — repurposed\nfrom schizophrenia trials", fillcolor="#cfdcf0", penwidth=2];
    Bit_plasma [label="Bitopertin plasma conc.\nlong t½, once-daily"];
    Bcar_dose [label="β-Carotene 120-180 mg PO od\n(erratic absorption; carotenodermia\nis the visible marker of exposure)"];
    Chole_dose [label="Cholestyramine 4-16 g PO\nNON-absorbed anion-exchange resin\n→ acts only in the gut lumen"];
    Hemin_dose [label="Hemin (heme arginate) 3 mg/kg IV\n→ ALAS feedback suppression\n(hepatic ALAS1 ≫ erythroid ALAS2 — hence weak here)"];
    Cimetidine_dose [label="Cimetidine 400-800 mg PO\nweak ALAS inhibition (paediatric reports)"];
    Transfusion [label="RBC transfusion / exchange\nsuppresses endogenous erythropoiesis\n→ cuts the SOURCE"];
    Plasmapheresis [label="Plasmapheresis / albumin dialysis\nremoves albumin-bound plasma PPIX"];
  }

  /* =======================================================================
     11. DRUG PHARMACODYNAMICS — two orthogonal axes that MULTIPLY
     ======================================================================= */
  subgraph cluster_pd {
    label="11. Pharmacodynamics — TWO ORTHOGONAL AXES: shielding (denominator) × source-reduction (numerator). Their product is the dose.";
    style=filled; color="#c0e8d0"; fillcolor="#eefaf2";
    Afa_MC1R [label="Afamelanotide → MC1R agonism\n(potency ≫ α-MSH, protease-resistant)"];
    Der_MC1R [label="Dersimelagon → MC1R agonism (oral)"];
    Axis_shield [label="★ AXIS A — SHIELDING\nraises T⁻¹ (optical denominator)\nPPIX COMPLETELY UNCHANGED", fillcolor="#cfeeda", penwidth=2];
    Bit_GlyT1 [label="Bitopertin → GlyT1 blockade\n→ erythroblast glycine ↓\n→ ALAS2 substrate-limited"];
    Axis_source [label="★ AXIS B — SOURCE REDUCTION\nlowers [PPIX] (numerator)\nMELANIN COMPLETELY UNCHANGED", fillcolor="#cfeeda", penwidth=2];
    Multiplicative [label="★★ BECAUSE DOSE IS A PRODUCT,\nTOLERANCE TIME ∝ 1/(T · PPIX)\n→ COMBINING THE AXES IS MULTIPLICATIVE\n(supra-additive vs an additive expectation)", fillcolor="#cfeeda", penwidth=3];
    Bcar_quench [label="β-Carotene → ¹O₂ physical quenching\n(competes with a 3 µs lifetime\nat achievable skin concentrations → weak)"];
    Chole_EHC [label="Cholestyramine → binds luminal PPIX\n→ breaks enterohepatic recirculation\n→ raises net faecal loss"];
    Hemin_ALAS [label="Hemin → ALAS feedback ↓ (transient)"];
    Transf_supp [label="Transfusion → EPO ↓ → erythron output ↓\n→ cuts PPIX production at source"];
    Avoidance [label="★ BEHAVIOURAL AVOIDANCE\nthe most effective 'drug' ever used in EPP —\nand the one with the worst QoL cost", fillcolor="#cfeeda"];
    Ceiling [label="★ CENSORING CEILING\nonce tolerance time > a typical outdoor bout,\nfurther gain is INVISIBLE to the trial endpoint\n(why registrational effect sizes look modest)", fillcolor="#cfeeda", penwidth=2];
  }

  /* =======================================================================
     12. THE CONTROL LOOP — the patient is a feedback controller
     ======================================================================= */
  subgraph cluster_control {
    label="12. The patient as a feedback controller — prodrome is the SENSOR, retreat is the ACTUATOR, and human reaction time is the LOOP DELAY";
    style=filled; color="#e0d0b0"; fillcolor="#faf5ea";
    Sensor [label="SENSOR: prodromal tingle\n(fires at D = D_prodrome)"];
    Delay [label="★ LOOP DELAY: recognition + retreat\n(seconds in an adult, MINUTES in a child\nor when distracted / socially constrained)", fillcolor="#eee0c0", penwidth=2];
    Actuator [label="ACTUATOR: move into shade / cover"];
    Overshoot [label="★ OVERSHOOT DOSE accrued during the delay\ndecides prodrome-only vs a full 3-day reaction", fillcolor="#eee0c0", penwidth=2];
    Slow_accrual [label="★ A SHIELDING DRUG'S HIDDEN BENEFIT:\nby slowing dose accrual it makes the SAME\nhuman delay non-limiting → fewer FULL reactions\neven at equal total sun exposure", fillcolor="#eee0c0", penwidth=2];
    Kids_worse [label="Children: delay ↑, communication ↓\n→ disproportionate reaction burden"];
  }

  /* =======================================================================
     13. DIFFERENTIAL DIAGNOSIS & BIOCHEMICAL SIGNATURE
     ======================================================================= */
  subgraph cluster_ddx {
    label="13. Biochemical signature & differential — the Zn-PP FRACTION separates EPP from XLP from lead/iron deficiency";
    style=filled; color="#d0d0d0"; fillcolor="#f4f4f4";
    Total_EP [label="Total erythrocyte protoporphyrin ↑↑\n(the screening test)"];
    Metal_free_frac [label="★ METAL-FREE PPIX fraction\nEPP: >85% metal-free (FECH can't insert Zn either)\nXLP: substantial Zn-PP (FECH is INTACT)", fillcolor="#dcdcdc", penwidth=2];
    Plasma_fluor [label="Plasma fluorescence emission peak 634 nm\n(vs 626 nm in variegate porphyria)"];
    Urine_normal [label="Urinary porphyrins NORMAL\n(PPIX has no carboxyl handles → not renally cleared)"];
    Fe_def_ZnPP [label="Iron deficiency / lead poisoning:\nZn-PP ↑ but metal-free PPIX NORMAL\n(FECH intact, substrate normal, metal wrong)"];
    PCT_VP [label="PCT / VP: blistering + skin fragility\n+ abnormal URINE porphyrins"];
    CEP [label="CEP (Günther): severe mutilating,\nuroporphyrin I, red urine, red teeth"];
    Solar_urticaria [label="Solar urticaria / polymorphic light eruption\n(no porphyrin abnormality)"];
  }

  /* =======================================================================
     14. QSP READOUTS
     ======================================================================= */
  subgraph cluster_readout {
    label="14. QSP model read-outs — the numbers the mrgsolve model emits";
    style=filled; color="#b8c8d8"; fillcolor="#e8eef4";
    RO_ppix [label="RBC metal-free PPIX (µmol/L)"];
    RO_znfrac [label="Zn-PP fraction (%) — the EPP/XLP discriminator"];
    RO_mel [label="Melanin optical density / melanin index"];
    RO_ttol [label="★ Tolerance time to prodrome (min)", fillcolor="#c8d8e8", penwidth=2];
    RO_sun [label="★ Pain-free sun hours per day (censored)", fillcolor="#c8d8e8", penwidth=2];
    RO_rxn [label="Phototoxic reactions per 6 months"];
    RO_pain [label="Pain NRS trajectory (days)"];
    RO_liver [label="Hepatic PPIX · ALT · bilirubin · runaway flag"];
    RO_crit [label="★ CRITICAL ERYTHRON FLUX for hepatic runaway\n(the saddle-node location)", fillcolor="#c8d8e8", penwidth=2];
    RO_bliss [label="★ Combination index vs Bliss/additive expectation", fillcolor="#c8d8e8", penwidth=2];
    RO_qol [label="EPP-QoL projection"];
  }

  /* ===================== EDGES: genetics → enzyme ===================== */
  FECH_gene -> FECH_null;
  FECH_gene -> IVS3_48;
  FECH_null -> FECH_trans;
  IVS3_48 -> FECH_trans;
  FECH_trans -> FECH_threshold [label="residual ~10-35%"];
  FECH_gene -> FECH_biallelic;
  FECH_biallelic -> FECH_threshold [label="<10%", color="#b03030"];
  FECH_threshold -> FECH_enz [label="sets Vmax", color="#b03030", penwidth=2];
  ALAS2_gene -> ALAS2_enz;
  ALAS2_gene -> ALAS2_GOF;
  ALAS2_GOF -> XLP_male;
  ALAS2_GOF -> ALAS2_enz [label="Vmax ↑↑ (loss of C-term autoinhibition)", color="#b03030", penwidth=2];
  CLPX_gene -> ALAS2_enz [label="activates"];
  MMAB_mod -> Genotype_load [style=dashed];
  FECH_threshold -> Genotype_load;
  ALAS2_GOF -> Genotype_load;

  /* ===================== EDGES: heme pathway ===================== */
  Glycine -> ALAS2_enz [label="substrate", color="#2060a0"];
  SuccCoA -> ALAS2_enz [label="substrate", color="#2060a0"];
  ALAS2_enz -> ALA;
  ALA -> ALAD -> PBG -> HMBS -> HMB -> UROS -> UPGIII -> UROD -> CPGIII -> CPOX -> PPGIX -> PPOX -> PPIX_pool;
  PPIX_pool -> FECH_enz [label="substrate", color="#2060a0"];
  LIP -> FECH_enz [label="Fe²⁺ co-substrate", color="#c07030"];
  FECH_enz -> Heme_e [label="+Fe²⁺", color="#207040", penwidth=2];
  FECH_enz -> ZnPP [label="+Zn²⁺ when Fe scarce\n(SAME enzyme!)", color="#207040", penwidth=2];
  Heme_e -> Globin;
  Globin -> Hb;
  Heme_e -> HRI_eIF2a [label="⊣ inhibits HRI", arrowhead=tee, color="#207040"];
  HRI_eIF2a -> Globin [label="⊣", arrowhead=tee];
  Heme_e -> Heme_fb [label="feedback"];
  Heme_fb -> ALAS2_enz [label="⊣ weak in erythron", arrowhead=tee, style=dashed];
  Mitoferrin -> LIP;
  ABCB10_TMEM14C -> PPIX_pool [style=dashed, label="transport"];
  FLVCR1b -> Heme_e [style=dashed];
  PPIX_pool -> PPIX_erythroblast;
  ZnPP -> RO_znfrac;

  /* ===================== EDGES: iron ===================== */
  Dietary_Fe -> DMT1_Fpn -> Tf_sat;
  Hepcidin -> DMT1_Fpn [label="⊣", arrowhead=tee];
  ERFE -> Hepcidin [label="⊣", arrowhead=tee];
  Hb -> ERFE [style=dashed];
  Tf_sat -> TfR1 -> LIP;
  LIP -> Ferritin;
  LIP -> IRE_IRP [label="sets IRP binding", color="#c07030", penwidth=2];
  IRE_IRP -> ALAS2_enz [label="HIGH Fe → de-repress → ALAS2 ↑\n(SUPPLY ARM, + sign)", color="#c07030", penwidth=2];
  LIP -> ISCU_cluster -> FECH_enz [label="2Fe-2S → Vmax\n(DISPOSAL ARM, − sign)", color="#c07030", penwidth=2];
  IRE_IRP -> Fe_paradox;
  ISCU_cluster -> Fe_paradox;
  FECH_threshold -> Fe_paradox [label="decides which arm wins", style=dashed, color="#b03030"];
  Fe_paradox -> PPIX_pool [label="NET SIGN COMPUTED, NOT ASSUMED", color="#c07030", penwidth=2, style=dashed];
  Tf_sat -> Anemia_micro [style=dashed];
  Ferritin -> Tf_sat [style=dashed];

  /* ===================== EDGES: distribution ===================== */
  PPIX_erythroblast -> PPIX_rbc;
  RBC_lifespan -> PPIX_rbc [style=dashed, label="dilution"];
  PPIX_rbc -> PPIX_plasma [label="efflux (reticulocyte leak)", color="#2080a0"];
  Albumin -> PPIX_plasma [style=dashed];
  PPIX_plasma -> PPIX_skin [color="#2080a0", penwidth=2];
  PPIX_skin -> PPIX_plasma [style=dashed];
  PPIX_plasma -> PPIX_liver [color="#2080a0"];
  Hep_uptake -> PPIX_liver;
  PPIX_plasma -> Hep_uptake;
  PPIX_liver -> PPIX_bile [label="MRP2/BCRP"];
  Canalic_transport -> PPIX_bile;
  PPIX_liver -> Canalic_transport;
  PPIX_bile -> PPIX_gut;
  PPIX_gut -> Enterohepatic -> PPIX_plasma [label="reabsorption", color="#2080a0", style=dashed];
  PPIX_gut -> Faecal_PPIX [label="ONLY EXIT", color="#207040", penwidth=2];
  PPIX_plasma -> No_renal [arrowhead=none, style=dotted];
  No_renal -> Urine_normal [style=dashed];
  PPIX_rbc -> Total_EP;
  PPIX_rbc -> RO_ppix;

  /* ===================== EDGES: photophysics ===================== */
  Solar_irr -> Visible_violet;
  Visible_violet -> Window_glass;
  Visible_violet -> Cloud_pass;
  Window_glass -> Soret [label="reaches skin indoors", color="#b08020"];
  Cloud_pass -> Soret;
  Sunscreen_fail -> Soret [label="✗ no attenuation", style=dotted];
  Opaque_screen -> Soret [label="⊣ blocks", arrowhead=tee, color="#207040"];
  Melanin_abs -> Optical_depth [color="#8040a0", penwidth=2];
  Optical_depth -> Soret [label="⊣ T = e^(−OD)", arrowhead=tee, color="#8040a0", penwidth=2];
  PPIX_skin -> Soret [label="absorber concentration", color="#b03030", penwidth=2];
  Soret -> PPIX_S1 -> ISC -> PPIX_T1;
  O2_ground -> Singlet_O2;
  PPIX_T1 -> Singlet_O2 [label="type II energy transfer", color="#b03030", penwidth=2];
  PPIX_T1 -> Type_I [style=dashed];
  PPIX_T1 -> Photobleach [style=dashed];
  Photobleach -> PPIX_skin [label="⊣ self-consumption", arrowhead=tee, style=dashed];
  Beta_carotene_q -> Singlet_O2 [label="⊣ physical quench (weak)", arrowhead=tee, style=dashed, color="#207040"];
  Singlet_O2 -> Photodyn_dose [penwidth=2, color="#b03030"];
  Solar_irr -> Photodyn_dose [style=dashed];

  /* ===================== EDGES: injury cascade ===================== */
  Singlet_O2 -> Lipid_perox [penwidth=2, color="#b03030"];
  Singlet_O2 -> Endothelial_dmg [penwidth=2, color="#b03030"];
  Lipid_perox -> Endothelial_dmg;
  Lipid_perox -> TRPA1 [label="4-HNE gates TRPA1 DIRECTLY", color="#b03030", penwidth=2];
  Endothelial_dmg -> Mast_cell;
  Endothelial_dmg -> Complement;
  Endothelial_dmg -> Vascular_leak;
  Endothelial_dmg -> Basement_memb [label="cumulative over years", style=dashed];
  Complement -> Neutrophil;
  Mast_cell -> Vascular_leak;
  Mast_cell -> Eicosanoid;
  Neutrophil -> ROS_amplify;
  ROS_amplify -> Lipid_perox [label="positive feedback", color="#b03030", style=dashed];
  Eicosanoid -> TRPV1;
  TRPV1 -> Nav17_18;
  TRPA1 -> Nav17_18;
  Nav17_18 -> SubP_CGRP;
  SubP_CGRP -> Vascular_leak [label="neurogenic feedback", style=dashed, color="#b03030"];
  SubP_CGRP -> Mast_cell [style=dashed];
  Nav17_18 -> Central_sens;
  Central_sens -> Pain_NRS [penwidth=2];
  Central_sens -> Opioid_refract;
  Vascular_leak -> Phototox_rxn;
  TRPA1 -> Prodrome [label="EARLIEST signal", color="#207040", penwidth=2];

  /* ===================== EDGES: clinical ===================== */
  Photodyn_dose -> Prodrome [label="D reaches D_prodrome", penwidth=2, color="#b03030"];
  Photodyn_dose -> Phototox_rxn [label="D exceeds D_crit"];
  Prodrome -> Tolerance_time [penwidth=2];
  Tolerance_time -> Sun_hours [penwidth=2];
  Phototox_rxn -> Pain_NRS;
  Phototox_rxn -> Reaction_count;
  Phototox_rxn -> Chronic_skin [style=dashed, label="years"];
  Basement_memb -> Chronic_skin;
  Chronic_skin -> No_blister [arrowhead=none, style=dotted];
  Sun_hours -> QoL [penwidth=2];
  Pain_NRS -> QoL;
  Avoidance -> VitD_def;
  VitD_def -> QoL;
  Onset_infancy -> QoL [style=dashed];
  Sun_hours -> RO_sun;
  Tolerance_time -> RO_ttol;
  Reaction_count -> RO_rxn;
  Pain_NRS -> RO_pain;
  QoL -> RO_qol;

  /* ===================== EDGES: liver runaway ===================== */
  PPIX_liver -> PPIX_crystal;
  Canalic_transport -> PPIX_crystal [label="saturates → spillover", color="#b03030"];
  PPIX_crystal -> Cholestasis [penwidth=2, color="#b03030"];
  Cholestasis -> Canalic_transport [label="⊣ bile flow ↓", arrowhead=tee, color="#b03030", penwidth=3];
  Cholestasis -> Vicious_loop [penwidth=2];
  PPIX_crystal -> Vicious_loop [penwidth=2];
  Vicious_loop -> PPIX_liver [label="RUNAWAY", color="#b03030", penwidth=3, style=bold];
  Vicious_loop -> PPIX_plasma [label="plasma PPIX ↑↑ → skin worsens too", color="#b03030", penwidth=2];
  PPIX_crystal -> Hepatocyte_inj;
  Hepatocyte_inj -> Stellate -> Cirrhosis;
  Cholestasis -> Gallstones;
  Cirrhosis -> Liver_tx;
  Liver_tx -> Motor_neuropathy [style=dashed];
  Liver_tx -> Vicious_loop [label="✗ graft re-accumulates:\nthe SOURCE is the marrow", style=dashed, color="#b03030"];
  BMT_curative -> PPIX_erythroblast [label="⊣ replaces the source", arrowhead=tee, color="#207040", penwidth=2];
  PPIX_liver -> Photo_surgical [style=dashed];
  Vicious_loop -> RO_crit [penwidth=2];
  Hepatocyte_inj -> RO_liver;

  /* ===================== EDGES: MC1R axis ===================== */
  POMC -> MC1R;
  Afa_MC1R -> MC1R [penwidth=2, color="#8040a0"];
  Der_MC1R -> MC1R [penwidth=2, color="#8040a0"];
  MC1R -> cAMP_mel -> CREB_MITF -> TYR_enz -> Eumelanin;
  Eumelanin -> Melanosome_tx -> Epidermal_OD;
  Epidermal_OD -> Melanin_abs [penwidth=2, color="#8040a0"];
  Epidermal_OD -> MED_up;
  Epidermal_OD -> RO_mel;
  Eumelanin -> Nevus_watch [style=dashed];

  /* ===================== EDGES: PK ===================== */
  Afa_implant -> Afa_release -> Afa_plasma -> Afa_MC1R;
  Afa_release -> Epidermal_OD [label="PK 5 d vs PD 60 d\n= HYSTERESIS", style=dashed, color="#8040a0"];
  Der_dose -> Der_abs -> Der_plasma -> Der_MC1R;
  Bit_dose -> Bit_plasma -> Bit_GlyT1;
  Bit_GlyT1 -> Glycine [label="⊣ erythroblast glycine ↓", arrowhead=tee, color="#2060a0", penwidth=2];
  Bcar_dose -> Beta_carotene_q;
  Chole_dose -> Chole_EHC;
  Chole_EHC -> Enterohepatic [label="⊣", arrowhead=tee, color="#207040", penwidth=2];
  Chole_EHC -> Faecal_PPIX [color="#207040"];
  Hemin_dose -> Hemin_ALAS -> ALAS2_enz [label="⊣ (weak: ALAS1 ≫ ALAS2)", arrowhead=tee, style=dashed];
  Cimetidine_dose -> ALAS2_enz [label="⊣ weak", arrowhead=tee, style=dashed];
  Transfusion -> Transf_supp -> PPIX_erythroblast [label="⊣ source", arrowhead=tee, color="#207040", penwidth=2];
  Plasmapheresis -> PPIX_plasma [label="⊣ direct removal", arrowhead=tee, color="#207040"];

  /* ===================== EDGES: the two axes and their product ===================== */
  MC1R -> Axis_shield [penwidth=2, color="#207040"];
  Axis_shield -> Epidermal_OD [penwidth=2, color="#207040"];
  Axis_shield -> PPIX_rbc [label="✗ NO effect on PPIX\n(a falsifiable prediction)", style=dotted, color="#808080"];
  Bit_GlyT1 -> Axis_source [penwidth=2, color="#207040"];
  Axis_source -> PPIX_pool [label="⊣", arrowhead=tee, penwidth=2, color="#207040"];
  Axis_source -> Epidermal_OD [label="✗ NO effect on melanin", style=dotted, color="#808080"];
  Axis_shield -> Multiplicative [penwidth=2];
  Axis_source -> Multiplicative [penwidth=2];
  Photodyn_dose -> Multiplicative [label="D = T × PPIX × E × t\n(a PRODUCT)", style=dashed, penwidth=2];
  Multiplicative -> Tolerance_time [penwidth=3, color="#b03030"];
  Multiplicative -> RO_bliss [penwidth=2];
  Tolerance_time -> Ceiling;
  Ceiling -> Sun_hours [label="⊣ censors the endpoint", arrowhead=tee, penwidth=2, color="#b08020"];
  Beta_carotene_q -> Axis_shield [style=dotted, label="nominally axis A, quantitatively negligible"];
  Avoidance -> Sun_hours [label="⊣", arrowhead=tee];

  /* ===================== EDGES: control loop ===================== */
  Prodrome -> Sensor [penwidth=2];
  Sensor -> Delay -> Actuator;
  Actuator -> Photodyn_dose [label="⊣ exposure stops", arrowhead=tee, color="#207040", penwidth=2];
  Delay -> Overshoot [penwidth=2];
  Overshoot -> Phototox_rxn [label="decides prodrome-only vs full reaction", penwidth=2, color="#b03030"];
  Axis_shield -> Slow_accrual [penwidth=2, color="#207040"];
  Slow_accrual -> Overshoot [label="⊣ same delay, less dose accrued", arrowhead=tee, penwidth=2, color="#207040"];
  Delay -> Kids_worse;
  Kids_worse -> Reaction_count;

  /* ===================== EDGES: diagnostics ===================== */
  Total_EP -> Metal_free_frac;
  ZnPP -> Metal_free_frac [penwidth=2];
  FECH_threshold -> Metal_free_frac [label="EPP: no Zn insertion either", color="#b03030", style=dashed];
  ALAS2_GOF -> Metal_free_frac [label="XLP: FECH intact → Zn-PP RISES", color="#b03030", style=dashed];
  Metal_free_frac -> Fe_def_ZnPP [arrowhead=none, style=dotted, label="contrast"];
  PPIX_plasma -> Plasma_fluor;
  Plasma_fluor -> PCT_VP [arrowhead=none, style=dotted, label="626 vs 634 nm"];
  Urine_normal -> PCT_VP [arrowhead=none, style=dotted];
  Total_EP -> CEP [arrowhead=none, style=dotted];
  Prodrome -> Solar_urticaria [arrowhead=none, style=dotted, label="minutes-latency mimic"];
  Metal_free_frac -> RO_znfrac [penwidth=2];

  /* ===================== cross-cluster spine ===================== */
  Genotype_load -> PPIX_pool [label="★ THE MASTER RATIO", penwidth=3, color="#b03030", style=bold];
  PPIX_rbc -> PPIX_skin [style=invis];
}
