digraph BE_QSP {
  rankdir=LR;
  fontname="Helvetica";
  labelloc="t";
  label="Barrett's Esophagus (BE) — Mechanistic QSP Map\nAcid + Bile Reflux → Intestinal Metaplasia → Clonal Evolution (CDKN2A → TP53) → Dysplasia → Esophageal Adenocarcinoma\nChemoprevention (PPI / P-CAB / Aspirin) · Endoscopic Eradication (RFA / EMR) · Surveillance";
  node [style=filled, fontname="Helvetica", fontsize=10, shape=box, fillcolor="#ffffff"];
  edge [fontname="Helvetica", fontsize=8];

  /* =====================================================================
     1. Host predisposition & risk factors
     ===================================================================== */
  subgraph cluster_risk {
    label="1. Host Predisposition & Risk Factors"; style=filled; color="#e8ddf0"; fillcolor="#f3ecf9";
    Male_sex [label="Male sex\n(M:F ~ 2:1 BE, 8:1 EAC)"];
    Age [label="Age\n(mean dx ~55 y)"];
    Central_obesity [label="Central obesity\n(waist-hip ratio)"];
    Smoking [label="Tobacco smoking\n(OR ~1.7 for EAC)"];
    White_ancestry [label="European ancestry"];
    Family_history [label="Familial BE/EAC\n(~7% pedigrees)"];
    GWAS_loci [label="GWAS loci\nMHC · CRTC1 · BARX1 · FOXP1"];
    Hpylori_absent [label="H. pylori absence\n(inverse assoc., OR ~0.5)"];
    Hiatal_hernia [label="Hiatal hernia\n(axial length)"];
    GERD_duration [label="GERD symptom\nduration (years)"];
    Alcohol [label="Alcohol\n(weak//null for EAC)"];
  }

  /* =====================================================================
     2. Reflux physiology
     ===================================================================== */
  subgraph cluster_reflux {
    label="2. Antireflux Barrier & Reflux Physiology"; style=filled; color="#dbe8f5"; fillcolor="#eaf3fb";
    LES_tone [label="LES resting\npressure"];
    TLESR [label="Transient LES\nrelaxations (TLESRs)"];
    Crural_diaphragm [label="Crural diaphragm /\nEGJ contractile integral"];
    Gastric_acid_secretion [label="Parietal-cell\nH+/K+-ATPase acid output"];
    Pepsin [label="Pepsin\n(activated at pH<4)"];
    Bile_acid_pool [label="Duodenal bile-acid pool\n(taurocholate, glycocholate)"];
    Deoxycholate [label="Deoxycholic acid (DCA)\nsecondary bile acid"];
    DGER [label="Duodeno-gastro-esophageal\nreflux (DGER)"];
    Esoph_clearance [label="Esophageal peristaltic\nclearance"];
    Saliva_bicarb [label="Salivary bicarbonate\nneutralization"];
    Nocturnal_breakthrough [label="Nocturnal acid\nbreakthrough"];
    Gastric_emptying [label="Delayed gastric\nemptying"];
    Intragastric_pH [label="Intragastric pH\n(% time pH>4)"];
  }

  /* =====================================================================
     3. Luminal insult & epithelial barrier failure
     ===================================================================== */
  subgraph cluster_insult {
    label="3. Luminal Insult & Barrier Failure"; style=filled; color="#f6dede"; fillcolor="#fdeeee";
    Acid_exposure_time [label="Acid exposure time (AET)\n% time pH<4"];
    DeMeester [label="DeMeester score\n(pH-impedance)"];
    Bile_exposure [label="Esophageal bile exposure\n(Bilitec / bile-salt assay)"];
    Squamous_epithelium [label="Native stratified\nsquamous epithelium"];
    Dilated_ICS [label="Dilated intercellular\nspaces (DIS)"];
    Tight_junction [label="Tight junction\nclaudin-1/-4 loss"];
    Permeability [label="Mucosal permeability\n(transepithelial resistance ↓)"];
    Erosive_esophagitis [label="Erosive esophagitis\n(LA grade A-D)"];
    Ulceration_repair [label="Ulceration &\nwound repair cycling"];
  }

  /* =====================================================================
     4. Oxidative stress & genome damage
     ===================================================================== */
  subgraph cluster_oxid {
    label="4. Oxidative Stress & Genome Damage"; style=filled; color="#f9e6cf"; fillcolor="#fdf3e6";
    ROS [label="ROS / superoxide\n(NOX5, mitochondrial)"];
    NOS_NO [label="iNOS → NO /\nperoxynitrite"];
    OHdG [label="8-OHdG\noxidative DNA adducts"];
    DSB [label="DNA double-strand\nbreaks (γH2AX)"];
    Telomere [label="Telomere\nshortening"];
    MMR_defect [label="Mismatch repair /\nBER capacity"];
    APOBEC [label="APOBEC mutational\nsignature"];
    ER_stress [label="ER stress /\nunfolded protein response"];
    Bile_mito [label="Bile-acid mitochondrial\nmembrane injury"];
  }

  /* =====================================================================
     5. Inflammatory signaling
     ===================================================================== */
  subgraph cluster_inflam {
    label="5. Mucosal Inflammatory Signaling"; style=filled; color="#f5dcea"; fillcolor="#fceef6";
    NFkB [label="NF-κB (p65)\nactivation"];
    IL6_STAT3 [label="IL-6 → JAK2/STAT3"];
    IL8_CXCL8 [label="IL-8 / CXCL8\nneutrophil chemotaxis"];
    TNFa [label="TNF-α"];
    IL1b [label="IL-1β / NLRP3"];
    COX2 [label="COX-2 (PTGS2)\ninduction"];
    PGE2 [label="PGE2\n(tissue)"];
    EP2_EP4 [label="EP2 / EP4 receptor\ncAMP signaling"];
    Th2_shift [label="Th2 / IL-4-IL-13\nlocal shift"];
    Myeloid_infiltrate [label="Neutrophil & macrophage\ninfiltration"];
  }

  /* =====================================================================
     6. Metaplastic transcriptional reprogramming
     ===================================================================== */
  subgraph cluster_meta {
    label="6. Metaplastic Reprogramming (Squamous → Columnar)"; style=filled; color="#d9f0ea"; fillcolor="#eafaf5";
    BMP4 [label="BMP4 → pSMAD1/5/8"];
    SOX9 [label="SOX9"];
    CDX1 [label="CDX1"];
    CDX2 [label="CDX2\n(master intestinal TF)"];
    HNF4A [label="HNF4A"];
    KLF4 [label="KLF4 / KLF5"];
    SOX2_loss [label="SOX2 / TP63\nsquamous program loss"];
    MUC2_goblet [label="MUC2 / TFF3\ngoblet cell differentiation"];
    Villin_CK [label="Villin · CK7/CK20\nBarrett phenotype"];
    Progenitor_origin [label="Cell of origin:\nresidual embryonic / submucosal gland /\ntransitional basal cells"];
    Notch_inhib [label="Notch pathway\nsuppression"];
  }

  /* =====================================================================
     7. Barrett's segment phenotype
     ===================================================================== */
  subgraph cluster_segment {
    label="7. Barrett's Segment Phenotype"; style=filled; color="#dcecd6"; fillcolor="#eef7ea";
    Intestinal_metaplasia [label="Specialized intestinal\nmetaplasia (goblet cells)"];
    Prague_CM [label="Prague C&M\nclassification (cm)"];
    SSBE [label="Short-segment BE\n(<3 cm)"];
    LSBE [label="Long-segment BE\n(≥3 cm) — higher risk"];
    Segment_area [label="Metaplastic mucosal\nsurface area (cm²)"];
    Buried_glands [label="Subsquamous 'buried'\nintestinal glands"];
    Goblet_density [label="Goblet cell\ndensity"];
    Islands_tongues [label="Islands & tongues\n(irregular Z-line)"];
  }

  /* =====================================================================
     8. Clonal evolution & genomic instability
     ===================================================================== */
  subgraph cluster_clonal {
    label="8. Clonal Evolution & Genomic Instability"; style=filled; color="#e3dccb"; fillcolor="#f4efe2";
    CDKN2A_loss [label="CDKN2A (p16) loss\n9p LOH — EARLY, frequent"];
    Clonal_expansion [label="Clonal expansion\n(field of p16-null crypts)"];
    TP53_mut [label="TP53 mutation / 17p LOH\n— gatekeeper of LGD→HGD"];
    p53_IHC [label="Aberrant p53 IHC\n(overexpression / null)"];
    WGD [label="Whole-genome doubling\n(catastrophic, punctuated)"];
    Aneuploidy [label="Aneuploidy /\nDNA content abnormality"];
    SMAD4_loss [label="SMAD4 loss\n— LATE, EAC-restricted"];
    Clonal_diversity [label="Clonal diversity\n(Shannon index)"];
    Receptor_amp [label="ERBB2 · EGFR · KRAS ·\nMYC amplification"];
    Telomerase [label="TERT reactivation"];
  }

  /* =====================================================================
     9. Histologic progression cascade
     ===================================================================== */
  subgraph cluster_prog {
    label="9. Histologic Progression Cascade"; style=filled; color="#f3d4d4"; fillcolor="#fbe9e9";
    NDBE [label="Non-dysplastic BE (NDBE)\n~0.1-0.3 %/yr → EAC", fillcolor="#e8f5e9"];
    Indefinite [label="Indefinite for dysplasia\n(IND)", fillcolor="#fff8e1"];
    LGD [label="Low-grade dysplasia (LGD)\nconfirmed: ~9 %/yr", fillcolor="#fff3c4"];
    LGD_regress [label="Spontaneous regression /\nexpert downstaging (~73%)"];
    HGD [label="High-grade dysplasia (HGD)\n~6-10 %/yr → EAC", fillcolor="#ffcc80"];
    IMC [label="Intramucosal EAC\n(T1a — endoscopically curable)", fillcolor="#ffab91"];
    Invasive_EAC [label="Invasive EAC\n(≥T1b, submucosal)", fillcolor="#ef9a9a"];
    Nodal_mets [label="Nodal / distant\nmetastasis", fillcolor="#e57373"];
  }

  /* =====================================================================
     10. Metabolic / growth-factor axis
     ===================================================================== */
  subgraph cluster_metab {
    label="10. Adiposity & Growth-Factor Axis"; style=filled; color="#dde8d0"; fillcolor="#eff5e6";
    Visceral_adipose [label="Visceral adipose\ntissue mass"];
    Leptin [label="Leptin → LepR\n(proliferative)"];
    Adiponectin [label="Adiponectin\n(protective) ↓"];
    Insulin_IGF1 [label="Insulin / IGF-1\n(hyperinsulinemia)"];
    PI3K_AKT [label="PI3K → AKT → mTOR"];
    Adipose_IL6 [label="Adipose-derived\nIL-6 / TNF-α"];
    Mechanical_load [label="Intra-abdominal pressure\n(mechanical, ↑ reflux)"];
    Weight_loss [label="Weight loss /\nGLP-1 RA / bariatric surgery"];
  }

  /* =====================================================================
     11. Proliferation / apoptosis balance
     ===================================================================== */
  subgraph cluster_growth {
    label="11. Proliferation ↔ Apoptosis Balance"; style=filled; color="#d6e4ec"; fillcolor="#eaf2f7";
    Ki67 [label="Ki-67 proliferative\nindex (%)"];
    CyclinD1 [label="Cyclin D1 / CDK4-6\nRB phosphorylation"];
    Apoptosis [label="Apoptosis\n(caspase-3, TUNEL)"];
    BclXL [label="Bcl-xL / survivin\n(apoptosis resistance)"];
    Crypt_fission [label="Crypt fission &\nstem-cell dynamics"];
    Mutation_fixation [label="Mutation fixation rate\n(∝ proliferation × damage)"];
  }

  /* =====================================================================
     12. PPI / P-CAB pharmacology
     ===================================================================== */
  subgraph cluster_ppi {
    label="12. Acid-Suppression Pharmacology (PPI / P-CAB)"; style=filled; color="#cfe0f5"; fillcolor="#e6eefb";
    PPI_dose [label="Esomeprazole PO\n20 mg OD vs 40 mg BID", fillcolor="#e3f2fd"];
    PPI_depot [label="Enteric-coated depot\n(delayed absorption)"];
    PPI_plasma [label="PPI plasma conc.\n(t½ ~1.3 h)"];
    CYP2C19 [label="CYP2C19 genotype\nPM · IM · NM · RM · UM (*17)"];
    CYP3A4 [label="CYP3A4 secondary\nmetabolism"];
    Pump_pool [label="Active H+/K+-ATPase pool\n(resynthesis t½ ~50 h)"];
    Covalent_inhib [label="Covalent sulfenamide\nbinding (irreversible)"];
    Acid_suppression [label="Acid suppression\n(% pH>4 holding time)"];
    Gastrin [label="Serum gastrin\n(2-4× rise)"];
    CCK2R [label="CCK2 receptor\ntrophic signaling"];
    PPI_safety [label="Long-term PPI concerns:\nfracture · hypoMg · C. difficile · CKD"];
    Vonoprazan [label="Vonoprazan (P-CAB)\nK+-competitive, t½ ~7 h", fillcolor="#e3f2fd"];
    VPZ_advantage [label="Sustained nocturnal control\n(CYP2C19-independent)"];
  }

  /* =====================================================================
     13. Aspirin / NSAID chemoprevention
     ===================================================================== */
  subgraph cluster_asa {
    label="13. Aspirin / NSAID Chemoprevention"; style=filled; color="#f5e0cf"; fillcolor="#fcf0e6";
    ASA_dose [label="Aspirin 300 mg PO OD\n(AspECT)", fillcolor="#fff3e0"];
    ASA_plasma [label="Aspirin / salicylate\nplasma conc. (t½ ~20 min)"];
    COX_acetyl [label="Irreversible COX-1/COX-2\nSer529/516 acetylation"];
    COX_activity [label="Mucosal COX activity\n(recovery with cell turnover)"];
    ASA_PGE2_down [label="Tissue PGE2 ↓"];
    ASA_apoptosis [label="Apoptosis restoration\n(NF-κB-independent)"];
    ASA_bleed [label="GI bleeding / ulcer risk\n(dose-dependent)"];
    Statin [label="Statin (adjunct,\nobservational RR ~0.6)"];
    Metformin [label="Metformin (phase 2:\nno pS6K reduction)"];
  }

  /* =====================================================================
     14. Endoscopic eradication & surveillance
     ===================================================================== */
  subgraph cluster_endo {
    label="14. Endoscopic Eradication & Surveillance"; style=filled; color="#d5e8e4"; fillcolor="#e9f6f3";
    Surveillance_EGD [label="Surveillance endoscopy\n(interval by grade)"];
    Seattle_protocol [label="Seattle biopsy protocol\n(4-quadrant / 1-2 cm)"];
    Sampling_error [label="Sampling error /\nmissed prevalent dysplasia"];
    WATS3D [label="WATS-3D wide-area\nbrush cytology"];
    Cytosponge [label="Cytosponge-TFF3\n(BEST3 case-finding)"];
    p53_biomarker [label="p53 IHC as risk\nstratifier (BSG/ACG)"];
    TissueCypher [label="Tissue systems pathology\nrisk score"];
    EMR_ESD [label="EMR / ESD of\nvisible lesion (staging + cure)", fillcolor="#e0f2f1"];
    RFA [label="Radiofrequency ablation\n(RFA, 12 J/cm²)", fillcolor="#e0f2f1"];
    Cryo [label="Cryoablation /\ncryoballoon", fillcolor="#e0f2f1"];
    Neosquamous [label="Neosquamous\nre-epithelialization"];
    CE_D [label="Complete eradication of\ndysplasia (CE-D ~93%)"];
    CE_IM [label="Complete eradication of\nintestinal metaplasia (CE-IM ~88%)"];
    Recurrence [label="Recurrent IM / dysplasia\n(~8-10 %/yr)"];
    Stricture [label="Post-ablation stricture\n(~6-12%)"];
    Fundoplication [label="Antireflux surgery /\nmagnetic sphincter augmentation", fillcolor="#e0f2f1"];
    Baclofen [label="Baclofen (GABA-B):\nTLESR reduction"];
    UDCA [label="UDCA: bile-pool\nhydrophobicity ↓"];
    Alginate [label="Alginate raft\n(postprandial)"];
  }

  /* =====================================================================
     15. Clinical endpoints
     ===================================================================== */
  subgraph cluster_end {
    label="15. Clinical Endpoints"; style=filled; color="#e0dcf0"; fillcolor="#efedfa";
    Heartburn [label="Heartburn severity\n(0-10)", fillcolor="#ede7f6"];
    Regurgitation [label="Regurgitation /\nRDQ score", fillcolor="#ede7f6"];
    Dysphagia [label="Dysphagia\n(alarm symptom)", fillcolor="#ede7f6"];
    EAC_incidence [label="EAC incidence\n(per 1000 person-years)", fillcolor="#ffcdd2"];
    AspECT_composite [label="AspECT composite:\nall-cause death · EAC · HGD", fillcolor="#ffcdd2"];
    Progression_hazard [label="Annual progression\nhazard (%/yr)", fillcolor="#ffcdd2"];
    Cancer_stage [label="Stage at diagnosis\n→ 5-yr survival", fillcolor="#ffcdd2"];
    QoL [label="Health-related QoL\n(cancer-worry burden)", fillcolor="#ede7f6"];
    Cost_effectiveness [label="Surveillance\ncost-effectiveness", fillcolor="#ede7f6"];
  }

  /* =====================================================================
     EDGES — risk factors into physiology
     ===================================================================== */
  Male_sex -> Visceral_adipose;
  Male_sex -> Segment_area [style=dashed];
  Age -> Telomere;
  Age -> CDKN2A_loss [style=dashed];
  Central_obesity -> Visceral_adipose;
  Central_obesity -> Mechanical_load;
  Smoking -> APOBEC;
  Smoking -> ROS;
  White_ancestry -> GWAS_loci [style=dashed];
  Family_history -> GWAS_loci;
  GWAS_loci -> BMP4 [style=dashed, label="BARX1/FOXP1"];
  Hpylori_absent -> Gastric_acid_secretion [label="+"];
  Hiatal_hernia -> Crural_diaphragm [label="-", color="#c62828"];
  Hiatal_hernia -> TLESR [label="+", color="#2e7d32"];
  GERD_duration -> Acid_exposure_time;
  Alcohol -> Erosive_esophagitis [style=dashed];

  /* ---- Reflux barrier physiology ---- */
  LES_tone -> Acid_exposure_time [label="-", color="#c62828"];
  TLESR -> Acid_exposure_time [label="+", color="#2e7d32"];
  Crural_diaphragm -> LES_tone [label="+", color="#2e7d32"];
  Gastric_acid_secretion -> Intragastric_pH [label="-", color="#c62828"];
  Intragastric_pH -> Acid_exposure_time;
  Gastric_acid_secretion -> Pepsin [label="activates"];
  Bile_acid_pool -> DGER;
  Deoxycholate -> DGER;
  Bile_acid_pool -> Deoxycholate [label="colonic 7α-dehydroxylation"];
  DGER -> Bile_exposure;
  Gastric_emptying -> DGER;
  Esoph_clearance -> Acid_exposure_time [label="-", color="#c62828"];
  Saliva_bicarb -> Acid_exposure_time [label="-", color="#c62828"];
  Nocturnal_breakthrough -> Acid_exposure_time [label="+", color="#2e7d32"];
  Mechanical_load -> TLESR;

  /* ---- Luminal insult ---- */
  Acid_exposure_time -> DeMeester;
  Acid_exposure_time -> Squamous_epithelium [label="injury", color="#c62828"];
  Pepsin -> Squamous_epithelium [label="proteolysis", color="#c62828"];
  Bile_exposure -> Squamous_epithelium [label="detergent", color="#c62828"];
  Squamous_epithelium -> Dilated_ICS;
  Dilated_ICS -> Tight_junction;
  Tight_junction -> Permeability;
  Permeability -> Acid_exposure_time [label="+ (vicious cycle)", style=dashed, color="#c62828"];
  Acid_exposure_time -> Erosive_esophagitis;
  Bile_exposure -> Erosive_esophagitis;
  Erosive_esophagitis -> Ulceration_repair;
  Ulceration_repair -> Progenitor_origin [label="repair from\nalternative progenitors"];
  Erosive_esophagitis -> Heartburn;
  Acid_exposure_time -> Heartburn;
  Permeability -> Heartburn [label="nociceptor access"];
  DGER -> Regurgitation;

  /* ---- Oxidative stress & DNA damage ---- */
  Acid_exposure_time -> ROS;
  Bile_exposure -> Bile_mito;
  Bile_mito -> ROS;
  Deoxycholate -> ER_stress;
  ER_stress -> ROS;
  Myeloid_infiltrate -> ROS;
  Myeloid_infiltrate -> NOS_NO;
  ROS -> OHdG;
  NOS_NO -> OHdG;
  OHdG -> DSB;
  ROS -> DSB;
  Telomere -> DSB;
  MMR_defect -> Mutation_fixation [label="-repair", color="#c62828"];
  DSB -> Mutation_fixation;
  APOBEC -> Mutation_fixation;
  ROS -> NFkB;

  /* ---- Inflammation ---- */
  Acid_exposure_time -> NFkB;
  Bile_exposure -> NFkB [label="DCA → IKK"];
  Permeability -> NFkB;
  NFkB -> IL6_STAT3;
  NFkB -> IL8_CXCL8;
  NFkB -> TNFa;
  NFkB -> IL1b;
  NFkB -> COX2;
  IL1b -> COX2;
  TNFa -> NFkB [style=dashed, label="feed-forward"];
  COX2 -> PGE2;
  PGE2 -> EP2_EP4;
  IL8_CXCL8 -> Myeloid_infiltrate;
  TNFa -> Myeloid_infiltrate;
  IL6_STAT3 -> BclXL;
  Th2_shift -> MUC2_goblet [style=dashed];
  IL6_STAT3 -> Ki67;
  EP2_EP4 -> CyclinD1;
  EP2_EP4 -> Apoptosis [label="-", color="#c62828"];

  /* ---- Metaplastic reprogramming ---- */
  NFkB -> BMP4;
  Bile_exposure -> CDX2 [label="DCA → NF-κB → CDX2"];
  BMP4 -> SOX9;
  SOX9 -> CDX2;
  NFkB -> CDX1;
  CDX1 -> CDX2;
  CDX2 -> HNF4A;
  HNF4A -> MUC2_goblet;
  CDX2 -> MUC2_goblet;
  CDX2 -> Villin_CK;
  KLF4 -> MUC2_goblet;
  BMP4 -> SOX2_loss [label="-", color="#c62828"];
  SOX2_loss -> Squamous_epithelium [label="-", color="#c62828"];
  Notch_inhib -> MUC2_goblet;
  CDX2 -> Notch_inhib;
  Progenitor_origin -> Intestinal_metaplasia;
  MUC2_goblet -> Intestinal_metaplasia;
  Villin_CK -> Intestinal_metaplasia;

  /* ---- Segment phenotype ---- */
  Intestinal_metaplasia -> Prague_CM;
  Prague_CM -> SSBE;
  Prague_CM -> LSBE;
  Prague_CM -> Segment_area;
  Intestinal_metaplasia -> Goblet_density;
  Intestinal_metaplasia -> Islands_tongues;
  Segment_area -> Clonal_diversity [label="larger field =\nmore clones"];
  Segment_area -> Progression_hazard [label="~1.7× per 2 cm"];
  LSBE -> Progression_hazard;
  Acid_exposure_time -> Prague_CM [label="segment\nextension"];

  /* ---- Clonal evolution ---- */
  Mutation_fixation -> CDKN2A_loss;
  Ki67 -> Mutation_fixation;
  CDKN2A_loss -> Clonal_expansion;
  Clonal_expansion -> Clonal_diversity;
  CDKN2A_loss -> CyclinD1 [label="-p16 brake", color="#c62828"];
  Mutation_fixation -> TP53_mut;
  Clonal_expansion -> TP53_mut [label="substrate for\nnext hit"];
  TP53_mut -> p53_IHC;
  TP53_mut -> WGD;
  WGD -> Aneuploidy;
  Aneuploidy -> Clonal_diversity;
  TP53_mut -> Apoptosis [label="-", color="#c62828"];
  Aneuploidy -> Receptor_amp;
  Receptor_amp -> Ki67;
  SMAD4_loss -> Invasive_EAC;
  Telomerase -> Clonal_expansion;
  Telomere -> Telomerase [label="crisis →\nreactivation"];

  /* ---- Progression cascade ---- */
  Intestinal_metaplasia -> NDBE;
  NDBE -> Indefinite;
  Indefinite -> LGD;
  NDBE -> LGD [label="k_LGD ∝ mutational drive"];
  CDKN2A_loss -> LGD;
  LGD -> LGD_regress [label="downstaging"];
  LGD_regress -> NDBE;
  LGD -> HGD [label="TP53-gated"];
  TP53_mut -> HGD;
  Aneuploidy -> HGD;
  HGD -> IMC;
  IMC -> Invasive_EAC;
  Aneuploidy -> Invasive_EAC;
  Invasive_EAC -> Nodal_mets;
  Invasive_EAC -> Dysphagia;
  Nodal_mets -> Cancer_stage;
  IMC -> Cancer_stage;

  /* ---- Metabolic axis ---- */
  Visceral_adipose -> Leptin;
  Visceral_adipose -> Adiponectin [label="-", color="#c62828"];
  Visceral_adipose -> Adipose_IL6;
  Visceral_adipose -> Insulin_IGF1;
  Leptin -> PI3K_AKT;
  Insulin_IGF1 -> PI3K_AKT;
  Adiponectin -> PI3K_AKT [label="-", color="#c62828"];
  PI3K_AKT -> Ki67;
  PI3K_AKT -> BclXL;
  Adipose_IL6 -> IL6_STAT3;
  Weight_loss -> Visceral_adipose [label="-", color="#c62828"];
  Weight_loss -> Mechanical_load [label="-", color="#c62828"];

  /* ---- Proliferation / apoptosis ---- */
  CyclinD1 -> Ki67;
  Ki67 -> Crypt_fission;
  Crypt_fission -> Clonal_expansion;
  BclXL -> Apoptosis [label="-", color="#c62828"];
  Apoptosis -> Clonal_expansion [label="-", color="#c62828"];
  Ki67 -> Segment_area;

  /* ---- PPI pharmacology ---- */
  PPI_dose -> PPI_depot;
  PPI_depot -> PPI_plasma;
  CYP2C19 -> PPI_plasma [label="clearance\n(PM ↑ AUC 4-5×)"];
  CYP3A4 -> PPI_plasma [label="clearance"];
  PPI_plasma -> Covalent_inhib;
  Covalent_inhib -> Pump_pool [label="-", color="#c62828"];
  Pump_pool -> Gastric_acid_secretion;
  Pump_pool -> Acid_suppression [label="-", color="#c62828"];
  Acid_suppression -> Intragastric_pH [label="+", color="#2e7d32"];
  Acid_suppression -> Acid_exposure_time [label="-", color="#c62828"];
  Acid_suppression -> Pepsin [label="- (inactive at pH>4)", color="#c62828"];
  Acid_suppression -> Gastrin [label="+", color="#2e7d32"];
  Gastrin -> CCK2R;
  CCK2R -> Ki67 [label="+ trophic (tension)", color="#ef6c00"];
  Gastrin -> Gastric_acid_secretion [label="+ rebound", style=dashed];
  PPI_plasma -> PPI_safety;
  Acid_suppression -> Heartburn [label="-", color="#c62828"];
  Vonoprazan -> Pump_pool [label="- K+-competitive", color="#c62828"];
  Vonoprazan -> VPZ_advantage;
  VPZ_advantage -> Nocturnal_breakthrough [label="-", color="#c62828"];
  VPZ_advantage -> Acid_suppression [label="+", color="#2e7d32"];
  CYP2C19 -> VPZ_advantage [label="minimal effect", style=dashed];
