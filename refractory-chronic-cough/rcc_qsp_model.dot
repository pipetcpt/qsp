  /* ================================================================
     20. DISEASE-STATE INTEGRATORS
     ================================================================ */
  subgraph cluster_state {
    label="20 · 질환 상태 통합 변수 (Disease-State Integrators — the bistable core)";
    style="filled,rounded"; color="#37474F"; fillcolor="#CFD8DC"; fontsize=11;
    node [shape=box, style="filled,bold", fillcolor="#B0BEC5", color="#263238", penwidth=2];

    PERGAIN  [label="말초 이득\nPERIPHERAL GAIN\n(receptor expression ×\nsensitisation)"];
    CENGAIN  [label="중추 이득\nCENTRAL GAIN\n(wind-up × loss of inhibition)"];
    LOOPGAIN [label="루프 이득\nLOOP GAIN\n> 1 → SELF-SUSTAINING\nRefractory chronic cough\n< 1 → post-viral cough resolves"];
    HYPERSENS [label="기침 과민증 증후군\nCOUGH HYPERSENSITIVITY\nhypertussia + allotussia +\nlaryngeal paraesthesia"];
    TUSSDRIVE [label="총 기침 구동력\nTOTAL TUSSIVE DRIVE\n= afferent barrage × central gain"];
  }

  /* ================================================================
     EDGES — 1. Triggers into the airway
     ================================================================ */
  T_VIRUS   -> EPI_DAM   [label="cytopathic"];
  T_VIRUS   -> NGF       [label="↑↑", style=dashed];
  T_VIRUS   -> T_POSTVIR;
  T_POSTVIR -> AFIRE;
  T_SMOKE   -> EPI_DAM;
  T_SMOKE   -> OXSTR;
  T_SMOKE   -> TRPA1     [label="acrolein"];
  T_ALLERG  -> TH2;
  T_REFLUX  -> ACIDREF;
  T_REFLUX  -> NONACID;
  T_UACS    -> EXTRAP    [label="pharyngeal\nafferents"];
  T_UACS    -> MUCUS;
  T_IPF     -> RAR       [label="traction on\nmechanoreceptors"];
  T_IPF     -> EPI_DAM;
  T_SURG    -> SLN;
  T_ACEI    -> BK        [label="kininase II\ninhibition"];
  T_ACEI    -> SUBP_P    [label="↓ degradation"];
  T_MENO    -> ESTRO     [style=dashed];
  T_GENE    -> TRPV1     [style=dashed, label="TRPV1 I585V"];
  T_AGE     -> PERIPHSENS [style=dashed, label="F: C5 2-4x lower"];
  T_AGE     -> CENGAIN   [style=dashed];

  /* 2. Epithelium and ATP */
  EPI_DAM  -> EPI_INT    [arrowhead=tee];
  EPI_INT  -> PANX1      [arrowhead=tee, label="intact barrier\nrestrains release"];
  EPI_DAM  -> PANX1;
  MECHSTR  -> PANX1;
  OSMO     -> PANX1;
  NFKB     -> PANX1      [style=dashed];
  PANX1    -> ATP_REL;
  EPI_DAM  -> ATP_REL    [label="lytic release"];
  ATP_REL  -> ATP_ASL;
  ENTPD    -> ATP_ASL    [arrowhead=tee];
  ATP_ASL  -> ADENO      [label="via CD39/CD73"];
  ADENO    -> AFIRE      [label="A1 excitatory"];
  ATP_ASL  -> P2X3       [label="AGONIST", penwidth=1.8, color="#1565C0"];
  ATP_ASL  -> P2X23;
  MUCUS    -> RAR        [label="mechanical"];
  MCC      -> MUCUS      [arrowhead=tee];
  MUCUS    -> MCC        [arrowhead=tee];
  EPI_REP  -> EPI_INT;
  EPI_DAM  -> EPI_REP    [style=dashed, label="slow, weeks"];
  EPI_DAM  -> MCC        [arrowhead=tee];

  /* 3. Inflammation */
  TH2      -> EOS;
  TH2      -> IL33       [dir=back];
  IL33     -> TH2;
  IL33     -> MAST;
  EOS      -> EOSPROD;
  EOSPROD  -> EPI_DAM    [label="MBP/ECP\ncytotoxicity"];
  EOS      -> NGF        [style=dashed];
  EOS      -> FENO;
  MAST     -> HIST;
  MAST     -> PGD2;
  MAST     -> TRYPT;
  HIST     -> AFIRE      [label="H1"];
  PGD2     -> AFIRE      [label="DP2"];
  TRYPT    -> PERIPHSENS [label="PAR-2"];
  NEUT     -> OXSTR;
  MACRO    -> NFKB;
  NFKB     -> IL6L;
  NFKB     -> COX2;
  COX2     -> PGE2;
  NFKB     -> NGF        [style=dashed];
  TH2      -> MUCUS      [label="IL-13"];
  OXSTR    -> TRPA1      [label="4-HNE"];
  OXSTR    -> EPI_DAM;

  /* 4. Reflux */
  LES      -> ACIDREF    [arrowhead=tee];
  TLESR    -> ACIDREF;
  TLESR    -> NONACID;
  HIATUS   -> LES        [arrowhead=tee];
  ACIDREF  -> PEPSIN;
  NONACID  -> PEPSIN;
  PEPSIN   -> LPR;
  PEPSIN   -> EPI_DAM    [label="laryngeal\nmucosal injury"];
  ACIDREF  -> PROTON;
  ASPIRA   -> EPI_DAM;
  ACIDREF  -> ASPIRA;
  ACIDREF  -> OESVAGAL;
  NONACID  -> OESVAGAL   [label="distension,\ngas"];
  OESVAGAL -> AFIRE      [label="oesophago-\nbronchial reflex"];
  LPR      -> LARYSPAS;
  LPR      -> SLN;
  COUGHREF -> ACIDREF    [color="#D32F2F", penwidth=1.5, style=bold,
                          label="cough → reflux\n→ cough"];

  /* 5. Mediators onto channels */
  NGF      -> P2X3EXP    [style=dashed, penwidth=1.6, color="#E65100",
                          label="TrkA → transcription\nDAYS-WEEKS"];
  NGF      -> TRPV1      [label="TrkA/PI3K\ntrafficking"];
  NGF      -> NAV17      [style=dashed];
  BDNF_P   -> PERIPHSENS [style=dashed];
  PGE2     -> EP3R;
  EP3R     -> TRPV1      [label="PKA\nphosphorylation"];
  EP3R     -> PERIPHSENS;
  BK       -> B2R;
  B2R      -> TRPV1      [label="PKC"];
  B2R      -> TRPA1;
  B2R      -> SUBP_P;
  PROTON   -> ASIC3;
  PROTON   -> TRPV1;
  LTD4     -> AFIRE;
  IL6L     -> PERIPHSENS;
  ESTRO    -> TRPV1      [style=dashed, label="modulates\nexpression"];
  ESTRO    -> NGF        [style=dashed];
  SUBP_P   -> NK1P;
  NK1P     -> PERIPHSENS;
  ATPADO   -> P2X3;

  /* 6. Channels into afferents */
  P2X3     -> JUG_C      [penwidth=1.6, color="#1565C0"];
  P2X3     -> AD_COUGH   [penwidth=1.6, color="#1565C0"];
  P2X23    -> NOD_C;
  P2X3EXP  -> P2X3       [label="receptor\ndensity"];
  TRPV1    -> JUG_C      [penwidth=1.4];
  TRPA1    -> JUG_C;
  ASIC3    -> AD_COUGH;
  NAV17    -> AFIRE      [label="AP generation"];
  KV       -> AFIRE      [arrowhead=tee, label="membrane\nstabilisation"];
  A2CH     -> AFIRE      [label="Ca_v traffick.,\n↑ in neuropathy"];
  MOR_P    -> AFIRE      [arrowhead=tee];
  TRPM8    -> AFIRE      [arrowhead=tee, label="menthol:\nANTI-tussive"];
  EP3R     -> AD_COUGH;
  B2R      -> JUG_C;

  /* 7. Afferents to integrated firing */
  JUG_C    -> AFIRE      [penwidth=1.5];
  NOD_C    -> AFIRE;
  AD_COUGH -> AFIRE      [penwidth=1.5];
  RAR      -> AFIRE;
  SLN      -> AFIRE      [penwidth=1.4];
  EXTRAP   -> AFIRE;
  PERIPHSENS -> AFIRE    [penwidth=1.6, label="threshold ↓"];
  PERIPHSENS -> ECTOPIC  [penwidth=1.4];
  ECTOPIC  -> AFIRE      [penwidth=1.5, label="cough with a\nnormal airway"];
  P2X3EXP  -> ECTOPIC    [style=dashed];
  NAV17    -> ECTOPIC;
  JUG_C    -> SUBP_P     [label="axon reflex"];
  JUG_C    -> PSNEUR;

  /* 8. Afferents into brainstem */
  AFIRE    -> NTS        [penwidth=2.0, color="#6A1B9A",
                          label="afferent barrage"];
  NTS      -> AMPA;
  NTS      -> NMDA;
  AFIRE    -> SUBP_C     [label="central\nrelease"];
  SUBP_C   -> NMDA       [label="NK-1 → removes\nMg2+ block"];
  NMDA     -> WINDUP     [penwidth=1.8, color="#6A1B9A"];
  AMPA     -> NTS;
  WINDUP   -> NTS        [penwidth=1.8, color="#6A1B9A", label="synaptic gain ↑"];
  GABAI    -> NTS        [arrowhead=tee, penwidth=1.4];
  WINDUP   -> GABAI      [arrowhead=tee, style=dashed,
                          label="disinhibition"];
  MICROG   -> GABAI      [arrowhead=tee, label="BDNF → KCC2 ↓"];
  AFIRE    -> MICROG     [style=dashed, label="sustained barrage,\nDAYS"];
  MICROG   -> WINDUP     [style=dashed];
  ASTRO    -> NTS        [arrowhead=tee, label="glutamate\nre-uptake"];
  WINDUP   -> ASTRO      [arrowhead=tee, style=dashed];
  SEROT    -> NTS;
  PSNEUR   -> THAL;
  NTS      -> CVLM;
  CVLM     -> CPG;
  NTS      -> THAL       [penwidth=1.4];

  /* 9. Descending modulation */
  PAG      -> RVM;
  RVM      -> DESCINH;
  RAPHE    -> DESCINH;
  LC       -> DESCINH    [label="α2-noradrenergic"];
  ENKEPH   -> DESCINH    [penwidth=1.4];
  DESCINH  -> NTS        [arrowhead=tee, penwidth=1.7, color="#4527A0",
                          label="THE BRAKE"];
  DESCINH  -> THRESH     [label="raises"];
  DESCFAC  -> NTS        [penwidth=1.3];
  HYPERVIG -> DESCFAC    [penwidth=1.4];
  PFC      -> PAG;
  SLEEPDEB -> DESCINH    [arrowhead=tee, penwidth=1.4];

  /* 10. Cortex and urge */
  THAL     -> INSULA     [penwidth=1.5];
  THAL     -> S1;
  INSULA   -> URGE       [penwidth=1.8, color="#0277BD"];
  ACC      -> URGE       [label="unpleasantness"];
  INSULA   -> ACC;
  S1       -> URGE       [label="localisation:\n'a tickle, here'"];
  URGE     -> PFC        [label="recruits\nsuppression"];
  PFC      -> CORTSUP    [penwidth=1.5];
  ATTEN    -> CORTSUP;
  CORTSUP  -> THRESH     [penwidth=1.7, color="#0277BD", label="raises threshold —\nvoluntary suppression"];
  HYPERVIG -> CORTSUP    [arrowhead=tee];
  HYPERVIG -> URGE       [label="amplifies\npercept"];
  URGE     -> HYPERVIG   [style=dashed];
  HABIT    -> CPG        [label="operant\nreinforcement"];
  URGE     -> HABIT      [style=dashed];
  URGE     -> UCSCORE;

  /* 11. Motor output */
  TUSSDRIVE -> CPG       [penwidth=2.0, color="#C62828"];
  THRESH   -> CPG        [arrowhead=tee, penwidth=1.7];
  AFIRE    -> TUSSDRIVE  [penwidth=1.6];
  CENGAIN  -> TUSSDRIVE  [penwidth=1.6];
  CPG      -> INSP;
  INSP     -> COMPR;
  COMPR    -> EXPUL;
  EXPUL    -> BOUT;
  CPG      -> BOUT;
  LARYSPAS -> CPG;
  EXPUL    -> MECHSTR    [color="#D32F2F", penwidth=1.8, style=bold,
                          label="cough traumatises\nthe airway"];
  EXPUL    -> COUGHREF   [color="#D32F2F", penwidth=1.5, style=bold];

  /* 12. Circadian and sleep */
  CIRCOSC  -> AWAKE      [penwidth=1.4];
  AWAKE    -> CORTSUP    [label="suppression only\nexists when awake"];
  AWAKE    -> CPG        [penwidth=1.6, label="GATE"];
  SLEEPSUP -> CPG        [arrowhead=tee, penwidth=1.6];
  AWAKE    -> SLEEPSUP   [arrowhead=tee];
  CIRCOSC  -> MORNPEAK;
  MORNPEAK -> CF24;
  BOUT     -> SLEEPFRAG;
  SLEEPFRAG -> SLEEPDEB;
  SLEEPDEB -> CORTSUP    [arrowhead=tee, penwidth=1.4,
                          label="tired patients\nsuppress less"];
  AWAKE    -> AWAKEF;
  BOUT     -> AWAKEF;
  MUCUS    -> MORNPEAK   [label="overnight\naccumulation"];

  /* 13. P2X3 antagonists */
  GEFA     -> OCC3       [penwidth=1.5, color="#1565C0"];
  GEFA     -> OCC23      [penwidth=1.5, color="#E64A19",
                          label="SELECTIVITY ≈ 1 →\nSAME exposure hits both"];
  CAMLI    -> OCC3       [penwidth=1.5, color="#1565C0"];
  CAMLI    -> OCC23      [style=dashed, color="#BDBDBD",
                          label="1500x selective →\nnegligible at\ntherapeutic dose"];
  ELIA     -> OCC3       [color="#1565C0"];
  ELIA     -> OCC23      [style=dashed, color="#FFB74D", label="60x"];
  ELIA     -> DILI       [color="#E64A19", style=dashed,
                          label="idiosyncratic,\nNOT target-mediated"];
  SIVO     -> OCC3       [color="#1565C0", label="QD dosing →\ntrough coverage\nshortfall"];
  SIVO     -> OCC23      [style=dashed, color="#FFB74D", label="30x"];
  RENAL    -> GEFA       [arrowhead=tee, label="OAT3 clearance"];
  ATP_ASL  -> OCC3       [arrowhead=tee, penwidth=1.3, color="#795548",
                          label="ATP COMPETITION:\nmore airway ATP →\nless inhibition"];
  OCC3     -> P2X3       [arrowhead=tee, penwidth=2.0, color="#1565C0"];
  OCC3     -> CEILING;
  CEILING  -> TUSSDRIVE  [label="floor on achievable\ncough reduction"];
  TRPV1    -> CEILING    [label="P2X3-independent\narm"];
  TRPA1    -> CEILING;
  RAR      -> CEILING;

  /* 14. Central neuromodulators */
  GABAP    -> A2CH       [arrowhead=tee, penwidth=1.5, color="#3949AB"];
  GABAP    -> WINDUP     [arrowhead=tee, penwidth=1.4, color="#3949AB"];
  GABAP    -> GABAAE     [color="#E64A19"];
  PREGAB   -> A2CH       [arrowhead=tee, color="#3949AB"];
  PREGAB   -> GABAAE     [color="#E64A19"];
  MORPH    -> ENKEPH     [label="μ-agonism at\nthe same targets", color="#3949AB"];
  MORPH    -> DESCINH    [penwidth=1.6, color="#3949AB"];
  MORPH    -> NTS        [arrowhead=tee, penwidth=1.4, color="#3949AB"];
  MORPH    -> OPIOIDAE   [color="#E64A19"];
  NALBU    -> DESCINH    [color="#3949AB", label="κ-agonist"];
  NALBU    -> OPIOIDAE   [color="#E64A19", style=dashed];
  AMITRIP  -> DESCINH    [color="#3949AB", label="NA/5-HT re-uptake"];
  AMITRIP  -> NAV17      [arrowhead=tee, style=dashed];
  BACLO    -> TLESR      [arrowhead=tee, color="#3949AB"];
  BACLO    -> NTS        [arrowhead=tee, color="#3949AB"];
  DEXTRO   -> NMDA       [arrowhead=tee, style=dashed, color="#90A4AE",
                          label="weak in RCC"];
  CODEINE  -> NTS        [arrowhead=tee, style=dashed, color="#90A4AE",
                          label="no better than\nplacebo (negative\ncontrol)"];
  MOR_P    -> ENKEPH     [dir=back, style=dashed];

  /* 15. Treatable traits */
  ICS      -> EOS        [arrowhead=tee, penwidth=1.5, color="#2E7D32"];
  ICS      -> NFKB       [arrowhead=tee, color="#2E7D32"];
  ICS      -> FENO       [arrowhead=tee];
  LTRA     -> LTD4       [arrowhead=tee, color="#2E7D32"];
  BIOLOG   -> EOS        [arrowhead=tee, color="#2E7D32", style=dashed];
  PPI      -> ACIDREF    [arrowhead=tee, penwidth=1.4, color="#2E7D32"];
  PPI      -> NONACID    [style=dotted, color="#BDBDBD",
                          label="NO EFFECT — this is\nwhy PPI trials fail"];
  PROKIN   -> TLESR      [arrowhead=tee, color="#2E7D32"];
  ANTIHIST -> HIST       [arrowhead=tee, color="#2E7D32"];
  ANTIHIST -> EXTRAP     [arrowhead=tee, style=dashed];
  NASSTER  -> T_UACS     [arrowhead=tee, color="#2E7D32"];
  ACEISTOP -> BK         [arrowhead=tee, penwidth=1.6, color="#2E7D32"];
  AZITHRO  -> NEUT       [arrowhead=tee, color="#2E7D32"];

  /* 16. Non-pharmacological */
  SLT      -> CORTSUP    [penwidth=1.8, color="#00796B",
                          label="TRAINS the suppression\nnetwork: LCQ +1.5"];
  SLT      -> HABIT      [arrowhead=tee, color="#00796B"];
  CSTX     -> CORTSUP    [color="#00796B"];
  CBTC     -> HYPERVIG   [arrowhead=tee, penwidth=1.4, color="#00796B"];
  CBTC     -> DESCFAC    [arrowhead=tee, color="#00796B"];
  SLNBLOCK -> SLN        [arrowhead=tee, color="#00796B"];
  NEBLIDO  -> NAV17      [arrowhead=tee, color="#00796B",
                          label="use-dependent\nNa+ block, minutes"];
  VOCALHYG -> EPI_DAM    [arrowhead=tee, style=dashed, color="#00796B"];

  /* 17. On-target adverse effects */
  TASTEATP -> P2X23      [penwidth=1.5, label="ATP is THE taste\nneurotransmitter"];
  TASTEBUD -> TASTEATP;
  OCC23    -> P2X23      [arrowhead=tee, penwidth=1.8, color="#E64A19"];
  OCC23    -> DYSG       [penwidth=2.0, color="#E64A19",
                          label="the SAME occupancy curve\nthat gives efficacy"];
  DYSG     -> DISCONT    [penwidth=1.6, color="#E64A19"];
  DYSG     -> ADHERE     [arrowhead=tee, penwidth=1.6, color="#E64A19"];
  DISCONT  -> ADHERE     [arrowhead=tee, penwidth=1.5, color="#E64A19"];
  ADHERE   -> OCC3       [penwidth=1.6, color="#E64A19",
                          label="effectiveness\n< efficacy"];
  DILI     -> ELIA       [arrowhead=tee, style=dashed, color="#E64A19"];
  GABAAE   -> GABAP      [arrowhead=tee, style=dashed, color="#E64A19",
                          label="dose titration\nlimited"];
  OPIOIDAE -> MORPH      [arrowhead=tee, style=dashed, color="#E64A19"];

  /* 18. Measurement */
  TRPV1    -> CAPSC5     [label="capsaicin acts HERE —\nbypassing P2X3"];
  P2X3     -> ATPCHAL;
  ASIC3    -> CITRICA;
  TRPV1    -> CITRICA;
  BOUT     -> COUGHMON   [penwidth=1.6];
  EOS      -> SPUTUM;
  FENO     -> FENOM;
  ACIDREF  -> PHIMP;
  NONACID  -> PHIMP;
  COUGHMON -> CF24       [penwidth=1.8];
  COUGHMON -> CFAWK;
  OCC3     -> ATPCHAL    [arrowhead=tee, penwidth=1.7, color="#1565C0",
                          label="STRONG shift"];
  OCC3     -> CAPSC5     [arrowhead=tee, style=dotted, color="#90A4AE",
                          label="MINIMAL shift —\nthe class's diagnostic\nsignature"];

  /* 19. Endpoints */
  BOUT     -> CF24       [penwidth=1.8];
  AWAKEF   -> CFAWK      [penwidth=1.5];
  CF24     -> VAS        [penwidth=1.3];
  URGE     -> VAS        [penwidth=1.5,
                          label="PROs track the URGE,\nnot only the count"];
  URGE     -> CSD;
  CF24     -> CSD;
  CF24     -> LCQ        [arrowhead=tee];
  URGE     -> LCQ        [arrowhead=tee, penwidth=1.4];
  HYPERVIG -> LCQ        [arrowhead=tee];
  SLEEPFRAG -> LCQ       [arrowhead=tee];
  CF24     -> COMPLIC    [penwidth=1.4];
  COMPLIC  -> LCQ        [arrowhead=tee];
  COMPLIC  -> DEPRESS;
  DEPRESS  -> HYPERVIG   [penwidth=1.3];
  LCQ      -> RESPOND;
  CF24     -> RESPOND;
  CORTSUP  -> PLACEBO    [penwidth=1.5,
                          label="trial participation itself\ntrains suppression"];
  EPI_REP  -> PLACEBO    [label="natural resolution"];
  PLACEBO  -> CF24       [arrowhead=tee, penwidth=1.7, color="#AD1457",
                          label="≈ -30% at 12 weeks\nBEFORE any drug effect"];

  /* 20. Disease-state integrators — the bistable core */
  P2X3EXP  -> PERGAIN    [penwidth=1.5];
  PERIPHSENS -> PERGAIN  [penwidth=1.5];
  ECTOPIC  -> PERGAIN;
  WINDUP   -> CENGAIN    [penwidth=1.7];
  GABAI    -> CENGAIN    [arrowhead=tee, penwidth=1.4];
  MICROG   -> CENGAIN;
  DESCINH  -> CENGAIN    [arrowhead=tee, penwidth=1.5];
  PERGAIN  -> LOOPGAIN   [penwidth=1.7];
  CENGAIN  -> LOOPGAIN   [penwidth=1.7];
  LOOPGAIN -> HYPERSENS  [penwidth=1.8, color="#C62828"];
  HYPERSENS -> TUSSDRIVE [penwidth=1.7, color="#C62828"];
  HYPERSENS -> ECTOPIC   [penwidth=1.4];
  HYPERSENS -> CAPSC5    [arrowhead=tee, label="hypertussia"];
  HYPERSENS -> URGE      [penwidth=1.4, label="allotussia:\ntalking, laughing,\nperfume, cold air"];

  /* THE VICIOUS CIRCLE — drawn bold red */
  MECHSTR  -> EPI_DAM    [color="#D32F2F", penwidth=2.2, style=bold];
  ATP_ASL  -> AFIRE      [color="#D32F2F", penwidth=2.2, style=bold];
  AFIRE    -> WINDUP     [color="#D32F2F", penwidth=2.2, style=bold];
  WINDUP   -> TUSSDRIVE  [color="#D32F2F", penwidth=2.2, style=bold];
  CPG      -> EXPUL      [color="#D32F2F", penwidth=2.2, style=bold];

  /* Cross-links that matter clinically */
  EOS      -> ICS        [dir=back, style=dotted, color="#2E7D32",
                          label="FeNO/sputum eos\nSELECT the responder"];
  ACIDREF  -> PPI        [dir=back, style=dotted, color="#2E7D32",
                          label="pH-impedance\nSELECTS the responder"];
  ATP_ASL  -> GEFA       [dir=back, style=dotted, color="#1565C0",
                          label="high airway ATP →\nhigher dose needed"];
  T_POSTVIR -> LOOPGAIN  [style=dashed, penwidth=1.4,
                          label="loop gain decides:\nresolve vs become\nrefractory"];
  SLEEPSUP -> CF24       [arrowhead=tee, style=dashed,
                          label="why 24-h < awake rate"];

}
