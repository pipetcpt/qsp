digraph LCH_QSP {
  rankdir=LR;
  fontname="Helvetica";
  labelloc="t";
  fontsize=20;
  label="Langerhans Cell Histiocytosis (LCH) — Mechanistic QSP Map\nMisrouted myeloid DC precursor × cell-of-origin partition × ERK-driven senescent secretome × cytostatic MAPK inhibition and rebound × irreversible sequelae as time-integrals";
  node [style=filled, fontname="Helvetica", fontsize=10, shape=box];
  edge [fontname="Helvetica", fontsize=8];
  compound=true;
  nodesep=0.22;
  ranksep=0.55;

  /* ============================================================
     1. Somatic driver lesions
     ============================================================ */
  subgraph cluster_driver {
    label="1. 체성 드라이버 변이 (Somatic MAPK Driver Lesions — ~85% of cases)";
    style=filled; color="#d8c4e8"; fillcolor="#f0e8f8";
    BRAF_V600E [label="BRAF V600E\n(~50-60% of LCH)\nclass I, RAS-independent monomer", fillcolor="#e2c4f0"];
    BRAF_indel [label="BRAF in-frame\ndeletions / fusions\n(~5%)"];
    MAP2K1_mut [label="MAP2K1 (MEK1)\nexon 2/3 mutations\n(~15-25%)", fillcolor="#e2c4f0"];
    ARAF_mut [label="ARAF S214\nactivating mutation\n(rare)"];
    MAP3K1_mut [label="MAP3K1 / KRAS /\nNRAS mutations"];
    NRAS_lung [label="NRAS Q61 mutation\n(pulmonary LCH,\nsmoking-associated)"];
    ERBB3_PIK3CA [label="ERBB3 / PIK3CA\nco-alterations"];
    Driver_neg [label="Driver-negative by\nsequencing (~15%)\n(assumed cryptic MAPK)"];
    Clonality [label="Clonal somatic origin\n(neoplasm, not\nreactive proliferation)", fillcolor="#e2c4f0"];
    VAF_lesion [label="Lesional BRAF V600E\nallele fraction\n(10-60% of CD207+ cells)"];
  }

  /* ============================================================
     2. Cell of origin — the partition that sets phenotype
     ============================================================ */
  subgraph cluster_origin {
    label="2. 기원세포 분화단계 (Cell-of-Origin Stage — the misguided-myeloid-DC model)";
    style=filled; color="#c9d9ef"; fillcolor="#eaf1fa";
    HSC_mut [label="Mutant CD34+ HSC /\nmultipotent progenitor\n(bone marrow)", fillcolor="#b8cfe8"];
    CMP_mut [label="Mutant common\nmyeloid progenitor"];
    CDP_mut [label="Mutant common\nDC precursor (CDP)"];
    cDCP_circ [label="Circulating mutant\nCD11c+ / CD1c+\nDC precursor", fillcolor="#b8cfe8"];
    Mono_mut [label="Mutant CD14+\nclassical monocyte"];
    Tissue_precursor [label="Tissue-restricted\nmature precursor\n(local, self-limited)"];
    Epidermal_LC [label="Normal epidermal\nLangerhans cell\n(NOT the origin —\nembryonic, self-renewing)", fillcolor="#dfe8f2"];
    Partition [label="PARTITION OF ONE\nMUTANT POOL\n(θ_marrow : θ_circ : θ_local)\n→ sets disease extent", shape=octagon, fillcolor="#8fb4dc"];
    Origin_early [label="Early (HSC-stage) mutation\n→ multisystem, risk-organ+,\nage <2 y", fillcolor="#f6c9c9"];
    Origin_late [label="Late (committed-precursor)\nmutation → single-system\nbone / skin", fillcolor="#d3ecd3"];
  }

  /* ============================================================
     3. RAS-RAF-MEK-ERK signalling
     ============================================================ */
  subgraph cluster_mapk {
    label="3. MAPK 신호전달 (RAS-RAF-MEK-ERK Cascade & Feedback)";
    style=filled; color="#f2ddc0"; fillcolor="#fcf3e6";
    GF_RTK [label="Growth-factor RTK\n(CSF1R, FLT3, KIT)"];
    RAS_GTP [label="RAS-GTP"];
    BRAF_WT [label="BRAF wild-type\n(dimer-dependent)"];
    CRAF [label="CRAF / RAF1\n(paradox conduit)"];
    RAF_dimer [label="RAF dimerisation\n(14-3-3 scaffold)"];
    MEK12 [label="MEK1 / MEK2\n(MAP2K1/2)", fillcolor="#f0cc95"];
    pERK [label="phospho-ERK1/2\n(central node —\nlesional pERK is\nuniversally positive)", shape=doubleoctagon, fillcolor="#e8a33d"];
    ERK_nuc [label="Nuclear pERK →\nELK1 / FOS / MYC"];
    DUSP6 [label="DUSP6 / SPRY\nnegative feedback"];
    RSK_MNK [label="RSK / MNK1\ntranslational output"];
    CCND1 [label="Cyclin D1 → CDK4/6\n→ Rb-E2F\n(proliferative drive)", fillcolor="#f0cc95"];
    p16 [label="p16INK4a / p21\ncell-cycle arrest"];
    SASP [label="Senescence-like program\n+ SASP secretome\n(BRAF-V600E-induced)", shape=octagon, fillcolor="#e8a33d"];
    BCL2A1 [label="BCL2A1 / MCL-1\n(ERK-dependent survival —\nWHY MAPKi IS CYTOSTATIC)", fillcolor="#f0cc95"];
    BIM_BAD [label="BIM / BAD\nphosphorylation\n(apoptosis blocked)"];
    PI3K_AKT [label="PI3K-AKT-mTOR\ncrosstalk / bypass"];
    ERK_reactiv [label="ERK reactivation\n(adaptive rebound)"];
  }

  /* ============================================================
     4. Pathologic LCH cell identity
     ============================================================ */
  subgraph cluster_identity {
    label="4. 병리적 LCH 세포 표현형 (Pathologic LCH Cell Identity)";
    style=filled; color="#cfe6cf"; fillcolor="#eaf6ea";
    LCH_cell [label="LCH cell\nCD1a+ CD207/Langerin+\nS100+ CD68+/-", shape=doubleoctagon, fillcolor="#8fcf8f"];
    Birbeck [label="Birbeck granules\n(Langerin-driven\nmembrane organelle)"];
    Ecadherin [label="E-cadherin loss →\nlesional dissemination"];
    CCR6_CCR7 [label="CCR6+ / CCR7+\nsimultaneous\n(migration mismatch —\ncannot leave lesion)"];
    JAG2_Notch [label="JAG2-Notch signalling\n(monocyte → LCH-like\ntransdifferentiation)"];
    Immature_phen [label="Immature, poorly\nmigratory DC phenotype"];
    Antigen_fail [label="Impaired antigen\npresentation despite\nhigh MHC-II"];
    EV_release [label="Extracellular vesicle\nE-cadherin / RAF release"];
    Prolif_frac [label="Low proliferative\nfraction (Ki-67 ~5-10%)\n— chemo-resistance driver", fillcolor="#b7dfb7"];
  }

  /* ============================================================
     5. Lesional microenvironment
     ============================================================ */
  subgraph cluster_micro {
    label="5. 병변 미세환경 (Lesional Inflammatory Microenvironment — the granuloma)";
    style=filled; color="#f6d3e2"; fillcolor="#fdeef4";
    Eosinophil [label="Eosinophils\n(hallmark infiltrate)"];
    Tcell_les [label="Lesional CD4+ / CD8+\nT lymphocytes"];
    Treg_les [label="FOXP3+ regulatory\nT cells (expanded,\n~20% of T cells)", fillcolor="#f2bfd7"];
    PD1_PDL1 [label="PD-1 / PD-L1 axis →\nT-cell exhaustion"];
    Macrophage [label="CD163+ CD14+\nmacrophages"];
    MNGC [label="Multinucleated giant cells\n(osteoclast-like,\nDC-STAMP-driven fusion)", fillcolor="#f2bfd7"];
    Neutrophil_les [label="Neutrophils\n(necrotic lesions)"];
    Fibroblast_les [label="Stromal fibroblasts →\nlate lesional fibrosis"];
    Hemophago [label="Hemophagocytosis\n(HLH-overlap in\nrisk-organ disease)"];
    Granuloma [label="LCH granuloma\n(mixed cellular lesion)", shape=octagon, fillcolor="#ec9dc3"];
  }

  /* ============================================================
     6. Secretome
     ============================================================ */
  subgraph cluster_secretome {
    label="6. 사이토카인 · 케모카인 분비체 (ERK-Driven Secretome — the 'cytokine storm' of LCH)";
    style=filled; color="#f7cfc0"; fillcolor="#fdefe8";
    IL1B [label="IL-1β\n(+ IL-1Ra elevation)", fillcolor="#f5b79c"];
    TNFA [label="TNF-α", fillcolor="#f5b79c"];
    IL6 [label="IL-6 →\nhepatic CRP / ESR", fillcolor="#f5b79c"];
    IL17A [label="IL-17A\n(historically claimed;\ncontested — kept as\nswitchable node)"];
    OSM [label="Oncostatin M\n(OSM) — osteolysis\nand fibrosis"];
    GMCSF [label="GM-CSF / CSF1"];
    CCL20 [label="CCL20 / MIP-3α\n(recruits CCR6+ cells)"];
    CCL5_CXCL9 [label="CCL5 / CXCL9 / CXCL10\n(T-cell recruitment)"];
    TGFB [label="TGF-β\n(Treg induction, fibrosis)"];
    VEGFA [label="VEGF-A\n(lesional angiogenesis)"];
    MMP9 [label="MMP-9 / MMP-12\n(matrix + elastin\ndegradation)", fillcolor="#f5b79c"];
    RANKL_node [label="RANKL (TNFSF11)\n↑ / OPG ↓\n→ RANKL:OPG ratio", fillcolor="#f5b79c"];
    OPN [label="Osteopontin\n(lesional, very high)"];
    IL10 [label="IL-10\n(immunoregulatory arm)"];
  }

  /* ============================================================
     7. Bone lesion & remodelling
     ============================================================ */
  subgraph cluster_bone {
    label="7. 골 병변 · 골재형성 (Osteolytic Bone Lesion & Remodelling — 80% of patients)";
    style=filled; color="#dcdcdc"; fillcolor="#f2f2f2";
    OC_precursor [label="Monocytic osteoclast\nprecursor recruitment"];
    RANK [label="RANK on precursor →\nNF-κB / NFATc1"];
    OC_active [label="Activated osteoclast\n(TRAP+, cathepsin K+)", fillcolor="#c8c8c8"];
    CTSK [label="Cathepsin K + MMP-9\n→ collagen I cleavage"];
    Resorption [label="Bone resorption rate"];
    Osteoblast [label="Osteoblast /\nbone formation"];
    Lytic_lesion [label="Osteolytic lesion volume\n(punched-out, skull /\nfemur / vertebra / rib)", shape=octagon, fillcolor="#b0b0b0"];
    Reossify [label="Reossification / healing\n(months, ERK-independent)"];
    Bone_pain [label="Bone pain\n(nociceptor sensitisation\nby IL-1β / NGF / acid)"];
    Fracture [label="Pathologic fracture /\nvertebral collapse\n(vertebra plana)"];
    Site_CNSrisk [label="CRANIOFACIAL CNS-RISK SITE\n(orbit, mastoid, temporal,\nsphenoid, ethmoid, zygoma)", fillcolor="#f6c9c9"];
    Site_spine [label="Spine / weight-bearing\nlong bone (special site)"];
    Otorrhea [label="External ear canal\ninvolvement / otorrhea\n→ conductive hearing loss"];
    Proptosis [label="Orbital mass →\nproptosis"];
  }

  /* ============================================================
     8. Hypothalamic-pituitary axis & central DI
     ============================================================ */
  subgraph cluster_pituitary {
    label="8. 시상하부-뇌하수체 축 · 중추성 요붕증 (Hypothalamic-Pituitary Axis & Central DI — the commonest permanent sequela)";
    style=filled; color="#c9e4ee"; fillcolor="#eaf6fa";
    Stalk_thick [label="Pituitary stalk\nthickening (MRI >3 mm)", fillcolor="#a8d4e6"];
    Post_pit [label="Posterior pituitary\ninfiltration → loss of\nbright spot"];
    AVP_neuron [label="Magnocellular AVP neurons\n(supraoptic / paraventricular)\nIRREVERSIBLE POOL", shape=octagon, fillcolor="#7fc3dc"];
    AVP_secretion [label="AVP (vasopressin)\nsecretory reserve"];
    V2R_AQP2 [label="Renal V2R → cAMP →\nAQP2 apical trafficking"];
    Urine_osm [label="Urine osmolality /\nfree-water clearance"];
    CDI [label="CENTRAL DIABETES INSIPIDUS\n(polyuria, polydipsia,\nhypernatraemia)\n~20-25% cumulative", shape=doubleoctagon, fillcolor="#4fa8cc"];
    Ant_pit [label="Anterior pituitary\nfunction reserve"];
    GH_def [label="GH deficiency →\ngrowth failure\n(~50% of CDI patients)"];
    TSH_ACTH [label="TSH / ACTH /\ngonadotropin deficiency"];
    Panhypopit [label="Panhypopituitarism"];
    Desmopressin [label="Desmopressin (dDAVP)\nreplacement — treats\nsymptom, not the neuron"];
  }

  /* ============================================================
     9. LCH-associated neurodegeneration
     ============================================================ */
  subgraph cluster_nd {
    label="9. LCH 관련 신경변성 (LCH-Associated Neurodegeneration, LCH-ND — late, irreversible, therapy-refractory)";
    style=filled; color="#d5cfe8"; fillcolor="#eeeaf8";
    BRAF_mono_CNS [label="Circulating BRAF V600E+\nmonocytes cross into CNS\n(shared clonal origin\nwith lesions)", fillcolor="#bdb2dc"];
    Microglia [label="Microglial / perivascular\nmacrophage activation"];
    Dentate [label="Cerebellar dentate\nnucleus + white matter\n(T2 hyperintensity)"];
    Pons_BG [label="Pons / basal ganglia\nsignal change"];
    Demyelin [label="Demyelination +\naxonal injury"];
    Purkinje [label="Purkinje cell /\nneuronal pool\nIRREVERSIBLE POOL", shape=octagon, fillcolor="#a294cf"];
    Gliosis [label="Gliosis + cerebellar\natrophy"];
    Ataxia [label="Ataxia · dysarthria ·\ntremor · cognitive decline\n(may appear years later)", shape=doubleoctagon, fillcolor="#8878c0"];
    ND_radiologic [label="Radiologic ND\nprecedes clinical ND\nby years"];
    IVIG [label="IVIG / cytarabine /\nMAPKi for ND\n(stabilise, rarely reverse)"];
  }

  /* ============================================================
     10. Risk organs — liver, spleen, haematopoietic
     ============================================================ */
  subgraph cluster_risk {
    label="10. 위험장기 침범 (Risk-Organ Involvement — haematopoietic, liver, spleen)";
    style=filled; color="#f2c9c9"; fillcolor="#fbeaea";
    Marrow_infilt [label="Bone-marrow infiltration\n→ haematopoietic\ndysfunction", fillcolor="#eaa8a8"];
    Cytopenia [label="Cytopenias\n(Hb <10, plt <100,\nANC <1.5)"];
    Transfusion [label="Transfusion\ndependence"];
    Spleen [label="Splenomegaly →\nsequestration"];
    Liver_infilt [label="Periportal / sinusoidal\nLCH infiltration", fillcolor="#eaa8a8"];
    Cholangiocyte [label="Cholangiocyte injury\n(direct + cytokine)"];
    Sclerosing_chol [label="SCLEROSING CHOLANGITIS\nirreversible biliary\nfibrosis", shape=octagon, fillcolor="#dc8080"];
    Bili_alb [label="↑ Bilirubin, ↑ GGT,\n↓ albumin, ascites"];
    Cirrhosis [label="Biliary cirrhosis →\nliver transplantation"];
    HLH_overlap [label="Secondary HLH /\nMAS overlap\n(ferritin, sCD25)"];
    RO_pos [label="RISK-ORGAN POSITIVE (RO+)\n→ mortality risk", shape=doubleoctagon, fillcolor="#cc5f5f"];
  }

  /* ============================================================
     11. Pulmonary LCH
     ============================================================ */
  subgraph cluster_lung {
    label="11. 폐 LCH (Pulmonary LCH — smoking-driven in adults)";
    style=filled; color="#cfe2e2"; fillcolor="#eaf5f5";
    Smoking [label="Cigarette smoke\n(>90% of adult PLCH)", fillcolor="#a8cccc"];
    Smoke_DC [label="Smoke-induced\nbronchiolar DC\naccumulation (CCL20↑)"];
    Bronch_nodule [label="Peribronchiolar\ncellular nodule"];
    Cavitation [label="Cavitated nodule →\nthick-walled cyst"];
    Cyst [label="Irregular cysts,\nupper/mid-zone\npredominance", fillcolor="#a8cccc"];
    Elastolysis [label="MMP-12-mediated\nelastolysis"];
    Pneumothorax [label="Pneumothorax\n(recurrent)"];
    DLCO [label="↓ DLCO, ↓ FEV1,\nexercise limitation"];
    PH_lung [label="Pulmonary hypertension\n(pre- and post-capillary,\npoor prognosis)"];
    Smoke_cessation [label="Smoking cessation\n— the single most\neffective intervention", fillcolor="#d3ecd3"];
  }

  /* ============================================================
     12. Skin, mucosa and other sites
     ============================================================ */
  subgraph cluster_skin {
    label="12. 피부 · 점막 · 기타 부위 (Skin, Mucosa & Other Sites)";
    style=filled; color="#f2e2c9"; fillcolor="#fbf4ea";
    Skin_seborrh [label="Seborrhoeic scalp /\nflexural eruption"];
    Skin_erosion [label="Intertriginous\nerosive lesions"];
    Congenital_sk [label="Congenital self-healing\nLCH (Hashimoto-Pritzker)", fillcolor="#d3ecd3"];
    Skin_multisys [label="Skin-limited at onset →\n~40% progress to\nmultisystem in infants", fillcolor="#f6c9c9"];
    Oral [label="Gingival / oral mucosa,\n'floating teeth'"];
    LN_thymus [label="Lymph node / thymic\ninvolvement"];
    GI_LCH [label="Gastrointestinal LCH\n(protein-losing\nenteropathy)"];
  }

  /* ============================================================
     13. Clinical classification & risk stratification
     ============================================================ */
  subgraph cluster_class {
    label="13. 임상 분류 · 위험 계층화 (Clinical Classification & Risk Stratification)";
    style=filled; color="#e8e0f0"; fillcolor="#f5f1fa";
    SS_uni [label="SS-b unifocal\n('eosinophilic granuloma')\n— often self-limited", fillcolor="#d3ecd3"];
    SS_multi [label="SS-b multifocal"];
    MS_ROneg [label="MS RO-negative\n(multisystem, no risk organ)"];
    MS_ROpos [label="MS RO-positive\n(liver / spleen / marrow)", fillcolor="#f6c9c9"];
    Special_site [label="Special sites:\nCNS-risk bone, spine\nwith soft-tissue extension"];
    Age_lt2 [label="Age <2 years\n(higher risk)"];
    Wk6_response [label="Week-6 response\n(strongest single\nprognostic factor)", shape=octagon, fillcolor="#c9b8e0"];
    Wk12_response [label="Week-12 response →\nsalvage decision"];
    Reactivation [label="Reactivation\n(~30-50% within 2 y;\nbone / skin most common)", fillcolor="#f6c9c9"];
  }

  /* ============================================================
     14. BRAF inhibitor PK/PD
     ============================================================ */
  subgraph cluster_brafi {
    label="14. BRAF 억제제 PK/PD (Vemurafenib · Dabrafenib)";
    style=filled; color="#c9dcf0"; fillcolor="#eaf2fb";
    VEM_dose [label="Vemurafenib PO\n(20 mg/kg/d paediatric;\n960 mg BID adult)", shape=note, fillcolor="#a8c8e8"];
    VEM_abs [label="Slow, saturable\nabsorption (MBP form)"];
    VEM_C [label="Vemurafenib plasma\n(t½ ~50 h, >99%\nprotein bound)"];
    VEM_P [label="Peripheral tissue\ndistribution"];
    VEM_CYP [label="CYP3A4 metabolism\n+ mild autoinduction"];
    DAB_dose [label="Dabrafenib PO BID\n(2.25-5.25 mg/kg/d)", shape=note, fillcolor="#a8c8e8"];
    DAB_C [label="Dabrafenib plasma\n(t½ ~8 h)"];
    DAB_OH [label="Hydroxy-dabrafenib\n(active metabolite,\nt½ ~10 h)"];
    DAB_CNS [label="Better CNS\npenetration than\nvemurafenib"];
    BRAF_occupancy [label="Mutant-BRAF ATP-site\noccupancy → pERK\ninhibition (need >80%)", fillcolor="#a8c8e8"];
    Paradox [label="PARADOXICAL MAPK ACTIVATION\nin BRAF-WT / RAS-mutant cells\n(CRAF dimer transactivation)", shape=octagon, fillcolor="#f6c9c9"];
  }

  /* ============================================================
     15. MEK inhibitor PK/PD
     ============================================================ */
  subgraph cluster_meki {
    label="15. MEK 억제제 PK/PD (Trametinib · Cobimetinib)";
    style=filled; color="#cfe8dc"; fillcolor="#eaf8f2";
    TRA_dose [label="Trametinib PO OD\n(0.025-0.032 mg/kg/d)", shape=note, fillcolor="#a8dcc4"];
    TRA_C [label="Trametinib plasma\n(t½ ~4-5 days →\nslow steady state)"];
    TRA_P [label="Deep peripheral\ncompartment"];
    COB_dose [label="Cobimetinib PO\n(21/7 schedule)", shape=note, fillcolor="#a8dcc4"];
    COB_C [label="Cobimetinib plasma\n(t½ ~44 h)"];
    MEK_allosteric [label="Allosteric MEK1/2\ninhibition (non-ATP,\nblocks RAF→MEK)", fillcolor="#a8dcc4"];
    MEKi_genotype [label="Active regardless of\nupstream genotype →\ncovers MAP2K1, ARAF,\ndriver-negative"];
    Combo_synergy [label="BRAFi + MEKi:\ndeeper pERK suppression\n+ paradox suppression"];
  }

  /* ============================================================
     16. Cytotoxic and immunomodulatory chemotherapy PK/PD
     ============================================================ */
  subgraph cluster_chemo {
    label="16. 세포독성 · 면역조절 화학요법 PK/PD (Vinblastine · Prednisolone · Cytarabine · Cladribine · Clofarabine)";
    style=filled; color="#f0d8e8"; fillcolor="#fbf0f7";
    VBL_dose [label="Vinblastine 6 mg/m²\nIV weekly", shape=note, fillcolor="#e0b0d0"];
    VBL_C [label="Vinblastine plasma\n(tri-exponential,\nt½z ~25 h)"];
    Tubulin [label="β-tubulin binding →\nmitotic arrest\n(S/M-phase dependent)"];
    PRED_dose [label="Prednisolone\n40 mg/m²/d PO", shape=note, fillcolor="#e0b0d0"];
    PRED_C [label="Prednisolone plasma\n(t½ ~2-3 h,\nnonlinear binding)"];
    GR [label="Glucocorticoid receptor →\nNF-κB transrepression\n+ lymphoid apoptosis", fillcolor="#e0b0d0"];
    ARAC_dose [label="Cytarabine 100-170\nmg/m²/d × 5 (or\nhigh-dose 500-1000)", shape=note, fillcolor="#e0b0d0"];
    ARAC_C [label="Ara-C plasma\n(t½ ~2 h, deaminated\nby cytidine deaminase)"];
    ARACTP [label="Intracellular ara-CTP\n(dCK-activated) →\nDNA chain termination", fillcolor="#e0b0d0"];
    CLAD_dose [label="Cladribine (2-CdA)\n5-9 mg/m²/d × 5", shape=note, fillcolor="#e0b0d0"];
    CLAD_C [label="Cladribine plasma\n(t½ ~10 h)"];
    CdATP [label="Intracellular Cd-ATP →\nDNA strand breaks;\nactive in NON-dividing\nmonocytoid cells", fillcolor="#e0b0d0"];
    CLOF [label="Clofarabine 25 mg/m²\n× 5 (salvage)"];
    MP_MTX [label="6-mercaptopurine +\nmethotrexate\nmaintenance"];
    HSCT [label="Reduced-intensity\nallogeneic HSCT\n(refractory RO+)"];
  }

  /* ============================================================
     17. Drug effect on the cell pools — the cytostatic/cytotoxic split
     ============================================================ */
  subgraph cluster_effect {
    label="17. 약물 효과의 분기 (The Cytostatic / Cytotoxic Split — why response ≠ cure)";
    style=filled; color="#f7e0a8"; fillcolor="#fdf6e0";
    Eff_prolif [label="↓ Proliferation\n(cyclin D1 loss)", fillcolor="#f0d080"];
    Eff_survival [label="↓ Survival signal\n(BCL2A1 loss →\nmodest apoptosis)", fillcolor="#f0d080"];
    Eff_secretome [label="↓ Secretome output\n(ERK-dependent\ntranscription)\n— FASTEST effect (days)", fillcolor="#f0d080"];
    Eff_kill [label="DIRECT CYTOTOXIC KILL\n(chemo only —\nara-CTP / Cd-ATP /\ntubulin / GR apoptosis)", shape=octagon, fillcolor="#e8b040"];
    Reservoir_persist [label="MARROW PRECURSOR RESERVOIR\nPERSISTS under MAPKi\n(cfDNA VAF rarely clears)", shape=octagon, fillcolor="#f6c9c9"];
    Rebound [label="REBOUND ON WITHDRAWAL\n(>75% reactivate within\nweeks-months of stopping)", shape=doubleoctagon, fillcolor="#e07070"];
    Durable_rem [label="Durable off-therapy\nremission (chemo /\nreservoir depletion)", fillcolor="#d3ecd3"];
  }

  /* ============================================================
     18. Toxicity and resistance
     ============================================================ */
  subgraph cluster_tox {
    label="18. 독성 · 내성 (Toxicity & Acquired Resistance)";
    style=filled; color="#f2d0d0"; fillcolor="#fbeded";
    Prolif_marrow [label="Proliferating marrow\nprogenitor pool"];
    Transit [label="Maturation transit\ncompartments (3)"];
    ANC [label="Absolute neutrophil\ncount (Friberg model)", fillcolor="#e8a8a8"];
    Feb_neut [label="Febrile neutropenia /\nsepsis"];
    Rash_photo [label="MAPKi rash,\nphotosensitivity,\nhyperkeratosis", fillcolor="#e8a8a8"];
    cuSCC [label="Keratoacanthoma /\ncutaneous SCC\n(paradox-driven)"];
    Arthralgia_QT [label="Arthralgia, fatigue,\nQT prolongation"];
    LVEF [label="↓ LVEF (MEKi),\nperipheral oedema,\nretinopathy", fillcolor="#e8a8a8"];
    Steroid_tox [label="Steroid toxicity:\ngrowth, bone,\nhyperglycaemia"];
    Neuropathy [label="Vinblastine\nneuropathy, constipation"];
    Res_MAP2K1 [label="Acquired resistance:\nsecondary MAP2K1,\nRAS, CRAF, ERK\nreactivation"];
  }

  /* ============================================================
     19. Biomarkers
     ============================================================ */
  subgraph cluster_biomarker {
    label="19. 바이오마커 · 모니터링 (Biomarkers & Monitoring)";
    style=filled; color="#d0e8f2"; fillcolor="#edf7fb";
    cfDNA [label="Plasma cell-free\nBRAF V600E VAF\n(ddPCR) — tracks\ntotal mutant burden", shape=octagon, fillcolor="#a8d8ec"];
    Circ_cells [label="Circulating BRAF V600E+\nCD11c+ / CD14+ cells\n(marker of high-risk)"];
    sCD163 [label="Soluble CD163\n(macrophage activation)"];
    CRP_ESR [label="CRP / ESR\n(IL-6-driven)"];
    Ferritin_sCD25 [label="Ferritin / sCD25\n(HLH overlap)"];
    LFT [label="Bilirubin / GGT /\nalbumin"];
    PET [label="FDG-PET SUV\n(most sensitive for\nresponse + occult sites)", fillcolor="#a8d8ec"];
    MRI_brain [label="Brain MRI: stalk\nthickness, cerebellar\nT2 signal"];
    Water_dep [label="Water-deprivation test /\nurine osmolality, copeptin"];
    DAS_score [label="Disease Activity Score\n(DAS, Histiocyte Society)", shape=octagon, fillcolor="#a8d8ec"];
  }

  /* ============================================================
     20. Clinical endpoints
     ============================================================ */
  subgraph cluster_endpoint {
    label="20. 임상 엔드포인트 (Clinical Endpoints)";
    style=filled; color="#c9e8c9"; fillcolor="#eaf8ea";
    EP_better [label="Response 'better' /\nNAD at week 6", fillcolor="#a8dca8"];
    EP_worse [label="'Worse' at week 6 →\nsalvage indicated", fillcolor="#eaa8a8"];
    EP_EFS [label="Event-free survival"];
    EP_OS [label="Overall survival\n(RO+ refractory:\nhistorically <30%,\nnow >80% with salvage)", fillcolor="#a8dca8"];
    EP_perm [label="PERMANENT CONSEQUENCES\n(CDI, ND, hearing loss,\northopaedic, growth)\n~30-40% of MS patients", shape=doubleoctagon, fillcolor="#dc8080"];
    EP_QOL [label="Quality of life /\nneurocognitive outcome"];
    EP_pain [label="Pain score /\nanalgesic use"];
    EP_time_to_tx [label="TIME TO EFFECTIVE THERAPY\n— dominates sequelae\nmore than drug potency", shape=octagon, fillcolor="#f0d080"];
  }

  /* ============================================================
     EDGES — driver → origin → signalling
     ============================================================ */
  BRAF_V600E -> pERK [label="constitutive\nmonomer activity", penwidth=2, color="#8b2fa0"];
  BRAF_indel -> pERK;
  MAP2K1_mut -> MEK12 [label="RAF-independent\nactivation", penwidth=2, color="#8b2fa0"];
  ARAF_mut -> RAF_dimer;
  MAP3K1_mut -> MEK12;
  NRAS_lung -> RAS_GTP;
  ERBB3_PIK3CA -> PI3K_AKT;
  Driver_neg -> pERK [style=dashed, label="cryptic"];
  BRAF_V600E -> Clonality;
  MAP2K1_mut -> Clonality;
  Clonality -> VAF_lesion;
  VAF_lesion -> cfDNA [label="shed into plasma"];

  BRAF_V600E -> HSC_mut [label="if mutation arises\nat HSC stage", color="#2f5fa0"];
  BRAF_V600E -> CDP_mut;
  BRAF_V600E -> Tissue_precursor;
  HSC_mut -> CMP_mut -> CDP_mut -> cDCP_circ;
  CDP_mut -> Mono_mut;
  HSC_mut -> Partition [penwidth=2, color="#2f5fa0"];
  CDP_mut -> Partition;
  Tissue_precursor -> Partition;
  Partition -> Origin_early [label="θ_marrow high", penwidth=2];
  Partition -> Origin_late [label="θ_local high", penwidth=2];
  Origin_early -> MS_ROpos [penwidth=2, color="#c04040"];
  Origin_early -> Age_lt2;
  Origin_late -> SS_uni [penwidth=2, color="#40a040"];
  Origin_late -> SS_multi;
  Epidermal_LC -> LCH_cell [style=dashed, label="transcriptionally\nDISTINCT — not\nthe precursor", color="#808080"];
  cDCP_circ -> LCH_cell [penwidth=2, color="#2f5fa0"];
  Mono_mut -> LCH_cell [label="JAG2 /\ntransdifferentiation"];
  HSC_mut -> Marrow_infilt;
  cDCP_circ -> Circ_cells;
  cDCP_circ -> BRAF_mono_CNS [label="CNS trafficking", color="#6a4fa0"];

  GF_RTK -> RAS_GTP -> RAF_dimer;
  RAS_GTP -> CRAF;
  BRAF_WT -> RAF_dimer;
  CRAF -> RAF_dimer -> MEK12 -> pERK [penwidth=2];
  pERK -> ERK_nuc;
  pERK -> DUSP6 [label="feedback"];
  DUSP6 -> pERK [label="dephosphorylation", style=dashed, color="#808080"];
  pERK -> RSK_MNK;
  ERK_nuc -> CCND1 [penwidth=2];
  ERK_nuc -> BCL2A1 [penwidth=2];
  ERK_nuc -> SASP [penwidth=2, color="#c07000"];
  BRAF_V600E -> p16 [label="oncogene-induced"];
  p16 -> SASP;
  SASP -> Prolif_frac [label="explains LOW Ki-67\ndespite active disease", style=dashed];
  BCL2A1 -> BIM_BAD;
  BIM_BAD -> LCH_cell [label="apoptosis\nblocked"];
  CCND1 -> LCH_cell [label="proliferation"];
  PI3K_AKT -> BCL2A1;
  ERK_reactiv -> pERK [style=dashed];
  Res_MAP2K1 -> ERK_reactiv;

  /* identity */
  LCH_cell -> Birbeck;
  LCH_cell -> Ecadherin;
  LCH_cell -> CCR6_CCR7;
  LCH_cell -> Immature_phen -> Antigen_fail;
  JAG2_Notch -> LCH_cell;
  LCH_cell -> EV_release;
  Ecadherin -> Granuloma [label="dissemination\nwithin lesion"];
  CCR6_CCR7 -> Granuloma [label="cannot emigrate →\naccumulation", penwidth=2];
  LCH_cell -> Prolif_frac;
  LCH_cell -> Granuloma [penwidth=2, color="#c04080"];

  /* microenvironment */
  Granuloma -> Eosinophil;
  Granuloma -> Tcell_les -> Treg_les;
  Tcell_les -> PD1_PDL1;
  LCH_cell -> PD1_PDL1 [label="PD-L1"];
  PD1_PDL1 -> Tcell_les [label="exhaustion →\nno clearance", style=dashed];
  Granuloma -> Macrophage -> sCD163;
  Macrophage -> MNGC;
  Granuloma -> Neutrophil_les;
  Granuloma -> Fibroblast_les;
  Macrophage -> Hemophago;
  Hemophago -> HLH_overlap;
  TGFB -> Treg_les;
  Treg_les -> Tcell_les [label="suppress effector\nresponse", style=dashed];

  /* secretome sources */
  SASP -> IL1B [penwidth=2, color="#c07000"];
  SASP -> TNFA [penwidth=2, color="#c07000"];
  SASP -> IL6 [penwidth=2, color="#c07000"];
  SASP -> MMP9;
  SASP -> VEGFA;
  LCH_cell -> IL17A [style=dashed, label="contested"];
  LCH_cell -> OSM;
  LCH_cell -> GMCSF;
  LCH_cell -> CCL20;
  LCH_cell -> RANKL_node [penwidth=2];
  LCH_cell -> OPN;
  Tcell_les -> RANKL_node;
  Macrophage -> IL1B;
  Macrophage -> TNFA;
  Macrophage -> IL10;
  Tcell_les -> CCL5_CXCL9;
  Treg_les -> TGFB;
  CCL20 -> cDCP_circ [label="recruits CCR6+\nprecursors → self-\namplifying loop", penwidth=2, color="#c04040"];
  CCL5_CXCL9 -> Tcell_les;
  IL6 -> CRP_ESR [penwidth=2];
  IL1B -> Bone_pain;
  IL1B -> Granuloma [label="amplification"];
  TNFA -> Granuloma;
  VEGFA -> Granuloma;

  /* bone */
  RANKL_node -> RANK [penwidth=2];
  OSM -> OC_precursor;
  GMCSF -> OC_precursor;
  MNGC -> OC_active;
  OC_precursor -> RANK -> OC_active [penwidth=2];
  IL17A -> MNGC [style=dashed, label="DC fusion\n(contested)"];
  OC_active -> CTSK -> Resorption [penwidth=2];
  MMP9 -> Resorption;
  Resorption -> Lytic_lesion [penwidth=2, color="#606060"];
  Osteoblast -> Reossify;
  Lytic_lesion -> Reossify [label="after LCH cells\nare cleared"];
  Reossify -> Lytic_lesion [label="lesion healing\n(months)", style=dashed, color="#40a040"];
  Lytic_lesion -> Bone_pain [penwidth=2];
  Lytic_lesion -> Fracture;
  Lytic_lesion -> Site_CNSrisk;
  Lytic_lesion -> Site_spine;
  Site_CNSrisk -> Otorrhea;
  Site_CNSrisk -> Proptosis;
  Bone_pain -> EP_pain;
  Fracture -> EP_perm;
  Otorrhea -> EP_perm [label="hearing loss"];
  Granuloma -> Lytic_lesion [penwidth=2];

  /* pituitary */
  Site_CNSrisk -> Stalk_thick [label="contiguous spread\n→ 3-4x CDI risk", penwidth=2, color="#c04040"];
  Granuloma -> Stalk_thick;
  Stalk_thick -> Post_pit -> AVP_neuron;
  IL1B -> AVP_neuron [label="cytokine-mediated\nneuronal injury", style=dashed];
  TNFA -> AVP_neuron [style=dashed];
  AVP_neuron -> AVP_secretion [penwidth=2];
  AVP_secretion -> V2R_AQP2 -> Urine_osm;
  AVP_neuron -> CDI [label="pool < critical\nthreshold →\nirreversible", penwidth=2, color="#c04040"];
  Urine_osm -> CDI;
  Stalk_thick -> Ant_pit;
  Ant_pit -> GH_def;
  Ant_pit -> TSH_ACTH -> Panhypopit;
  GH_def -> Panhypopit;
  CDI -> Desmopressin;
  CDI -> EP_perm [penwidth=2, color="#c04040"];
  GH_def -> EP_perm;
  CDI -> GH_def [label="~50% develop\nanterior deficit"];
  CDI -> Ataxia [label="CDI is the single\nstrongest ND risk factor", style=dashed, color="#6a4fa0"];

  /* neurodegeneration */
  BRAF_mono_CNS -> Microglia [penwidth=2, color="#6a4fa0"];
  Microglia -> Demyelin;
  BRAF_mono_CNS -> Dentate;
  BRAF_mono_CNS -> Pons_BG;
  Dentate -> Demyelin -> Purkinje [penwidth=2];
  Purkinje -> Gliosis -> Ataxia [penwidth=2, color="#6a4fa0"];
  Purkinje -> Ataxia [label="pool < threshold →\nno recovery", penwidth=2, color="#6a4fa0"];
  Dentate -> ND_radiologic -> Ataxia [label="years of lead time", style=dashed];
  IVIG -> Purkinje [label="stabilise", style=dashed, color="#40a040"];
  Ataxia -> EP_perm [penwidth=2, color="#c04040"];
  Ataxia -> EP_QOL;

  /* risk organs */
  Marrow_infilt -> Cytopenia -> Transfusion;
  Marrow_infilt -> RO_pos [penwidth=2];
  Spleen -> Cytopenia;
  Liver_infilt -> Cholangiocyte;
  IL1B -> Cholangiocyte [style=dashed];
  TNFA -> Cholangiocyte [style=dashed];
  Cholangiocyte -> Sclerosing_chol [penwidth=2, color="#c04040"];
  Sclerosing_chol -> Bili_alb -> Cirrhosis;
  Sclerosing_chol -> Cirrhosis [penwidth=2];
  Liver_infilt -> RO_pos [penwidth=2];
  Spleen -> RO_pos;
  Bili_alb -> LFT;
  HLH_overlap -> Ferritin_sCD25;
  HLH_overlap -> RO_pos;
  RO_pos -> MS_ROpos [penwidth=2];
  RO_pos -> EP_OS [label="drives mortality", penwidth=2, color="#c04040"];
  Sclerosing_chol -> EP_perm [penwidth=2];
  Granuloma -> Liver_infilt;
  Granuloma -> Marrow_infilt;
  Granuloma -> Spleen;

  /* lung */
  Smoking -> Smoke_DC [penwidth=2];
  Smoke_DC -> Bronch_nodule;
  Granuloma -> Bronch_nodule;
  NRAS_lung -> Bronch_nodule;
  Bronch_nodule -> Cavitation -> Cyst [penwidth=2];
  MMP9 -> Elastolysis;
  Elastolysis -> Cyst [penwidth=2];
  Cyst -> Pneumothorax;
  Cyst -> DLCO [penwidth=2];
  Cyst -> PH_lung;
  DLCO -> EP_QOL;
  PH_lung -> EP_OS;
  Smoke_cessation -> Smoke_DC [label="removes the\ndriving stimulus", color="#40a040", penwidth=2];
  Cyst -> EP_perm;

  /* skin & other */
  Granuloma -> Skin_seborrh;
  Granuloma -> Skin_erosion;
  Skin_seborrh -> Skin_multisys;
  Tissue_precursor -> Congenital_sk [color="#40a040"];
  Granuloma -> Oral;
  Granuloma -> LN_thymus;
  Granuloma -> GI_LCH;
  Skin_multisys -> MS_ROpos [style=dashed];

  /* classification → endpoints */
  SS_uni -> EP_better [color="#40a040"];
  MS_ROpos -> Wk6_response [penwidth=2];
  MS_ROneg -> Wk6_response;
  Special_site -> Wk6_response;
  Wk6_response -> EP_better;
  Wk6_response -> EP_worse;
  EP_worse -> Wk12_response;
  EP_better -> EP_EFS;
  EP_worse -> EP_OS [color="#c04040"];
  Wk12_response -> Reactivation;
  Reactivation -> EP_EFS [color="#c04040"];
  Reactivation -> EP_perm [label="each reactivation\nadds sequela risk", color="#c04040"];
  Age_lt2 -> Wk6_response;
  DAS_score -> Wk6_response [penwidth=2];

  /* BRAF inhibitor PK/PD */
  VEM_dose -> VEM_abs -> VEM_C;
  VEM_C -> VEM_P [dir=both];
  VEM_C -> VEM_CYP;
  VEM_CYP -> VEM_C [label="autoinduction ↓ Css", style=dashed];
  VEM_C -> BRAF_occupancy [penwidth=2, color="#2f5fa0"];
  DAB_dose -> DAB_C -> DAB_OH;
  DAB_C -> DAB_CNS;
  DAB_OH -> BRAF_occupancy [penwidth=2, color="#2f5fa0"];
  DAB_C -> BRAF_occupancy [penwidth=2];
  DAB_CNS -> BRAF_mono_CNS [label="CNS activity", color="#2f5fa0"];
  BRAF_occupancy -> pERK [label="IC50-driven\ninhibition (need >80%\nfor response)", penwidth=3, color="#2f5fa0", arrowhead=tee];
  VEM_C -> Paradox;
  DAB_C -> Paradox;
  Paradox -> CRAF [penwidth=2, color="#c04040"];
  Paradox -> cuSCC [penwidth=2, color="#c04040"];
  VEM_C -> Rash_photo;
  VEM_C -> Arthralgia_QT;

  /* MEK inhibitor PK/PD */
  TRA_dose -> TRA_C;
  TRA_C -> TRA_P [dir=both];
  COB_dose -> COB_C;
  TRA_C -> MEK_allosteric [penwidth=2, color="#2f8f6f"];
  COB_C -> MEK_allosteric [penwidth=2, color="#2f8f6f"];
  MEK_allosteric -> MEK12 [penwidth=3, color="#2f8f6f", arrowhead=tee];
  MEK_allosteric -> MEKi_genotype;
  MEKi_genotype -> MAP2K1_mut [style=dashed, label="covers non-BRAF\ndrivers"];
  MEKi_genotype -> Driver_neg [style=dashed];
  MEK_allosteric -> Paradox [arrowhead=tee, color="#2f8f6f", label="suppresses"];
  BRAF_occupancy -> Combo_synergy;
  MEK_allosteric -> Combo_synergy;
  Combo_synergy -> pERK [arrowhead=tee, penwidth=2, color="#2f8f6f"];
  TRA_C -> LVEF [color="#c04040"];
  TRA_C -> Rash_photo;
  COB_C -> LVEF;

  /* chemotherapy PK/PD */
  VBL_dose -> VBL_C -> Tubulin;
  PRED_dose -> PRED_C -> GR;
  ARAC_dose -> ARAC_C -> ARACTP;
  CLAD_dose -> CLAD_C -> CdATP;
  CLOF -> CdATP [style=dashed];
  Tubulin -> Eff_kill [penwidth=2, color="#a04080"];
  GR -> Eff_kill [penwidth=2, color="#a04080"];
  GR -> Eff_secretome [label="NF-κB\ntransrepression", color="#a04080"];
  ARACTP -> Eff_kill [penwidth=2, color="#a04080"];
  CdATP -> Eff_kill [penwidth=3, color="#a04080"];
  CdATP -> Reservoir_persist [arrowhead=tee, penwidth=2, color="#a04080", label="depletes the\nmonocytoid reservoir"];
  MP_MTX -> Reactivation [arrowhead=tee, label="maintenance ↓\nreactivation"];
  HSCT -> Reservoir_persist [arrowhead=tee, label="replaces the\nprecursor pool"];

  /* the cytostatic / cytotoxic split */
  pERK -> Eff_prolif [style=invis];
  CCND1 -> Eff_prolif [dir=back, arrowhead=none, style=dashed];
  BRAF_occupancy -> Eff_prolif [color="#c07000"];
  MEK_allosteric -> Eff_prolif [color="#c07000"];
  BRAF_occupancy -> Eff_survival [color="#c07000"];
  MEK_allosteric -> Eff_survival [color="#c07000"];
  BRAF_occupancy -> Eff_secretome [penwidth=2, color="#c07000"];
  MEK_allosteric -> Eff_secretome [penwidth=2, color="#c07000"];
  Eff_secretome -> IL1B [arrowhead=tee, penwidth=2];
  Eff_secretome -> TNFA [arrowhead=tee];
  Eff_secretome -> IL6 [arrowhead=tee];
  Eff_secretome -> RANKL_node [arrowhead=tee];
  Eff_secretome -> DAS_score [arrowhead=tee, label="clinical response\nin DAYS", penwidth=2, color="#c07000"];
  Eff_prolif -> LCH_cell [arrowhead=tee, penwidth=2];
  Eff_survival -> LCH_cell [arrowhead=tee];
  Eff_kill -> LCH_cell [arrowhead=tee, penwidth=3, color="#a04080"];
  Eff_kill -> HSC_mut [arrowhead=tee, penwidth=2, color="#a04080"];
  Eff_prolif -> HSC_mut [arrowhead=tee, style=dashed, label="cytostatic only"];
  Reservoir_persist -> HSC_mut [label="pool preserved"];
  Reservoir_persist -> cfDNA [label="VAF plateau,\nnot clearance", penwidth=2];
  Reservoir_persist -> Rebound [penwidth=3, color="#c04040"];
  Rebound -> Granuloma [label="regrowth at\nprecursor rate", penwidth=2, color="#c04040"];
  Rebound -> Reactivation [penwidth=2, color="#c04040"];
  Durable_rem -> EP_EFS [color="#40a040", penwidth=2];
  Eff_kill -> Durable_rem [color="#40a040"];
  Prolif_frac -> Eff_kill [label="low proliferative\nfraction limits\nS-phase drugs", arrowhead=tee, style=dashed];

  /* toxicity */
  ARACTP -> Prolif_marrow [arrowhead=tee, penwidth=2];
  CdATP -> Prolif_marrow [arrowhead=tee, penwidth=2];
  Tubulin -> Prolif_marrow [arrowhead=tee];
  Prolif_marrow -> Transit -> ANC [penwidth=2];
  ANC -> Prolif_marrow [label="feedback\n(ANC0/ANC)^γ", style=dashed, color="#808080"];
  ANC -> Feb_neut [label="ANC <0.5", color="#c04040"];
  Feb_neut -> EP_OS [color="#c04040"];
  Rash_photo -> EP_QOL;
  cuSCC -> EP_perm;
  LVEF -> EP_QOL;
  PRED_C -> Steroid_tox -> EP_perm;
  VBL_C -> Neuropathy;
  Marrow_infilt -> ANC [label="disease itself\ncauses cytopenia", style=dashed];

  /* biomarkers → endpoints */
  cfDNA -> DAS_score [style=dashed];
  Circ_cells -> RO_pos [style=dashed];
  sCD163 -> DAS_score [style=dashed];
  CRP_ESR -> DAS_score [style=dashed];
  PET -> Wk6_response [penwidth=2];
  MRI_brain -> ND_radiologic [penwidth=2];
  MRI_brain -> Stalk_thick;
  Water_dep -> CDI;
  LFT -> DAS_score;
  Granuloma -> DAS_score [penwidth=2];
  Lytic_lesion -> DAS_score;

  /* time-to-therapy as the sequelae driver */
  EP_time_to_tx -> AVP_neuron [label="longer exposure →\nmore neuron loss", penwidth=3, color="#c07000"];
  EP_time_to_tx -> Purkinje [penwidth=3, color="#c07000"];
  EP_time_to_tx -> Sclerosing_chol [penwidth=2, color="#c07000"];
  EP_time_to_tx -> EP_perm [penwidth=3, color="#c07000"];
  Eff_secretome -> EP_time_to_tx [arrowhead=tee, label="fast MAPKi onset\nshortens exposure", color="#40a040"];
  Eff_kill -> EP_time_to_tx [arrowhead=tee, style=dashed, label="slower onset,\ndeeper nadir"];
  Wk6_response -> EP_time_to_tx [style=dashed];
}
