  /* ===================== 18. CLINICAL ENDPOINTS ========================= */
  subgraph cluster_end {
    label = "18. Endpoints — and why % TG change is the wrong one";
    style = "filled,rounded"; color = "#b39ddb"; fillcolor = "#ede7f6"; fontsize = 12;
    node [fillcolor = "#b39ddb", color = "#5e35b1"];

    K_TG3     [label = "Primary: % change fasting TG\nat month 3 / 6 (regulatory convention)"];
    K_BELOW   [label = "% of patients reaching TG < 880 mg/dL\n(the mechanistically meaningful one)", fillcolor="#9575cd", color="#4527a0"];
    K_TAT     [label = "TIME-ABOVE-THRESHOLD\ndays/year with TG > 880 mg/dL\n(model output TAT880)", fillcolor="#9575cd", color="#4527a0", penwidth=2];
    K_AUC     [label = "Cumulative TG exposure AUC\nand postprandial peak TG"];
    K_AP      [label = "AP event rate (events/patient-year)\nthe endpoint patients actually care about", fillcolor="#9575cd", color="#4527a0"];
    K_APOC3   [label = "Plasma apoC-III % change\n(target engagement, not benefit)"];
    K_ABDPAIN [label = "Abdominal pain days · PRO diaries"];
    K_XANTH2  [label = "Xanthoma clearance"];
    K_QOL2    [label = "FCS-IMPACT / EQ-5D"];
    K_CONVEX  [label = "BECAUSE hazard is convex in TG,\nΔ(AP rate) > Δ(mean TG).\n43% TG ↓ can buy ~88% AP ↓", fillcolor="#7e57c2", fontcolor="white", color="#311b92", penwidth=2];

    K_TG3 -> K_CONVEX [style=dashed]; K_TAT -> K_CONVEX; K_BELOW -> K_CONVEX;
    K_CONVEX -> K_AP;
    K_AUC -> K_TAT;
