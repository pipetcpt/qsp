    V_ISR     [label = "Injection-site reactions ~61–82%\nleading cause of discontinuation"];
    V_REG     [label = "EMA conditional approval (Waylivra, 2019)\nFDA CRL — benefit/risk on platelets", fillcolor="#b0bec5"];

    V_DOSE -> V_DEPOT -> V_PLASMA -> V_UPTAKE -> V_LIVER -> V_RNASE -> V_PD -> V_AP;
    V_UPTAKE -> V_PLT [color="#d84315"];
