  /* ===================== 19. DIAGNOSIS & SCORING ======================== */
  subgraph cluster_dx {
    label = "19. Diagnosis — separating FCS from the 100× commoner MCS";
    style = "filled,rounded"; color = "#c5e1a5"; fillcolor = "#f1f8e9"; fontsize = 12;
    node [fillcolor = "#c5e1a5", color = "#689f38"];

    Q_SCORE   [label = "FCS Score (Moulin 2018) ≥10/17\nsens 88% · spec 85%"];
    Q_ITEMS   [label = "Score items: fasting TG >885 mg/dL always ·\nno secondary cause · TG unresponsive to\nfibrate/statin · onset <40 y · prior AP"];
    Q_GENE    [label = "Genetic panel: LPL·APOC2·APOA5·\nGPIHBP1·LMF1 (biallelic)"];
    Q_LPLACT  [label = "Post-heparin LPL activity <5%\n(gold standard, few labs)"];
    Q_UNMET   [label = "Median diagnostic delay ~10–20 y\nmisdiagnosed as alcoholic/biliary AP"];
    Q_PREV    [label = "Prevalence 1–10 per million\n(founder effects: Québec Saguenay,\nAfrikaner, Amish)"];
    Q_MISS    [label = "Diagnostic trap: amylase can be\nFALSELY NORMAL in HTG-AP\n(inhibitor in lipaemic serum)", fillcolor="#ffe0b2", color="#f57c00"];

    Q_ITEMS -> Q_SCORE -> Q_GENE -> Q_LPLACT;
    Q_UNMET -> Q_PREV [style=invis];
    Q_MISS -> Q_UNMET;
