  /* genotype → machinery */
  G_LPL     -> L_TRANS    [lhead=cluster_lpl, color="#5c6bc0", label="no functional enzyme"];
  G_LMF1    -> L_ER       [color="#5c6bc0", arrowhead=tee];
  G_GPIHBP1 -> L_GPIHBP1  [color="#5c6bc0", arrowhead=tee];
