    X_EVIRES  [label = "In LPL-null FCS: modest/inconsistent TG ↓\nIn PARTIAL LPL deficiency & MCS: clear ↓\nEXACTLY the structural prediction", fillcolor="#bcaaa4", color="#4e342e", penwidth=2];
