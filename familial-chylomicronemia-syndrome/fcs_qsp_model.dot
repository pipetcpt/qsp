  M_OB    -> H_FFA    [color="#f57c00"];
  M_HYPOTH-> L_TRANS  [color="#f57c00", arrowhead=tee];
  M_CKD   -> C3_PROT  [color="#f57c00"];
  M_DRUG  -> H_VLDL   [color="#f57c00"];
  M_CARB  -> H_DNL    [color="#f57c00"];
  M_FAST  -> D_FAT    [color="#43a047", arrowhead=tee];

  /* diet → enterocyte → plasma */
  D_NPC1L1 -> E_MGAT   [color="#7cb342"];
  D_TARGET -> D_FAT    [arrowhead=tee, color="#2e7d32", label="the only\neffective\nnon-drug lever"];
  D_ADHERE -> D_FAT    [color="#e64a19", label="binge → input spike"];
  D_OMEGA  -> H_VLDL   [arrowhead=tee, color="#7cb342"];
  D_MCT    -> H_FFA    [color="#7cb342", label="portal FFA,\nno CM formed"];
  E_CM     -> P_CMTG   [color="#0277bd", penwidth=1.6];

  /* the two limbs acting on the plasma pool */
  P_CMTG -> L_LUMEN  [color="#d81b60", label="LIMB 1 substrate"];
  L_CAT  -> P_CMTG   [arrowhead=tee, color="#d81b60", penwidth=1.6, label="hydrolysis\n(absent in FCS)"];
  L_ZERO -> P_KNEE   [color="#b71c1c", penwidth=1.8, label="input forced\ninto limb 2"];
  P_CMTG -> I_REM    [color="#7e57c2", label="LIMB 2 substrate"];
  I_SATUR-> P_CMTG   [arrowhead=tee, color="#7e57c2", penwidth=1.6, label="saturable removal"];
  P_VLDLTG -> I_REM  [color="#7e57c2", style=dashed];
  H_VLDL   -> P_VLDLTG [color="#ef6c00", penwidth=1.4];

  /* apoC-III wiring */
  C3_E1 -> L_ACTIV  [arrowhead=tee, color="#e53935"];
  C3_E2 -> I_APOC3B [color="#e53935", penwidth=1.5];
  C3_E3 -> H_VLDL   [color="#e53935"];
  C3_PROT -> E_APOCIII [color="#e53935", style=dashed];
  C3_INS  -> M_DM   [style=dashed];

  /* FFA / tissue */
  L_CAT -> P_FFAP   [style=dashed, color="#d81b60"];
  P_FFAP -> H_FFA   [color="#ffa000"];

  /* plasma → pancreas */
  P_CMTG  -> A_CAP    [color="#d84315", penwidth=1.6];
  P_TOTTG -> A_THRESH [color="#d84315", penwidth=1.6];
  P_VISC  -> A_ISCH   [color="#d84315"];
  P_PPEXC -> A_THRESH [color="#d84315", style=dashed, label="the peaks, not\nthe mean"];
  P_FFAP  -> A_UFFA   [color="#d84315", style=dashed];
  A_DM3C  -> M_DM     [color="#d84315", style=dashed, label="vicious loop"];
  A_EPI   -> D_LIPASE [arrowhead=tee, style=dashed];

  /* plasma → other organs */
  P_TOTTG -> N_XANTH  [color="#afb42b"];
  P_TOTTG -> N_LIPRET [color="#afb42b"];
  P_TOTTG -> N_HSM    [color="#afb42b"];
  P_VISC  -> N_FOG    [color="#afb42b"];
  P_TOTTG -> N_ABD    [color="#afb42b"];
  A_RECUR -> N_ANX    [color="#afb42b"];
