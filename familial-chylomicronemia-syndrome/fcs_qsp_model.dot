/* ===========================================================================
   Familial Chylomicronemia Syndrome (FCS) — QSP Mechanistic Map
   ---------------------------------------------------------------------------
   Organising idea:  Plasma triglyceride in FCS is not set by a rate, it is set
   by a SATURATED CAPACITY.  Triglyceride-rich lipoprotein (TRL) clearance is
   the SUM of two structurally different limbs:

        CL_total  =  CL_LPL( LPL activity )      <-- first-order, huge capacity
                   + CL_indep( apoC-III, RES )   <-- saturable, tiny Vmax

   In healthy plasma the first limb carries >95% of the flux and the second is
   invisible.  In FCS the first limb is multiplied by a genotype factor that is
   ZERO (biallelic LOF in LPL, APOC2, APOA5, GPIHBP1 or LMF1), so the entire
   dietary fat flux is forced through a Michaelis–Menten route whose Vmax is
   of the order of the daily fat load itself.  Three consequences are drawn
   explicitly on this map and are the whole reason the map exists:

     (1) Steady-state TG becomes a HYPERBOLA in dietary fat, not a line.  Below
         the knee TG is nearly normal; a few grams of fat above it and TG runs
         away to 3000–10000 mg/dL.  That is why "<20 g fat/day" behaves like a
         cliff edge and not like a dose-response.
     (2) Every drug that works by RAISING LPL — fibrates (PPARa -> LPL
         transcription), omega-3, niacin, insulin — multiplies a limb that is
         already zero.  Zero times anything is zero.  This is a structural
         prediction, not an empirical disappointment.
     (3) Every drug that works in FCS acts on the OTHER limb: apoC-III
         knockdown (volanesorsen, olezarsen, plozasiran) raises the Vmax of
         the LPL-INDEPENDENT hepatic route, because apoC-III blocks
         LDLR/LRP1/HSPG remnant uptake by a mechanism that never needed LPL.
         That is why an antisense drug lowers TG by 70-80% in a patient with
         literally undetectable lipase.

   The clinical endpoint is drawn the same way.  Acute pancreatitis hazard is
   not linear in TG: it is a threshold-convex function of TIME SPENT ABOVE
   ~880 mg/dL (10 mmol/L), integrated over postprandial excursions.  A therapy
   is therefore scored by how much of the upper tail of the TG distribution it
   deletes, not by its mean percent change — which is why observed pancreatitis
   reductions (83-88%) exceed what the percent-TG number naively predicts.

   Render:
     dot -Tsvg fcs_qsp_model.dot -o fcs_qsp_model.svg
     dot -Tpng -Gdpi=150 fcs_qsp_model.dot -o fcs_qsp_model.png
   =========================================================================== */

digraph FCS_QSP {
  graph [ rankdir      = LR,
          splines      = spline,
          nodesep      = 0.24,
          ranksep      = 0.72,
          fontname     = "Helvetica",
          fontsize     = 11,
          compound     = true,
          newrank      = true,
          bgcolor      = "white",
          label        = "Familial Chylomicronemia Syndrome (FCS) — Integrated QSP Mechanistic Map\l21 clusters · 222 nodes · 290 edges · one saturated clearance capacity: CL_total = CL_LPL(genotype ~ 0) + CL_independent(apoC-III, saturable)\lQSP Disease Model Library — research/education only\l",
          labelloc     = "t",
          fontcolor    = "#1a1a2e" ];

  node [ shape = box, style = "rounded,filled", fontname = "Helvetica",
         fontsize = 9, penwidth = 0.8, margin = "0.07,0.04" ];
  edge [ fontname = "Helvetica", fontsize = 7.5, penwidth = 0.9,
         arrowsize = 0.6, color = "#4a4a5a" ];

  /* ===================== 1. GENETIC ARCHITECTURE ======================== */
  subgraph cluster_gene {
    label = "1. Genetic architecture — five genes, one enzyme complex, one phenotype";
    style = "filled,rounded"; color = "#c5cae9"; fillcolor = "#e8eaf6"; fontsize = 12;
    node [fillcolor = "#c5cae9", color = "#5c6bc0"];

    G_LPL     [label = "LPL (8p21.3)\nbiallelic LOF · 60–80% of FCS\n>200 pathogenic variants"];
    G_APOC2   [label = "APOC2 (19q13.32)\nloss of the obligate LPL activator\n~5% of FCS"];
    G_APOA5   [label = "APOA5 (11q23.3)\nbiallelic LOF · ~5%\nTRL–LPL–GPIHBP1 tethering lost"];
    G_GPIHBP1 [label = "GPIHBP1 (8q24.3)\n~10–15% · LPL cannot be moved\nto the capillary lumen"];
    G_LMF1    [label = "LMF1 (16p13.3)\nrare · ER chaperone for LPL\nfolding/dimerisation"];
    G_CREB3L3 [label = "CREB3L3 · GPD1 (rare)\nhepatic TG-clearance TFs"];
    G_BIALL   [label = "BIALLELIC state required\nhomozygous · compound het\n(pseudo-recessive)", fillcolor="#9fa8da"];
    G_HET     [label = "Heterozygous carriers\nTG 150–400 mg/dL\nNOT FCS"];
    G_AUTOAB  [label = "Acquired FCS\nautoantibody vs LPL or GPIHBP1\n(SLE, Sjögren) — phenocopy"];
    G_MCS     [label = "Multifactorial chylomicronemia (MCS)\npolygenic TG score + secondary factor\n(>90% of TG>1000 seen in clinic)", fillcolor="#ffe0b2", color="#fb8c00"];
    G_APOC3LOF[label = "APOC3 LOF carriers (natural experiment)\nTG −39% · CHD −40%\n(Lancaster Amish R19X)", fillcolor="#c8e6c9", color="#43a047"];
    G_ANGPTL3L[label = "ANGPTL3 LOF (FHBL2)\ncombined hypolipidaemia\nno cardiovascular penalty", fillcolor="#c8e6c9", color="#43a047"];
    G_PENETR  [label = "Genotype→phenotype:\nresidual post-heparin LPL activity\nis the ONE quantitative modifier", fillcolor="#9fa8da"];

    G_LPL -> G_BIALL; G_APOC2 -> G_BIALL; G_APOA5 -> G_BIALL;
    G_GPIHBP1 -> G_BIALL; G_LMF1 -> G_BIALL; G_CREB3L3 -> G_BIALL;
    G_BIALL -> G_PENETR;
    G_LPL -> G_HET [style=dashed];
    G_AUTOAB -> G_PENETR [style=dashed];
  }

  /* ===================== 2. SECONDARY / MODIFYING FACTORS =============== */
  subgraph cluster_mod {
    label = "2. Secondary amplifiers — what pushes a partial genotype over the knee";
    style = "filled,rounded"; color = "#ffe0b2"; fillcolor = "#fff8e1"; fontsize = 12;
    node [fillcolor = "#ffe0b2", color = "#fb8c00"];

    M_ALC     [label = "Alcohol\n↑hepatic VLDL-TG secretion\n↓FA oxidation"];
    M_EST     [label = "Oestrogen (oral) · pregnancy\n↑VLDL secretion · ↓LPL\n3rd-trimester TG surge 2–4×"];
    M_PREG    [label = "Pregnancy in FCS\nTG can exceed 10 000 mg/dL\npancreatitis risk peak wk 28–36", fillcolor="#ffab91", color="#e64a19"];
    M_DM      [label = "Uncontrolled diabetes\ninsulinopenia → LPL transcription↓\n(a 3rd hit on the LPL limb)"];
    M_OB      [label = "Obesity · insulin resistance\n↑FFA flux · ↑VLDL"];
    M_HYPOTH  [label = "Hypothyroidism\n↓LPL · ↓LDLR"];
    M_CKD     [label = "Nephrotic syndrome · CKD\n↓lipolysis · ↑apoC-III"];
    M_DRUG    [label = "Drugs: tamoxifen · isotretinoin\npropofol · L-asparaginase\nclozapine/olanzapine · protease inhibitors"];
    M_CARB    [label = "Refined carbohydrate · fructose\n→ChREBP/SREBP-1c → DNL"];
    M_FAST    [label = "Acute fasting / plasmapheresis\nremoves the input term entirely", fillcolor="#c8e6c9", color="#43a047"];

    M_ALC -> M_PREG [style=invis];
    M_EST -> M_PREG;
  }

  /* ===================== 3. DIETARY FAT INPUT =========================== */
  subgraph cluster_diet {
    label = "3. Dietary fat — the input term (the only term the patient controls)";
    style = "filled,rounded"; color = "#dcedc8"; fillcolor = "#f1f8e9"; fontsize = 12;
    node [fillcolor = "#dcedc8", color = "#7cb342"];

    D_FAT     [label = "Dietary long-chain triglyceride (LCT)\ng per meal — model input FAT_GUT"];
    D_LIPASE  [label = "Gastric + pancreatic lipase\ncolipase · bile salt micelles"];
    D_2MAG    [label = "2-monoacylglycerol + free fatty acid\nmicellar solubilisation"];
    D_NPC1L1  [label = "Enterocyte uptake\nCD36 · FATP4 · NPC1L1 (sterols)"];
    D_MCT     [label = "Medium-chain triglyceride (MCT)\nC8–C12 → PORTAL vein, albumin-bound\nBYPASSES chylomicron assembly", fillcolor="#c8e6c9", color="#43a047"];
    D_OMEGA   [label = "Marine ω-3 (EPA/DHA)\n↓hepatic VLDL-TG secretion\n(input-side, not clearance-side)"];
    D_TARGET  [label = "FCS diet prescription\n<20 g LCT/day (~15% energy)\n+ MCT + fat-soluble vitamins", fillcolor="#a5d6a7", color="#2e7d32"];
    D_ADHERE  [label = "Adherence decay\nreal-world 30–60%\nsocial/holiday fat binges", fillcolor="#ffccbc", color="#e64a19"];
    D_BURDEN  [label = "Diet burden\nfood anxiety · social isolation\n(FCS-Symptom/IMPACT PROs)"];

    D_FAT -> D_LIPASE -> D_2MAG -> D_NPC1L1;
    D_MCT -> D_TARGET [style=dashed, label="fat calories\nwithout CM"];
    D_TARGET -> D_ADHERE -> D_BURDEN;
  }

  /* ===================== 4. ENTEROCYTE / CHYLOMICRON ASSEMBLY =========== */
  subgraph cluster_ent {
    label = "4. Enterocyte — chylomicron assembly and lymphatic delivery";
    style = "filled,rounded"; color = "#b3e5fc"; fillcolor = "#e1f5fe"; fontsize = 12;
    node [fillcolor = "#b3e5fc", color = "#039be5"];

    E_MGAT    [label = "MGAT2 → DGAT1\nTG re-esterification in smooth ER"];
    E_APOB48  [label = "apoB48 (APOBEC1-edited)\none per particle → apoB48 = particle count"];
    E_MTP     [label = "MTP (MTTP)\nlipidation of nascent apoB48"];
    E_PRECM   [label = "Pre-chylomicron\n+ apoA-I · apoA-IV · apoA-V"];
    E_PCTV    [label = "PCTV / Sar1b (SAR1B)\nER→Golgi transport vesicle"];
    E_SECR    [label = "Basolateral secretion\ninto lacteal"];
    E_LYMPH   [label = "Mesenteric lymph → thoracic duct\ntransit delay 1–3 h (model LYMPH)"];
    E_CM      [label = "NASCENT CHYLOMICRON\nd < 0.95 g/mL · 75–1200 nm\n~90% TG by mass", fillcolor="#81d4fa", color="#0277bd"];
    E_APOCII  [label = "apoC-II acquired from HDL\nobligate LPL activator"];
    E_APOCIII [label = "apoC-III acquired from HDL\nLPL inhibitor + uptake inhibitor", fillcolor="#ffcdd2", color="#e53935"];
    E_APOE    [label = "apoE acquired from HDL\nligand for LDLR/LRP1"];

    E_MGAT -> E_MTP; E_APOB48 -> E_MTP; E_MTP -> E_PRECM -> E_PCTV -> E_SECR -> E_LYMPH -> E_CM;
    E_APOCII -> E_CM; E_APOCIII -> E_CM; E_APOE -> E_CM;
  }

  /* ===================== 5. LPL MACHINERY (LIMB 1) ====================== */
  subgraph cluster_lpl {
    label = "5. LPL machinery — LIMB 1 of clearance (multiplied by genotype ≈ 0 in FCS)";
    style = "filled,rounded"; color = "#f8bbd0"; fillcolor = "#fce4ec"; fontsize = 12;
    node [fillcolor = "#f8bbd0", color = "#d81b60"];

    L_TRANS   [label = "LPL transcription\nadipocyte · myocyte · cardiomyocyte\n(insulin ↑adipose · fasting ↑muscle)"];
    L_ER      [label = "ER folding — LMF1 chaperone\nhomodimer assembly (head-to-tail)"];
    L_SECR    [label = "Secretion to subendothelial HSPG"];
    L_GPIHBP1 [label = "GPIHBP1 (LU domain + acidic tract)\ncapillary endothelial transcytosis\nabluminal → LUMINAL"];
    L_LUMEN   [label = "LUMINAL LPL–GPIHBP1 complex\nthe only catalytically relevant pool", fillcolor="#f48fb1", color="#ad1457"];
    L_ACTIV   [label = "apoC-II activation\n(lid displacement, ~50-fold kcat)"];
    L_APOA5   [label = "apoA-V\ntethers TRL to GPIHBP1/HSPG\n↑residence time"];
    L_CAT     [label = "TG hydrolysis\nsn-1/sn-3 ester bonds\n→ 2-MAG + 2 FFA"];
    L_ANG3    [label = "ANGPTL3 (hepatic, endocrine)\nunfolds the LPL hydrolase domain", fillcolor="#ffcdd2", color="#e53935"];
    L_ANG4    [label = "ANGPTL4 (local, fasting-induced)\nirreversible LPL unfolding", fillcolor="#ffcdd2", color="#e53935"];
    L_ANG8    [label = "ANGPTL8 (feeding-induced)\nANGPTL3/8 complex = 100× inhibitor\nANGPTL4/8 = de-inhibitor", fillcolor="#ffcdd2", color="#e53935"];
    L_APOC3I  [label = "apoC-III\ndisplaces apoC-II · ↓LPL kcat", fillcolor="#ffcdd2", color="#e53935"];
    L_APOC1   [label = "apoC-I\nweak LPL inhibitor · blocks apoE binding"];
    L_HSPG    [label = "Endothelial HSPG (syndecan-1)\nTRL margination platform"];
    L_TURN    [label = "LPL inactivation & turnover\nmonomerisation → hepatic clearance\nt½ minutes-hours"];
    L_HEPARIN [label = "Post-heparin LPL activity assay\nDIAGNOSTIC: <5% of normal = FCS", fillcolor="#f48fb1", color="#ad1457"];
    L_ZERO    [label = "FCS: LUMINAL LPL ACTIVITY ≈ 0\n⇒ LIMB 1 CONTRIBUTES NOTHING\nno drug that scales LPL can help", fillcolor="#b71c1c", fontcolor="white", color="#7f0000", penwidth=2];

    L_TRANS -> L_ER -> L_SECR -> L_GPIHBP1 -> L_LUMEN -> L_CAT;
    L_ACTIV -> L_CAT; L_APOA5 -> L_LUMEN; L_HSPG -> L_LUMEN;
    L_ANG3 -> L_LUMEN [color="#e53935", arrowhead=tee];
    L_ANG4 -> L_LUMEN [color="#e53935", arrowhead=tee];
    L_ANG8 -> L_ANG3 [label="×100 potency"];
    L_APOC3I -> L_ACTIV [color="#e53935", arrowhead=tee];
    L_APOC1 -> L_LUMEN [color="#e53935", arrowhead=tee, style=dashed];
    L_LUMEN -> L_TURN [style=dashed];
    L_LUMEN -> L_HEPARIN [style=dotted];
    L_CAT -> L_ZERO [style=invis];
  }

  /* ===================== 6. LPL-INDEPENDENT CLEARANCE (LIMB 2) ========== */
  subgraph cluster_indep {
    label = "6. LPL-INDEPENDENT clearance — LIMB 2, saturable, the only route left in FCS";
    style = "filled,rounded"; color = "#d1c4e9"; fillcolor = "#ede7f6"; fontsize = 12;
    node [fillcolor = "#d1c4e9", color = "#7e57c2"];

    I_REM     [label = "TRL / chylomicron remnant\napoE-enriched, apoC-III-shielded"];
    I_LDLR    [label = "Hepatocyte LDL receptor\napoE-mediated remnant uptake"];
    I_LRP1    [label = "LRP1\nsecond apoE receptor, HSPG-assisted"];
    I_SDC1    [label = "Syndecan-1 HSPG\nsinusoidal remnant capture"];
    I_HL      [label = "Hepatic lipase (LIPC)\nremnant TG hydrolysis, LPL-independent"];
    I_EL      [label = "Endothelial lipase (LIPG)\nmainly phospholipase"];
    I_RES     [label = "Reticuloendothelial system\nKupffer cells · splenic macrophages\nnon-receptor scavenging of large CM", fillcolor="#b39ddb", color="#5e35b1"];
    I_SATUR   [label = "SATURABLE KINETICS\nVmax_indep ≈ 1× daily fat load\nKm ≈ 800–1200 mg/dL", fillcolor="#9575cd", color="#4527a0", penwidth=2];
    I_APOC3B  [label = "apoC-III blocks BOTH:\n(i) apoE–receptor docking\n(ii) HSPG binding", fillcolor="#ffcdd2", color="#e53935"];
    I_SIZE    [label = "Particle SIZE constraint\nCM > 70 nm cannot cross the\nfenestrated sinusoid efficiently"];
    I_KEY     [label = "KEY: knocking down apoC-III raises\nVmax of THIS limb — no LPL needed.\nMechanistic basis of ASO/siRNA efficacy", fillcolor="#c8e6c9", color="#2e7d32", penwidth=2];

    I_REM -> I_LDLR; I_REM -> I_LRP1; I_REM -> I_SDC1; I_REM -> I_RES;
    I_LDLR -> I_SATUR; I_LRP1 -> I_SATUR; I_SDC1 -> I_SATUR; I_RES -> I_SATUR;
    I_HL -> I_REM [style=dashed]; I_EL -> I_REM [style=dashed];
    I_APOC3B -> I_LDLR [color="#e53935", arrowhead=tee];
    I_APOC3B -> I_SDC1 [color="#e53935", arrowhead=tee];
    I_SIZE -> I_SATUR [style=dashed];
    I_SATUR -> I_KEY [style=dotted];
  }

  /* ===================== 7. APOC3 BIOLOGY =============================== */
  subgraph cluster_apoc3 {
    label = "7. apoC-III — the druggable node that sits on BOTH limbs";
    style = "filled,rounded"; color = "#ffcdd2"; fillcolor = "#ffebee"; fontsize = 12;
    node [fillcolor = "#ffcdd2", color = "#e53935"];

    C3_GENE   [label = "APOC3 (11q23.3)\nAPOA1/APOC3/APOA4/APOA5 cluster"];
    C3_HNF4   [label = "HNF-4α · RXR · FoxO1\ntranscriptional drive"];
    C3_INS    [label = "Insulin → FoxO1 exclusion\n→ APOC3 transcription ↓\n(lost in insulin resistance)"];
    C3_GLU    [label = "Glucose → ChREBP\n→ APOC3 ↑"];
    C3_MRNA   [label = "Hepatic APOC3 mRNA\n(model state APOC3_mRNA)", fillcolor="#ef9a9a"];
    C3_PROT   [label = "Plasma apoC-III\n8–15 mg/dL normal · 20–40 in FCS", fillcolor="#ef9a9a", color="#c62828"];
    C3_E1     [label = "Effect 1: inhibits LPL\n(irrelevant when LPL = 0)"];
    C3_E2     [label = "Effect 2: inhibits hepatic\nremnant uptake (LDLR/LRP1/HSPG)", fillcolor="#ef9a9a"];
    C3_E3     [label = "Effect 3: ↑ hepatic VLDL\nassembly & secretion"];
    C3_E4     [label = "Effect 4: pro-inflammatory\nmonocyte-endothelium adhesion (NF-κB)"];
    C3_INTEST [label = "Intestinal APOC3 expression\n(second, smaller source)"];
    C3_POOL   [label = "apoC-III distribution\nHDL-bound ↔ TRL-bound exchangeable pool"];

    C3_GENE -> C3_MRNA; C3_HNF4 -> C3_GENE; C3_GLU -> C3_GENE;
    C3_INS -> C3_GENE [arrowhead=tee];
    C3_MRNA -> C3_PROT -> C3_POOL;
    C3_PROT -> C3_E1; C3_PROT -> C3_E2; C3_PROT -> C3_E3; C3_PROT -> C3_E4;
    C3_INTEST -> C3_PROT [style=dashed];
  }

  /* ===================== 8. HEPATIC VLDL AXIS =========================== */
  subgraph cluster_liver {
    label = "8. Hepatic VLDL axis — the competing input the diet does not control";
    style = "filled,rounded"; color = "#ffe0b2"; fillcolor = "#fff3e0"; fontsize = 12;
    node [fillcolor = "#ffe0b2", color = "#f57c00"];

    H_FFA     [label = "Portal + systemic FFA influx"];
    H_DNL     [label = "De novo lipogenesis\nSREBP-1c · ChREBP · ACC · FASN · SCD1"];
    H_TGPOOL  [label = "Hepatic cytosolic TG pool\n(model LIVER_TG)"];
    H_APOB100 [label = "apoB100 co-translational lipidation\nMTP-dependent"];
    H_VLDL    [label = "VLDL1 / VLDL2 secretion\n(model VLDL_TG)", fillcolor="#ffcc80", color="#ef6c00"];
    H_PPARA   [label = "PPARα → FA β-oxidation\n(fibrate target)"];
    H_STEAT   [label = "Hepatic steatosis · hepatomegaly\ncommon in FCS, usually bland"];
    H_ALT     [label = "ALT/AST elevation\n(also an ASO class safety signal)"];
    H_CETP    [label = "CETP: TG→HDL/LDL exchange\nTG-rich HDL → HL → rapid catabolism"];
    H_HDLLOW  [label = "HDL-C very low (<25 mg/dL)\nLDL-C low/normal — NOT protective,\njust a mass-balance artefact"];
    H_APOB48  [label = "apoB48 measurement\ndistinguishes CM from VLDL burden"];

    H_FFA -> H_TGPOOL; H_DNL -> H_TGPOOL; H_TGPOOL -> H_APOB100 -> H_VLDL;
    H_PPARA -> H_TGPOOL [arrowhead=tee];
    H_TGPOOL -> H_STEAT -> H_ALT;
    H_VLDL -> H_CETP -> H_HDLLOW;
  }

  /* ===================== 9. PLASMA LIPID STATE ========================== */
  subgraph cluster_plasma {
    label = "9. Plasma compartment — the saturated state variable";
    style = "filled,rounded"; color = "#ffecb3"; fillcolor = "#fffde7"; fontsize = 12;
    node [fillcolor = "#ffecb3", color = "#ffa000"];

    P_CMTG    [label = "PLASMA CHYLOMICRON-TG\n(model CM_TG) — dominant species in FCS", fillcolor="#ffe082", color="#ff8f00", penwidth=2];
    P_VLDLTG  [label = "Plasma VLDL-TG (model VLDL_TG)"];
    P_REMTG   [label = "Remnant-TG / remnant-cholesterol"];
    P_TOTTG   [label = "TOTAL PLASMA TG\nFCS fasting 1500–10 000 mg/dL\n(17–113 mmol/L)", fillcolor="#ffe082", color="#ff8f00", penwidth=2];
    P_KNEE    [label = "THE KNEE\nTG rises hyperbolically once\ninput > Vmax_indep", fillcolor="#ff8a65", color="#bf360c", penwidth=2];
    P_PPEXC   [label = "Postprandial excursion\n+1000–4000 mg/dL per fatty meal\npeak 3–5 h, no true fasting baseline"];
    P_LACT    [label = "Lactescent (milky) plasma\ncreamy supernatant on standing\n(the 12-h refrigerator test)"];
    P_VISC    [label = "Plasma viscosity ↑\nsludging in pancreatic capillaries"];
    P_PSEUDO  [label = "Assay interference\npseudohyponatraemia · false low HbA1c\nfalse amylase (inhibitor) — MISDIAGNOSIS"];
    P_FFAP    [label = "Plasma FFA / albumin binding\nunbound FFA is the toxic species"];
    P_APOB    [label = "apoB total normal-low;\nparticle count NOT the problem —\nparticle SIZE and TG mass are"];

    P_CMTG -> P_TOTTG; P_VLDLTG -> P_TOTTG; P_REMTG -> P_TOTTG;
    P_TOTTG -> P_KNEE; P_PPEXC -> P_TOTTG;
    P_TOTTG -> P_LACT; P_TOTTG -> P_VISC; P_TOTTG -> P_PSEUDO;
    P_CMTG -> P_FFAP [style=dashed];
  }

  /* ===================== 10. PANCREATITIS MECHANISM ===================== */
  subgraph cluster_panc {
    label = "10. Acute pancreatitis — the endpoint that defines the disease";
    style = "filled,rounded"; color = "#ffcdd2"; fillcolor = "#fbe9e7"; fontsize = 12;
    node [fillcolor = "#ffcdd2", color = "#d84315"];

    A_CAP     [label = "Pancreatic capillary bed\nCM cannot pass — margination"];
    A_PLIP    [label = "Pancreatic lipase leakage\ninto the microcirculation"];
    A_HYDRO   [label = "LOCAL TG hydrolysis in situ\n(the one place lipolysis still happens)", fillcolor="#ffab91"];
    A_UFFA    [label = "Unbound (albumin-unbuffered) FFA\nlocal concentration → detergent action", fillcolor="#ff8a65", color="#bf360c", penwidth=2];
    A_MEMB    [label = "Acinar membrane lysis\nlysophosphatidylcholine · micelle injury"];
    A_CA      [label = "Sustained cytosolic Ca²⁺ overload\nSERCA failure · store-operated influx"];
    A_MITO    [label = "Mitochondrial permeability transition\nATP depletion (MPTP, cyclophilin D)"];
    A_TRYP    [label = "Intra-acinar trypsinogen activation\ncathepsin B · colocalisation"];
    A_NFKB    [label = "NF-κB activation (parallel to trypsin)\nIL-6 · TNF-α · CXCL1/2"];
    A_NECRO   [label = "Acinar necrosis · autodigestion"];
    A_ISCH    [label = "Capillary sludging + ischaemia\n(viscosity limb, trypsin-independent)"];
    A_SIRS    [label = "SIRS · capillary leak\nAPACHE-II · organ failure"];
    A_SEVERE  [label = "Severe AP\nnecrosis · ICU · mortality 5–10%\nHTG-AP is MORE severe than biliary AP", fillcolor="#e57373", color="#b71c1c"];
    A_RECUR   [label = "RECURRENT AP\nmedian 2–5 lifetime episodes\n(some patients >20)"];
    A_CHRONIC [label = "Chronic pancreatitis\nfibrosis · calcification"];
    A_EPI     [label = "Exocrine pancreatic insufficiency\nsteatorrhoea (worsens the diet problem)"];
    A_DM3C    [label = "Type 3c diabetes\n(then raises TG further — vicious loop)", fillcolor="#e57373"];
    A_THRESH  [label = "THRESHOLD 880 mg/dL (10 mmol/L)\nrisk rises steeply; >2000 mg/dL steeper.\nHAZARD IS CONVEX, NOT LINEAR", fillcolor="#ff8a65", color="#bf360c", penwidth=2];

    A_CAP -> A_PLIP -> A_HYDRO -> A_UFFA;
    A_UFFA -> A_MEMB -> A_CA -> A_MITO -> A_TRYP -> A_NECRO;
    A_UFFA -> A_NFKB -> A_NECRO;
    A_CAP -> A_ISCH -> A_NECRO;
    A_NECRO -> A_SIRS -> A_SEVERE -> A_RECUR -> A_CHRONIC;
    A_CHRONIC -> A_EPI; A_CHRONIC -> A_DM3C;
    A_THRESH -> A_HYDRO [style=dotted];
  }

  /* ===================== 11. NON-PANCREATIC MANIFESTATIONS ============== */
  subgraph cluster_clin {
    label = "11. Non-pancreatic disease burden — chronic, and usually ignored";
    style = "filled,rounded"; color = "#f0f4c3"; fillcolor = "#f9fbe7"; fontsize = 12;
    node [fillcolor = "#f0f4c3", color = "#afb42b"];

    N_XANTH   [label = "Eruptive xanthomas\nbuttocks · extensors · TG > 1500–2000\ndermal foam macrophages"];
    N_LIPRET  [label = "Lipaemia retinalis\ncreamy retinal vessels (TG > 2500)"];
    N_HSM     [label = "Hepatosplenomegaly\nRES foam-cell loading"];
    N_ABD     [label = "Chronic/recurrent abdominal pain\noften without frank pancreatitis\n(the most common daily symptom)"];
    N_FOG     [label = "Cognitive 'brain fog'\nimpaired concentration/memory\nplausibly viscosity + microcirculation"];
    N_FATIGUE [label = "Fatigue · impaired work capacity"];
    N_ANX     [label = "Anxiety/depression\nfear of the next attack"];
    N_INFANT  [label = "Infantile presentation\ncolic · failure to thrive\nlipaemic blood at first venepuncture"];
    N_QOL     [label = "Quality of life\nFCS-IMPACT · FCS-SS instruments"];
    N_ATHERO  [label = "Atherosclerosis risk: NOT clearly ↑\n(CM too large to enter intima) —\ncontrast with remnant-rich MCS", fillcolor="#dcedc8"];

    N_XANTH -> N_QOL; N_LIPRET -> N_QOL; N_ABD -> N_QOL;
    N_FOG -> N_QOL; N_FATIGUE -> N_QOL; N_ANX -> N_QOL;
    N_HSM -> N_QOL; N_INFANT -> N_QOL;
  }

  /* ===================== 12. FAILED THERAPY (LIMB-1 DRUGS) ============== */
  subgraph cluster_fail {
    label = "12. Conventional TG drugs — all act on LIMB 1, all fail in true FCS";
    style = "filled,rounded"; color = "#cfd8dc"; fillcolor = "#eceff1"; fontsize = 12;
    node [fillcolor = "#cfd8dc", color = "#546e7a"];

    F_FIB     [label = "Fenofibrate / gemfibrozil\nPPARα → ↑LPL, ↓APOC3\nneeds LPL protein to exist"];
    F_STATIN  [label = "Statins\nLDLR↑ — wrong particle, wrong limb"];
    F_NIACIN  [label = "Niacin\n↓adipose lipolysis → ↓VLDL only"];
    F_O3      [label = "ω-3 4 g/day (icosapent/omega-3-acid)\n↓VLDL secretion, some ↑LPL"];
    F_INSULIN [label = "IV insulin ± heparin (acute)\ninsulin ↑LPL transcription;\nheparin releases the LPL you HAVE"];
    F_APH     [label = "Plasmapheresis / plasma exchange\nremoves TG mechanically\n(bridges pregnancy & severe AP)", fillcolor="#c8e6c9", color="#43a047"];
    F_ORL     [label = "Orlistat\n↓intestinal fat absorption (input limb)", fillcolor="#dcedc8"];
    F_RESULT  [label = "OBSERVED: fibrate + ω-3 give\n<10–20% TG reduction in LPL-null FCS.\nEXPECTED from the structure: ~0%", fillcolor="#b0bec5", color="#37474f", penwidth=2];

    F_FIB -> F_RESULT; F_STATIN -> F_RESULT; F_NIACIN -> F_RESULT; F_O3 -> F_RESULT;
    F_INSULIN -> F_RESULT [style=dashed];
  }

  /* ===================== 13. APOC3 ANTISENSE — VOLANESORSEN ============= */
  subgraph cluster_vola {
    label = "13. Volanesorsen — 2′-MOE antisense oligonucleotide (EU-approved 2019)";
