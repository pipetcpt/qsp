    Y_GLUC    [label = "Glycaemic drift with deep\nAPOC3/ANGPTL3 knockdown"];
    Y_VITAMIN [label = "Fat-soluble vitamin deficiency\nfrom the DIET, not the drug (A,D,E,K)"];

    Y_PSASO -> Y_MACRO -> Y_PLTMOD;
    Y_GALNAC -> Y_PLTMOD [arrowhead=tee, color="#43a047"];
    Y_GALNAC -> Y_ISR2 [arrowhead=tee, color="#43a047"];
