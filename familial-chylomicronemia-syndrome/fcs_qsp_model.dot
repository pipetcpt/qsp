    Y_GALNAC  [label = "GalNAc conjugation → 20–30× dose ↓\n⇒ systemic exposure ↓ ⇒ platelet\nand ISR signal largely disappears", fillcolor="#c8e6c9", color="#43a047"];
    Y_ISR2    [label = "Injection-site reaction burden"];
