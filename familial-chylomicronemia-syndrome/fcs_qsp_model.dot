  /* failed drugs act on limb 1 */
  F_FIB    -> L_TRANS  [color="#546e7a", label="↑transcription of\na gene that is broken"];
  F_FIB    -> C3_GENE  [color="#546e7a", arrowhead=tee];
  F_O3     -> H_VLDL   [color="#546e7a", arrowhead=tee];
  F_NIACIN -> H_FFA    [color="#546e7a", arrowhead=tee];
  F_INSULIN-> L_TRANS  [color="#546e7a"];
  F_STATIN -> I_LDLR   [color="#546e7a"];
  F_ORL    -> D_LIPASE [color="#546e7a", arrowhead=tee];
  F_APH    -> P_TOTTG  [color="#43a047", arrowhead=tee, penwidth=1.4];
  L_ZERO   -> F_RESULT [color="#b71c1c", penwidth=1.6, label="zero × anything"];

  /* apoC-III drugs act on limb 2 */
  V_RNASE -> C3_MRNA [arrowhead=tee, color="#00897b", penwidth=1.6];
  O_RNASE -> C3_MRNA [arrowhead=tee, color="#43a047", penwidth=1.6];
  S_SLICE -> C3_MRNA [arrowhead=tee, color="#0288d1", penwidth=1.6];
  C3_PROT -> I_APOC3B [color="#e53935"];
  I_KEY   -> V_PD [style=dotted, color="#2e7d32"];
  I_KEY   -> O_PD [style=dotted, color="#2e7d32"];
  I_KEY   -> S_PD [style=dotted, color="#2e7d32"];

  /* ANGPTL3 drugs act on limb 1 */
  X_EVIMECH -> L_ANG3 [arrowhead=tee, color="#6d4c41", penwidth=1.4];
  L_ZERO    -> X_EVIRES [color="#b71c1c", style=dashed, label="same arithmetic"];
  X_GENE    -> L_TRANS  [color="#6d4c41", label="restores the\nmissing protein"];
  X_FGF21   -> H_DNL    [arrowhead=tee, color="#6d4c41"];

  /* safety wiring */
  V_UPTAKE -> Y_PSASO  [color="#e64a19"];
  Y_PLTMOD -> V_PLT    [color="#e64a19", penwidth=1.4];
  O_ASGPR  -> Y_GALNAC [color="#43a047", penwidth=1.4];
  S_ASGPR  -> Y_GALNAC [color="#43a047", penwidth=1.4];
  Y_GALNAC -> O_SAFE   [color="#43a047"];
  Y_GALNAC -> S_SAFE   [color="#43a047"];
  S_PD     -> Y_GLUC   [style=dashed];
  D_TARGET -> Y_VITAMIN[style=dashed, color="#e64a19"];
  X_EVI    -> Y_IMMUNO [style=dashed];
  V_LIVER  -> Y_HEPTOX [style=dashed];
  V_UPTAKE -> Y_RENAL  [style=dashed];

  /* endpoints */
  P_TOTTG  -> K_TG3    [color="#5e35b1"];
  P_TOTTG  -> K_BELOW  [color="#5e35b1"];
  P_PPEXC  -> K_TAT    [color="#5e35b1", penwidth=1.4];
  A_THRESH -> K_TAT    [color="#5e35b1", penwidth=1.4];
  A_RECUR  -> K_AP     [color="#5e35b1", penwidth=1.4];
  C3_PROT  -> K_APOC3  [color="#5e35b1", style=dashed];
  N_ABD    -> K_ABDPAIN[color="#5e35b1"];
  N_XANTH  -> K_XANTH2 [color="#5e35b1"];
  N_QOL    -> K_QOL2   [color="#5e35b1"];
  V_PD     -> K_TG3    [style=dashed, color="#00897b"];
  O_PD     -> K_TG3    [style=dashed, color="#43a047"];
  S_PD     -> K_TG3    [style=dashed, color="#0288d1"];
  O_AP     -> K_CONVEX [style=dashed, color="#43a047"];
  S_AP     -> K_CONVEX [style=dashed, color="#0288d1"];

  /* diagnosis */
  L_HEPARIN -> Q_LPLACT [color="#689f38"];
  G_BIALL   -> Q_GENE   [color="#689f38"];
  P_PSEUDO  -> Q_MISS   [color="#689f38"];
  G_MCS     -> Q_SCORE  [color="#689f38", style=dashed, label="the differential"];
  A_RECUR   -> Q_UNMET  [color="#689f38", style=dashed];

  /* model + claim */
  Z_SUM  -> W_2 [style=dotted];
  I_SATUR-> Z_SUM [style=dotted];
  Z_HAZ  -> W_4 [style=dotted];
  P_KNEE -> W_1 [style=dotted, penwidth=1.4];
  I_KEY  -> W_3 [style=dotted, penwidth=1.4];
  Y_GALNAC -> W_5 [style=dotted, penwidth=1.4];
}
