    node [fillcolor = "#b2dfdb", color = "#00897b"];

    V_DOSE    [label = "300 mg SC weekly ×3 mo\nthen q2w (platelet-driven)"];
    V_DEPOT   [label = "SC depot\nka ≈ 0.05–0.15 h⁻¹ (model VOL_SC)"];
    V_PLASMA  [label = "Plasma PS-ASO\nt½ plasma 2–5 h, >90% albumin-bound"];
    V_UPTAKE  [label = "Broad tissue uptake\n(no ligand): liver, kidney, spleen,\nMACROPHAGES ← relevant to platelets"];
    V_LIVER   [label = "Hepatocyte nuclear ASO\ntissue t½ 2–4 weeks (model VOL_LIV)"];
    V_RNASE   [label = "RNase H1 cleavage of APOC3 mRNA\ngapmer mechanism", fillcolor="#80cbc4"];
    V_PD      [label = "apoC-III ↓ 71–84%\nTG ↓ 77% at 3 mo (APPROACH, n=66)", fillcolor="#80cbc4", color="#00695c"];
