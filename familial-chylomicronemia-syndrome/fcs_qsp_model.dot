  G_MCS     -> L_LUMEN    [style=dashed, label="partial activity retained"];
  G_APOC3LOF-> C3_PROT    [color="#43a047", arrowhead=tee, label="natural knockdown"];
  G_ANGPTL3L-> L_ANG3     [color="#43a047", arrowhead=tee];

  /* modifiers → liver / LPL */
  M_ALC   -> H_VLDL   [color="#f57c00"];
  M_EST   -> H_VLDL   [color="#f57c00"];
  M_EST   -> L_TRANS  [color="#f57c00", arrowhead=tee];
