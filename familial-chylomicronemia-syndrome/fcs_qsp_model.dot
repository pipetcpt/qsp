  /* ===================== 20. QSP MODEL STRUCTURE ======================== */
  subgraph cluster_model {
    label = "20. QSP model structure — what is actually integrated";
    style = "filled,rounded"; color = "#b0bec5"; fillcolor = "#eceff1"; fontsize = 12;
    node [fillcolor = "#b0bec5", color = "#455a64", shape=note];

    Z_ODE     [label = "43 ODE compartments\ngut · lymph · plasma lipoproteins · liver ·\napoC-III mRNA/protein · pancreas · PK ×5 drugs"];
    Z_INPUT   [label = "INPUT: meal-wise fat dosing\n(3 meals/day, g LCT)"];
    Z_SUM     [label = "CLEARANCE: CL_LPL·f_geno\n+ Vmax_indep·TG/(Km+TG)·g(apoC-III)", fillcolor="#90a4ae"];
    Z_HAZ     [label = "HAZARD: λ(t) = λ0 · exp(β·(TG−TG*)₊/1000)\nintegrated → AP events/patient-year", fillcolor="#90a4ae"];
    Z_PK      [label = "PK: volanesorsen · olezarsen ·\nplozasiran (RISC effect cmt) ·\nevinacumab (2-cmt mAb) · fenofibrate"];
    Z_SCEN    [label = "10 simulation scenarios\nincl. diet titration, pregnancy,\nfat binge, genotype spectrum"];
    Z_CAL     [label = "Calibrated to APPROACH · Balance ·\nPALISADE · SHASTA-2 · Moulin cohort"];
    Z_FUNC    [label = "Analysis functions:\nFCS_saturation_curve() · FCS_limb_decomposition()\nFCS_trial_ledger() · FCS_threshold_time()"];

    Z_ODE -> Z_SUM -> Z_HAZ; Z_INPUT -> Z_ODE; Z_PK -> Z_ODE;
    Z_SCEN -> Z_CAL -> Z_FUNC;
  }

  /* ===================== 21. THE STRUCTURAL CLAIM ======================= */
  subgraph cluster_claim {
    label = "21. The structural claim this map exists to make";
    style = "filled,rounded"; color = "#ffab91"; fillcolor = "#fff3e0"; fontsize = 12;
    node [fillcolor = "#ffe0b2", color = "#e64a19", shape=box, penwidth=1.5];

    W_1 [label = "1. FCS is a SATURATED-CAPACITY disease.\nTG is a hyperbola in dietary fat, so the diet\nthreshold is a cliff and not a slope.", fillcolor="#ffcc80"];
    W_2 [label = "2. Clearance is a SUM of two limbs, and the\ngenotype multiplies the first one by zero.\nEvery limb-1 drug is arithmetically dead.", fillcolor="#ffcc80"];
    W_3 [label = "3. apoC-III knockdown works because it raises\nVmax of limb 2 — a route that never needed\nlipase. Hence 70–80% TG ↓ with LPL = 0.", fillcolor="#ffcc80"];
    W_4 [label = "4. The pancreatitis endpoint is CONVEX in TG.\nDeleting the upper tail buys more than the\nmean-percent number suggests (88% vs 43%).", fillcolor="#ffcc80"];
    W_5 [label = "5. GalNAc conjugation changed the class not by\nchanging the target but by cutting systemic\nexposure ~30× — a PK fix for a PD-blind toxicity.", fillcolor="#ffcc80"];

    W_1 -> W_2 -> W_3 -> W_4 -> W_5 [style=dotted, arrowhead=none];
  }

