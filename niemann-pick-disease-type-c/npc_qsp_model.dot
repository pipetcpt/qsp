        NFL_CSF     [label="CSF/혈장 신경필라멘트 경쇄\nNfL (뉴런 손상 판독)", penwidth=2.2, fillcolor="#eaf2f8"];
        CALBINDIN   [label="CSF 칼빈딘-D28K\n(푸르킨예 소실 판독)", penwidth=2.2, fillcolor="#eaf2f8"];
