        NPCCSS17    [label="17-domain NPCCSS\n연 2.7-2.9점 진행", penwidth=2.4, fillcolor="#f9e79f"];
        NPCCSS5     [label="5-domain NPCCSS\n연 1.5점 진행", penwidth=2.4, fillcolor="#f9e79f"];
        NPCCSS4     [label="R4DNPCCSS (재채점 4영역)\n보행·미세운동·언어·연하", penwidth=2.4, fillcolor="#f9e79f"];
        ASPIRATION  [label="흡인성 폐렴", fillcolor="#f5b7b1"];
        SURVIVAL    [label="생존 · 사망연령", penwidth=2.6, fillcolor="#f5b7b1"];

        F_IRREV -> VSGP [color="#e67e22"];
        F_REV -> SACCADE [color="#e67e22"];
        F_IRREV -> SACCADE [color="#e67e22"];
        VSGP -> SACCADE [color="#e67e22"];
        NEURO_FUNC -> ATAXIA [color="#e67e22", arrowhead=tee, penwidth=1.6];
        ATAXIA -> SARA [color="#e67e22", penwidth=1.8];
        NEURO_FUNC -> AMBUL [color="#e67e22", arrowhead=tee];
        NEURO_FUNC -> FINE_MOTOR [color="#e67e22", arrowhead=tee];
        NEURO_FUNC -> SPEECH [color="#e67e22", arrowhead=tee];
        NEURO_FUNC -> SWALLOW [color="#e67e22", arrowhead=tee];
        THAL_CORT -> COGNITION [color="#e67e22"];
        THAL_CORT -> PSYCH [color="#e67e22"];
        CHOL_CNS -> SEIZURE [color="#e67e22"];
        CHOL_CNS -> CATAPLEXY [color="#e67e22"];
        AMBUL -> NPCCSS5 [color="#e67e22"];
        FINE_MOTOR -> NPCCSS5 [color="#e67e22"];
        SPEECH -> NPCCSS5 [color="#e67e22"];
        SWALLOW -> NPCCSS5 [color="#e67e22"];
        COGNITION -> NPCCSS5 [color="#e67e22"];
        AMBUL -> NPCCSS4 [color="#e67e22"];
        FINE_MOTOR -> NPCCSS4 [color="#e67e22"];
        SPEECH -> NPCCSS4 [color="#e67e22"];
        SWALLOW -> NPCCSS4 [color="#e67e22"];
        NPCCSS5 -> NPCCSS17 [color="#e67e22"];
        HEARING -> NPCCSS17 [color="#e67e22"];
        SEIZURE -> NPCCSS17 [color="#e67e22"];
        CATAPLEXY -> NPCCSS17 [color="#e67e22"];
        SWALLOW -> ASPIRATION [color="#c0392b", arrowhead=tee, penwidth=1.8];
        ASPIRATION -> SURVIVAL [color="#c0392b", arrowhead=tee, penwidth=1.8];
        SEIZURE -> SURVIVAL [color="#c0392b", arrowhead=tee];
        LIVER_FAIL -> SURVIVAL [color="#c0392b", arrowhead=tee];
    }

    /* ================================================================== *
     * 16. 미글루스타트 PK/PD                                              *
     * ================================================================== */
    subgraph cluster_miglustat {
        label=<<b>16. 미글루스타트 (Zavesca) — 기질 감소</b><br/><font point-size="9">경구 200 mg tid · GCS 억제 · 유입 flux를 줄인다</font>>;
        style="rounded,filled"; fillcolor="#f5eef8"; color="#a569bd"; fontsize=11;
        node [fillcolor="#ebdef0", color="#8e44ad"];

        MIG_DOSE    [label="미글루스타트 경구\n200 mg tid (성인) · BSA 기준 소아"];
        MIG_GUT     [label="장관 흡수\nF ≈ 0.97 · Tmax 2-2.5 h", penwidth=2.2];
        MIG_PLASMA  [label="혈장 농도\nCss ~11-14 μM · t½ 6-7 h", penwidth=2.2];
        MIG_RENAL   [label="신 배설 (미변화체 우세)"];
        MIG_BRAIN   [label="뇌 조직 농도\n뇌/혈장 비 ~0.3-0.6", penwidth=2.2];
        MIG_GCS     [label="UGCG (GCS) 억제\nIC₅₀ ~20-50 μM"];
        MIG_GI_AE   [label="설사 · 체중감소\n(장 이당분해효소 억제)", fillcolor="#fadbd8"];
        MIG_TREMOR  [label="말초신경병증 · 진전", fillcolor="#fadbd8"];

        MIG_DOSE -> MIG_GUT [color="#8e44ad", style=dashed];
        MIG_GUT -> MIG_PLASMA [color="#2471a3"];
        MIG_PLASMA -> MIG_RENAL [color="#2471a3"];
        MIG_PLASMA -> MIG_BRAIN [color="#2471a3"];
        MIG_BRAIN -> MIG_GCS [color="#8e44ad", style=dashed, penwidth=1.6];
        MIG_PLASMA -> MIG_GCS [color="#8e44ad", style=dashed];
        MIG_GCS -> UGCG [color="#c0392b", arrowhead=tee, penwidth=2.0];
        MIG_GUT -> MIG_GI_AE [color="#c0392b"];
        MIG_PLASMA -> MIG_TREMOR [color="#c0392b"];
        MIG_GI_AE -> MIG_DOSE [label="용량 감량 · 중단", color="#c0392b", arrowhead=tee, style=dotted];
    }

    /* ================================================================== *
     * 17. 아리모클로몰 PK/PD                                              *
     * ================================================================== */
    subgraph cluster_arimoclomol {
        label=<<b>17. 아리모클로몰 (Miplyffa) — HSP70 증폭</b><br/><font point-size="9">경구 tid · HSF1 공동유도 → 변이 NPC1 접힘 수율↑ (유전형 의존)</font>>;
        style="rounded,filled"; fillcolor="#f5eef8"; color="#a569bd"; fontsize=11;
        node [fillcolor="#ebdef0", color="#8e44ad"];

        ARI_DOSE    [label="아리모클로몰 경구\n47/62/93/124 mg tid (체중별)"];
        ARI_PLASMA  [label="혈장 농도\n선형 PK · t½ ~4 h", penwidth=2.2];
        ARI_CSF     [label="CSF 농도\n용량 의존적 상승", penwidth=2.2];
        ARI_HSF1    [label="HSF1 공동유도\n(스트레스 있을 때만 증폭)"];
        ARI_HSP70   [label="HSP70 발현↑", penwidth=2.2];
        ARI_LYSO    [label="리소좀 막 안정화\nBMP 결합 · 가수분해효소 활성↑"];
        ARI_AE      [label="상기도 감염 · 어지럼\n체중감소", fillcolor="#fadbd8"];

        ARI_DOSE -> ARI_PLASMA [color="#8e44ad", style=dashed];
        ARI_PLASMA -> ARI_CSF [color="#2471a3"];
        ARI_CSF -> ARI_HSF1 [color="#8e44ad", style=dashed, penwidth=1.6];
        ARI_PLASMA -> ARI_HSF1 [color="#8e44ad", style=dashed];
        ARI_HSF1 -> ARI_HSP70 [color="#1a7f37", penwidth=1.8];
        ARI_HSP70 -> HSP70_FOLD [color="#1a7f37", penwidth=2.0];
        ARI_HSP70 -> ARI_LYSO [color="#1a7f37"];
        ARI_LYSO -> HYDROLASE [color="#1a7f37"];
        ARI_PLASMA -> ARI_AE [color="#c0392b"];
        MUT_MISFOLD -> ARI_HSP70 [label="구제 가능 기질 존재\n(효과의 전제)", color="#1a7f37", style=dashed];
    }

    /* ================================================================== *
     * 18. 레바세틸류신 PK/PD                                              *
     * ================================================================== */
    subgraph cluster_nal {
        label=<<b>18. 레바세틸류신 (Aqneursa, N-acetyl-L-leucine)</b><br/><font point-size="9">경구 최대 4 g/일 · t½ ~1 h · 빠른 대증효과 + 대사 개선</font>>;
        style="rounded,filled"; fillcolor="#f5eef8"; color="#a569bd"; fontsize=11;
        node [fillcolor="#ebdef0", color="#8e44ad"];

        NAL_DOSE    [label="레바세틸류신 경구\n체중별 · 최대 4 g/일 (분할)"];
        NAL_PLASMA  [label="혈장 농도\nCmax ~8.3 μg/mL · t½ ~1 h\n축적 없음", penwidth=2.2];
        NAL_BRAIN   [label="뇌 노출\n(아세틸화 아미노산 수송)", penwidth=2.2];
        NAL_METAB   [label="뇌 포도당·젖산 대사 정상화\n(막 전위 · 소뇌 대사)"];
        NAL_VEST    [label="전정·소뇌 보상 촉진\n(전정 대상성 회복 기전)"];
        NAL_LYSO    [label="리소좀 기질 축적 완만화\n(마우스에서 진행 지연)"];
        NAL_AE      [label="복통 · 연하곤란 · 구토", fillcolor="#fadbd8"];

        NAL_DOSE -> NAL_PLASMA [color="#8e44ad", style=dashed];
        NAL_PLASMA -> NAL_BRAIN [color="#2471a3"];
        NAL_BRAIN -> NAL_METAB [color="#8e44ad", style=dashed, penwidth=1.6];
        NAL_BRAIN -> NAL_VEST [color="#8e44ad", style=dashed];
        NAL_BRAIN -> NAL_LYSO [color="#8e44ad", style=dashed];
        NAL_METAB -> GLUC_METAB [color="#1a7f37", penwidth=1.8];
        NAL_VEST -> F_REV [label="가역 성분만 즉시 감소\n(수일-수주)", color="#1a7f37", arrowhead=tee, penwidth=2.0];
        NAL_LYSO -> CHOL_CNS [color="#c0392b", arrowhead=tee, style=dashed];
        NAL_PLASMA -> NAL_AE [color="#c0392b"];
    }

    /* ================================================================== *
     * 19. 사이클로덱스트린 (수막강내) PK/PD + 기전분리불가 독성            *
     * ================================================================== */
    subgraph cluster_cd {
        label=<<b>19. 아드라베타덱스 (2-HPβCD, 수막강내)</b><br/><font point-size="9">NPC1을 우회하는 직접 추출 · 효능과 이독성이 같은 기전</font>>;
        style="rounded,filled"; fillcolor="#f5eef8"; color="#a569bd"; fontsize=11;
        node [fillcolor="#ebdef0", color="#8e44ad"];

        CD_DOSE     [label="수막강내 2-HPβCD\n900-1200 mg q2wk"];
        CD_CSF      [label="CSF 농도\n급속 소실 (t½ 수 시간)", penwidth=2.2];
        CD_BRAIN_ECF[label="뇌 세포외액 노출\n(대류 확산 · 구배 존재)", penwidth=2.2];
        CD_IV       [label="정맥 투여 시\nBBB 통과 거의 없음", fillcolor="#eaeded"];
        CD_ENDOCYT  [label="세포내섭취 → LE/LY 도달"];
        CD_EXTRACT  [label="막에서 콜레스테롤 직접 추출\n(포접 · NPC1 무관)", penwidth=2.2];
        CD_OTO      [label="외유모세포 콜레스테롤 고갈\nprestin 기능 상실", fillcolor="#f5b7b1"];
        CD_HEARING  [label="고주파 감각신경성 난청\n(용량 제한 독성)", penwidth=2.2, fillcolor="#f5b7b1"];
        CD_LP_AE    [label="요추천자 관련 사건\n두통 · 감염 위험", fillcolor="#fadbd8"];

        CD_DOSE -> CD_CSF [color="#8e44ad", style=dashed];
        CD_CSF -> CD_BRAIN_ECF [color="#2471a3"];
        CD_IV -> CD_BRAIN_ECF [color="#c0392b", arrowhead=tee, style=dashed];
        CD_BRAIN_ECF -> CD_ENDOCYT [color="#2471a3"];
        CD_ENDOCYT -> CD_EXTRACT [color="#8e44ad", style=dashed, penwidth=1.6];
        CD_EXTRACT -> CHOL_CNS [color="#c0392b", arrowhead=tee, penwidth=2.2];
        CD_IV -> CHOL_VISC [label="정맥 경로는 내장만", color="#c0392b", arrowhead=tee, style=dashed];
        CD_EXTRACT -> CD_OTO [label="같은 기전, 다른 세포", color="#c0392b", penwidth=1.8];
        CD_OTO -> CD_HEARING [color="#c0392b", penwidth=1.8];
        CD_HEARING -> HEARING [color="#c0392b", arrowhead=tee, penwidth=1.8];
        CD_DOSE -> CD_LP_AE [color="#c0392b"];
    }

    /* ================================================================== *
     * 20. 개발 중 · 실험적 접근                                           *
     * ================================================================== */
    subgraph cluster_emerging {
        label=<<b>20. 개발 중 접근</b><br/><font point-size="9">유전자치료 · HDAC 억제 · TRPML1 작용제</font>>;
        style="rounded,filled"; fillcolor="#eaf2f8"; color="#7fb3d5"; fontsize=11;
        node [fillcolor="#d6eaf8", color="#2471a3"];

        AAV9_NPC1   [label="AAV9-NPC1 유전자 전달\n(IV / ICV)"];
        HDACI       [label="HDAC 억제제 (보리노스탓 등)\nI1061T 통과 증가"];
        TRPML1_AG   [label="TRPML1 작용제 (ML-SA1 등)\nCa²⁺ 방출 회복"];
        HSCT        [label="조혈모세포 이식\n(내장 표현형에 국한)"];
        SUBST_COMBO [label="병용: 기질감소 + 추출\n(마우스 상가효과)"];

        AAV9_NPC1 -> NPC1_LYSO [color="#8e44ad", style=dashed, penwidth=1.8];
        HDACI -> ERAD [color="#c0392b", arrowhead=tee, style=dashed];
        TRPML1_AG -> TRPML1 [color="#1a7f37", style=dashed];
        HSCT -> KUPFFER [color="#c0392b", arrowhead=tee, style=dashed];
        SUBST_COMBO -> CHOL_CNS [color="#c0392b", arrowhead=tee, style=dashed];
    }

    /* ================================================================== *
     * 21. 환자 이질성 · 발병 연령형                                       *
     * ================================================================== */
    subgraph cluster_hetero {
        label=<<b>21. 환자 이질성 — 발병 연령형이 잔여 활성의 함수</b><br/><font point-size="9">같은 구조, 다른 f_NPC1 → 전혀 다른 표현형</font>>;
        style="rounded,filled"; fillcolor="#f4f6f6"; color="#aab7b8"; fontsize=11;
        node [fillcolor="#eaeded"];

        FORM_PERI   [label="주산기형 (f_NPC1 ≈ 0)\n담즙정체 · 간부전 · 조기사망"];
        FORM_EI     [label="조기영아형 (<2세)\n발달지연 · 저긴장"];
        FORM_LI     [label="후기영아형 (2-6세)\n실조 · 인지저하 · 탈력"];
        FORM_JUV    [label="청소년형 (6-15세)\n학습장애 · VSGP · 실조"];
        FORM_ADULT  [label="성인형 (>15세, f_NPC1 최대)\n정신증상 · 완만한 실조"];
        AGE_ONSET   [label="신경학적 발병 연령\n(생존의 최강 예측자)", penwidth=2.2];
        SEX_MOD     [label="성별 · 환경 · 수정유전자"];

        NPC1_FUNC -> FORM_PERI [color="#7f8c8d", style=dashed];
        NPC1_FUNC -> FORM_EI [color="#7f8c8d", style=dashed];
        NPC1_FUNC -> FORM_LI [color="#7f8c8d", style=dashed];
        NPC1_FUNC -> FORM_JUV [color="#7f8c8d", style=dashed];
        NPC1_FUNC -> FORM_ADULT [color="#7f8c8d", style=dashed];
        FORM_LI -> AGE_ONSET [color="#e67e22"];
        FORM_JUV -> AGE_ONSET [color="#e67e22"];
        FORM_ADULT -> AGE_ONSET [color="#e67e22"];
        AGE_ONSET -> SURVIVAL [color="#e67e22", penwidth=1.8];
        SEX_MOD -> AGE_ONSET [color="#7f8c8d", style=dashed];
    }

    /* ================================================================== *
     * 22. 시험 설계가 볼 수 있는 것 (측정 구조)                           *
     * ================================================================== */
    subgraph cluster_trialdesign {
        label=<<b>22. ★ 시험 설계 × 기전의 함정</b><br/><font point-size="9">각 약은 자기 가정된 기전만 볼 수 있는 설계로 시험되었다</font>>;
        style="rounded,filled"; fillcolor="#fdf2e2"; color="#d68910"; fontsize=12; penwidth=2.0;
        node [fillcolor="#fdebd0", color="#b9770e"];

        TRIAL_12WK  [label="12주 교차설계 · SARA 변화\n(IB1001-301, n=60)\nΔ = −1.28점", penwidth=2.4];
        TRIAL_12MO  [label="12개월 병렬설계 · NPCCSS 변화\n(arimoclomol, n=50, 2:1)\nΔ = −1.40 (5D) / −1.70 (4D)", penwidth=2.4];
        TRIAL_OL    [label="공개 라벨 · 역사적 대조\n(Ory 2017 IT-HPβCD, n=14)\n21/21 vs 7/14 진행"];
        TRIAL_SHAM  [label="무작위 · 위처치 대조\n(adrabetadex 2b/3)\n어떤 지표에서도 차이 없음", fillcolor="#f5b7b1"];
        POWER_REV   [label="짧은 창 = 가역 성분에만 민감\n(대증효과를 본다)", shape=note, fillcolor="#fef9e7"];
        POWER_IRREV [label="긴 창 + 기저치 대비 변화\n= 상수 편차와 기울기를 구분 못함", shape=note, fillcolor="#fef9e7"];
        CONFOUND_OL [label="공개라벨 + 역사적 대조\n= 기울기 감소를 과대추정", shape=note, fillcolor="#fadbd8"];
        WITHDRAW    [label="중단 후 재악화 여부\n= 두 성분을 가르는 유일한 설계", shape=note, fillcolor="#d4efdf"];

        SARA -> TRIAL_12WK [color="#7f8c8d", style=dashed];
        NPCCSS5 -> TRIAL_12MO [color="#7f8c8d", style=dashed];
        NPCCSS4 -> TRIAL_12MO [color="#7f8c8d", style=dashed];
        NPCCSS17 -> TRIAL_OL [color="#7f8c8d", style=dashed];
        HEARING -> TRIAL_SHAM [label="청력 포함시\n효과 상쇄", color="#c0392b", style=dashed];
        TRIAL_12WK -> POWER_REV [color="#7f8c8d", style=dashed];
        TRIAL_12MO -> POWER_IRREV [color="#7f8c8d", style=dashed];
        TRIAL_OL -> CONFOUND_OL [color="#7f8c8d", style=dashed];
        TRIAL_OL -> TRIAL_SHAM [label="같은 약, 반대 결론", color="#c0392b", penwidth=1.8];
        F_REV -> POWER_REV [color="#7f8c8d", style=dashed];
        F_IRREV -> POWER_IRREV [color="#7f8c8d", style=dashed];
        WITHDRAW -> F_REV [color="#7f8c8d", style=dashed];
        WITHDRAW -> F_IRREV [color="#7f8c8d", style=dashed];
        OX_TRIOL -> CHOL_VISC [label="ρ = 0.265 만 — 다른 구획을\n재고 있기 때문", color="#7f8c8d", style=dashed, dir=back];
        OX_TRIOL -> NPCCSS5 [label="약한 상관", color="#7f8c8d", style=dashed];
    }

    /* ================================================================== *
     * 클러스터 간 연결: 스트레스 → 손상 적분 → 예비능 관문 → 사멸         *
     * (클러스터 안에 두면 11↔14 사이에 순환이 생겨 rank 배정이 깨진다)     *
     * ================================================================== */
    CHOL_CNS   -> STRESS_NODE [color="#c0392b", penwidth=1.6];
    NEUROINFL  -> STRESS_NODE [color="#c0392b"];
    ROS        -> STRESS_NODE [color="#c0392b"];
    LY_CA_STORE-> STRESS_NODE [label="결핍이 스트레스", color="#c0392b", arrowhead=tee];
    AUTOPH     -> STRESS_NODE [style=invis];
    GATE_NODE  -> PC_LOST     [label="사멸 개시 (관문이 열린 뒤)", color="#c0392b", penwidth=2.2];

    /* ================================================================== *
     * 구획 간 약물 접근성 (핵심 비대칭)                                   *
     * ================================================================== */
    MIG_PLASMA  -> CHOL_VISC [label="경구 → 내장 도달", color="#8e44ad", style=dashed];
    MIG_BRAIN   -> CHOL_CNS  [label="BBB 통과 부분적", color="#8e44ad", style=dashed];
    ARI_PLASMA  -> CHOL_VISC [color="#8e44ad", style=dashed];
    ARI_CSF     -> CHOL_CNS  [color="#8e44ad", style=dashed];
    CD_CSF      -> CHOL_VISC [label="수막강내는 내장에\n도달하지 않는다", color="#c0392b", arrowhead=tee, style=dotted];
    CHOL_VISC   -> CHOL_STORE [style=invis];
    NPC1_FUNC   -> CHOL_VISC [label="같은 병변, 다른 구획", color="#c0392b", arrowhead=tee];
    NPC1_FUNC   -> CHOL_CNS  [color="#c0392b", arrowhead=tee, penwidth=1.8];
    BBB         -> MIG_BRAIN [style=invis];
}
