    /* ================================================================== *
     * 14. 기능 구조: 가역 vs 비가역 (모델의 핵심 구조)                    *
     * ================================================================== */
    subgraph cluster_reserve {
        label=<<b>14. 기능 = f(가역적 기능이상, 비가역적 소실)</b><br/><font point-size="9">★ 모델의 핵심 구조 — 대증효과와 질병조절효과가 갈리는 지점</font>>;
        style="rounded,filled"; fillcolor="#fbeee6"; color="#d98880"; fontsize=12; penwidth=2.0;
        node [fillcolor="#fdebd0"];

        STRESS_NODE [label="소뇌 스트레스 S\n(부하·염증·ROS·Ca²⁺·오토파지 합)", penwidth=2.2, fillcolor="#fdebd0"];
        DAM_NODE    [label="누적 손상 적분\nDAM = ∫ S dt — 수선항 없음", penwidth=2.6, fillcolor="#f5b7b1"];
        GATE_NODE   [label="예비능 관문\nDAM > D_reserve 일 때만 사멸 개시", shape=hexagon, penwidth=2.4, fillcolor="#f9e79f"];
        VULN_NODE   [label="발달 취약성\n1 + v_dev·e^(−age/τ)", shape=note, fillcolor="#eaf2f8"];
        LATENCY     [label="발병 지연 ∝ 1/S\n→ 유전형이 발병 연령을 정한다", shape=note, fillcolor="#d4efdf"];
        SATRATE     [label="관문 통과 후 속도는 포화\n→ 기울기는 발병 연령과 무관", shape=note, fillcolor="#d4efdf"];
        F_REV       [label="가역적 기능이상 성분\nD_rev — 시간상수 일 단위\n(부하·염증·대사에 즉시 반응)", penwidth=2.6];
        F_IRREV     [label="비가역적 소실 성분\nD_irr — 시간상수 년 단위\n(뉴런 소실의 누적 적분)", penwidth=2.6, fillcolor="#f5b7b1"];
        RESERVE     [label="기능적 예비능\n(임상 발현 전 완충)", penwidth=2.2];
        NEURO_FUNC  [label="총 신경학적 기능\nFUNC = 1 − D_rev − D_irr", penwidth=2.8, fillcolor="#f9e79f"];
        SYMPT_ARROW [label="대증 효과\n= D_rev 만 감소\n(중단시 되돌아감)", shape=note, fillcolor="#e8daef"];
        DISMOD_ARROW[label="질병조절 효과\n= dD_irr/dt 감소\n(중단해도 유지)", shape=note, fillcolor="#d4e6f1"];

        STRESS_NODE -> DAM_NODE [label="적분", color="#c0392b", penwidth=2.2];
        DAM_NODE -> GATE_NODE [color="#c0392b", penwidth=2.0];
        VULN_NODE -> GATE_NODE [color="#7f8c8d", style=dashed];
        DAM_NODE -> LATENCY [color="#7f8c8d", style=dashed];
        GATE_NODE -> SATRATE [color="#7f8c8d", style=dashed];
        STRESS_NODE -> F_REV [label="포화 함수 (즉시)", color="#c0392b", penwidth=1.8];
        NEUROINFL -> F_REV [color="#c0392b"];
        GLUC_METAB -> F_REV [color="#c0392b", arrowhead=tee];
        PC_LOST -> F_IRREV [color="#c0392b", penwidth=2.0];
        SYN_LOSS -> F_IRREV [color="#c0392b"];
        CBL_VOL -> F_IRREV [color="#c0392b"];
        F_REV -> NEURO_FUNC [color="#c0392b", arrowhead=tee, penwidth=2.0];
        F_IRREV -> NEURO_FUNC [color="#c0392b", arrowhead=tee, penwidth=2.0];
        RESERVE -> NEURO_FUNC [color="#1a7f37"];
        F_IRREV -> RESERVE [color="#c0392b", arrowhead=tee];
        SYMPT_ARROW -> F_REV [color="#8e44ad", style=dashed];
        DISMOD_ARROW -> F_IRREV [color="#8e44ad", style=dashed];
    }

