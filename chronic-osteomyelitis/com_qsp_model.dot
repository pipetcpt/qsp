  cv_ckd -> tx_aki [style=dashed, dir=back];   /* 되먹임: 화살표 방향 유지, 랭킹만 정방향 */
  abx_dur -> tx_util [label="기간이 독성을 만든다", penwidth=2.0, color="#b91c1c"];
  abx_dur -> tx_util [label="T* 결정", style=dashed, color="#16a34a", dir=back];   /* 되먹임: 화살표 방향 유지, 랭킹만 정방향 */

  /* 공변량 → 시스템 */
  cv_dm -> im_neut [label="살균능↓", style=dashed, color="#b91c1c"];
  cv_dm -> pf_pad [style=dashed, penwidth=1.6];
  cv_smoke -> pf_frac [style=dashed, color="#b91c1c"];
  cv_immuno -> im_neut [style=dashed, color="#b91c1c"];
