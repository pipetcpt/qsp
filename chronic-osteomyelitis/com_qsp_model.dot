  pd_eq -> eq_2 [style=dotted, color="#b45309", dir=back];   /* 되먹임: 화살표 방향 유지, 랭킹만 정방향 */
  pd_rster -> eq_3 [style=dotted, color="#b45309", dir=back];   /* 되먹임: 화살표 방향 유지, 랭킹만 정방향 */
  pd_tster -> eq_4 [style=dotted, color="#b45309", dir=back];   /* 되먹임: 화살표 방향 유지, 랭킹만 정방향 */
  B_res -> eq_5 [style=dotted, color="#b45309", dir=back];   /* 되먹임: 화살표 방향 유지, 랭킹만 정방향 */
  pk_ind -> eq_6 [style=dotted, color="#b45309", dir=back];   /* 되먹임: 화살표 방향 유지, 랭킹만 정방향 */
  bn_thromb -> eq_7 [style=dotted, color="#b45309", dir=back];   /* 되먹임: 화살표 방향 유지, 랭킹만 정방향 */
