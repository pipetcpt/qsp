  /* ================================================================
     22. VARIANTS — ONE COEFFICIENT, NOT ONE MORE MODEL
     ================================================================ */
  subgraph cluster_var {
    label="22 · 변이형 — 하나의 계수 (aHIT · Spontaneous HIT · VITT)  ★ 헤파린 비의존성";
    style="filled,rounded"; color="#D84315"; fillcolor="#FBE9E7"; fontsize=11;
    node [shape=box, fillcolor="#FFAB91", color="#D84315"];

    VR_AHIT   [label="자가면역 HIT (aHIT)\nAutoimmune HIT\nantibody clusters PF4 WITHOUT\nheparin → persists after\ncessation; more severe"];
    VR_SPONT  [label="자발성 HIT 증후군\nSpontaneous HIT syndrome\nNO heparin exposure ever\n(post-infection, post-ortho\nsurgery, knee arthroplasty)"];
    VR_VITT   [label="백신 유발 면역성 혈전\n혈소판감소증 (VITT)\nAdenoviral-vector vaccine;\nantibody binds the HEPARIN-\nBINDING SITE of PF4"];
    VR_EPI    [label="에피토프 이동\nEPITOPE SHIFT\nKKO-like site → heparin-\nbinding site itself"];
    VR_AFF    [label="더 높은 친화도 / 협착 클론성\nHigher affinity, oligoclonal,\nstronger platelet activation"];
    VR_HEPIND [label="헤파린 비의존적 ULC\nHeparin-INDEPENDENT clustering\n(PF4 alone at high local\nconcentration)"];
    VR_HEPOK  [label="헤파린 금기 아님 (VITT)\nHeparin NOT contraindicated\nin VITT — there is no heparin\nin the antigen\n★ counter-intuitive prediction"];
    VR_IVIGY  [label="IVIG 반응성\nIVIG-responsive\n(receptor competition is\nepitope-agnostic)"];
    VR_PFDNA  [label="내인성 폴리음이온\nEndogenous polyanions as\nthe bridging agent\n(DNA, polyP, bacterial\nsurfaces)"];
  }

  /* ================================================================
     EDGES — LAYER 1: ANTIGEN
     ================================================================ */
  HEP_IND -> HEP_UFH; HEP_IND -> HEP_LMWH; HEP_IND -> HEP_FONDA; HEP_IND -> HEP_DANA;
  HEP_UFH -> HEP_PK1; HEP_LMWH -> HEP_PK2; HEP_FONDA -> HEP_PK3;
  HEP_IND -> HEP_DOSE; HEP_DOSE -> HEP_PK1;
  HEP_CPB -> HEP_PK1 [label="3-6 U/mL", color="#C62828", penwidth=1.4];
  HEP_UFH -> HEP_CHAIN [label="~50 sacch."];
  HEP_LMWH -> HEP_CHAIN [label="~15 sacch."];
  HEP_FONDA -> HEP_CHAIN [label="5 sacch. — cannot bridge", color="#2E7D32"];
  HEP_DANA -> HEP_CHAIN;
  HEP_CHAIN -> AG_LEN [penwidth=1.4];
  HEP_PK1 -> AG_RATIO [penwidth=1.4]; HEP_PK2 -> AG_RATIO; HEP_PK3 -> AG_RATIO [style=dashed];
  HEP_GAG -> AG_RATIO [style=dashed, label="endogenous\nbridging"];
  HEP_STOP -> HEP_PK1 [arrowhead=tee, color="#1565C0", penwidth=1.6];
  HEP_REEXP -> HEP_PK1;
  HEP_REEXP -> K_RAPID [label="if antibody\nstill present", color="#C62828"];

  PF4_GENE -> PF4_GRAN; PF4_GRAN -> PF4_PLAS; PF4_PLAS -> PF4_TET;
  PF4_TET -> PF4_SURF; PF4_TET -> PF4_EC; PF4_TET -> PF4_MONO;
  PF4_TET -> AG_RATIO [penwidth=1.4];
  PF4_PLAS -> PF4_CLEAR; PF4_TET -> PF4_KD; PF4_KD -> AG_RATIO;
  PF4_TET -> PF4_HBS;
  AG_ULC -> PF4_CONF; PF4_CONF -> PF4_NEO [penwidth=1.4];
  PF4_EC -> AG_LOCAL; PF4_SURF -> AG_LOCAL; AG_LOCAL -> AG_ULC [penwidth=1.3];

  AG_RATIO -> AG_NEUT; AG_NEUT -> AG_ULC [penwidth=1.6, color="#C62828"];
  AG_RATIO -> AG_BIN; AG_BIN -> AG_ULC [label="polymerise\nat optimal ratio"];
  AG_RATIO -> AG_BELL [penwidth=1.4]; AG_BELL -> AG_ULC [penwidth=1.4];
  AG_EXCESS -> AG_ULC [arrowhead=tee, penwidth=1.6, color="#2E7D32"];
  HEP_PK1 -> AG_EXCESS [label="at very high\n[heparin]", color="#2E7D32"];
  AG_PF4EX -> AG_ULC [arrowhead=tee, style=dashed];
  PF4_PLAS -> AG_PF4EX [style=dashed];
  AG_LEN -> AG_ULC [penwidth=1.4];
  AG_ULC -> AG_EPDENS [penwidth=1.4]; AG_EPDENS -> AG_STAB;
  AG_ULC -> NEO_CRYPT; NEO_CRYPT -> NEO_KKO; PF4_NEO -> NEO_KKO [penwidth=1.4];
  PF4_TET -> NEO_RTO [label="monomeric\nepitope", style=dashed];
  AG_ULC -> NEO_C3; NEO_C3 -> NEO_CR2; AG_ULC -> NEO_APC;

  /* ================================================================
     EDGES — LAYER 2: IMMUNITY
     ================================================================ */
  NEO_KKO -> B_ACT [penwidth=1.4]; NEO_CR2 -> B_ACT [label="lowers\nthreshold"];
  NEO_APC -> NEO_TDEP; NEO_TDEP -> B_ACT [style=dashed];
  NEO_PRE -> B_NAIVE [penwidth=1.3]; NEO_MZB -> B_ACT;
  NEO_PRE -> NEO_MZB;
  B_NAIVE -> B_ACT; B_ACT -> B_PROLIF; B_PROLIF -> B_PLASMA [penwidth=1.4];
  B_PROLIF -> B_LLPC [style=dashed, label="minimal"];
  B_PROLIF -> B_MEM [style=dashed, label="functionally\ndeficient"];
  B_BAFF -> B_PLASMA; B_NAIVE -> B_CD20; B_ACT -> B_CD20;
  B_PLASMA -> AB_IGG [penwidth=1.6];
  B_PLASMA -> AB_IGM; B_PLASMA -> AB_IGA;
  B_LLPC -> AB_IGG [style=dashed];
  B_MEM -> K_NOBOOST [penwidth=1.3, color="#2E7D32", label="no boost"];

  AB_IGG -> AB_TITRE; AB_TITRE -> AB_PATH [penwidth=1.4];
  AB_TITRE -> AB_NONP [label="majority"];
  NEO_RTO -> AB_NONP; AB_AFF -> AB_PATH [penwidth=1.3];
  AB_IGG -> AB_AFF; AG_EPDENS -> AB_AFF [label="valency", penwidth=1.3];
  AB_PATH -> AB_STOICH [penwidth=1.6, color="#C62828"];
  AG_ULC -> AB_STOICH [penwidth=1.6, color="#C62828"];
  AB_HDEP -> AB_STOICH [penwidth=1.3];
  AB_IGG -> AB_CLEAR; AB_CLEAR -> K_SEROREV [penwidth=1.3];
  AB_IGG -> AB_CROSS; AB_CROSS -> AG_ULC [style=dashed, label="LMWH ~90%,\nfonda ~0-5%"];
  AB_IGM -> AB_STOICH [arrowhead=tee, style=dashed, label="cannot\nengage FcγRIIa"];

  B_ACT -> K_TYPICAL [style=dashed, label="maturation delay\n→ day 5-10", penwidth=1.4];
  AB_TITRE -> K_TYPICAL; K_SEROREV -> K_PERSIST; K_PERSIST -> K_RAPID [penwidth=1.3];
  K_PERSIST -> K_NOBOOST [arrowhead=tee, style=dashed];
  AB_HDEP -> K_DELAY [penwidth=1.3, color="#D84315"];
  HEP_STOP -> K_DELAY [style=dashed, label="disease continues"];

  /* ================================================================
     EDGES — LAYER 3: EFFECTOR
     ================================================================ */
  AB_STOICH -> FCR_BOUND [penwidth=1.6]; FCR_NUM -> FCR_BOUND;
  FCR_POLY -> FCR_BOUND [label="H131/R131\naffinity"];
  FCR_BOUND -> FCR_XLINK [penwidth=1.6, color="#C62828"];
  AG_EPDENS -> FCR_XLINK [label="multivalency\nrequired", penwidth=1.4];
  FCR_XLINK -> FCR_THR [penwidth=1.4]; FCR_THR -> FCR_ITAM [penwidth=1.4];
  FCR_ITAM -> FCR_SYK -> FCR_LAT -> FCR_PLC -> FCR_CA;
  FCR_PLC -> FCR_PKC; FCR_CA -> FCR_RAP1; FCR_PKC -> FCR_RAP1;
  FCR_SHIP -> FCR_SYK [arrowhead=tee, style=dashed];
  FCR_COMP -> FCR_BOUND [arrowhead=tee, penwidth=1.6, color="#1565C0"];
  AB_STOICH -> FCR_FCGR3;

  FCR_CA -> PLT_ACT [penwidth=1.6]; FCR_RAP1 -> PLT_GP2B;
  PLT_REST -> PLT_ACT [penwidth=1.4];
  PLT_ACT -> PLT_GRAN [penwidth=1.6]; PLT_ACT -> PLT_DENSE [penwidth=1.4];
  PLT_ACT -> PLT_PSEL; PLT_ACT -> PLT_CD40L; PLT_ACT -> PLT_TXA2;
  PLT_DENSE -> PLT_P2Y; PLT_P2Y -> PLT_ACT [style=dashed, label="secondary"];
  PLT_TXA2 -> PLT_ACT [style=dashed];
  PLT_GP2B -> PLT_AGG; PLT_ACT -> PLT_AGG;
  PLT_ACT -> PLT_MPV [style=dashed];

  /* THE AUTOCATALYTIC LOOP — bold red */
  PLT_GRAN -> PF4_PLAS [penwidth=2.4, color="#B71C1C", label="PF4 dump"];
  PF4_PLAS -> AG_RATIO [penwidth=2.4, color="#B71C1C"];
  AG_ULC -> PLT_LOOP [penwidth=2.0, color="#B71C1C", style=bold];
  PLT_ACT -> PLT_LOOP [penwidth=2.0, color="#B71C1C", style=bold];
  PLT_LOOP -> PLT_ACT [penwidth=2.4, color="#B71C1C", style=bold, label="AMPLIFY"];
  PLT_TXN -> PLT_REST [penwidth=1.6, color="#E65100", label="adds substrate"];
  PLT_TXN -> PLT_LOOP [penwidth=1.6, color="#E65100", style=bold, label="FEEDS THE LOOP"];

  /* PLATELET CLEARANCE ARM */
  AB_STOICH -> CL_SPLEEN [penwidth=1.4, label="opsonisation"];
  PLT_ACT -> CL_SPLEEN [penwidth=1.4];
  PLT_AGG -> CL_CONSUM [penwidth=1.4]; PLT_ACT -> CL_DESIAL [style=dashed];
  CL_SPLEEN -> CL_NADIR [penwidth=1.6]; CL_CONSUM -> CL_NADIR [penwidth=1.4];
  CL_DESIAL -> CL_NADIR;
  CL_BASE -> CL_FALL [penwidth=1.3]; CL_NADIR -> CL_FALL [penwidth=1.6];
  CL_FALL -> DX_4TS [penwidth=1.6];
  PLT_REST -> CL_BASE;
  CL_NADIR -> PLT_TPO [style=dashed]; PLT_TPO -> PLT_REST [style=dashed, label="recovery\nlag 3-5 d"];
  HEP_STOP -> CL_RECOV [penwidth=1.4, color="#1565C0"]; CL_RECOV -> PLT_REST [style=dashed];
  CL_NADIR -> CL_BLEED [style=dashed, label="rare"];
  FCR_COMP -> CL_SPLEEN [arrowhead=tee, color="#1565C0", penwidth=1.4];

  /* MICROPARTICLE ARM */
  FCR_CA -> MP_SCRAM [penwidth=1.3]; PLT_ACT -> MP_SCRAM [penwidth=1.4];
  MP_SCRAM -> MP_PS [penwidth=1.6]; MP_PS -> MP_SHED; MP_SHED -> MP_PMP [penwidth=1.4];
  MP_PMP -> MP_SURF [penwidth=1.6]; MP_PS -> MP_SURF [penwidth=1.4];
  MO_TF -> MP_TFMP; MP_TFMP -> MP_SURF; MP_TFMP -> CO_TF [penwidth=1.4];

  /* MONOCYTE / NEUTROPHIL ARM */
  MO_REST -> MO_ACT; AB_STOICH -> MO_ACT [penwidth=1.4];
  PF4_MONO -> MO_ACT [penwidth=1.4]; FCR_FCGR3 -> MO_ACT;
  MO_ACT -> MO_NFKB; MO_NFKB -> MO_TF [style=dashed, penwidth=1.6, label="2-6 h\ntranscription"];
  MO_NFKB -> MO_IL8 [style=dashed]; MO_IL8 -> RK_INFL;
  MO_TF -> CO_TF [penwidth=1.8, color="#C62828"];
  PLT_PSEL -> NE_ADH; NE_REST -> NE_ADH; NE_ADH -> NE_NET [penwidth=1.3];
  MO_IL8 -> NE_NET [style=dashed];
  NE_NET -> NE_SCAFF; NE_NET -> NE_PF4DNA;
  PF4_PLAS -> NE_PF4DNA; NE_PF4DNA -> AG_ULC [style=dashed, color="#D84315", label="heparin-free\nantigen"];
  NE_SCAFF -> CO_FIBRIN [style=dashed]; NE_NET -> CO_THR [style=dashed];

  /* ENDOTHELIAL ARM */
  EC_REST -> EC_HSPG; PF4_EC -> EC_HSPG [penwidth=1.3];
  EC_HSPG -> AG_ULC [label="ULC on the\nvessel wall", penwidth=1.3];
  AB_STOICH -> EC_ACT [penwidth=1.3]; PLT_CD40L -> EC_ACT;
  MO_IL8 -> EC_ACT [style=dashed];
  EC_ACT -> EC_TF [style=dashed]; EC_TF -> CO_TF;
  EC_ACT -> EC_VWF; EC_VWF -> PLT_ACT [style=dashed]; EC_VWF -> EC_ADAM;
  EC_ACT -> EC_TM [arrowhead=tee, penwidth=1.3]; EC_ACT -> EC_EPCR [arrowhead=tee];
  EC_ACT -> EC_NO [arrowhead=tee]; EC_ACT -> EC_GLYCO;
  EC_GLYCO -> HEP_GAG [style=dashed];
  EC_TM -> NA_PC [arrowhead=tee, penwidth=1.3, label="loses APC\ngeneration"];
  EC_EPCR -> NA_APC [arrowhead=tee];

  /* COAGULATION CASCADE */
  CO_TF -> CO_FX [penwidth=1.6]; CO_TF -> CO_FIX; CO_FIX -> CO_FX [penwidth=1.3];
  CO_FX -> CO_PTASE [penwidth=1.6]; MP_SURF -> CO_PTASE [penwidth=1.8, color="#C62828",
                                                          label="catalytic\nsurface"];
  CO_FII -> CO_PTASE [penwidth=1.4]; CO_PTASE -> CO_THR [penwidth=1.8];
  CO_THR -> CO_FBG [penwidth=1.6]; CO_FBG -> CO_FIBRIN [penwidth=1.4];
  CO_FIBRIN -> CO_FXIII; CO_THR -> CO_FXIII;
  CO_THR -> CO_FV [penwidth=1.3]; CO_FV -> CO_PTASE [penwidth=1.3];
  CO_THR -> CO_FVIII; CO_FVIII -> CO_FIX;
  CO_THR -> CO_FXI; CO_FXI -> CO_FIX [style=dashed];
  CO_THR -> CO_TAT; CO_PTASE -> CO_F12; CO_FIBRIN -> CO_DDIM;
  CO_THR -> CO_PLTTHR [penwidth=1.4];
  CO_PLTTHR -> PLT_ACT [penwidth=1.6, color="#B71C1C", style=bold, label="SECOND LOOP"];

  /* NATURAL ANTICOAGULANTS */
  NA_AT -> CO_THR [arrowhead=tee, penwidth=1.4];
  NA_AT -> CO_FX [arrowhead=tee];
  HEP_PK1 -> NA_ATHEP [penwidth=1.4]; HEP_PK2 -> NA_ATHEP; NA_ATHEP -> NA_AT [penwidth=1.4];
  CO_THR -> NA_AT [arrowhead=tee, style=dashed, label="consumption"];
  NA_PC -> NA_APC [penwidth=1.4]; NA_PS -> NA_APC;
  NA_APC -> CO_FV [arrowhead=tee, penwidth=1.4]; NA_APC -> CO_FVIII [arrowhead=tee];
  HEP_PK1 -> NA_TFPI [style=dashed]; NA_TFPI -> CO_TF [arrowhead=tee];
  HEP_STOP -> NA_TFPI [arrowhead=tee, style=dashed, label="TFPI lost\non cessation"];
  CO_FIBRIN -> NA_FIBRIN; NA_PAI -> NA_FIBRIN [arrowhead=tee];
  RK_INFL -> NA_PAI [style=dashed]; NA_FIBRIN -> CO_DDIM;

  /* THROMBOSIS PHENOTYPE */
  CO_THR -> TH_ANY [penwidth=2.0, color="#BF360C"];
  CO_FIBRIN -> TH_ANY [penwidth=1.6]; PLT_AGG -> TH_ANY [penwidth=1.4];
  TH_ANY -> TH_DVT [penwidth=1.4]; TH_ANY -> TH_PE [penwidth=1.4]; TH_ANY -> TH_ART;
  TH_DVT -> TH_PE [style=dashed]; TH_ART -> TH_LIMB; TH_DVT -> TH_LIMB [style=dashed];
  TH_ANY -> TH_CVST; TH_ANY -> TH_ADREN; TH_ANY -> TH_LINE;
  HEP_UFH -> TH_SKIN [style=dashed, label="injection site"];
  CO_THR -> TH_DIC [style=dashed]; TH_DIC -> CL_BLEED [style=dashed];
  TH_ANY -> TH_DEATH [penwidth=1.4]; TH_LIMB -> TH_DEATH [style=dashed];
  TH_PE -> TH_DEATH; TH_ADREN -> TH_DEATH [style=dashed];
  TH_ANY -> DX_4TS [penwidth=1.3];

  /* NON-HEPARIN ANTICOAGULANTS */
  DR_ARG -> DR_ARGPD [penwidth=1.4]; DR_BIV -> DR_ARGPD [penwidth=1.4];
  DR_ARGPD -> CO_THR [arrowhead=tee, penwidth=1.8, color="#1565C0"];
  DR_ARGPD -> DR_APTT; DR_APTT -> DR_ARG [style=dashed, label="titration\nfeedback"];
  DR_DANA -> DR_ANTIXA; DR_FONDA -> DR_ANTIXA; DR_ANTIXA -> CO_FX [arrowhead=tee,
                                                penwidth=1.6, color="#1565C0"];
  DR_DOAC -> CO_FX [arrowhead=tee, penwidth=1.6, color="#1565C0", label="apixaban /\nrivaroxaban"];
  DR_DOAC -> CO_THR [arrowhead=tee, style=dashed, label="dabigatran"];
  DR_RENAL -> DR_FONDA [arrowhead=tee, style=dashed]; DR_RENAL -> DR_DANA [arrowhead=tee, style=dashed];
  DR_RENAL -> DR_DOAC [arrowhead=tee, style=dashed];
  DR_HEPAT -> DR_ARG [arrowhead=tee, style=dashed, label="halve the dose"];
  DR_DANA -> AB_CROSS [style=dashed, label="~10-25%\ncross-react"];
  DR_FONDA -> AG_ULC [arrowhead=tee, style=dashed, color="#2E7D32",
                      label="cannot form ULC"];
  DR_ARGPD -> TH_ANY [arrowhead=tee, penwidth=1.6, color="#1565C0"];
  DR_ARGPD -> CL_NADIR [arrowhead=tee, style=dashed, color="#90A4AE",
                        label="NO direct effect on\nthe platelet axis"];

  /* IMMUNOMODULATION */
  IM_IVIG -> FCR_COMP [penwidth=1.8, color="#1565C0"];
  IM_IVIG -> AG_ULC [arrowhead=tee, penwidth=1.3, color="#1565C0", label="ULC disruption"];
  IM_IVIG -> AB_PATH [arrowhead=tee, style=dashed, label="anti-idiotype"];
  IM_PLEX -> AB_IGG [arrowhead=tee, penwidth=1.6, color="#1565C0"];
  IM_PLEX -> AB_STOICH [arrowhead=tee, penwidth=1.4, color="#1565C0"];
  IM_RTX -> B_CD20 [arrowhead=tee, penwidth=1.4, color="#1565C0"];
  IM_RTX -> B_PLASMA [arrowhead=tee, style=dashed, label="spares plasmablasts\n→ slow onset"];
  IM_STER -> B_ACT [arrowhead=tee, style=dashed];
  IM_C5 -> NEO_C3 [arrowhead=tee, style=dashed];
  IM_FCRN -> AB_CLEAR [penwidth=1.3, color="#1565C0", label="accelerate\ncatabolism"];
  IM_BTK -> FCR_SYK [arrowhead=tee, style=dashed, color="#1565C0"];
  IM_BTK -> B_ACT [arrowhead=tee, style=dashed, color="#1565C0"];

  /* THE TWO TRAPS */
  TR_VKA -> TR_PCFALL [penwidth=1.6, color="#E65100"];
  TR_VKA -> TR_FIIFALL [penwidth=1.6];
  TR_PCFALL -> NA_PC [arrowhead=tee, penwidth=1.6, color="#E65100"];
  TR_FIIFALL -> CO_FII [arrowhead=tee, penwidth=1.4];
  TR_PCFALL -> TR_MISM [penwidth=1.6, color="#E65100"];
  TR_FIIFALL -> TR_MISM [penwidth=1.4];
  TR_MISM -> CO_THR [penwidth=1.8, color="#E65100", label="NET INCREASE\nin thrombin"];
  TR_MISM -> TR_VLG [penwidth=1.8, color="#E65100"];
  TR_MISM -> TR_SKINN [penwidth=1.4, color="#E65100"];
  CL_NADIR -> TR_VLG [style=dashed, label="risk highest while\nplatelets still low"];
  TH_DVT -> TR_VLG [penwidth=1.3, label="thrombosed limb +\nintact arterial supply"];
  TR_VLG -> TH_LIMB [penwidth=1.6, color="#E65100"];
  TR_DELAY -> TR_VKA [arrowhead=tee, penwidth=1.6, color="#1565C0",
                      label="withhold until\nPLT >150"];
  CL_RECOV -> TR_DELAY [penwidth=1.3];
  TR_VITK -> TR_PCFALL [arrowhead=tee, style=dashed, color="#1565C0"];
  DR_ARG -> TR_INRART [penwidth=1.6, color="#E65100"];
  TR_INRART -> TR_INRFAL [penwidth=1.6, color="#E65100"];
  TR_FIIFALL -> TR_INRFAL [style=dashed, label="true depletion\nis only part of it"];
  TR_INRFAL -> DR_ARG [arrowhead=tee, color="#E65100", style=dashed,
                       label="premature\ncessation"];
  TR_INRFAL -> TH_ANY [penwidth=1.4, color="#E65100", label="patient uncovered"];
  TR_FXACT -> TR_INRFAL [arrowhead=tee, penwidth=1.4, color="#1565C0",
                         label="the correct test"];
  CO_FII -> TR_FXACT [style=dashed];

  /* DIAGNOSTICS AND THE ICEBERG */
  AB_TITRE -> DX_ELISA [penwidth=1.6]; DX_ELISA -> DX_ODTIER [penwidth=1.4];
  AB_TITRE -> DX_RAPID; DX_ODTIER -> DX_ICE1 [penwidth=1.4];
  AB_PATH -> DX_SRA [penwidth=1.6]; PLT_DENSE -> DX_SRA [penwidth=1.6,
                                          label="serotonin release\nIS the readout"];
  AG_EXCESS -> DX_SRA [penwidth=1.6, color="#2E7D32",
                       label="100 U/mL abolishes\nrelease = confirm"];
  AB_PATH -> DX_HIPA; PLT_PSEL -> DX_PEA;
  DX_SRA -> DX_ICE2 [penwidth=1.4]; DX_HIPA -> DX_ICE2;
  DX_ICE1 -> DX_ICE2 [penwidth=1.3, label="threshold 1:\nepitope + affinity"];
  DX_ICE2 -> DX_ICE3 [penwidth=1.3, label="threshold 2:\ncrosslinking density"];
  FCR_THR -> DX_ICE3 [penwidth=1.3];
  CL_FALL -> DX_ICE3 [penwidth=1.4]; TH_ANY -> DX_ICE3 [penwidth=1.4];
  DX_PLTCT -> CL_NADIR [style=dashed, label="detects"]; DX_PLTCT -> CL_FALL [style=dashed];
  DX_4TS -> DX_ELISA [style=dashed, label="pretest\nprobability gates\ntesting"];
  DX_4TS -> HEP_STOP [penwidth=1.6, color="#1565C0", label="4Ts ≥4 →\nSTOP + start DTI"];
  DX_4TS -> DR_ARG [penwidth=1.4, color="#1565C0"];
  AB_NONP -> DX_ELISA [penwidth=1.3, label="the false-positive\nmass of the iceberg"];

  /* RISK MODIFIERS */
  RK_SURG -> PF4_PLAS [penwidth=1.4]; RK_CPB -> PF4_PLAS [penwidth=1.8, color="#C62828"];
  RK_CPB -> PLT_ACT [penwidth=1.4]; RK_CPB -> HEP_CPB [penwidth=1.6];
  RK_TRAUMA -> PF4_PLAS [style=dashed]; RK_INFL -> B_ACT [style=dashed];
  RK_INFL -> MO_TF [style=dashed]; RK_SEX -> B_ACT [style=dashed];
  RK_MALIG -> CO_TF [style=dashed]; RK_HLA -> NEO_TDEP [style=dashed];
  RK_TREG -> B_ACT [arrowhead=tee, style=dashed];
  RK_PRIOR -> HEP_REEXP [penwidth=1.3]; RK_PRIOR -> K_PERSIST [penwidth=1.3];
  RK_OBESE -> DR_RENAL [style=dashed];
  RK_SURG -> DX_ICE1 [style=dashed, label="25-50% seroconvert\npost-CPB"];

  /* VARIANTS */
  VR_EPI -> PF4_HBS [penwidth=1.6, color="#D84315"];
  PF4_HBS -> VR_HEPIND [penwidth=1.6, color="#D84315"];
  VR_EPI -> AB_HDEP [arrowhead=tee, penwidth=1.8, color="#D84315",
                     label="heparin-dependence\n→ 0"];
  VR_HEPIND -> AG_ULC [penwidth=1.6, color="#D84315",
                       label="ULC without heparin"];
  VR_AHIT -> VR_EPI [penwidth=1.4]; VR_VITT -> VR_EPI [penwidth=1.6];
  VR_SPONT -> VR_EPI [penwidth=1.4];
  VR_AHIT -> VR_AFF; VR_VITT -> VR_AFF [penwidth=1.4];
  VR_AFF -> AB_PATH [penwidth=1.4, color="#D84315"];
  VR_PFDNA -> VR_HEPIND [style=dashed]; NE_PF4DNA -> VR_SPONT [style=dashed];
  HEP_GAG -> VR_SPONT [style=dashed];
  VR_HEPIND -> K_DELAY [penwidth=1.4, color="#D84315"];
  VR_VITT -> TH_CVST [penwidth=1.6, color="#D84315", label="hallmark"];
  VR_VITT -> VR_HEPOK [penwidth=1.4, color="#2E7D32"];
  VR_HEPOK -> HEP_UFH [style=dashed, color="#2E7D32", label="permitted"];
  IM_IVIG -> VR_IVIGY [penwidth=1.4, color="#1565C0"];
  VR_IVIGY -> VR_AHIT [arrowhead=tee, penwidth=1.4, color="#1565C0"];
  VR_IVIGY -> VR_VITT [arrowhead=tee, penwidth=1.4, color="#1565C0"];
  HEP_STOP -> VR_AHIT [arrowhead=tee, style=dashed, color="#90A4AE",
                       label="INEFFECTIVE alone"];

  /* CROSS-LAYER SUMMARY EDGES — the two-axis separation */
  PLT_ACT -> MP_PS [style=invis];
  AG_ULC -> AB_STOICH [style=invis];

  /* Rank hints to keep the three layers legible top-to-bottom */
  { rank=same; HEP_UFH; HEP_LMWH; HEP_FONDA; HEP_DANA; }
  { rank=same; TH_DVT; TH_PE; TH_ART; TH_CVST; }
}
