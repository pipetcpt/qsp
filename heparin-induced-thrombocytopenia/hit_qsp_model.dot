    TR_PCFALL [label="단백질 C 붕괴 (빠름)\nProtein C falls FAST\nt½ 8 h → ~70% gone by 24 h"];
    TR_FIIFALL[label="프로트롬빈 붕괴 (느림)\nProthrombin falls SLOWLY\nt½ 60-72 h → ~20% gone\nby 24 h"];
    TR_MISM   [label="반감기 불일치\nHALF-LIFE MISMATCH\n→ transient NET\nPROCOAGULANT state"];
    TR_VLG    [label="정맥성 사지 괴사\nVENOUS LIMB GANGRENE\n★ iatrogenic amputation in a\npatient 'being anticoagulated'"];
    TR_SKINN  [label="와파린 피부 괴사\nWarfarin-induced skin\nnecrosis (breast, thigh)"];
    TR_DELAY  [label="VKA 연기 규칙\nWithhold VKA until\nplatelets >150 x10⁹/L,\noverlap ≥5 days"];
    TR_INRART [label="아르가트로반 INR 인공물\nARGATROBAN-INR ARTIFACT\nDTI prolongs PT with NO\nfactor depletion"];
    TR_INRFAL [label="거짓 치료적 INR\nFalsely therapeutic INR\n→ premature DTI cessation\n→ patient UNCOVERED"];
    TR_FXACT  [label="FX 활성 측정\nChromogenic factor X\n(the correct surrogate\nduring overlap)"];
    TR_VITK   [label="비타민 K 투여\nVitamin K reversal\n(if VKA started early)"];
  }

