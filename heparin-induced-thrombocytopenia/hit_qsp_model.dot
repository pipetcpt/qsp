     ================================================================ */
  subgraph cluster_trap {
    label="19 · 두 가지 약리학적 함정 (The Two Pharmacological Traps)  ★ 반감기 불일치";
    style="filled,rounded"; color="#E65100"; fillcolor="#FFF3E0"; fontsize=11;
    node [shape=box, fillcolor="#FFCC80", color="#E65100"];

