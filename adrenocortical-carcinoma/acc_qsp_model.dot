/* ===========================================================================
   acc_qsp_model.dot
   Adrenocortical Carcinoma (ACC) — mechanistic QSP map
   부신피질암 (ACC) 기계론적 QSP 지도

   ORGANISING THESIS (see README.md):

     Plasma mitotane is not a dose.  It is the OVERFLOW of a slowly filling
     lipid depot.  Mitotane (o,p'-DDD, logP ~ 5.9) distributes into an
     apparent volume of ~6,000 L — roughly 75x total body water — which is
     overwhelmingly ADIPOSE.  For a constant intake the plasma trough obeys

         Cp(t)  =  (D * F / CL) * [ 1 - exp(-t * CL / Vss) ]
                    \__________/    \_________________________/
                     WHERE it ends              WHEN it gets there
                     (dose / clearance)         (Vss / CL  ~  50-110 days)

     and the therapeutic action is a THRESHOLD on Cp (>= 14 mg/L), while the
     neurotoxicity is a second threshold on the same Cp (> 20 mg/L).

     The whole clinical personality of this drug — and of this disease's
     drug therapy — falls out of the fact that ONE state variable, the amount
     of mitotane sitting in fat, is read THREE ways that pull in OPPOSITE
     directions:

       (1) BENEFIT.  Above ~14 mg/L mitotane (a) inhibits SOAT1, so free
           cholesterol and oxysterols accumulate in the adrenocortical ER ->
           ER stress -> apoptosis (ADRENOLYSIS, slow and IRREVERSIBLE), and
           (b) directly inhibits CYP11A1 / CYP11B1 / 3beta-HSD, blocking
           cortisol synthesis (FAST and REVERSIBLE).  Two benefits, two
           time-scales, from one concentration.

       (2) HARM #1 - the drug eats its own partners.  The same exposure is a
           powerful inducer of CYP3A4 / CYP2B6 / UGT / SULT.  That induction
           integral (a) doubles etoposide clearance, halving the exposure of
           the cytotoxic backbone it is supposed to be helping; (b) doubles
           hydrocortisone clearance, so the standard 20 mg/day replacement
           silently under-replaces; and (c) accelerates mitotane's OWN
           clearance (autoinduction), so Css DRIFTS DOWN on a fixed dose.

       (3) HARM #2.  Above ~20 mg/L the same molecule produces ataxia,
           dysarthria and confusion.  The therapeutic window is a 6 mg/L
           slot on a variable whose between-patient CV is 81.5%.

     Six consequences are then ARITHMETIC rather than assertion:

       A. FAT SETS *WHEN*, NOT *WHERE*.  Doubling adipose mass doubles Vss,
          which does not change Css (= D*F/CL) at all but roughly doubles the
          time constant.  A lean patient crosses 14 mg/L in ~3 weeks and then
          overshoots 20; an obese patient on the SAME regimen crosses it at
          ~10 weeks and then keeps a therapeutic tail for half a year after
          stopping.  Same dose, same endpoint, different disease.

       B. THE RCT RANDOMISED THE SMALLER VARIABLE.  Arshad 2018 puts the
          inter-individual CV of V at 81.5%.  Doubling the starting dose
          moves time-to-target by ~40%; one SD of body composition moves it
          by more.  A trial that randomises DOSE but does not stratify on
          BODY COMPOSITION is underpowered by construction — which is
          exactly what the two-starting-dose RCT reported (no significant
          difference), while the popPK model of the same drug recommends the
          high-dose start.  Both are right.

       C. HYPERCORTISOLISM DIGS THE HOLE IT SITS IN.  Cortisol excess adds
          visceral fat.  Fat is the depot.  So the hormone the drug is meant
          to suppress ENLARGES the compartment that delays the drug — a
          positive feedback on time-to-control that no dose adjustment can
          see, because the dose is right and the clock is wrong.

       D. EDP-M IS WEAKEST WHERE MITOTANE IS STRONGEST.  Induction tracks
          the depot, not the dose.  So etoposide exposure is at its LOWEST
          precisely in the patients who have finally reached therapeutic
          mitotane levels.  The combination's two halves are anticorrelated
          THROUGH THE SHARED STATE VARIABLE.

       E. TOTAL CORTISOL LIES.  Mitotane has an oestrogenic action on the
          liver and roughly DOUBLES CBG.  Free cortisol = f(total, CBG), so a
          clinician who titrates hydrocortisone on TOTAL cortisol sees a
          reassuring number generated by a doubled carrier and a halved free
          fraction — and under-replaces a patient whose hydrocortisone
          clearance is simultaneously doubled by induction.  Two independent
          errors, same direction.

       F. CORTISOL IS AN IMMUNOSUPPRESSANT THE TUMOUR MAKES ITSELF.
          Glucocorticoid excess depletes tumour-infiltrating lymphocytes.
          So a cortisol-secreting ACC arrives at the checkpoint inhibitor
          having already administered its own steroid pre-medication — which
          is why PD-1 blockade in ACC returns ~15% ORR overall and does
          worse in the secreting subset, and why controlling the steroid is
          a prerequisite for, not an alternative to, immunotherapy.

     Everything drawn below is one of those three reads, or a feedback that
     changes the CLOCK rather than the SET-POINT.

   LEGEND
     box3d / cylinder  = ODE compartment in acc_mrgsolve_model.R
     ellipse           = signalling species / mediator
     hexagon           = drug or drug product
     octagon           = measured clinical endpoint / biomarker readout
     diamond           = switch, threshold or logical gate
     parallelogram     = clinical decision / dosing action
     solid arrow       = mass flow / activation
     dashed arrow      = modulation / signalling
     bar-headed (tee)  = inhibition
     red edge          = harm axis
     green edge        = benefit axis
     blue edge         = pharmacokinetic transfer
   =========================================================================== */

digraph ACC_QSP {
    rankdir = TB;
    compound = true;
    newrank = true;
    splines = spline;
    concentrate = false;
    nodesep = 0.22;
    ranksep = 0.42;
    fontname = "Helvetica";
    labelloc = "t";
    fontsize = 30;
    label = <<b>Adrenocortical Carcinoma (ACC) — Quantitative Systems Pharmacology Map</b><br/>
             <font point-size="17">부신피질암 · One lipid depot, read three ways: adrenolysis (benefit) · CYP3A4 induction (harm) · CNS threshold (harm)</font><br/>
             <font point-size="14">mitotane depot PK · steroidogenesis · EDP-M · CBG assay artefact · IGF2/IGF1R · glucocorticoid-mediated immune escape</font>>;

    node [fontname="Helvetica", fontsize=11, style="filled", penwidth=1.1];
    edge [fontname="Helvetica", fontsize=9, penwidth=1.0, arrowsize=0.65];

    /* ---- colour palette ------------------------------------------------ */
    /* tumour  #f3c9c0 | steroid #ffe6a8 | PK #cfe0f5 | induction #e2d2f0
       immune  #cfe9d8 | tox #f2b8b8 | endpoint #dfe3e8 | decision #fff2c2 */

/* =======================================================================
   CLUSTER 00 — PATIENT / BODY COMPOSITION  (the clock)
   ======================================================================= */
subgraph cluster_body {
    label = <<b>0. 환자 · 체성분 (Patient &amp; Body Composition)</b><br/><font point-size="9">sets the mitotane TIME CONSTANT, not its set-point</font>>;
    style = "filled"; fillcolor = "#f7f7f2"; color = "#9a9a86"; fontsize = 14;

    WT      [label="Body weight\nWT (kg)", shape=box3d, fillcolor="#eceade"];
    FATKG   [label="Adipose mass\nFATKG (kg)\n[ODE: cortisol-driven]", shape=box3d, fillcolor="#eceade", penwidth=2.4, color="#8a6d1f"];
    LEANKG  [label="Lean mass\nLEANKG (kg)", shape=box3d, fillcolor="#eceade"];
    BMI     [label="BMI\n(covariate on V)", shape=octagon, fillcolor="#dfe3e8"];
    BSA     [label="BSA (m²)\nchemo dosing", shape=octagon, fillcolor="#dfe3e8"];
    AGE     [label="Age / sex", shape=ellipse, fillcolor="#eceade"];
    ALB     [label="Albumin", shape=ellipse, fillcolor="#eceade"];
    DIET    [label="Fat content of\nco-administered meal", shape=parallelogram, fillcolor="#fff2c2"];

    FATKG -> BMI  [style=dashed];
    WT -> BMI     [style=dashed];
    WT -> BSA     [style=dashed];
    LEANKG -> WT;
    FATKG -> WT;
    AGE -> WT [style=dotted];
}

/* =======================================================================
   CLUSTER 01 — GENOMIC DRIVERS
   ======================================================================= */
subgraph cluster_genomic {
    label = <<b>1. 유전체 드라이버 (Genomic Drivers of ACC)</b><br/><font point-size="9">TCGA / ENSAT: IGF2 ~90% · TP53 ~21% · ZNRF3 ~19% · CTNNB1 ~16%</font>>;
    style = "filled"; fillcolor = "#fdf1ee"; color = "#b5766a"; fontsize = 14;

    LOI11p15 [label="11p15 loss of\nimprinting (~90%)", shape=ellipse, fillcolor="#f3c9c0"];
    IGF2gene [label="IGF2 overexpression\n(50–100x normal cortex)", shape=ellipse, fillcolor="#f3c9c0", penwidth=2.0];
    TP53mut  [label="TP53 mutation /\nLi-Fraumeni (~21%)", shape=ellipse, fillcolor="#f3c9c0"];
    ZNRF3mut [label="ZNRF3 loss (~19%)\nE3 ligase for FZD", shape=ellipse, fillcolor="#f3c9c0"];
    CTNNB1m  [label="CTNNB1 activating\nmutation (~16%)", shape=ellipse, fillcolor="#f3c9c0"];
    WNT      [label="Wnt / β-catenin\nconstitutive signalling", shape=ellipse, fillcolor="#f3c9c0"];
    TERTact  [label="TERT / telomere\nmaintenance", shape=ellipse, fillcolor="#f3c9c0"];
    PRKAR1A  [label="PRKAR1A / cAMP\npathway lesions", shape=ellipse, fillcolor="#f3c9c0"];
    CDKN2A   [label="CDKN2A loss\nRB1 pathway", shape=ellipse, fillcolor="#f3c9c0"];
    STEROIDOG_PHEN [label="Steroidogenic\nphenotype (secretor)\n~60% of ACC", shape=diamond, fillcolor="#ffe6a8", penwidth=2.0];
    KI67     [label="Ki-67 index\n(prognostic, %)", shape=octagon, fillcolor="#dfe3e8"];
    ENSATst  [label="ENSAT stage I–IV\nR0/R1/R2 resection", shape=octagon, fillcolor="#dfe3e8"];
    CYP2W1   [label="CYP2W1 expression\n(mitotane response marker)", shape=ellipse, fillcolor="#f3c9c0"];
    SOAT1exp [label="SOAT1 expression\n(mitotane target level)", shape=ellipse, fillcolor="#f3c9c0", penwidth=2.0];
    MMRstat  [label="MMR deficiency /\nTMB (rare, ~4%)", shape=ellipse, fillcolor="#f3c9c0"];

    LOI11p15 -> IGF2gene;
    ZNRF3mut -> WNT;
    CTNNB1m -> WNT;
    WNT -> STEROIDOG_PHEN [style=dashed, label="GC secretion\nassociation"];
    TP53mut -> KI67 [style=dashed];
    CDKN2A -> KI67 [style=dashed];
    TERTact -> KI67 [style=dotted];
    PRKAR1A -> STEROIDOG_PHEN [style=dashed];
}

/* =======================================================================
   CLUSTER 02 — TUMOUR GROWTH & CLONAL RESISTANCE
   ======================================================================= */
subgraph cluster_tumour {
    label = <<b>2. 종양 성장 · 내성 클론 (Tumour Growth &amp; Clonal Resistance)</b><br/><font point-size="9">Gompertz growth; resistant clone pre-exists and is selected, not created</font>>;
    style = "filled"; fillcolor = "#fdeeeb"; color = "#b5766a"; fontsize = 14;

    TUMS   [label="Sensitive tumour\nTUMS (mL)\n[ODE]", shape=cylinder, fillcolor="#f3c9c0", penwidth=2.4, color="#8b3a2c"];
    TUMR   [label="Resistant clone\nTUMR (mL)\n[ODE]", shape=cylinder, fillcolor="#e8a89c", penwidth=2.4, color="#8b3a2c"];
    TUMTOT [label="Total tumour burden\nTUMTOT = TUMS + TUMR", shape=octagon, fillcolor="#dfe3e8", penwidth=2.0];
    KGROW  [label="Intrinsic growth\nk_grow (Gompertz)", shape=ellipse, fillcolor="#f3c9c0"];
    TVMAX  [label="Carrying capacity\nTVmax", shape=ellipse, fillcolor="#f3c9c0"];
    PROLIF [label="Proliferation drive\n(IGF/AKT + Wnt)", shape=ellipse, fillcolor="#f3c9c0"];
    APOP   [label="Apoptotic flux\n(caspase-3)", shape=ellipse, fillcolor="#f3c9c0"];
    HYPOX  [label="Tumour hypoxia\nVEGF-A", shape=ellipse, fillcolor="#f3c9c0"];
    ANGIO  [label="Neoangiogenesis\n(drug delivery term)", shape=ellipse, fillcolor="#f3c9c0"];
    MUTSW  [label="Resistance switch\nk_res selection", shape=diamond, fillcolor="#fff2c2"];
    METLIV [label="Hepatic metastases", shape=box, fillcolor="#f3c9c0"];
    METLUN [label="Pulmonary metastases", shape=box, fillcolor="#f3c9c0"];
    METBON [label="Bone metastases", shape=box, fillcolor="#f3c9c0"];

    KGROW -> TUMS; TVMAX -> TUMS [style=dashed, arrowhead=tee, label="density\nbrake"];
    KGROW -> TUMR; TVMAX -> TUMR [style=dashed, arrowhead=tee];
    PROLIF -> KGROW [style=dashed];
    APOP -> TUMS [arrowhead=tee, color="#2e7d32"];
    TUMS -> MUTSW [style=dotted]; MUTSW -> TUMR [style=dotted, label="selection"];
    TUMS -> TUMTOT; TUMR -> TUMTOT;
    TUMTOT -> HYPOX [style=dashed]; HYPOX -> ANGIO [style=dashed];
    ANGIO -> TUMS [style=dotted];
    TUMTOT -> METLIV [style=dotted]; TUMTOT -> METLUN [style=dotted]; TUMTOT -> METBON [style=dotted];
    IGF2gene -> PROLIF [style=dashed];
    WNT -> PROLIF [style=dashed];
    KI67 -> KGROW [style=dashed];
}

/* =======================================================================
   CLUSTER 03 — ADRENAL STEROIDOGENESIS
   ======================================================================= */
subgraph cluster_steroid {
    label = <<b>3. 부신 스테로이드 생성 (Adrenocortical Steroidogenesis)</b><br/><font point-size="9">mitotane hits the pathway at THREE enzymes and at the cholesterol ester store</font>>;
    style = "filled"; fillcolor = "#fff9e8"; color = "#b39338"; fontsize = 14;

    LDLR    [label="LDL-R / SR-B1\ncholesterol uptake", shape=ellipse, fillcolor="#ffe6a8"];
    CE_STORE[label="Cholesteryl ester\ndroplet store\n[ODE: CEST]", shape=cylinder, fillcolor="#ffe6a8", penwidth=2.0];
    SOAT1   [label="SOAT1 / ACAT1\nesterifies free cholesterol", shape=ellipse, fillcolor="#ffe6a8", penwidth=2.4, color="#8a6d1f"];
    FREECHOL[label="Free cholesterol +\noxysterols (toxic pool)\n[ODE: FCHOL]", shape=cylinder, fillcolor="#ffd98a", penwidth=2.4, color="#8a6d1f"];
    STAR    [label="StAR\nmitochondrial import", shape=ellipse, fillcolor="#ffe6a8"];
    CYP11A1 [label="CYP11A1 (SCC)\nchol → pregnenolone", shape=ellipse, fillcolor="#ffe6a8", penwidth=2.0];
    PREG    [label="Pregnenolone", shape=box, fillcolor="#fff3cf"];
    HSD3B2  [label="3β-HSD2", shape=ellipse, fillcolor="#ffe6a8"];
    CYP17A1 [label="CYP17A1\n(17α-OH / 17,20-lyase)", shape=ellipse, fillcolor="#ffe6a8"];
    OHP17   [label="17-OH-progesterone\n[ODE: OHP17]", shape=box, fillcolor="#fff3cf"];
    CYP21A2 [label="CYP21A2", shape=ellipse, fillcolor="#ffe6a8"];
    CYP11B1 [label="CYP11B1\n11-deoxycortisol → cortisol", shape=ellipse, fillcolor="#ffe6a8", penwidth=2.0];
    CYP11B2 [label="CYP11B2 (aldo synthase)\nzona glomerulosa", shape=ellipse, fillcolor="#ffe6a8"];
    DOC     [label="11-deoxycortisol\n(rises under blockade)", shape=box, fillcolor="#fff3cf"];
    CORT_SYN[label="Cortisol synthesis flux\nk_syn", shape=ellipse, fillcolor="#ffe6a8", penwidth=2.0];
    DHEAS   [label="DHEA-S\n[ODE: DHEAS]", shape=box, fillcolor="#fff3cf"];
    ANDRO   [label="Androstenedione /\n11-oxyandrogens", shape=box, fillcolor="#fff3cf"];
    ALDO    [label="Aldosterone\n[ODE: ALDO]", shape=box, fillcolor="#fff3cf"];
    ZFASC   [label="Normal adrenal\nzona fasciculata mass\n[ODE: ADRN]", shape=cylinder, fillcolor="#ffdd94", penwidth=2.4, color="#8a6d1f"];
    TUMSTER [label="Tumour steroidogenic\ncapacity [ODE: STCAP]", shape=cylinder, fillcolor="#ffdd94", penwidth=2.4, color="#8a6d1f"];
    URSTER  [label="Urine steroid\nmetabolomics profile", shape=octagon, fillcolor="#dfe3e8"];

    LDLR -> FREECHOL; FREECHOL -> SOAT1 [style=dashed];
    SOAT1 -> CE_STORE; CE_STORE -> FREECHOL [label="hydrolysis (HSL)"];
    FREECHOL -> STAR; STAR -> CYP11A1; CYP11A1 -> PREG;
    PREG -> HSD3B2; HSD3B2 -> CYP21A2; PREG -> CYP17A1;
    CYP17A1 -> OHP17; OHP17 -> CYP21A2; CYP21A2 -> DOC;
    DOC -> CYP11B1; CYP11B1 -> CORT_SYN;
    CYP17A1 -> DHEAS [label="17,20-lyase"]; DHEAS -> ANDRO [style=dotted];
    CYP11B2 -> ALDO;
    ZFASC -> CORT_SYN [style=dashed, label="normal-gland\ncapacity"];
    TUMSTER -> CORT_SYN [style=dashed, label="autonomous\ntumour output"];
    TUMS -> TUMSTER [style=dashed, label="burden x\nsecretor phenotype"];
    STEROIDOG_PHEN -> TUMSTER [style=dashed, penwidth=1.8];
    DHEAS -> URSTER [style=dotted]; OHP17 -> URSTER [style=dotted]; DOC -> URSTER [style=dotted];
}

/* =======================================================================
   CLUSTER 04 — HPA AXIS & HYPERCORTISOLISM
   ======================================================================= */
subgraph cluster_hpa {
    label = <<b>4. HPA 축 · 코르티솔 과잉의 결과 (HPA Axis &amp; Sequelae of Cortisol Excess)</b><br/><font point-size="9">the fat that cortisol builds is the depot that delays the drug (feedback C)</font>>;
    style = "filled"; fillcolor = "#fff6ec"; color = "#b3873a"; fontsize = 14;

    CRH     [label="Hypothalamic CRH", shape=ellipse, fillcolor="#ffe6a8"];
    ACTH    [label="Pituitary ACTH\n[ODE: ACTH]", shape=cylinder, fillcolor="#ffe6a8", penwidth=2.0];
    CORT    [label="Total plasma cortisol\n[ODE: CORT]", shape=cylinder, fillcolor="#ffd98a", penwidth=2.4, color="#8a6d1f"];
    FCORT   [label="FREE cortisol\n(the biologically active one)", shape=octagon, fillcolor="#ffcf6e", penwidth=2.4, color="#8a6d1f"];
    GR      [label="Glucocorticoid receptor\noccupancy [ODE: GRO]", shape=cylinder, fillcolor="#ffe6a8", penwidth=2.0];
    CONTRAT [label="Contralateral adrenal\natrophy (ACTH-suppressed)", shape=box, fillcolor="#fff3cf"];
    CUSHING [label="Cushingoid phenotype\n(Clinical)", shape=octagon, fillcolor="#dfe3e8", penwidth=2.0];
    HYPERGLY[label="Steroid diabetes\n(hepatic gluconeogenesis↑)", shape=octagon, fillcolor="#dfe3e8"];
    HTN     [label="Hypertension\n(MR occupancy at high F)", shape=octagon, fillcolor="#dfe3e8"];
    HYPOKAL [label="Hypokalaemic alkalosis", shape=octagon, fillcolor="#dfe3e8"];
    MYOPATH [label="Proximal myopathy\n[ODE: MUSC]", shape=cylinder, fillcolor="#ffe6a8"];
    BMD     [label="Bone mineral density\n[ODE: BMD]", shape=cylinder, fillcolor="#ffe6a8"];
    VISCFAT [label="Visceral / truncal\nfat accretion", shape=ellipse, fillcolor="#ffcf6e", penwidth=2.4, color="#8a6d1f"];
    THROMB  [label="Hypercoagulability\n(VTE risk)", shape=octagon, fillcolor="#dfe3e8"];
    INFECT  [label="Opportunistic infection\n(PJP) risk", shape=octagon, fillcolor="#dfe3e8"];
    MOOD    [label="Neuropsychiatric\n(mood, cognition)", shape=octagon, fillcolor="#dfe3e8"];

    CRH -> ACTH; ACTH -> ZFASC [style=dashed, label="trophic"];
    CORT_SYN -> CORT; CORT -> FCORT [penwidth=2.0];
    CORT -> ACTH [arrowhead=tee, style=dashed, label="negative feedback"];
    CORT -> CRH  [arrowhead=tee, style=dashed];
    ACTH -> CONTRAT [arrowhead=tee, style=dashed, label="suppressed → atrophy"];
    FCORT -> GR [penwidth=2.0];
    GR -> CUSHING; GR -> HYPERGLY; GR -> HTN; GR -> HYPOKAL;
    GR -> MYOPATH [arrowhead=tee]; GR -> BMD [arrowhead=tee];
    GR -> VISCFAT [penwidth=2.4, color="#8a6d1f"];
    GR -> THROMB; GR -> INFECT; GR -> MOOD;
    VISCFAT -> FATKG [penwidth=2.4, color="#c62828", label="  FEEDBACK C:\n  grows the depot  "];
    ALDO -> HTN [style=dashed]; ALDO -> HYPOKAL [style=dashed];
}

/* =======================================================================
   CLUSTER 05 — MITOTANE PHARMACOKINETICS (the depot)
   ======================================================================= */
subgraph cluster_mitpk {
    label = <<b>5. 미토테인 PK — 지방 저장고 (Mitotane PK: the Lipid Depot)</b><br/><font point-size="9">Vss ≈ 6,000 L (CV 81.5%) · t½ 18–160 d · therapeutic slot 14–20 mg/L</font>>;
    style = "filled"; fillcolor = "#eaf1fb"; color = "#5b7fae"; fontsize = 14;

    MITDOSE [label="Mitotane tablets\n(o,p'-DDD, 500 mg)\n1–6 g/day divided", shape=hexagon, fillcolor="#9dc3e6", penwidth=2.0];
    MITGUT  [label="Gut depot\n[ODE: MITG]", shape=box3d, fillcolor="#cfe0f5"];
    FBIO    [label="Bioavailability F ≈ 0.30–0.55\nfat-meal dependent", shape=diamond, fillcolor="#fff2c2", penwidth=2.0];
    MITC    [label="Plasma mitotane\n[ODE: MITC]  (mg/L)", shape=cylinder, fillcolor="#9dc3e6", penwidth=2.8, color="#1f4e79"];
    MITADI  [label="ADIPOSE DEPOT\n[ODE: MITA]\nVadi = Kp_fat x FATKG", shape=cylinder, fillcolor="#7fb0dd", penwidth=3.0, color="#1f4e79"];
    MITCNS  [label="CNS effect site\n[ODE: MITCNS]", shape=cylinder, fillcolor="#cfe0f5", penwidth=2.0];
    MITADR  [label="Adrenal / tumour\neffect site [ODE: MITE]", shape=cylinder, fillcolor="#cfe0f5", penwidth=2.0];
    DDA     [label="o,p'-DDA\n(major inactive metabolite)", shape=box, fillcolor="#e3edf9"];
    DDE     [label="o,p'-DDE\n(accumulates)", shape=box, fillcolor="#e3edf9"];
    CLMIT   [label="Mitotane CL\n(rises: AUTOINDUCTION)", shape=ellipse, fillcolor="#cfe0f5", penwidth=2.0];
    TAU     [label="Time constant\nτ = Vss / CL  (50–110 d)", shape=diamond, fillcolor="#fff2c2", penwidth=2.4];
    CSS     [label="Set-point\nCss = D·F / CL", shape=diamond, fillcolor="#fff2c2", penwidth=2.4];
    TDM     [label="TDM trough level\n(mg/L, day 16 then q2–4 wk)", shape=octagon, fillcolor="#dfe3e8", penwidth=2.0];
    THR14   [label="THRESHOLD 1\nCp ≥ 14 mg/L\n(efficacy)", shape=diamond, fillcolor="#c8e6c9", penwidth=2.6, color="#2e7d32"];
    THR20   [label="THRESHOLD 2\nCp > 20 mg/L\n(neurotoxicity)", shape=diamond, fillcolor="#ffcdd2", penwidth=2.6, color="#c62828"];

    MITDOSE -> MITGUT; DIET -> FBIO [style=dashed]; FBIO -> MITGUT [style=dashed];
    MITGUT -> MITC [color="#1f4e79", label="ka"];
    MITC -> MITADI [color="#1f4e79", penwidth=2.6, dir=both, label="  Q_adi\n  perfusion/permeability-limited  "];
    FATKG -> MITADI [style=dashed, penwidth=2.6, color="#8a6d1f", label="  sets depot VOLUME  "];
    MITC -> MITCNS [color="#1f4e79", style=dashed];
    MITC -> MITADR [color="#1f4e79", style=dashed];
    MITC -> DDA [color="#1f4e79"]; MITC -> DDE [color="#1f4e79"];
    CLMIT -> MITC [arrowhead=tee, color="#1f4e79", penwidth=1.8];
    MITADI -> TAU [style=dotted]; CLMIT -> TAU [style=dotted];
    CLMIT -> CSS [style=dotted]; MITDOSE -> CSS [style=dotted]; FBIO -> CSS [style=dotted];
    MITC -> TDM; TDM -> THR14 [style=dotted]; TDM -> THR20 [style=dotted];
}

/* =======================================================================
   CLUSTER 06 — MITOTANE PD #1: ADRENOLYSIS (slow, irreversible) — BENEFIT
   ======================================================================= */
subgraph cluster_adrenolysis {
    label = <<b>6. 미토테인 PD ① 부신파괴 (Adrenolysis — slow, IRREVERSIBLE)</b><br/><font point-size="9">SOAT1 inhibition → free cholesterol/oxysterol load → ER stress → apoptosis</font>>;
    style = "filled"; fillcolor = "#eaf6ec"; color = "#4e8b57"; fontsize = 14;

    SOAT1INH [label="SOAT1 inhibition\nby mitotane", shape=ellipse, fillcolor="#cfe9d8", penwidth=2.4, color="#2e7d32"];
    OXYSTER  [label="Oxysterol /\nfree-cholesterol overload", shape=ellipse, fillcolor="#cfe9d8"];
    ERSTRESS [label="ER stress\n(CHOP, ATF4, XBP1s)", shape=ellipse, fillcolor="#cfe9d8", penwidth=2.0];
    MITOCHOND[label="Mitochondrial injury\n(complex IV, ΔΨm↓)", shape=ellipse, fillcolor="#cfe9d8"];
    ROSacc   [label="ROS / lipid\nperoxidation", shape=ellipse, fillcolor="#cfe9d8"];
    FERROPT  [label="Ferroptosis\nsusceptibility (GPX4)", shape=ellipse, fillcolor="#cfe9d8"];
    CASP     [label="Caspase-3 activation\n→ apoptosis", shape=ellipse, fillcolor="#cfe9d8", penwidth=2.0];
    ADRLYSIS [label="Adrenolytic flux\nk_lysis (zona fasciculata\nand reticularis)", shape=ellipse, fillcolor="#a5d6a7", penwidth=2.4, color="#2e7d32"];
    NEVANIM  [label="Nevanimibe\n(selective SOAT1 inhibitor,\nphase 1)", shape=hexagon, fillcolor="#9dc3e6"];

    MITADR -> SOAT1INH [penwidth=2.2, color="#2e7d32"];
    SOAT1exp -> SOAT1INH [style=dashed, label="target abundance"];
    NEVANIM -> SOAT1INH [color="#2e7d32"];
    SOAT1INH -> SOAT1 [arrowhead=tee, penwidth=2.2, color="#2e7d32"];
    SOAT1INH -> OXYSTER [penwidth=2.0]; FREECHOL -> OXYSTER [style=dashed];
    OXYSTER -> ERSTRESS [penwidth=2.0];
    MITADR -> MITOCHOND [color="#2e7d32"]; MITOCHOND -> ROSacc;
    ROSacc -> FERROPT [style=dashed]; CORT_SYN -> FERROPT [style=dashed, label="active synthesis\nsensitises"];
    ERSTRESS -> CASP [penwidth=2.0]; MITOCHOND -> CASP; FERROPT -> CASP [style=dashed];
    CASP -> ADRLYSIS [penwidth=2.2];
    ADRLYSIS -> ZFASC [arrowhead=tee, penwidth=2.6, color="#2e7d32", label="  irreversible  "];
    ADRLYSIS -> TUMSTER [arrowhead=tee, penwidth=2.4, color="#2e7d32"];
    CASP -> APOP [penwidth=2.0, color="#2e7d32", label="cytotoxic arm\n(weak vs tumour)"];
    CYP2W1 -> CASP [style=dashed, label="bioactivation?"];
}

/* =======================================================================
   CLUSTER 07 — MITOTANE PD #2: ENZYME BLOCKADE (fast, reversible) — BENEFIT
   ======================================================================= */
subgraph cluster_enzblock {
    label = <<b>7. 미토테인 PD ② 스테로이드 합성 효소 차단 (Enzyme Blockade — fast, REVERSIBLE)</b><br/><font point-size="9">the reason cortisol falls in weeks while the gland only shrinks in months</font>>;
    style = "filled"; fillcolor = "#f0f7ea"; color = "#6b8b4e"; fontsize = 14;

    INH11A1 [label="CYP11A1 inhibition", shape=ellipse, fillcolor="#dcedc8", penwidth=2.0];
    INH11B1 [label="CYP11B1 inhibition", shape=ellipse, fillcolor="#dcedc8", penwidth=2.0];
    INH3B2  [label="3β-HSD2 inhibition", shape=ellipse, fillcolor="#dcedc8"];
    INH5AR  [label="5α-reductase inhibition\n(→ androgen replacement need)", shape=ellipse, fillcolor="#dcedc8"];
    FASTBLK [label="FAST reversible block\nof cortisol synthesis\n(days–weeks)", shape=diamond, fillcolor="#c8e6c9", penwidth=2.4, color="#2e7d32"];
    OTHERSTER [label="Other steroidogenesis\ninhibitors: metyrapone,\nketoconazole, osilodrostat,\nmitotane-sparing control", shape=hexagon, fillcolor="#9dc3e6"];
    ETOMID  [label="Etomidate\n(rescue, IV, hours)", shape=hexagon, fillcolor="#9dc3e6"];

    MITADR -> INH11A1 [color="#2e7d32"]; MITADR -> INH11B1 [color="#2e7d32"];
    MITADR -> INH3B2 [color="#2e7d32"]; MITADR -> INH5AR [color="#2e7d32"];
    INH11A1 -> CYP11A1 [arrowhead=tee, penwidth=2.0, color="#2e7d32"];
    INH11B1 -> CYP11B1 [arrowhead=tee, penwidth=2.0, color="#2e7d32"];
    INH3B2 -> HSD3B2 [arrowhead=tee, color="#2e7d32"];
    INH11B1 -> DOC [label="substrate\naccumulates", style=dashed];
    INH11A1 -> FASTBLK; INH11B1 -> FASTBLK; INH3B2 -> FASTBLK;
    FASTBLK -> CORT_SYN [arrowhead=tee, penwidth=2.6, color="#2e7d32"];
    OTHERSTER -> CYP11B1 [arrowhead=tee, color="#2e7d32"];
    ETOMID -> CYP11A1 [arrowhead=tee, color="#2e7d32"];
    INH5AR -> ANDRO [arrowhead=tee, style=dashed];
}

/* =======================================================================
   CLUSTER 08 — CYP3A4 INDUCTION HUB — HARM #1
   ======================================================================= */
subgraph cluster_induction {
    label = <<b>8. CYP3A4/2B6 유도 허브 — 약이 자기 파트너를 먹는다 (Induction Hub: HARM #1)</b><br/><font point-size="9">ONE induction state, FOUR victims: etoposide · hydrocortisone · mitotane itself · everything else</font>>;
    style = "filled"; fillcolor = "#f2ecf8"; color = "#7e5aa2"; fontsize = 14;

    PXR      [label="PXR / CAR\nnuclear receptor activation", shape=ellipse, fillcolor="#e2d2f0", penwidth=2.0];
    ENZ3A4   [label="CYP3A4 activity\n[ODE: ENZ] (1 → ~4x)\nturnover t½ ≈ 4–5 d", shape=cylinder, fillcolor="#c9aede", penwidth=3.0, color="#5e35b1"];
    ENZ2B6   [label="CYP2B6 · UGT · SULT\nco-induction", shape=ellipse, fillcolor="#e2d2f0"];
    PGP      [label="P-gp / ABCB1\ninduction", shape=ellipse, fillcolor="#e2d2f0"];
    INDINT   [label="INDUCTION INTEGRAL\n∫ENZ dt — tracks the DEPOT,\nnot the dose", shape=diamond, fillcolor="#d1c4e9", penwidth=2.6, color="#5e35b1"];
    DDI_ETO  [label="Etoposide CL ↑ ~2x", shape=octagon, fillcolor="#f2b8b8", penwidth=2.0];
    DDI_HC   [label="Hydrocortisone CL ↑ ~2x\n→ 20 mg/day under-replaces", shape=octagon, fillcolor="#f2b8b8", penwidth=2.4];
    DDI_MIT  [label="Mitotane CL ↑\n→ Css DRIFTS DOWN", shape=octagon, fillcolor="#f2b8b8", penwidth=2.2];
    DDI_SUNI [label="Sunitinib / TKI exposure ↓\n(SIRAC)", shape=octagon, fillcolor="#f2b8b8"];
    DDI_WARF [label="Warfarin, DOAC,\nmidazolam, opioids,\nantiretrovirals affected", shape=octagon, fillcolor="#f2b8b8"];
    DDI_LEVO [label="Levothyroxine / sex-steroid\nrequirements ↑", shape=octagon, fillcolor="#f2b8b8"];
    PERSIST  [label="Induction PERSISTS\nmonths after stopping\n(depot keeps dosing)", shape=diamond, fillcolor="#ffcdd2", penwidth=2.4, color="#c62828"];

    MITC -> PXR [penwidth=2.4, color="#5e35b1"];
    PXR -> ENZ3A4 [penwidth=2.6, color="#5e35b1"]; PXR -> ENZ2B6; PXR -> PGP;
    ENZ3A4 -> INDINT [penwidth=2.2];
    INDINT -> DDI_ETO [color="#c62828", penwidth=2.0];
    INDINT -> DDI_HC  [color="#c62828", penwidth=2.4];
    INDINT -> DDI_MIT [color="#c62828", penwidth=2.0];
    INDINT -> DDI_SUNI [color="#c62828"];
    INDINT -> DDI_WARF [color="#c62828"];
    ENZ2B6 -> DDI_LEVO [color="#c62828"];
    DDI_MIT -> CLMIT [penwidth=2.2, color="#c62828", label="  autoinduction  "];
    MITADI -> PERSIST [style=dashed, penwidth=2.2, color="#c62828"];
    PERSIST -> ENZ3A4 [style=dashed, color="#c62828"];
}

/* =======================================================================
   CLUSTER 09 — EDP CYTOTOXIC CHEMOTHERAPY
   ======================================================================= */
subgraph cluster_edp {
    label = <<b>9. EDP 세포독성 항암화학 (Etoposide · Doxorubicin · Cisplatin)</b><br/><font point-size="9">FIRM-ACT: EDP-M ORR 23.2% / PFS 5.0 mo vs Sz-M 9.2% / 2.1 mo; OS 14.8 vs 12.0 mo (NS)</font>>;
    style = "filled"; fillcolor = "#eaf1fb"; color = "#5b7fae"; fontsize = 14;

    ETODOSE [label="Etoposide\n100 mg/m² d2–4 q28d", shape=hexagon, fillcolor="#9dc3e6", penwidth=2.0];
    ETOC    [label="Etoposide plasma\n[ODE: ETOC]", shape=cylinder, fillcolor="#cfe0f5", penwidth=2.0];
    ETOP    [label="Etoposide peripheral\n[ODE: ETOP]", shape=box3d, fillcolor="#cfe0f5"];
    ETOAUC  [label="Etoposide AUC\n(the variable induction destroys)", shape=octagon, fillcolor="#dfe3e8", penwidth=2.4];
    TOP2    [label="Topoisomerase IIα\ncleavable complex", shape=ellipse, fillcolor="#cfe0f5"];
    DOXDOSE [label="Doxorubicin\n40 mg/m² d1 q28d", shape=hexagon, fillcolor="#9dc3e6"];
    DOXC    [label="Doxorubicin plasma\n[ODE: DOXC]", shape=cylinder, fillcolor="#cfe0f5"];
    DOXP    [label="Doxorubicin tissue\n[ODE: DOXP]", shape=box3d, fillcolor="#cfe0f5"];
    DOXCUM  [label="Cumulative anthracycline\n[ODE: DOXCUM] mg/m²", shape=cylinder, fillcolor="#cfe0f5", penwidth=2.0];
    CISDOSE [label="Cisplatin\n40 mg/m² d3–4 q28d", shape=hexagon, fillcolor="#9dc3e6"];
    CISC    [label="Cisplatin (free Pt)\n[ODE: CISC]", shape=cylinder, fillcolor="#cfe0f5"];
    CISP    [label="Pt–protein adducts\n[ODE: CISP]", shape=box3d, fillcolor="#cfe0f5"];
    DNADAM  [label="DNA damage\n(dsDNA breaks, Pt adducts)", shape=ellipse, fillcolor="#cfe0f5", penwidth=2.0];
    MDR1    [label="ABCB1/MDR1 efflux\n(ACC constitutively high)", shape=ellipse, fillcolor="#cfe0f5", penwidth=2.0];
    KILLEDP [label="EDP kill flux\non TUMS", shape=ellipse, fillcolor="#a5d6a7", penwidth=2.2];

    ETODOSE -> ETOC [color="#1f4e79"]; ETOC -> ETOP [dir=both, color="#1f4e79"];
    ETOC -> ETOAUC; ETOAUC -> TOP2 [penwidth=2.0];
    DOXDOSE -> DOXC [color="#1f4e79"]; DOXC -> DOXP [dir=both, color="#1f4e79"];
    DOXDOSE -> DOXCUM [color="#1f4e79"]; DOXC -> TOP2;
    CISDOSE -> CISC [color="#1f4e79"]; CISC -> CISP [color="#1f4e79"];
    TOP2 -> DNADAM [penwidth=2.0]; CISC -> DNADAM [penwidth=2.0];
    DNADAM -> KILLEDP [penwidth=2.2]; KILLEDP -> APOP [penwidth=2.2, color="#2e7d32"];
    MDR1 -> ETOAUC [arrowhead=tee, style=dashed, label="intratumoural"];
    MDR1 -> DOXC [arrowhead=tee, style=dashed];
    PGP -> MDR1 [style=dashed, color="#c62828", label="induced further"];
    DDI_ETO -> ETOC [arrowhead=tee, penwidth=2.6, color="#c62828", label="  HARM #1 lands here  "];
    MITADR -> MDR1 [arrowhead=tee, style=dotted, label="reversal\n(claimed, weak)"];
    TUMR -> KILLEDP [arrowhead=tee, style=dashed, label="resistant clone\nnot killed"];
}

/* =======================================================================
   CLUSTER 10 — STREPTOZOTOCIN ARM
   ======================================================================= */
subgraph cluster_sz {
    label = <<b>10. 스트렙토조토신 (Streptozotocin — FIRM-ACT comparator arm)</b>>;
    style = "filled"; fillcolor = "#eef3fa"; color = "#6b87ab"; fontsize = 14;

    SZDOSE [label="Streptozotocin\n1 g d1–5 then 2 g q3wk", shape=hexagon, fillcolor="#9dc3e6"];
    SZC    [label="Streptozotocin plasma\n[ODE: SZC]", shape=cylinder, fillcolor="#cfe0f5"];
    GLUT2  [label="GLUT2-mediated uptake\n(β-cell + adrenocortical)", shape=ellipse, fillcolor="#cfe0f5"];
    ALKYL  [label="DNA alkylation /\nNAD+ depletion", shape=ellipse, fillcolor="#cfe0f5"];
    KILLSZ [label="Sz kill flux (weaker)", shape=ellipse, fillcolor="#a5d6a7"];
    SZDM   [label="β-cell toxicity →\nnew-onset diabetes", shape=octagon, fillcolor="#f2b8b8"];

    SZDOSE -> SZC [color="#1f4e79"]; SZC -> GLUT2; GLUT2 -> ALKYL;
    ALKYL -> KILLSZ; KILLSZ -> APOP [color="#2e7d32"];
    GLUT2 -> SZDM [color="#c62828"];
}

/* =======================================================================
   CLUSTER 11 — IGF2 / IGF1R / INSULIN — why linsitinib failed
   ======================================================================= */
subgraph cluster_igf {
    label = <<b>11. IGF2 · IGF1R · 인슐린 (IGF Axis: target present in 90%, drug failed)</b><br/><font point-size="9">GALACTIC phase 3 negative — IGF1R blockade raises glucose → insulin → IR-A rescue of the same signal</font>>;
    style = "filled"; fillcolor = "#fdf3e8"; color = "#b3873a"; fontsize = 14;

    IGF2   [label="Circulating / paracrine IGF2\n[ODE: IGF2]", shape=cylinder, fillcolor="#ffe6a8", penwidth=2.0];
    IGFBP  [label="IGFBP-2/3 · ALS\nbinding capacity", shape=ellipse, fillcolor="#ffe6a8"];
    IGF1R  [label="IGF1R", shape=ellipse, fillcolor="#ffe6a8", penwidth=2.0];
    IRA    [label="Insulin receptor A (IR-A)\n(the escape route)", shape=ellipse, fillcolor="#ffd98a", penwidth=2.4, color="#8a6d1f"];
    AKTMTOR[label="PI3K–AKT–mTOR\n[ODE: IGFSIG]", shape=cylinder, fillcolor="#ffe6a8", penwidth=2.4];
    LINSI  [label="Linsitinib (OSI-906)\ndual IGF1R/IR TKI", shape=hexagon, fillcolor="#9dc3e6", penwidth=2.0];
    GLU    [label="Plasma glucose\n[ODE: GLU]", shape=cylinder, fillcolor="#ffe6a8"];
    INS    [label="Plasma insulin\n[ODE: INS]", shape=cylinder, fillcolor="#ffd98a", penwidth=2.4, color="#8a6d1f"];
    RESCUE [label="INSULIN RESCUE:\ntarget engaged, signal restored", shape=diamond, fillcolor="#ffcdd2", penwidth=2.6, color="#c62828"];
    MITOTOX_GLU [label="Steroid + Sz + linsitinib\nall push glucose up", shape=octagon, fillcolor="#dfe3e8"];

    IGF2gene -> IGF2 [penwidth=2.0];
    IGF2 -> IGFBP [dir=both, style=dashed];
    IGF2 -> IGF1R [penwidth=2.0]; IGF2 -> IRA [penwidth=2.0];
    IGF1R -> AKTMTOR [penwidth=2.0]; IRA -> AKTMTOR [penwidth=2.0];
    AKTMTOR -> PROLIF [penwidth=2.2, style=dashed];
    LINSI -> IGF1R [arrowhead=tee, penwidth=2.4, color="#2e7d32"];
    LINSI -> IRA [arrowhead=tee, penwidth=1.4, color="#2e7d32", label="partial"];
    LINSI -> GLU [penwidth=2.0, color="#c62828", label="hyperglycaemia"];
    GLU -> INS [penwidth=2.2]; INS -> IRA [penwidth=2.4, color="#c62828"];
    INS -> RESCUE [penwidth=2.4, color="#c62828"]; IRA -> RESCUE [style=dashed];
    RESCUE -> AKTMTOR [penwidth=2.4, color="#c62828", label="  signal restored  "];
    HYPERGLY -> GLU [style=dashed]; SZDM -> GLU [style=dashed];
    GLU -> MITOTOX_GLU [style=dotted];
}

/* =======================================================================
   CLUSTER 12 — IMMUNE / CHECKPOINT — cortisol as self-administered steroid
   ======================================================================= */
subgraph cluster_immune {
    label = <<b>12. 면역 · 면역관문 (Immune Compartment: the tumour pre-medicates itself with steroid)</b><br/><font point-size="9">pembrolizumab ORR ~14–23%; glucocorticoid excess depletes TILs (Landwehr 2020)</font>>;
    style = "filled"; fillcolor = "#eaf6ec"; color = "#4e8b57"; fontsize = 14;

    APC     [label="Antigen presentation\n(MHC-I, low in ACC)", shape=ellipse, fillcolor="#cfe9d8"];
    TEFF    [label="Effector CD8 T cells\n[ODE: TEFF]", shape=cylinder, fillcolor="#a5d6a7", penwidth=2.4, color="#2e7d32"];
    TREG    [label="Treg / MDSC\n[ODE: TREG]", shape=cylinder, fillcolor="#cfe9d8", penwidth=2.0];
    TIL     [label="Tumour-infiltrating\nlymphocyte density", shape=octagon, fillcolor="#dfe3e8", penwidth=2.0];
    PD1     [label="PD-1 / PD-L1 axis", shape=ellipse, fillcolor="#cfe9d8", penwidth=2.0];
    CTLA4   [label="CTLA-4", shape=ellipse, fillcolor="#cfe9d8"];
    PEMBRO  [label="Pembrolizumab\n200 mg q3wk", shape=hexagon, fillcolor="#9dc3e6", penwidth=2.0];
    PEMC    [label="Pembrolizumab plasma\n[ODE: PEMC]", shape=cylinder, fillcolor="#cfe0f5"];
    OCCUP   [label="PD-1 receptor occupancy", shape=ellipse, fillcolor="#cfe9d8", penwidth=2.0];
    IFNG    [label="IFN-γ · granzyme B\nperforin", shape=ellipse, fillcolor="#cfe9d8"];
    KILLIMM [label="Immune kill flux\non TUMS", shape=ellipse, fillcolor="#a5d6a7", penwidth=2.2];
    GCIMSUP [label="GLUCOCORTICOID\nIMMUNOSUPPRESSION\n(T-cell apoptosis, IL-2↓)", shape=diamond, fillcolor="#ffcdd2", penwidth=2.8, color="#c62828"];
    IRAE    [label="Immune-related AE\n(hypophysitis, colitis)", shape=octagon, fillcolor="#f2b8b8"];

    APC -> TEFF; TEFF -> IFNG [penwidth=2.0]; IFNG -> KILLIMM [penwidth=2.0];
    KILLIMM -> APOP [penwidth=2.2, color="#2e7d32"];
    TREG -> TEFF [arrowhead=tee, penwidth=2.0];
    PD1 -> TEFF [arrowhead=tee, penwidth=2.2];
    CTLA4 -> TEFF [arrowhead=tee];
    PEMBRO -> PEMC [color="#1f4e79"]; PEMC -> OCCUP [penwidth=2.0];
    OCCUP -> PD1 [arrowhead=tee, penwidth=2.4, color="#2e7d32"];
    OCCUP -> IRAE [color="#c62828", style=dashed];
    TEFF -> TIL; TREG -> TIL [style=dashed];
    GR -> GCIMSUP [penwidth=2.8, color="#c62828"];
    GCIMSUP -> TEFF [arrowhead=tee, penwidth=2.8, color="#c62828", label="  FEEDBACK F  "];
    GCIMSUP -> TREG [penwidth=2.0, color="#c62828"];
    GCIMSUP -> TIL [arrowhead=tee, penwidth=2.2, color="#c62828"];
    MMRstat -> APC [style=dashed, label="TMB → neoantigen"];
    TUMTOT -> APC [style=dotted];
    FASTBLK -> GCIMSUP [arrowhead=tee, style=dashed, penwidth=2.2, color="#2e7d32", label="  steroid control\n  restores immunity  "];
}

/* =======================================================================
   CLUSTER 13 — HORMONE REPLACEMENT (the induced victim)
   ======================================================================= */
subgraph cluster_replace {
    label = <<b>13. 호르몬 보충 (Replacement Therapy — dosed against a moving clearance)</b><br/><font point-size="9">mitotane doubles hydrocortisone CL AND doubles CBG: two errors, same direction</font>>;
    style = "filled"; fillcolor = "#fff9e8"; color = "#b39338"; fontsize = 14;

    HCDOSE [label="Hydrocortisone\n20 → 50 mg/day\n(must be doubled)", shape=hexagon, fillcolor="#9dc3e6", penwidth=2.4];
    HCGUT  [label="HC gut depot\n[ODE: HCG]", shape=box3d, fillcolor="#cfe0f5"];
    HCC    [label="HC plasma (as cortisol)\n[ODE: HCC]", shape=cylinder, fillcolor="#cfe0f5", penwidth=2.0];
    FLUDRO [label="Fludrocortisone\n(if MC deficient)", shape=hexagon, fillcolor="#9dc3e6"];
    LT4    [label="Levothyroxine\n(central FT4 fall)", shape=hexagon, fillcolor="#9dc3e6"];
    TESTOR [label="Testosterone\n(5α-reductase block + SHBG↑)", shape=hexagon, fillcolor="#9dc3e6"];
    AICRISIS [label="ADRENAL CRISIS\nhazard (cumulative)\n[ODE: AIHAZ]", shape=octagon, fillcolor="#f2b8b8", penwidth=2.6, color="#c62828"];
    STRESSD [label="Stress-dose rules\n(sick-day, 3x)", shape=parallelogram, fillcolor="#fff2c2"];

    HCDOSE -> HCGUT; HCGUT -> HCC [color="#1f4e79"];
    HCC -> CORT [penwidth=2.2, label="indistinguishable\nfrom endogenous"];
    DDI_HC -> HCC [arrowhead=tee, penwidth=2.6, color="#c62828", label="  CL doubled  "];
    ADRLYSIS -> AICRISIS [style=dashed, penwidth=2.0, color="#c62828"];
    FCORT -> AICRISIS [arrowhead=tee, penwidth=2.4, color="#2e7d32"];
    STRESSD -> HCDOSE [style=dashed];
    FLUDRO -> ALDO [style=dashed, label="MR replacement"];
    ADRLYSIS -> CYP11B2 [arrowhead=tee, style=dashed, label="glomerulosa\nrelatively spared"];
    DDI_LEVO -> LT4 [style=dashed];
    INH5AR -> TESTOR [style=dashed];
}

/* =======================================================================
   CLUSTER 14 — BINDING PROTEINS & THE ASSAY ARTEFACT
   ======================================================================= */
subgraph cluster_binding {
    label = <<b>14. 결합단백 · 검사 함정 (Binding Proteins &amp; the Assay Artefact)</b><br/><font point-size="9">Nader 2006: mitotane has an oestrogenic action → CBG and SHBG roughly double</font>>;
    style = "filled"; fillcolor = "#fdeeeb"; color = "#b5766a"; fontsize = 14;

    CBG     [label="CBG (transcortin)\n[ODE: CBG] 1 → ~2x", shape=cylinder, fillcolor="#f3c9c0", penwidth=2.8, color="#8b3a2c"];
    SHBG    [label="SHBG\n[ODE: SHBG] 1 → ~2x", shape=cylinder, fillcolor="#f3c9c0", penwidth=2.0];
    ESTROG  [label="Hepatic oestrogenic\naction of mitotane", shape=ellipse, fillcolor="#f3c9c0", penwidth=2.0];
    BINDEQ  [label="Binding equilibrium\nfree = f(total, CBG, alb)", shape=diamond, fillcolor="#fff2c2", penwidth=2.4];
    TOTALLIE[label="ASSAY TRAP:\ntotal cortisol looks\nNORMAL while free is LOW", shape=diamond, fillcolor="#ffcdd2", penwidth=2.8, color="#c62828"];
    SALIVA  [label="Salivary / free\ncortisol assay\n(the correct readout)", shape=octagon, fillcolor="#c8e6c9", penwidth=2.2, color="#2e7d32"];
    FREETES [label="Free testosterone ↓\n→ gynaecomastia, ED", shape=octagon, fillcolor="#f2b8b8"];
    URINEFREE [label="24-h urinary free\ncortisol (UFC)", shape=octagon, fillcolor="#dfe3e8"];

    MITC -> ESTROG [penwidth=2.2];
    ESTROG -> CBG [penwidth=2.6]; ESTROG -> SHBG [penwidth=2.2];
    CORT -> BINDEQ; CBG -> BINDEQ [penwidth=2.6]; ALB -> BINDEQ [style=dashed];
    BINDEQ -> FCORT [penwidth=2.6];
    CBG -> TOTALLIE [penwidth=2.6, color="#c62828"];
    CORT -> TOTALLIE [style=dashed];
    TOTALLIE -> HCDOSE [arrowhead=tee, penwidth=2.6, color="#c62828", style=dashed, label="  clinician under-doses  "];
    FCORT -> SALIVA [color="#2e7d32", penwidth=2.0];
    FCORT -> URINEFREE [style=dotted];
    SHBG -> FREETES [arrowhead=tee, penwidth=2.0, color="#c62828"];
    TESTOR -> FREETES [style=dashed];
}

/* =======================================================================
   CLUSTER 15 — CNS TOXICITY (threshold 2)
   ======================================================================= */
subgraph cluster_cnstox {
    label = <<b>15. 중추신경 독성 (CNS Toxicity — the OTHER threshold on the same variable)</b><br/><font point-size="9">&gt;20 mg/L: ataxia, dysarthria, confusion; dose-limiting in ~30% of adjuvant patients</font>>;
    style = "filled"; fillcolor = "#fdecec"; color = "#ad4a4a"; fontsize = 14;

    BBBMIT  [label="Mitotane crosses BBB\n(highly lipophilic)", shape=ellipse, fillcolor="#f2b8b8"];
    CEREBEL [label="Cerebellar dysfunction\n(ataxia, dysarthria)", shape=octagon, fillcolor="#f2b8b8", penwidth=2.0];
    CONFUS  [label="Confusion, somnolence,\nmemory impairment", shape=octagon, fillcolor="#f2b8b8"];
    NEUROTOX[label="Cumulative CNS injury\n[ODE: NTOX]", shape=cylinder, fillcolor="#f2b8b8", penwidth=2.4, color="#c62828"];
    DOSEHOLD[label="Dose interruption /\nreduction decision", shape=parallelogram, fillcolor="#fff2c2", penwidth=2.2];
    SLOWOFF [label="Recovery is SLOW\n(depot must drain)", shape=diamond, fillcolor="#ffcdd2", penwidth=2.4, color="#c62828"];

    MITCNS -> BBBMIT [penwidth=2.2, color="#c62828"];
    THR20 -> NEUROTOX [penwidth=2.6, color="#c62828"];
    BBBMIT -> CEREBEL [color="#c62828"]; BBBMIT -> CONFUS [color="#c62828"];
    CEREBEL -> NEUROTOX; CONFUS -> NEUROTOX;
    NEUROTOX -> DOSEHOLD [penwidth=2.2];
    DOSEHOLD -> MITDOSE [arrowhead=tee, penwidth=2.2, style=dashed];
    MITADI -> SLOWOFF [style=dashed, penwidth=2.2, color="#c62828"];
    SLOWOFF -> NEUROTOX [style=dashed, color="#c62828", label="persists weeks\nafter stopping"];
}

/* =======================================================================
   CLUSTER 16 — OTHER ORGAN TOXICITY
   ======================================================================= */
subgraph cluster_othertox {
    label = <<b>16. 기타 장기 독성 (Other Organ Toxicity)</b>>;
    style = "filled"; fillcolor = "#fdf0f0"; color = "#ad6a6a"; fontsize = 14;

    GITOX   [label="GI intolerance\n(nausea, diarrhoea)\ndose-splitting dependent", shape=octagon, fillcolor="#f2b8b8"];
    HEPTOX  [label="Hepatotoxicity\nGGT↑↑ (near-universal),\nALT [ODE: ALT]", shape=cylinder, fillcolor="#f2b8b8", penwidth=2.0];
    HYPCHOL [label="Hypercholesterolaemia\n(mitotane class effect)", shape=octagon, fillcolor="#f2b8b8"];
    FT4     [label="Free T4 ↓ without TSH rise\n[ODE: FT4] (central effect)", shape=cylinder, fillcolor="#f2b8b8", penwidth=2.0];
    TSHn    [label="TSH (inappropriately\nnormal)", shape=octagon, fillcolor="#dfe3e8"];
    NEUT    [label="Neutrophils\n[ODE: NEUT] (EDP)", shape=cylinder, fillcolor="#f2b8b8", penwidth=2.0];
    MUCOS   [label="Mucositis, alopecia", shape=octagon, fillcolor="#f2b8b8"];
    LVEF    [label="LVEF ↓ (anthracycline)\n[ODE: LVEF]", shape=cylinder, fillcolor="#f2b8b8", penwidth=2.0];
    GFR     [label="eGFR ↓ (cisplatin)\n[ODE: GFR]", shape=cylinder, fillcolor="#f2b8b8", penwidth=2.0];
    OTOTOX  [label="Ototoxicity, peripheral\nneuropathy (cisplatin)", shape=octagon, fillcolor="#f2b8b8"];
    MGSQ    [label="Hypomagnesaemia", shape=octagon, fillcolor="#f2b8b8"];

    MITC -> GITOX [color="#c62828"]; MITC -> HEPTOX [color="#c62828"];
    MITC -> HYPCHOL [color="#c62828"]; MITC -> FT4 [arrowhead=tee, color="#c62828", penwidth=2.0];
    FT4 -> TSHn [style=dotted, label="no compensatory rise"];
    ETOC -> NEUT [arrowhead=tee, color="#c62828", penwidth=2.0];
    DOXC -> NEUT [arrowhead=tee, color="#c62828"];
    DOXC -> MUCOS [color="#c62828"];
    DOXCUM -> LVEF [arrowhead=tee, color="#c62828", penwidth=2.2];
    CISC -> GFR [arrowhead=tee, color="#c62828", penwidth=2.0];
    CISC -> OTOTOX [color="#c62828"]; CISC -> MGSQ [color="#c62828"];
    GFR -> CISC [arrowhead=tee, style=dotted, label="reduced clearance\n→ worse toxicity"];
    GITOX -> FBIO [arrowhead=tee, style=dotted, label="less taken →\nless absorbed"];
}

/* =======================================================================
   CLUSTER 17 — TDM & DOSING DECISIONS
   ======================================================================= */
subgraph cluster_tdm {
    label = <<b>17. TDM · 용량 결정 (Therapeutic Drug Monitoring &amp; Dosing Strategy)</b><br/><font point-size="9">the decision layer that has to act on a variable whose clock is 50–110 days long</font>>;
    style = "filled"; fillcolor = "#fffbe8"; color = "#b5a13a"; fontsize = 14;

    STARTREG [label="Starting regimen\nlow-dose ramp vs\nhigh-dose start", shape=parallelogram, fillcolor="#fff2c2", penwidth=2.2];
    ESCAL    [label="Escalate to target\n(TDM-guided)", shape=parallelogram, fillcolor="#fff2c2", penwidth=2.2];
    STRATIFY [label="STRATIFY ON BODY\nCOMPOSITION, not just dose", shape=parallelogram, fillcolor="#c8e6c9", penwidth=2.6, color="#2e7d32"];
    IIV      [label="IIV on V = 81.5% CV\n>> effect of doubling dose", shape=diamond, fillcolor="#ffcdd2", penwidth=2.6, color="#c62828"];
    TRIALPWR [label="RCT that randomises DOSE\nbut not BODY FAT is\nunderpowered by construction", shape=diamond, fillcolor="#ffcdd2", penwidth=2.6, color="#c62828"];
    ADJUVANT [label="Adjuvant setting\n(ADIUVO: no benefit in\nlow-risk; RFS benefit in\nhigh-risk cohorts)", shape=parallelogram, fillcolor="#fff2c2"];
    STOPRULE [label="Discontinuation\n(long therapeutic tail)", shape=parallelogram, fillcolor="#fff2c2"];

    TDM -> ESCAL [penwidth=2.0]; ESCAL -> MITDOSE [penwidth=2.2];
    STARTREG -> MITDOSE [penwidth=2.0];
    FATKG -> IIV [style=dashed, penwidth=2.2, color="#8a6d1f"];
    IIV -> TRIALPWR [penwidth=2.4, color="#c62828"];
    STARTREG -> TRIALPWR [style=dashed];
    IIV -> STRATIFY [penwidth=2.4, color="#2e7d32"];
    STRATIFY -> STARTREG [style=dashed, penwidth=2.2, color="#2e7d32"];
    ENSATst -> ADJUVANT [style=dashed]; KI67 -> ADJUVANT [style=dashed];
    ADJUVANT -> MITDOSE [style=dashed];
    STOPRULE -> MITDOSE [arrowhead=tee, style=dashed];
    PERSIST -> STOPRULE [style=dashed, color="#c62828"];
}

/* =======================================================================
   CLUSTER 18 — CLINICAL ENDPOINTS
   ======================================================================= */
subgraph cluster_endpoints {
    label = <<b>18. 임상 엔드포인트 (Clinical Endpoints)</b>>;
    style = "filled"; fillcolor = "#eef0f3"; color = "#7c848e"; fontsize = 14;

    RECIST  [label="RECIST 1.1\nsum of target diameters", shape=octagon, fillcolor="#dfe3e8", penwidth=2.2];
    ORR     [label="Objective response rate\n(EDP-M 23.2% · Sz-M 9.2%)", shape=octagon, fillcolor="#dfe3e8", penwidth=2.2];
    PFS     [label="PFS (EDP-M 5.0 mo\nvs Sz-M 2.1 mo)", shape=octagon, fillcolor="#dfe3e8", penwidth=2.4];
    OS      [label="Overall survival\n(14.8 vs 12.0 mo, NS)", shape=octagon, fillcolor="#dfe3e8", penwidth=2.4];
    RFS     [label="Recurrence-free survival\n(adjuvant setting)", shape=octagon, fillcolor="#dfe3e8", penwidth=2.0];
    CORTCTL [label="Cortisol control\n(free cortisol normalised)", shape=octagon, fillcolor="#c8e6c9", penwidth=2.4, color="#2e7d32"];
    TIMEINWIN[label="Time in therapeutic\nwindow 14–20 mg/L (%)", shape=octagon, fillcolor="#c8e6c9", penwidth=2.4, color="#2e7d32"];
    QOL     [label="Quality of life /\nsymptom burden", shape=octagon, fillcolor="#dfe3e8"];
    TTT     [label="Time to first\ntherapeutic level (days)", shape=octagon, fillcolor="#c8e6c9", penwidth=2.4, color="#2e7d32"];

    TUMTOT -> RECIST [penwidth=2.2]; RECIST -> ORR [penwidth=2.0]; RECIST -> PFS [penwidth=2.2];
    PFS -> OS [style=dashed]; TUMTOT -> OS [style=dashed];
    TUMTOT -> RFS [style=dashed];
    FCORT -> CORTCTL [penwidth=2.2, color="#2e7d32"];
    TDM -> TIMEINWIN [penwidth=2.2]; TDM -> TTT [penwidth=2.2];
    NEUROTOX -> QOL [arrowhead=tee, color="#c62828"];
    CUSHING -> QOL [arrowhead=tee, color="#c62828"];
    GITOX -> QOL [arrowhead=tee, color="#c62828"];
    MYOPATH -> QOL [style=dashed];
    TIMEINWIN -> RFS [style=dashed, penwidth=2.0, color="#2e7d32", label="exposure–response"];
    TIMEINWIN -> ORR [style=dashed, color="#2e7d32"];
    ETOAUC -> ORR [style=dashed, penwidth=2.2, color="#c62828", label="  HARM #1 shows up\n  in the endpoint  "];
    TIL -> OS [style=dashed, color="#2e7d32", label="prognostic"];
    LVEF -> OS [style=dashed, color="#c62828"];
    AICRISIS -> OS [style=dashed, color="#c62828"];
}

/* =======================================================================
   THE THREE READS — cross-cluster summary spine
   ======================================================================= */
subgraph cluster_thesis {
    label = <<b>★ 하나의 저장고, 세 가지 해석 (ONE DEPOT, THREE READS)</b>>;
    style = "filled"; fillcolor = "#fffde7"; color = "#c0a020"; fontsize = 15;

    READ1 [label="READ 1 — BENEFIT\nCp ≥ 14 mg/L → adrenolysis (slow,\nirreversible) + enzyme block (fast,\nreversible) → cortisol control, tumour kill", shape=note, fillcolor="#c8e6c9", penwidth=2.4, color="#2e7d32", fontsize=12];
    READ2 [label="READ 2 — HARM #1\nSame Cp → PXR → CYP3A4 ×4 → etoposide\nAUC ÷2, hydrocortisone AUC ÷2,\nmitotane's own CL ↑ (Css drifts down)", shape=note, fillcolor="#f2b8b8", penwidth=2.4, color="#c62828", fontsize=12];
    READ3 [label="READ 3 — HARM #2\nSame Cp &gt; 20 mg/L → cerebellar and\ncognitive toxicity; recovery needs the\ndepot to DRAIN (weeks–months)", shape=note, fillcolor="#f2b8b8", penwidth=2.4, color="#c62828", fontsize=12];
    CLOCK [label="THE CLOCK, NOT THE SET-POINT\nFat mass leaves Css = D·F/CL untouched but\nscales τ = Vss/CL. Hypercortisolism adds fat,\nso the disease lengthens its own treatment delay.", shape=note, fillcolor="#fff2c2", penwidth=2.6, color="#8a6d1f", fontsize=12];

    READ1 -> READ2 [style=invis]; READ2 -> READ3 [style=invis]; READ3 -> CLOCK [style=invis];
}

    MITC -> READ1 [style=dotted, color="#2e7d32", penwidth=1.6];
    MITC -> READ2 [style=dotted, color="#c62828", penwidth=1.6];
    MITC -> READ3 [style=dotted, color="#c62828", penwidth=1.6];
    MITADI -> CLOCK [style=dotted, color="#8a6d1f", penwidth=1.6];
    FATKG -> CLOCK [style=dotted, color="#8a6d1f", penwidth=1.6];
}
