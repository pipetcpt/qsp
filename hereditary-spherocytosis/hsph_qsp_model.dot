/* =====================================================================
   Hereditary Spherocytosis (HS) -- QSP mechanistic map
   유전성 구상적혈구증 -- 정량적 시스템 약리학 기계론적 지도

   Organising principle: every arrow in this map eventually acts on ONE of
   two numbers -- red cell membrane AREA (S) and red cell VOLUME (V).  The
   geometry cluster in the middle converts (S, V) into the minimum
   cylindrical diameter D_c, and D_c is the only thing the spleen can see.
   The loop  area loss -> D_c up -> longer cordal residence -> area loss
   is drawn in red: it is the disease.

   dot -Tsvg hsph_qsp_model.dot -o hsph_qsp_model.svg
   dot -Tpng -Gdpi=150 hsph_qsp_model.dot -o hsph_qsp_model.png
   ===================================================================== */
digraph HS_QSP {
  graph [rankdir=TB, splines=spline, overlap=false, nodesep=0.22,
         ranksep=0.55, fontname="Helvetica", fontsize=11, compound=true,
         bgcolor="white", labelloc="t",
         label="Hereditary Spherocytosis — QSP Mechanistic Map\n유전성 구상적혈구증: 막 면적(S)과 부피(V)라는 두 숫자로 환원되는 질환\nred = the splenic conditioning loop (area loss ⇄ cordal residence)  ·  blue = drug / intervention  ·  green = clinical endpoint"];
  node  [shape=box, style="rounded,filled", fontname="Helvetica",
         fontsize=9, penwidth=0.8, margin="0.05,0.03"];
  edge  [fontname="Helvetica", fontsize=7.5, arrowsize=0.6, penwidth=0.8,
         color="#555555"];

  /* ---------- palette ---------- */
  /* gene            #ffe0b2   protein/structure #e1f5fe
     process         #f3e5f5   geometry          #fff9c4
     spleen          #ffcdd2   immune            #d1c4e9
     marrow          #c8e6c9   liver/bile        #dcedc8
     iron            #ffe0b2   drug              #bbdefb
     endpoint        #a5d6a7   assay             #eceff1  */

  /* =================================================================
     1. GENOTYPE -- the vertical linkage genes
     ================================================================= */
  subgraph cluster_gene {
    label="1. 유전자 결함 · Genotype: the vertical linkage\n(ankyrin–band 3–protein 4.2–spectrin axis)";
    style="rounded,filled"; fillcolor="#fff8e1"; fontsize=11; color="#f57c00";
    ANK1   [label="ANK1 (8p11.21)\nankyrin-1 · ~50% of HS\nAD, ~1/3 de novo", fillcolor="#ffe0b2"];
    SPTB   [label="SPTB (14q23.3)\nβ-spectrin · ~20%\nAD", fillcolor="#ffe0b2"];
    SPTA1  [label="SPTA1 (1q23.1)\nα-spectrin · ~5%\nAR, severe", fillcolor="#ffe0b2"];
    SLC4A1 [label="SLC4A1 (17q21.31)\nband 3 (AE1) · ~20%\nAD", fillcolor="#ffe0b2"];
    EPB42  [label="EPB42 (15q15.2)\nprotein 4.2 · ~5%\nAR (Japan-enriched)", fillcolor="#ffe0b2"];
    RHAG   [label="RHAG\nRh-associated glycoprotein\n(rare, overhydrated SAO overlap)", fillcolor="#ffe0b2"];
    DENOVO [label="de novo mutation\n~25% of index cases", fillcolor="#ffecb3"];
    NGS    [label="NGS membrane panel\nα/β-spectrin, ANK1, SLC4A1,\nEPB42, PIEZO1, KCNN4", fillcolor="#eceff1"];
    SPCONT [label="spectrin content\n(mild ~80% · moderate ~70%\n· severe ~55% of normal)", fillcolor="#ffe0b2"];
  }

  /* =================================================================
     2. MEMBRANE ARCHITECTURE
     ================================================================= */
  subgraph cluster_mem {
    label="2. 적혈구막 골격 · Membrane skeleton architecture";
    style="rounded,filled"; fillcolor="#e8f5fe"; fontsize=11; color="#0277bd";
    SPTET  [label="spectrin αβ heterodimer\n→ head-to-head tetramer\n(horizontal linkage)", fillcolor="#e1f5fe"];
    ANKP   [label="ankyrin-1 protein\nbridges β-spectrin ↔ band 3\n(vertical linkage)", fillcolor="#e1f5fe"];
    B3     [label="band 3 / AE1\n~1.2×10⁶ copies/cell\nanion exchanger + anchor", fillcolor="#e1f5fe"];
    P42    [label="protein 4.2\nstabilises ankyrin–band 3", fillcolor="#e1f5fe"];
    P41    [label="protein 4.1R + actin +\nadducin + dematin\n(junctional complex)", fillcolor="#e1f5fe"];
    GPA    [label="glycophorin A\nchaperone for band 3", fillcolor="#e1f5fe"];
    RHCX   [label="Rh / RhAG complex\nsecond vertical anchor", fillcolor="#e1f5fe"];
    LIPID  [label="lipid bilayer\n(PS inner leaflet, PIP₂)", fillcolor="#e1f5fe"];
    UNSUP  [label="UNSUPPORTED BILAYER\nmembrane not tethered to skeleton", fillcolor="#ffccbc"];
    AREACOMP [label="membrane is area-INCOMPRESSIBLE\n(≤3–4% areal strain before lysis)", fillcolor="#f3e5f5"];
  }

  /* =================================================================
     3. VESICULATION -- how area is actually lost
     ================================================================= */
  subgraph cluster_ves {
    label="3. 소포 방출 · Vesiculation: the only way area leaves the cell";
    style="rounded,filled"; fillcolor="#f7f0fb"; fontsize=11; color="#6a1b9a";
    VESIC  [label="microvesiculation\n~100–200 nm vesicles\nV/S = r/3 ≈ 0.025 µm", fillcolor="#f3e5f5"];
    VESB3  [label="vesicle band 3 content\nANK1/SPTB: band-3 RICH\nSLC4A1: band-3 POOR", fillcolor="#f3e5f5"];
    VESHB  [label="vesicle haemoglobin content\n≈ 0 in HS\n→ AREA lost, VOLUME kept", fillcolor="#ffccbc"];
    ECHINO [label="echinocyte → spheroechinocyte\n(ATP-depleted shape change)", fillcolor="#f3e5f5"];
    ATP    [label="red cell ATP\nglycolysis only (no mitochondria)", fillcolor="#f3e5f5"];
    PKR    [label="pyruvate kinase (PKR)\nrate-limiting for ATP", fillcolor="#f3e5f5"];
    DPG    [label="2,3-DPG\nO₂ affinity ↓ when high", fillcolor="#f3e5f5"];
    FLIP   [label="flippase (ATP8A1) needs ATP\n→ PS stays inside", fillcolor="#f3e5f5"];
    ARLOSS [label="MEMBRANE AREA  S\n(µm², state variable)", fillcolor="#fff59d", penwidth=2.2];
  }

  /* =================================================================
     4. CATION LEAK AND DEHYDRATION -- how volume is lost
     ================================================================= */
  subgraph cluster_cat {
    label="4. 양이온 누출·탈수 · Cation leak and dehydration";
    style="rounded,filled"; fillcolor="#fdf3e7"; fontsize=11; color="#ef6c00";
    KLEAK  [label="passive K⁺ leak\n↑ in HS membranes", fillcolor="#ffe0b2"];
    KCC    [label="K-Cl cotransport (KCC1/3)\nactivated by acid + swelling", fillcolor="#ffe0b2"];
    GARDOS [label="Gardos channel KCNN4\nCa²⁺-activated K⁺ efflux", fillcolor="#ffe0b2"];
    NAKATP [label="Na⁺/K⁺-ATPase\nATP-dependent pump", fillcolor="#ffe0b2"];
    PIEZO  [label="PIEZO1 (contrast: DHS)\ngain-of-function → dehydration\nwithout area loss", fillcolor="#ffe0b2"];
    DEHYD  [label="cellular dehydration\nwater follows K⁺ out", fillcolor="#ffe0b2"];
    VOLST  [label="CELL VOLUME  V\n(µm³, state variable)", fillcolor="#fff59d", penwidth=2.2];
    MCHCUP [label="MCHC ↑ (>35 g/dL)\nthe only CBC index that rises", fillcolor="#fff9c4"];
  }

  /* =================================================================
     5. GEOMETRY KERNEL -- the whole disease in two numbers
     ================================================================= */
  subgraph cluster_geo {
    label="5. 기하학 커널 · Geometry kernel — everything the spleen can see";
    style="rounded,filled"; fillcolor="#fffde7"; fontsize=12; color="#f9a825"; penwidth=2.0;
    VSPH   [label="V_sph = S^{3/2}/(6√π)\ncritical haemolytic volume\n= largest volume the membrane can hold", fillcolor="#fff59d"];
    SPHIDX [label="sphericity  s = V / V_sph  ∈ (0,1]\nnormal 0.58 · moderate HS 0.73", fillcolor="#fff59d"];
    DCRIT  [label="MINIMUM CYLINDRICAL DIAMETER\nD_c = 2√(S/π)·cos(arccos(−s)/3 − 2π/3)\nnormal 2.72 µm · moderate HS 3.30 µm",
            fillcolor="#ffe082", penwidth=2.4, shape=box];
    RESERV [label="deformability reserve\n= excess area over the sphere", fillcolor="#fff59d"];
    SVRAT  [label="surface-to-volume ratio S/V\n1.56 normal → 1.34 HS", fillcolor="#fff59d"];
  }

  /* =================================================================
     6. SPLENIC MICROCIRCULATION
     ================================================================= */
  subgraph cluster_spl {
    label="6. 비장 미세순환 · Splenic microcirculation — the filter";
    style="rounded,filled"; fillcolor="#ffebee"; fontsize=11; color="#c62828";
    SPART  [label="splenic artery\n~5% of cardiac output\n≈72 passes per cell per day", fillcolor="#ffcdd2"];
    WPULP  [label="white pulp / PALS\n(immune, not filtration)", fillcolor="#ffcdd2"];
    MZONE  [label="marginal zone", fillcolor="#ffcdd2"];
    FASTR  [label="FAST route (closed)\nsinus → vein, seconds", fillcolor="#ffcdd2"];
    SLOWR  [label="SLOW route (open)\ninto the cords of Billroth", fillcolor="#ef9a9a"];
    SLIT   [label="INTERENDOTHELIAL SLIT\n0.2–0.65 µm wide\nstress-fibre ring, sinus endothelium", fillcolor="#ef9a9a", penwidth=2.0];
    CORD   [label="cords of Billroth\nhypoxic · acidotic (pH ~7.2)\nglucose-poor · high haematocrit", fillcolor="#ef9a9a"];
    DWELL  [label="cordal dwell time τ_c\n1.5 min normal → 10+ min in HS\nτ_c = τ₀·exp((D_c−D_c⁰)/w)", fillcolor="#ef9a9a"];
    PSLOW  [label="p_slow(D_c)  = fraction of passes\ndiverted to the cords\n1.5% normal → 90% in HS", fillcolor="#ef9a9a"];
    POOL   [label="splenic red cell pool\n(sequestration / hypersplenism)", fillcolor="#ffcdd2"];
    SPLMASS[label="spleen mass\n150 mL → 300–1000 mL\nworkload-driven hypertrophy", fillcolor="#ffcdd2"];
  }

  /* =================================================================
     7. SPLENIC CONDITIONING -- the amplifier
     ================================================================= */
  subgraph cluster_cond {
    label="7. 비장 조건화 · Splenic conditioning — the amplifier loop";
    style="rounded,filled"; fillcolor="#fff0f0"; fontsize=11; color="#b71c1c"; penwidth=2.0;
    STRIP  [label="cordal membrane stripping\n≈42× the circulating vesiculation rate\n(hypoxia + acidosis + ATP fall)", fillcolor="#ffcdd2"];
    CONDIT [label="CONDITIONING\nthe most spherocytic cells in the body\nare the ones inside the spleen", fillcolor="#ef9a9a", penwidth=1.8];
    LOOP   [label="POSITIVE FEEDBACK\nD_c ↑ → τ_c ↑ → area ↓ → D_c ↑", fillcolor="#e57373", penwidth=2.4, fontcolor="white"];
    PITTED [label="pitting function\n(also removes Howell-Jolly bodies,\nnuclear remnants, Heinz bodies)", fillcolor="#ffcdd2"];
  }

  /* =================================================================
     8. MACROPHAGE CLEARANCE
     ================================================================= */
  subgraph cluster_mac {
    label="8. 대식세포 청소 · Macrophage clearance — two different triggers";
    style="rounded,filled"; fillcolor="#ede7f6"; fontsize=11; color="#4527a0";
    RPMAC  [label="red pulp macrophage\n(SPI-C, VCAM1⁺)", fillcolor="#d1c4e9"];
    KUPF   [label="Kupffer cell (liver)\nhandles opsonised cells,\nSURVIVES splenectomy", fillcolor="#d1c4e9"];
    B3CLUS [label="band 3 CLUSTERING\nrequires retained band 3", fillcolor="#d1c4e9"];
    NAB3   [label="natural anti-band-3 IgG\nlow affinity → needs bivalent\nbinding to a cluster", fillcolor="#d1c4e9"];
    IGGN   [label="IgG per cell\n≤60 control & spectrin/ankyrin HS\nup to 140 in band 3 HS", fillcolor="#b39ddb"];
    C3B    [label="C3b deposition\nCR1 / CR3 (CD11b) uptake", fillcolor="#d1c4e9"];
    FCG    [label="FcγRI / FcγRIIA / FcγRIIIA\nphagocytic signal", fillcolor="#d1c4e9"];
    CD47   [label="CD47–SIRPα\n'don't eat me', lost with age", fillcolor="#d1c4e9"];
    PSEXP  [label="phosphatidylserine exposure\nscramblase > flippase", fillcolor="#d1c4e9"];
    HGEOM  [label="GEOMETRIC clearance h_geom\nspleen-only\n= f_pass · p_slow(D_c) · π_dest(τ_c)", fillcolor="#ffcdd2", penwidth=1.8];
    HOPS   [label="OPSONIC clearance h_ops\nspleen 72% + liver 28%", fillcolor="#d1c4e9", penwidth=1.8];
    HSEN   [label="SENESCENCE clearance h_sen\nmolecular tagging, geometry-blind\n(94% of normal red cell death)", fillcolor="#d1c4e9"];
  }

  /* =================================================================
     9. INTRAVASCULAR HAEMOLYSIS (minor in HS -- and that is diagnostic)
     ================================================================= */
  subgraph cluster_iv {
    label="9. 혈관내 용혈 · Intravascular haemolysis (minor component)";
    style="rounded,filled"; fillcolor="#f1f8e9"; fontsize=11; color="#558b2f";
    LYSIS  [label="osmotic / mechanical lysis\nwhen V → V_sph", fillcolor="#dcedc8"];
    FHB    [label="free plasma haemoglobin", fillcolor="#dcedc8"];
    HPT    [label="haptoglobin\n(consumed → low)", fillcolor="#dcedc8"];
    HPX    [label="hemopexin / CD163", fillcolor="#dcedc8"];
    LDHN   [label="LDH (mildly raised in HS;\nvery high suggests another cause)", fillcolor="#dcedc8"];
    NOSC   [label="NO scavenging by free Hb", fillcolor="#dcedc8"];
  }

  /* =================================================================
     10. ERYTHROPOIESIS -- the compensation
     ================================================================= */
  subgraph cluster_ery {
    label="10. 적혈구 조혈 · Erythropoiesis — the compensation and its ceiling";
    style="rounded,filled"; fillcolor="#e8f5e9"; fontsize=11; color="#2e7d32";
    HIF2   [label="renal HIF-2α\nO₂ sensing (PHD2/VHL)", fillcolor="#c8e6c9"];
    EPO    [label="erythropoietin\nlog₁₀EPO = 4.17 − 0.211·Hb", fillcolor="#c8e6c9"];
    BFUE   [label="BFU-E → CFU-E", fillcolor="#c8e6c9"];
    ERYBL  [label="erythroblast / erythroblastic island\ncentral macrophage", fillcolor="#c8e6c9"];
    RETM   [label="marrow reticulocyte\nrelease accelerated by EPO", fillcolor="#c8e6c9"];
    RETB   [label="blood reticulocyte\nmaturation 1 d → 2.5 d ('shift')", fillcolor="#c8e6c9"];
    MAREXP [label="marrow expansion ≤ 8×\nthe hard ceiling on compensation", fillcolor="#a5d6a7"];
    EMH    [label="extramedullary haematopoiesis\nparaspinal / hepatosplenic masses", fillcolor="#c8e6c9"];
    FOLDEM [label="folate demand ↑\n(megaloblastic crisis if unmet)", fillcolor="#c8e6c9"];
    ERFE   [label="erythroferrone (ERFE)\nsuppresses hepcidin", fillcolor="#c8e6c9"];
  }

  /* =================================================================
     11. HAEM CATABOLISM AND BILIRUBIN
     ================================================================= */
  subgraph cluster_bil {
    label="11. 헴 대사·빌리루빈 · Haem catabolism and bilirubin";
    style="rounded,filled"; fillcolor="#f1f8e9"; fontsize=11; color="#33691e";
    HO1    [label="haem oxygenase-1 (HMOX1)\nhaem → biliverdin + Fe²⁺ + CO", fillcolor="#dcedc8"];
    BVR    [label="biliverdin reductase", fillcolor="#dcedc8"];
    BILU   [label="unconjugated bilirubin\n34 mg per g of haemoglobin", fillcolor="#dcedc8"];
    ALBB   [label="albumin binding\n(displaced by sulfonamides, acidosis)", fillcolor="#dcedc8"];
    OATP   [label="hepatic uptake OATP1B1/1B3", fillcolor="#dcedc8"];
    UGT    [label="UGT1A1 conjugation", fillcolor="#dcedc8"];
    GILB   [label="UGT1A1*28 (TA)₇/(TA)₇ — Gilbert\n~29% of normal activity", fillcolor="#c5e1a5"];
    MRP2   [label="MRP2 canalicular export", fillcolor="#dcedc8"];
    BILC   [label="conjugated bilirubin → bile", fillcolor="#dcedc8"];
    UROB   [label="urobilinogen ↑ (urine, stool)", fillcolor="#dcedc8"];
    COEX   [label="exhaled CO (ETCOc)\ndirect haemolysis read-out", fillcolor="#dcedc8"];
  }

  /* =================================================================
     12. PIGMENT GALLSTONES
     ================================================================= */
  subgraph cluster_stone {
    label="12. 색소성 담석 · Pigment gallstone formation";
    style="rounded,filled"; fillcolor="#f9fbe7"; fontsize=11; color="#827717";
    BGLUC  [label="biliary β-glucuronidase\ndeconjugation in bile", fillcolor="#f0f4c3"];
    UCBBIL [label="unconjugated bilirubin in bile", fillcolor="#f0f4c3"];
    CABIL  [label="calcium bilirubinate\nprecipitation / nucleation", fillcolor="#f0f4c3"];
    STONE  [label="black pigment gallstones\n40–60% of HS adults", fillcolor="#f0f4c3"];
    CHOLE  [label="cholecystitis · biliary colic\ncholedocholithiasis · pancreatitis", fillcolor="#f0f4c3"];
  }

  /* =================================================================
     13. IRON
     ================================================================= */
  subgraph cluster_fe {
    label="13. 철 대사 · Iron";
    style="rounded,filled"; fillcolor="#fff3e0"; fontsize=11; color="#e65100";
    HEPC   [label="hepcidin", fillcolor="#ffe0b2"];
    FPN    [label="ferroportin (SLC40A1)\nduodenum + macrophage export", fillcolor="#ffe0b2"];
    DMT1   [label="DMT1 duodenal uptake", fillcolor="#ffe0b2"];
    FERR   [label="serum ferritin", fillcolor="#ffe0b2"];
    LIVFE  [label="liver iron concentration\n(MRI R2*/T2*)", fillcolor="#ffe0b2"];
    HFE    [label="HFE co-inheritance\n(C282Y/H63D) worsens loading", fillcolor="#ffe0b2"];
    TXFE   [label="transfusional iron\n~200 mg per unit", fillcolor="#ffe0b2"];
  }

  /* =================================================================
     14. CRISES
     ================================================================= */
  subgraph cluster_crisis {
    label="14. 위기 · The three crises of HS";
    style="rounded,filled"; fillcolor="#fce4ec"; fontsize=11; color="#ad1457";
    PARVO  [label="parvovirus B19\nP antigen (globoside) receptor\non erythroid progenitors", fillcolor="#f8bbd0"];
    APLAS  [label="APLASTIC CRISIS\nproduction stops 7–10 d\nΔHb ≈ Hb × days/lifespan", fillcolor="#f48fb1", penwidth=1.6];
    MEGAL  [label="MEGALOBLASTIC CRISIS\nfolate exhausted", fillcolor="#f8bbd0"];
    HAEMC  [label="HAEMOLYTIC CRISIS\nintercurrent infection →\nmacrophage activation", fillcolor="#f8bbd0"];
    NEOJ   [label="neonatal jaundice\n(immature UGT1A1 + haemolysis)\n→ kernicterus risk", fillcolor="#f8bbd0"];
    LATEAN [label="late neonatal anaemia (wk 3–8)\nphysiological EPO nadir + HS", fillcolor="#f8bbd0"];
  }

  /* =================================================================
     15. DIAGNOSTICS
     ================================================================= */
  subgraph cluster_dx {
    label="15. 진단 검사 · Diagnostics — all of them read (S, V)";
    style="rounded,filled"; fillcolor="#eceff1"; fontsize=11; color="#37474f";
    EMA    [label="EMA binding (flow cytometry)\nMFI ∝ band 3 copies ∝ AREA\ncut-off ≈ 16–21% reduction", fillcolor="#cfd8dc"];
    OFT    [label="osmotic fragility (immediate)\n50% lysis where V reaches V_sph\nnormal 0.43 → HS 0.55–0.65 %NaCl", fillcolor="#cfd8dc"];
    OFI    [label="incubated OF (24 h, 37 °C)\nATP depletion exaggerates the defect", fillcolor="#cfd8dc"];
    AGLT   [label="acidified glycerol lysis time\n(AGLT₅₀)", fillcolor="#cfd8dc"];
    EKTA   [label="osmotic gradient ektacytometry\nO_min (S/V) · EI_max (area) · O_hyper (hydration)", fillcolor="#cfd8dc"];
    CRYO   [label="cryohaemolysis test", fillcolor="#cfd8dc"];
    SMEAR  [label="blood film: spherocytes,\nno central pallor, polychromasia", fillcolor="#cfd8dc"];
    CBCIDX [label="MCHC ≥ 35.4 + RDW ≥ 14\n(high specificity screen)", fillcolor="#cfd8dc"];
    DAT    [label="DAT / Coombs NEGATIVE\n(separates HS from warm AIHA)", fillcolor="#cfd8dc"];
  }

  /* =================================================================
     16. SURGERY
     ================================================================= */
  subgraph cluster_surg {
    label="16. 수술 · Surgery — removing the amplifier, not the defect";
    style="rounded,filled"; fillcolor="#e3f2fd"; fontsize=11; color="#1565c0";
    TSPLX  [label="TOTAL SPLENECTOMY\nremoves sink AND amplifier", fillcolor="#bbdefb", penwidth=1.6];
    PSPLX  [label="PARTIAL (subtotal) splenectomy\nleave 10–20% of mass", fillcolor="#bbdefb"];
    REGROW [label="splenic remnant regrowth\n→ recurrence of haemolysis", fillcolor="#bbdefb"];
    CCY    [label="cholecystectomy\n(± concurrent with splenectomy)", fillcolor="#bbdefb"];
    ACCESS [label="accessory spleen (15–30%)\nmissed → apparent failure", fillcolor="#bbdefb"];
    OPSI   [label="OPSI risk\nencapsulated organisms\n(pneumococcus, Hib, meningococcus)", fillcolor="#ffcdd2"];
    VACC   [label="vaccination + penicillin prophylaxis\nsurgery deferred to age ≥ 6 y", fillcolor="#bbdefb"];
    THROMB [label="post-splenectomy thrombosis\nportal vein · VTE · pulmonary HTN\n· accelerated atherosclerosis", fillcolor="#ffcdd2"];
    HJB    [label="Howell-Jolly bodies\n(proof of asplenia)", fillcolor="#cfd8dc"];
  }

  /* =================================================================
     17. PHARMACOLOGY
     ================================================================= */
  subgraph cluster_drug {
    label="17. 약물 · Pharmacology";
    style="rounded,filled"; fillcolor="#e1f5fe"; fontsize=11; color="#01579b";
    MITA   [label="MITAPIVAT (PKR activator)\noral, t½ ≈ 3–5 h, BID", fillcolor="#bbdefb", penwidth=1.6];
    MITPD  [label="allosteric PKR activation\n→ ATP ↑ · 2,3-DPG ↓", fillcolor="#bbdefb"];
    FOLATE [label="folic acid 1–5 mg/day\nprevents megaloblastic crisis", fillcolor="#bbdefb"];
    TXF    [label="red cell transfusion\ndonor cells have NORMAL geometry\n→ substrate dilution", fillcolor="#bbdefb"];
    CHEL   [label="iron chelation\ndeferasirox · deferiprone", fillcolor="#bbdefb"];
    PHOTO  [label="neonatal phototherapy\n± exchange transfusion", fillcolor="#bbdefb"];
    EPOTX  [label="rhEPO (neonatal / infant\nlate anaemia, transfusion-sparing)", fillcolor="#bbdefb"];
    URSO   [label="ursodeoxycholic acid\n(stone prevention, weak evidence)", fillcolor="#bbdefb"];
  }

  /* =================================================================
     18. CLINICAL ENDPOINTS
     ================================================================= */
  subgraph cluster_end {
    label="18. 임상 결과 · Clinical endpoints";
    style="rounded,filled"; fillcolor="#e8f5e9"; fontsize=11; color="#1b5e20";
    HBEND  [label="haemoglobin (g/dL)\nmild >11 · moderate 8–11 · severe <8", fillcolor="#a5d6a7", penwidth=1.6];
    JAUND  [label="jaundice / scleral icterus", fillcolor="#a5d6a7"];
    SPLMEG [label="splenomegaly\n(palpable, US length)", fillcolor="#a5d6a7"];
    FATIG  [label="fatigue · exercise intolerance", fillcolor="#a5d6a7"];
    GROWTH [label="growth failure (severe, untreated)", fillcolor="#a5d6a7"];
    ULCER  [label="chronic leg ulcers (rare)", fillcolor="#a5d6a7"];
    TXDEP  [label="transfusion dependence", fillcolor="#a5d6a7"];
    QOL    [label="quality of life · school/work days", fillcolor="#a5d6a7"];
    RETIC  [label="reticulocyte count\n(6–20% in untreated HS)", fillcolor="#a5d6a7"];
  }

  /* =================================================================
     EDGES
     ================================================================= */

  /* --- genotype to structure --- */
  ANK1 -> ANKP;  SPTB -> SPTET;  SPTA1 -> SPTET;  SLC4A1 -> B3;
  EPB42 -> P42;  RHAG -> RHCX;   DENOVO -> ANK1 [style=dashed];
  NGS -> ANK1 [style=dotted, dir=back];  NGS -> SLC4A1 [style=dotted, dir=back];
  NGS -> SPTB [style=dotted, dir=back];
  ANK1 -> SPCONT [label="spectrin not\nassembled"];
  SPTB -> SPCONT;  SPTA1 -> SPCONT;
  SPCONT -> UNSUP [label="fdef = 1 − spectrin fraction", fontcolor="#c62828"];

  /* --- structure --- */
  ANKP -> B3 [dir=both, label="vertical link"];
  P42 -> ANKP;  GPA -> B3;  RHCX -> LIPID;  P41 -> SPTET;
  SPTET -> LIPID [label="tethers"];
  B3 -> LIPID [label="anchors"];
  ANKP -> UNSUP [style=dashed, color="#c62828", label="loss →"];
  B3   -> UNSUP [style=dashed, color="#c62828"];
  P42  -> UNSUP [style=dashed, color="#c62828"];
  SPTET-> UNSUP [style=dashed, color="#c62828"];
  AREACOMP -> VSPH [label="why V_sph is a hard ceiling", style=dotted];

  /* --- vesiculation --- */
  UNSUP -> VESIC [color="#c62828", penwidth=1.6, label="unsupported lipid\nbuds off"];
  VESIC -> VESB3;  VESIC -> VESHB;
  VESIC -> ARLOSS [color="#c62828", penwidth=1.8, label="dS/dt < 0"];
  VESHB -> VOLST [label="≈ no volume\nleaves with it", style=dashed];
  ATP -> VESIC [label="ATP ↓ → vesiculation ↑", arrowhead=tee, color="#1565c0"];
  PKR -> ATP;  ATP -> DPG [style=dotted];  ATP -> FLIP;
  ATP -> ECHINO [arrowhead=tee];  ECHINO -> VESIC;
  FLIP -> PSEXP [arrowhead=tee];

  /* --- cation / volume --- */
  UNSUP -> KLEAK;  KLEAK -> DEHYD;  KCC -> DEHYD;  GARDOS -> DEHYD;
  NAKATP -> KLEAK [arrowhead=tee, label="pumps back"];
  ATP -> NAKATP;
  PIEZO -> DEHYD [style=dashed, label="contrast: DHS\nvolume without area"];
  DEHYD -> VOLST [color="#ef6c00", penwidth=1.6, label="dV/dt < 0"];
  VOLST -> MCHCUP [label="MCHC = Hb/V"];
  CORD -> KCC [label="acidosis"];  CORD -> GARDOS [label="Ca²⁺ entry"];

  /* --- geometry kernel --- */
  ARLOSS -> VSPH [penwidth=1.6];
  ARLOSS -> SVRAT;  VOLST -> SVRAT;
  VSPH -> SPHIDX;  VOLST -> SPHIDX [penwidth=1.6];
  SPHIDX -> DCRIT [penwidth=2.0];
  ARLOSS -> DCRIT [penwidth=2.0];
  SPHIDX -> RESERV [arrowhead=tee];
  RESERV -> DCRIT [arrowhead=tee];
  SVRAT -> DCRIT [style=dotted];

  /* --- spleen --- */
  SPART -> WPULP;  SPART -> MZONE;  SPART -> FASTR;  SPART -> SLOWR;
  DCRIT -> PSLOW [color="#c62828", penwidth=2.0, label="the ONLY input\nthe filter has"];
  PSLOW -> SLOWR [penwidth=1.6];
  SLOWR -> CORD;  CORD -> SLIT [label="must cross to exit"];
  DCRIT -> SLIT [color="#c62828", label="D_c vs slit calibre"];
  SLIT -> DWELL;  DCRIT -> DWELL [color="#c62828"];
  DWELL -> POOL;  PSLOW -> POOL;
  POOL -> SPLMASS;  SPLMASS -> SPART [label="flow ∝ mass (≤3×)", style=dotted];
  FASTR -> SPART [style=dotted, dir=back];

  /* --- the amplifier loop (red) --- */
  CORD -> STRIP [color="#b71c1c", penwidth=1.8];
  DWELL -> STRIP [color="#b71c1c", penwidth=1.8, label="exposure = τ_c × visits"];
  STRIP -> VESIC [color="#b71c1c", penwidth=2.2, label="×42 vesiculation"];
  STRIP -> CONDIT [color="#b71c1c"];
  CONDIT -> LOOP [color="#b71c1c", penwidth=1.6];
  ARLOSS -> LOOP [color="#b71c1c", style=dashed];
  LOOP -> DCRIT [color="#b71c1c", penwidth=2.4, label="feedback closes here"];
  CORD -> ATP [arrowhead=tee, color="#b71c1c", label="glucose-poor,\nhypoxic"];
  CORD -> PITTED;

  /* --- clearance --- */
  CORD -> RPMAC;  RPMAC -> HGEOM [penwidth=1.6];
  DWELL -> HGEOM [color="#b71c1c", label="π_dest = 1 − e^{−k_ph τ_c}"];
  PSLOW -> HGEOM [penwidth=1.6];
  VESB3 -> B3CLUS [arrowhead=tee, label="band 3 LEAVES\n→ no clusters", color="#2e7d32"];
  B3 -> B3CLUS;
  B3CLUS -> NAB3;  NAB3 -> IGGN;  IGGN -> FCG;  C3B -> RPMAC;
  FCG -> RPMAC;  FCG -> KUPF;
  IGGN -> HOPS [penwidth=1.6];
  RPMAC -> HOPS;  KUPF -> HOPS [label="28% — survives\nsplenectomy", color="#1565c0"];
  CD47 -> RPMAC [arrowhead=tee];
  PSEXP -> RPMAC;  PSEXP -> HSEN;  CD47 -> HSEN [arrowhead=tee];
  B3CLUS -> HSEN [style=dotted];
  HGEOM -> HBEND [arrowhead=tee, penwidth=1.6];
  HOPS -> HBEND [arrowhead=tee];
  HSEN -> HBEND [arrowhead=tee, style=dotted];

  /* --- intravascular --- */
  SPHIDX -> LYSIS [label="s → 1"];
  LYSIS -> FHB;  FHB -> HPT [arrowhead=tee];  FHB -> HPX;
  LYSIS -> LDHN;  FHB -> NOSC;

  /* --- erythropoiesis --- */
  HBEND -> HIF2 [arrowhead=tee, label="tissue O₂"];
  HIF2 -> EPO;  EPO -> BFUE;  BFUE -> ERYBL;  ERYBL -> RETM;
  RETM -> RETB;  RETB -> ARLOSS [style=dotted, label="new cells enter\nwith area A₀"];
  RETB -> RETIC;  EPO -> RETM [label="shift reticulocytes"];
  MAREXP -> BFUE [arrowhead=tee, penwidth=1.6, label="≤8× ceiling"];
  EPO -> EMH;  BFUE -> FOLDEM;  FOLDEM -> MEGAL;
  BFUE -> ERFE;  ERFE -> HEPC [arrowhead=tee];
  RETB -> HBEND [penwidth=1.6];

  /* --- haem catabolism --- */
  HGEOM -> HO1 [label="haem load"];
  HOPS -> HO1;  HSEN -> HO1;
  HO1 -> BVR;  BVR -> BILU;  HO1 -> COEX;  HO1 -> FERR [label="recycled Fe"];
  BILU -> ALBB;  ALBB -> OATP;  OATP -> UGT;  UGT -> BILC;
  GILB -> UGT [arrowhead=tee, penwidth=1.6, label="29% activity"];
  BILC -> MRP2;  MRP2 -> UROB;  BILU -> JAUND [penwidth=1.6];
  BILU -> NEOJ;

  /* --- stones --- */
  MRP2 -> BGLUC;  BGLUC -> UCBBIL;  BILU -> UCBBIL [style=dotted];
  UCBBIL -> CABIL;  CABIL -> STONE;  STONE -> CHOLE;
  GILB -> STONE [style=dashed, color="#c62828", label="~5× risk\nwhen co-inherited"];
  CCY -> CHOLE [arrowhead=tee, color="#1565c0"];
  URSO -> CABIL [arrowhead=tee, color="#1565c0", style=dashed];

  /* --- iron --- */
  HEPC -> FPN [arrowhead=tee];  FPN -> DMT1;  DMT1 -> LIVFE;
  TXFE -> LIVFE;  LIVFE -> FERR;  HFE -> HEPC [arrowhead=tee];
  CHEL -> LIVFE [arrowhead=tee, color="#1565c0"];
  LIVFE -> HEPC;

  /* --- crises --- */
  PARVO -> BFUE [arrowhead=tee, penwidth=1.8, color="#ad1457",
                 label="P antigen; 7–10 d arrest"];
  PARVO -> APLAS;  APLAS -> HBEND [arrowhead=tee, penwidth=1.8];
  MEGAL -> HBEND [arrowhead=tee];  HAEMC -> RPMAC [label="macrophage\nactivation"];
  HAEMC -> HBEND [arrowhead=tee];
  NEOJ -> PHOTO [dir=back, color="#1565c0"];
  LATEAN -> EPOTX [dir=back, color="#1565c0"];
  EPO -> LATEAN [arrowhead=tee, style=dotted, label="physiological nadir"];

  /* --- diagnostics read the geometry --- */
  ARLOSS -> EMA [style=dotted, color="#37474f", penwidth=1.4,
                 label="EMA MFI ∝ S"];
  VSPH -> OFT [style=dotted, color="#37474f", penwidth=1.4,
               label="lysis when V = V_sph"];
  OFT -> OFI [style=dotted];  ATP -> OFI [arrowhead=tee, style=dotted];
  SPHIDX -> EKTA [style=dotted, color="#37474f"];
  VOLST -> EKTA [style=dotted];
  OFT -> AGLT [style=dotted];  OFT -> CRYO [style=dotted];
  SPHIDX -> SMEAR [style=dotted];  MCHCUP -> CBCIDX [style=dotted];
  DAT -> HOPS [style=dotted, dir=back,
               label="natural IgG is below\nDAT detection"];

  /* --- surgery --- */
  TSPLX -> SPART [arrowhead=tee, color="#1565c0", penwidth=2.2,
                  label="removes the whole organ:\nsink AND amplifier"];
  TSPLX -> STRIP [arrowhead=tee, color="#1565c0", penwidth=2.0];
  TSPLX -> HGEOM [arrowhead=tee, color="#1565c0", penwidth=2.0];
  TSPLX -> HOPS  [arrowhead=tee, color="#1565c0", style=dashed,
                  label="only the splenic 72%"];
  PSPLX -> SPLMASS [arrowhead=tee, color="#1565c0"];
  PSPLX -> REGROW;  REGROW -> SPLMASS [color="#c62828"];
  ACCESS -> SPART [style=dashed, label="residual filter"];
  TSPLX -> OPSI [color="#c62828"];  TSPLX -> THROMB [color="#c62828"];
  TSPLX -> HJB;  VACC -> OPSI [arrowhead=tee, color="#1565c0"];
  TSPLX -> HBEND [color="#1565c0", penwidth=1.8, label="Hb +2–4 g/dL"];
  TSPLX -> ARLOSS [style=dashed, color="#c62828",
                   label="does NOT fix the\ninherited defect"];
  TSPLX -> EMA [style=dashed, label="EMA stays abnormal"];
  TSPLX -> OFT [style=dashed, label="OF stays abnormal"];

  /* --- drugs --- */
  MITA -> MITPD;  MITPD -> ATP [color="#1565c0", penwidth=1.8];
  MITPD -> DPG [arrowhead=tee, color="#1565c0"];
  DPG -> EPO [style=dotted, label="O₂ affinity ↑\n→ EPO drive ↑"];
  FOLATE -> FOLDEM [arrowhead=tee, color="#1565c0"];
  TXF -> HBEND [color="#1565c0", penwidth=1.6];
  TXF -> EPO [arrowhead=tee, color="#1565c0", label="suppresses\nendogenous production"];
  TXF -> TXFE [color="#c62828"];
  PHOTO -> BILU [arrowhead=tee, color="#1565c0"];
  EPOTX -> BFUE [color="#1565c0"];

  /* --- endpoints --- */
  SPLMASS -> SPLMEG [penwidth=1.6];
  HBEND -> FATIG [arrowhead=tee];  HBEND -> GROWTH [arrowhead=tee];
  HBEND -> QOL [arrowhead=tee];  HBEND -> TXDEP [arrowhead=tee];
  FHB -> ULCER [style=dotted];  HBEND -> EXER [style=invis];
  JAUND -> QOL [arrowhead=tee];  STONE -> QOL [arrowhead=tee];
  DPG -> FATIG [style=dotted, label="O₂ unloading"];
  EXER [label="exercise capacity\n(O₂ delivery = Hb × CO × extraction)", fillcolor="#a5d6a7"];
  HBEND -> EXER;  DPG -> EXER [style=dotted];
  TXDEP -> TXFE;

  /* --- rank hints --- */
  { rank=same; ARLOSS; VOLST; }
  { rank=same; HGEOM; HOPS; HSEN; }
}
