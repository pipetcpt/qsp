  IRON -> ROS [label="Fenton"];
  OXSTRESS -> IRON;
  AXON_ENERGY -> N_LOSS_HUB [label="−", color="#2a7a2a", penwidth=1.3];

  /* --- 5: neuroinflammation ------------------------------------------ */
  SEED_EX -> TLR2_4;
  TLR2_4 -> MGL_ACT [penwidth=1.2];
  MGL_ACT -> NLRP3;
  NLRP3 -> TNF_IL6;
