  /* --- shared neurodegeneration hub ---------------------------------- */
  N_LOSS_HUB [label="NEURODEGENERATION DRIVE\n(shared hazard applied to every\nvulnerable population)", shape=hexagon, style="filled", fillcolor="#f0d0d0", penwidth=1.6, fontsize=10];
