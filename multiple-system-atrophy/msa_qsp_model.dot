    OSMO [label="Osmoreceptor\n(intact)", fillcolor="#dceaf2"];
    AVP_BARO [label="BARORECEPTOR-mediated\nAVP release ABSENT\n(hypotension no longer\nreleases AVP)", fillcolor="#c8dfeb", penwidth=1.4];
    AVP_PL [label="Plasma AVP\n(model AVP)", fillcolor="#c8dfeb"];
    V2R [label="Collecting-duct V2R\n→ cAMP → PKA", fillcolor="#dceaf2"];
