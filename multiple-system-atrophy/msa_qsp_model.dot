  /* ================================================================ */
  subgraph cluster_19 {
    label="19. 승압 약물 PK/PD (Pressor Pharmacology)"; style="filled"; color="#8caac8"; fillcolor="#eef3f9"; fontsize=11;
    MIDO_DOSE [label="MIDODRINE 2.5–10 mg\nPO t.i.d. (never <4 h\nbefore recumbency)", shape=note, fillcolor="#dbe6f4"];
    MIDO_PK [label="Midodrine prodrug\n(model MID_c)\nt½ ≈ 0.5 h", fillcolor="#dbe6f4"];
    DMM [label="DESGLYMIDODRINE (DMM)\nactive metabolite\nt½ ≈ 3 h (model DMM)", fillcolor="#c2d8ee"];
    DMM_A1 [label="DMM → peripheral α1\nAGONIST (no CNS entry)\n★ works downstream of\nEVERY lesion", fillcolor="#c2d8ee", penwidth=1.4];
    DROX_DOSE [label="DROXIDOPA 100–600 mg\nPO t.i.d.", shape=note, fillcolor="#dbe6f4"];
    DROX_PK [label="Droxidopa (L-threo-DOPS)\n(model DRX_c) t½ ≈ 2.5 h", fillcolor="#dbe6f4"];
    DROX_AADC [label="Peripheral AADC\nconverts droxidopa → NE\n★ REQUIRES residual\npostganglionic terminals", fillcolor="#c2d8ee", penwidth=1.4];
    CARBI_BLOCK [label="CARBIDOPA INHIBITS the\nsame peripheral AADC\n★ drug–drug antagonism", fillcolor="#f0c8c8", penwidth=1.6];
    ATX_DOSE [label="ATOMOXETINE 10–18 mg\n(off-label pressor)", shape=note, fillcolor="#dbe6f4"];
    ATX_PK [label="Atomoxetine (model ATX)\nCYP2D6 poor metaboliser\nAUC ×10", fillcolor="#dbe6f4"];
    ATX_NET [label="NET blockade AMPLIFIES\nEXISTING NE release\n★ needs central lesion +\nintact terminals → MSA-\nselective", fillcolor="#c2d8ee", penwidth=1.4];
    FLUDRO_DOSE [label="FLUDROCORTISONE\n0.1–0.2 mg daily", shape=note, fillcolor="#dbe6f4"];
    FLUDRO_MR [label="Mineralocorticoid receptor\n→ ENaC → Na⁺/volume\n(+ hypokalaemia, oedema,\nsupine HTN)", fillcolor="#c2d8ee"];
    PYRIDO_DOSE [label="PYRIDOSTIGMINE 60 mg\nt.i.d.", shape=note, fillcolor="#dbe6f4"];
    PYRIDO_AChE [label="Ganglionic AChE inhibition\n→ amplifies BAROREFLEX-\nDRIVEN traffic only\n★ little supine HTN", fillcolor="#c2d8ee"];
    YOHIM [label="YOHIMBINE — α2\nantagonist; needs residual\ncentral drive", fillcolor="#dbe6f4"];
    OCTREO [label="OCTREOTIDE 25–50 µg SC\n— splanchnic\nvasoconstriction for\npost-prandial hypotension", fillcolor="#dbe6f4"];
    DDAVP_DOSE [label="DESMOPRESSIN 1–2 µg IM /\n5–40 µg nasal at BEDTIME", shape=note, fillcolor="#dbe6f4"];
    DDAVP_PD [label="V2R agonism → blocks\nNOCTURNAL polyuria\n★ raises NEXT-MORNING\nstanding BP", fillcolor="#c2d8ee", penwidth=1.4];
    WATER_BOLUS [label="500 mL WATER BOLUS\n→ osmopressor response\n(TRPV4 / spinal reflex)\n+20–30 mmHg for ~1 h", fillcolor="#dbe6f4"];
    COMPRESS [label="Abdominal binder /\ncompression stockings\n(30–40 mmHg)", fillcolor="#dbe6f4"];
    COUNTER [label="Physical counter-\nmanoeuvres · slow rising ·\nsmall low-carb meals", fillcolor="#dbe6f4"];
  }

