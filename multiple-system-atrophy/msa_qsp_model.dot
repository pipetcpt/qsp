  FLUDRO_MR -> SUPINE_HTN [label="volume-mediated", color="#b03030"];
  FLUDRO_MR -> HYPOK [label="K⁺ wasting"];
  HYPOK [label="Hypokalaemia · oedema ·\nheart-failure risk\n(fludrocortisone ceiling)", fillcolor="#fbe4e4"];

  PYRIDO_DOSE -> PYRIDO_AChE;
  PYRIDO_AChE -> GANGLION [label="amplifies nicotinic\ntransmission", penwidth=1.3, color="#1a6a1a"];
  CENTRAL_GAIN -> PYRIDO_AChE [label="effect ∝ residual\nbaroreflex traffic", style=dashed, penwidth=1.2];

  YOHIM -> A2_PRE [label="− blockade", color="#b03030"];
  CENTRAL_GAIN -> YOHIM [label="needs residual\ncentral drive", style=dashed];
  OCTREO -> SPLANCH [label="− pooling", color="#1a6a1a", penwidth=1.2];
  OCTREO -> PPH [label="−", color="#1a6a1a"];

  DDAVP_DOSE -> DDAVP_PD;
  DDAVP_PD -> V2R [penwidth=1.4, color="#1a6a1a"];
  DDAVP_PD -> HYPONA_RISK [color="#b03030"];
  WATER_BOLUS -> TPR [label="osmopressor\nreflex", color="#1a6a1a", penwidth=1.2];
  WATER_BOLUS -> ECF;

  /* --- 20: dopaminergic & disease-modifying -------------------------- */
  LDOPA_DOSE -> LDOPA_PK;
  LDOPA_DOSE -> CARBI_PK [label="fixed-dose\ncombination", penwidth=1.3];
  LDOPA_PK -> LDOPA_BRAIN [penwidth=1.3];
  CARBI_PK -> LDOPA_BRAIN [label="+ raises central\navailability", color="#1a6a1a"];
  LDOPA_BRAIN -> DA_SYN [penwidth=1.4, color="#1a6a1a"];
  LDOPA_BRAIN -> DA_REL [penwidth=1.3];
  AMANT -> DA_REL [style=dashed];
  UBIQ -> COQ10_LVL [penwidth=1.3, color="#1a6a1a"];
  VERDI -> MPO [label="− irreversible", color="#b03030", penwidth=1.3];
  MAB_ASYN -> SEED_EX [label="− neutralises\nEXTRACELLULAR only", color="#b03030", penwidth=1.3];
  ASO_SNCA -> SNCA_mRNA [label="−", color="#b03030"];
  MSC -> MGL_ACT [label="−", style=dashed];
  RIFAM_NEG -> NUCLEATION [label="− (trial failed)", style=dotted];
  EXERCISE -> UMSARS1 [label="−disability", color="#1a6a1a"];
  EXERCISE -> STRIDOR [label="CPAP /\ntracheostomy", color="#1a6a1a"];
  N_LOSS_HUB -> WINDOW [label="closes the window", color="#b03030", penwidth=1.4];
  WINDOW -> MAB_ASYN [label="gates achievable\nbenefit", style=dashed, penwidth=1.3];
  WINDOW -> UBIQ [style=dashed];
  WINDOW -> VERDI [style=dashed];

  /* --- 21: biomarkers ------------------------------------------------ */
  ASTRO -> GFAP_BM;
  ASYN_OLIG -> CSF_ASYN;
  SEED_EX -> SKIN_BX;
  POSTGANG -> SKIN_BX [label="adrenergic-fibre\npattern"];
  TILT_BM -> SBP_STAND [dir=back];
  HR_RATIO -> MSA_ICC;
  QSART_BM -> MSA_ICC;
  CEREB_MRI -> MSA_ICC;
  RT_QUIC -> MSA_ICC [style=dashed, label="research"];
  NFL -> SURVIVAL [label="predicts", style=dashed];

  /* --- 22: endpoints ------------------------------------------------- */
  SBP_STAND -> OHSA [label="symptom burden", penwidth=1.4];
  OHSA -> UMSARS1 [penwidth=1.2];
  SCOPA -> UMSARS1;
  PVR -> SCOPA;
  ED -> SCOPA;
  UMSARS1 -> UMSARS4;
  UMSARS2 -> UMSARS4 [penwidth=1.3];
  UMSARS2 -> WHEELCHAIR [penwidth=1.3];
  WHEELCHAIR -> SURVIVAL [label="−", color="#b03030"];
  FALLS_EP -> SURVIVAL [label="−", color="#b03030"];
  UMSARS4 -> QOL [label="−"];
  OHSA -> QOL [label="−"];
  TARGET_ORGAN -> SURVIVAL [label="−", style=dashed, color="#b03030"];
  COG_EP -> QOL [label="−", style=dashed];
  UMSARS2 -> SURVIVAL [label="rate of change\npredicts", style=dashed, color="#b03030"];

  /* --- legend -------------------------------------------------------- */
  subgraph cluster_legend {
    label="범례 (Legend)"; style="filled"; color="#999999"; fillcolor="#fafafa"; fontsize=10;
    LG1 [label="검은 화살표 = 정보/물질 흐름", fillcolor="#ffffff", shape=plaintext];
    LG2 [label="빨간 화살표 = 억제 / 손상 / 악화", fillcolor="#ffffff", shape=plaintext, fontcolor="#b03030"];
    LG3 [label="초록 화살표 = 보존 / 치료적 이득", fillcolor="#ffffff", shape=plaintext, fontcolor="#1a6a1a"];
    LG4 [label="점선 = 약한 / 가설적 / 게이팅 관계", fillcolor="#ffffff", shape=plaintext];
    LG5 [label="★ = 임상적으로 결정적인 노드", fillcolor="#ffffff", shape=plaintext];
    LG6 [label="note 모양 = 투여 요법 (dosing regimen)", fillcolor="#ffffff", shape=plaintext];
    LG1 -> LG2 [style=invis];
    LG2 -> LG3 [style=invis];
    LG3 -> LG4 [style=invis];
    LG4 -> LG5 [style=invis];
    LG5 -> LG6 [style=invis];
  }
}
