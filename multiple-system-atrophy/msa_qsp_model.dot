/* =====================================================================
   Multiple System Atrophy (MSA) — Mechanistic QSP Map
   ---------------------------------------------------------------------
   ORGANISING PRINCIPLE.  The clinically dominant problem in MSA is not a
   rate but a BROKEN CONTROL LOOP.  Upright blood pressure is the PRODUCT of
   a chain of independently breakable gains:

     dMAP(upright) =  [baroreceptor afferent signal]
                    x [central medullary integration  NTS -> CVLM -> RVLM]
                    x [preganglionic output (IML column survival)]
                    x [POSTGANGLIONIC releasable NE pool]
                    x [vascular alpha1-adrenoceptor density]
                    x [effective circulating volume]
                    x [venous capacitance / splanchnic pooling]

   MSA drives the CENTRAL terms toward zero while leaving the POSTGANGLIONIC
   term comparatively intact.  Pure autonomic failure (PAF) and Parkinson
   disease do the opposite.  That single difference in WHERE the product is
   broken - not how severe the orthostatic hypotension is - is what decides
   which drug works:

     midodrine      acts DOWNSTREAM of every lesion  -> works in both
     droxidopa      needs postganglionic AADC         -> and carbidopa blocks it
     atomoxetine    amplifies EXISTING tonic NE release -> works in MSA (central
                                                          lesion, intact terminals),
                                                          fails in PAF
     yohimbine      needs residual central drive      -> MSA only

   SECOND STRUCTURAL CLAIM.  The ceiling on pressor therapy is set by a
   NOCTURNAL loop, not by daytime potency:
       supine hypertension -> pressure natriuresis at night -> overnight volume
       loss -> WORSE morning orthostatic hypotension -> more pressor -> ...
   Head-up tilt sleeping and bedtime desmopressin therefore raise DAYTIME
   standing BP with no daytime pressor at all.

   THIRD STRUCTURAL CLAIM.  Levodopa failure in MSA-P is POSTSYNAPTIC.
   Parkinson disease loses the presynaptic terminal (levodopa substitutes for
   it); MSA-P additionally loses the striatal medium spiny neuron and its
   D2 receptors (nothing to substitute onto).  Same drug, same brain exposure,
   different target -> partial early response that wanes, and no dyskinesia.

   FOURTH STRUCTURAL CLAIM.  MSA is a GLIAL proteinopathy.  alpha-synuclein
   aggregates in OLIGODENDROCYTES (glial cytoplasmic inclusions) after p25alpha
   / TPPP relocates from myelin to the soma; myelin fails; trophic support to
   the axon fails; neuronal death is DOWNSTREAM.  Neuron-directed therapy is
   therefore aimed at the wrong compartment.

   Render:
     dot -Tsvg msa_qsp_model.dot -o msa_qsp_model.svg
     dot -Tpng -Gdpi=150 msa_qsp_model.dot -o msa_qsp_model.png
   ===================================================================== */

digraph MSA_QSP {
  rankdir=LR;
  newrank=true;
  compound=true;
  fontname="Helvetica";
  fontsize=11;
  labelloc="t";
  label=<<B>Multiple System Atrophy (MSA) — Mechanistic QSP Map</B><BR/>Oligodendroglial α-synuclein (GCI) → myelin failure → central autonomic + striatonigral + olivopontocerebellar neuronal loss → a baroreflex loop broken CENTRALLY while postganglionic terminals survive<BR/><FONT POINT-SIZE="10">Drug layer: midodrine · droxidopa (± carbidopa interaction) · fludrocortisone · atomoxetine · pyridostigmine · yohimbine · octreotide · desmopressin · levodopa/carbidopa · ubiquinol · verdiperstat · anti-α-synuclein mAb / ASO</FONT>>;
  node [style="filled,rounded", shape=box, fontname="Helvetica", fontsize=9, color="#5b5b5b", penwidth=0.7];
  edge [fontname="Helvetica", fontsize=7.5, color="#6b6b6b", arrowsize=0.6];
  graph [nodesep=0.20, ranksep=0.58];

  /* ================================================================ */
  subgraph cluster_01 {
    label="1. 유전·위험인자 (Genetic & Environmental Risk)"; style="filled"; color="#d8c6e6"; fillcolor="#f5eefb"; fontsize=11;
    SNCA_LOCUS [label="SNCA locus\n(4q22) risk variants\nrs11931074 / rs3857059", fillcolor="#ede0f7"];
    COQ2 [label="COQ2 (4q21)\nV393A / R387X\npara-hydroxybenzoate\npolyprenyltransferase", fillcolor="#ede0f7"];
    MAPT_H1 [label="MAPT H1 haplotype\n(weak, MSA-P)", fillcolor="#ede0f7"];
    GBA1 [label="GBA1 variants\nlysosomal GCase ↓", fillcolor="#ede0f7"];
    LRRK2_NEG [label="LRRK2 / PRKN\nNOT associated\n(≠ Parkinson disease)", fillcolor="#f6eef6"];
    ENV_SOLV [label="Occupational solvent /\nmetal / pesticide exposure\n(weak epidemiology)", fillcolor="#f6f0e8"];
    SPORADIC [label="≈99% SPORADIC\nmean onset 56 yr\nprevalence 3–5 / 10^5", fillcolor="#ede0f7"];
    NO_LEWY [label="No Lewy-body co-pathology\nrequired\n(distinct α-syn STRAIN)", fillcolor="#f6eef6"];
  }

  /* ================================================================ */
  subgraph cluster_02 {
    label="2. 올리고덴드로글리아 α-시누클레인 병리 (Oligodendroglial α-Synuclein / GCI)"; style="filled"; color="#e0b0b0"; fillcolor="#fdf0f0"; fontsize=11;
    SNCA_mRNA [label="SNCA transcription\nin oligodendrocyte\n(low but non-zero)", fillcolor="#fbdede"];
    ASYN_UPTAKE [label="Neuronal α-syn UPTAKE\nby oligodendrocyte\n(TLR2 / heparan sulfate /\nLAG3-independent)", fillcolor="#fbdede"];
    ASYN_MON [label="α-syn MONOMER pool\n(oligodendroglial cytosol)", fillcolor="#f9caca"];
    P25A [label="p25α / TPPP\nRELOCALISES\nmyelin → soma", fillcolor="#f7b8b8"];
    NUCLEATION [label="p25α-templated\nNUCLEATION\n(rate-limiting step)", fillcolor="#f9caca"];
    ASYN_OLIG [label="α-syn OLIGOMER\n(toxic species)", fillcolor="#f7b8b8"];
    ASYN_PSER129 [label="pSer129 α-syn\n(phospho-epitope,\nPLK2 / CK2)", fillcolor="#f9caca"];
    GCI [label="GCI burden\nGlial Cytoplasmic Inclusion\n(Papp–Lantos body)\n★ pathognomonic", fillcolor="#f09a9a", penwidth=1.6];
    NCI [label="Neuronal cytoplasmic\ninclusions (secondary,\nsparse)", fillcolor="#fbdede"];
    STRAIN [label="MSA α-syn STRAIN\nhigh seeding efficiency,\nprotease-resistant core", fillcolor="#f7b8b8"];
    AUTOPHAGY [label="Autophagy–lysosome\nflux (p62 / LC3-II)\nOVERWHELMED", fillcolor="#fbdede"];
    UPS [label="Ubiquitin–proteasome\ncapacity ↓", fillcolor="#fbdede"];
  }

  /* ================================================================ */
  subgraph cluster_03 {
    label="3. 미엘린·지질 대사 실패 (Myelin & Lipid Metabolism Failure)"; style="filled"; color="#c8b48c"; fillcolor="#faf5e8"; fontsize=11;
    MBP_LOSS [label="MBP / PLP / CNP\ndownregulation", fillcolor="#f2e6c8"];
    SREBP [label="SREBP-1/2 lipogenic\nprogramme disrupted", fillcolor="#f2e6c8"];
    MYE_INT [label="MYELIN INTEGRITY\n(model state MYE)", fillcolor="#ecd8a8", penwidth=1.4];
    DEMYE [label="Demyelination +\nmyelin-debris release", fillcolor="#f2e6c8"];
    TROPHIC [label="Oligodendroglial TROPHIC\nsupport to axon\n(GDNF / BDNF / lactate\nvia MCT1)", fillcolor="#ecd8a8"];
    AXON_ENERGY [label="Axonal energy supply\n(oligo→axon lactate shuttle)", fillcolor="#f2e6c8"];
    WM_MRI [label="White-matter\ndiffusivity ↑ (MD),\nFA ↓ on DTI", fillcolor="#f7f2e2"];
    HOT_CROSS [label="\"Hot cross bun\" sign\n(pontine transverse\nfibre loss, MSA-C)", fillcolor="#f7f2e2"];
    PUT_RIM [label="Putaminal rim /\nT2* iron deposition\n(MSA-P, 7T)", fillcolor="#f7f2e2"];
  }

  /* ================================================================ */
  subgraph cluster_04 {
    label="4. 미토콘드리아·CoQ10 축 (Mitochondrial & Coenzyme Q10 Axis)"; style="filled"; color="#9fc4a8"; fillcolor="#eef8f0"; fontsize=11;
    COQ10_SYN [label="CoQ10 biosynthesis\n(COQ2 step)", fillcolor="#d8ecdc"];
    COQ10_LVL [label="Cerebellar CoQ10\ncontent ↓ (even in\nCOQ2-wildtype MSA)", fillcolor="#c4e2ca"];
    ETC [label="Electron transport\nchain complex II+III\nactivity ↓", fillcolor="#d8ecdc"];
    ROS [label="Mitochondrial ROS /\nsuperoxide ↑", fillcolor="#c4e2ca"];
    OXSTRESS [label="Oxidative stress\n(4-HNE, 8-OHdG,\nprotein carbonyl)", fillcolor="#c4e2ca"];
    MPTP_PORE [label="Permeability transition /\ncytochrome-c release", fillcolor="#d8ecdc"];
    NRF2 [label="NRF2 / ARE\nantioxidant response\n(insufficient)", fillcolor="#d8ecdc"];
    IRON [label="Iron dyshomeostasis\n(ferritin, H-ferritin,\nputaminal iron)", fillcolor="#d8ecdc"];
  }

  /* ================================================================ */
  subgraph cluster_05 {
    label="5. 신경염증 (Neuroinflammation: Microglia · MPO · Astrocytes)"; style="filled"; color="#e2b48c"; fillcolor="#fdf3e8"; fontsize=11;
    MGL_ACT [label="Microglial ACTIVATION\n(TSPO-PET signal,\nCD68 / HLA-DR)", fillcolor="#f8dfc0"];
    TLR2_4 [label="TLR2 / TLR4 sensing of\nextracellular α-syn", fillcolor="#f8dfc0"];
    NLRP3 [label="NLRP3 inflammasome\ncaspase-1 → IL-1β", fillcolor="#f4cba0"];
    MPO [label="MYELOPEROXIDASE\n(microglial, ↑ in MSA)", fillcolor="#f4cba0"];
    HOCL [label="HOCl / chlorinating\noxidant burst", fillcolor="#f8dfc0"];
    TNF_IL6 [label="TNF-α · IL-6 · IL-1β\nCSF and plasma ↑", fillcolor="#f8dfc0"];
    ASTRO [label="Reactive astrocytes\n(GFAP ↑, glutamate\nuptake ↓)", fillcolor="#f8dfc0"];
    MSR1 [label="MSR1 / scavenger\nreceptor clearance", fillcolor="#f8dfc0"];
    BBB [label="Blood–brain-barrier\npermeability ↑", fillcolor="#fbeedd"];
    TREG [label="Peripheral Treg\ndysfunction / T-cell\ninfiltration", fillcolor="#fbeedd"];
  }

  /* ================================================================ */
  subgraph cluster_06 {
    label="6. 프리온 유사 전파 (Prion-like Seeding & Spread)"; style="filled"; color="#b7a0d0"; fillcolor="#f3eefa"; fontsize=11;
    SEED_EX [label="Extracellular\nSEEDING-competent α-syn\n(model state SEED)", fillcolor="#e2d4f2"];
    EXO [label="Exosome / EV-mediated\nrelease", fillcolor="#e9dff6"];
    TUNNEL [label="Tunnelling nanotube /\ndirect cell–cell transfer", fillcolor="#e9dff6"];
    RAAB [label="Regional spread:\nspinal IML → medulla →\npons → striatum → cortex", fillcolor="#e2d4f2"];
    RT_QUIC [label="CSF / skin seed\namplification assay\n(RT-QuIC, PMCA)", fillcolor="#efe8f9"];
    GLYMPH [label="Glymphatic clearance\n(AQP4 polarity lost)", fillcolor="#e9dff6"];
  }

  /* ================================================================ */
  subgraph cluster_07 {
    label="7. 중추 자율신경망 (Central Autonomic Network — the BROKEN link)"; style="filled"; color="#8fb8d8"; fillcolor="#eef5fb"; fontsize=11;
    BARO_AFF [label="Baroreceptor AFFERENT\n(carotid sinus / aortic arch\n→ glossopharyngeal, vagal)\nINTACT in MSA", fillcolor="#e0eef8"];
    NTS [label="NTS (nucleus tractus\nsolitarii) neurons\n★ degenerating", fillcolor="#bcdcf2", penwidth=1.4];
    CVLM [label="CVLM GABAergic\nrelay", fillcolor="#cfe6f5"];
    RVLM [label="RVLM (C1 adrenergic)\npremotor sympathetic\n★ degenerating", fillcolor="#bcdcf2", penwidth=1.4];
    IML [label="Spinal IML column\npreganglionic sympathetic\nneurons ★ LOST", fillcolor="#a8d0ee", penwidth=1.6];
    NA_AMB [label="Nucleus ambiguus /\ncardiovagal preganglionic", fillcolor="#cfe6f5"];
    DMV [label="Dorsal motor nucleus\nof vagus", fillcolor="#cfe6f5"];
    ONUF [label="Onuf's nucleus\n(S2–S4) ★ LOST\n(≠ Parkinson disease)", fillcolor="#a8d0ee", penwidth=1.4];
    ARC_SERO [label="Arcuate / raphe\nserotonergic medullary\nneurons LOST", fillcolor="#cfe6f5"];
    PREBOT [label="Pre-Bötzinger complex\nrespiratory rhythm", fillcolor="#cfe6f5"];
    CENTRAL_GAIN [label="CENTRAL BAROREFLEX GAIN\n(model term G_central)", fillcolor="#8cc4e8", penwidth=1.6];
  }

  /* ================================================================ */
  subgraph cluster_08 {
    label="8. 절후 교감신경 및 NE 처리 (Postganglionic Sympathetic — comparatively SPARED)"; style="filled"; color="#7fb89a"; fillcolor="#edf8f2"; fontsize=11;
    GANGLION [label="Paravertebral ganglion\n(nicotinic ACh transmission)", fillcolor="#d6efe2"];
    POSTGANG [label="POSTGANGLIONIC terminal\nintegrity (model POSTG)\nPRESERVED in MSA,\nLOST in PAF / PD", fillcolor="#a8e0c4", penwidth=1.6];
    TH_DBH [label="TH → DOPA → DA →\nDBH → NE synthesis", fillcolor="#d6efe2"];
    VMAT2 [label="VMAT2 vesicular\nstorage", fillcolor="#d6efe2"];
    NE_VES [label="Releasable NE POOL\n(model NE_ves)", fillcolor="#bfe8d2"];
    NET [label="NET (SLC6A2) reuptake\n★ atomoxetine target", fillcolor="#bfe8d2"];
    A2_PRE [label="Presynaptic α2A\nautoreceptor brake\n★ yohimbine target", fillcolor="#bfe8d2"];
    COMT_MAO [label="MAO-A / COMT\nmetabolism → DHPG, NMN", fillcolor="#d6efe2"];
    MIBG [label="Cardiac ¹²³I-MIBG uptake\nNORMAL in MSA,\nreduced in PD/PAF\n(diagnostic split)", fillcolor="#e6f6ee"];
    PLASMA_NE [label="Supine plasma NE normal;\nUPRIGHT rise BLUNTED\n(<60% increment)", fillcolor="#e6f6ee"];
  }

  /* ================================================================ */
  subgraph cluster_09 {
    label="9. 혈관 효과기 (Vascular Effector & Denervation Supersensitivity)"; style="filled"; color="#d09090"; fillcolor="#fbeeee"; fontsize=11;
    A1_REC [label="Vascular α1-adrenoceptor\nDENSITY (model A1R)", fillcolor="#f5d6d6"];
    SUPERSENS [label="DENERVATION\nSUPERSENSITIVITY\n(A1R ↑ as drive falls)\n→ same mg, bigger ΔBP", fillcolor="#efbcbc", penwidth=1.4];
    VSMC_CA [label="VSMC Gq → IP3 →\nCa²⁺ → MLCK\ncontraction", fillcolor="#f5d6d6"];
    RHOA [label="RhoA / ROCK\nCa²⁺-sensitisation", fillcolor="#f5d6d6"];
    TPR [label="TOTAL PERIPHERAL\nRESISTANCE (model TPR)", fillcolor="#efbcbc", penwidth=1.4];
    VEN_CAP [label="VENOUS CAPACITANCE\n(splanchnic bed,\nα1/α2 mediated)", fillcolor="#f5d6d6"];
    SPLANCH [label="Splanchnic POOLING\non standing (model V_sp)", fillcolor="#efbcbc"];
    NO_ENDO [label="Endothelial NO /\nprostacyclin (opposing)", fillcolor="#fbe4e4"];
    SKELMUSC [label="Skeletal-muscle pump +\nabdominal compression\n(non-pharmacological)", fillcolor="#fbe4e4"];
  }

  /* ================================================================ */
  subgraph cluster_10 {
    label="10. 혈역학 루프 (Fast Haemodynamic Loop — seconds)"; style="filled"; color="#8c9fd0"; fillcolor="#eef0fb"; fontsize=11;
    POSTURE [label="POSTURE INPUT\nsupine → standing\n(500–700 mL translocated)", fillcolor="#dde2f6"];
    V_CENT [label="Central blood volume\n(model V_c)", fillcolor="#ccd4f2"];
    SV [label="Stroke volume\n(Frank–Starling)", fillcolor="#dde2f6"];
    HR_N [label="Heart rate\n(model HR)", fillcolor="#dde2f6"];
    CO [label="Cardiac output\n= SV × HR", fillcolor="#ccd4f2"];
    MAP_N [label="MEAN ARTERIAL PRESSURE\n(model MAP) = CO × TPR", fillcolor="#b4c0ee", penwidth=1.6];
    SBP_STAND [label="Standing SBP / ΔSBP₃ₘᵢₙ\n★ primary endpoint\n(nOH: ↓≥30/15 mmHg)", fillcolor="#a4b2ea", penwidth=1.6];
    SNA [label="Sympathetic nerve\nactivity (model SNA)", fillcolor="#ccd4f2"];
    VAGAL [label="Cardiovagal tone\n(model VAG)", fillcolor="#dde2f6"];
    HR_RATIO [label="ΔHR/ΔSBP ratio <0.5\n★ NEUROGENIC signature", fillcolor="#e6eafb"];
    CBF [label="Cerebral blood flow /\nautoregulation reserve", fillcolor="#dde2f6"];
    SYNCOPE [label="Pre-syncope / syncope /\nFALL", fillcolor="#ccd4f2"];
  }

  /* ================================================================ */
  subgraph cluster_11 {
