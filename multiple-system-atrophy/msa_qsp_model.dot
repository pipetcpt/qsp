     ===================================================================== */

  /* --- 1 → 2/4: aetiology into pathology ------------------------------ */
  SNCA_LOCUS -> SNCA_mRNA [label="expression ↑"];
  SNCA_LOCUS -> ASYN_MON;
  COQ2 -> COQ10_SYN [label="LoF", color="#b03030"];
  MAPT_H1 -> GCI [style=dashed, label="weak"];
  GBA1 -> AUTOPHAGY [color="#b03030", label="GCase ↓"];
  ENV_SOLV -> OXSTRESS [style=dashed];
  SPORADIC -> ASYN_UPTAKE;
  NO_LEWY -> STRAIN [label="strain-specific"];
  LRRK2_NEG -> SPORADIC [style=dotted, label="no genetic\noverlap with PD"];

  /* --- 2: the glial aggregation core ---------------------------------- */
  SNCA_mRNA -> ASYN_MON;
  ASYN_UPTAKE -> ASYN_MON [label="neuronal α-syn\ntaken up"];
  P25A -> NUCLEATION [label="template", color="#b03030", penwidth=1.3];
  ASYN_MON -> NUCLEATION;
  NUCLEATION -> ASYN_OLIG;
  ASYN_OLIG -> ASYN_PSER129;
  ASYN_PSER129 -> GCI [penwidth=1.3];
  ASYN_OLIG -> GCI;
  GCI -> STRAIN;
  STRAIN -> SEED_EX [penwidth=1.3];
  ASYN_OLIG -> AUTOPHAGY [label="clogs", color="#b03030"];
  AUTOPHAGY -> ASYN_OLIG [label="clearance ↓\n(feedback)", color="#b03030", style=dashed];
  UPS -> ASYN_MON [label="degradation", color="#2a7a2a"];
  ASYN_OLIG -> UPS [label="inhibits", color="#b03030"];
  GCI -> NCI [style=dashed, label="secondary"];

  /* --- 2 → 3: p25α is the myelin link -------------------------------- */
  MYE_INT -> P25A [label="p25α released\nwhen myelin fails", color="#b03030", penwidth=1.3];
  P25A -> MBP_LOSS [label="lost from\nmyelin sheath", color="#b03030"];
  GCI -> MBP_LOSS [color="#b03030"];
  MBP_LOSS -> MYE_INT [color="#b03030", label="−"];
  SREBP -> MYE_INT [label="lipid supply", color="#2a7a2a"];
  GCI -> SREBP [label="disrupts", color="#b03030"];
  MYE_INT -> DEMYE [label="−", style=dashed];
  DEMYE -> MGL_ACT [label="debris → TLR", penwidth=1.2];
  MYE_INT -> TROPHIC [color="#2a7a2a", penwidth=1.3];
  TROPHIC -> AXON_ENERGY [color="#2a7a2a"];
  DEMYE -> WM_MRI;
  DEMYE -> HOT_CROSS;
  IRON -> PUT_RIM;

  /* --- 4: mitochondrial arm ------------------------------------------ */
  COQ10_SYN -> COQ10_LVL;
