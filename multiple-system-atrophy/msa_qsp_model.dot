  SPLANCH -> V_CENT [label="−", color="#b03030", penwidth=1.4];
  NO_ENDO -> TPR [label="−", color="#2a7a2a"];
  SKELMUSC -> V_CENT [color="#2a7a2a"];
  COMPRESS -> VEN_CAP [label="−capacitance", color="#2a7a2a", penwidth=1.2];
  COUNTER -> SKELMUSC [color="#2a7a2a"];

  /* --- 10: fast loop ------------------------------------------------- */
  POSTURE -> V_CENT [label="−500–700 mL", color="#b03030", penwidth=1.4];
  ECF -> V_CENT [penwidth=1.3];
