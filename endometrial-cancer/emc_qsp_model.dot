digraph EMC_QSP {
  rankdir=LR;
  fontname="Helvetica";
  labelloc="t";
  fontsize=20;
  label="Endometrial Carcinoma (EC) — Mechanistic QSP Map\nUnopposed Estrogen + PI3K/PTEN Loss → TCGA Molecular Class (POLE / MSI-H / NSMP / p53abn) → Mutational Burden → Neoantigen-Driven Immunogenicity → Class-Specific Therapy";
  node [style=filled, fontname="Helvetica", fontsize=10, shape=box, fillcolor="#ffffff"];
  edge [fontname="Helvetica", fontsize=8, color="#555555"];
  compound=true;

  //=========================================================================
  subgraph cluster_risk {
    label="1. Host Risk Factors / Metabolic-Endocrine Milieu"; style=filled; color="#e6d7c3"; fillcolor="#f7f0e6"; fontsize=13;
    Obesity [label="Obesity\n(BMI; RR ~1.5 per 5 kg/m2)", fillcolor="#f0e0c0"];
    Adipose_mass [label="Adipose tissue mass\n(peripheral aromatization site)"];
    Insulin_resistance [label="Insulin resistance /\nhyperinsulinemia"];
    IGF1_bioavail [label="Free IGF-1 ↑\n(IGFBP-1/2 ↓)"];
    SHBG_low [label="SHBG ↓\n→ free estradiol ↑"];
    Adipokines [label="Leptin ↑ / Adiponectin ↓\n(pro-proliferative adipokine shift)"];
    Chronic_infl_adipose [label="Adipose chronic inflammation\n(TNF-a, IL-6, MCP-1)"];
    PCOS [label="PCOS / chronic anovulation\n(no luteal progesterone)"];
    Nulliparity [label="Nulliparity / early menarche /\nlate menopause"];
    Diabetes_T2 [label="Type 2 diabetes mellitus"];
    Tamoxifen_exposure [label="Tamoxifen (breast cancer)\nendometrial partial agonism"];
    Unopposed_ERT [label="Unopposed estrogen\nreplacement therapy"];
    Lynch_syndrome [label="Lynch syndrome\n(germline MLH1/MSH2/MSH6/PMS2)", fillcolor="#f0d0d0"];
    Cowden_PTEN [label="Cowden syndrome\n(germline PTEN)"];
    Age_postmenopause [label="Postmenopausal age\n(median dx 63 y)"];
  }

  //=========================================================================
  subgraph cluster_steroid {
    label="2. Steroid Hormone Biosynthesis & HPO Axis"; style=filled; color="#d9c6e3"; fillcolor="#f2eaf7"; fontsize=13;
    GnRH_pulse [label="Hypothalamic GnRH\npulse generator"];
    LH_FSH [label="Pituitary LH / FSH"];
    Ovarian_theca_granulosa [label="Ovarian theca-granulosa\nsteroidogenesis (premenopausal)"];
    Androstenedione [label="Adrenal / ovarian\nandrostenedione"];
    Aromatase_CYP19A1 [label="Aromatase CYP19A1\n(adipose + tumor-intrinsic)", fillcolor="#e6d0f0"];
    Estrone_E1 [label="Estrone (E1)\n(dominant postmenopausal estrogen)"];
    HSD17B1 [label="17b-HSD type 1\nE1 → E2 conversion"];
    Estradiol_E2 [label="17b-Estradiol (E2)\nfree fraction", fillcolor="#e6d0f0"];
    Progesterone_luteal [label="Luteal progesterone\n(opposing signal)", fillcolor="#d7ecd9"];
    Estrogen_metab_CYP1B1 [label="CYP1B1 → 4-OH-catechol\nestrogen genotoxic metabolites"];
    Estrogen_quinones [label="Estrogen-quinone DNA\nadducts / oxidative damage"];
  }

  //=========================================================================
  subgraph cluster_receptor {
    label="3. Endometrial ER / PR Nuclear Receptor Signalling"; style=filled; color="#d9c6e3"; fillcolor="#f6f0fa"; fontsize=13;
    ERalpha [label="ERa (ESR1)\nnuclear receptor", fillcolor="#e6d0f0"];
    ERbeta [label="ERb (ESR2)\n(anti-proliferative modifier)"];
    GPER1 [label="GPER1 / GPR30\nmembrane estrogen receptor"];
    ER_coactivators [label="Coactivators\n(SRC-1/2/3, AIB1, p300)"];
    ERE_transcription [label="ERE-driven transcription\n(MYC, CCND1, IGF1R, PGR)"];
    PR_A [label="PR-A isoform\n(transrepressive)"];
    PR_B [label="PR-B isoform\n(differentiation, secretory)", fillcolor="#d7ecd9"];
    PR_downreg [label="PR loss / down-regulation\n(progestin resistance)", fillcolor="#f5d6d6"];
    HAND2 [label="HAND2 stromal mediator\n(promoter hypermethylation)"];
    FOXO1_endometrial [label="FOXO1 decidualization\nprogram"];
    IGF1_endometrial [label="Endometrial IGF-1 / IGF1R\nautocrine loop"];
    Hyperplasia_simple [label="Endometrial hyperplasia\nwithout atypia"];
    Atypical_hyperplasia [label="Atypical hyperplasia / EIN\n(precursor lesion)", fillcolor="#f5e0c0"];
  }

  //=========================================================================
  subgraph cluster_genomics {
    label="4. Somatic Driver Landscape & Mutational Processes"; style=filled; color="#c7d9e8"; fillcolor="#eaf2f8"; fontsize=13;
    PTEN_loss [label="PTEN loss-of-function\n(~77% endometrioid)", fillcolor="#cfe0ef"];
    PIK3CA_mut [label="PIK3CA mutation\n(~53%)"];
    PIK3R1_mut [label="PIK3R1 mutation\n(~33%)"];
    ARID1A_mut [label="ARID1A / SWI-SNF\nchromatin remodeler loss (~35%)"];
    CTNNB1_mut [label="CTNNB1 exon-3 mutation\n(~30% NSMP; recurrence risk)"];
    KRAS_mut [label="KRAS mutation (~25%)"];
    FGFR2_mut [label="FGFR2 activating mutation\n(~12%)"];
    TP53_mut [label="TP53 mutation\n(serous ~90%)", fillcolor="#f0c9c9"];
    PPP2R1A_mut [label="PPP2R1A mutation\n(serous)"];
    ERBB2_amp [label="ERBB2 (HER2) amplification\n(~30% serous)"];
    CCNE1_amp [label="CCNE1 amplification\n(copy-number-high)"];
    MYC_amp [label="MYC amplification"];
    POLE_exo [label="POLE exonuclease-domain\nmutation (P286R, V411L)", fillcolor="#cfe8d5"];
    MMR_deficiency [label="MMR deficiency\n(MLH1/MSH2/MSH6/PMS2)", fillcolor="#d8e8f5"];
    MLH1_hypermethyl [label="MLH1 promoter\nhypermethylation (sporadic)"];
    MSI_high [label="Microsatellite instability\n(MSI-H)"];
    Proofreading_failure [label="DNA polymerase-e\nproofreading failure"];
    HRD_status [label="Homologous recombination\ndeficiency (subset)"];
  }

  //=========================================================================
  subgraph cluster_class {
    label="5. TCGA / ProMisE Molecular Classification"; style=filled; color="#b9cfc0"; fillcolor="#e9f3ec"; fontsize=13;
    ProMisE_algorithm [label="ProMisE surrogate classifier\nPOLE seq → MMR IHC → p53 IHC", shape=hexagon, fillcolor="#dcefe2"];
    Class_POLE [label="POLEmut / ultramutated\n(7-12%; TMB >100 mut/Mb)\n5-y PFS ~95-100%", shape=box3d, fillcolor="#cfe8d5"];
    Class_MMRd [label="MMRd / MSI-H hypermutated\n(25-30%; TMB ~18-40 mut/Mb)\n5-y PFS ~75%", shape=box3d, fillcolor="#d8e8f5"];
    Class_NSMP [label="NSMP / copy-number-low\n(30-40%; TMB ~2.9 mut/Mb)\n5-y PFS ~80%", shape=box3d, fillcolor="#f3ecd6"];
    Class_p53abn [label="p53abn / copy-number-high\n(15-25%; TMB ~2.3 mut/Mb)\n5-y PFS ~50%", shape=box3d, fillcolor="#f0c9c9"];
    Histology_endometrioid [label="Endometrioid histology\n(type I, ~80%)"];
    Histology_serous [label="Serous / carcinosarcoma\n(type II)"];
    Histology_clearcell [label="Clear cell carcinoma"];
    Grade_FIGO [label="FIGO grade 1/2/3"];
    ER_PR_status [label="ER / PR immunohistochemistry\nstatus (predictive of hormonal response)"];
    L1CAM_expr [label="L1CAM overexpression\n(NSMP high-risk marker)"];
    FIGO2023_staging [label="FIGO 2023 staging\n(molecular class integrated)", shape=hexagon];
  }

  //=========================================================================
  subgraph cluster_pathway {
    label="6. Growth-Factor Signal Transduction"; style=filled; color="#c9d7c0"; fillcolor="#eef4e9"; fontsize=13;
    PI3K [label="PI3K (p110a / p85)"];
    PIP3 [label="PIP3 second messenger"];
    AKT [label="AKT phosphorylation\n(pAKT S473)", fillcolor="#dbe8cf"];
    mTORC1 [label="mTORC1\n(S6K1, 4E-BP1)", fillcolor="#dbe8cf"];
    mTORC2 [label="mTORC2\n(AKT S473 feedback)"];
    S6K1_feedback [label="S6K1 → IRS-1 negative\nfeedback loop"];
    FOXO3a [label="FOXO3a inactivation\n(apoptosis brake released)"];
    RAS_RAF [label="RAS → RAF"];
    MEK_ERK [label="MEK → ERK1/2"];
    Wnt_bcatenin [label="Wnt / b-catenin\nnuclear translocation"];
    TCF_LEF [label="TCF/LEF target genes\n(AXIN2, MYC, CCND1)"];
    HER2_signaling [label="HER2/HER3 heterodimer\nsignalling"];
    FGFR2_signaling [label="FGFR2 → FRS2 → RAS"];
    Ligand_independent_ER [label="mTOR/ERK → ERa Ser167/118\nligand-independent activation", fillcolor="#e6d0f0"];
  }

  //=========================================================================
  subgraph cluster_cellcycle {
    label="7. Cell Cycle, Apoptosis, Genomic Instability"; style=filled; color="#cfc3d9"; fillcolor="#f0ecf5"; fontsize=13;
    CyclinD1_CDK46 [label="Cyclin D1 - CDK4/6"];
    RB_phospho [label="RB phosphorylation"];
    E2F_release [label="E2F transcriptional release"];
    CyclinE_CDK2 [label="Cyclin E - CDK2\n(CCNE1 amp)"];
    G1S_transition [label="G1/S transition"];
    Tumor_proliferation [label="Tumor cell proliferation\n(Ki-67 index)", fillcolor="#e5d5ef"];
    Apoptosis_intrinsic [label="Intrinsic apoptosis\n(BAX / BCL-2 balance)"];
    p53_pathway [label="p53 checkpoint\n(p21, MDM2)"];
    Replication_stress [label="Replication stress /\nchromosomal instability"];
    Aneuploidy [label="Aneuploidy / SCNA burden"];
    Somatic_mutation_rate [label="Somatic mutation\naccumulation rate", fillcolor="#e5d5ef"];
    Tumor_burden [label="Tumor burden\n(sum of target lesions)", shape=box3d, fillcolor="#e5d5ef"];
    Clonal_heterogeneity [label="Subclonal heterogeneity /\nresistant clone outgrowth", fillcolor="#f5d6d6"];
  }

  //=========================================================================
  subgraph cluster_antigen {
    label="8. Mutational Burden → Neoantigen → Antigen Presentation"; style=filled; color="#c3d9d5"; fillcolor="#e9f5f2"; fontsize=13;
    TMB [label="Tumor mutational burden\n(mut/Mb) — CONTINUOUS axis", shape=box3d, fillcolor="#cfe8e2"];
    Frameshift_neoantigen [label="MSI frameshift neoantigens\n(indel-derived, highly immunogenic)"];
    SNV_neoantigen [label="POLE SNV neoantigens\n(ultramutated repertoire)"];
    Neoantigen_load [label="Presentable neoantigen load", fillcolor="#cfe8e2"];
    Proteasome_TAP [label="Proteasome / TAP\npeptide processing"];
    MHC_I_expression [label="MHC class I (HLA-A/B/C)\nsurface expression"];
    B2M_loss [label="B2M loss-of-function\n(immune escape)", fillcolor="#f5d6d6"];
    JAK1_JAK2_loss [label="JAK1/JAK2 loss\n(IFN-g insensitivity)", fillcolor="#f5d6d6"];
    Dendritic_cell [label="Tumor-resident dendritic cell\ncross-presentation"];
    Lymph_node_priming [label="Draining lymph node\nT-cell priming"];
  }

  //=========================================================================
  subgraph cluster_immune {
    label="9. Adaptive Anti-Tumor Immunity & Checkpoints"; style=filled; color="#c3cfe0"; fillcolor="#eaeff7"; fontsize=13;
    CD8_naive [label="Naive CD8+ T cell"];
    CD8_effector [label="Activated CD8+ effector\nT cell (intratumoral)", fillcolor="#d5e0f0"];
    CD4_Th1 [label="CD4+ Th1 helper\n(IFN-g, IL-2)"];
    TCR_MHC_synapse [label="TCR-peptide-MHC-I\nimmune synapse"];
    IFN_gamma [label="IFN-g release"];
    Granzyme_perforin [label="Granzyme B / perforin\ncytolysis"];
    Tumor_kill_rate [label="Immune-mediated\ntumor kill rate", fillcolor="#d5e0f0"];
    PD1_receptor [label="PD-1 on T cell"];
    PDL1_tumor [label="PD-L1 on tumor / APC\n(IFN-g adaptive induction)"];
    PD1_PDL1_axis [label="PD-1 / PD-L1\ninhibitory checkpoint", fillcolor="#dbe4f2"];
    CTLA4_axis [label="CTLA-4 / CD80-86\npriming checkpoint"];
    LAG3_TIM3 [label="LAG-3 / TIM-3 / TIGIT\nco-inhibitory receptors"];
    T_exhaustion [label="T-cell exhaustion\n(TOX, chronic antigen)", fillcolor="#f5d6d6"];
    Memory_Tcell [label="Memory T-cell pool\n(durability of response)"];
    TLS_formation [label="Tertiary lymphoid structures"];
  }

  //=========================================================================
  subgraph cluster_tme {
    label="10. Immunosuppressive Tumor Microenvironment"; style=filled; color="#e0cfc3"; fillcolor="#f7efe9"; fontsize=13;
    Treg [label="FOXP3+ regulatory T cell", fillcolor="#f0dcd0"];
    MDSC [label="Myeloid-derived\nsuppressor cell"];
    TAM_M2 [label="M2-polarized tumor-\nassociated macrophage"];
    TGF_beta [label="TGF-b1 (stromal exclusion,\nEMT driver)"];
    IL10_TME [label="IL-10 immunosuppression"];
    IDO1 [label="IDO1 → kynurenine\ntryptophan catabolism"];
    Adenosine_CD73 [label="CD39 / CD73 → adenosine\nA2AR suppression"];
    CAF [label="Cancer-associated fibroblast\nmatrix stiffening"];
    Hypoxia_HIF1a [label="Hypoxia → HIF-1a"];
    Immune_exclusion [label="Immune-excluded / cold\nphenotype (typical of p53abn)", fillcolor="#f0d0d0"];
    Obesity_immune [label="Obesity-driven T-cell\nmetabolic dysfunction"];
  }

  //=========================================================================
  subgraph cluster_angio {
    label="11. Angiogenesis & Vascular Remodelling"; style=filled; color="#d9cfc3"; fillcolor="#f7f2ea"; fontsize=13;
    VEGFA [label="VEGF-A secretion", fillcolor="#f0e2c8"];
    VEGFR2 [label="VEGFR-2 endothelial\ntyrosine kinase"];
    FGF2_FGFR1 [label="FGF-2 / FGFR1\n(escape angiogenesis)"];
    PDGFR_beta [label="PDGFR-b pericyte\nrecruitment"];
    Ang2_Tie2 [label="Angiopoietin-2 / Tie2\nvessel destabilization"];
    Microvessel_density [label="Microvessel density /\ntumor perfusion", fillcolor="#f0e2c8"];
    Vascular_normalization [label="Vascular normalization window\n(improves T-cell infiltration)", fillcolor="#dbe4f2"];
    Interstitial_pressure [label="Interstitial fluid pressure\n(drug delivery barrier)"];
    RET_KIT [label="RET / KIT off-target\nkinase inhibition"];
  }

  //=========================================================================
  subgraph cluster_invasion {
    label="12. Invasion, LVSI & Metastatic Dissemination"; style=filled; color="#d9c3c3"; fillcolor="#f7ecec"; fontsize=13;
    EMT_program [label="EMT (SNAIL/SLUG/ZEB1,\nE-cadherin loss)"];
    MMP2_MMP9 [label="MMP-2 / MMP-9\nbasement membrane digestion"];
    Myometrial_invasion [label="Deep myometrial invasion\n(>=50%)"];
    LVSI [label="Lymphovascular space\ninvasion (substantial)", fillcolor="#f0d0d0"];
    Cervical_stromal [label="Cervical stromal involvement"];
    Pelvic_paraaortic_LN [label="Pelvic / para-aortic\nlymph node metastasis"];
    Sentinel_node [label="Sentinel lymph node\nmapping (ITC / micromet)"];
    Peritoneal_spread [label="Peritoneal / adnexal spread"];
    Distant_mets [label="Distant metastasis\n(lung, liver, bone)"];
    Recurrence_local [label="Vaginal vault /\nlocoregional recurrence"];
  }

  //=========================================================================
  subgraph cluster_pkpd {
    label="13. Drug Pharmacokinetics & Pharmacodynamics"; style=filled; color="#b8c8d8"; fillcolor="#e8eff5"; fontsize=13;
    Carboplatin [label="CARBOPLATIN IV q21d\n(AUC 5-6, Calvert dosing)", shape=component, fillcolor="#d0e0ee"];
    Paclitaxel [label="PACLITAXEL IV q21d\n(175 mg/m2, 2-cmt PK)", shape=component, fillcolor="#d0e0ee"];
    Pt_DNA_adduct [label="Pt-DNA intrastrand\ncrosslink formation"];
    Microtubule_stab [label="Microtubule stabilization\n→ mitotic arrest"];
    Dostarlimab [label="DOSTARLIMAB IV\n500 mg q3w x4 → 1000 mg q6w", shape=component, fillcolor="#cfe0f5"];
    Pembrolizumab [label="PEMBROLIZUMAB IV\n200 mg q3w / 400 mg q6w", shape=component, fillcolor="#cfe0f5"];
    PD1_occupancy [label="PD-1 receptor occupancy\n(>95% at therapeutic Ctrough)"];
    Lenvatinib [label="LENVATINIB PO\n20 mg daily (multikinase)", shape=component, fillcolor="#f0e0c0"];
    Megestrol [label="MEGESTROL ACETATE PO\n160-320 mg daily", shape=component, fillcolor="#dcefe2"];
    LNG_IUS [label="LEVONORGESTREL IUS\n(52 mg, local delivery)", shape=component, fillcolor="#dcefe2"];
    Letrozole [label="LETROZOLE PO 2.5 mg\n(aromatase inhibition)", shape=component, fillcolor="#e6d0f0"];
    Everolimus [label="EVEROLIMUS PO 10 mg\n(mTORC1 inhibitor)", shape=component, fillcolor="#dbe8cf"];
    Trastuzumab [label="TRASTUZUMAB\n(HER2+ serous)", shape=component, fillcolor="#d0e0ee"];
    Selinexor [label="SELINEXOR PO\n(XPO1 inhibitor, TP53wt)", shape=component, fillcolor="#e5d5ef"];
    Metformin_adj [label="METFORMIN (adjunct,\nAMPK → mTOR inhibition)", shape=component];
    Tamoxifen_alt [label="TAMOXIFEN alternating\nwith megestrol (GOG-153)", shape=component];
    Bariatric_weightloss [label="Weight loss / bariatric surgery\n(non-pharmacologic)", shape=component];
  }

  //=========================================================================
  subgraph cluster_endpoint {
    label="14. Clinical Endpoints, Biomarkers & Toxicity"; style=filled; color="#c8c8c8"; fillcolor="#f0f0f0"; fontsize=13;
    ORR [label="Objective response rate\n(RECIST 1.1)", shape=box3d];
    PFS [label="Progression-free survival", shape=box3d, fillcolor="#dfe9df"];
    OS [label="Overall survival", shape=box3d, fillcolor="#dfe9df"];
    CA125 [label="Serum CA-125\n(serous / advanced disease)"];
    ctDNA_MRD [label="ctDNA / molecular residual\ndisease (VAF)"];
    HE4_marker [label="HE4 biomarker"];
    AUB_bleeding [label="Abnormal uterine bleeding\n(presenting symptom, 90%)"];
    Pathologic_CR [label="Pathologic complete response\n(fertility-sparing setting)", fillcolor="#dcefe2"];
    Fertility_preservation [label="Fertility preservation /\nlive birth", fillcolor="#dcefe2"];
    QoL_score [label="Quality of life\n(EORTC QLQ-EN24)"];
    Neutropenia [label="Chemotherapy neutropenia\n(Friberg myelosuppression)", fillcolor="#f5d6d6"];
    Peripheral_neuropathy [label="Taxane peripheral neuropathy"];
    Hypertension_AE [label="Lenvatinib hypertension\n(~65%, dose-limiting)", fillcolor="#f5d6d6"];
    Proteinuria_AE [label="Lenvatinib proteinuria"];
    irAE [label="Immune-related AE\n(thyroiditis, colitis, hepatitis)", fillcolor="#f5d6d6"];
    VTE_risk [label="Progestin / cancer-associated\nVTE risk"];
    Weight_gain_AE [label="Megestrol weight gain /\nfluid retention"];
    Dose_reduction [label="Dose reduction / interruption\n→ effective exposure loss"];
  }

  //=========================================================================
  // EDGES — Risk / metabolic
  //=========================================================================
  Obesity -> Adipose_mass;
  Obesity -> Insulin_resistance;
  Obesity -> Chronic_infl_adipose;
  Obesity -> Adipokines;
  Obesity -> Obesity_immune;
  Adipose_mass -> Aromatase_CYP19A1 [label="peripheral\naromatization", color="#8e44ad"];
  Insulin_resistance -> IGF1_bioavail;
  Insulin_resistance -> SHBG_low;
  Insulin_resistance -> Diabetes_T2;
  Diabetes_T2 -> Insulin_resistance [style=dashed];
  SHBG_low -> Estradiol_E2 [label="free fraction ↑", color="#8e44ad"];
  IGF1_bioavail -> IGF1_endometrial;
  Adipokines -> Tumor_proliferation [style=dashed];
  Chronic_infl_adipose -> TAM_M2 [style=dashed];
  PCOS -> Progesterone_luteal [label="absent luteal\nphase", style=dashed, color="#c0392b"];
  Nulliparity -> Progesterone_luteal [label="fewer opposed\ncycles", style=dashed, color="#c0392b"];
  Age_postmenopause -> Ovarian_theca_granulosa [label="senescence", style=dashed];
  Age_postmenopause -> Estrone_E1;
  Tamoxifen_exposure -> ERalpha [label="partial agonist\nin endometrium", color="#8e44ad"];
  Unopposed_ERT -> Estradiol_E2;
  Lynch_syndrome -> MMR_deficiency [color="#2471a3", penwidth=2];
  Cowden_PTEN -> PTEN_loss [color="#2471a3"];

  // Steroid axis
  GnRH_pulse -> LH_FSH;
  LH_FSH -> Ovarian_theca_granulosa;
  Ovarian_theca_granulosa -> Estradiol_E2;
  Ovarian_theca_granulosa -> Progesterone_luteal;
  Androstenedione -> Aromatase_CYP19A1;
  Aromatase_CYP19A1 -> Estrone_E1;
  Estrone_E1 -> HSD17B1;
  HSD17B1 -> Estradiol_E2;
  Estradiol_E2 -> ERalpha [penwidth=2, color="#8e44ad"];
  Estradiol_E2 -> ERbeta;
  Estradiol_E2 -> GPER1;
  Estradiol_E2 -> Estrogen_metab_CYP1B1;
  Estrogen_metab_CYP1B1 -> Estrogen_quinones;
  Estrogen_quinones -> Somatic_mutation_rate [style=dashed];
  Progesterone_luteal -> PR_B [color="#27ae60"];

  // Receptor signalling
  ERalpha -> ER_coactivators;
  ER_coactivators -> ERE_transcription;
  ERalpha -> ERE_transcription [penwidth=2];
  ERbeta -> ERE_transcription [label="attenuates", arrowhead=tee, color="#27ae60"];
  GPER1 -> MEK_ERK [style=dashed];
  ERE_transcription -> CyclinD1_CDK46;
  ERE_transcription -> IGF1_endometrial;
  ERE_transcription -> PR_A;
  ERE_transcription -> PR_B [label="PGR is an\nER target gene"];
  PR_B -> ERE_transcription [label="transrepression", arrowhead=tee, color="#27ae60", penwidth=2];
  PR_A -> ERE_transcription [arrowhead=tee, color="#27ae60"];
  PR_B -> FOXO1_endometrial;
  PR_B -> HAND2;
  HAND2 -> IGF1_endometrial [arrowhead=tee, color="#27ae60"];
  FOXO1_endometrial -> Apoptosis_intrinsic [color="#27ae60"];
  PR_downreg -> PR_B [arrowhead=tee, color="#c0392b", penwidth=2];
  IGF1_endometrial -> PI3K;
  ERE_transcription -> Hyperplasia_simple;
  Hyperplasia_simple -> Atypical_hyperplasia [label="+ driver\nmutation"];
  Atypical_hyperplasia -> Histology_endometrioid [label="malignant\ntransformation", penwidth=2];
  PTEN_loss -> Atypical_hyperplasia;

  // Genomics → class
  PTEN_loss -> PI3K [label="brake released", penwidth=2, color="#2471a3"];
  PIK3CA_mut -> PI3K [penwidth=2];
  PIK3R1_mut -> PI3K;
  ARID1A_mut -> Replication_stress;
  ARID1A_mut -> PI3K [style=dashed];
  CTNNB1_mut -> Wnt_bcatenin [penwidth=2];
  KRAS_mut -> RAS_RAF [penwidth=2];
  FGFR2_mut -> FGFR2_signaling;
  TP53_mut -> p53_pathway [arrowhead=tee, color="#c0392b", penwidth=2];
  PPP2R1A_mut -> AKT [style=dashed];
  ERBB2_amp -> HER2_signaling [penwidth=2];
  CCNE1_amp -> CyclinE_CDK2 [penwidth=2];
  MYC_amp -> Tumor_proliferation;
  POLE_exo -> Proofreading_failure [penwidth=2, color="#1e8449"];
  Proofreading_failure -> Somatic_mutation_rate [penwidth=3, color="#1e8449", label="~100x"];
  MLH1_hypermethyl -> MMR_deficiency [penwidth=2];
  MMR_deficiency -> MSI_high [penwidth=2, color="#2471a3"];
  MSI_high -> Somatic_mutation_rate [penwidth=2, color="#2471a3", label="~10x"];
  MSI_high -> Frameshift_neoantigen [penwidth=2, color="#2471a3"];
  Replication_stress -> Aneuploidy;
  TP53_mut -> Aneuploidy [penwidth=2, color="#c0392b"];
  Aneuploidy -> Clonal_heterogeneity;
  HRD_status -> Replication_stress;

  // Classification
  POLE_exo -> ProMisE_algorithm;
  MMR_deficiency -> ProMisE_algorithm;
  TP53_mut -> ProMisE_algorithm;
  ProMisE_algorithm -> Class_POLE [penwidth=2];
  ProMisE_algorithm -> Class_MMRd [penwidth=2];
  ProMisE_algorithm -> Class_NSMP [penwidth=2];
  ProMisE_algorithm -> Class_p53abn [penwidth=2];
  Class_POLE -> TMB [label="> 100 mut/Mb", penwidth=3, color="#1e8449"];
