  SYNOVITIS -> OSTEOPEN [color="#e63946", style=dashed];

  /* pain */
  SHARD -> NOCI [color="#e63946"];
  SYNOVITIS -> NOCI [color="#e63946", penwidth=2];
  JSN -> NOCI [color="#e63946", penwidth=2];
  PERIPH_S -> NOCI [color="#e63946"];
  NOCI -> DORSAL [color="#e63946", penwidth=2];
  DORSAL -> CENTRAL_S [color="#e63946", penwidth=2.5];
  CENTRAL_S -> PAIN_VAS [color="#e63946", penwidth=2.5];
  NOCI -> PAIN_VAS [color="#e63946", penwidth=2];
  PAIN_VAS -> SLEEP [color="#e63946"];
  SLEEP -> CENTRAL_S [color="#e63946", style=dashed];
  PAIN_VAS -> QOL [color="#e63946"];
  HAQ -> QOL [color="#e63946"];
  PAIN_VAS -> ANALG_USE [color="#e63946"];
  NSAID -> PERIPH_S [label="PGE2 block", color="#457b9d"];
  NSAID -> SYNOVITIS [color="#457b9d"];
  PARA -> PAIN_VAS [color="#457b9d"];
  OPIOID -> DORSAL [color="#457b9d"];
  OPIOID -> ANALG_USE [label="dependence", color="#e63946", style=dashed];
  NSAID -> CKD [label="renal risk → raises HGA", color="#e63946", style=dashed, penwidth=2];
  PHYSIO -> HAQ [color="#457b9d"];

  /* nitisinone PK */
  NT_DOSE -> NT_ABS -> NT_CEN [color="#457b9d", penwidth=2];
  NT_CEN -> NT_PER [dir=both, color="#457b9d"];
  NT_CEN -> NT_CL [color="#457b9d"];
  NT_PROT -> NT_CEN [color="#457b9d"];
  NT_ADH -> NT_CEN [color="#e63946", style=dashed];
  CYP3A4_M -> NT_CL [color="#457b9d", style=dashed];

  /* nitisinone PD — the redirection */
  NT_CEN -> HPD_INH [color="#457b9d", penwidth=2.5];
  HPD_INH -> OCC [color="#457b9d", penwidth=2];
  OCC -> HPD [label="96% at 2 mg, 99% at 10 mg", color="#457b9d", penwidth=2.5];
  HPD_INH -> HGA_DOWN [color="#457b9d", penwidth=2];
  HGA_DOWN -> UHGA24 [color="#457b9d", penwidth=2];
  HPD_INH -> UPSTREAM [color="#457b9d", penwidth=2.5];
  UPSTREAM -> HPP [color="#e63946", penwidth=2];
  UPSTREAM -> HPLA [color="#e63946", penwidth=2];
  UPSTREAM -> TYR_HIGH [color="#e63946", penwidth=2.5];
  HGA_DOWN -> SHGA_DOWN [color="#457b9d"];
  OAT_COMP -> SHGA_DOWN [label="blunts serum fall", color="#e63946", style=dashed, penwidth=2];
  HPP -> OAT_COMP [color="#e63946", style=dashed];
  HPLA -> OAT_COMP [color="#e63946", style=dashed];
  OAT_COMP -> CL_HGA [color="#e63946", style=dashed, penwidth=2];
  HGA_DOWN -> DIVERG [color="#01579b", penwidth=2];
  SHGA_DOWN -> DIVERG [color="#01579b", penwidth=2];
  DIVERG -> PIG_RATE [label="use −92.6%, not −99.7%", color="#01579b", penwidth=2.5];
  SHGA_DOWN -> HGA_PL [color="#457b9d", penwidth=2];
  PIG_RATE -> POLY [label="rate only, never the stock", color="#457b9d", penwidth=2.5];
  HGD_RES -> HGA [label="residual disposal", color="#457b9d", style=dashed];

  /* tyrosinaemia arm */
  TYR_HIGH -> TYR_CEIL [dir=both, color="#e65100", penwidth=2];
  PROTEIN -> TYR_CEIL [label="THE determinant", color="#e65100", penwidth=2.5];
  NT_DOSE -> TYR_CEIL [label="NOT a determinant\nabove ~2 mg", color="#8d99ae", style=dashed, penwidth=2];
  TYR_HIGH -> ALT_EXIT [color="#e65100", penwidth=2.5];
  ALT_EXIT -> NACTYR [color="#e65100"];
  ALT_EXIT -> TYRGLUC [color="#e65100"];
  ALT_EXIT -> TYRSULF [color="#e65100"];
  ALT_EXIT -> HPLA [color="#e65100"];
  ALT_EXIT -> HPP [color="#e65100"];
  TYR_HIGH -> CORNEA -> KERATO [color="#e63946", penwidth=2];
  KERATO -> PHOTOPH [color="#e63946"];
  TYR_HIGH -> KERATOSIS [color="#e63946"];
  TYR_HIGH -> NEUROCOG [color="#e63946", style=dashed];
  TYR_MON -> DIET_RX [color="#457b9d", penwidth=2];
  TYR_MON -> KERATO_REV [color="#457b9d"];
  KERATO_REV -> KERATO [label="resolves", color="#457b9d", penwidth=2];
  DIET_RX -> TYR_HIGH [label="the only effective lever", color="#457b9d", penwidth=2.5];
  NT_DOSE -> LFT_PLT [color="#e63946", style=dashed];
  TYR_HIGH -> PHE_LOW [color="#e63946", style=dashed];
  AA_SUPP -> PHE_LOW [color="#e63946", style=dashed];
  TYR_HIGH -> STYR_E [color="#616161"];

  /* future therapy comparators */
  GENE_TX -> HGD_ENZ [label="restores disposal,\nno Tyr rise", color="#457b9d", style=dashed, penwidth=2];
  ERT -> HGA_PL [color="#457b9d", style=dashed];
  CHAPERONE -> HGD_RES [color="#457b9d", style=dashed];
  HGA_DEG -> HGA_PL [color="#457b9d", style=dashed];
  IDEAL -> HGA_PL [label="isolates the Tyr penalty", color="#004d40", style=dashed, penwidth=2];
  SCREEN -> AGE_INIT [label="moves initiation to infancy", color="#457b9d", penwidth=2.5];

  /* endpoints and headroom */
  AKUSSI_J -> AKUSSI_C [color="#212121", penwidth=2];
  AKUSSI_S -> AKUSSI_C [color="#212121", penwidth=2];
  PAIN_VAS -> AKUSSI_C [color="#616161"];
  AKUSSI_C -> DELAY [color="#616161"];
  AGE_INIT -> HEADROOM [color="#5d4037", penwidth=2.5];
  PIG_DENS -> HEADROOM [label="accrued integral", color="#e63946", penwidth=2.5];
  HEADROOM -> AKUSSI_C [label="caps achievable benefit", color="#5d4037", penwidth=2.5];
  CENTRAL_S -> HEADROOM [label="not recoverable", color="#546e7a", penwidth=2];
  AGE_INIT -> NT_DOSE [color="#457b9d"];
  GUT_MB -> HGA_PL [color="#8d99ae", style=dashed];

  /* the three balances anchor the whole graph */
  BAL1 -> TYR_CEIL [color="#f4a261", penwidth=2, style=dashed];
  BAL1 -> ALT_EXIT [color="#f4a261", penwidth=2, style=dashed];
  BAL1 -> HPD_INH [color="#f4a261", penwidth=2, style=dashed];
  BAL2 -> POLY [color="#f4a261", penwidth=2, style=dashed];
  BAL2 -> HEADROOM [color="#f4a261", penwidth=2, style=dashed];
  BAL2 -> COLL_TURN [color="#f4a261", penwidth=2, style=dashed];
  BAL3 -> CL_HGA [color="#f4a261", penwidth=2, style=dashed];
  BAL3 -> RPF_DOWN [color="#f4a261", penwidth=2, style=dashed];
  BAL3 -> DIVERG [color="#f4a261", penwidth=2, style=dashed];
}
