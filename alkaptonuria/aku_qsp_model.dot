/* ============================================================================
   Alkaptonuria (AKU) — Quantitative Systems Pharmacology mechanistic map
   ----------------------------------------------------------------------------
   Organising idea (read this before reading the graph)
   ----------------------------------------------------------------------------
   Alkaptonuria is NOT a disease of a rate. The tyrosine catabolic flux through
   the ochronotic pathway is ~40 mmol/day and is set almost entirely by dietary
   protein; HGD deficiency does not change it. What HGD deficiency changes is
   which molecule that fixed flux is standing as while it waits to leave the
   body — and homogentisic acid, unlike maleylacetoacetate, can auto-oxidise to
   a benzoquinone that polymerises onto collagen and never leaves at all.

   Three structural consequences are drawn as structure, not as annotations:

   (1) MASS BALANCE IS CONSERVED ACROSS TREATMENT.  Nitisinone inhibits HPD,
       one step UPSTREAM of the missing enzyme.  It therefore cannot reduce the
       flux — it can only change the exit.  The same ~40 mmol/day that left as
       urinary HGA must now leave as urinary HPPA, HPLA, tyrosine and its
       conjugates, and the plasma tyrosine concentration is simply the pressure
       head required to push that load through lower-capacity exits.  Hence the
       central asymmetry of this map:  DOSE SETS HGA, DIET SETS TYROSINE.
       (edges: J_TAT / J_ALT* / U_* — note that no nitisinone edge touches the
       tyrosine exits, and no dietary edge touches HPD.)

   (2) THE TOXIC FLUX IS INVISIBLE IN THE MASS BALANCE.  Of ~40 mmol/day of
       HGA passing through, of the order of 0.6 umol/day (about 1.5e-5) is
       diverted into ochronotic pigment.  Every gram of that diversion is
       permanent, because articular collagen does not turn over.  So the
       disease is an INTEGRAL of a flux too small to measure, and no drug can
       act on the part of the integral already accrued (edges into PIG_* are
       one-way; there is no return edge anywhere in cluster_pigment).

   (3) PLASMA HGA IS CLEARANCE-LIMITED, NOT PRODUCTION-LIMITED.  Renal
       clearance of HGA approaches renal plasma flow (net tubular secretion
       plus intrarenal production), so it is at a ceiling and cannot buffer.
       Any age- or CKD-related fall in renal plasma flow raises plasma HGA
       ~1:1 at unchanged production, and plasma HGA is what pigments cartilage.
       This is why urinary HGA (-99.7% on nitisinone 10 mg) and serum HGA
       (-92.6%) diverge, and the pigmentation rate follows the serum number.

   Rendering:
     dot -Tsvg aku_qsp_model.dot -o aku_qsp_model.svg
     dot -Tpng -Gdpi=150 aku_qsp_model.dot -o aku_qsp_model.png

   Node shape / colour legend
     ellipse  = metabolite / soluble species        box      = process, enzyme
     hexagon  = drug or intervention                octagon  = clinical endpoint
     diamond  = irreversible accumulation           parallelogram = modifier
     component / house = organ-level structure
     red edge = pathogenic  ·  blue edge = therapeutic  ·  green = physiological
     dashed   = inferred / hypothesised  ·  bold = dominant flux
   ============================================================================ */

digraph AKU_QSP {
  graph [rankdir=TB, splines=true, nodesep=0.30, ranksep=0.55, fontname="Helvetica",
         labelloc="t", fontsize=30, compound=true, newrank=true,
         label="Alkaptonuria (AKU) — QSP mechanistic map\nHGD deficiency · ochronosis · nitisinone HPD blockade · the flux is conserved, only its exit changes"];
  node  [fontname="Helvetica", fontsize=11, style="filled,rounded", penwidth=1.2];
  edge  [fontname="Helvetica", fontsize=9, arrowsize=0.65, penwidth=1.0];

  /* ==========================================================================
     1. GENETICS — the lesion
     ========================================================================== */
  subgraph cluster_gen {
    label="1 · Genetics of the lesion (HGD, 3q13.33)"; style="filled"; color="#f4f1de"; fontsize=15;
    HGD_GENE   [label="HGD gene\n3q13.33 · 14 exons", shape=box, fillcolor="#e9c46a"];
    HGD_VAR    [label="pathogenic variants\n>270 reported", shape=box, fillcolor="#e9c46a"];
    HGD_MISS   [label="missense variant\n(partial folding defect)", shape=box, fillcolor="#f0e0b0"];
    HGD_NULL   [label="null / truncating\nvariant", shape=box, fillcolor="#f0e0b0"];
    HGD_HEXA   [label="HGD hexamer\n(2 x trimer) assembly", shape=box, fillcolor="#f0e0b0"];
    HGD_RES    [label="residual HGD activity\nRESACT 0–5%", shape=parallelogram, fillcolor="#d8e2dc"];
    HGD_ENZ    [label="homogentisate\n1,2-dioxygenase (HGD)", shape=box, fillcolor="#e76f51", fontcolor=white];
    FOUNDER    [label="founder clusters\nSlovakia ~1:19,000\nDominican Republic", shape=parallelogram, fillcolor="#d8e2dc"];
    PREV       [label="global prevalence\n1:250,000–1:1,000,000", shape=parallelogram, fillcolor="#d8e2dc"];
    AR_INH     [label="autosomal recessive\ninheritance", shape=parallelogram, fillcolor="#d8e2dc"];
    CARRIER    [label="heterozygous carrier\n(asymptomatic)", shape=parallelogram, fillcolor="#d8e2dc"];
  }

  /* ==========================================================================
     2. DIETARY INPUT — the only lever on total flux
     ========================================================================== */
  subgraph cluster_diet {
    label="2 · Dietary input — the ONLY lever on total pathway flux"; style="filled"; color="#e8f4ea"; fontsize=15;
    PROTEIN    [label="dietary protein\n0.6–1.6 g/kg/day", shape=parallelogram, fillcolor="#a8dadc"];
    IN_PHE     [label="phenylalanine intake\n~4.6 g/100 g protein", shape=ellipse, fillcolor="#cdeac0"];
    IN_TYR     [label="tyrosine intake\n~3.6 g/100 g protein", shape=ellipse, fillcolor="#cdeac0"];
    PROT_TURN  [label="whole-body protein\nturnover (recycling)", shape=box, fillcolor="#cdeac0"];
    PROT_POOL  [label="body protein\nTyr reservoir", shape=ellipse, fillcolor="#cdeac0"];
    DIET_RX    [label="protein restriction\n0.8–0.9 g/kg by Tyr band", shape=hexagon, fillcolor="#457b9d", fontcolor=white];
    AA_SUPP    [label="Phe/Tyr-free amino-acid\nsupplement (Tyr >900)", shape=hexagon, fillcolor="#457b9d", fontcolor=white];
    DIETITIAN  [label="active dietetic\nmonitoring (NAC model)", shape=hexagon, fillcolor="#457b9d", fontcolor=white];
  }

  /* ==========================================================================
     3. PHE/TYR CATABOLIC PATHWAY — the block and the step above it
     ========================================================================== */
  subgraph cluster_path {
    label="3 · Phenylalanine–tyrosine catabolic pathway (the block, and the step above it)"; style="filled"; color="#fdf0d5"; fontsize=15;
    PHE        [label="phenylalanine\nplasma ~55 umol/L", shape=ellipse, fillcolor="#ffd6a5"];
    PAH        [label="phenylalanine\nhydroxylase (PAH)", shape=box, fillcolor="#ffd6a5"];
    BH4        [label="BH4 cofactor", shape=ellipse, fillcolor="#ffe8cc"];
    TYR        [label="TYROSINE\nplasma 54 umol/L (normal)\n780–875 on nitisinone", shape=ellipse, fillcolor="#ffb703", penwidth=2.5];
    TAT        [label="tyrosine amino-\ntransferase (TAT)\nREVERSIBLE", shape=box, fillcolor="#ffd6a5"];
    HPP        [label="4-hydroxyphenyl-\npyruvate (HPPA)", shape=ellipse, fillcolor="#ffd6a5"];
    HPD        [label="4-HPP dioxygenase\n(HPD) — nitisinone target", shape=box, fillcolor="#fb8500", penwidth=2.5];
    HGA        [label="HOMOGENTISIC ACID\n(HGA)\nplasma 26–30 umol/L", shape=ellipse, fillcolor="#e63946", fontcolor=white, penwidth=3];
    MAA        [label="maleylacetoacetate", shape=ellipse, fillcolor="#ffd6a5"];
    MAAI       [label="MAA isomerase\n(GSTZ1)", shape=box, fillcolor="#ffd6a5"];
    FAA        [label="fumarylacetoacetate", shape=ellipse, fillcolor="#ffd6a5"];
    FAH        [label="fumarylacetoacetate\nhydrolase (FAH)", shape=box, fillcolor="#ffd6a5"];
    FUM        [label="fumarate +\nacetoacetate", shape=ellipse, fillcolor="#cdeac0"];
    TCA        [label="TCA cycle /\nketone bodies", shape=ellipse, fillcolor="#cdeac0"];
    HPLA       [label="4-hydroxyphenyl-\nlactate (HPLA)", shape=ellipse, fillcolor="#ffd6a5"];
    HPPR       [label="HPP reductase /\nLDH (reversible)", shape=box, fillcolor="#ffe8cc"];
    HPAC       [label="4-hydroxyphenyl-\nacetate", shape=ellipse, fillcolor="#ffe8cc"];
  }

  /* ==========================================================================
     4. TYROSINE'S OTHER FATES — competing sinks that matter only when Tyr is high
     ========================================================================== */
  subgraph cluster_tyrfate {
    label="4 · Competing tyrosine fates (dormant at 54 umol/L, load-bearing at 875)"; style="filled"; color="#eef7f9"; fontsize=15;
    NACTYR     [label="N-acetyl-tyrosine", shape=ellipse, fillcolor="#a8dadc"];
    NAT_E      [label="N-acetyltransferase", shape=box, fillcolor="#cfe8ee"];
    TYRGLUC    [label="tyrosine-glucuronide", shape=ellipse, fillcolor="#a8dadc"];
    UGT        [label="UGT conjugation", shape=box, fillcolor="#cfe8ee"];
    TYRSULF    [label="tyrosine-sulfate", shape=ellipse, fillcolor="#a8dadc"];
    SULT       [label="SULT conjugation", shape=box, fillcolor="#cfe8ee"];
    DOPA       [label="L-DOPA", shape=ellipse, fillcolor="#cfe8ee"];
    TH_ENZ     [label="tyrosine hydroxylase", shape=box, fillcolor="#cfe8ee"];
    CATECH     [label="dopamine /\nnoradrenaline", shape=ellipse, fillcolor="#cfe8ee"];
    MELANIN    [label="melanin\n(tyrosinase)", shape=ellipse, fillcolor="#cfe8ee"];
    THYROID    [label="T4 / T3 synthesis", shape=ellipse, fillcolor="#cfe8ee"];
    TYRPROT    [label="protein synthesis\n(reincorporation)", shape=box, fillcolor="#cfe8ee"];
  }

  /* ==========================================================================
     5. HGA DISPOSITION — clearance at the renal-plasma-flow ceiling
     ========================================================================== */
  subgraph cluster_disp {
    label="5 · HGA disposition — a clearance already at the renal-plasma-flow ceiling"; style="filled"; color="#fbe9e7"; fontsize=15;
    HGA_PL     [label="plasma / TBW HGA\n(the pigmenting species)", shape=ellipse, fillcolor="#e63946", fontcolor=white, penwidth=2];
    GFR_F      [label="glomerular filtration\nof HGA", shape=box, fillcolor="#f8c9c4"];
    OAT13      [label="OAT1 / OAT3 net\ntubular SECRETION\n(dominant route)", shape=box, fillcolor="#f4978e", penwidth=2];
    REN_PROD   [label="intrarenal HGA\nPRODUCTION (renal HPD)", shape=box, fillcolor="#f4978e", style="filled,dashed"];
    CL_HGA     [label="CL_HGA ~ 600–900 mL/min\n≈ renal plasma flow\n→ NO reserve", shape=parallelogram, fillcolor="#f8c9c4", penwidth=2];
    RPF        [label="renal plasma flow", shape=parallelogram, fillcolor="#d8e2dc"];
    BILE       [label="biliary / intestinal\nelimination (proposed)", shape=box, fillcolor="#f8c9c4", style="filled,dashed"];
    HGA_URINE  [label="urinary HGA\n1–8 g/day (24–48 mmol)", shape=ellipse, fillcolor="#c1121f", fontcolor=white];
    DARK_U     [label="urine darkens on\nstanding / alkali\n(diagnostic since infancy)", shape=octagon, fillcolor="#8d99ae"];
    HGA_SF     [label="synovial fluid HGA", shape=ellipse, fillcolor="#f4978e"];
    HGA_CART   [label="cartilage interstitial HGA\n(avascular, long residence)", shape=ellipse, fillcolor="#f4978e", penwidth=2];
    DIFF_C     [label="diffusion into\navascular matrix", shape=box, fillcolor="#f8c9c4"];
  }

  /* ==========================================================================
     6. OXIDATION / POLYMERISATION — the irreversible branch
     ========================================================================== */
  subgraph cluster_ox {
    label="6 · Oxidation and polymerisation — where the futile cycle competes with a one-way step"; style="filled"; color="#ede7f6"; fontsize=15;
    AUTOX      [label="auto-oxidation\n(pH-dependent, O2)", shape=box, fillcolor="#c3b1e1"];
    PPO        [label="tissue polyphenol\noxidase-like activity", shape=box, fillcolor="#c3b1e1"];
    BQA        [label="benzoquinone acetic\nacid (BQA)", shape=ellipse, fillcolor="#7b2cbf", fontcolor=white];
    POLY       [label="oxidative polymerisation\nIRREVERSIBLE", shape=box, fillcolor="#5a189a", fontcolor=white, penwidth=2.5];
    ASC        [label="ascorbate", shape=hexagon, fillcolor="#457b9d", fontcolor=white];
    REDOX      [label="BQA → HGA reduction\n(FUTILE CYCLE)", shape=box, fillcolor="#c3b1e1", style="filled,dashed"];
    ROS        [label="ROS / superoxide", shape=ellipse, fillcolor="#c3b1e1"];
    GSH        [label="glutathione depletion", shape=ellipse, fillcolor="#c3b1e1"];
    LIPOX      [label="lipid peroxidation\n(MDA, 8-isoprostane)", shape=ellipse, fillcolor="#c3b1e1"];
    SAA        [label="serum amyloid A\n(secondary amyloid risk)", shape=ellipse, fillcolor="#c3b1e1"];
    OXALATE    [label="ascorbate → oxalate\n(iatrogenic stone risk)", shape=ellipse, fillcolor="#ffd6a5"];
  }

  /* ==========================================================================
     7. OCHRONOTIC PIGMENT — one-way depots, no return edges anywhere
     ========================================================================== */
  subgraph cluster_pig {
    label="7 · Ochronotic pigment depots — every edge in is one-way (no drug reverses these)"; style="filled"; color="#e0e0e0"; fontsize=15;
    COLL2      [label="type II collagen\n(articular)", shape=ellipse, fillcolor="#adb5bd"];
    COLL1      [label="type I collagen\n(disc, tendon, valve, sclera)", shape=ellipse, fillcolor="#adb5bd"];
    COLL_TURN  [label="collagen turnover\nt1/2 decades → ~0 clearance", shape=parallelogram, fillcolor="#ced4da", penwidth=2];
    PIG_CART   [label="PIGMENT: articular\ncartilage (knee, hip, shoulder)", shape=diamond, fillcolor="#212529", fontcolor=white, penwidth=2];
    PIG_DISC   [label="PIGMENT: intervertebral\ndisc (earliest depot)", shape=diamond, fillcolor="#212529", fontcolor=white, penwidth=2];
    PIG_VALVE  [label="PIGMENT: aortic valve\n& annulus", shape=diamond, fillcolor="#212529", fontcolor=white, penwidth=2];
    PIG_TEND   [label="PIGMENT: tendon,\nligament, fascia", shape=diamond, fillcolor="#212529", fontcolor=white];
    PIG_SCL    [label="PIGMENT: sclera\n(Osler sign)", shape=diamond, fillcolor="#212529", fontcolor=white];
    PIG_EAR    [label="PIGMENT: ear cartilage,\ncerumen", shape=diamond, fillcolor="#212529", fontcolor=white];
    PIG_SKIN   [label="PIGMENT: skin, sweat\nglands (axilla, groin)", shape=diamond, fillcolor="#212529", fontcolor=white];
    PIG_OTHER  [label="PIGMENT: prostate,\nkidney, dura, larynx", shape=diamond, fillcolor="#212529", fontcolor=white];
    PIG_DENS   [label="pigment density\nper unit collagen", shape=parallelogram, fillcolor="#ced4da", penwidth=2];
  }

  /* ==========================================================================
     8. CARTILAGE MECHANICS — threshold, then feedback: this is where age 30 comes from
     ========================================================================== */
  subgraph cluster_cart {
    label="8 · Cartilage mechanics — a threshold plus one feedback generates the 3rd-decade onset"; style="filled"; color="#e3f2fd"; fontsize=15;
    CHONDRO    [label="chondrocyte", shape=box, fillcolor="#90caf9"];
    AGGRECAN   [label="aggrecan / proteoglycan", shape=ellipse, fillcolor="#bbdefb"];
    XLINK      [label="pigment–collagen\ncross-linking", shape=box, fillcolor="#64b5f6"];
    BRITTLE    [label="matrix EMBRITTLEMENT\nHill threshold in PIG_DENS", shape=box, fillcolor="#1e88e5", fontcolor=white, penwidth=2.5];
    STIFF      [label="loss of compressive\nresilience", shape=ellipse, fillcolor="#bbdefb"];
    MECH_LOAD  [label="mechanical load\n(BMI, occupation, sport)", shape=parallelogram, fillcolor="#d8e2dc"];
    FRAG       [label="matrix fragmentation\n→ pigmented shards", shape=box, fillcolor="#1565c0", fontcolor=white, penwidth=2];
    CART_LOSS  [label="cartilage volume loss", shape=ellipse, fillcolor="#64b5f6"];
    CHOND_DEATH[label="chondrocyte apoptosis", shape=box, fillcolor="#bbdefb"];
    CART_CALC  [label="cartilage calcification\n/ mineralisation", shape=box, fillcolor="#bbdefb"];
    REPAIR     [label="matrix repair capacity\n(near zero in adult)", shape=parallelogram, fillcolor="#ced4da"];
  }

  /* ==========================================================================
     9. SYNOVITIS — the amplifier that makes progression accelerate
     ========================================================================== */
  subgraph cluster_syn {
    label="9 · Synovial amplification loop (debris → cytokines → proteases → more debris)"; style="filled"; color="#fff3e0"; fontsize=15;
    SHARD      [label="pigmented cartilage\nshards in joint space", shape=ellipse, fillcolor="#ffcc80"];
    SYN_MAC    [label="synovial macrophage\nphagocytosis", shape=box, fillcolor="#ffcc80"];
    NLRP3      [label="NLRP3 inflammasome", shape=box, fillcolor="#ffb74d"];
    IL1B       [label="IL-1beta", shape=ellipse, fillcolor="#ffb74d"];
    IL6        [label="IL-6", shape=ellipse, fillcolor="#ffb74d"];
    TNFA       [label="TNF-alpha", shape=ellipse, fillcolor="#ffb74d"];
    SYNOVITIS  [label="chronic synovitis /\neffusion", shape=box, fillcolor="#fb8c00", fontcolor=white, penwidth=2];
    MMP313     [label="MMP-3 / MMP-13", shape=ellipse, fillcolor="#ffb74d"];
    ADAMTS5    [label="ADAMTS-5", shape=ellipse, fillcolor="#ffb74d"];
    CRP        [label="CRP / ESR\n(usually near-normal)", shape=ellipse, fillcolor="#ffe0b2"];
    CHONDROCAL [label="secondary chondro-\ncalcinosis / CPPD", shape=box, fillcolor="#ffe0b2"];
  }

  /* ==========================================================================
     10. JOINT — structural and functional endpoints
     ========================================================================== */
  subgraph cluster_joint {
    label="10 · Large-joint ochronotic arthropathy"; style="filled"; color="#f1f8e9"; fontsize=15;
    JSN        [label="joint space narrowing\n(K–L grade)", shape=ellipse, fillcolor="#c5e1a5"];
    SUBCH      [label="subchondral sclerosis\n& cysts", shape=ellipse, fillcolor="#c5e1a5"];
    OSTEOPH    [label="osteophytosis", shape=ellipse, fillcolor="#c5e1a5"];
    KNEE       [label="knee arthropathy\n(most affected)", shape=house, fillcolor="#aed581"];
    HIP        [label="hip arthropathy\n→ loss of rotation", shape=house, fillcolor="#aed581"];
    SHOULDER   [label="shoulder arthropathy", shape=house, fillcolor="#aed581"];
    ROM        [label="range-of-motion loss", shape=ellipse, fillcolor="#c5e1a5"];
    JR         [label="joint replacement\nmean age 55 y", shape=octagon, fillcolor="#558b2f", fontcolor=white, penwidth=2];
    REVISION   [label="revision / peri-\nprosthetic issues", shape=octagon, fillcolor="#8d99ae"];
    HAQ        [label="HAQ / KOOS\nfunction", shape=octagon, fillcolor="#8d99ae"];
  }

  /* ==========================================================================
     11. SPINE — the earliest radiographic depot
     ========================================================================== */
  subgraph cluster_spine {
    label="11 · Spine — pigment's earliest radiographic footprint"; style="filled"; color="#ede7f6"; fontsize=15;
    DISC       [label="intervertebral disc\n(nucleus pulposus)", shape=house, fillcolor="#b39ddb"];
    DISC_CALC  [label="disc calcification\n(3rd decade, pathognomonic)", shape=ellipse, fillcolor="#9575cd"];
    DISC_H     [label="disc height loss\n/ vacuum phenomenon", shape=ellipse, fillcolor="#b39ddb"];
    LBP        [label="chronic low back pain\n(first symptom, ~age 30)", shape=octagon, fillcolor="#673ab7", fontcolor=white, penwidth=2];
    KYPHOSIS   [label="thoracic kyphosis /\nheight loss", shape=ellipse, fillcolor="#b39ddb"];
    ANKYLOSIS  [label="spinal ankylosis\n(bamboo-like)", shape=ellipse, fillcolor="#9575cd"];
    STENOSIS   [label="spinal stenosis /\nradiculopathy", shape=octagon, fillcolor="#8d99ae"];
    SIJ        [label="sacroiliac / symphysis\nchanges", shape=ellipse, fillcolor="#d1c4e9"];
    FRACT_V    [label="vertebral fracture\n(osteopenic bone)", shape=octagon, fillcolor="#8d99ae"];
  }

  /* ==========================================================================
     12. CARDIOVASCULAR
     ========================================================================== */
  subgraph cluster_cv {
    label="12 · Cardiovascular ochronosis"; style="filled"; color="#ffebee"; fontsize=15;
    AV_LEAF    [label="aortic valve leaflet\n(type I collagen)", shape=house, fillcolor="#ef9a9a"];
    VIC        [label="valve interstitial cell\nosteogenic transition", shape=box, fillcolor="#ef9a9a"];
    AV_FIB     [label="leaflet fibrosis\n& thickening", shape=ellipse, fillcolor="#ffcdd2"];
    AV_CALC    [label="valve calcification", shape=ellipse, fillcolor="#e57373"];
    AV_SCL     [label="aortic sclerosis\n18% of AKU cohort", shape=ellipse, fillcolor="#e57373"];
    AV_STEN    [label="aortic stenosis\n13% of cohort · onset ~54 y", shape=octagon, fillcolor="#c62828", fontcolor=white, penwidth=2];
    PMAX       [label="peak transaortic\ngradient (Pmax)", shape=octagon, fillcolor="#8d99ae"];
    AVA        [label="aortic valve area", shape=octagon, fillcolor="#8d99ae"];
    LVH        [label="LV hypertrophy →\ndiastolic dysfunction", shape=ellipse, fillcolor="#ffcdd2"];
    AVR        [label="aortic valve\nreplacement", shape=octagon, fillcolor="#c62828", fontcolor=white];
    CORON      [label="coronary artery\ncalcification ~59 y", shape=ellipse, fillcolor="#ffcdd2"];
    MITRAL     [label="mitral annular\ncalcification", shape=ellipse, fillcolor="#ffcdd2"];
    AORTA_D    [label="aortic root dilatation\n/ intimal pigment", shape=ellipse, fillcolor="#ffcdd2"];
  }

  /* ==========================================================================
     13. RENAL / GENITOURINARY — the modifier that feeds back on the driver
     ========================================================================== */
  subgraph cluster_ren {
    label="13 · Renal & genitourinary — and the feedback that closes on plasma HGA"; style="filled"; color="#e0f7fa"; fontsize=15;
    U_SUPSAT   [label="urinary HGA\nsupersaturation", shape=ellipse, fillcolor="#80deea"];
    STONE_R    [label="renal stones (black)\nmean age 64 y", shape=octagon, fillcolor="#00838f", fontcolor=white];
    STONE_P    [label="prostate calculi", shape=octagon, fillcolor="#00838f", fontcolor=white];
    OBSTRUCT   [label="obstruction /\npyelonephritis", shape=ellipse, fillcolor="#b2ebf2"];
    CKD        [label="chronic kidney disease\n(acquired)", shape=box, fillcolor="#0097a7", fontcolor=white, penwidth=2];
    RPF_DOWN   [label="renal plasma flow ↓\n(age ~0.8%/yr, CKD)", shape=parallelogram, fillcolor="#b2ebf2", penwidth=2];
    URINE_PH   [label="urine pH / volume\n(alkalinisation, fluids)", shape=hexagon, fillcolor="#457b9d", fontcolor=white];
    DIALYSIS   [label="dialysis / transplant\n(HGA poorly cleared)", shape=octagon, fillcolor="#8d99ae"];
  }

  /* ==========================================================================
     14. EYE, EAR, SKIN — the visible, harmless markers
     ========================================================================== */
  subgraph cluster_ees {
    label="14 · Ocular, aural, cutaneous signs (visible early, harmless)"; style="filled"; color="#fce4ec"; fontsize=15;
    SCLERA     [label="scleral / conjunctival\nslate-blue pigment", shape=octagon, fillcolor="#f48fb1"];
    OSLER      [label="Osler sign\n(interpalpebral, 3rd decade)", shape=octagon, fillcolor="#8d99ae"];
    EAR_C      [label="ear cartilage\nblue-black discolouration", shape=octagon, fillcolor="#f48fb1"];
    CERUMEN    [label="dark cerumen", shape=octagon, fillcolor="#8d99ae"];
    HEARING    [label="sensorineural /\nconductive hearing loss", shape=octagon, fillcolor="#8d99ae"];
    SKIN_AX    [label="axillary / inguinal\npigmentation", shape=octagon, fillcolor="#f48fb1"];
    SWEAT      [label="dark sweat, stained\nclothing", shape=octagon, fillcolor="#8d99ae"];
    NAIL       [label="nail / tooth\ndiscolouration", shape=octagon, fillcolor="#8d99ae"];
  }

  /* ==========================================================================
     15. MUSCULOTENDINOUS
     ========================================================================== */
  subgraph cluster_tend {
    label="15 · Tendon, ligament and bone"; style="filled"; color="#f9fbe7"; fontsize=15;
    TEND_INT   [label="tendon tensile\nintegrity", shape=ellipse, fillcolor="#e6ee9c"];
    ACH_RUPT   [label="Achilles / patellar\ntendon rupture", shape=octagon, fillcolor="#827717", fontcolor=white];
    MUSC_RUPT  [label="spontaneous muscle\nrupture", shape=octagon, fillcolor="#8d99ae"];
    OSTEOPEN   [label="osteopenia /\nosteoporosis", shape=ellipse, fillcolor="#e6ee9c"];
    FRACT      [label="fragility fracture", shape=octagon, fillcolor="#8d99ae"];
  }

  /* ==========================================================================
     16. PAIN — why late treatment cannot help symptoms even if it stops pigment
     ========================================================================== */
  subgraph cluster_pain {
    label="16 · Pain processing — the component no HGA-lowering drug can reverse"; style="filled"; color="#eceff1"; fontsize=15;
    NOCI       [label="peripheral nociceptor\ndrive (joint, disc)", shape=box, fillcolor="#b0bec5"];
