  /* ==========================================================================
     23. THE THREE BALANCES — the model's spine, stated explicitly
     ========================================================================== */
  subgraph cluster_bal {
    label="23 · The three balances that generate every prediction"; style="filled"; color="#fff9c4"; fontsize=16;
    BAL1       [label="BALANCE 1 — FLUX IS CONSERVED\nintake ≈ 40 mmol/day must exit as HGA\nOR as Tyr/HPPA/HPLA/conjugates.\nNitisinone picks the exit; diet picks the size.", shape=note, fillcolor="#fff59d", penwidth=2];
    BAL2       [label="BALANCE 2 — THE TOXIC BRANCH IS ~1.5e-5 OF FLUX\n~0.6 umol/day into pigment out of 40 mmol/day.\nInvisible in mass balance, and the entire disease.\nOne-way: no term removes it.", shape=note, fillcolor="#fff59d", penwidth=2];
    BAL3       [label="BALANCE 3 — CLEARANCE HAS NO RESERVE\nCL_HGA ≈ renal plasma flow, so plasma HGA\n= production / RPF.  Ageing and CKD raise the\npigmenting concentration without touching production.", shape=note, fillcolor="#fff59d", penwidth=2];
  }

