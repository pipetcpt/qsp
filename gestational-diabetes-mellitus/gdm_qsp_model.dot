digraph GDM_QSP {
  rankdir=LR;
  fontname="Helvetica";
  labelloc="t";
  label="Gestational Diabetes Mellitus (GDM) — Mechanistic QSP Map\nPlacental Contra-Insulin Drive → Maternal Insulin Resistance → FAILURE of β-Cell Compensation → Maternal Hyperglycaemia\nGLUT1 Placental Transfer → Pedersen/Freinkel Fetal Hyperinsulinism → Asymmetric Fetal Overgrowth · Neonatal & Life-Course Programming\nTherapy: MNT/Exercise · Metformin (crosses placenta) · Insulin (does not) · Glyburide (BCRP-effluxed)";
  node [style=filled, fontname="Helvetica", fontsize=10, shape=box, fillcolor="#ffffff"];
  edge [fontname="Helvetica", fontsize=8];

  /* =====================================================================
     1. Pre-gestational susceptibility — the "starting line"
     GDM is unmasked, not created, by pregnancy: most women enter pregnancy
     with a pre-existing, subclinical β-cell secretory deficit.
     ===================================================================== */
  subgraph cluster_suscept {
    label="1. Pre-gestational Susceptibility (β-cell reserve set before conception)"; style=filled; color="#e8ddf0"; fillcolor="#f3ecf9";
    Pregest_BMI [label="Pre-gestational BMI\n(OR ~3.0 if ≥30 kg/m²)"];
    Maternal_age [label="Maternal age\n(risk ↑ ~4%/yr after 25)"];
    Ethnicity [label="Ethnicity\n(S/E-Asian, Hispanic risk ↑)"];
    Family_hx_T2DM [label="1st-degree family hx\nof T2DM"];
    Prior_GDM [label="Prior GDM\n(recurrence ~40-50%)"];
    Prior_macrosomia [label="Prior macrosomic\ninfant (>4000 g)"];
    PCOS [label="PCOS\n(pre-existing IR + IGT)"];
    TCF7L2 [label="TCF7L2 rs7903146\n(β-cell/incretin locus)"];
    MTNR1B [label="MTNR1B rs10830963\n(melatonin-receptor, FPG)"];
    GCK_MODY [label="GCK / HNF1A variants\n(MODY masquerading as GDM)"];
    Beta_reserve [label="★ β-CELL FUNCTIONAL RESERVE\n(BCAP — capacity to expand)", fillcolor="#f6cfe0", penwidth=2];
    Autoantibody [label="GAD65/IA-2 antibodies\n(latent autoimmune, ~5-10%)"];
    Visceral_fat0 [label="Baseline visceral\nadipose mass"];
    Physical_fitness [label="Pre-gestational\ncardiorespiratory fitness"];
  }

  /* =====================================================================
     2. Placental endocrine unit — the contra-insulin generator
     ===================================================================== */
  subgraph cluster_placenta {
    label="2. Placental Endocrine Unit — Contra-Insulin Drive (grows with placental mass)"; style=filled; color="#dbe8f5"; fillcolor="#eaf3fb";
    Syncytio_mass [label="★ Syncytiotrophoblast mass\n(logistic growth, GW 8→38)", fillcolor="#cfe3f6", penwidth=2];
    hPL [label="Human placental lactogen\n(hPL/CSH1, ~×30 by term)"];
    GH_V [label="Placental GH variant\n(GH2/GH-V, replaces pituitary GH)"];
    Progesterone [label="Progesterone\n(~×10 rise; IRS-1 Ser-P)"];
    Estradiol [label="Estradiol (E2)\n(~×100 rise)"];
    Placental_CRH [label="Placental CRH\n(exponential, → cortisol)"];
    Cortisol_M [label="Maternal cortisol\n(free cortisol ~×2)"];
    HSD11B2 [label="Placental 11β-HSD2\n(fetal cortisol barrier)"];
    Prolactin_M [label="Maternal prolactin\n(decidual + pituitary)"];
    Placental_TNF [label="Placental TNF-α\n(strongest inverse\ncorrelate of SI)"];
    Placental_IL6 [label="Placental IL-6"];
    Leptin_P [label="Placental leptin\n(~×3 in GDM)"];
    Resistin [label="Resistin"];
    Adiponectin [label="Adiponectin ↓\n(low in 1st trimester\npredicts GDM)"];
    Kisspeptin [label="Placental kisspeptin\n(β-cell trophic)"];
    sFlt1 [label="sFlt-1 / sEng ↑\nPlGF ↓ (→ preeclampsia)"];
    Placental_mTOR [label="Trophoblast mTORC1\n(nutrient sensor)"];
    Placental_infarct [label="Placental villous\nimmaturity / chorangiosis"];
  }

  /* =====================================================================
     3. Maternal insulin-resistance machinery (post-receptor)
     ===================================================================== */
  subgraph cluster_ir {
    label="3. Maternal Insulin Resistance — Post-receptor Signalling Defect"; style=filled; color="#f5e2d3"; fillcolor="#fdf1e8";
    INSR [label="Insulin receptor\n(β-subunit content ↓)"];
    IRS1_Ser [label="IRS-1 Ser307/312\nphosphorylation ↑"];
    IRS1_total [label="IRS-1 protein ↓\n(~23% of non-pregnant)"];
    PI3K [label="PI3K p85α ↑ /\nsignalling ↓"];
    AKT [label="AKT/PKB\nphosphorylation ↓"];
    AS160 [label="AS160 / TBC1D4"];
    GLUT4 [label="GLUT4 translocation ↓\n(skeletal muscle)"];
    Muscle_uptake [label="Skeletal-muscle\nglucose disposal ↓ 50-60%"];
    PKC_theta [label="DAG–PKCθ/ε\n(lipid-induced)"];
    JNK_IKK [label="JNK / IKKβ-NF-κB\n(inflammatory serine kinases)"];
    SOCS3 [label="SOCS1/3 induction"];
    AMPK_M [label="Muscle AMPK\n(insulin-independent route)"];
    Hepatic_IR [label="Hepatic insulin\nresistance"];
    PEPCK_G6P [label="PEPCK / G6Pase ↑\n(gluconeogenesis)"];
    EGP [label="★ Endogenous glucose production\n(fasting EGP ↑ ~30% by T3)", fillcolor="#fbdcc4", penwidth=2];
    Lipolysis [label="Adipose lipolysis ↑\n(ATGL/HSL, insulin-resistant)"];
    FFA [label="Plasma FFA ↑\n(Randle glucose–FA cycle)"];
    Ectopic_lipid [label="Hepatic/muscle\nectopic lipid"];
    ATM_M1 [label="Adipose M1 macrophage\ninfiltration"];
    SI_index [label="★ INSULIN SENSITIVITY (SI)\nMatsuda / clamp M-value", fillcolor="#fbdcc4", penwidth=2];
  }

  /* =====================================================================
     4. β-cell compensation — the axis that decides who gets GDM
     ===================================================================== */
  subgraph cluster_beta {
    label="4. Maternal β-Cell Adaptation — Compensation vs Failure"; style=filled; color="#d9ecdc"; fillcolor="#eef8f0";
    PRLR [label="Lactogen receptor (PRLR)\nhPL + PRL"];
    JAK2_STAT5 [label="JAK2–STAT5b\nsignalling"];
    Tph1_5HT [label="Tph1 → islet serotonin\n→ HTR2B (proliferative)"];
    HTR3A [label="HTR3A (secretory,\nlowers threshold)"];
    Menin_p18 [label="Menin/p18-p27 ↓\n(permits cycling)"];
    FoxM1 [label="FoxM1 / Cyclin D2"];
    Beta_prolif [label="β-cell proliferation\n(~×1.4-2.4 mass in rodent;\nhuman: mostly function)"];
    Beta_mass [label="★ β-CELL MASS × FUNCTION\n(adaptive expansion)", fillcolor="#c9e7d0", penwidth=2];
    GLUT2_GCK [label="GLUT2 / glucokinase\nglucose sensing"];
    KATP [label="KATP (Kir6.2/SUR1)\nclosure → depolarisation"];
    Ca_influx [label="L-type Ca²⁺ influx\n→ granule exocytosis"];
    First_phase [label="1st-phase insulin\nsecretion ↓ (earliest defect)"];
    Second_phase [label="2nd-phase secretion\n(compensatory ↑)"];
    Proinsulin_ratio [label="Proinsulin:insulin ratio ↑\n(processing stress)"];
    ER_stress [label="ER stress / UPR\n(PERK-ATF4-CHOP)"];
    Amyloid_IAPP [label="IAPP oligomers\n(islet amyloid)"];
    Beta_apop [label="β-cell apoptosis /\ndedifferentiation"];
    GLP1 [label="GLP-1 / GIP\nincretin axis"];
    DPP4 [label="DPP-4 activity"];
    Disposition_index [label="★ DISPOSITION INDEX (DI)\n= SI × 1st-phase ISR", fillcolor="#c9e7d0", penwidth=2];
    Beta_failure [label="★ COMPENSATION FAILURE\n(DI below threshold ⇒ GDM)", fillcolor="#f2b8b8", penwidth=2];
  }

  /* =====================================================================
     5. Maternal glucose kinetics & diagnosis
     ===================================================================== */
  subgraph cluster_glucose {
    label="5. Maternal Glucose Kinetics · Screening & Diagnosis"; style=filled; color="#f9e8c8"; fillcolor="#fdf6e4";
    Meal_CHO [label="Meal carbohydrate load\n(g, glycaemic index)"];
    Gut_absorption [label="Intestinal glucose\nabsorption (ka)"];
    Glu_M [label="★ MATERNAL PLASMA GLUCOSE\n(fasting ↓ early, PP ↑ late)", fillcolor="#f7dca0", penwidth=2];
    Ins_M [label="★ MATERNAL PLASMA INSULIN\n(fasting ~×2-3 by T3)", fillcolor="#f7dca0", penwidth=2];
    Cpeptide_M [label="Maternal C-peptide"];
    Renal_threshold [label="Renal glucose threshold ↓\n(SGLT2, glycosuria physiological)"];
    Glucosuria [label="Glycosuria"];
    Fasting_hypo [label="Early-pregnancy fasting\nglucose ↓ (fetal siphon)"];
    OGTT75 [label="75 g OGTT\n(GW 24-28)"];
    GCT50 [label="50 g GCT screen\n(two-step, ≥130-140 mg/dL)"];
    IADPSG [label="IADPSG/WHO one-step\nFPG 5.1 · 1h 10.0 · 2h 8.5 mmol/L"];
    Carpenter [label="Carpenter–Coustan\n95/180/155/140 mg/dL (≥2)"];
    CGM_metrics [label="CGM: mean glucose,\nTIR 63-140 mg/dL, MAGE"];
    HbA1c [label="HbA1c\n(↓ in pregnancy; target <6.0%)"];
    Fructosamine [label="Fructosamine /\nglycated albumin"];
    AG15 [label="1,5-anhydroglucitol ↓"];
    gCD59 [label="Glycated CD59\n(early 1st-trimester marker)"];
    SHBG [label="SHBG ↓\n(hepatic IR marker)"];
  }

  /* =====================================================================
     6. Placental transfer — nutrients AND drugs
     ===================================================================== */
  subgraph cluster_transfer {
    label="6. Placental Transfer — Nutrients & Drugs (the interface that matters)"; style=filled; color="#dfe0f2"; fillcolor="#eeeffb";
    GLUT1_MVM [label="★ GLUT1 (microvillous +\nbasal membrane) facilitated diffusion", fillcolor="#cdcff0", penwidth=2];
    Glu_gradient [label="Materno-fetal glucose\ngradient (~0.5-1.0 mmol/L)"];
    SNAT_SystemA [label="System A / SNAT1-2-4\namino-acid transport ↑"];
    LAT1_2 [label="LAT1/2 (leucine,\nexchange transport)"];
    LPL_placental [label="Placental LPL /\nendothelial lipase ↑"];
    FATP_CD36 [label="FATP1/4 · CD36\nfatty-acid uptake"];
    Placental_glycogen [label="Placental glycogen\nstores"];
    Ins_no_cross [label="INSULIN does NOT\ncross the placenta", fillcolor="#e6f0e6"];
    IGF_axis_P [label="IGF-1/IGF-2 · IGFBP-1 ↓\n(placental)"];
    OCT3_MATE [label="OCT3 (SLC22A3) / MATE1 /\nPMAT — metformin influx"];
    BCRP_placenta [label="BCRP/ABCG2 apical efflux\n(glyburide substrate)"];
    Pgp_placenta [label="P-gp/ABCB1\n(apical efflux)"];
    Met_FM_ratio [label="Metformin umbilical:maternal\nratio ≈ 1.0 (free transfer)", fillcolor="#fde8e8"];
    Glyb_FM_ratio [label="Glyburide cord:maternal\n≈ 0.7 (assay-dependent)", fillcolor="#fde8e8"];
    Placental_barrier [label="Syncytial barrier\nthickness / surface area"];
  }

  /* =====================================================================
     7. Fetal compartment — Pedersen/Freinkel cascade
     ===================================================================== */
  subgraph cluster_fetus {
    label="7. Fetal Compartment — Pedersen Hyperglycaemia–Hyperinsulinism Cascade"; style=filled; color="#f4d9e3"; fillcolor="#fceef3";
    Glu_F [label="★ FETAL PLASMA GLUCOSE\n(passively follows mother)", fillcolor="#f3c2d5", penwidth=2];
    Fetal_beta [label="Fetal β-cell hyperplasia\n(islet mass ↑)"];
    Ins_F [label="★ FETAL HYPERINSULINAEMIA\n(cord C-peptide ↑)", fillcolor="#f3c2d5", penwidth=2];
    Fetal_IGF1 [label="Fetal IGF-1 ↑\n(insulin-dependent)"];
    Fetal_leptin [label="Fetal leptin ↑\n(adipose-derived)"];
    Fetal_glycogen [label="Fetal hepatic\nglycogen ↑"];
    Fetal_lipogenesis [label="Fetal de-novo lipogenesis\n+ TG uptake"];
    Fat_mass_F [label="★ Fetal FAT mass\n(disproportionate)", fillcolor="#f3c2d5", penwidth=2];
    Lean_mass_F [label="Fetal LEAN mass\n(IGF-1 driven)"];
    AC_percentile [label="Abdominal circumference\npercentile (US)"];
    EFW [label="Estimated fetal weight\n(Hadlock) → z-score"];
    Asym_growth [label="Asymmetric growth\n(AC/HC ↑, shoulder:head ↑)"];
    Septal_hyper [label="Interventricular septal\nhypertrophy"];
    Fetal_O2_demand [label="Fetal O₂ consumption ↑\n→ relative hypoxaemia"];
    Fetal_EPO [label="Fetal erythropoietin ↑\n→ polycythaemia"];
    Surfactant_delay [label="Insulin-delayed\nsurfactant (SP-A) synthesis"];
    Polyhydramnios [label="Polyhydramnios\n(fetal polyuria)"];
    Fetal_acidemia [label="Fetal acidaemia /\nlactate ↑"];
    Stillbirth_risk [label="Late stillbirth risk"];
    Fetal_epigenome [label="Fetal epigenome\n(LEP/ADIPOQ/MEST methylation)"];
  }

  /* =====================================================================
     8. Lifestyle therapy — first-line in every guideline
     ===================================================================== */
  subgraph cluster_lifestyle {
    label="8. Medical Nutrition Therapy & Exercise (first-line, ~70-85% controlled)"; style=filled; color="#d7ecec"; fillcolor="#e9f7f7";
    MNT [label="MNT: 175 g/d CHO floor,\n40-45% E from CHO"];
    Low_GI [label="Low-glycaemic-index\ncarbohydrate substitution"];
    Meal_split [label="3 meals + 2-3 snacks\n(PP peak flattening)"];
    Exercise [label="Exercise 30 min ≥5 d/wk\n(walking, resistance)"];
    AMPK_ex [label="Exercise AMPK → GLUT4\n(insulin-INDEPENDENT)"];
    GWG [label="Gestational weight gain\n(IOM 2009 targets)"];
    SMBG [label="SMBG 4×/day\nfasting + 1h PP"];
    Adherence [label="Adherence /\nhealth literacy"];
    Sleep_circadian [label="Sleep duration /\ncircadian misalignment"];
    Vitamin_D [label="Vitamin D / myo-inositol\n(adjunct, weak evidence)"];
  }

  /* =====================================================================
     9. Insulin pharmacology
     ===================================================================== */
  subgraph cluster_pk_insulin {
    label="9. Insulin PK/PD — Gold Standard (does not cross placenta)"; style=filled; color="#e5dccb"; fillcolor="#f5efe2";
    Insulin_dose [label="Insulin dose\n0.7 → 1.0 U/kg/day by T3"];
    NPH_detemir [label="Basal: NPH / detemir\n(detemir non-inferior, EU/FDA-B)"];
    Aspart_lispro [label="Bolus: aspart / lispro\n(rapid, no ↑ teratogenicity)"];
    SC_depot [label="SC depot: hexamer→dimer→\nmonomer dissociation"];
    Insulin_ka [label="Absorption ka\n(site, blood flow, pregnancy oedema)"];
    Insulin_CL [label="Insulin clearance ↑\n(placental insulinase/IDE)"];
    Ins_exo [label="Exogenous plasma insulin\n(adds to endogenous)"];
    Insulin_titration [label="Titration to FPG <95 &\n1h PP <140 mg/dL"];
    Hypoglycaemia [label="Maternal hypoglycaemia\n(<70 mg/dL) risk"];
    Weight_gain_ins [label="Insulin-associated\nmaternal weight gain"];
    Antibody_ins [label="Anti-insulin antibodies\n(negligible with analogues)"];
    Pump_CSII [label="CSII / hybrid closed-loop\n(AiDAPT: TIR +10%)"];
  }

  /* =====================================================================
     10. Metformin pharmacology (crosses the placenta)
     ===================================================================== */
  subgraph cluster_pk_met {
    label="10. Metformin PK/PD — Effective but Reaches the Fetus"; style=filled; color="#efdcdc"; fillcolor="#fbeded";
    Met_dose [label="Metformin 500 mg →\n2000-2500 mg/day divided"];
    Met_gut [label="Gut lumen (PMAT/OCT3\nuptake, F ~50%)"];
    Met_plasma [label="Maternal plasma metformin\n(Cmax ~1-2 mg/L)"];
    Met_CL [label="Renal CL ↑ ~20-30%\nin pregnancy (GFR ↑ 50%)"];
    OCT2_MATE_kidney [label="Renal OCT2 / MATE1-2K\ntubular secretion"];
    Met_liver [label="Hepatic OCT1 uptake\n→ mitochondria"];
    Complex_I [label="Mito complex I\npartial inhibition"];
    AMPK_liver [label="Hepatic AMPK / LKB1\n(+ AMPK-independent redox)"];
    GNG_inhib [label="Gluconeogenesis ↓\n(glycerol-3-P dehydrogenase)"];
    Met_gut_GLP1 [label="Gut-mediated GLP-1 ↑ /\nbile-acid & microbiome shift"];
    Met_GI_AE [label="GI intolerance\n(~10-20% dose-limiting)"];
    Met_fetal [label="Fetal metformin exposure\n(Cfetal ≈ Cmaternal)", fillcolor="#fbc9c9"];
    Met_offspring [label="Offspring: lower BW but\n↑ childhood BMI/adiposity (MiG-TOFU)"];
    Met_failure [label="Supplemental insulin needed\nin ~46% (MiG trial)"];
    Lactate_M [label="Maternal lactate\n(no acidosis at normal GFR)"];
  }

  /* =====================================================================
     11. Sulfonylurea pharmacology
     ===================================================================== */
  subgraph cluster_pk_glyb {
    label="11. Glyburide/Glibenclamide PK/PD — Third-line, Signal of Harm"; style=filled; color="#e3dcef"; fillcolor="#f0ecf9";
    Glyb_dose [label="Glyburide 2.5 → 20 mg/day"];
    Glyb_plasma [label="Maternal plasma glyburide\n(CL ↑ ~2× in pregnancy)"];
    SUR1_block [label="SUR1/KATP closure →\nglucose-independent secretion"];
    Glyb_secretagogue [label="Maternal insulin\nsecretion ↑ (β-cell strain)"];
    Glyb_fetal [label="Fetal glyburide exposure\n(BCRP-limited but present)", fillcolor="#fbc9c9"];
    Glyb_neonat_hypo [label="↑ Neonatal hypoglycaemia\n(RR ~2, Sénat JAMA 2018)"];
    Glyb_macrosomia [label="↑ Macrosomia vs insulin\n(meta-analysis)"];
    Glyb_hypo_M [label="Maternal hypoglycaemia\n(long duration of action)"];
  }

  /* =====================================================================
     12. Maternal clinical outcomes
     ===================================================================== */
  subgraph cluster_mat_out {
    label="12. Maternal Clinical Endpoints"; style=filled; color="#f3dcc9"; fillcolor="#fdf0e2";
    Preeclampsia [label="Preeclampsia / HDP\n(13.6% → 8.6% treated, MFMU)"];
    Cesarean [label="Cesarean delivery\n(33.8% → 26.9% treated)"];
    Induction [label="Labour induction\nat 38-39 wk"];
    Shoulder_dystocia [label="Shoulder dystocia\n(4.0% → 1.5% treated)"];
    Birth_trauma [label="Perineal trauma /\noperative vaginal delivery"];
    PPH [label="Postpartum haemorrhage\n(uterine overdistension)"];
    Preterm [label="Preterm birth\n(iatrogenic + spontaneous)"];
    Postpartum_OGTT [label="Postpartum 75 g OGTT\nat 4-12 wk (ADA)"];
    Persistent_IGT [label="Persistent IGT / IFG\n(~15-20%)"];
    T2DM_progression [label="★ Progression to T2DM\n(RR 7.4, Bellamy Lancet 2009)", fillcolor="#f6c9a8", penwidth=2];
    CVD_later [label="Later maternal CVD\n(HR ~1.7-2.0)"];
    Recurrence [label="GDM recurrence in next\npregnancy (~40-50%)"];
    Lactation [label="Lactation ≥3 mo\n(protective, HR ~0.5)"];
  }

  /* =====================================================================
     13. Neonatal & offspring outcomes
     ===================================================================== */
  subgraph cluster_neo_out {
    label="13. Neonatal & Life-Course Offspring Endpoints"; style=filled; color="#d9e5cf"; fillcolor="#eef4e8";
    Birthweight [label="Birth weight (g)\n→ z-score (GROW/Intergrowth)"];
    LGA [label="★ LGA >90th percentile\n(HAPO 5.3% → 26.3% across\nglucose categories 1→7)", fillcolor="#c6dcb6", penwidth=2];
    Macrosomia [label="Macrosomia >4000 g\n(14.3% → 5.9% treated)"];
    Neonatal_hypo [label="Neonatal hypoglycaemia\n(<40 mg/dL, 1-2 h of life)"];
    Hyperbili [label="Hyperbilirubinaemia\n(polycythaemia → haemolysis)"];
    RDS_TTN [label="RDS / transient tachypnoea\n(surfactant delay)"];
    Hypocalcaemia [label="Hypocalcaemia /\nhypomagnesaemia"];
    NICU [label="NICU admission"];
    Cord_Cpeptide [label="Cord-blood C-peptide\n>90th percentile (HAPO 2°)"];
    Neonatal_fat [label="Neonatal % body fat\n(skinfold/ADP)"];
    Childhood_obesity [label="Childhood obesity\n(HAPO-FUS: OR ~1.2-1.6)"];
    Offspring_IGT [label="Offspring IGT / T2DM\n(fuel-mediated programming)"];
    Neurodev [label="Neurodevelopment /\nADHD-ASD signal (uncertain)"];
  }

  /* =====================================================================
     14. QSP model observables (what the mrgsolve model outputs)
     ===================================================================== */
  subgraph cluster_model {
    label="14. QSP Model State Variables & Derived Observables"; style=filled; color="#d5d5d5"; fillcolor="#ededed";
    SV_placenta [label="PLAC · HPL · PROG · E2 · TNFA\n(placental drive block)", shape=note];
    SV_maternal [label="GLU · INS · FFA · SI · BCM · GLYC\n(maternal metabolic block)", shape=note];
    SV_fetal [label="GLUF · INSF · BCF · IGF1F ·\nFATF · LEANF (fetal block)", shape=note];
    SV_drug [label="MGUT/MCEN/MFET · IBAS/IBOL/IPLA ·\nGGUT/GCEN (drug block)", shape=note];
    OBS_diag [label="Observables: FPG · 1h/2h OGTT ·\nHbA1c · TIR · DI", shape=note];
    OBS_endpoint [label="Endpoints: BW z · P(LGA) ·\nP(neonatal hypo) · P(preeclampsia)", shape=note];
    Calib_HAPO [label="Calibration target: HAPO\ncontinuous glucose–LGA gradient", shape=note, fillcolor="#ffe9b0"];
    Calib_MFMU [label="Calibration target: MFMU/ACHOIS\ntreatment effect sizes", shape=note, fillcolor="#ffe9b0"];
    Calib_MiG [label="Calibration target: MiG metformin\nvs insulin equivalence + 46% add-on", shape=note, fillcolor="#ffe9b0"];
  }

  /* =====================================================================
     EDGES — 1. susceptibility → resistance / β-cell reserve
     ===================================================================== */
  Pregest_BMI -> Visceral_fat0;
  Pregest_BMI -> ATM_M1;
  Visceral_fat0 -> Lipolysis;
  Visceral_fat0 -> Adiponectin [label="−", color="#b03030"];
  Maternal_age -> Beta_reserve [label="−", color="#b03030"];
  Ethnicity -> Beta_reserve [label="−", color="#b03030"];
  Family_hx_T2DM -> Beta_reserve [label="−", color="#b03030"];
  Prior_GDM -> Beta_reserve [label="−", color="#b03030"];
  Prior_macrosomia -> Prior_GDM [style=dashed];
  PCOS -> IRS1_Ser;
  PCOS -> Beta_reserve [label="−", color="#b03030"];
  TCF7L2 -> Beta_reserve [label="−", color="#b03030"];
  MTNR1B -> Beta_reserve [label="−", color="#b03030"];
  GCK_MODY -> GLUT2_GCK [label="−", color="#b03030"];
  Autoantibody -> Beta_apop;
  Physical_fitness -> SI_index [label="+", color="#2f6f3f"];
  Beta_reserve -> Beta_prolif [label="+", color="#2f6f3f"];
  Beta_reserve -> Beta_mass [label="+ capacity", color="#2f6f3f"];

  /* 2. placental drive */
  Syncytio_mass -> hPL;
  Syncytio_mass -> GH_V;
  Syncytio_mass -> Progesterone;
  Syncytio_mass -> Estradiol;
  Syncytio_mass -> Placental_CRH;
  Syncytio_mass -> Placental_TNF;
  Syncytio_mass -> Placental_IL6;
  Syncytio_mass -> Leptin_P;
  Syncytio_mass -> Kisspeptin;
  Placental_CRH -> Cortisol_M;
  HSD11B2 -> Cortisol_M [label="− (fetal side)", color="#b03030"];
  Placental_mTOR -> Syncytio_mass;
  Placental_infarct -> Syncytio_mass [label="−", color="#b03030"];
  Placental_infarct -> sFlt1;
  hPL -> IRS1_Ser;
  hPL -> Lipolysis;
  hPL -> PRLR;
  GH_V -> Hepatic_IR;
  GH_V -> Lipolysis;
  Progesterone -> IRS1_Ser;
  Estradiol -> Hepatic_IR;
  Cortisol_M -> PEPCK_G6P;
  Cortisol_M -> Lipolysis;
  Placental_TNF -> IRS1_Ser [label="strongest", color="#b03030"];
  Placental_TNF -> JNK_IKK;
  Placental_IL6 -> SOCS3;
  Leptin_P -> SOCS3;
  Resistin -> Hepatic_IR;
  Adiponectin -> AMPK_M [label="+", color="#2f6f3f"];
  Adiponectin -> SI_index [label="+", color="#2f6f3f"];
  Prolactin_M -> PRLR;
  Kisspeptin -> Second_phase;

  /* 3. IR machinery */
  Ins_M -> INSR;
  INSR -> PI3K;
  IRS1_Ser -> PI3K [label="−", color="#b03030"];
  IRS1_total -> PI3K [label="+", color="#2f6f3f"];
  JNK_IKK -> IRS1_Ser;
