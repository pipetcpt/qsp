digraph FTD_QSP {
  rankdir=LR;
  fontname="Helvetica";
  labelloc="t";
  fontsize=20;
  label="Frontotemporal Dementia (FTD / FTLD) — Mechanistic QSP Map\nThree Genes (GRN · C9orf72 · MAPT) → Two Proteinopathies (TDP-43 · Tau) → One Network (Salience / Anterior Temporal)\nDrug axes: anti-sortilin mAb · AAV-GRN · C9 ASO · MAPT ASO · serotonergic symptomatic · (cholinergic = null control)";
  node [style=filled, fontname="Helvetica", fontsize=10, shape=box];
  edge [fontname="Helvetica", fontsize=8];
  newrank=true;
  ranksep=1.0;
  nodesep=0.35;

  // =========================================================================
  // 1. GENETIC ARCHITECTURE & RISK MODIFIERS
  // =========================================================================
  subgraph cluster_genetics {
    label="1. Genetic Architecture & Risk Modifiers (~30-40% familial)";
    style=filled; color="#d8c9e8"; fillcolor="#f2ecf9";
    GRN_mut [label="GRN mutation (17q21.31)\nnonsense/frameshift/splice\nHAPLOINSUFFICIENCY", fillcolor="#e3d1f5"];
    C9orf72_exp [label="C9orf72 (9p21.2)\nGGGGCC hexanucleotide\nrepeat expansion (>30)", fillcolor="#e3d1f5"];
    MAPT_mut [label="MAPT mutation (17q21.31)\nP301L / IVS10+16 / R406W\nexon-10 splicing", fillcolor="#e3d1f5"];
    TBK1_mut [label="TBK1 mutation\n(autophagy/TBK1-optineurin)"];
    VCP_mut [label="VCP mutation\n(MSP1 / IBMPFD)"];
    CHMP2B_mut [label="CHMP2B mutation\n(ESCRT-III, FTD-3)"];
    TARDBP_mut [label="TARDBP mutation\n(rare, FTD-ALS)"];
    SQSTM1_OPTN [label="SQSTM1 / OPTN\n(autophagy receptors)"];
    CHCHD10_mut [label="CHCHD10\n(mitochondrial)"];
    TMEM106B_risk [label="TMEM106B risk haplotype\nrs1990622 — modifies GRN\npenetrance & age at onset", fillcolor="#f0e2c8"];
    GFPT1_modifier [label="GFPT1 / other GWAS\nmodifier loci"];
    HLA_DRA_risk [label="HLA-DRA/DRB5 locus\n(immune risk, TDP-43 FTD)"];
    APOE_effect [label="APOE ε4\n(weak/inconsistent in FTD)"];
    Sporadic_FTD [label="SPORADIC FTLD\n(~60-70%, no Mendelian gene)", fillcolor="#e3d1f5"];
    Repeat_length [label="Repeat length &\nsomatic mosaicism\n(C9orf72)"];
    Anticipation [label="Intrafamilial variability\n/ incomplete penetrance"];
  }

  // =========================================================================
  // 2. PROGRANULIN BIOLOGY & SORTILIN TRAFFICKING (the drug-target axis)
  // =========================================================================
  subgraph cluster_pgrn {
    label="2. Progranulin (PGRN) Biology & Sortilin Trafficking";
    style=filled; color="#c9dcf0"; fillcolor="#eaf3fb";
    GRN_transcription [label="GRN transcription\n(neurons, microglia)"];
    PGRN_synth [label="PGRN synthesis\n(7.5 granulin domains,\n~68 kDa glycoprotein)"];
    PGRN_secreted [label="Secreted PGRN\n(extracellular pool)", fillcolor="#cfe4f7"];
    PGRN_plasma [label="PLASMA PGRN\n(~200 ng/mL WT;\n~1/3 in GRN carriers)", fillcolor="#bcd9f5"];
    PGRN_CSF [label="CSF PGRN\n(~3 ng/mL WT;\n~50% in carriers)", fillcolor="#bcd9f5"];
    SORT1 [label="SORTILIN (SORT1)\nhigh-affinity PGRN receptor\n→ rapid endocytic clearance", fillcolor="#ffd9d9"];
    SORT1_recycle [label="Sortilin receptor\nsynthesis / recycling / turnover"];
    PSAP_route [label="Prosaposin (PSAP)\nco-trafficking route\n(M6PR / LRP1)"];
    LRP1_route [label="LRP1-mediated\nuptake (alternative)"];
    M6PR [label="Mannose-6-phosphate\nreceptor sorting"];
    PGRN_lysosome [label="Lysosomal PGRN\n(intracellular pool)", fillcolor="#cfe4f7"];
    Granulins [label="Granulin peptides A-G\n(cathepsin-cleaved,\nbioactive fragments)"];
    CTSD_activity [label="Cathepsin D (CTSD)\nactivity & maturation"];
    GCase_activity [label="Glucocerebrosidase\n(GBA1) activity"];
    BMP_lipid [label="BMP / bis(monoacylglycero)\nphosphate — lysosomal lipid"];
    Sulfatide_GlcCer [label="Sulfatide / glucosyl-\nceramide accumulation"];
    PGRN_deficit [label="PGRN INSUFFICIENCY\n(functional haploinsufficiency)", fillcolor="#ff9e9e"];
    GRN_homozygous [label="Homozygous GRN loss →\nneuronal ceroid lipofuscinosis\n(CLN11) — dose proof"];
  }

  // =========================================================================
  // 3. LYSOSOME, AUTOPHAGY & PROTEOSTASIS
  // =========================================================================
  subgraph cluster_lysosome {
    label="3. Lysosome / Autophagy / Proteostasis Failure";
    style=filled; color="#c6e8dd"; fillcolor="#e9faf4";
    Lyso_biogenesis [label="Lysosomal biogenesis\n(TFEB / CLEAR network)"];
    Lyso_acidification [label="Lysosomal acidification\n(v-ATPase, pH)"];
    Lyso_function [label="LYSOSOMAL FUNCTION INDEX\n(composite 0-1)", fillcolor="#b8e8d5"];
    Lipofuscin [label="Lipofuscin / ceroid\naccumulation"];
    Autophagosome [label="Autophagosome\nformation (LC3-II)"];
    Autophagic_flux [label="Autophagic flux\n(p62/SQSTM1 clearance)"];
    C9orf72_protein [label="C9orf72 protein\n(C9-SMCR8-WDR41 complex,\nGEF for RAB8/RAB39)"];
    C9_haploinsuff [label="C9orf72 protein\nHAPLOINSUFFICIENCY"];
    TMEM106B_protein [label="TMEM106B protein\n(lysosomal membrane;\nforms its own amyloid fibrils)"];
    UPS_capacity [label="Ubiquitin-proteasome\ncapacity"];
    ER_stress [label="ER stress / UPR\n(PERK-eIF2α, ATF4)"];
    Stress_granules [label="Stress granule\ndynamics (G3BP1, TIA-1)"];
    Nucleocyt_transport [label="Nucleocytoplasmic\ntransport defect\n(RanGAP1, nuclear pore)"];
    Mito_dysfunction [label="Mitochondrial dysfunction\n(OXPHOS↓, ROS↑)"];
    Oxidative_stress [label="Oxidative stress\n(4-HNE, ROS)"];
  }

  // =========================================================================
  // 4. TDP-43 PROTEINOPATHY & CRYPTIC SPLICING
  // =========================================================================
  subgraph cluster_tdp43 {
    label="4. TDP-43 Proteinopathy (FTLD-TDP; ~50% of FTLD) & Cryptic Splicing";
    style=filled; color="#f5d9c0"; fillcolor="#fdf0e4";
    TDP43_nuclear [label="NUCLEAR TDP-43\n(functional; splicing repressor,\nautoregulates own mRNA)", fillcolor="#f7c99b"];
    TDP43_mislocal [label="Nuclear depletion →\ncytoplasmic mislocalization", fillcolor="#f7a86b"];
    TDP43_phospho [label="Phospho-TDP-43\n(pS409/410)"];
    TDP43_cleave [label="Caspase-3 / calpain\nC-terminal fragments (CTFs)"];
    TDP43_aggregate [label="TDP-43 INCLUSIONS\n(ubiquitin+, p62+)", fillcolor="#f78e5b"];
    TDP43_LLPS [label="Aberrant liquid-liquid\nphase separation"];
    TDP43_seeding [label="Seeded aggregation /\nprion-like templating"];
    TDP_typeA [label="TDP-43 Type A\n(GRN; compact NCI + DN)"];
    TDP_typeB [label="TDP-43 Type B\n(C9orf72; diffuse NCI,\nFTD-ALS)"];
    TDP_typeC [label="TDP-43 Type C\n(svPPA; long dystrophic\nneurites)"];
    STMN2_cryptic [label="STMN2 cryptic exon →\ntruncated STMN2\n(axonal repair failure)", fillcolor="#ffd0b0"];
    UNC13A_cryptic [label="UNC13A cryptic exon\n(synaptic vesicle priming;\nrs12608932 risk SNP)", fillcolor="#ffd0b0"];
    Other_cryptic [label="Additional cryptic splicing\n(ELAVL3, KALRN, HDGFL2)"];
    HDGFL2_marker [label="HDGFL2 cryptic peptide\n(pre-symptomatic CSF marker)"];
    Axonal_transport [label="Axonal transport &\ncytoskeletal integrity"];
    FUS_pathology [label="FUS pathology\n(FTLD-FET, ~5-10%,\nyoung-onset bvFTD)"];
    Dipeptide_UPS [label="Ubiquitinated inclusions\n(FTLD-UPS; CHMP2B)"];
  }

  // =========================================================================
  // 5. C9orf72 REPEAT TOXICITY
  // =========================================================================
  subgraph cluster_c9 {
    label="5. C9orf72 Repeat Toxicity — Three Parallel Mechanisms";
    style=filled; color="#e8d0e8"; fillcolor="#f9ecf9";
    C9_sense_RNA [label="Sense GGGGCC\nrepeat RNA", fillcolor="#eec9ee"];
    C9_antisense_RNA [label="Antisense CCCCGG\nrepeat RNA"];
    RNA_foci [label="Nuclear RNA foci\n(G-quadruplex, R-loops)", fillcolor="#eec9ee"];
    RBP_sequestration [label="RNA-binding protein\nsequestration (hnRNPH,\nPur-α, ADARB2, ALYREF)"];
    RAN_translation [label="RAN translation\n(repeat-associated non-AUG,\nall 6 frames)"];
    polyGP [label="poly-GP DPR\n(CSF-measurable\nTARGET-ENGAGEMENT marker)", fillcolor="#e8b5e8"];
    polyGA [label="poly-GA DPR\n(most abundant, aggregating,\nproteasome-impairing)"];
    polyGR [label="poly-GR DPR\n(arginine-rich, most toxic;\nnucleolar/ribosomal stress)"];
    polyPR [label="poly-PR DPR\n(arginine-rich, toxic)"];
    Nucleolar_stress [label="Nucleolar stress\n(nucleophosmin, rRNA)"];
    Ribosome_stalling [label="Ribosome stalling /\ntranslational repression"];
    Repeat_methylation [label="Repeat / promoter\nhypermethylation\n(protective? lowers RNA)"];
    C9_transcript_V [label="C9orf72 transcript\nvariant imbalance (V1/V2/V3)"];
  }

  // =========================================================================
  // 6. TAU PATHOLOGY
  // =========================================================================
  subgraph cluster_tau {
    label="6. Tau Pathology (FTLD-Tau; ~40-45% — MAPT, PSP, CBD, Pick)";
    style=filled; color="#f0e0b8"; fillcolor="#fbf5e3";
    MAPT_transcript [label="MAPT transcription\n(6 isoforms)"];
    Exon10_splicing [label="Exon-10 (E10) splicing →\n4R : 3R tau ratio", fillcolor="#f5e199"];
    Tau_3R [label="3R tau\n(Pick bodies)"];
    Tau_4R [label="4R tau\n(PSP / CBD / most MAPT)"];
    Tau_soluble [label="Soluble monomeric tau\n(microtubule-binding)", fillcolor="#f5e199"];
    Tau_kinases [label="Tau kinases\n(GSK-3β, CDK5, MARK,\nDYRK1A, TTBK1)"];
    PP2A [label="PP2A phosphatase\n(↓ activity)"];
    Tau_phospho [label="HYPERPHOSPHORYLATED tau\n(AT8, pT181, pT217)", fillcolor="#f0d270"];
    Tau_acetyl_trunc [label="Acetylation / truncation /\nO-GlcNAc changes"];
    Tau_oligomer [label="Tau oligomers\n(most synaptotoxic species)"];
    Tau_aggregate [label="Tau FILAMENTS\n(NFT, Pick body,\ntufted astrocyte, coiled body)", fillcolor="#e8be4a"];
    Tau_MT_detach [label="Microtubule\ndestabilization"];
    Tau_spread [label="Trans-synaptic\nprion-like tau spread"];
    Tau_glial [label="Glial tau pathology\n(astrocytic plaques CBD,\ntufted astrocytes PSP)"];
    Tau_PET [label="Tau-PET signal\n(flortaucipir: poor 4R ligand —\na measurement gap)"];
  }

  // =========================================================================
  // 7. NEUROINFLAMMATION & COMPLEMENT-MEDIATED SYNAPTIC PRUNING
  // =========================================================================
  subgraph cluster_inflam {
    label="7. Neuroinflammation, Microglia & Complement-Mediated Pruning";
    style=filled; color="#f2c9c9"; fillcolor="#fceaea";
    Microglia_homeo [label="Homeostatic microglia\n(P2RY12, TMEM119, CX3CR1)"];
    Microglia_DAM [label="DISEASE-ASSOCIATED\nMICROGLIA (DAM/MGnD)\nAPOE-TREM2-TYROBP", fillcolor="#f0a8a8"];
    TREM2_signal [label="TREM2-DAP12 signaling\n(lipid sensing)"];
    Microglia_lyso [label="Microglial lysosomal\nburden (PGRN-dependent)"];
    Complement_C1q [label="C1q upregulation\n(synaptic tagging)", fillcolor="#f0a8a8"];
    Complement_C3 [label="C3 / C3b deposition\n(CSF C1QA & C3 fall\non anti-sortilin therapy)", fillcolor="#f0a8a8"];
    CR3_pruning [label="CR3 (CD11b)-mediated\nmicroglial synapse engulfment", fillcolor="#e88a8a"];
    Astrocyte_react [label="Reactive astrocytes\n(GFAP↑, A1 phenotype)"];
    Cytokines [label="Pro-inflammatory cytokines\n(TNF-α, IL-1β, IL-6, IL-18)"];
    NLRP3 [label="NLRP3 inflammasome\n(caspase-1)"];
    cGAS_STING [label="cGAS-STING / type-I IFN\n(cytosolic dsDNA)"];
    T_cell_infiltr [label="CD8+ T-cell infiltration\n(clonal, GRN & C9 models)"];
    BBB_leak [label="Blood-brain barrier\npermeability↑"];
    TNF_periph [label="Peripheral immune\nactivation (autoimmunity ↑\nin GRN carriers)"];
    Microglia_phagoc [label="Impaired debris /\nmyelin clearance"];
  }

  // =========================================================================
  // 8. SYNAPTIC & NEURONAL DEGENERATION
  // =========================================================================
  subgraph cluster_neurodeg {
    label="8. Synaptic Loss, Neuronal Death & Selective Vulnerability";
    style=filled; color="#c9c9e8"; fillcolor="#ececf9";
    Synapse_density [label="SYNAPTIC DENSITY\n(SV2A-PET, SNAP-25)", fillcolor="#b8b8e8"];
    Dendritic_spine [label="Dendritic spine loss\n/ arbor simplification"];
    vE_neurons [label="VON ECONOMO NEURONS\n(ACC/frontoinsula layer 5 —\nEARLIEST cell type lost)", fillcolor="#a8a8e0"];
    FI_neurons [label="Frontoinsular\nprojection neurons"];
    Layer2_neurons [label="Layer II neurons\n(entorhinal / temporal)"];
    Spindle_selective [label="Selective vulnerability\n(large, long-range,\nhigh-energy neurons)"];
    Neuronal_death [label="NEURONAL DEATH\n(apoptosis / necroptosis)", fillcolor="#a8a8e0"];
    Necroptosis [label="Necroptosis\n(RIPK1-RIPK3-MLKL)"];
    Excitotoxicity [label="Glutamatergic\nexcitotoxicity / E-I imbalance"];
    GABA_interneuron [label="GABAergic interneuron\nloss → disinhibition"];
    Myelin_loss [label="White-matter / myelin\ndegeneration (oligodendrocyte)"];
    Axon_degeneration [label="Axonal degeneration\n→ NfL release", fillcolor="#a8a8e0"];
    Gliosis [label="Superficial laminar\nspongiosis & gliosis"];
    Motor_neuron [label="Lower motor neuron loss\n(FTD-ALS continuum)"];
    Nigrostriatal_loss [label="Nigrostriatal degeneration\n(FTD-parkinsonism, PSP/CBD)"];
  }

  // =========================================================================
  // 9. NETWORK-LEVEL SPREAD & REGIONAL ATROPHY
  // =========================================================================
  subgraph cluster_network {
    label="9. Large-Scale Network Degeneration & Regional Atrophy";
    style=filled; color="#c9e0e8"; fillcolor="#ebf6fa";
    Salience_network [label="SALIENCE NETWORK\n(ACC + frontoinsula)\n→ bvFTD", fillcolor="#a8d4e0"];
    Semantic_network [label="Anterior temporal /\nsemantic network (L>R)\n→ svPPA", fillcolor="#a8d4e0"];
    Language_network [label="L inferior frontal /\nfronto-insular language\n→ nfvPPA", fillcolor="#a8d4e0"];
    Frontoparietal_net [label="Frontoparietal executive\nnetwork (later)"];
    DMN_relative [label="Default-mode network\n(relatively SPARED early —\ncontrast with AD)"];
    Network_spread [label="Connectome-based\ntransneuronal spread\n(hub vulnerability)"];
    Vol_frontal [label="FRONTAL GREY VOLUME\n(MRI, mL / % baseline)", fillcolor="#8fc6d6"];
    Vol_temporal [label="TEMPORAL GREY VOLUME\n(MRI)", fillcolor="#8fc6d6"];
    Vol_insula [label="Insular / ACC volume"];
    Vol_wholebrain [label="Whole-brain volume &\nventricular expansion"];
    FDG_PET [label="FDG-PET frontotemporal\nhypometabolism"];
    ASL_perfusion [label="ASL hypoperfusion\n(earliest imaging change)"];
    DTI_FA [label="DTI: uncinate / SLF\nfractional anisotropy↓"];
    Cortical_thickness [label="Cortical thinning\n(vertex-wise)"];
  }

  // =========================================================================
  // 10. NEUROTRANSMITTER SYSTEMS
  // =========================================================================
  subgraph cluster_nt {
    label="10. Neurotransmitter Systems — Serotonergic Loss vs PRESERVED Cholinergic";
    style=filled; color="#d8e8c0"; fillcolor="#f0f8e4";
    Raphe_5HT [label="Dorsal raphe\nserotonergic neurons"];
    HT5_tone [label="SEROTONERGIC TONE\n(5-HT2A/1A binding↓\nfrontal & cingulate)", fillcolor="#c8e0a0"];
    HT5_2A_loss [label="Frontal 5-HT2A\nreceptor loss"];
    SERT [label="Serotonin transporter\n(SERT/5-HTT) — SSRI target", fillcolor="#c8e0a0"];
    DA_nigrostriatal [label="Dopaminergic tone\n(DAT-SPECT↓ in some;\nFTD-parkinsonism)"];
    D2_striatal [label="Striatal D2 availability"];
    ACh_basal_forebrain [label="Basal forebrain cholinergic\nneurons — LARGELY PRESERVED\n(nucleus basalis)", fillcolor="#e0f0c0"];
    ACh_tone [label="CHOLINERGIC TONE\n(ChAT normal/near-normal →\nAChEI rationale ABSENT)", fillcolor="#e0f0c0"];
    Glutamate_tone [label="Glutamatergic tone\n(NMDA/AMPA)"];
    GABA_tone [label="GABAergic tone"];
    Oxytocin_system [label="Oxytocin / social\nneuropeptide signaling"];
    Noradrenergic [label="Locus coeruleus\nnoradrenergic system"];
  }

  // =========================================================================
  // 11. DRUG PK/PD — DISEASE-MODIFYING
  // =========================================================================
  subgraph cluster_drugDM {
    label="11. Disease-Modifying Drug PK/PD";
    style=filled; color="#ffd9b0"; fillcolor="#fff2e2";
    LATO_dose [label="LATOZINEMAB (AL001)\nanti-sortilin IgG1\n60 mg/kg IV q4w", fillcolor="#ffc180"];
    LATO_central [label="Latozinemab central\nplasma compartment"];
    LATO_periph [label="Peripheral tissue\ncompartment"];
    LATO_TMDD [label="TARGET-MEDIATED\nDISPOSITION on sortilin\n(mAb-SORT1 complex)", fillcolor="#ffb060"];
    LATO_brain [label="Brain / CSF exposure\n(~0.1-0.3% plasma;\nBBB-limited)"];
    SORT1_degrade [label="Sortilin surface\ndownregulation & degradation", fillcolor="#ffb060"];
    AAV_GRN [label="AAV-GRN GENE THERAPY\n(PR006 / AVB-101,\nsingle ICV / intraparenchymal)", fillcolor="#ffc180"];
    AAV_transduce [label="Transduced-cell\ntransgene expression\n(sustained, non-decaying)"];
    AAV_immunity [label="Pre-existing NAb /\ncapsid immune response"];
    ASO_C9 [label="C9orf72 ASO (WVE-004 /\nBIIB078-class)\nintrathecal bolus", fillcolor="#ffc180"];
    ASO_C9_CSF [label="ASO CSF compartment\n(rapid distribution)"];
    ASO_C9_tissue [label="ASO CNS tissue depot\n(t½ weeks-months)"];
    ASO_MAPT [label="MAPT ASO (BIIB080)\nintrathecal q4-12w", fillcolor="#ffc180"];
    ASO_MAPT_tissue [label="MAPT ASO tissue depot\n→ MAPT mRNA knockdown"];
    ASO_dist_gradient [label="Rostro-caudal ASO\ndistribution gradient\n(cortex < spinal cord)"];
    Tau_immunother [label="Anti-tau antibodies /\naggregation inhibitors\n(largely negative to date)"];
    C1q_inhibitor [label="Anti-C1q / complement\ninhibition (experimental)"];
    Cathepsin_modulator [label="CTSD / GCase enhancers,\nTFEB activators (preclinical)"];
  }

  // =========================================================================
  // 12. DRUG PK/PD — SYMPTOMATIC (incl. explicit NULL arm)
  // =========================================================================
  subgraph cluster_drugSym {
    label="12. Symptomatic Pharmacology (and the Cholinergic Null Result)";
    style=filled; color="#ffe0b0"; fillcolor="#fff7e6";
    SSRI_dose [label="SSRI — citalopram 30 mg /\nsertraline 100 mg PO qd", fillcolor="#ffd090"];
    SSRI_plasma [label="SSRI plasma\n(CYP2C19 / 2D6)"];
    SSRI_SERT_block [label="SERT blockade →\nsynaptic 5-HT↑"];
    Trazodone_dose [label="TRAZODONE 150-300 mg\n(5-HT2A antagonist +\nweak SERT inhibition)", fillcolor="#ffd090"];
    Trazodone_effect [label="NPI reduction\n(only positive RCT class)"];
    Oxytocin_dose [label="Intranasal oxytocin\n(empathy/apathy, phase 2)"];
    Antipsychotic [label="Atypical antipsychotics\n(quetiapine — high EPS\nsensitivity, mortality risk)", fillcolor="#ffb0b0"];
    AChEI_dose [label="DONEPEZIL / AChEI\n— NULL EFFICACY ARM", fillcolor="#ffb0b0"];
    AChEI_plasma [label="Donepezil plasma\n(t½ ~70 h)"];
    AChE_inhib [label="AChE inhibition → ACh↑\nin an ALREADY-INTACT system\n→ NO cognitive benefit", fillcolor="#ff9e9e"];
    AChEI_worsen [label="WORSENED disinhibition /\nagitation (documented)", fillcolor="#ff9e9e"];
    Memantine_null [label="Memantine — negative\nphase 3 (Boxer 2013)", fillcolor="#ffb0b0"];
    Nonpharm [label="Non-pharmacological:\ncaregiver training,\nspeech & language therapy"];
  }

  // =========================================================================
  // 13. BIOMARKERS
  // =========================================================================
  subgraph cluster_biomarker {
    label="13. Fluid & Imaging Biomarkers";
    style=filled; color="#c0e0d8"; fillcolor="#e8f7f3";
    NfL_CSF [label="CSF NfL\n(axonal injury; strongest\nprognostic FTD biomarker)", fillcolor="#a0d0c4"];
    NfL_plasma [label="PLASMA / SERUM NfL\n(rises ~1-2 y before onset;\ntracks progression & survival)", fillcolor="#8fc8ba"];
    GFAP_plasma [label="Plasma GFAP\n(astrogliosis)"];
    PGRN_biomarker [label="Plasma & CSF PGRN\n(diagnostic for GRN;\nPD marker for anti-sortilin)", fillcolor="#a0d0c4"];
    polyGP_CSF [label="CSF poly-GP\n(C9 target engagement)", fillcolor="#a0d0c4"];
    pTau_ratio [label="CSF pTau181/tTau ratio\n(LOW in FTLD-TDP —\nhelps exclude AD)"];
    Abeta_ratio [label="CSF Aβ42/40 & p-tau217\n(rule out AD copathology)"];
    CSF_C1Q_C3 [label="CSF C1QA / C3\n(complement PD marker)"];
    CSF_lipids [label="CSF BMP / glucosylsphingosine\n(lysosomal PD markers)"];
    HDGFL2_CSF [label="CSF cryptic HDGFL2\n(pre-symptomatic\nTDP-43 dysfunction)"];
    Neuroimaging_panel [label="MRI volumetry / FDG-PET /\nSV2A-PET / tau-PET"];
    Retinal_thinning [label="Retinal thinning\n(GRN carriers, OCT)"];
    Digital_speech [label="Digital speech &\nactigraphy markers"];
  }

  // =========================================================================
  // 14. CLINICAL PHENOTYPES & ENDPOINTS
  // =========================================================================
  subgraph cluster_clinical {
    label="14. Clinical Phenotypes, Endpoints & Outcomes";
    style=filled; color="#f0c9d8"; fillcolor="#fceaf2";
    Presymptomatic [label="PRESYMPTOMATIC carrier\n(GENFI/ARTFL-LEFFTDS)", fillcolor="#f0b0c8"];
    Prodromal_MCI [label="Prodromal / mild\nbehavioral impairment"];
    bvFTD [label="bvFTD — behavioral variant\n(disinhibition, apathy,\nloss of empathy, hyperorality,\ncompulsions, dysexecutive)", fillcolor="#e89ab8"];
    svPPA [label="svPPA — semantic variant\nPPA (anomia, single-word\ncomprehension loss)", fillcolor="#e89ab8"];
    nfvPPA [label="nfvPPA — nonfluent variant\nPPA (agrammatism, apraxia\nof speech)", fillcolor="#e89ab8"];
    FTD_ALS [label="FTD-ALS\n(C9orf72-enriched;\nshortest survival)", fillcolor="#e89ab8"];
    FTD_PSP_CBS [label="FTD-parkinsonism\n(PSP / CBS phenotypes)", fillcolor="#e89ab8"];
    Disinhibition [label="Disinhibition &\nsocial-conduct breakdown"];
    Apathy [label="Apathy / inertia"];
    Empathy_loss [label="Loss of empathy /\nemotional blunting"];
    Hyperorality [label="Hyperorality, carbohydrate\ncraving, weight gain"];
    Compulsions [label="Stereotyped / ritualistic\ncompulsive behavior"];
    Executive_dysf [label="Executive dysfunction\n(with relatively spared\nmemory & visuospatial early)"];
    CDR_FTLD [label="CDR plus NACC-FTLD SB\n(0-24) — PRIMARY ENDPOINT", fillcolor="#e07aa0"];
    NPI_score [label="NPI total (0-144) —\nbehavioral endpoint", fillcolor="#e07aa0"];
    FRS_score [label="FTD Rating Scale (FRS)\nlogit / Rasch score"];
