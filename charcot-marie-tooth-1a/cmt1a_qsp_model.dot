  /* ================================================================
     22. NEUROTOXIC CONTRAINDICATIONS
     ================================================================ */
  subgraph cluster_tox {
    label = "22. Neurotoxic drugs: the same margin equation, evaluated at a lower transport velocity";
    style = "filled"; fillcolor = "#f7dede"; color = "#8b2020"; fontsize = 14; fontcolor = "#661414";
    node [fillcolor = "#eebcbc", color = "#8b2020"];

    VCR        [label = "VINCRISTINE\nabsolutely contraindicated in CMT1A",
