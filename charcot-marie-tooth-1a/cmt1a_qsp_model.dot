    PregWorse  [label = "Documented worsening in ~1/3 of pregnancies\noften incomplete recovery"];
    Growth     [label = "Childhood growth\naxons lengthen faster than they can be supplied"];
    Ageing     [label = "Ageing: baseline motor unit attrition\nadds to the disease slope after 60"];
    Diabetes   [label = "Comorbid diabetes / CIDP overlap\nsuperimposed second hit"];
    Immob      [label = "Immobilisation / illness\nreserve loss not recovered"];
    B6         [label = "Pyridoxine excess, alcohol, B12 deficiency\nadditive axonal insults"];
    CIDPover   [label = "Superimposed inflammatory neuropathy\nrare, steroid-responsive: worth excluding", fillcolor = "#cfe0f4"];

    Preg -> PRnuc [label = "+"]; Preg -> PregWorse;
    Growth -> Ltrans [style = dotted]; Ageing -> MUcount [arrowhead = tee];
    Diabetes -> AxLoss; Immob -> Reserve [arrowhead = tee]; B6 -> AxLoss;
    CIDPover -> Demy;
