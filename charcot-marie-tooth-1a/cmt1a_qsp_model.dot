    TenMWT     [label = "10-metre walk test (s)"];
    SixMWT     [label = "6-minute walk distance (m)"];
    NineHPT    [label = "9-hole peg test (s)\nhand function"];
    Dorsi      [label = "Ankle dorsiflexion strength (MRC / N)"];
    Grip       [label = "Grip / pinch strength"];
    SF36       [label = "SF-36 / patient-reported QoL"];
    CMTPedS    [label = "CMTPedS (paediatric, 0-44)\nmoves faster than adult scales"];
