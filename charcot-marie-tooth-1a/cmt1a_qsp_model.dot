                shape = box, style = "filled,bold", fillcolor = "#dd9494"];
    Taxane     [label = "Paclitaxel / docetaxel\nMT stabilisation, transport impaired"];
    Platin     [label = "Cisplatin / oxaliplatin\nDRG-selective, sensory"];
    Nitrofur   [label = "Nitrofurantoin, amiodarone, dapsone,\nmetronidazole, thalidomide, bortezomib"];
