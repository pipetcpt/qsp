  subgraph cluster_sens {
    label = "13. Sensory system: large-fibre loss, proprioceptive ataxia and the unfelt foot";
    style = "filled"; fillcolor = "#eaf5ea"; color = "#4c8a4c"; fontsize = 14; fontcolor = "#336133";
    node [fillcolor = "#dcf0dc", color = "#4c8a4c"];

    DRG        [label = "Dorsal root ganglion neuron\npseudounipolar, two long branches"];
    Ia_spindle [label = "Ia afferent / muscle spindle\nproprioception"];
    Abeta      [label = "A-beta touch / vibration\nMeissner, Pacinian"];
    Adelta_C   [label = "A-delta / C small fibres\nrelatively preserved in CMT1A"];
    VibThr     [label = "Vibration threshold at hallux\nearliest quantitative sensory sign"];
    SNAP       [label = "Sural SNAP amplitude\noften absent by adulthood"];
    IENFD      [label = "Intraepidermal nerve fibre density\nskin biopsy"];
    Proprio    [label = "PROPRIOCEPTIVE LOSS\ndrives ataxia more than weakness does",
                shape = box, style = "filled,bold", fillcolor = "#b8dfb8"];
    Romberg    [label = "Romberg positive / sensory ataxia"];
    Ulcer      [label = "Insensate foot + high plantar pressure\nulceration risk", fillcolor = "#e8c9c9"];

    DRG -> Ia_spindle; DRG -> Abeta; DRG -> Adelta_C;
    Sensory_L -> DRG [style = dotted];
    Ia_spindle -> Proprio; Abeta -> VibThr; Abeta -> SNAP;
    Adelta_C -> IENFD; Proprio -> Romberg;
  }

