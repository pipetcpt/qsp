    CMTNS -> CMTES [style = dotted]; Dorsi -> ONLS; Grip -> ONLS;
    FootDrop -> TenMWT; Falls -> SixMWT; HandIntr -> NineHPT;
    CMTNS -> Ceiling [style = dotted]; ONLS -> Ceiling [style = dotted];
