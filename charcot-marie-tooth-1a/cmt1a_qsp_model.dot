  /* ================================================================
     24. TRIAL DESIGN LAYER
     ================================================================ */
  subgraph cluster_trial {
    label = "24. The trial-design layer: why a correct drug can still produce a null result here";
    style = "filled"; fillcolor = "#f2f2f2"; color = "#555555"; fontsize = 14; fontcolor = "#333333";
    node [fillcolor = "#e2e2e2", color = "#555555"];

    Slope      [label = "TRUE PROGRESSION SLOPE\nCMTNS ~0.1-0.7 points/year"];
    MeasErr    [label = "MEASUREMENT ERROR\nCMTNS inter-rater SD ~1.5-2 points",
                shape = box, style = "filled,bold", fillcolor = "#cfcfcf"];
    SNR        [label = "SIGNAL-TO-NOISE\n12-month signal is a fraction of the noise",
                shape = box, style = "filled,bold", fillcolor = "#cfcfcf"];
    Nreq       [label = "REQUIRED SAMPLE SIZE\ncomputed, not assumed",
                shape = box, style = "filled,bold", fillcolor = "#cfcfcf"];
    Duration   [label = "REQUIRED DURATION\n>= 24-36 months for adult scales"];
    Enrich     [label = "ENRICHMENT: recruit while reserve remains\nchildren / early adults, CMTPedS"];
    EndpointCh [label = "ENDPOINT CHOICE dominates power\nMRI fat fraction >> NfL > CMAP >> CMTNS >> NCV",
                shape = box, style = "filled,bold", fillcolor = "#c2c2c2"];
    Placebo    [label = "Placebo-arm drift: practice effects on timed tests\ncan cancel a real drug effect"];
    Window_t   [label = "TREATMENT WINDOW\nreserve, not age, defines who can still benefit",
                shape = box, style = "filled,bold", fillcolor = "#c2c2c2"];

    Slope -> SNR; MeasErr -> SNR [arrowhead = tee]; SNR -> Nreq -> Duration;
    CMTNS -> Slope; NCVb -> EndpointCh; MRIfat -> EndpointCh; NfL_pl -> EndpointCh;
    EndpointCh -> Nreq [arrowhead = tee]; Enrich -> Nreq [arrowhead = tee];
    Reserve -> Window_t; Window_t -> Enrich; Placebo -> SNR [arrowhead = tee];
    PLEO -> Nreq [style = dotted]; TRIAAL -> Nreq [style = dotted];
  }

  /* ================================================================
     CROSS-CLUSTER EDGES — the spine of the model
     ================================================================ */
  Dosage_g   -> Translate      [lhead = cluster_prot, penwidth = 2.0, color = "#2f8b80", label = "  1.5x load"];
  Aggreg     -> CJUN           [penwidth = 2.0, color = "#c1732a", label = "  proteostatic stress\n  dedifferentiates"];
  PERK       -> EGR2sc         [arrowhead = tee, color = "#2f8b80"];
  Dosage_g   -> Stoich         [penwidth = 2.0, color = "#c1732a", label = "  wrong ratio"];
  Cycle      -> IntLen         [arrowhead = tee, penwidth = 2.0, color = "#c1732a", label = "  ratchet"];
  IntLen     -> NCV            [penwidth = 2.0, color = "#b39b1e"];
  Lamellae   -> NCV            [penwidth = 1.5, color = "#b39b1e"];
  Demy       -> NodeLen        [penwidth = 1.5, color = "#b39b1e"];
  Demy       -> NKA            [penwidth = 1.5, color = "#8a6244", label = "  conduction cost up"];
  SCmetab    -> Lactate        [penwidth = 2.0, color = "#8a6244"];
  Demy       -> SCmetab        [arrowhead = tee, penwidth = 2.0, color = "#8a6244", label = "  support withdrawn"];
  SCtrophic  -> Supply         [penwidth = 1.5, color = "#6b4a30", label = "  local"];
  Calibre    -> Demand         [penwidth = 1.2, color = "#6b4a30"];
  Margin     -> AxLoss         [penwidth = 2.4, color = "#a34a4a", label = "  below 1: dying back"];
  AxLoss     -> Force          [arrowhead = tee, penwidth = 1.5, color = "#4c8a4c", ltail = cluster_degen];
  Reserve    -> MUsize         [style = dotted, color = "#4f6d8f"];
  Knee       -> CMTNS          [penwidth = 2.0, color = "#8f2f2f", label = "  disability begins"];
  Ulcer      -> ONLS           [color = "#8f2f2f", style = dotted];
  MUcount    -> NfL_pl         [style = dotted, color = "#8f2f2f"];
  Window     -> Stoich         [penwidth = 2.0, color = "#9c2f6a", label = "  restores ratio"];
  Overshoot  -> Margin         [style = dotted, color = "#8b2020", label = "  no axonal benefit either"];
  HDACi_pk   -> Vtrans         [penwidth = 1.8, color = "#b8477e", label = "  raises v - raises margin"];
  NT3        -> Regen          [penwidth = 1.2, color = "#b8477e"];
  PXT_effect -> Dosage_g       [arrowhead = tee, penwidth = 1.5, color = "#b8477e"];
  AA_cAMP    -> Dosage_g       [arrowhead = tee, style = dotted, color = "#b8477e"];
  VCR_cat    -> AxLoss         [penwidth = 2.0, color = "#8b2020"];
  Preg       -> Dosage_g       [style = dotted, color = "#3d6fa5"];
  DevWin     -> Window_t       [style = dotted, color = "#555555", label = "  the earliest window of all"];
  NCV        -> EndpointCh     [style = dotted, color = "#555555"];

  /* ---------- legend ---------- */
  subgraph cluster_legend {
    label = "Legend";
    style = "filled"; fillcolor = "#fafafa"; color = "#888888"; fontsize = 13;
    node [shape = plaintext, fillcolor = "#fafafa", color = "#fafafa", fontsize = 10];
    L1 [label = "solid arrow  =  activation / flux / causation"];
    L2 [label = "tee arrow  =  inhibition / consumption / suppression"];
    L3 [label = "dotted arrow  =  modulation, weak or conditional link"];
    L4 [label = "bold node  =  quantity carried explicitly as a state or key algebraic output in the mrgsolve model"];
    L5 [label = "g  =  PMP22 functional dosage relative to normal (2 copies).  CMT1A untreated g ~ 1.5;  HNPP g ~ 0.5;  therapeutic target g = 1.0"];
    L6 [label = "Margin  =  delivered axonal supply / terminal demand.  Axon degenerates while Margin < 1."];
    L1 -> L2 -> L3 -> L4 -> L5 -> L6 [style = invis];
  }
}
