  /* ================================================================
     18. PXT3003
     ================================================================ */
  subgraph cluster_pxt {
    label = "18. PXT3003 (baclofen + naltrexone + D-sorbitol): low-dose combination, PMP22 transcription";
    style = "filled"; fillcolor = "#fdeef5"; color = "#b8477e"; fontsize = 14; fontcolor = "#8c3260";
    node [fillcolor = "#f7d5e4", color = "#b8477e"];

    BAC_dose   [label = "(R)-baclofen PO\nGABA-B agonist, sub-therapeutic dose"];
    NTX_dose   [label = "Naltrexone PO (low dose)\nopioid receptor antagonist"];
    SOR_dose   [label = "D-sorbitol PO"];
    BAC_pk     [label = "Baclofen PK\nF ~ 0.7, t1/2 ~ 4 h, renal CL"];
    NTX_pk     [label = "Naltrexone PK\nhigh first pass, 6-beta-naltrexol metabolite"];
    SOR_pk     [label = "Sorbitol PK\nosmotic, poorly absorbed"];
    Synergy    [label = "Claimed multi-target synergy\non PMP22 transcription (P1 promoter)"];
    PXT_effect [label = "PMP22 mRNA reduction\n~15-25% in preclinical models"];
    PLEO       [label = "PLEO-CMT phase 3\nONLS -0.37 vs placebo at high dose;\n1.5x arm stopped (sorbitol crystallisation)", fillcolor = "#f0bcd4"];
    PREMIER    [label = "PREMIER phase 3 (2024)\nFAILED primary endpoint", fillcolor = "#e5a1c2"];
    Formul     [label = "Formulation instability\nthe 1.5x arm lost mid-trial", fillcolor = "#e5a1c2"];

    BAC_dose -> BAC_pk; NTX_dose -> NTX_pk; SOR_dose -> SOR_pk;
    BAC_pk -> Synergy; NTX_pk -> Synergy; SOR_pk -> Synergy;
    Synergy -> PXT_effect; PXT_effect -> PMP22mRNA [arrowhead = tee];
    PXT_effect -> PLEO; PLEO -> PREMIER; Formul -> PLEO;
  }

  /* ================================================================
     19. ASCORBIC ACID
     ================================================================ */
  subgraph cluster_aa {
    label = "19. Ascorbic acid: four null RCTs, and a PK explanation that precedes any question of efficacy";
    style = "filled"; fillcolor = "#fdeef5"; color = "#b8477e"; fontsize = 14; fontcolor = "#8c3260";
    node [fillcolor = "#fadeeb", color = "#b8477e"];

    AA_dose    [label = "Oral ascorbic acid\n1.0 / 1.5 / 3.0 / 4.0 g per day in trials"];
    SVCT1gut   [label = "SVCT1 intestinal transporter\nSATURATES: F falls from ~0.9 to ~0.16",
                shape = box, style = "filled,bold", fillcolor = "#f0bcd4"];
    AA_plasma  [label = "PLASMA ASCORBATE\nPLATEAUS near 70-80 uM regardless of dose",
                shape = box, style = "filled,bold", fillcolor = "#f0bcd4"];
    RenalThr   [label = "Renal threshold\nfiltered load above ~60 uM is not reabsorbed"];
    SVCT2      [label = "SVCT2 tissue uptake (Schwann cell)\nKm ~ 20 uM: already saturated at baseline"];
    AA_cAMP    [label = "Adenylate cyclase inhibition - cAMP down\n- PMP22 P1 transcription down"];
    Mouse      [label = "C22 mouse: 4x lifespan-scaled dose\nrescued myelination (Passage 2004)"];
    TRIAAL     [label = "CMT-TRIAAL / CMT-TRAUK / Micallef /\nBurns paediatric: ALL NULL", fillcolor = "#e5a1c2"];
    DoseGap    [label = "MODEL RESULT: 1.5 g/d and 4 g/d differ\nby ~10% in plasma, not by 2.7x",
                shape = box, style = "filled,bold", fillcolor = "#e5a1c2"];

    AA_dose -> SVCT1gut -> AA_plasma; AA_plasma -> RenalThr -> AA_plasma [arrowhead = tee];
    AA_plasma -> SVCT2 -> AA_cAMP; AA_cAMP -> cAMP [arrowhead = tee];
    Mouse -> AA_dose [style = dotted, label = "translation step"];
    AA_plasma -> DoseGap; DoseGap -> TRIAAL;
  }

  /* ================================================================
     20. PMP22-LOWERING OLIGONUCLEOTIDES — THE INTERIOR OPTIMUM
     ================================================================ */
  subgraph cluster_oligo {
    label = "20. PMP22-lowering oligonucleotides: the therapeutic window has a FAR WALL (interior optimum #1)";
    style = "filled"; fillcolor = "#fdeef5"; color = "#9c2f6a"; fontsize = 14; fontcolor = "#75204f";
    node [fillcolor = "#f5c9de", color = "#9c2f6a"];

    ASO        [label = "ASO gapmer vs PMP22 mRNA\nRNase H1 cleavage (Zhao 2018 JCI)"];
    siRNA      [label = "siRNA-fatty-acid conjugate (FALCON)\nRISC loading, sciatic nerve delivery"];
    AAV_shRNA  [label = "AAV-delivered shRNA / miRNA\none-shot, non-titratable = risky here"];
    CRISPRi    [label = "CRISPRi / epigenetic silencing\nnon-titratable, permanent"];
    SC_depot   [label = "Subcutaneous depot"];
    Plasma_o   [label = "Plasma oligonucleotide\nrapid distribution, hours"];
    Nerve_o    [label = "PERIPHERAL NERVE TISSUE POOL\nt1/2 weeks - months: the PD driver",
                shape = box, style = "filled,bold", fillcolor = "#eeb0cf"];
    KD         [label = "PMP22 knockdown fraction\nslow on, very slow off"];
    Window     [label = "THERAPEUTIC WINDOW\n0 < knockdown < 33% of the 3-copy state",
                shape = box, style = "filled,bold", fillcolor = "#e29ac0"];
    Overshoot  [label = "OVERSHOOT: g < 1\niatrogenic HNPP - tomacula, pressure palsies",
                shape = box, style = "filled,bold", fillcolor = "#c97fa5"];
    Slowdrug   [label = "Long tissue half-life is PROTECTIVE here\nit flattens g and keeps it inside the window",
                shape = box, style = "filled,bold", fillcolor = "#e29ac0"];
    Titrate    [label = "Dose titration against skin PMP22 mRNA\nthe only safe way to approach g = 1"];

    ASO -> SC_depot; siRNA -> SC_depot; SC_depot -> Plasma_o -> Nerve_o -> KD;
    KD -> PMP22mRNA [arrowhead = tee];
    KD -> Window; Window -> Dosage_g [arrowhead = tee];
    KD -> Overshoot [label = "if too deep"]; Overshoot -> Tomacula;
    Nerve_o -> Slowdrug; Titrate -> KD [style = dotted];
    AAV_shRNA -> Overshoot [style = dotted, label = "cannot be dialled back"];
    CRISPRi -> Overshoot [style = dotted];
  }

