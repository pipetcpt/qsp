    NaV17      [label = "NaV1.7 / NaV1.8 upregulation in DRG"];
    Cramp      [label = "Muscle cramp\nhyperexcitable terminal branches"];
    DorsalH    [label = "Dorsal horn wind-up / central sensitisation"];
