     23. MODIFIERS AND LIFE COURSE
     ================================================================ */
  subgraph cluster_mod {
    label = "23. Modifiers and life course: pregnancy, growth, comorbidity, immobilisation";
    style = "filled"; fillcolor = "#eef4fb"; color = "#3d6fa5"; fontsize = 14; fontcolor = "#24507d";
    node [fillcolor = "#dfeaf7", color = "#3d6fa5"];

