                shape = box, style = "filled,bold", fillcolor = "#dd9494"];

    VCR -> VCR_mech -> Vtrans [arrowhead = tee];
    Margin -> Margin_lo; Margin_lo -> VCR_cat; VCR_mech -> VCR_cat;
    Taxane -> Vtrans [arrowhead = tee]; Platin -> DRG [arrowhead = tee];
    Nitrofur -> AxLoss [style = dotted]; Statin_q -> AxLoss [style = dotted];
  }

