    NerveUS    [label = "Nerve ultrasound CSA\nhypertrophy: a trait, not a state"];
    SkinBx     [label = "Skin biopsy PMP22 mRNA\ntarget engagement, not efficacy"];
    Nerve_MRI  [label = "Nerve MRI / MR neurography"];

    AxLoss -> NfL_pl; AxLoss -> CMAPamp [arrowhead = tee]; MUcount -> MUNEb;
    FatRepl -> MRIfat; NCV -> NCVb; ONION -> NerveUS;
    Dosage_g -> SkinBx [style = dotted];
