  Plasma_Ala -> Portal_NH4 [style=dashed];
  Plasma_Gln -> Gln_as_substrate [penwidth=2];
  Plasma_Gln -> Mon_Gln;
  Plasma_Gln -> Crisis_rate [label=">1000 µmol/L\npredicts crisis", style=dashed, color="#b71c1c"];

  /* EDGES — 7. ammonia kinetics */
  Portal_NH4 -> Plasma_NH4 [penwidth=2];
