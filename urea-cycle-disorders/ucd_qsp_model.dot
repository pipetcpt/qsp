  Plasma_NH4 -> Mon_NH3;
  Renal_NH4_excr -> Plasma_NH4 [label="−", arrowhead=tee, color="#2e7d32"];

  /* EDGES — 8. CNS */
  Brain_NH4 -> Astrocyte [penwidth=2];
  Astrocyte -> GS_brain;
  GS_brain -> Brain_Gln [penwidth=2];
  Brain_Gln -> Astro_swelling [penwidth=2, color="#b71c1c"];
  Brain_Gln -> Myoinositol [label="osmolyte\nexchange", arrowhead=tee];
  Myoinositol -> Astro_swelling [label="depleted buffer\n→ less protection", color="#b71c1c"];
  Taurine_cr -> Astro_swelling [arrowhead=tee];
  Brain_Gln -> Taurine_cr [arrowhead=tee];
  AQP4 -> Astro_swelling;
  Astro_swelling -> Brain_water [penwidth=2];
