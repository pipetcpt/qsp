  Plasma_Arg -> Arg_allosteric [penwidth=2];
  ARG1_gene -> Arg_excess_ARG1;
  Arg_excess_ARG1 -> Motor_deficit;

  /* EDGES — 10. PBA / PAA / PAGN */
  NaPBA_dose -> PBA_plasma [penwidth=2];
  GPB_dose -> GPB_lipase [penwidth=2];
