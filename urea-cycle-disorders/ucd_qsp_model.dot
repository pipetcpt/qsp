  Liver_Tx -> Neurocog [label="no reversal of\nexisting injury", style=dashed];
  Hepatocyte_Tx -> Cycle_flux [style=dashed];
  AAV_OTC -> OTC_enz [label="+ transgene\nactivity", color="#2e7d32", penwidth=2];
  mRNA_OTC -> OTC_enz [label="+ pulsed", color="#2e7d32", penwidth=2];
  Base_editing -> OTC_enz [style=dashed, color="#2e7d32"];
  Immune_AAV -> AAV_OTC [arrowhead=tee, color="#b71c1c"];
  Cycle_flux -> Ureagenesis_assay;
  AAV_OTC -> Ureagenesis_assay;

  /* EDGES — 13. renal / disposition */
  GFR -> OAT13;
  OAT13 -> PAGN_renal;
  OAT13 -> Hipp_renal;
  Probenecid -> OAT13 [arrowhead=tee, color="#b71c1c"];
  GFR -> Renal_impair [style=dashed];
