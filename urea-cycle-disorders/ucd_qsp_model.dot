  Brain_NH4 -> EAAT2 [arrowhead=tee];
  EAAT2 -> NMDA [label="clearance ↓\n→ Glu ↑"];
  NMDA -> ROS_RNS;
  NMDA -> Seizure;
  Brain_NH4 -> GABA_tone;
  GABA_tone -> EEG_slow;
  Plasma_Gln -> Trp_5HT [label="LNAA\ncompetition"];
