  BCAA_depletion -> Growth_z [arrowhead=tee, color="#b71c1c"];
  BCAA_depletion -> Mon_AA;
  Glycine_pool -> Mon_AA;

  /* EDGES — 12. extracorporeal / definitive */
  HD -> Plasma_NH4 [label="−− (fastest)", arrowhead=tee, color="#2e7d32", penwidth=3];
  CVVHD -> Plasma_NH4 [label="−", arrowhead=tee, color="#2e7d32", penwidth=2];
  Peritoneal -> Plasma_NH4 [arrowhead=tee, style=dashed];
