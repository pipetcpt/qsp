  CPS1_gene -> CPS1_enz;
  ASS1_gene -> ASS1_enz;
  ASL_gene -> ASL_enz;
  ARG1_gene -> ARG1_enz;
  ORNT1_gene -> ORNT1_tr;
  CITRIN_gene -> AGC_citrin;

  /* EDGES — 2. nitrogen input */
  Dietary_protein -> Gut_lumen_protein;
  Protein_restrict -> Dietary_protein [label="−", color="#2e7d32"];
