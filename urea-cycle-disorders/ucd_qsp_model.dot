  PAA_plasma -> BCAA_depletion [style=dashed];
  NaPBA_dose -> BCAA_depletion [color="#b71c1c"];
  GPB_dose -> BCAA_depletion [color="#b71c1c", style=dashed];
  NaPBA_dose -> Na_load [color="#b71c1c"];

  /* EDGES — 11. benzoate axis + activators */
  Benzoate_dose -> BZ_CoA [penwidth=2];
  IV_PAA_BZ -> BZ_CoA;
  BZ_CoA -> GLYAT;
  Glycine_pool -> GLYAT [penwidth=2];
  GLYAT -> Hippurate [penwidth=2];
  Hippurate -> Hipp_renal;
