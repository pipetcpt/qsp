  Brain_water -> Motor_deficit;
  Crisis_rate -> Hospitalisation;
  Herniation -> Survival [arrowhead=tee, color="#b71c1c"];
  Crisis_rate -> Survival [arrowhead=tee];
  Liver_Tx -> Survival [color="#2e7d32"];
  Neurocog -> QoL;
  Hospitalisation -> QoL [arrowhead=tee];
  Cycle_flux -> Diet_tolerance [color="#2e7d32", penwidth=2];
  PAGN -> Diet_tolerance [color="#2e7d32"];
  Hippurate -> Diet_tolerance [color="#2e7d32"];
  Diet_tolerance -> Growth_z [color="#2e7d32"];
  Diet_tolerance -> QoL [color="#2e7d32"];
  Mon_Gln -> Crisis_rate [style=dashed, label="early warning"];
  Mon_NH3 -> Crisis_rate [style=dashed];
  Mon_UPAGN -> NaPBA_dose [style=dashed, label="dose\nadjustment"];
  Mon_PAA -> GPB_dose [style=dashed, label="dose\nadjustment"];
  Mon_AA -> Citrulline_drug [style=dashed];
  Mon_orotate -> Dx_discriminator [style=dashed];
  Mon_MRS -> Neurocog [style=dashed];
}
