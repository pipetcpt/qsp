  Brain_NH4 -> Energy_fail;
  Energy_fail -> Astro_neuron;
  Astro_neuron -> EEG_slow;
  Brain_water -> EEG_slow;
  Brain_Gln -> Mon_MRS;
  Myoinositol -> Mon_MRS;
