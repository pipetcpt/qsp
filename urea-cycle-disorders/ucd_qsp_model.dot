digraph UCD_QSP {
  rankdir=LR;
  fontname="Helvetica";
  labelloc="t";
  fontsize=20;
  label="Urea Cycle Disorders (UCD) — Mechanistic QSP Map (OTC deficiency as the index defect)\nEnzyme/transporter block in hepatic ureagenesis → nitrogen backs up as ammonia and glutamine → astrocytic glutamine osmolyte trap → cerebral oedema, encephalopathy, neurocognitive loss\nPharmacology: alternative-pathway nitrogen scavengers (NaPBA · glycerol phenylbutyrate · Na-benzoate · Na-phenylacetate) · carglumic acid · L-arginine / L-citrulline · dialysis · AAV-OTC & OTC-mRNA · liver transplant";
  node [style=filled, fontname="Helvetica", fontsize=10, shape=box];
  edge [fontname="Helvetica", fontsize=8];
  newrank=true;
  nodesep=0.28;
  ranksep=0.90;

  /* ======================================================================
     1. Genetic substrate — which enzyme, which allele, how much residual
     ====================================================================== */
  subgraph cluster_gen {
    label="1. Genetic Substrate: Eight Loci of the Urea Cycle";
    style=filled; color="#c8bcd8"; fillcolor="#f1ecf7"; fontsize=13;
    NAGS_gene   [label="NAGS (17q21.31)\nN-acetylglutamate synthase\nAR — carglumic-acid curable"];
    CPS1_gene   [label="CPS1 (2q34)\ncarbamoyl-phosphate\nsynthetase 1 — AR"];
    OTC_gene    [label="OTC (Xp11.4)\nornithine transcarbamylase\nX-LINKED — commonest UCD", fillcolor="#dccff0"];
    ASS1_gene   [label="ASS1 (9q34.11)\nargininosuccinate synthetase\nAR — citrullinaemia type I"];
    ASL_gene    [label="ASL (7q11.21)\nargininosuccinate lyase\nAR — ASA aciduria"];
    ARG1_gene   [label="ARG1 (6q23.2)\narginase-1 — AR\nargininaemia / spastic diplegia"];
    ORNT1_gene  [label="SLC25A15 / ORNT1\nmitochondrial ornithine\ncarrier — HHH syndrome"];
    CITRIN_gene [label="SLC25A13 / citrin\naspartate–glutamate carrier\nNICCD / CTLN2"];
    Mut_class   [label="Allele class:\nnull / missense /\nsplice / deletion", fillcolor="#e6dcf5"];
    Residual_activity [label="Residual hepatic\nenzyme activity (%)", fillcolor="#d2bff0"];
    Xinact      [label="X-inactivation skewing\n(heterozygous OTC females)\n→ hepatic mosaicism", fillcolor="#dccff0"];
    Onset_class [label="Phenotype class:\nneonatal (<0-2% act.)\nvs late-onset (partial)", fillcolor="#d2bff0"];
    Newborn_screen [label="Newborn screening\n(low citrulline / high Gln)\n— imperfect for OTC"];
    Family_hx   [label="Family history:\nunexplained neonatal death,\nprotein aversion, migraine"];
  }

  /* ======================================================================
     2. Nitrogen input — diet, gut flora and endogenous catabolism
     ====================================================================== */
  subgraph cluster_nin {
    label="2. Nitrogen Load: Diet · Gut Flora · Endogenous Protein Catabolism";
    style=filled; color="#cfd8b8"; fillcolor="#f2f6e8"; fontsize=13;
    Dietary_protein [label="Dietary protein\n(g/kg/day; 0.16 g N per g)", fillcolor="#e3edcb"];
    Protein_restrict [label="Prescribed protein\nrestriction (0.6-1.2 g/kg/d\nby age) + EAA supplement"];
    EAA_formula [label="Essential amino-acid\nformula (Cyclinex / UCD-2)"];
    Gut_lumen_protein [label="Intestinal protein\n+ urea recycling"];
    Gut_urease [label="Colonic bacterial\nurease → NH3", fillcolor="#e3edcb"];
    Gut_glutaminase [label="Enterocyte glutaminase\n(Gln → Glu + NH4+)"];
    Portal_NH4 [label="Portal ammonia flux\n(~ 1000 µmol/min fed)", fillcolor="#dbe8bd"];
    Muscle_protein [label="Skeletal-muscle\nprotein pool"];
    Proteolysis [label="Net proteolysis\n(ubiquitin-proteasome ·\nautophagy)", fillcolor="#dbe8bd"];
    Catabolic_trigger [label="CATABOLIC TRIGGERS:\ninfection · fever · fasting >8h ·\nsurgery · trauma · GI bleed ·\npostpartum involution · steroids ·\nchemotherapy · seizures", fillcolor="#cfe0a8"];
    Valproate [label="Valproate\n(inhibits NAGS/CPS1,\ncarnitine depletion)", fillcolor="#f6c6c6"];
    Asparaginase [label="L-asparaginase ·\ntopiramate · high-dose\nglucocorticoid", fillcolor="#f6c6c6"];
    Anabolic_rescue [label="Anabolic rescue:\nIV dextrose 10% + intralipid\n± insulin (stop catabolism)", fillcolor="#cfe0a8"];
    Energy_intake [label="Total energy intake\n(kcal/kg/day)"];
  }

  /* ======================================================================
     3. Hepatic urea cycle — mitochondrial arm
     ====================================================================== */
  subgraph cluster_mito {
    label="3. Periportal Hepatocyte Mitochondrion: Proximal (Mitochondrial) Arm";
    style=filled; color="#c3d9ea"; fillcolor="#e9f3fa"; fontsize=13;
    Hepatocyte_periportal [label="Periportal hepatocyte\n(high-capacity, low-affinity\nureagenesis zone)"];
    Mito_NH4 [label="Mitochondrial\nNH4+ / NH3 pool", fillcolor="#cfe4f5"];
    GDH [label="Glutamate dehydrogenase\n(GLUD1) Glu ⇌ α-KG + NH4+"];
    Bicarbonate [label="HCO3- (from CA-VA)"];
    ATP_mito [label="2 ATP\n(mitochondrial)"];
    AcCoA [label="Acetyl-CoA"];
    Glu_mito [label="Mitochondrial\nglutamate"];
    NAGS_enz [label="NAGS\n(N-acetylglutamate\nsynthase)", fillcolor="#cfe4f5"];
    NAG [label="N-acetylglutamate (NAG)\nOBLIGATE CPS1 ALLOSTERIC\nACTIVATOR", fillcolor="#a9d0ee"];
    Arg_allosteric [label="Arginine → allosteric\nSTIMULATION of NAGS"];
    CPS1_enz [label="CPS1\n(rate-limiting, 20% of\nmitochondrial protein)", fillcolor="#cfe4f5"];
    CarbP [label="Carbamoyl phosphate\n(CP)", fillcolor="#a9d0ee"];
    OTC_enz [label="OTC\nornithine transcarbamylase\n★ INDEX DEFECT", fillcolor="#8fc0e8"];
    Orn_mito [label="Mitochondrial ornithine"];
    ORNT1_tr [label="ORNT1 / SLC25A15\nornithine ⇄ citrulline\nantiporter"];
    Citrulline_mito [label="Citrulline (mitochondrial)"];
    CP_overflow [label="CP OVERFLOW to cytosol\n(when OTC blocked)", fillcolor="#f6d9a8"];
  }

  /* ======================================================================
     4. Hepatic urea cycle — cytosolic arm and the aspartate shunt
     ====================================================================== */
  subgraph cluster_cyto {
    label="4. Hepatocyte Cytosol: Distal Arm & Aspartate–Argininosuccinate Shunt";
    style=filled; color="#b9d6cd"; fillcolor="#e8f5f1"; fontsize=13;
    Citrulline_cyto [label="Cytosolic citrulline"];
    Aspartate [label="Aspartate\n(2nd nitrogen donor)", fillcolor="#cfeae1"];
    AGC_citrin [label="Citrin (AGC2)\nAsp/Glu exchange"];
    ATP_cyto [label="ATP → AMP + PPi"];
    ASS1_enz [label="ASS1\nargininosuccinate\nsynthetase", fillcolor="#cfeae1"];
    ASA [label="Argininosuccinate (ASA)"];
    ASL_enz [label="ASL\nargininosuccinate lyase", fillcolor="#cfeae1"];
    Fumarate [label="Fumarate → TCA\n(carbon recycling)"];
    Arginine_hep [label="Hepatic arginine", fillcolor="#cfeae1"];
    ARG1_enz [label="ARG1 (arginase-1)"];
    Urea_made [label="UREA\n(2 N disposed per turn)", fillcolor="#9fd9c8"];
    Orn_cyto [label="Cytosolic ornithine\n(regenerated)"];
    OAT [label="OAT (ornithine\naminotransferase)\n→ P5C / proline"];
    ODC [label="ODC → polyamines"];
    Cycle_flux [label="NET UREAGENESIS FLUX\n(mmol N / h)", fillcolor="#7fcbb6"];
  }

  /* ======================================================================
     5. Orotic-acid overflow — the OTC-specific biochemical signature
     ====================================================================== */
  subgraph cluster_orotate {
    label="5. Orotic-Acid Overflow (distinguishes OTC from CPS1 / NAGS deficiency)";
    style=filled; color="#e0cbaa"; fillcolor="#faf1e2"; fontsize=13;
    CAD_enzyme [label="CAD complex\n(cytosolic ATCase domain)"];
    Carb_asp [label="Carbamoyl aspartate"];
    Dihydroorotate [label="Dihydroorotate"];
    DHODH [label="DHODH\n(inner mitochondrial\nmembrane)"];
    Orotic_acid [label="OROTIC ACID ↑↑\n(urine, mmol/mol creat)", fillcolor="#f4d8ab"];
    Orotidine [label="Orotidine"];
    Uracil_urine [label="Uracil / uridine ↑"];
    Pyrimidine_pool [label="Pyrimidine nucleotide\nsynthesis"];
    Dx_discriminator [label="DIAGNOSTIC LOGIC:\nlow citrulline + high orotate = OTC\nlow citrulline + normal orotate = CPS1/NAGS", fillcolor="#f4d8ab"];
  }

  /* ======================================================================
     6. Glutamine trap and inter-organ nitrogen shuttling
     ====================================================================== */
  subgraph cluster_gln {
    label="6. Glutamine Trap & Inter-Organ Nitrogen Shuttling";
    style=filled; color="#dcc6c6"; fillcolor="#faeeee"; fontsize=13;
    Hepatocyte_perivenous [label="Perivenous hepatocyte\n(low-capacity, HIGH-AFFINITY\nammonia scavenger)"];
    GS_liver [label="Hepatic glutamine\nsynthetase (GLUL)\n— the last-ditch sink"];
    Muscle_GS [label="Skeletal-muscle GS\n(largest peripheral\nNH4+ sink)", fillcolor="#f2dada"];
    Plasma_Gln [label="PLASMA GLUTAMINE\n(normal 500-750 µmol/L;\n>1000 = crisis risk)", fillcolor="#eec5c5"];
    Plasma_Ala [label="Plasma alanine\n(glucose–alanine cycle)"];
    Plasma_Glu [label="Plasma glutamate"];
    Renal_glutaminase [label="Renal glutaminase\n→ NH4+ into urine\n(pH-dependent)"];
    Renal_NH4_excr [label="Urinary NH4+ excretion\n(minor route, ~30-50 mmol/d)"];
    Gln_reservoir [label="Whole-body glutamine\nreservoir = the buffer\nthat delays coma", fillcolor="#eec5c5"];
    Gln_as_substrate [label="Glutamine = the SUBSTRATE\nthat PAA conjugates\n(2 N per PAGN)", fillcolor="#e8b4b4"];
  }

  /* ======================================================================
     7. Ammonia kinetics and distribution
     ====================================================================== */
  subgraph cluster_nh3 {
    label="7. Ammonia Kinetics: Plasma ⇄ Brain";
    style=filled; color="#d4b8b0"; fillcolor="#f8eeea"; fontsize=13;
    Plasma_NH4 [label="PLASMA AMMONIA\nnormal <35 µmol/L", fillcolor="#f0cfc2"];
    pKa_partition [label="NH3 ⇌ NH4+ (pKa 9.15)\n~1-2% as diffusible NH3"];
    Resp_alkalosis [label="Central hyperventilation\n→ RESPIRATORY ALKALOSIS\n(↑ NH3 fraction — vicious cycle)", fillcolor="#eec0ad"];
    BBB_diffusion [label="Non-ionic NH3 diffusion\nacross BBB"];
    Rh_glycoprotein [label="RhBG / RhCG\nNH4+ transporters"];
    Brain_NH4 [label="BRAIN AMMONIA", fillcolor="#eec0ad"];
    Ammonia_thresholds [label="THRESHOLDS:\n>100 treat · >200 coma risk\n>360 dialyse · >500 & >36 h\n= poor neuro outcome", fillcolor="#e5a98f"];
    Peak_NH3 [label="PEAK ammonia\n× DURATION\n= injury dose", fillcolor="#e5a98f"];
    NH3_AUC [label="Cumulative AUC\nabove 100 µmol/L"];
  }

  /* ======================================================================
     8. CNS pathophysiology — the astrocyte at the centre
     ====================================================================== */
  subgraph cluster_cns {
    label="8. CNS Pathophysiology: Astrocytic Glutamine Osmolyte Trap";
    style=filled; color="#bfc9de"; fillcolor="#ecf0f8"; fontsize=13;
    Astrocyte [label="ASTROCYTE\n(only CNS cell with GS)", fillcolor="#d3dcf0"];
    GS_brain [label="Astrocytic glutamine\nsynthetase"];
    Brain_Gln [label="Brain glutamine ↑↑\n(MRS peak 2.05-2.45 ppm)", fillcolor="#c2cfee"];
    Myoinositol [label="Myo-inositol DEPLETION\n(compensatory osmolyte efflux —\nexhausted in chronic disease)", fillcolor="#c2cfee"];
    Taurine_cr [label="Taurine / creatine\nosmolyte loss"];
    Astro_swelling [label="Astrocyte swelling\n(Alzheimer type II astrocytes)", fillcolor="#adc0e9"];
    AQP4 [label="Aquaporin-4\n(perivascular endfeet)"];
    Brain_water [label="BRAIN WATER CONTENT ↑\n→ cytotoxic oedema", fillcolor="#9db4e5"];
    ICP [label="INTRACRANIAL\nPRESSURE ↑", fillcolor="#8ba8e0"];
    CBF [label="Cerebral blood flow ↑\n(loss of autoregulation)"];
    Herniation [label="Uncal / tonsillar\nherniation → death", fillcolor="#f3b0b0"];
    mPTP [label="Mitochondrial permeability\ntransition pore (Gln → mito\n'Trojan horse' → NH3 in situ)"];
    ROS_RNS [label="Oxidative / nitrosative\nstress (ROS · ONOO-)"];
    NMDA [label="Glutamate ↑ at synapse\n→ NMDA-R overactivation\n→ excitotoxicity", fillcolor="#adc0e9"];
    EAAT2 [label="EAAT2 / GLT-1\ndownregulation"];
    GABA_tone [label="↑ GABAergic tone\n(neurosteroids · benzo-like\nligands)"];
    Trp_5HT [label="↑ brain tryptophan\n→ serotonin turnover\n(anorexia, lethargy)"];
    Energy_fail [label="α-KG drain → TCA\nflux ↓ → ATP ↓"];
    Astro_neuron [label="Astrocyte–neuron\nlactate shuttle failure"];
    EEG_slow [label="EEG: triphasic waves ·\ngeneralised slowing ·\nburst-suppression"];
    Seizure [label="Seizures"];
  }

  /* ======================================================================
     9. Arginine as a conditionally essential amino acid
     ====================================================================== */
  subgraph cluster_arg {
    label="9. Arginine: Conditionally Essential Downstream of the Block";
    style=filled; color="#c9d6b5"; fillcolor="#eff5e6"; fontsize=13;
    Plasma_Arg [label="Plasma arginine\n(deficient in all UCD\nexcept ARG1 deficiency)", fillcolor="#dbe7c6"];
    NOS_path [label="NOS → nitric oxide\n(eNOS / nNOS)"];
    NO_deficit [label="NO deficiency\n(marked in ASL deficiency —\nASL is required for the\nNOS multiprotein complex)", fillcolor="#dbe7c6"];
    Hypertension_ASL [label="Hypertension ·\nendothelial dysfunction"];
    AGAT_GAMT [label="AGAT → guanidinoacetate\n→ GAMT → CREATINE"];
    Creatine_pool [label="Brain / muscle\ncreatine-phosphate pool ↓"];
    Protein_synth [label="Whole-body protein\nsynthesis / growth"];
    Growth_z [label="Height & weight\nZ-score"];
    Arg_excess_ARG1 [label="ARG1 deficiency:\narginine ACCUMULATES\n→ guanidino compounds\n→ spastic diplegia", fillcolor="#f6d9a8"];
  }

  /* ======================================================================
     10. Nitrogen-scavenger pharmacology — the phenylbutyrate axis
     ====================================================================== */
  subgraph cluster_pba {
    label="10. Alternative-Pathway Pharmacology I: Phenylbutyrate → Phenylacetate → PAGN";
    style=filled; color="#e6c9ab"; fillcolor="#fbf0e2"; fontsize=13;
    NaPBA_dose [label="SODIUM PHENYLBUTYRATE\n(Buphenyl / Pheburane)\n9.9-13 g/m2/day ÷ TID-QID", fillcolor="#f6dfbe"];
    GPB_dose [label="GLYCEROL PHENYLBUTYRATE\n(Ravicti, HPN-100)\n4.5-11.2 mL/m2/day ÷ TID", fillcolor="#f6dfbe"];
    GPB_lipase [label="Pancreatic lipase\nhydrolysis in duodenum\n(slow, prodrug-limited release)"];
    PBA_plasma [label="PBA in plasma\n(t½ ~0.8 h)"];
    Beta_ox [label="Hepatic/renal\nmitochondrial β-oxidation\n(one cycle)"];
    PAA_plasma [label="PHENYLACETATE (PAA)\nthe ACTIVE moiety", fillcolor="#f0cb9b"];
    PA_CoA [label="Phenylacetyl-CoA"];
    GLYATL1 [label="Phenylacetyl-CoA:\nL-glutamine N-acyltransferase\n(GLYATL1, liver + kidney)"];
    PAGN [label="PHENYLACETYLGLUTAMINE\n(PAGN) — carries 2 N", fillcolor="#eabb7f"];
    PAGN_renal [label="Renal tubular secretion\n(OAT1 / OAT3) — rapid,\n~100% of dose in urine"];
    UPAGN [label="Urinary PAGN\n(adherence + dose-\nadequacy biomarker)", fillcolor="#eabb7f"];
    PAA_PAGN_ratio [label="PAA : PAGN ratio\n>2.5 (µg/mL) = saturated\nconjugation, PAA will rise", fillcolor="#f3b0b0"];
    PAA_tox [label="PAA NEUROTOXICITY\n(>500 µg/mL: somnolence,\nnausea, headache,\nlethargy, dysgeusia)", fillcolor="#f3b0b0"];
    IV_PAA_BZ [label="IV Na-phenylacetate +\nNa-benzoate 10%/10%\n(Ammonul) — rescue", fillcolor="#f6dfbe"];
    Taste_adherence [label="Taste / pill burden\n→ adherence (GPB is\ntasteless & odourless)"];
  }

  /* ======================================================================
     11. Nitrogen-scavenger pharmacology — the benzoate axis + activators
     ====================================================================== */
  subgraph cluster_bz {
    label="11. Alternative-Pathway Pharmacology II: Benzoate–Glycine · NAG Analogue · Cycle Substrates";
    style=filled; color="#c9c0dd"; fillcolor="#f0edf8"; fontsize=13;
    Benzoate_dose [label="SODIUM BENZOATE\n250-500 mg/kg/day", fillcolor="#dcd4ee"];
    BZ_CoA [label="Benzoyl-CoA\n(hepatic/renal)"];
    GLYAT [label="Glycine N-acyltransferase\n(GLYAT)"];
    Glycine_pool [label="Glycine pool\n(DEPLETED by chronic\nbenzoate)", fillcolor="#dcd4ee"];
    Hippurate [label="HIPPURATE\n— carries 1 N only", fillcolor="#c9bce8"];
    Hipp_renal [label="Renal OAT-mediated\nsecretion → urine"];
    Carglumic [label="CARGLUMIC ACID\n(N-carbamyl-L-glutamate,\nCarbaglu) 100-250 mg/kg/d", fillcolor="#dcd4ee"];
    NCG_action [label="Stable NAG ANALOGUE →\ndirect CPS1 activation\n(curative in NAGS deficiency;\nuseful in PA/MMA & VPA\nhyperammonaemia)", fillcolor="#c9bce8"];
    Arg_HCl [label="L-ARGININE HCl\nIV 200-600 mg/kg load\n(ASS1/ASL: high dose)", fillcolor="#dcd4ee"];
    Citrulline_drug [label="L-CITRULLINE PO\n170 mg/kg/day\n(OTC / CPS1 only —\nbypasses the block and\ntraps 1 extra N via ASS1)", fillcolor="#dcd4ee"];
    Na_load [label="Sodium load\n(NaPBA & benzoate)\n→ oedema, hypertension,\nhypokalaemia", fillcolor="#f3b0b0"];
    BCAA_depletion [label="BRANCHED-CHAIN AA\nDEPLETION (PBA-specific)\n→ monitor Val/Leu/Ile", fillcolor="#f3b0b0"];
    Carnitine_dep [label="Carnitine depletion\n(benzoate · valproate)"];
    Ondansetron [label="Antiemetic / gastric\nprotection (PPI)"];
  }

  /* ======================================================================
     12. Extracorporeal removal and definitive therapy
     ====================================================================== */
  subgraph cluster_extra {
    label="12. Extracorporeal Removal · Transplant · Genetic Therapies";
    style=filled; color="#b3cdd6"; fillcolor="#e7f2f5"; fontsize=13;
    HD [label="HAEMODIALYSIS\nammonia clearance\n~35-60 mL/min/kg —\nfastest available", fillcolor="#cbe3ea"];
    CVVHD [label="CVVHDF (continuous)\nlower clearance,\nprevents rebound", fillcolor="#cbe3ea"];
    Peritoneal [label="Peritoneal dialysis /\nexchange transfusion\n— inadequate alone"];
    Rebound [label="POST-DIALYSIS REBOUND\n(re-equilibration from\nthe tissue Gln reservoir)", fillcolor="#f3b0b0"];
    Liver_Tx [label="ORTHOTOPIC LIVER\nTRANSPLANT — phenotypic\ncure of ureagenesis;\ndoes NOT reverse prior\nCNS injury", fillcolor="#cbe3ea"];
    Hepatocyte_Tx [label="Hepatocyte transplantation\n(bridge)"];
    AAV_OTC [label="AAV8-OTC gene transfer\n(DTX301) — durable\nepisomal OTC expression,\nscavenger weaning", fillcolor="#cbe3ea"];
    mRNA_OTC [label="OTC mRNA-LNP\n(ARCT-810) — repeat-dosed\npulses of hepatic OTC", fillcolor="#cbe3ea"];
    Base_editing [label="In-vivo base editing /\nintegrating vectors\n(paediatric, preclinical)"];
    Immune_AAV [label="Anti-capsid immunity ·\npre-existing NAb ·\nsteroid taper"];
    Ureagenesis_assay [label="13C-acetate / 15N\nureagenesis flux assay\n(the trial endpoint that\nreads restored capacity)", fillcolor="#cbe3ea"];
  }

  /* ======================================================================
     13. Renal handling, drug disposition and DDI
     ====================================================================== */
  subgraph cluster_renal {
    label="13. Renal Handling & Drug Disposition";
    style=filled; color="#cdd3b6"; fillcolor="#f2f4e7"; fontsize=13;
    GFR [label="GFR / renal function"];
    OAT13 [label="OAT1 / OAT3 tubular\nsecretion of PAGN,\nhippurate, PAA"];
    Probenecid [label="Probenecid / high-dose\npenicillins → OAT inhibition\n→ scavenger retention", fillcolor="#f3b0b0"];
    Renal_impair [label="Renal impairment →\nPAA accumulation →\nneurotoxicity risk", fillcolor="#f3b0b0"];
    Hepatic_impair [label="Hepatic impairment →\nslower PBA→PAA conversion\nAND slower PAA→PAGN\n→ ↑ PAA exposure"];
    Urea_excretion [label="Renal urea excretion\n(the physiological route)"];
    Corticosteroid_DDI [label="Corticosteroids →\nprotein catabolism →\nammonia rise", fillcolor="#f3b0b0"];
    Haloperidol_DDI [label="Haloperidol / valproate —\navoid or use with\nextreme caution", fillcolor="#f3b0b0"];
  }

  /* ======================================================================
     14. Hepatic and systemic involvement
     ====================================================================== */
  subgraph cluster_liver {
    label="14. Hepatic & Systemic Involvement";
    style=filled; color="#dcd0b8"; fillcolor="#f7f2e7"; fontsize=13;
    Hepatomegaly [label="Hepatomegaly"];
    Transaminitis [label="ALT / AST elevation\n(common in ASL, citrin,\nand during crises)"];
    Coagulopathy [label="Coagulopathy\n(factor synthesis ↓)"];
    Liver_fibrosis [label="Hepatic fibrosis\n(chronic ASL / citrin)"];
    GI_symptoms [label="Anorexia · vomiting ·\nprotein aversion"];
    Trichorrhexis [label="Trichorrhexis nodosa\n(ASL deficiency)"];
    Bone_health [label="Growth failure ·\nreduced bone density"];
  }

  /* ======================================================================
     15. Clinical endpoints and outcomes
     ====================================================================== */
  subgraph cluster_endpoints {
    label="15. Clinical Endpoints & Long-Term Outcomes";
    style=filled; color="#d6b8c4"; fillcolor="#f9ecf1"; fontsize=13;
    Crisis_rate [label="HYPERAMMONAEMIC CRISES\nper patient-year\n(the registered endpoint)", fillcolor="#eccfd9"];
    Coma_duration [label="Duration of neonatal\nhyperammonaemic coma (h)\n— strongest predictor\nof IQ", fillcolor="#eccfd9"];
    Neurocog [label="Neurocognitive outcome:\nfull-scale IQ · executive\nfunction · attention", fillcolor="#e3b6c6"];
    Dev_delay [label="Developmental delay /\nintellectual disability"];
    ADHD_pheno [label="ADHD-like inattention ·\nexecutive dysfunction\n(even in 'asymptomatic'\nheterozygotes)"];
    Motor_deficit [label="Motor deficit ·\nspasticity · ataxia"];
    Hospitalisation [label="Hospitalisation days /\nICU admissions"];
    Survival [label="Overall & transplant-free\nsurvival", fillcolor="#e3b6c6"];
    QoL [label="Quality of life ·\ncaregiver burden"];
    Diet_tolerance [label="Natural-protein tolerance\n(g/kg/day) — the practical\nmeasure of therapeutic\nheadroom", fillcolor="#eccfd9"];
  }

  /* ======================================================================
     16. Monitoring and biomarker panel
     ====================================================================== */
  subgraph cluster_monitor {
    label="16. Monitoring & Biomarker Panel";
    style=filled; color="#b8c9c0"; fillcolor="#eaf3ee"; fontsize=13;
    Mon_NH3 [label="Plasma ammonia\n(free-flowing, on ice,\n<15 min to assay)"];
    Mon_Gln [label="Plasma glutamine\n(early-warning:\nrises before ammonia)", fillcolor="#cfe5da"];
    Mon_AA [label="Quantitative plasma\namino acids (Cit, Arg,\nOrn, ASA, BCAA)"];
    Mon_orotate [label="Urine orotic acid"];
    Mon_UPAGN [label="Urinary PAGN\n(dose adequacy)"];
    Mon_PAA [label="Plasma PAA and\nPAA:PAGN ratio"];
    Mon_LFT [label="ALT/AST, albumin, INR"];
    Mon_MRS [label="1H-MR spectroscopy:\nGln↑ / mIns↓ signature"];
    Mon_EEG [label="EEG · neuroimaging"];
    Mon_growth [label="Growth, DEXA,\nnutritional panel"];
  }

  /* ======================================================================
     EDGES — 1. genotype to residual activity
     ====================================================================== */
  NAGS_gene -> Residual_activity;
  CPS1_gene -> Residual_activity;
  OTC_gene -> Residual_activity [penwidth=2];
  ASS1_gene -> Residual_activity;
  ASL_gene -> Residual_activity;
  ARG1_gene -> Residual_activity;
  ORNT1_gene -> Residual_activity;
  CITRIN_gene -> Residual_activity;
  Mut_class -> Residual_activity;
  OTC_gene -> Xinact;
  Xinact -> Residual_activity [label="hepatic mosaic\nfraction"];
