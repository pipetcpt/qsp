  /* EDGES — 6. glutamine trap */
  Plasma_NH4 -> Hepatocyte_perivenous;
  Hepatocyte_perivenous -> GS_liver;
  GS_liver -> Plasma_Gln;
  Plasma_NH4 -> Muscle_GS [penwidth=2];
  Muscle_GS -> Plasma_Gln [penwidth=2];
  Plasma_Glu -> Muscle_GS;
  Plasma_Gln -> Gln_reservoir;
