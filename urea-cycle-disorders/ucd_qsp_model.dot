  /* EDGES — 14. liver / systemic */
  Cycle_flux -> Hepatomegaly [style=dashed];
  ASL_enz -> Liver_fibrosis [style=dashed];
  AGC_citrin -> Liver_fibrosis [style=dashed];
  Plasma_NH4 -> Transaminitis [style=dashed];
  Transaminitis -> Coagulopathy;
  Transaminitis -> Mon_LFT;
  Coagulopathy -> Mon_LFT;
  ASL_enz -> Trichorrhexis [style=dashed];
  GI_symptoms -> Dietary_protein [arrowhead=tee, label="protein\naversion"];
  Growth_z -> Bone_health;
  Bone_health -> Mon_growth;
  Growth_z -> Mon_growth;

  /* EDGES — 15. endpoints */
  Plasma_NH4 -> Crisis_rate [penwidth=2, color="#b71c1c"];
