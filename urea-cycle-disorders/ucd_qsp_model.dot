  Plasma_Gln -> Plasma_NH4 [dir=both, style=dashed, label="buffer\nequilibrium"];
  PAA_plasma -> PAA_PAGN_ratio;
  PAGN -> PAA_PAGN_ratio;
  PAA_PAGN_ratio -> PAA_tox [color="#b71c1c"];
