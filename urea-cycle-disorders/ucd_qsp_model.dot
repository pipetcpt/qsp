  Arginine_hep -> Plasma_Arg;

  /* EDGES — 5. orotate */
  CP_overflow -> CAD_enzyme [penwidth=2];
  CAD_enzyme -> Carb_asp;
  Carb_asp -> Dihydroorotate;
