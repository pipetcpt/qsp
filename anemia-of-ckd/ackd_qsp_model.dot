digraph ACKD_QSP {
  rankdir=LR;
  fontname="Helvetica";
  labelloc="t";
  fontsize=20;
  label="Anemia of Chronic Kidney Disease (ACKD) — Mechanistic QSP Map\nNephron loss → REP-cell EPO deficiency + HIF-PHD oxygen sensing + hepcidin-driven functional iron deficiency → impaired erythropoiesis\nPharmacology: ESAs (epoetin / darbepoetin / MPG-epoetin beta) · HIF-PHIs (roxadustat / daprodustat / vadadustat) · oral & IV iron · hepcidin-axis agents";
  node [style=filled, fontname="Helvetica", fontsize=10, shape=box];
  edge [fontname="Helvetica", fontsize=8];
  newrank=true;
  nodesep=0.28;
  ranksep=0.85;

  /* ======================================================================
     1. CKD substrate — nephron loss and the fate of EPO-producing cells
     ====================================================================== */
  subgraph cluster_ckd {
    label="1. CKD Substrate: Nephron Loss & REP-Cell Transdifferentiation";
    style=filled; color="#d8c9b8"; fillcolor="#f5efe8"; fontsize=13;
    Primary_insult [label="Primary renal insult\n(DKD · HTN · GN · ADPKD)"];
    Nephron_loss [label="Nephron loss\n(eGFR decline)"];
    Hyperfiltration [label="Residual-nephron\nhyperfiltration"];
    Tubulointerstitial_fibrosis [label="Tubulointerstitial\nfibrosis"];
    Peritubular_capillary_loss [label="Peritubular capillary\nrarefaction"];
    REP_cells [label="REP cells\n(peritubular interstitial\nfibroblast-like, cortex)", fillcolor="#fbe8d3"];
    REP_transdifferentiation [label="REP → myofibroblast\ntransdifferentiation\n(TGF-β1 · PDGF)", fillcolor="#fbdcc0"];
    REP_pool_functional [label="Functional REP\ncell pool ↓", fillcolor="#f8cfa8"];
    Renal_O2_paradox [label="Cortical O2 paradox:\ntubular workload ↓\n→ relative normoxia\n(blunted hypoxic signal)"];
    Uremic_milieu [label="Uremic milieu\n(retention solutes)"];
    Dialysis_status [label="Dialysis modality\n(HD / PD / none)"];
    Residual_renal_function [label="Residual renal\nfunction"];
  }

  /* ======================================================================
     2. Oxygen sensing: the PHD-VHL-HIF axis (the HIF-PHI drug target)
     ====================================================================== */
  subgraph cluster_o2 {
    label="2. Oxygen Sensing: PHD–VHL–HIF Axis (HIF-PHI target)";
    style=filled; color="#c3d9ea"; fillcolor="#e9f3fa"; fontsize=13;
    Tissue_pO2 [label="Renal / hepatic\ntissue pO2"];
    O2_cosubstrate [label="O2 as PHD\nco-substrate"];
    TwoOG [label="2-oxoglutarate\n(α-KG)"];
    Fe2_cofactor [label="Fe(II) + ascorbate\nPHD cofactors"];
    Succinate_fumarate [label="Succinate / fumarate\n(competitive inhibitors)"];
    PHD1 [label="PHD1 / EGLN2"];
    PHD2 [label="PHD2 / EGLN1\n(dominant HIF-α regulator)", fillcolor="#cfe4f5"];
    PHD3 [label="PHD3 / EGLN3"];
    FIH1 [label="FIH-1 (asparaginyl\nhydroxylase, C-TAD)"];
    HIF1A [label="HIF-1α"];
    HIF2A [label="HIF-2α / EPAS1\n(the EPO-relevant isoform)", fillcolor="#cfe4f5"];
    Pro_hydroxylation [label="Pro402 / Pro564\nhydroxylation"];
    VHL_complex [label="pVHL–E3 ubiquitin\nligase complex"];
    Proteasome [label="26S proteasomal\ndegradation"];
    HIFB_ARNT [label="HIF-1β / ARNT"];
    HIF_dimer [label="HIF-α : ARNT\nheterodimer"];
    p300_CBP [label="p300 / CBP\ncoactivator"];
    HRE [label="Hypoxia-response\nelement (HRE)"];
    HIF_target_program [label="HIF transcriptional\nprogram", fillcolor="#cfe4f5"];
  }

  /* ======================================================================
     3. Erythropoietin production, transport and receptor signaling
     ====================================================================== */
  subgraph cluster_epo {
    label="3. Erythropoietin: Production & EPOR Signaling";
    style=filled; color="#e2c9dd"; fillcolor="#f8eef6"; fontsize=13;
    EPO_gene [label="EPO gene\n(3' HRE enhancer)"];
    Renal_EPO_synthesis [label="Renal EPO synthesis\n(REP cells, ~90%)", fillcolor="#f0d9ec"];
    Hepatic_EPO_synthesis [label="Hepatic EPO synthesis\n(HIF-2α, ~10%, inducible)"];
    GATA2_repression [label="GATA-2 / NF-κB\nEPO repression"];
    Plasma_EPO [label="Plasma EPO\n(mIU/mL)", fillcolor="#eccce6"];
    EPO_glycosylation [label="Sialylation / N-glycans\n→ half-life"];
    EPO_deficiency [label="Relative EPO deficiency\n(inappropriately normal\nEPO for Hb)", fillcolor="#e5b6da"];
    EPOR [label="EPOR homodimer\n(CFU-E / proerythroblast)"];
    EPOR_density [label="EPOR surface\ndensity"];
    JAK2 [label="JAK2\nautophosphorylation"];
    STAT5 [label="STAT5a/b"];
    PI3K_AKT [label="PI3K / AKT"];
    MAPK_ERK [label="RAS / MAPK-ERK"];
    BCLXL [label="BCL-xL\n(anti-apoptotic)"];
    GATA1_program [label="GATA-1 / KLF1\nerythroid program"];
    SOCS3 [label="SOCS3 / CIS\nnegative feedback"];
    EPO_receptor_clearance [label="Receptor-mediated\nEPO clearance (TMDD)"];
  }

  /* ======================================================================
     4. Bone-marrow erythropoiesis cascade
     ====================================================================== */
  subgraph cluster_ery {
    label="4. Bone-Marrow Erythropoiesis Cascade";
    style=filled; color="#e8b9b9"; fillcolor="#fbeeee"; fontsize=13;
    HSC [label="Haematopoietic\nstem cell"];
    CMP_MEP [label="CMP → MEP\ncommitment"];
    BFUE [label="BFU-E\n(SCF · IL-3 · GM-CSF)"];
    CFUE [label="CFU-E\n(maximal EPOR density)", fillcolor="#f7d6d6"];
    Proerythroblast [label="Proerythroblast"];
    Baso_EB [label="Basophilic\nerythroblast"];
    Poly_EB [label="Polychromatic\nerythroblast"];
    Ortho_EB [label="Orthochromatic\nerythroblast"];
    Enucleation [label="Enucleation\n(macrophage island)"];
    Marrow_reticulocyte [label="Marrow\nreticulocyte"];
    Blood_reticulocyte [label="Blood reticulocyte\n(RET %, CHr)", fillcolor="#f7d6d6"];
    Mature_RBC [label="Circulating RBC mass", fillcolor="#f2bcbc"];
    Marrow_apoptosis [label="Ineffective erythropoiesis\n(erythroblast apoptosis\nFAS/FASL)"];
    Marrow_fibrosis [label="Marrow fibrosis\n(severe SHPT / adynamic)"];
    Hb_synthesis [label="Haem + globin\nassembly (ALAS2 · HRI)"];
    RBC_lifespan [label="RBC lifespan\n(~115 d normal →\n~70-90 d in ESKD)", fillcolor="#f2bcbc"];
    Eryptosis [label="Eryptosis\n(PS exposure · Ca2+ ·\nceramide · oxidation)"];
    Blood_loss [label="Blood loss\n(HD circuit · GI · phlebotomy)"];
    Splenic_clearance [label="Splenic / hepatic\nRBC clearance"];
  }

  /* ======================================================================
     5. Systemic iron traffic
     ====================================================================== */
  subgraph cluster_iron {
    label="5. Systemic Iron Traffic";
    style=filled; color="#cfd8a8"; fillcolor="#f2f6e4"; fontsize=13;
    Dietary_iron [label="Dietary iron\n(haem / non-haem)"];
    DCYTB [label="DCYTB\n(Fe3+ → Fe2+)"];
    DMT1 [label="DMT1 / SLC11A2\napical uptake"];
    Enterocyte_pool [label="Enterocyte\nlabile iron pool"];
    Ferroportin_gut [label="Ferroportin (SLC40A1)\nbasolateral export", fillcolor="#e5eeca"];
    Hephaestin [label="Hephaestin /\nceruloplasmin ferroxidase"];
    Transferrin [label="Transferrin (TIBC)"];
    Fe_Tf [label="Transferrin-bound Fe\n(TSAT %)", fillcolor="#e5eeca"];
    TFR1 [label="TfR1-mediated\nerythroblast uptake"];
    Endosomal_STEAP3 [label="Endosome: STEAP3 +\nDMT1 release"];
    Mitochondrial_Fe [label="Mitochondrial Fe\n(MFRN1 · FECH)"];
    Macrophage_recycling [label="RE macrophage\nhaem recycling (HMOX1)"];
    Hepatocyte_store [label="Hepatocyte iron\nstore"];
    Serum_ferritin [label="Serum ferritin\n(store + acute-phase)", fillcolor="#e5eeca"];
    Functional_ID [label="Functional iron deficiency\n(store-replete, TSAT ↓)", fillcolor="#d3e0a3"];
    Absolute_ID [label="Absolute iron deficiency\n(ferritin ↓, TSAT ↓)"];
    NTBI [label="Non-transferrin-bound\niron (NTBI) / labile Fe"];
    Iron_overload [label="Iron overload\n(hepatic LIC ↑)"];
  }

  /* ======================================================================
     6. Hepcidin–ferroportin regulatory hub
     ====================================================================== */
  subgraph cluster_hepc {
    label="6. Hepcidin–Ferroportin Regulatory Hub";
    style=filled; color="#c9d6d6"; fillcolor="#eaf2f2"; fontsize=13;
    BMP6 [label="BMP6 / BMP2\n(LSEC-derived)"];
    HJV [label="Hemojuvelin (HFE2)\nBMP co-receptor"];
    ALK2_ALK3 [label="ALK2 / ALK3 +\nBMPR2"];
    SMAD158 [label="SMAD1/5/8\nphosphorylation"];
    SMAD4 [label="SMAD4"];
    BMP_RE [label="HAMP promoter\nBMP-RE1/2"];
    HFE_TFR2 [label="HFE / TfR2\niron-sensing"];
    TMPRSS6 [label="TMPRSS6 (matriptase-2)\ncleaves HJV"];
    IL6_STAT3 [label="IL-6 → gp130 →\nJAK1/2 → STAT3", fillcolor="#dbe8e8"];
    HAMP_gene [label="HAMP transcription"];
    Serum_hepcidin [label="Serum hepcidin-25", fillcolor="#c7dada"];
    Renal_hepcidin_clearance [label="Renal hepcidin\nclearance ↓ (CKD)", fillcolor="#c7dada"];
    Ferroportin_degradation [label="Ferroportin ubiquitination\n& lysosomal degradation"];
    ERFE [label="Erythroferrone (ERFE)\nfrom erythroblasts", fillcolor="#dbe8e8"];
    ERFE_BMP_trap [label="ERFE sequesters\nBMP2/6 → HAMP ↓"];
    Iron_sequestration [label="Macrophage & enterocyte\niron sequestration"];
  }

  /* ======================================================================
     7. Inflammation and ESA hyporesponsiveness
     ====================================================================== */
  subgraph cluster_inflam {
    label="7. Inflammation & ESA Hyporesponsiveness";
    style=filled; color="#e6c6a8"; fillcolor="#fbf0e6"; fontsize=13;
    Uremic_toxins [label="Uremic toxins\n(indoxyl sulfate ·\np-cresyl sulfate)"];
    Dialysis_bioincompat [label="Dialysis membrane\nbioincompatibility"];
    Gut_dysbiosis [label="Gut dysbiosis /\nendotoxin translocation"];
    Vascular_access_infection [label="Access infection /\noccult inflammation"];
    IL6 [label="IL-6", fillcolor="#f5dcc4"];
    TNFa [label="TNF-α"];
    IFNg [label="IFN-γ"];
    IL1b [label="IL-1β"];
    hsCRP [label="hs-CRP", fillcolor="#f5dcc4"];
    NFkB [label="NF-κB activation"];
    Oxidative_stress [label="Oxidative stress\n(ROS · MDA · AOPP)"];
    EPOR_signaling_block [label="EPOR / JAK2-STAT5\nsignal attenuation", fillcolor="#f0cba8"];
    Progenitor_suppression [label="Direct BFU-E / CFU-E\nsuppression"];
    ESA_resistance [label="ESA hyporesponsiveness\n(ERI ↑)", fillcolor="#e8b382"];
    Hyporesponse_phenotype [label="Inflammatory\nhyporesponsive phenotype"];
    PTH_excess [label="Secondary hyperparathyroidism\n(PTH ↑)"];
    Nutritional_deficit [label="B12 / folate deficiency ·\nprotein-energy wasting"];
    Carnitine_deficiency [label="Carnitine deficiency\n(HD)"];
    Aluminium_exposure [label="Aluminium / lead\nexposure (historical)"];
  }

  /* ======================================================================
     8. ESA pharmacology
     ====================================================================== */
  subgraph cluster_esa {
    label="8. ESA Pharmacology (epoetin · darbepoetin · MPG-epoetin beta)";
    style=filled; color="#b9cfe8"; fillcolor="#e8f0fa"; fontsize=13;
    Epoetin_dose [label="Epoetin alfa/beta\nIV or SC, TIW", shape=oval, fillcolor="#cfe0f5"];
    Darbepoetin_dose [label="Darbepoetin alfa\nQW / Q2W (hyperglycosylated)", shape=oval, fillcolor="#cfe0f5"];
    MPG_epoetin [label="Methoxy-PEG-epoetin beta\nQ2W / Q4W", shape=oval, fillcolor="#cfe0f5"];
    ESA_SC_depot [label="SC depot\n(flip-flop absorption)"];
    ESA_central [label="ESA central\ncompartment"];
    ESA_bioavailability [label="SC bioavailability\n(~20-40% epoetin)"];
    ESA_TMDD [label="Target-mediated\ndisposition (EPOR)"];
    ESA_halflife [label="t1/2: epoetin ~8h IV /\ndarbepoetin ~25h /\nMPG-epoetin ~130h"];
    ESA_EPOR_occupancy [label="EPOR occupancy →\nprogenitor survival ↑", fillcolor="#cfe0f5"];
    ESA_dose_escalation [label="Protocolised\ndose escalation"];
    ESA_ERFE_induction [label="ERFE induction →\nhepcidin ↓ → iron mobilisation"];
    ESA_iron_demand [label="Iron demand surge →\nfunctional ID unmasked", fillcolor="#b8cfea"];
  }

  /* ======================================================================
     9. HIF-PHI pharmacology
     ====================================================================== */
  subgraph cluster_phi {
    label="9. HIF-PHI Pharmacology (roxadustat · daprodustat · vadadustat · molidustat · enarodustat)";
    style=filled; color="#b9e0cf"; fillcolor="#e6f7ee"; fontsize=13;
    Roxadustat [label="Roxadustat\nPO TIW", shape=oval, fillcolor="#cdefdf"];
    Daprodustat [label="Daprodustat\nPO daily", shape=oval, fillcolor="#cdefdf"];
    Vadadustat [label="Vadadustat\nPO daily", shape=oval, fillcolor="#cdefdf"];
    Molidustat [label="Molidustat / enarodustat\nPO daily", shape=oval, fillcolor="#cdefdf"];
    PHI_absorption [label="GI absorption\n(phosphate-binder chelation ↓)"];
    PHI_central [label="PHI plasma\nconcentration"];
    PHI_protein_binding [label="High albumin binding\n(>98%)"];
    PHI_metabolism [label="CYP2C8 · UGT1A9 /\nOATP1B1 uptake"];
    PHI_PHD_inhibition [label="Competitive 2-OG-site\nPHD1/2/3 inhibition", fillcolor="#cdefdf"];
    PHI_HIF_stabilization [label="HIF-1α / HIF-2α\nstabilisation", fillcolor="#b3e6cf"];
    PHI_coordinated_program [label="Coordinated program:\nEPO ↑ + DMT1/DCYTB ↑ +\nTF ↑ + TFRC ↑ + hepcidin ↓", fillcolor="#b3e6cf"];
    PHI_hepatic_EPO [label="Hepatic EPO\nre-activation"];
    PHI_physiological_EPO [label="Near-physiological\nEPO peaks (vs ESA bolus)"];
    PHI_iron_mobilisation [label="Enhanced iron\nabsorption & mobilisation"];
    PHI_cholesterol [label="LDL-C / total-C ↓\n(HMGCR · IDOL · PCSK9 effects)"];
    PHI_off_target [label="Off-target HIF program\n(VEGF · glycolysis · EMT)"];
  }

  /* ======================================================================
     10. Iron therapy
     ====================================================================== */
  subgraph cluster_ferro {
    label="10. Iron Repletion Therapy";
    style=filled; color="#dcc9a8"; fillcolor="#f7f1e4"; fontsize=13;
    Oral_ferrous [label="Oral ferrous sulfate /\nfumarate / gluconate", shape=oval, fillcolor="#efe4cb"];
    Ferric_citrate [label="Ferric citrate\n(binder + iron source)", shape=oval, fillcolor="#efe4cb"];
    Sucrosomial_iron [label="Sucrosomial /\nferric maltol", shape=oval, fillcolor="#efe4cb"];
    IV_ferric_carboxymaltose [label="IV ferric\ncarboxymaltose", shape=oval, fillcolor="#efe4cb"];
    IV_iron_sucrose [label="IV iron sucrose /\nferric gluconate", shape=oval, fillcolor="#efe4cb"];
    IV_ferumoxytol [label="IV ferumoxytol /\nferric derisomaltose", shape=oval, fillcolor="#efe4cb"];
    Ferric_pyrophosphate [label="Ferric pyrophosphate citrate\n(dialysate delivery)", shape=oval, fillcolor="#efe4cb"];
    Oral_absorption_ceiling [label="Oral absorption ceiling\n(hepcidin-gated, ~2-5 mg/d)"];
    Oral_GI_intolerance [label="GI intolerance /\nadherence ↓"];
    IV_macrophage_processing [label="RE macrophage colloid\nprocessing → store"];
    Proactive_high_dose [label="Proactive high-dose IV iron\n(PIVOTAL strategy)", fillcolor="#e8d7b0"];
    Iron_dosing_targets [label="Targets: TSAT >20-30% ·\nferritin 200-500 ng/mL"];
  }

  /* ======================================================================
     11. Emerging & adjunct therapy
     ====================================================================== */
  subgraph cluster_adjunct {
    label="11. Emerging / Adjunct Interventions";
    style=filled; color="#cdc0e0"; fillcolor="#f0ecf8"; fontsize=13;
    Anti_hepcidin [label="Anti-hepcidin mAb /\nspiegelmer (lexaptepid)", shape=oval, fillcolor="#ded4ef"];
    Ferroportin_stabiliser [label="Ferroportin inhibitor /\nstabiliser (vamifeport)", shape=oval, fillcolor="#ded4ef"];
    Anti_BMP6 [label="Anti-BMP6 mAb", shape=oval, fillcolor="#ded4ef"];
    Anti_IL6 [label="Anti-IL-6 / anti-IL-6R\n(ziltivekimab · tocilizumab)", shape=oval, fillcolor="#ded4ef"];
    Vitamin_C_adjunct [label="IV ascorbate adjunct", shape=oval, fillcolor="#ded4ef"];
    Transfusion [label="RBC transfusion\n(rescue)", shape=oval, fillcolor="#ded4ef"];
    Alloimmunisation [label="Alloimmunisation /\ntransplant sensitisation"];
    Transfusion_iron_load [label="Transfusional\niron loading"];
    Nutrient_repletion [label="B12 / folate / carnitine\nrepletion", shape=oval, fillcolor="#ded4ef"];
    Calcimimetic [label="Calcimimetic (PTH ↓)", shape=oval, fillcolor="#ded4ef"];
  }

  /* ======================================================================
     12. Haemoglobin, oxygen delivery and physiological adaptation
     ====================================================================== */
  subgraph cluster_hb {
    label="12. Haemoglobin, O2 Delivery & Cardiac Adaptation";
    style=filled; color="#e8c9c9"; fillcolor="#fbeeee"; fontsize=13;
    Haemoglobin [label="Haemoglobin (g/dL)", fillcolor="#f2b6b6"];
    Haematocrit [label="Haematocrit / MCV / MCH"];
    Plasma_volume [label="Plasma volume /\nvolume overload dilution"];
    O2_carrying_capacity [label="Arterial O2\ncarrying capacity"];
    Tissue_O2_delivery [label="Tissue O2 delivery"];
    Cardiac_output_comp [label="Compensatory cardiac\noutput ↑ · SVR ↓"];
    LV_hypertrophy [label="LV hypertrophy\n(LVMI ↑)", fillcolor="#f2b6b6"];
    Diastolic_dysfunction [label="Diastolic dysfunction /\nHFpEF phenotype"];
    Myocardial_ischaemia [label="Myocardial O2\nsupply-demand mismatch"];
    Sympathetic_activation [label="Sympathetic /\nRAAS activation"];
    Anaemia_CKD_cardiac_triad [label="Cardio-renal-anaemia\nsyndrome triad", fillcolor="#eda0a0"];
    Hb_variability [label="Hb cycling / variability\n(dose-titration oscillation)", fillcolor="#f2b6b6"];
  }

  /* ======================================================================
     13. Clinical endpoints
     ====================================================================== */
  subgraph cluster_endpoints {
    label="13. Clinical Endpoints & Patient-Reported Outcomes";
    style=filled; color="#b8ddb8"; fillcolor="#e9f7e9"; fontsize=13;
    Hb_target_range [label="Hb in KDIGO target\n10-11.5 g/dL", shape=hexagon, fillcolor="#cdeccd"];
    Hb_response_rate [label="Hb response\n(≥1.0 g/dL rise)", shape=hexagon, fillcolor="#cdeccd"];
    Transfusion_avoidance [label="Transfusion avoidance", shape=hexagon, fillcolor="#cdeccd"];
    FACIT_fatigue [label="FACIT-Fatigue score", shape=hexagon, fillcolor="#cdeccd"];
    SF36_vitality [label="SF-36 vitality /\nKDQOL-36", shape=hexagon, fillcolor="#cdeccd"];
    Exercise_capacity [label="6-min walk /\nexercise tolerance", shape=hexagon, fillcolor="#cdeccd"];
    Hospitalisation [label="All-cause\nhospitalisation", shape=hexagon, fillcolor="#cdeccd"];
    MACE_endpoint [label="MACE / MACE+\n(death · MI · stroke · HF)", shape=hexagon, fillcolor="#cdeccd"];
    CKD_progression_endpoint [label="eGFR slope /\nESKD onset", shape=hexagon, fillcolor="#cdeccd"];
    Mortality [label="All-cause mortality", shape=hexagon, fillcolor="#cdeccd"];
    ESA_dose_endpoint [label="Monthly ESA dose /\nERI (U/kg per g/dL)", shape=hexagon, fillcolor="#cdeccd"];
  }

  /* ======================================================================
     14. Safety / adverse-outcome pathways
     ====================================================================== */
  subgraph cluster_safety {
    label="14. Safety & Adverse-Outcome Pathways";
    style=filled; color="#e8b8b8"; fillcolor="#fbe8e8"; fontsize=13;
    Hb_overshoot [label="Hb overshoot > 13 g/dL", fillcolor="#f5c9c9"];
    Blood_viscosity [label="Whole-blood\nviscosity ↑"];
    Platelet_activation [label="Platelet activation /\nreactive thrombocytosis"];
    Endothelial_dysfunction [label="Endothelial dysfunction\n(NO bioavailability ↓)"];
    Hypertension_ae [label="ESA-associated\nhypertension", fillcolor="#f5c9c9"];
    Thrombosis [label="Thrombosis: vascular access\nthrombosis · VTE · stroke", fillcolor="#f0a8a8"];
    Tumour_progression [label="Tumour progression risk\n(EPOR / HIF in malignancy)"];
    PRCA [label="Anti-EPO antibody\npure red-cell aplasia"];
    PHI_thrombosis_signal [label="HIF-PHI thrombotic /\nvascular-access signal"];
    PHI_pulm_HTN [label="Pulmonary hypertension\n(theoretical HIF-2α)"];
    PHI_retinal [label="Retinal / macular\nVEGF concern"];
    PHI_cyst_growth [label="Cyst growth /\nEMT concern (ADPKD)"];
    IV_iron_hypophosphataemia [label="FCM-induced FGF23 ↑\n→ hypophosphataemia", fillcolor="#f5c9c9"];
    IV_iron_hypersensitivity [label="IV iron hypersensitivity /\nFishbane reaction"];
    Oxidative_iron_injury [label="Labile-iron oxidative\ninjury · infection risk"];
    Iron_infection_risk [label="Bacterial siderophore\niron availability"];
  }

  /* ======================================================================
     15. Monitoring, biomarkers and titration policy
     ====================================================================== */
  subgraph cluster_monitor {
    label="15. Monitoring Biomarkers & Titration Policy";
    style=filled; color="#c9c9d8"; fillcolor="#eeeef5"; fontsize=13;
    Monitor_Hb [label="Hb q2-4 weeks\n(titration input)"];
    Monitor_TSAT_ferritin [label="TSAT + ferritin\nq1-3 months"];
    Monitor_retic [label="Reticulocyte count /\nRET-He"];
    Monitor_hepcidin [label="Hepcidin-25\n(research biomarker)"];
    Monitor_sTfR [label="Soluble TfR /\nZPP · %HYPO"];
    Monitor_CRP [label="hs-CRP\n(hyporesponse flag)"];
    Monitor_phosphate [label="Serum phosphate\n(post-IV-iron safety)"];
    Monitor_BP [label="Blood pressure"];
    Titration_algorithm [label="KDIGO-style titration:\nstart if Hb <10, hold if >11.5,\n±25% dose steps", fillcolor="#d8d8e8"];
    Hyporesponse_workup [label="Hyporesponse workup:\niron · inflammation · B12 ·\nPTH · haemolysis · PRCA"];
  }

  /* ======================================================================
     EDGES — CKD substrate
     ====================================================================== */
  Primary_insult -> Nephron_loss;
  Nephron_loss -> Hyperfiltration;
  Hyperfiltration -> Tubulointerstitial_fibrosis;
  Nephron_loss -> Tubulointerstitial_fibrosis;
  Tubulointerstitial_fibrosis -> Peritubular_capillary_loss;
  Tubulointerstitial_fibrosis -> REP_transdifferentiation;
  Peritubular_capillary_loss -> REP_cells [label="niche loss"];
  REP_cells -> REP_pool_functional;
  REP_transdifferentiation -> REP_pool_functional [label="−", color="#b03030"];
  Nephron_loss -> Renal_O2_paradox;
  Renal_O2_paradox -> Tissue_pO2 [label="relative\nnormoxia"];
  Nephron_loss -> Uremic_milieu;
  Uremic_milieu -> Uremic_toxins;
  Nephron_loss -> Dialysis_status;
  Dialysis_status -> Residual_renal_function [label="−", color="#b03030"];
  Dialysis_status -> Blood_loss;
  Dialysis_status -> Dialysis_bioincompat;
  Nephron_loss -> Renal_hepcidin_clearance [label="−", color="#b03030"];
  Nephron_loss -> CKD_progression_endpoint;

  /* EDGES — oxygen sensing */
  Tissue_pO2 -> O2_cosubstrate;
  O2_cosubstrate -> PHD2 [label="activates"];
  O2_cosubstrate -> PHD1;
  O2_cosubstrate -> PHD3;
  TwoOG -> PHD2 [label="co-substrate"];
  Fe2_cofactor -> PHD2;
  Succinate_fumarate -> PHD2 [label="−", color="#b03030"];
  PHD2 -> Pro_hydroxylation;
  PHD1 -> Pro_hydroxylation;
  PHD3 -> Pro_hydroxylation;
