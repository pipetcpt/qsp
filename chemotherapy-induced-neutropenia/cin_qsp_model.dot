/* ==========================================================================
   cin_qsp_model.dot
   Chemotherapy-Induced Neutropenia / Febrile Neutropenia (CIN/FN)
   Quantitative Systems Pharmacology mechanistic map

   Reading the map
   ---------------
   The spine runs down the middle: cytotoxic exposure -> DNA damage in the
   CYCLING granulocytic progenitors -> a DELAY LINE of maturation compartments
   -> circulating ANC -> loss of the neutrophil-dependent defence of a mucosal
   barrier the same drug has just breached -> febrile neutropenia -> dose
   delay/reduction -> loss of dose intensity -> tumour control.

   Two structural facts are drawn deliberately and everything clinically
   important follows from them:

   (1) The maturation chain is a PURE DELAY.  Its transit time sets WHEN the
       nadir happens; the drug exposure sets HOW DEEP it is.  The two are
       different parameters, so no intervention can move both in the same way.
       G-CSF acts almost entirely on the delay, its clearance, and
       redistribution -- NOT on the depth of the committed nadir.

   (2) Everything that raises the measured ANC is not the same as everything
       that restores host defence.  Corticosteroid demargination, G-CSF-driven
       release of the storage pool and G-CSF-driven prolongation of circulating
       survival all raise the number without adding marrow output, and
       neutrophil FUNCTION is drawn as its own state for that reason.

   Solid arrows = mass flow / activation.  Dashed = modulation.
   Red tee-heads = inhibition.  Blue = drug or intervention.

   Rendering:  dot -Tsvg cin_qsp_model.dot -o cin_qsp_model.svg
               dot -Tpng -Gdpi=150 cin_qsp_model.dot -o cin_qsp_model.png
   ========================================================================== */

digraph CIN_QSP {
    graph [rankdir=TB, splines=spline, overlap=false, nodesep=0.24, newrank=true,
           ranksep=0.52, fontname="Helvetica", fontsize=11, compound=true,
           bgcolor="white", labelloc="t", pad=0.4,
           label=<<b>Chemotherapy-Induced Neutropenia and Febrile Neutropenia — QSP Mechanistic Map</b><br/>
<font point-size="11">Cytotoxic exposure → cell-cycle-dependent kill of granulocytic progenitors → maturation DELAY LINE → ANC nadir<br/>
→ loss of defence at a drug-breached mucosal barrier → febrile neutropenia → dose delay / reduction → relative dose intensity → tumour control<br/>
<i>The transit time sets WHEN the nadir arrives; the exposure sets HOW DEEP it is. G-CSF moves the first, not the second.</i></font>>];

    node [shape=box, style="rounded,filled", fontname="Helvetica",
          fontsize=10, penwidth=1.1, margin="0.07,0.045"];
    edge [fontname="Helvetica", fontsize=8, arrowsize=0.65, penwidth=1.0,
          color="#5a5a5a"];

    /* ---------- colour conventions ---------- */
    /* drug / intervention        #cfe4ff  */
    /* PK compartment            #e8f0fb  */
    /* molecular signal          #fff2cc  */
    /* cell compartment          #e2f0d9  */
    /* pathology                 #fbd5d5  */
    /* clinical endpoint         #f4cccc  */
    /* readout / metric          #ede7f6  */
    /* covariate                 #eeeeee  */

/* ======================================================================== */
/* 1. CYTOTOXIC CHEMOTHERAPY PHARMACOKINETICS                               */
/* ======================================================================== */
subgraph cluster_pk {
    label=<<b>1. Cytotoxic PK — exposure is the only thing the drug contributes</b>>;
    style="rounded,filled"; fillcolor="#f2f7fd"; color="#7fa8d6"; fontsize=12;

    node [fillcolor="#cfe4ff"];
    DOCE   [label="Docetaxel\n75–100 mg/m² q3w\n1 h IV"];
    PACLI  [label="Paclitaxel\n175 q3w / 80 weekly\n3 h or 1 h IV"];
    DOXO   [label="Doxorubicin\n50–60 mg/m²\nIV bolus"];
    CYCLO  [label="Cyclophosphamide\n500–750 mg/m²"];
    CARBO  [label="Carboplatin\nAUC 5–6 (Calvert)"];
    CISPL  [label="Cisplatin\n75 mg/m²"];
    ETOP   [label="Etoposide\n100 mg/m² d1–3"];
    GEM    [label="Gemcitabine\n1000 mg/m² d1,8"];
    TOPO   [label="Topotecan\n1.5 mg/m² d1–5"];
    IRINO  [label="Irinotecan\n180–350 mg/m²"];
    FU     [label="5-Fluorouracil\ninfusional"];
    ANTHRA_LIPO [label="Pegylated liposomal\ndoxorubicin"];

    node [fillcolor="#e8f0fb"];
    PK_CENT  [label="Central compartment\nV1, C_plasma"];
    PK_PER1  [label="Peripheral 1\nrapid distribution"];
    PK_PER2  [label="Peripheral 2\ndeep tissue"];
    PK_CL    [label="Systemic clearance\nCL"];
    PK_HEP   [label="Hepatic metabolism\nCYP3A4 · CYP2B6 · CES"];
    PK_REN   [label="Renal excretion\nCL_R ≈ f(GFR)"];
    PK_BIL   [label="Biliary excretion"];
    ACT_CPA  [label="4-OH-cyclophosphamide\nactive alkylator"];
    ACT_SN38 [label="SN-38\nactive metabolite"];
    ACT_FDUMP[label="FdUMP / FUTP\nactive nucleotides"];
    ACT_DFDCTP [label="dFdCTP\nintracellular"];
    AUC      [label="AUC / Cmax /\ntime above threshold", fillcolor="#ede7f6"];

    DOCE -> PK_CENT; PACLI -> PK_CENT; DOXO -> PK_CENT; CARBO -> PK_CENT;
    CISPL -> PK_CENT; ETOP -> PK_CENT; TOPO -> PK_CENT; GEM -> PK_CENT;
    ANTHRA_LIPO -> PK_CENT [label="very long t½"];
    CYCLO -> PK_HEP -> ACT_CPA -> PK_CENT;
    IRINO -> PK_HEP; PK_HEP -> ACT_SN38 -> PK_CENT;
    FU -> ACT_FDUMP -> PK_CENT; GEM -> ACT_DFDCTP;
    PK_CENT -> PK_PER1 [dir=both]; PK_CENT -> PK_PER2 [dir=both];
    PK_CENT -> PK_CL; PK_CL -> PK_HEP; PK_CL -> PK_REN; PK_CL -> PK_BIL;
    PK_CENT -> AUC;
}

/* ======================================================================== */
/* 2. PHARMACOGENOMIC AND HOST DETERMINANTS OF EXPOSURE                     */
/* ======================================================================== */
subgraph cluster_pgx {
    label=<<b>2. Determinants of exposure — the same dose is not the same drug</b>>;
    style="rounded,filled"; fillcolor="#fafafa"; color="#999999"; fontsize=12;
    node [fillcolor="#eeeeee"];
    DPYD    [label="DPYD *2A / *13 / c.2846A>T\n→ 5-FU clearance ↓↓"];
    UGT1A1  [label="UGT1A1*28 / *6\n→ SN-38 exposure ↑"];
    CYP2B6  [label="CYP2B6 / CYP2C19\n→ 4-OH-CPA formation"];
    CYP3A4  [label="CYP3A4/5 activity\n+ inhibitors/inducers"];
    ABCB1   [label="ABCB1 / ABCG2\nefflux transporters"];
    TPMT    [label="TPMT / NUDT15\n(thiopurines)"];
    GFR_COV [label="Renal function\nGFR (Calvert, carboplatin)"];
    HEPFN   [label="Hepatic function\nbilirubin, transaminases"];
    ALB     [label="Albumin\n(docetaxel, unbound fraction)"];
    AGE     [label="Age ≥ 65 y"];
    BSA     [label="BSA / body composition\nsarcopenia"];
    PS      [label="Performance status\nECOG ≥ 2"];
    PRIOR   [label="Prior chemotherapy /\nradiotherapy to marrow"];
    BASEANC [label="Baseline ANC\nand ALC"];
    COMORB  [label="Comorbidity\n(COPD, diabetes, CVD)"];

    DPYD -> ACT_FDUMP [style=dashed, label="exposure ↑"];
    UGT1A1 -> ACT_SN38 [style=dashed]; CYP2B6 -> ACT_CPA [style=dashed];
    CYP3A4 -> PK_HEP [style=dashed]; ABCB1 -> PK_BIL [style=dashed];
    GFR_COV -> PK_REN [style=dashed]; HEPFN -> PK_HEP [style=dashed];
    ALB -> PK_CENT [style=dashed, label="f_u"];
    TPMT -> PK_CL [style=dashed];
    BSA -> PK_CL [style=dashed];
}

/* ======================================================================== */
/* 3. DNA DAMAGE AND THE CELL CYCLE IN THE PROGENITOR                       */
/* ======================================================================== */
subgraph cluster_cycle {
    label=<<b>3. Cell cycle and DNA damage — only CYCLING cells are killed, which is why G1 arrest protects</b>>;
    style="rounded,filled"; fillcolor="#fffdf3"; color="#d6b656"; fontsize=12;

    node [fillcolor="#fff2cc"];
    TOPO2   [label="Topoisomerase II\npoisoning (etoposide,\nanthracycline)"];
    TOPO1   [label="Topoisomerase I\ncleavage complex (SN-38,\ntopotecan)"];
    TUBUL   [label="β-tubulin / microtubule\nstabilisation (taxanes)"];
    ADDUCT  [label="Pt–DNA intrastrand\nadducts / crosslinks"];
    ALKYL   [label="DNA alkylation and\ninterstrand crosslinks"];
    ANTIMET [label="dNTP pool depletion /\nchain termination"];
    DSB     [label="DNA double-strand\nbreaks"];
    ATM     [label="ATM / ATR\nsensor kinases"];
    CHK     [label="CHK1 / CHK2"];
    P53     [label="p53 stabilisation"];
    P21     [label="p21^CIP1"];
    CDK46   [label="CDK4/6–cyclin D"];
    RB      [label="Rb phosphorylation"];
    E2F     [label="E2F target genes\nS-phase entry"];
    G0      [label="G0 quiescence"];
    G1      [label="G1"];
    SPHASE  [label="S phase"];
    G2M     [label="G2 / M"];
    MITCAT  [label="Mitotic catastrophe /\nspindle checkpoint"];
    APOP    [label="Intrinsic apoptosis\nBAX · PUMA · caspase-9"];
    SENESC  [label="Senescence / permanent\ngrowth arrest"];

    node [fillcolor="#cfe4ff"];
    TRILA   [label="Trilaciclib 240 mg/m²\nIV before each chemo dose\nCDK4/6 inhibitor"];

    ETOP -> TOPO2; DOXO -> TOPO2; TOPO -> TOPO1; ACT_SN38 -> TOPO1;
    DOCE -> TUBUL; PACLI -> TUBUL; CARBO -> ADDUCT; CISPL -> ADDUCT;
    ACT_CPA -> ALKYL; ACT_DFDCTP -> ANTIMET; ACT_FDUMP -> ANTIMET;
    TOPO2 -> DSB; TOPO1 -> DSB; ADDUCT -> DSB; ALKYL -> DSB; ANTIMET -> DSB;
    TUBUL -> MITCAT;
    DSB -> ATM -> CHK -> P53 -> P21;
    P21 -> CDK46 [arrowhead=tee, color="#cc0000"];
    CDK46 -> RB -> E2F -> SPHASE;
    G0 -> G1 [label="recruitment"]; G1 -> SPHASE -> G2M -> G1 [label="division"];
    G2M -> MITCAT [style=dashed];
    MITCAT -> APOP; P53 -> APOP; DSB -> APOP; P53 -> SENESC;
    TRILA -> CDK46 [arrowhead=tee, color="#cc0000", penwidth=1.8,
                    label="transient G1 arrest\nof HSPC"];
    SPHASE -> DSB [style=dashed, label="S-phase-specific\nagents act here"];
}

/* ======================================================================== */
/* 4. HAEMATOPOIETIC HIERARCHY AND THE MATURATION DELAY LINE                */
/* ======================================================================== */
subgraph cluster_marrow {
    label=<<b>4. Marrow — the maturation chain is a PURE DELAY (MTT ≈ 89 h); its length sets the nadir DAY</b>>;
    style="rounded,filled"; fillcolor="#f4faf0"; color="#7cab5a"; fontsize=12;

    node [fillcolor="#e2f0d9"];
    LTHSC   [label="LT-HSC\nquiescent, self-renewing\n(marrow reserve)"];
    STHSC   [label="ST-HSC / MPP"];
    CMP     [label="CMP"];
    GMP     [label="GMP\ngranulocyte–monocyte\nprogenitor"];
    MYBL    [label="Myeloblast"];
    PROMY   [label="Promyelocyte"];
    MYELO   [label="Myelocyte\nLAST DIVIDING STAGE"];
    METAMY  [label="Metamyelocyte\npost-mitotic"];
    BAND    [label="Band form"];
    SEGSTOR [label="Marrow storage pool\nsegmented neutrophils\n≈ 5–7 × blood pool"];
    NICHE   [label="Marrow niche\nCXCL12 · SCF · stromal\ncells · sinusoids"];
    ADIPO   [label="Marrow adiposity /\nage-related reserve loss"];
    FIBRO   [label="Irreversible marrow\ndamage (alkylator,\nradiotherapy)"];

    node [fillcolor="#ede7f6"];
    MTT     [label="MTT — mean transit time\nProl → circulating\nSETS THE NADIR DAY"];
    AMPLIF  [label="Mitotic amplification\n≈ 2⁵ divisions\n→ φ = 2⁻⁵ of the flux\nenters from upstream"];

    LTHSC -> STHSC -> CMP -> GMP -> MYBL -> PROMY -> MYELO -> METAMY
          -> BAND -> SEGSTOR;
    LTHSC -> LTHSC [label="self-renewal\n(slow, weeks)"];
    NICHE -> LTHSC [style=dashed]; ADIPO -> NICHE [style=dashed];
    FIBRO -> LTHSC [arrowhead=tee, color="#cc0000", style=dashed];
    MYBL -> MTT [style=dashed]; PROMY -> MTT [style=dashed];
    MYELO -> AMPLIF [style=dashed]; GMP -> AMPLIF [style=dashed];
    APOP -> GMP  [arrowhead=tee, color="#cc0000"];
    APOP -> MYBL [arrowhead=tee, color="#cc0000"];
    APOP -> PROMY[arrowhead=tee, color="#cc0000"];
    APOP -> MYELO[arrowhead=tee, color="#cc0000", penwidth=1.6,
                  label="the kill happens\nHERE, on day 0–2"];
    APOP -> LTHSC [arrowhead=tee, color="#cc0000", style=dashed,
                   label="small cycling\nfraction only"];
    SENESC -> FIBRO [style=dashed];
    G0 -> LTHSC [style=dashed]; SPHASE -> MYELO [style=dashed];
}

/* ======================================================================== */
/* 5. NEUTROPHIL KINETICS IN BLOOD AND TISSUE                               */
/* ======================================================================== */
subgraph cluster_kinetics {
    label=<<b>5. Blood and tissue kinetics — three pools, and only one of them is measured</b>>;
    style="rounded,filled"; fillcolor="#f4faf0"; color="#7cab5a"; fontsize=12;

    node [fillcolor="#e2f0d9"];
    CIRC    [label="CIRCULATING pool\nANC — the measured number\nt½ ≈ 7 h", penwidth=2.2];
    MARG    [label="MARGINATED pool\npulmonary/splenic\n≈ equal to circulating"];
    TISSUE  [label="Tissue / transmigrated\nneutrophils"];
    NAPOP   [label="Neutrophil apoptosis\nand clearance by\nmacrophages"];
    CXCR4   [label="CXCR4 — marrow\nRETENTION signal"];
    CXCR2   [label="CXCR2 — marrow\nRELEASE signal"];
    SELECT  [label="Endothelial selectins /\nβ2-integrins (CD11b/CD18)"];
    NEUTLIFE[label="Circulating survival\n(anti-apoptotic signalling)"];

    SEGSTOR -> CIRC [penwidth=1.8, label="baseline egress\n+ G-CSF-driven release"];
    CIRC -> MARG [dir=both, label="margination /\ndemargination"];
    CIRC -> TISSUE [label="transmigration"];
    CIRC -> NAPOP; TISSUE -> NAPOP;
    CXCR4 -> SEGSTOR [arrowhead=tee, color="#cc0000", style=dashed,
                      label="retention"];
    CXCR2 -> SEGSTOR [style=dashed, label="release"];
    SELECT -> MARG [style=dashed];
    NEUTLIFE -> NAPOP [arrowhead=tee, color="#cc0000", style=dashed];
}

/* ======================================================================== */
/* 6. NEUTROPHIL FUNCTION — A SEPARATE STATE FROM NEUTROPHIL COUNT          */
/* ======================================================================== */
subgraph cluster_function {
    label=<<b>6. Neutrophil FUNCTION — a separate state, because the count can rise while defence falls</b>>;
    style="rounded,filled"; fillcolor="#fff6f6"; color="#c98b8b"; fontsize=12;

    node [fillcolor="#fff2cc"];
    CHEMOTAX [label="Chemotaxis\nfMLP / IL-8 / C5a\nresponsiveness"];
    PHAGO    [label="Phagocytosis\nFcγR · CR3 opsonic uptake"];
    BURST    [label="NADPH oxidase burst\nsuperoxide · HOCl"];
    GRANULE  [label="Granule content\nMPO · elastase ·\nlactoferrin · defensins"];
    NETS     [label="NET formation\nPAD4 · citrullinated H3"];
    FUNCSTATE[label="FUNCTIONAL CAPACITY\n(effective ANC = count × function)",
              fillcolor="#f4cccc", penwidth=2.0];
    LEFTSHIFT[label="Left shift — bands and\nmetamyelocytes released\nearly, less competent"];

    CIRC -> FUNCSTATE [penwidth=1.6];
    CHEMOTAX -> FUNCSTATE; PHAGO -> FUNCSTATE; BURST -> FUNCSTATE;
    GRANULE -> PHAGO; NETS -> FUNCSTATE [style=dashed];
    LEFTSHIFT -> FUNCSTATE [arrowhead=tee, color="#cc0000", style=dashed];
    BAND -> LEFTSHIFT [style=dashed];
}

/* ======================================================================== */
/* 7. G-CSF AXIS — INCLUDING CLEARANCE BY THE CELLS IT CREATES              */
/* ======================================================================== */
subgraph cluster_gcsf {
    label=<<b>7. G-CSF axis — target-mediated clearance makes the drug's own half-life a function of the ANC it produced</b>>;
    style="rounded,filled"; fillcolor="#f2f7fd"; color="#7fa8d6"; fontsize=12;

    node [fillcolor="#cfe4ff"];
    FILG    [label="Filgrastim 5 µg/kg SC\ndaily from 24–72 h\nt½ ≈ 3.5 h"];
    PEGFIL  [label="Pegfilgrastim 6 mg SC\nONE fixed dose per cycle\nt½ 15–80 h, ANC-dependent",
             penwidth=1.9];
    LIPEG   [label="Lipegfilgrastim /\nefbemalenograstim /\neflapegrastim"];
    BIOSIM  [label="Filgrastim & pegfilgrastim\nbiosimilars"];
    ONBODY  [label="On-body injector\n(delayed delivery d+1)"];

    node [fillcolor="#e8f0fb"];
    GDEP    [label="SC depot\nflip-flop absorption\n(ka rate-limiting for peg)"];
    GCENT   [label="G-CSF central\nC_G (ng/mL)"];
    GREN    [label="Renal clearance\nabolished by PEGylation"];
    GTMDD   [label="TARGET-MEDIATED clearance\nVmax·C/(Km+C) × receptor pool\nNEGATIVE FEEDBACK", penwidth=1.9,
             fillcolor="#ffe0cc"];

    node [fillcolor="#fff2cc"];
    ENDOG   [label="Endogenous G-CSF\n(rises during neutropenia)"];
    CSF3R   [label="G-CSFR / CSF3R\non progenitors and\nmature neutrophils"];
    JAK2    [label="JAK2"];
    STAT3   [label="STAT3 / STAT5"];
    PI3K    [label="PI3K–AKT\n(anti-apoptotic)"];
    ERK     [label="RAS–ERK\n(proliferation)"];
    GACT1   [label="ACTION 1 — proliferation rate ↑\n(BOUNDED: gain > 1/(1−φ)\nwould be unstable)"];
    GACT2   [label="ACTION 2 — marrow transit\ntime ↓ (MTT 89 h → ~22 h)\nMOVES THE DELAY"];
    GACT3   [label="ACTION 3 — storage pool\nRELEASED (CXCR2 ↑, CXCR4 ↓)"];
    GACT4   [label="ACTION 4 — circulating\nsurvival ↑ (apoptosis ↓)"];
    GACT5   [label="ACTION 5 — demargination"];

    FILG -> GDEP; PEGFIL -> GDEP; LIPEG -> GDEP; BIOSIM -> GDEP;
    ONBODY -> GDEP [style=dashed];
    GDEP -> GCENT; GCENT -> GREN; GCENT -> GTMDD;
    ENDOG -> GCENT [style=dashed];
    GCENT -> CSF3R -> JAK2 -> STAT3;
    JAK2 -> PI3K; JAK2 -> ERK;
    ERK -> GACT1; STAT3 -> GACT2; STAT3 -> GACT3; PI3K -> GACT4;
    STAT3 -> GACT5;
    GACT1 -> MYELO [label="modest"];
    GACT2 -> MTT [arrowhead=tee, color="#cc0000", penwidth=1.8];
    GACT3 -> CXCR2; GACT3 -> CXCR4 [arrowhead=tee, color="#cc0000"];
    GACT4 -> NEUTLIFE [penwidth=1.6];
    GACT5 -> MARG [arrowhead=tee, color="#cc0000"];
    CIRC -> GTMDD [style=dashed, penwidth=1.8, color="#b45f06",
                   label="the ANC clears the drug"];
    SEGSTOR -> GTMDD [style=dashed, color="#b45f06"];
    CIRC -> ENDOG [arrowhead=tee, color="#cc0000", style=dashed];
}

/* ======================================================================== */
/* 8. G-CSF SAFETY AND LIMITS                                               */
/* ======================================================================== */
subgraph cluster_gcsfsafety {
    label=<<b>8. G-CSF — what it costs</b>>;
    style="rounded,filled"; fillcolor="#fff6f6"; color="#c98b8b"; fontsize=12;
    node [fillcolor="#fbd5d5"];
    BONEPAIN [label="Bone pain\n(20–60%, marrow expansion)"];
    SPLEEN   [label="Splenic enlargement /\nrupture (rare)"];
    CAPLEAK  [label="Capillary leak syndrome"];
    ARDSG    [label="Pulmonary toxicity /\nARDS (rare)"];
    MDSAML   [label="Secondary MDS / AML\n(alkylator + G-CSF debate)"];
    SICKLE   [label="Sickle cell crisis\n(contraindication)"];
    SAMEDAY  [label="SAME-DAY dosing hazard —\nexpanded cycling progenitors\nexposed to residual drug",
              penwidth=1.8];
    COSTG    [label="Cost / injection burden"];

    GACT1 -> BONEPAIN [style=dashed]; GCENT -> SPLEEN [style=dashed];
    GCENT -> CAPLEAK [style=dashed]; GCENT -> ARDSG [style=dashed];
    GCENT -> MDSAML [style=dashed]; GCENT -> SICKLE [style=dashed];
    GACT1 -> SAMEDAY [style=dashed];
    SAMEDAY -> APOP [penwidth=1.6, label="more cells in cycle\nwhen drug is still present"];
    PEGFIL -> COSTG [style=dashed];
}

/* ======================================================================== */
/* 9. MEGAKARYOCYTE / PLATELET LINEAGE                                      */
/* ======================================================================== */
subgraph cluster_plt {
    label=<<b>9. Platelet lineage — the SAME insult, a different clock (MTT ≈ 200 h)</b>>;
    style="rounded,filled"; fillcolor="#f4faf0"; color="#7cab5a"; fontsize=12;

    node [fillcolor="#e2f0d9"];
    MEP    [label="MEP\nmegakaryocyte–erythroid\nprogenitor"];
    MKPROG [label="Megakaryoblast /\npromegakaryocyte"];
    MKPOLY [label="Polyploid megakaryocyte\nendomitosis"];
    PROPLT [label="Proplatelet formation"];
    PLTC   [label="Circulating platelets\nlifespan ≈ 10 d", penwidth=1.6];
    node [fillcolor="#fff2cc"];
    TPO    [label="Thrombopoietin (TPO)"];
    MPL    [label="c-Mpl receptor —\nplatelet-mediated\nTPO clearance"];
    node [fillcolor="#cfe4ff"];
    ROMI   [label="Romiplostim /\neltrombopag / avatrombopag"];
    PLTTX  [label="Platelet transfusion\n(threshold 10 ×10⁹/L)"];
    node [fillcolor="#fbd5d5"];
    BLEED  [label="Bleeding / grade 3–4\nthrombocytopenia"];
    PLTDLT [label="Platelet nadir is the\nDOSE-LIMITING toxicity of\ncarboplatin and gemcitabine"];

    CMP -> MEP -> MKPROG -> MKPOLY -> PROPLT -> PLTC;
    LTHSC -> MEP [style=dashed];
    TPO -> MPL -> MKPROG [style=dashed];
    PLTC -> MPL [style=dashed, color="#b45f06",
                 label="same target-mediated trick,\none lineage over"];
    ROMI -> MPL; PLTTX -> PLTC;
    APOP -> MKPROG [arrowhead=tee, color="#cc0000"];
    PLTC -> BLEED [arrowhead=tee, color="#cc0000"];
    CARBO -> PLTDLT [style=dashed]; GEM -> PLTDLT [style=dashed];
    PLTDLT -> PLTC [style=dashed];
}

/* ======================================================================== */
/* 10. ERYTHROID LINEAGE                                                    */
/* ======================================================================== */
subgraph cluster_ery {
    label=<<b>10. Erythroid lineage — slowest clock of all, so anaemia is CUMULATIVE across cycles</b>>;
    style="rounded,filled"; fillcolor="#f4faf0"; color="#7cab5a"; fontsize=12;

    node [fillcolor="#e2f0d9"];
    BFUE   [label="BFU-E / CFU-E"];
    ERYBL  [label="Erythroblast\n(basophilic → orthochromatic)"];
    RETIC  [label="Reticulocyte"];
    RBCC   [label="Circulating RBC / Hb\nlifespan ≈ 120 d"];
    node [fillcolor="#fff2cc"];
    EPO    [label="Erythropoietin\n(renal, hypoxia-driven)"];
    HEPC   [label="Hepcidin ↑\nfunctional iron restriction"];
    IRON   [label="Iron availability /\nTSAT · ferritin"];
    node [fillcolor="#cfe4ff"];
    ESA    [label="Epoetin / darbepoetin"];
    IVFE   [label="IV iron"];
    RBCTX  [label="RBC transfusion"];
    node [fillcolor="#fbd5d5"];
    ANEMIA [label="Chemotherapy-induced\nanaemia · fatigue"];

    CMP -> BFUE -> ERYBL -> RETIC -> RBCC;
    MEP -> BFUE [style=dashed];
    EPO -> ERYBL [style=dashed]; ESA -> EPO; IVFE -> IRON -> ERYBL [style=dashed];
    HEPC -> IRON [arrowhead=tee, color="#cc0000", style=dashed];
    APOP -> ERYBL [arrowhead=tee, color="#cc0000"];
    RBCC -> ANEMIA [arrowhead=tee, color="#cc0000"]; RBCTX -> RBCC;
}

/* ======================================================================== */
/* 11. MUCOSAL BARRIER INJURY — THE OTHER HALF OF THE INFECTION RISK        */
/* ======================================================================== */
subgraph cluster_mucosa {
    label=<<b>11. Mucosal barrier injury — the same drug that removes the defence also opens the door</b>>;
    style="rounded,filled"; fillcolor="#fff6f6"; color="#c98b8b"; fontsize=12;

    node [fillcolor="#fff2cc"];
    CRYPT   [label="Intestinal crypt stem cells\n(rapid turnover, 3–5 d)"];
    ROS_MUC [label="ROS generation in\nsubmucosa"];
    NFKB_M  [label="NF-κB activation"];
    CERAM   [label="Ceramide / sphingomyelinase\napoptotic signalling"];
    TNFM    [label="TNF-α · IL-1β · IL-6\nlocal amplification"];
    MMP     [label="MMP-3 / MMP-9\nbasement membrane"];
    node [fillcolor="#fbd5d5"];
    OMUC    [label="Oral mucositis\n(WHO grade 1–4)"];
    GIMUC   [label="Gastrointestinal mucositis\ndiarrhoea"];
    BARRIER [label="BARRIER INTEGRITY LOST\ntight junctions, villous\natrophy", penwidth=2.0];
    node [fillcolor="#cfe4ff"];
    PALIF   [label="Palifermin (KGF)\ncryotherapy · photobiomodulation"];
    GLUTAM  [label="Oral care · glutamine\n(supportive)"];

    PK_CENT -> CRYPT [style=dashed, label="exposure"];
    CRYPT -> BARRIER [arrowhead=tee, color="#cc0000"];
    ROS_MUC -> NFKB_M -> TNFM -> MMP -> BARRIER;
    CERAM -> CRYPT [arrowhead=tee, color="#cc0000"];
    APOP -> CRYPT [arrowhead=tee, color="#cc0000"];
    BARRIER -> OMUC; BARRIER -> GIMUC;
    PALIF -> CRYPT; GLUTAM -> BARRIER [style=dashed];
    FU -> CERAM [style=dashed]; ACT_SN38 -> CRYPT [style=dashed];
    DOXO -> ROS_MUC [style=dashed];
}

/* ======================================================================== */
/* 12. MICROBIAL TRANSLOCATION AND INFECTION                                */
/* ======================================================================== */
subgraph cluster_infection {
    label=<<b>12. Translocation and infection — a race between bacterial growth and a defence that has been removed</b>>;
    style="rounded,filled"; fillcolor="#fff6f6"; color="#c98b8b"; fontsize=12;

    node [fillcolor="#fbd5d5"];
    MICROB  [label="Gut microbiome\ndysbiosis, loss of\nanaerobe diversity"];
    TRANSL  [label="Bacterial translocation\nacross the breached barrier",
             penwidth=1.8];
    GNEG    [label="Gram-negative bacilli\nE. coli · Klebsiella ·\nPseudomonas"];
    GPOS    [label="Gram-positive\ncoagulase-negative staph ·\nviridans streptococci"];
    CVC     [label="Central venous catheter\nbiofilm"];
    CANDIDA [label="Candida / invasive\naspergillosis (prolonged\nneutropenia)"];
    CDIFF   [label="Clostridioides difficile"];
    BACTLOAD[label="TISSUE / BLOODSTREAM\nBACTERIAL LOAD\ndB/dt = growth + influx − ANC-dependent kill",
             penwidth=2.2, fillcolor="#f4a6a6"];
    BSI     [label="Bloodstream infection /\nbacteraemia"];

    BARRIER -> TRANSL [penwidth=1.8];
    MICROB -> TRANSL [style=dashed]; CVC -> BACTLOAD [style=dashed];
    TRANSL -> BACTLOAD [penwidth=1.8];
    GNEG -> BACTLOAD; GPOS -> BACTLOAD; CANDIDA -> BACTLOAD;
    FUNCSTATE -> BACTLOAD [arrowhead=tee, color="#cc0000", penwidth=2.2,
                           label="the ONLY brake, and it\nis proportional to\nCOUNT × FUNCTION"];
    BACTLOAD -> BSI; CDIFF -> GIMUC [style=dashed];
    BACTLOAD -> CIRC [arrowhead=tee, color="#cc0000", style=dashed,
                      label="consumption at\nthe site"];
}

/* ======================================================================== */
/* 13. INNATE IMMUNE RESPONSE AND FEVER                                     */
/* ======================================================================== */
subgraph cluster_fever {
    label=<<b>13. Fever — the readout is inflammation, so a neutropenic patient can be septic and afebrile</b>>;
    style="rounded,filled"; fillcolor="#fffdf3"; color="#d6b656"; fontsize=12;

    node [fillcolor="#fff2cc"];
    LPS     [label="LPS / PAMPs"];
    TLR4    [label="TLR4 – MD2 – CD14"];
    MYD88   [label="MyD88 / TRIF"];
    NFKB_S  [label="NF-κB (systemic)"];
    INFLAM  [label="NLRP3 inflammasome →\nIL-1β maturation"];
    IL6     [label="IL-6"];
    TNFA    [label="TNF-α"];
    PGE2    [label="PGE2 in the\norganum vasculosum"];
    HYPOTH  [label="Hypothalamic\nthermoregulatory set-point ↑"];
    TEMPN   [label="Core temperature\n≥ 38.3 °C once, or ≥ 38.0 °C\nfor 1 h", fillcolor="#f4cccc",
             penwidth=1.8];
    CRPN    [label="CRP (t½ ≈ 50 h)"];
    PCT     [label="Procalcitonin"];
    LACT    [label="Lactate / organ\ndysfunction (qSOFA)"];
    BLUNT   [label="BLUNTED response —\nfew neutrophils to make\npus or to signal", penwidth=1.6,
             fillcolor="#f4cccc"];

    BACTLOAD -> LPS -> TLR4 -> MYD88 -> NFKB_S;
    NFKB_S -> IL6; NFKB_S -> TNFA; NFKB_S -> INFLAM;
    INFLAM -> IL6 [style=dashed];
    IL6 -> PGE2 -> HYPOTH -> TEMPN;
    IL6 -> CRPN; IL6 -> PCT; TNFA -> LACT;
    CIRC -> BLUNT [arrowhead=tee, color="#cc0000", style=dashed];
    BLUNT -> TEMPN [arrowhead=tee, color="#cc0000", style=dashed,
                    label="localising signs absent"];
}

/* ======================================================================== */
/* 14. CORTICOSTEROID — RAISES THE NUMBER, LOWERS THE DEFENCE               */
/* ======================================================================== */
subgraph cluster_steroid {
    label=<<b>14. Corticosteroid — the clearest case of the count and the defence moving in opposite directions</b>>;
    style="rounded,filled"; fillcolor="#f2f7fd"; color="#7fa8d6"; fontsize=12;
    node [fillcolor="#cfe4ff"];
    DEXA    [label="Dexamethasone 8 mg BID\n(taxane premedication,\nantiemetic)"];
    node [fillcolor="#fff2cc"];
    GR      [label="Glucocorticoid receptor\n– GRE transcription"];
    DEMARG  [label="Demargination —\nCD62L / β2-integrin ↓"];
    STORREL [label="Storage-pool release"];
    APOPDEL [label="Neutrophil apoptosis\ndelayed"];
    FUNCDOWN[label="Chemotaxis and oxidative\nburst SUPPRESSED"];
    node [fillcolor="#f4cccc"];
    FALSEANC[label="ANC RISES 1–3 ×10⁹/L\nwhile host defence FALLS\n→ the day-1 CBC gate passes a\nfunctionally neutropenic patient",
             penwidth=2.0];

    DEXA -> GR; GR -> DEMARG; GR -> STORREL; GR -> APOPDEL; GR -> FUNCDOWN;
    DEMARG -> MARG [arrowhead=tee, color="#cc0000"];
    DEMARG -> CIRC [penwidth=1.4]; STORREL -> CIRC;
    APOPDEL -> NAPOP [arrowhead=tee, color="#cc0000"];
    FUNCDOWN -> BURST [arrowhead=tee, color="#cc0000"];
    FUNCDOWN -> CHEMOTAX [arrowhead=tee, color="#cc0000"];
    CIRC -> FALSEANC [style=dashed]; FUNCDOWN -> FALSEANC [style=dashed];
}

/* ======================================================================== */
/* 15. ANTIMICROBIAL PROPHYLAXIS AND TREATMENT                              */
/* ======================================================================== */
subgraph cluster_abx {
    label=<<b>15. Antimicrobials — acting on the pathogen side of the same race</b>>;
    style="rounded,filled"; fillcolor="#f2f7fd"; color="#7fa8d6"; fontsize=12;
    node [fillcolor="#cfe4ff"];
    FQ      [label="Levofloxacin 500 mg PO daily\nprophylaxis (expected\nANC < 0.1 for > 7 d)"];
    AZOLE   [label="Fluconazole / posaconazole\nantifungal prophylaxis"];
    AVIR    [label="Aciclovir prophylaxis"];
    EMPIR   [label="Empirical anti-pseudomonal\nβ-lactam within 1 h\n(pip-tazo / cefepime /\nmeropenem)"];
    ADDVAN  [label="Vancomycin (added for\nline infection, MRSA, shock)"];
    GNEGRES [label="ESBL / carbapenemase\nresistance"];
    node [fillcolor="#ede7f6"];
    MASCC   [label="MASCC score ≥ 21 /\nCISNE → low risk,\noral or outpatient therapy"];

    FQ -> TRANSL [arrowhead=tee, color="#cc0000"];
    FQ -> BACTLOAD [arrowhead=tee, color="#cc0000"];
    AZOLE -> CANDIDA [arrowhead=tee, color="#cc0000"];
    EMPIR -> BACTLOAD [arrowhead=tee, color="#cc0000", penwidth=1.6];
    ADDVAN -> GPOS [arrowhead=tee, color="#cc0000"];
    GNEGRES -> EMPIR [arrowhead=tee, color="#cc0000", style=dashed];
    FQ -> GNEGRES [style=dashed, label="selection pressure"];
    FQ -> CDIFF [style=dashed];
}

/* ======================================================================== */
/* 16. CLINICAL ENDPOINTS                                                   */
/* ======================================================================== */
subgraph cluster_endpoints {
    label=<<b>16. Clinical endpoints — note that the driver is the INTEGRAL, not the minimum</b>>;
    style="rounded,filled"; fillcolor="#fdf2f2"; color="#c0504d"; fontsize=12;

    node [fillcolor="#ede7f6"];
    NADIR   [label="ANC NADIR\n(the minimum)"];
    NADIRDAY[label="Nadir DAY\n= f(MTT) only"];
    DSN     [label="DSN / DAN — DURATION of\nANC < 0.5 ×10⁹/L\nTHE ACTUAL DRIVER", penwidth=2.2];
    AUCBELOW[label="Area BELOW the ANC\nthreshold (depth × time)"];
    node [fillcolor="#f4cccc"];
    FN      [label="FEBRILE NEUTROPENIA\nANC < 0.5 + T ≥ 38.3 °C", penwidth=2.4];
    HOSP    [label="Hospitalisation"];
    IVABX   [label="IV anti-infective use"];
    SEPSIS  [label="Sepsis / septic shock"];
    ICU     [label="ICU admission"];
    DEATH   [label="Infection-related mortality\n(≈ 5–10% of FN episodes)"];
    DELAY   [label="Cycle DELAY\n(ANC < 1.5 on day 1)"];
    REDUCE  [label="Dose REDUCTION\n20–25%"];
    DISCONT [label="Treatment discontinuation"];
    QOL     [label="Fatigue · quality of life ·\ncost of care"];

    CIRC -> NADIR; MTT -> NADIRDAY [penwidth=1.8];
    NADIR -> AUCBELOW; DSN -> AUCBELOW;
    CIRC -> DSN [penwidth=1.8];
    AUCBELOW -> FN [penwidth=2.0, label="hazard ∝ ∫depth^p dt"];
    BACTLOAD -> FN [penwidth=1.6]; TEMPN -> FN [penwidth=1.6];
    FN -> HOSP -> IVABX; FN -> SEPSIS -> ICU -> DEATH;
    FN -> DELAY; FN -> REDUCE; DELAY -> DISCONT; REDUCE -> DISCONT;
    FN -> QOL; ANEMIA -> QOL; BLEED -> HOSP;
    OMUC -> QOL;
}

/* ======================================================================== */
/* 17. DOSE INTENSITY AND TUMOUR CONTROL — THE ACTUAL DECISION              */
/* ======================================================================== */
subgraph cluster_tumour {
    label=<<b>17. Dose intensity and tumour control — the loop that makes this a decision rather than a toxicity</b>>;
    style="rounded,filled"; fillcolor="#f5f0fa"; color="#8e7cc3"; fontsize=12;

    node [fillcolor="#ede7f6"];
    RDI     [label="RELATIVE DOSE INTENSITY\ndelivered / planned mg/m²/wk",
             penwidth=2.2];
    DELIVER [label="Delivered dose per cycle"];
    ONTIME  [label="On-time delivery\n(cycle interval)"];
    node [fillcolor="#e2f0d9"];
    TUMS    [label="Drug-sensitive tumour\nclone"];
    TUMR    [label="Drug-resistant clone\n(pre-existing, expands\nbetween cycles)"];
    REGROW  [label="Interval regrowth\n(Norton–Simon)"];
    node [fillcolor="#f4cccc"];
    RESP    [label="Objective response"];
    PFSOS   [label="PFS / OS\n(association is OBSERVATIONAL —\nweakest link in the model)",
             penwidth=1.6];

    DELAY -> ONTIME [arrowhead=tee, color="#cc0000"];
    REDUCE -> DELIVER [arrowhead=tee, color="#cc0000"];
    DELIVER -> RDI; ONTIME -> RDI;
    RDI -> TUMS [arrowhead=tee, color="#cc0000", penwidth=1.8, label="log-kill"];
    ONTIME -> REGROW [arrowhead=tee, color="#cc0000"];
    REGROW -> TUMS; REGROW -> TUMR;
    TUMS -> RESP [arrowhead=tee, color="#cc0000"];
    TUMR -> RESP [arrowhead=tee, color="#cc0000"];
    RESP -> PFSOS; RDI -> PFSOS [style=dashed];
    PK_CENT -> TUMS [arrowhead=tee, color="#cc0000", style=dashed];
}

/* ======================================================================== */
/* 18. RISK PREDICTION AND THE GUIDELINE DECISION LAYER                     */
/* ======================================================================== */
subgraph cluster_decision {
    label=<<b>18. Decision layer — the 20% threshold is a policy, and the model can be asked where it comes from</b>>;
    style="rounded,filled"; fillcolor="#fafafa"; color="#999999"; fontsize=12;

    node [fillcolor="#eeeeee"];
    REGRISK [label="Regimen FN risk category\nhigh > 20% · intermediate\n10–20% · low < 10%"];
    PATRISK [label="Patient risk factors\nage · prior FN · PS ·\nalbumin · comorbidity ·\nmarrow involvement"];
    THRESH  [label="20% THRESHOLD →\nPRIMARY prophylaxis\n(ASCO / NCCN / EORTC)",
             penwidth=1.8];
    SECOND  [label="SECONDARY prophylaxis\nafter an FN event or a\nprotocol-threatening nadir"];
    CHOICE  [label="THE CHOICE:\nG-CSF (keeps RDI) vs\ndose reduction (keeps FN risk\ndown but loses RDI)",
             fillcolor="#ffe0cc", penwidth=2.2];
    DAY1GATE[label="Day-1 CBC gate\nANC ≥ 1.5 and\nplatelets ≥ 100"];
    MODELUSE[label="Model use — first-in-human\ndose, schedule choice,\nMIDD dossier"];

    REGRISK -> THRESH; PATRISK -> THRESH; THRESH -> PEGFIL [penwidth=1.6];
    THRESH -> FILG; FN -> SECOND; SECOND -> PEGFIL; SECOND -> REDUCE;
    THRESH -> CHOICE; CHOICE -> REDUCE; CHOICE -> PEGFIL;
    DAY1GATE -> DELAY; CIRC -> DAY1GATE [style=dashed];
    PLTC -> DAY1GATE [style=dashed];
    FALSEANC -> DAY1GATE [style=dashed, color="#b45f06", penwidth=1.6,
                          label="the gate can be passed\nfor the wrong reason"];
    AGE -> PATRISK [style=dashed]; PS -> PATRISK [style=dashed];
    ALB -> PATRISK [style=dashed]; PRIOR -> PATRISK [style=dashed];
    COMORB -> PATRISK [style=dashed]; BASEANC -> PATRISK [style=dashed];
    RDI -> MODELUSE [style=dashed]; DSN -> MODELUSE [style=dashed];
}

/* ======================================================================== */
/* 19. WHAT THE MODEL ACTUALLY COMPUTES                                     */
/* ======================================================================== */
subgraph cluster_readout {
    label=<<b>19. Model readouts (53 ODE states)</b>>;
    style="rounded,filled"; fillcolor="#f5f0fa"; color="#8e7cc3"; fontsize=12;
    node [fillcolor="#ede7f6"];
    OUT_ANC  [label="ANC(t), nadir, nadir day,\nrecovery day"];
    OUT_DSN  [label="DSN(t) counter\n(hours below 0.5)"];
    OUT_HAZ  [label="Cumulative FN hazard\n→ P(FN per cycle)"];
    OUT_PK   [label="Cytotoxic and G-CSF\nconcentration–time"];
    OUT_TMDD [label="G-CSF half-life as a\nFUNCTION of ANC"];
    OUT_PLT  [label="Platelet and Hb\nnadirs, nadir days"];
    OUT_RES  [label="Marrow reserve /\ncumulative depletion"];
    OUT_RDI  [label="RDI, cycles delivered,\ntumour burden"];
    OUT_FUNC [label="Effective ANC\n(count × function)"];

    CIRC -> OUT_ANC; DSN -> OUT_DSN; FN -> OUT_HAZ; GCENT -> OUT_PK;
    GTMDD -> OUT_TMDD; PLTC -> OUT_PLT; RBCC -> OUT_PLT;
    LTHSC -> OUT_RES; RDI -> OUT_RDI; FUNCSTATE -> OUT_FUNC;
    PK_CENT -> OUT_PK;
}

/* ======================================================================== */
/* 20. CROSS-CLUSTER SPINE — the six claims the map is built to support     */
/* ======================================================================== */
    APOP -> DSN [style=invis];
    MTT -> CIRC [style=dashed, penwidth=2.0, color="#3c78d8",
                 label="  DELAY: sets the nadir DAY  "];
    AUC -> APOP [penwidth=2.0, color="#cc0000",
                 label="  DEPTH: sets the nadir VALUE  "];
    GACT2 -> DSN [style=dashed, color="#3c78d8", penwidth=1.6,
                  label="G-CSF shortens the delay,\nso it shortens DSN"];
    TRILA -> DSN [style=dashed, color="#3c78d8", penwidth=1.6,
                  label="G1 arrest removes cells from\nthe drug-sensitive fraction"];
    CIRC -> BACTLOAD [style=invis];
}
