digraph AIC_QSP {
    rankdir=LR;
    compound=true;
    newrank=true;   /* required: cluster-cycle ranking with 18 clusters */
    fontname="NanumGothic";
    labelloc="t";
    fontsize=28;
    label="안트라사이클린 심장독성 (Anthracycline-Induced Cardiotoxicity, AIC) — Mechanistic QSP Map\n독소루비신 PK/대사(독소루비시놀) · Top2b-DSB 축(첨두농도 구동) vs 철-ROS 축(AUC 구동) · 근세포 비재생 풀 · 보상성 심근비대 = 가면(mask) · 섬유화 = 가역성 창의 폐쇄\n(18 clusters · 174 nodes · 241 edges) — 핵심 구조: 두 개의 손상 축은 서로 다른 노출 지표를 읽고, 두 개의 결손(가역 FUNC / 비가역 MYO)은 서로 다른 치료 레버에 반응한다\n누적용량(mg/m²)은 노출 지표가 아니다: 같은 480 mg/m²가 일시주입(bolus)·72시간 지속주입·주간분할·리포조말에서 각각 다른 손상을 만든다";
    node [style=filled, fontname="NanumGothic", fontsize=11, shape=box, margin="0.12,0.08"];
    edge [fontname="NanumGothic", fontsize=9, color="gray35"];
    graph [fontname="NanumGothic"];

    /* ===================================================================
       1. 위험인자 및 숙주 취약성
       =================================================================== */
    subgraph cluster_risk {
        label="1. 위험인자 및 숙주 취약성 (Risk Factors & Host Vulnerability)";
        style=filled; color="#f3e5c0"; node [fillcolor="#f7d896"];
        Age_risk     [label="고령 (≥65세)\n근세포 재생능↓·미토콘드리아 예비력↓"];
        Age_young    [label="소아 (<5세)\n성장기 심장 = 절대 근세포수 예비력↓\n(성장 후 상대적 결손 확대)"];
        Female_risk  [label="여성 (특히 소아 코호트)"];
        HTN_risk     [label="고혈압 · 좌심실 후부하↑\n(벽응력 기저 상승)"];
        DM_risk      [label="당뇨병 · 대사증후군\n(미토콘드리아 산화 스트레스 취약)"];
        Prior_RT     [label="종격부 방사선치료 병력\n(미세혈관 손상 + 섬유화 기저치↑)"];
        Baseline_EF  [label="기저 LVEF 낮음 (<55%)\n= 가면(masking) 예비력 감소"];
        Prior_anthra [label="이전 안트라사이클린 노출\n(근세포 풀은 초기화되지 않음)"];
        CBR1_gene    [label="CBR1 · AKR1C3 다형성\n독소루비시놀 생성률(FM) 변이"];
        TOP2B_gene   [label="TOP2B (rs1206797) · RARG (rs2229774)\nSLC28A3 · UGT1A6 변이"];
        HFE_gene     [label="HFE · 철 과부하 상태\n가용성 철 풀(LIP)↑"];
        CELF4_gene   [label="CELF4 · HAS3 · NOS3 변이"];
        Obesity_risk [label="비만 · 심방세동 · 만성신질환"];
        Trast_risk   [label="HER2 양성 = 트라스투주맙 병용 예정\n(ErbB2 복구 신호 차단 예고)"];
    }

    /* ===================================================================
       2. 약물 노출 및 스케줄
       =================================================================== */
    subgraph cluster_dose {
        label="2. 노출 · 제형 · 스케줄 (Exposure, Formulation & Schedule)";
        style=filled; color="#e7dccd"; node [fillcolor="#dfc9a6"];
        DOX_bolus    [label="독소루비신 IV push\n60 mg/m² q3w (기준 요법)\nCmax ≈ 1.8 mg/L"];
        DOX_inf      [label="72시간 지속주입\n동일 누적용량, Cmax 1/65\n(첨두 제거 전략)"];
        DOX_weekly   [label="주간 분할 20 mg/m² ×24\n(첨두 1/3)"];
        PLD_dose     [label="페길화 리포조말 독소루비신(PLD)\n40 mg/m² q4w\n(캡슐화 = 심근 유입 차단)"];
        EPI_dose     [label="에피루비신 · 다우노루비신\n· 이다루비신 (등가환산)"];
        MITOX_dose   [label="미톡산트론 (안트라센디온)\n동일 Top2b 기전"];
        CUM_dose     [label="누적용량 (mg/m²)\n240 · 360 · 480 · 550\n※ 관례적 지표이나 노출 지표는 아님"];
        Cyclo_dose   [label="병용 사이클로포스파미드\n· 파클리탁셀 (AC-T)"];
        RT_conc      [label="동시 흉부 방사선"];
    }

    /* ===================================================================
       3. 독소루비신 PK
       =================================================================== */
    subgraph cluster_pk {
        label="3. 독소루비신 PK (3-구획 · 대사 · 심근 분포)";
        style=filled; color="#d9e8f5"; node [fillcolor="#a8c8e8"];
        A_central    [label="중심구획 A1 (V1 = 60 L)\nCL = 1296 L/day\nAUC(60 mg/m²) ≈ 2.0 µg·h/mL"];
        A_periph1    [label="말초구획 A2 (V2 = 200 L)\nQ2 = 1200 L/day"];
        A_periph2    [label="심부구획 A3 (V3 = 1300 L)\nQ3 = 600 L/day · 종말 t½ 20-48 h"];
        C_plasma     [label="혈장농도 C1 (mg/L)\n= A1 / V1"];
        LIPO_cmt     [label="리포조말 담체 ALIP\nt½ ≈ 3.1 d · 방출분율 ≈ 50%\n(핵 풀 첨두 113배↓)"];
        CBR1_enz     [label="CBR1 / AKR1C3 (세포질 환원효소)\nC-13 케톤 → 알코올"];
        DOXOL_c      [label="독소루비시놀 (2차 알코올 대사체)\nVM 250 L · CLM 150 L/day\nt½ ≈ 28 h · AUC > 모약물"];
        DOXOL_p      [label="독소루비시놀 말초구획"];
        Aglycone     [label="7-데옥시아글리콘 (환원적 탈당화)\n지질친화성 · 막 삽입"];
        Renal_bil    [label="담도 배설(주) · 신배설(<10%)\n간기능 저하 시 노출↑"];
        Pgp_eff      [label="P-gp / MRP1 유출\n(심근 내 잔류시간 조절)"];
    }

    /* ===================================================================
       4. 심근 내 두 개의 약물 풀 — 모델의 핵심 분기
       =================================================================== */
    subgraph cluster_cardiac_pool {
        label="4. 심근 내 두 개의 약물 풀 (Two Cardiac Drug Pools) — 서로 다른 노출 지표를 읽는다";
        style=filled; color="#f9d6d6"; node [fillcolor="#f2a9a9"];
        CHF_pool     [label="빠른 핵/유리 풀 CHF\nKPINF 600 · KPHF 25 (t½ ≈ 0.03 d)\n= 혈장 첨두를 추종 (PEAK-tracking)"];
        CH_pool      [label="느린 잔류 결합 풀 CH\nKPIN 3 · KPH 40 (t½ ≈ 9 d)\n= 혈장 AUC를 적분 (AUC-tracking)"];
        CHM_pool     [label="심근 독소루비시놀 CHM\nKPHM 60 (t½ ≈ 28 d)\n= 사이클마다 축적 (2.0배/8주기)"];
        TOXN_var     [label="TOXN = CHF / CHFREF\n핵 유전독성 구동변수\n제곱 의존성 (Hill n=2, 준포화)"];
        TOXR_var     [label="TOXR = CH/CHREF + CHM/CHMREF\n산화환원 구동변수\nAUC 비례 · 누적"];
        DNA_interc   [label="DNA 이중나선 삽입 (intercalation)\n분 단위 평형"];
        Cardiolipin  [label="카디오리핀 결합 (내막)\n심근 선택적 잔류의 물리적 근거"];
        Nuc_uptake   [label="핵 내 농축 (Nuclear/plasma ≈ 25)"];
    }

    /* ===================================================================
       5. Top2b 의존 DNA 손상 축
       =================================================================== */
    subgraph cluster_top2b {
        label="5. Top2b 의존 DNA 이중가닥절단 축 (Top2b-DSB Arm) — 첨두 구동 · 사이클 간 기억";
        style=filled; color="#e6dcf2"; node [fillcolor="#c4b0e0"];
        TOP2B_prot   [label="Top2b 단백 (심근세포 우세 아이소형)\n합성 0.35/day (t½ 2 d)\n= 심장 특이 표적"];
        TOP2A_prot   [label="Top2a (증식세포 · 종양)\n= 항종양 효과의 표적\n(심근에는 거의 없음)"];
        Top2b_cleav  [label="Top2b–DNA 절단복합체 안정화\n(ternary cleavage complex)"];
        DSB_state    [label="DNA 이중가닥절단 DSB\n생성 ∝ TOP2B × Hill(TOXN;2.5,n=2)\n복구 0.35/day"];
        ATM_ATR      [label="ATM / ATR → CHK1/2\nγH2AX 형성"];
        DDR_repair   [label="비상동말단연결(NHEJ) · HR 복구\nErbB2/NRG1 신호 의존"];
        P53_state    [label="p53 / p21 유전독성 스트레스 기억\n감쇠 t½ ≈ 28 d\n→ 사이클을 넘어 누적 (8주기 후 0.88)"];
        Senescence   [label="근세포 노화(senescence) 표현형\nSASP: IL-6 · IL-1β · TGF-β"];
        PGC1A_sup    [label="PGC-1α / PGC-1β 억제\n→ TFAM · NRF1 하향"];
        Apop_intr    [label="내재성 세포자멸사\nBAX/BAK · 시토크롬 c · caspase-9/3"];
        Topo_note    [label="Top2b 조건부 결손 마우스\n= 심장독성 저항성\n(기전 근거: Zhang 2012)", shape=note, fillcolor="#efe8fb"];
    }

    /* ===================================================================
       6. 철 · ROS · 산화 손상 축
       =================================================================== */
    subgraph cluster_redox {
        label="6. 철 · ROS · 산화 손상 축 (Iron-Redox Arm) — AUC 구동 · 대사체 우세";
        style=filled; color="#fde3cc"; node [fillcolor="#f8b878"];
        Quinone      [label="퀴논 고리 산화환원 순환\n(반퀴논 라디칼)"];
        NADPH_ox     [label="NADPH 산화효소 NOX2/NOX4\nRac1 의존 활성화"];
        eNOS_unc     [label="eNOS 탈짝지음(uncoupling)\n→ 슈퍼옥사이드 생성"];
        Complex_I    [label="미토콘드리아 복합체 I 환원\n(전자 누출)"];
        LIP_pool     [label="가용성 철 풀 LIP\n기저 1.0 · ROS 되먹임으로 상승\n(IRP1/2 · 페리틴 분해)"];
        Fe_complex   [label="안트라사이클린-Fe³⁺ 착물\n부위 특이적 하이드록실 라디칼"];
        Fenton       [label="펜톤/하버-바이스 반응\nH₂O₂ + Fe²⁺ → •OH"];
        ROS_state    [label="ROS 상태변수\n= f(TOXN 첨두, TOXR·(1+0.35·LIP),\nMITOD, p53) − 1.2/day 소거\n루프 이득 준임계(sub-critical)"];
        Lipid_perox  [label="지질 과산화 (4-HNE · MDA)\n카디오리핀 산화"];
        GPX4_GSH     [label="GPX4 · GSH · 티오레독신 소거계\n(소모성 고갈)"];
        Ferroptosis  [label="페롭토시스 (철 의존 세포사)\nACSL4 · 지질 ROS"];
        SOD2_MnSOD   [label="MnSOD(SOD2) · 카탈라제\n심근에서 상대적 저발현"];
        Doxol_Ca     [label="독소루비시놀: SERCA2a · RyR2 ·\nNa⁺/K⁺-ATPase 직접 억제\n(모약물보다 강한 칼슘 교란)"];
    }

    /* ===================================================================
       7. 미토콘드리아 기능장애
       =================================================================== */
    subgraph cluster_mito {
        label="7. 미토콘드리아 기능장애 (Mitochondrial Dysfunction) — 자기증폭 되먹임";
        style=filled; color="#dff0e3"; node [fillcolor="#a8d8b9"];
        MITOD_state  [label="미토콘드리아 결손 MITOD (0→1)\n생성 ∝ (0.6·ROS + 0.4·p53)\n회복 ∝ 0.03 × BIOG"];
        BIOG_var     [label="생합성 능력 BIOG = 1/(1+1.5·p53)\n(p53이 회복 자체를 억제)"];
        mtDNA_dmg    [label="mtDNA 손상 · 복제수 감소\n(핵 DNA보다 취약)"];
        OXPHOS_down  [label="산화적 인산화 능력↓\nATP/ADP↓ · 인산크레아틴↓"];
        MPTP_open    [label="미토콘드리아 투과성 전이공(mPTP) 개방\n칼슘 과부하 + ROS"];
        Cyt_c_rel    [label="시토크롬 c 방출"];
        Mitophagy    [label="마이토파지 (PINK1/Parkin)\n손상 미토콘드리아 제거 부담"];
        Energy_def   [label="에너지 결핍 → 수축·이완 예비력↓"];
        ROS_amp      [label="ROS 증폭 되먹임 (WMITO 1.2)\n※ 포화형이므로 단안정(monostable)", shape=note, fillcolor="#eef8f1"];
    }

    /* ===================================================================
       8. 두 개의 결손: 가역 vs 비가역
       =================================================================== */
    subgraph cluster_two_deficits {
        label="8. 두 개의 결손 (Two Deficits) — 가역적 기능장애 vs 비가역적 근세포 소실";
        style=filled; color="#fff2b8"; node [fillcolor="#ffe066"];
        FUNC_state   [label="가역적 기능 결손 FUNC\n근세포당 수축력 손실\n소실 t½ ≈ 58 d (섬유화로 지연)"];
        MYO_state    [label="비가역적 근세포 풀 MYO (1.0 → )\n사멸률 = f(Hill(ROS;1,n=3)·(1+1.2·p53))\n재생 2×10⁻⁵/day (≈0.7 %/yr)"];
        Sarc_disarr  [label="근섬유 배열 이상 · Z선 붕괴\n타이틴 인산화 변화"];
        SERCA_down   [label="SERCA2a 하향 · PLN 인산화↓\n근소포체 칼슘 재흡수 지연"];
        RyR_leak     [label="RyR2 칼슘 누출 (산화적 변형)"];
        Myofil_Ca    [label="근세사 칼슘 감수성 변화\n트로포닌 I 인산화"];
        Titin_stiff  [label="타이틴 이소형 전환 → 수동장력↑"];
        Vacuol       [label="세포질 공포화 · 근섬유 소실\n(Billingham 등급 병리)"];
        Necro_apop   [label="세포자멸사 · 네크롭토시스 · 페롭토시스\n(합산 사멸 경로)"];
        No_regen     [label="성체 심근세포 재생률 ≈ 0.5-1 %/yr\n= 손실은 사실상 영구적", shape=note, fillcolor="#fff8d6"];
        Cell_hyper   [label="잔존 근세포 개별 비대\n(수축단위 보상)"];
    }

    /* ===================================================================
       9. 보상성 비대 = 가면(masking)
       =================================================================== */
    subgraph cluster_mask {
        label="9. 보상 예비력과 가면 (Compensatory Reserve = the Mask) — LVEF가 늦게 움직이는 이유";
        style=filled; color="#ffe0f0"; node [fillcolor="#f5a8cd"];
        DEFICIT_var  [label="유효 수축단위 결손\nDEFICIT = 1 − MYO·(1−FUNC)"];
        HYP_state    [label="보상성 비대 HYP\n목표 = min(0.32, 1.6 × DEFICIT)\n시간상수 45 d"];
        HYP_sat      [label="예비력 포화 (HYPMAX 0.32)\n= DEFICIT > 0.20 에서 한계 도달"];
        Wall_stress  [label="벽응력 (라플라스)\n= 전·후부하 · 벽두께 함수"];
        LV_remod     [label="좌심실 재형성 · 구형화\n(확장성 표현형)"];
        Preload_var  [label="전부하 · 후부하 (혈압 · 빈혈 · 체액)"];
        Mask_note    [label="가면의 결과: 근세포가 20% 소실될 때까지\nLVEF는 거의 움직이지 않는다\n→ LVEF는 후행지표(lagging indicator)", shape=note, fillcolor="#ffeaf5"];
        Reserve_exh  [label="예비력 소진 → LVEF 급락 구간\n(외견상 '역치' 현상의 실체)"];
    }

    /* ===================================================================
       10. 섬유화 · 신경호르몬 재형성
       =================================================================== */
    subgraph cluster_fibrosis {
        label="10. 섬유화 · 신경호르몬 재형성 (Fibrosis & Neurohormonal Remodelling) — 가역성 창을 닫는다";
        style=filled; color="#e0e0e0"; node [fillcolor="#b8b8b8"];
        FIB_state    [label="섬유화 FIB\n생성 ∝ (2.5·근세포소실 + 0.3·NH)\n소실 0.010/day"];
        Fibro_act    [label="심장 섬유아세포 → 근섬유아세포\nTGF-β1 · SMAD2/3 · CTGF"];
        Collagen     [label="I/III형 콜라겐 침착 · 교차결합(LOX)\n세포외기질 강성↑"];
        MMP_TIMP     [label="MMP2/9 · TIMP 균형 이동"];
        NH_state     [label="신경호르몬 활성 NH\n= 3 × 벽응력 신호 (t½ ≈ 4.6 d)"];
        RAAS_ax      [label="RAAS: 레닌 → Ang II → AT1R\n알도스테론"];
        SNS_ax       [label="교감신경 활성 · 노르에피네프린\nβ1 하향조절"];
        NP_ax        [label="나트륨이뇨펩티드 축\nBNP/NT-proBNP · cGMP"];
        Fib_latch    [label="FIB → FUNC 회복 억제 (1+3·FIB)\n= 가역성 창의 폐쇄 기전", shape=note, fillcolor="#efefef"];
