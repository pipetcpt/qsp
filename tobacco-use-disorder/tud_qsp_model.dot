digraph TUD_QSP {
  graph [rankdir=LR, splines=spline, overlap=false, fontname="Helvetica",
         label="Tobacco Use Disorder (Nicotine Dependence) QSP Map — nicotine PK/CYP2A6 · α4β2* nAChR desensitization & upregulation · mesolimbic dopamine · habenular aversion · allostatic withdrawal · varenicline / cytisinicline / bupropion / NRT · CO-verified abstinence",
         labelloc="t", fontsize=22, nodesep=0.42, ranksep=0.85, bgcolor="white", compound=true];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, color="#333333"];
  edge  [fontname="Helvetica", fontsize=9, color="#666666"];

  // =================== 1) Product & delivery kinetics ===================
  subgraph cluster_delivery {
    label="1) Tobacco / Nicotine Product & Delivery Kinetics"; style="rounded,filled"; fillcolor="#FFF2CC"; color="#7F6000";
    CIG          [label="Combustible cigarette\n~1.0–1.5 mg nicotine absorbed/cig", fillcolor="#FFE0B2"];
    PUFF         [label="Puff topography\nvolume · duration · interpuff interval", fillcolor="#FFF8E1"];
    VLNC         [label="Very-low-nicotine cigarette\n0.4 mg/g tobacco (reduced-nicotine standard)", fillcolor="#FFF8E1"];
    ENDS         [label="ENDS / e-cigarette\nnicotine salt aerosol", fillcolor="#FFF8E1"];
    ORAL_POUCH   [label="Oral nicotine pouch / snus\nbuccal, pH-dependent", fillcolor="#FFF8E1"];
    LUNG_ABS     [label="Pulmonary alveolar absorption\nF≈1 · Tmax 10–20 s (arterial bolus)", fillcolor="#FFD180"];
    ART_SPIKE    [label="Arterial nicotine spike\nCa ≈ 2–5 × venous Cv", fillcolor="#FFD180"];
    BUCCAL       [label="Buccal / sublingual absorption\ngum · lozenge · inhaler (F 0.5–0.8)", fillcolor="#FFF8E1"];
    TRANSD       [label="Transdermal reservoir\npatch 7/14/21 mg/16–24 h", fillcolor="#FFF8E1"];
    LAG_SKIN     [label="Skin depot lag\nTlag 1–2 h · Tmax 6–10 h", fillcolor="#FFF8E1"];
    DOSE_RATE    [label="Nicotine input rate\ndCn/dt driver", fillcolor="#FFCC80"];
    SPEED_REINF  [label="Rate of rise → reinforcement\n(arterial dC/dt ∝ abuse liability)", fillcolor="#FFCC80"];

    CIG -> PUFF -> LUNG_ABS; CIG -> LUNG_ABS; VLNC -> LUNG_ABS [label="low nicotine yield"];
    ENDS -> LUNG_ABS; ENDS -> BUCCAL; ORAL_POUCH -> BUCCAL;
    LUNG_ABS -> ART_SPIKE -> SPEED_REINF;
    TRANSD -> LAG_SKIN -> DOSE_RATE; BUCCAL -> DOSE_RATE; ART_SPIKE -> DOSE_RATE;
  }

  // =================== 2) Nicotine PK & CYP2A6 pharmacogenetics ===================
  subgraph cluster_pk {
    label="2) Nicotine Disposition & CYP2A6 Pharmacogenetics"; style="rounded,filled"; fillcolor="#E1F5FE"; color="#01579B";
    NIC_C        [label="Nicotine central\nVc≈100–180 L · CL 1.1–1.3 L/min", fillcolor="#B3E5FC"];
    NIC_P        [label="Nicotine peripheral tissue\n(Vss 2.6 L/kg)", fillcolor="#E1F5FE"];
    NIC_BRAIN    [label="Brain biophase nicotine\nkeo t½ ≈ 3–5 min", fillcolor="#81D4FA"];
    NIC_T12      [label="Nicotine t½ ≈ 2 h\n(terminal 2–3 h)", fillcolor="#E1F5FE"];
    CYP2A6       [label="CYP2A6 (19q13.2)\nrate-limiting C-oxidation ~70–80%", fillcolor="#B3E5FC"];
    CYP2A6_ALL   [label="CYP2A6 alleles\n*1 · *2 · *4 (whole-gene del) · *9 · *12 · *17", fillcolor="#E1F5FE"];
    NMR_FAST     [label="Fast metabolizer\nNMR ≥0.31 · higher CL · higher CPD", fillcolor="#4FC3F7"];
    NMR_SLOW     [label="Slow metabolizer\nNMR <0.31 · nicotine accumulation", fillcolor="#4FC3F7"];
    COT          [label="Cotinine\nt½ 16 h · exposure biomarker", fillcolor="#E1F5FE"];
    HCOT         [label="trans-3'-hydroxycotinine\nCYP2A6-specific product", fillcolor="#E1F5FE"];
    NMR          [label="Nicotine metabolite ratio\nNMR = 3HC / cotinine", fillcolor="#4FC3F7"];
    UGT2B10      [label="UGT2B10\nnicotine/cotinine N-glucuronide", fillcolor="#E1F5FE"];
    FMO3         [label="FMO3\nnicotine N'-oxide (minor)", fillcolor="#E1F5FE"];
    CYP2B6       [label="CYP2B6\nminor nicotine · major bupropion route", fillcolor="#E1F5FE"];
    RENAL_NIC    [label="Renal excretion\n~10% unchanged (pH-dependent)", fillcolor="#E1F5FE"];
    NIC_PREG     [label="Pregnancy / estrogen\nCYP2A6 induction ↑CL", fillcolor="#E1F5FE"];

    NIC_C -> NIC_P [dir=both]; NIC_C -> NIC_BRAIN [label="keo"]; NIC_C -> NIC_T12;
    CYP2A6_ALL -> CYP2A6; NIC_PREG -> CYP2A6 [label="induce"];
    CYP2A6 -> NMR_FAST [label="high activity"]; CYP2A6 -> NMR_SLOW [label="reduced-function"];
    NIC_C -> COT [label="CYP2A6 C-oxidation"]; COT -> HCOT [label="CYP2A6"];
    HCOT -> NMR; COT -> NMR; NMR_FAST -> NMR; NMR_SLOW -> NMR;
    NIC_C -> UGT2B10; NIC_C -> FMO3; NIC_C -> CYP2B6; NIC_C -> RENAL_NIC;
    NMR_FAST -> NIC_C [label="↓AUC", style=dashed]; NMR_SLOW -> NIC_C [label="↑AUC", style=dashed];
  }

  // =================== 3) nAChR pharmacology ===================
  subgraph cluster_nachr {
    label="3) Nicotinic Acetylcholine Receptor Pharmacology"; style="rounded,filled"; fillcolor="#F3E5F5"; color="#4A148C";
    A4B2         [label="α4β2* nAChR\nprimary reward receptor · Kd 1–10 nM", fillcolor="#CE93D8"];
    HS_STOICH    [label="High-sensitivity (α4)2(β2)3\nEC50 ~1 µM ACh", fillcolor="#E1BEE7"];
    LS_STOICH    [label="Low-sensitivity (α4)3(β2)2", fillcolor="#E1BEE7"];
    A6B2B3       [label="α6β2β3 nAChR\nDA terminal · presynaptic release", fillcolor="#E1BEE7"];
    A5_SUB       [label="α5 accessory subunit (CHRNA5)\nrs16969968 D398N", fillcolor="#E1BEE7"];
    A7           [label="α7 nAChR\nglutamatergic terminals · Ca2+", fillcolor="#E1BEE7"];
    A3B4         [label="α3β4 nAChR\nautonomic ganglia · MHb · nausea", fillcolor="#E1BEE7"];
    OCC          [label="Receptor occupancy\nCbrain/(Kd+Cbrain) · 1 cig ⇒ >88% (PET)", fillcolor="#BA68C8"];
    DESENS       [label="Fast desensitization\nseconds–minutes · agonist-bound closed", fillcolor="#BA68C8"];
    RESENS       [label="Resensitization\novernight abstinence recovery", fillcolor="#E1BEE7"];
    UPREG        [label="Receptor upregulation\n↑β2* density (chronic) · t½ ~2–3 wk", fillcolor="#BA68C8"];
    PET_B2       [label="[123I]5-IA / [18F]flubatine β2* PET\nnormalizes 3–4 wk post-quit", fillcolor="#E1BEE7"];
    SPARE_CAP    [label="Spare receptor capacity\n(functional reserve)", fillcolor="#E1BEE7"];
    ACH_TONE     [label="Endogenous ACh tone\nbasal cholinergic drive", fillcolor="#E1BEE7"];

    A4B2 -> HS_STOICH; A4B2 -> LS_STOICH; A5_SUB -> A4B2 [label="α4β2α5"];
    A4B2 -> OCC; A6B2B3 -> OCC; ACH_TONE -> A4B2;
    OCC -> DESENS [label="sustained agonist"]; DESENS -> RESENS [label="agonist washout"];
    DESENS -> UPREG [label="chronic (weeks)"]; UPREG -> PET_B2; UPREG -> SPARE_CAP;
  }

  // =================== 4) Mesolimbic dopamine reward circuit ===================
  subgraph cluster_reward {
    label="4) Mesolimbic Dopamine Reward Circuit"; style="rounded,filled"; fillcolor="#E8F5E9"; color="#1B5E20";
    VTA_DA       [label="VTA dopamine neurons\nα4β2* on soma", fillcolor="#A5D6A7"];
    VTA_GABA     [label="VTA GABA interneurons\nα4β2* (rapidly desensitizing)", fillcolor="#C8E6C9"];
    VTA_GLU      [label="Glutamatergic afferents (PFC/PPTg)\nα7 presynaptic", fillcolor="#C8E6C9"];
    BURST        [label="Phasic burst firing\n(switch from tonic)", fillcolor="#A5D6A7"];
    NAC_DA       [label="NAc shell dopamine release\n↑150–200% acute nicotine", fillcolor="#66BB6A"];
    DAT          [label="Dopamine transporter (DAT)\nreuptake", fillcolor="#C8E6C9"];
    MAOAB        [label="MAO-A/MAO-B inhibition\nsmoke β-carbolines (harman/norharman)", fillcolor="#C8E6C9"];
    D1_MSN       [label="D1 MSN (direct 'go')", fillcolor="#C8E6C9"];
    D2_MSN       [label="D2 MSN (indirect 'stop')", fillcolor="#C8E6C9"];
    D2_AVAIL     [label="Striatal D2/D3 availability\n↓ in dependence (PET)", fillcolor="#C8E6C9"];
    REWARD_SIG   [label="Reward / reinforcement signal\n(positive reinforcement)", fillcolor="#66BB6A"];
    DA_DEFICIT   [label="Hypodopaminergic state\nabstinence reward deficit", fillcolor="#66BB6A"];

    VTA_DA -> BURST -> NAC_DA -> REWARD_SIG;
    VTA_GABA -> VTA_DA [label="disinhibition after desens", arrowhead=tee];
    VTA_GLU -> VTA_DA [label="α7 glutamate"];
    NAC_DA -> DAT [dir=both]; MAOAB -> NAC_DA [label="↑DA persistence"];
    NAC_DA -> D1_MSN; NAC_DA -> D2_MSN; D2_MSN -> D2_AVAIL;
    NAC_DA -> DA_DEFICIT [label="withdrawal ↓", style=dashed];
  }

  // =================== 5) Habenula–IPN aversion / intake titration ===================
  subgraph cluster_aversion {
    label="5) Habenula–IPN Aversion Circuit & Intake Titration"; style="rounded,filled"; fillcolor="#FFEBEE"; color="#B71C1C";
    MHB          [label="Medial habenula (MHb)\nα3β4α5 dense", fillcolor="#FFCDD2"];
    IPN          [label="Interpeduncular nucleus (IPN)\naversion relay", fillcolor="#FFCDD2"];
    RS16969968   [label="CHRNA5 rs16969968 (D398N)\nrisk allele ↓α5 function", fillcolor="#EF9A9A"];
    AVERS_SP     [label="Aversion set-point\nupper bound on intake", fillcolor="#EF9A9A"];
    TITRATE      [label="Nicotine titration\nsmoke to defended brain level", fillcolor="#E57373"];
    COMP_SMOKE   [label="Compensatory smoking\ndeeper puffs on low-yield cigarettes", fillcolor="#FFCDD2"];
    NAUSEA_C     [label="Nausea / emesis\nα3β4 + 5-HT3 (area postrema)", fillcolor="#FFCDD2"];
    DOSE_CEIL    [label="Self-administration ceiling\ninverted-U dose–response", fillcolor="#EF9A9A"];

    RS16969968 -> MHB [label="↓aversion signalling"]; MHB -> IPN -> AVERS_SP -> DOSE_CEIL;
    AVERS_SP -> TITRATE; TITRATE -> COMP_SMOKE; MHB -> NAUSEA_C;
  }

  // =================== 6) Allostasis, withdrawal & negative affect ===================
  subgraph cluster_withdrawal {
    label="6) Allostatic Load · Withdrawal · Negative Affect"; style="rounded,filled"; fillcolor="#EDE7F6"; color="#311B92";
    ALLO         [label="Allostatic set-point shift\n(reward threshold ↑)", fillcolor="#B39DDB"];
    CRF_CRF1     [label="CRF – CRF1 (extended amygdala)\nstress axis recruitment", fillcolor="#D1C4E9"];
    DYN_KOR      [label="Dynorphin – κ-opioid receptor\ndysphoria", fillcolor="#D1C4E9"];
    LC_NE        [label="Locus coeruleus noradrenaline\nirritability · anxiety", fillcolor="#D1C4E9"];
    HPA_AX       [label="HPA axis / cortisol\nnicotine-stimulated, withdrawal dysregulated", fillcolor="#D1C4E9"];
    OREXIN       [label="Hypocretin/orexin\narousal · sleep fragmentation", fillcolor="#D1C4E9"];
    WD_SYND      [label="Withdrawal syndrome (MNWS)\nirritability · anxiety · concentration · appetite · sleep", fillcolor="#9575CD"];
    WD_TIME      [label="Withdrawal time course\npeak d2–3 · resolves 2–4 wk", fillcolor="#B39DDB"];
    NEG_REINF    [label="Negative reinforcement\nsmoking to relieve withdrawal", fillcolor="#9575CD"];
    ANHED        [label="Anhedonia / reward blunting", fillcolor="#D1C4E9"];
    DEPR_COMORB  [label="Depression / anxiety comorbidity\n(EAGLES psychiatric cohort)", fillcolor="#D1C4E9"];

    UPREG -> ALLO [label="unoccupied upregulated receptors"];
    DA_DEFICIT -> ALLO; ALLO -> WD_SYND; ALLO -> ANHED;
    CRF_CRF1 -> WD_SYND; DYN_KOR -> WD_SYND; LC_NE -> WD_SYND; OREXIN -> WD_SYND; HPA_AX -> WD_SYND;
    ALLO -> CRF_CRF1; ALLO -> DYN_KOR;
    WD_SYND -> WD_TIME; WD_SYND -> NEG_REINF; DEPR_COMORB -> WD_SYND;
  }

  // =================== 7) Craving, cue reactivity & habit ===================
  subgraph cluster_craving {
    label="7) Craving · Cue Reactivity · Habit Learning"; style="rounded,filled"; fillcolor="#E0F7FA"; color="#006064";
    CUE          [label="Conditioned smoking cues\n(context · affect · ritual)", fillcolor="#B2EBF2"];
    DORSAL_STR   [label="Dorsolateral striatum\nstimulus–response habit", fillcolor="#B2EBF2"];
    INSULA       [label="Insula\ninteroceptive urge representation", fillcolor="#B2EBF2"];
    DLPFC        [label="dlPFC executive control\ninhibitory capacity", fillcolor="#B2EBF2"];
    MGLUR5       [label="mGluR5 / glutamate homeostasis\nAMPA plasticity", fillcolor="#B2EBF2"];
    INCENT_SAL   [label="Incentive salience\n(cue → wanting)", fillcolor="#80DEEA"];
    CRAVE_TONIC  [label="Tonic craving\nwithdrawal-driven (background urge)", fillcolor="#4DD0E1"];
    CRAVE_CUE    [label="Cue-provoked craving\nphasic spikes (QSU factor 2)", fillcolor="#4DD0E1"];
    QSU          [label="QSU-brief craving score\n1–7 Likert", fillcolor="#26C6DA"];
    HABIT_STR    [label="Habit strength\nyears-of-smoking dependent, slow decay", fillcolor="#4DD0E1"];

    CUE -> INCENT_SAL; CUE -> DORSAL_STR -> HABIT_STR; INSULA -> INCENT_SAL;
    MGLUR5 -> INCENT_SAL; INCENT_SAL -> CRAVE_CUE; HABIT_STR -> CRAVE_CUE;
    WD_SYND -> CRAVE_TONIC; ALLO -> CRAVE_TONIC;
    CRAVE_TONIC -> QSU; CRAVE_CUE -> QSU;
    DLPFC -> QSU [label="top-down suppression", arrowhead=tee];
  }

  // =================== 8) Smoking behaviour & lapse/relapse dynamics ===================
  subgraph cluster_behavior {
    label="8) Smoking Behaviour · Lapse / Relapse Dynamics"; style="rounded,filled"; fillcolor="#FFF3E0"; color="#E65100";
    CPD          [label="Cigarettes per day (CPD)\nbehavioural output", fillcolor="#FFCC80"];
    FTND         [label="FTND / HSI dependence score\ntime-to-first-cigarette", fillcolor="#FFE0B2"];
    TQD          [label="Target quit date (TQD)", fillcolor="#FFE0B2"];
    LAPSE_H      [label="Lapse hazard\nh0·exp(b1·QSU + b2·MNWS + b3·habit)", fillcolor="#FFB74D"];
    LAPSE        [label="Lapse (single cigarette)", fillcolor="#FFB74D"];
    RELAPSE      [label="Full relapse\n(≥7 consecutive days smoking)", fillcolor="#FFB74D"];
    ABST         [label="Continuous abstinence\nCO-verified, weeks 9–12", fillcolor="#FF9800"];
    PP7          [label="7-day point prevalence\nat 24 / 52 weeks", fillcolor="#FF9800"];
    COUNSEL      [label="Behavioural support / counselling\n(hazard multiplier ~0.8)", fillcolor="#FFE0B2"];
    SELF_EFF     [label="Self-efficacy / abstinence-violation effect", fillcolor="#FFE0B2"];
    REWARD_LAPSE [label="Lapse cigarette reward\n(blocked by antagonism)", fillcolor="#FFB74D"];

    QSU -> LAPSE_H; WD_SYND -> LAPSE_H; HABIT_STR -> LAPSE_H;
    COUNSEL -> LAPSE_H [arrowhead=tee]; SELF_EFF -> LAPSE_H [arrowhead=tee];
    TQD -> CPD [label="→0 at quit", style=dashed];
    LAPSE_H -> LAPSE -> REWARD_LAPSE -> RELAPSE; LAPSE -> SELF_EFF [arrowhead=tee];
    LAPSE_H -> ABST [arrowhead=tee]; ABST -> PP7; FTND -> LAPSE_H; CPD -> FTND;
    REWARD_SIG -> CPD [label="positive reinforcement"]; NEG_REINF -> CPD;
    TITRATE -> CPD; COMP_SMOKE -> CPD; CPD -> DOSE_RATE;
  }

  // =================== 9) Pharmacotherapy PK ===================
  subgraph cluster_drugpk {
    label="9) Pharmacotherapy — PK"; style="rounded,filled"; fillcolor="#E8EAF6"; color="#1A237E";
    VAR_PO       [label="Varenicline 0.5→1 mg BID PO\n1-wk titration · 12 wk", fillcolor="#9FA8DA"];
    VAR_PK       [label="Varenicline PK\nF~90% · t½ 24 h · Vd 415 L", fillcolor="#C5CAE9"];
    VAR_OCT2     [label="Renal OCT2 secretion\n~92% unchanged in urine", fillcolor="#C5CAE9"];
    VAR_CRCL     [label="Renal impairment dose reduction\nCrCl <30 → 0.5 mg QD", fillcolor="#C5CAE9"];
    VAR_BR       [label="Varenicline brain biophase", fillcolor="#9FA8DA"];
    CYT_PO       [label="Cytisinicline 1.5–3 mg TID PO\n6–12 wk (ORCA-2/ORCA-3)", fillcolor="#9FA8DA"];
    CYT_PK       [label="Cytisinicline PK\nt½ 4–6 h · renal clearance", fillcolor="#C5CAE9"];
    BUP_PO       [label="Bupropion SR 150 mg BID PO\nstart 1–2 wk pre-TQD", fillcolor="#9FA8DA"];
    BUP_PK       [label="Bupropion PK\nt½ 21 h · extensive first pass", fillcolor="#C5CAE9"];
    OHBUP        [label="Hydroxybupropion (CYP2B6)\nt½ 20–24 h · main active moiety", fillcolor="#C5CAE9"];
    CYP2B6_PGX   [label="CYP2B6*6 slow metabolizer\n↓OH-bupropion exposure", fillcolor="#C5CAE9"];
    NRT_PATCH    [label="Nicotine patch 21/14/7 mg\n24 h steady input", fillcolor="#9FA8DA"];
    NRT_PRN      [label="PRN NRT (gum 2/4 mg · lozenge · spray)\npeak-craving rescue", fillcolor="#9FA8DA"];
    NORTRIP      [label="Nortriptyline 75–100 mg\n2nd line (NE reuptake)", fillcolor="#C5CAE9"];
    CLONID       [label="Clonidine 0.1–0.3 mg\nα2 agonist, 2nd line", fillcolor="#C5CAE9"];
    NIC_VAX      [label="Nicotine conjugate vaccine\nperipheral sequestration (failed Ph3)", fillcolor="#C5CAE9"];

    VAR_PO -> VAR_PK -> VAR_BR; VAR_PK -> VAR_OCT2; VAR_CRCL -> VAR_PK;
    CYT_PO -> CYT_PK; BUP_PO -> BUP_PK -> OHBUP; CYP2B6_PGX -> OHBUP [arrowhead=tee];
    NRT_PATCH -> TRANSD; NRT_PRN -> BUCCAL; NIC_VAX -> NIC_C [arrowhead=tee, label="sequester"];
  }

  // =================== 10) Pharmacodynamics / mechanism of action ===================
  subgraph cluster_drugpd {
    label="10) Pharmacodynamics — Mechanism of Action"; style="rounded,filled"; fillcolor="#F1F8E9"; color="#33691E";
    PARTIAL_AG   [label="α4β2 partial agonism\nvarenicline Ki 0.06–0.4 nM · Emax ~45% of nicotine", fillcolor="#C5E1A5"];
    CYT_PARTIAL  [label="Cytisinicline partial agonism\nKi ~0.2 nM · lower intrinsic activity", fillcolor="#C5E1A5"];
    COMPET_BLOCK [label="Competitive blockade of smoked nicotine\n(reward attenuation on lapse)", fillcolor="#AED581"];
    RELIEF       [label="Withdrawal/craving relief\n(agonist floor on DA tone)", fillcolor="#AED581"];
    BUP_DAT_NET  [label="Bupropion DAT/NET reuptake inhibition\n↑synaptic DA & NE", fillcolor="#C5E1A5"];
    BUP_NACHR    [label="Bupropion non-competitive nAChR antagonism\n(α3β2 · α4β2)", fillcolor="#C5E1A5"];
    NRT_SUB      [label="NRT agonist substitution\nslow, low-peak nicotine delivery", fillcolor="#C5E1A5"];
    A7_VAR       [label="Varenicline α7 full agonism\n(minor, cognition)", fillcolor="#C5E1A5"];
    HT3_VAR      [label="Varenicline 5-HT3 agonism\n→ nausea", fillcolor="#C5E1A5"];
    DUAL_MECH    [label="Dual mechanism advantage\nrelief + blockade", fillcolor="#9CCC65"];
    PRELOAD      [label="Preloading / flexible quit date\ndrug started 4 wk before TQD", fillcolor="#C5E1A5"];

    VAR_BR -> PARTIAL_AG; CYT_PK -> CYT_PARTIAL; PARTIAL_AG -> A4B2; CYT_PARTIAL -> A4B2;
    PARTIAL_AG -> RELIEF; PARTIAL_AG -> COMPET_BLOCK; CYT_PARTIAL -> RELIEF; CYT_PARTIAL -> COMPET_BLOCK;
    RELIEF -> DUAL_MECH; COMPET_BLOCK -> DUAL_MECH; DUAL_MECH -> ABST;
    COMPET_BLOCK -> REWARD_LAPSE [arrowhead=tee]; RELIEF -> WD_SYND [arrowhead=tee]; RELIEF -> QSU [arrowhead=tee];
    OHBUP -> BUP_DAT_NET -> NAC_DA; OHBUP -> BUP_NACHR -> A4B2 [arrowhead=tee];
    NRT_PATCH -> NRT_SUB; NRT_PRN -> NRT_SUB; NRT_SUB -> A4B2; NRT_SUB -> RELIEF;
    VAR_BR -> A7_VAR; VAR_BR -> HT3_VAR -> NAUSEA_C;
    PRELOAD -> COMPET_BLOCK; PRELOAD -> CPD [arrowhead=tee, label="pre-quit reduction"];
    NIC_BRAIN -> OCC; VAR_BR -> OCC; CYT_PK -> OCC;
  }

  // =================== 11) Non-nicotine tobacco toxicology ===================
  subgraph cluster_tox {
    label="11) Non-Nicotine Tobacco Toxicology & Drug Interactions"; style="rounded,filled"; fillcolor="#FBE9E7"; color="#BF360C";
    CO_GAS       [label="Carbon monoxide", fillcolor="#FFCCBC"];
    COHB         [label="Carboxyhaemoglobin (COHb %)\nexhaled CO ppm biomarker", fillcolor="#FFAB91"];
    CO_VERIF     [label="CO verification (<10 ppm)\nabstinence confirmation", fillcolor="#FFAB91"];
    PAH          [label="Polycyclic aromatic hydrocarbons (tar)", fillcolor="#FFCCBC"];
    CYP1A2_IND   [label="CYP1A2 induction by PAH\n(NOT nicotine)", fillcolor="#FFCCBC"];
    DDI          [label="Smoking-cessation DDIs\nclozapine · olanzapine · theophylline · caffeine ↑", fillcolor="#FF8A65"];
    ACROLEIN     [label="Acrolein / aldehydes\nairway epithelial injury", fillcolor="#FFCCBC"];
    NNK_NNN      [label="Tobacco-specific nitrosamines\nNNK · NNN (NNAL biomarker)", fillcolor="#FFCCBC"];
    OXSTRESS     [label="Oxidative stress / ROS\n8-isoprostane", fillcolor="#FFCCBC"];
    ENDOTHEL     [label="Endothelial dysfunction\n↓NO bioavailability", fillcolor="#FFCCBC"];
    PLATELET     [label="Platelet activation · fibrinogen ↑", fillcolor="#FFCCBC"];
    INFLAM       [label="Systemic inflammation\nCRP · IL-6 · WBC ↑", fillcolor="#FFCCBC"];
    CARCINOGEN   [label="DNA adducts / carcinogenesis\nlung · bladder · head & neck", fillcolor="#FF8A65"];

    CIG -> CO_GAS -> COHB -> CO_VERIF; CIG -> PAH -> CYP1A2_IND -> DDI;
    CIG -> ACROLEIN; CIG -> NNK_NNN -> CARCINOGEN;
    PAH -> OXSTRESS; ACROLEIN -> OXSTRESS; OXSTRESS -> ENDOTHEL; OXSTRESS -> INFLAM;
    ENDOTHEL -> PLATELET; CPD -> CO_GAS;
  }

  // =================== 12) Organ-system consequences & safety ===================
  subgraph cluster_organ {
    label="12) Organ-System Consequences & Treatment Safety"; style="rounded,filled"; fillcolor="#F9FBE7"; color="#827717";
    HR_BP        [label="Heart rate / blood pressure\nnicotine sympathomimetic (+10–15 bpm)", fillcolor="#E6EE9C"];
    ATHERO       [label="Atherosclerosis progression\nMI · stroke · PAD risk", fillcolor="#E6EE9C"];
    FEV1         [label="FEV1 decline (Fletcher–Peto)\n~60 vs 30 mL/yr; slope normalizes post-quit", fillcolor="#E6EE9C"];
    COPD_RISK    [label="COPD / emphysema risk", fillcolor="#E6EE9C"];
    APPETITE     [label="Appetite regulation\nα3β4 on POMC · leptin · AgRP", fillcolor="#E6EE9C"];
    WEIGHT       [label="Post-cessation weight gain\n~4–5 kg at 12 mo", fillcolor="#E6EE9C"];
    INSULIN_R    [label="Insulin resistance / T2DM risk\ntransient ↑ post-quit", fillcolor="#E6EE9C"];
    BONE         [label="Bone mineral density\n↓ in smokers", fillcolor="#E6EE9C"];
    SLEEP        [label="Sleep architecture\nwithdrawal insomnia · vivid dreams (varenicline)", fillcolor="#E6EE9C"];
    NPS_SAFETY   [label="Neuropsychiatric safety (EAGLES)\nno excess vs placebo", fillcolor="#E6EE9C"];
    CV_SAFETY    [label="CV safety (CATS)\nvarenicline non-inferior", fillcolor="#E6EE9C"];
    SEIZURE      [label="Bupropion seizure risk\n~0.1% (dose-dependent)", fillcolor="#E6EE9C"];
    AE_BURDEN    [label="AE burden → discontinuation\n(nausea · insomnia · skin reaction)", fillcolor="#DCE775"];
    ORAL_HEALTH  [label="Periodontitis / wound healing", fillcolor="#E6EE9C"];
    PREG_OUT     [label="Pregnancy outcomes\nLBW · preterm · placental", fillcolor="#E6EE9C"];

    NIC_C -> HR_BP; ATHERO -> CV_SAFETY; ENDOTHEL -> ATHERO; PLATELET -> ATHERO; INFLAM -> ATHERO;
    ACROLEIN -> FEV1 [arrowhead=tee]; OXSTRESS -> FEV1 [arrowhead=tee]; FEV1 -> COPD_RISK;
    ABST -> FEV1 [label="slope recovery"]; ABST -> ATHERO [arrowhead=tee]; ABST -> CARCINOGEN [arrowhead=tee];
    NIC_C -> APPETITE; ABST -> WEIGHT; APPETITE -> WEIGHT; WEIGHT -> INSULIN_R;
    WD_SYND -> SLEEP; HT3_VAR -> AE_BURDEN; NAUSEA_C -> AE_BURDEN; SLEEP -> AE_BURDEN;
    BUP_PK -> SEIZURE -> AE_BURDEN; AE_BURDEN -> ABST [arrowhead=tee, label="early discontinuation"];
    VAR_BR -> NPS_SAFETY; NIC_C -> BONE [arrowhead=tee]; CIG -> ORAL_HEALTH [arrowhead=tee]; CIG -> PREG_OUT [arrowhead=tee];
    NIC_PREG -> PREG_OUT;
  }

  // =================== 13) Biomarkers, covariates & clinical endpoints ===================
  subgraph cluster_endpoints {
    label="13) Biomarkers · Covariates · Clinical Endpoints"; style="rounded,filled"; fillcolor="#ECEFF1"; color="#263238";
    BM_COT       [label="Plasma/saliva cotinine\ntotal nicotine equivalents (TNE)", fillcolor="#CFD8DC"];
    BM_NMR       [label="NMR (3HC/COT)\nprospective treatment-matching biomarker", fillcolor="#B0BEC5"];
    BM_CO        [label="Exhaled CO (ppm)", fillcolor="#CFD8DC"];
    BM_NNAL      [label="Urinary NNAL", fillcolor="#CFD8DC"];
    BM_PET       [label="β2*-nAChR PET occupancy", fillcolor="#CFD8DC"];
    EP_CAR       [label="CAR weeks 9–12 (primary)\nvarenicline ~33% · bupropion ~22% · patch ~23% · placebo ~13% (EAGLES)", fillcolor="#90A4AE"];
    EP_PP        [label="7-day PP abstinence 24/52 wk", fillcolor="#90A4AE"];
    EP_QSU       [label="ΔQSU craving from baseline", fillcolor="#90A4AE"];
    EP_MNWS      [label="ΔMNWS withdrawal from baseline", fillcolor="#90A4AE"];
    EP_CPD       [label="ΔCPD (reduction endpoint)", fillcolor="#90A4AE"];
    EP_WT        [label="Δweight (kg) at 12 / 52 wk", fillcolor="#90A4AE"];
    EP_AE        [label="AE / discontinuation rate", fillcolor="#90A4AE"];
    COV_SEX      [label="Covariate: sex (♀ ↑CYP2A6, ↓NRT response)", fillcolor="#CFD8DC"];
    COV_AGE      [label="Covariate: age · years smoked", fillcolor="#CFD8DC"];
    COV_PSY      [label="Covariate: psychiatric history", fillcolor="#CFD8DC"];
    COV_ALCOHOL  [label="Covariate: alcohol co-use", fillcolor="#CFD8DC"];

    COT -> BM_COT; NMR -> BM_NMR; COHB -> BM_CO; NNK_NNN -> BM_NNAL; PET_B2 -> BM_PET;
    ABST -> EP_CAR -> EP_PP; QSU -> EP_QSU; WD_SYND -> EP_MNWS; CPD -> EP_CPD; WEIGHT -> EP_WT; AE_BURDEN -> EP_AE;
    BM_NMR -> VAR_PO [label="fast NMR → prefer varenicline", style=dashed];
    BM_NMR -> NRT_PATCH [label="slow NMR → patch sufficient", style=dashed];
    COV_SEX -> CYP2A6; COV_AGE -> HABIT_STR; COV_PSY -> DEPR_COMORB; COV_ALCOHOL -> LAPSE_H;
  }

  // =================== Cross-cluster integrating edges ===================
  DOSE_RATE -> NIC_C [label="input"];
  NIC_BRAIN -> A4B2 [label="agonist"];
  OCC -> VTA_DA [label="activation"];
  DESENS -> VTA_GABA [label="GABA desensitizes first"];
  UPREG -> DA_DEFICIT [label="withdrawal amplification"];
  SPEED_REINF -> REWARD_SIG [label="rate-dependent reinforcement"];
  A6B2B3 -> NAC_DA [label="presynaptic DA release"];
  A7 -> VTA_GLU;
  NMR_FAST -> CPD [label="↑CPD, ↑relapse on NRT", style=dashed];
  NMR_SLOW -> AE_BURDEN [label="↑NRT side effects", style=dashed];
  RESENS -> WD_SYND [label="morning craving", style=dashed];
  D2_AVAIL -> ANHED;
  CO_VERIF -> EP_CAR;
  TITRATE -> VLNC [arrowhead=tee, label="capped by low yield"];
  COUNSEL -> ABST;
  VAR_PK -> NRT_PATCH [label="combination therapy", style=dotted, dir=both];
}
