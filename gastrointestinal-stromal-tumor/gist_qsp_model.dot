digraph GIST_QSP {
  rankdir=LR;
  fontname="Helvetica";
  labelloc="t";
  fontsize=18;
  label="Gastrointestinal Stromal Tumor (GIST) — Mechanistic QSP Map\nICC/ETV1 lineage → KIT/PDGFRA oncogenic driver → polyclonal secondary resistance → sequential TKI pharmacology";
  node [style=filled, fontname="Helvetica", fontsize=10, shape=box];
  edge [fontname="Helvetica", fontsize=8];
  compound=true;

  //==========================================================================
  subgraph cluster_lineage {
    label="1. Cell of Origin & Lineage Dependency (interstitial cells of Cajal)";
    style=filled; color="#dfd3ec"; fillcolor="#f2ecf9";
    ICC_precursor  [label="ICC / ICC-precursor\n(GI pacemaker lineage)"];
    SCF_ligand     [label="SCF / stem cell factor\n(KIT ligand, KITLG)"];
    KIT_expression [label="KIT (CD117)\nsurface expression"];
    ANO1_DOG1      [label="ANO1 / DOG1\n(Ca-activated Cl channel,\ndiagnostic marker)"];
    ETV1_TF        [label="ETV1 master\nlineage transcription factor"];
    ETV1_stability [label="ETV1 protein stabilization\n(MAPK-dependent)"];
    GI_pacemaker   [label="Slow-wave GI\npacemaker function"];
    Interstitial_niche [label="Muscularis propria\ninterstitial niche"];
    Hyperplasia_ICC [label="ICC hyperplasia\n(pre-GIST lesion)"];
    Micro_GIST     [label="Microscopic GIST\n(<1 cm 'tumorlet', ~20-30%\nof adults >50 y at autopsy)"];
  }

  //==========================================================================
  subgraph cluster_driver {
    label="2. Primary Driver Mutations (mutually exclusive genotypes)";
    style=filled; color="#f3d5d5"; fillcolor="#fbecec";
    KIT_ex11 [label="KIT exon 11\njuxtamembrane (~65-70%)\nMOST imatinib-sensitive", fillcolor="#f8c9c9"];
    KIT_ex9  [label="KIT exon 9\nextracellular dimerization (~8-10%)\nsmall bowel, needs 800 mg", fillcolor="#f8c9c9"];
    KIT_ex13_prim [label="KIT exon 13 K642E\n(primary, ~1%)"];
    KIT_ex17_prim [label="KIT exon 17 D820/N822\n(primary, ~1%)"];
    PDGFRA_ex18_D842V [label="PDGFRA exon 18 D842V\n(~5-6%) IMATINIB-RESISTANT", fillcolor="#f5b7b7"];
    PDGFRA_ex12_14 [label="PDGFRA exon 12 / 14\n(imatinib-sensitive)"];
    SDH_deficient [label="SDH-deficient GIST\n(SDHA/B/C/D mut or\nSDHC promoter methylation)", fillcolor="#f5d9b7"];
    NF1_GIST [label="NF1-associated GIST\n(multifocal small bowel)"];
    BRAF_V600E [label="BRAF V600E\n(~1%)"];
    RAS_mut [label="KRAS / NRAS\nmutation (rare)"];
    NTRK_FGFR_fusion [label="NTRK3 / FGFR1\nfusion (rare)"];
    Quadruple_WT [label="Quadruple wild-type\nGIST"];
    Carney_triad [label="Carney triad /\nCarney-Stratakis syndrome"];
    Germline_KIT [label="Germline KIT/PDGFRA\nfamilial GIST syndrome"];
  }

  //==========================================================================
  subgraph cluster_receptor {
    label="3. KIT / PDGFRA Receptor Activation & Conformational States";
    style=filled; color="#cfe2f3"; fillcolor="#e8f2fb";
    JM_autoinhibition [label="Juxtamembrane domain\nautoinhibition (WT brake)"];
    JM_loss [label="Loss of JM autoinhibition\n(exon 11 mutation)"];
    Ligand_indep_dimer [label="Ligand-independent\nreceptor dimerization"];
    Autophosphorylation [label="Trans-autophosphorylation\nY703 / Y719 / Y823"];
    DFG_out [label="Inactive DFG-out\nconformation (type II site)"];
    DFG_in [label="Active DFG-in\nconformation (type I site)"];
    Switch_pocket [label="Switch pocket\n(exon 13/14 switch control)"];
    Activation_loop [label="Activation loop\n(exon 17/18, A-loop)"];
    ATP_pocket [label="ATP-binding pocket\n(exon 13/14)"];
    Gatekeeper_T670 [label="Gatekeeper residue\nT670"];
    KIT_phospho [label="Phospho-KIT signal\n(pKIT, PD driver)", fillcolor="#b9d7f0"];
    KIT_internalization [label="Receptor internalization\n& degradation (CBL)"];
    KIT_amplification [label="KIT gene amplification\n(resistance mechanism)"];
  }

  //==========================================================================
  subgraph cluster_signal {
    label="4. Downstream Oncogenic Signaling";
    style=filled; color="#cfe8dd"; fillcolor="#e8f8f1";
    PI3K [label="PI3K (p110α)"];
    AKT [label="AKT\nphosphorylation"];
    mTORC1 [label="mTORC1"];
    S6K_4EBP1 [label="S6K1 / 4E-BP1\n(translation)"];
    PTEN [label="PTEN\n(negative regulator)"];
    RAS_GTP [label="RAS-GTP"];
    RAF [label="RAF (CRAF/BRAF)"];
    MEK12 [label="MEK1/2"];
    ERK12 [label="ERK1/2\nphosphorylation"];
    JAK_STAT3 [label="JAK2 / STAT3"];
    SRC_family [label="SRC-family kinases\n(LYN, FYN)"];
    PLCg [label="PLCγ1 / PKC-θ"];
    FOXO3a [label="FOXO3a\n(released on AKT inhibition)"];
    GLUT1 [label="GLUT1 / hexokinase\n(glucose uptake)"];
  }

  //==========================================================================
  subgraph cluster_cycle {
    label="5. Cell Cycle, Apoptosis, Autophagy & Drug-Tolerant Persistence";
    style=filled; color="#f5e6c8"; fillcolor="#fcf5e7";
    MYC [label="MYC"];
    CCND1 [label="Cyclin D1 / D3"];
    CDK4_6 [label="CDK4 / CDK6"];
    RB_phospho [label="Rb phosphorylation\n→ E2F release"];
    CDKN2A_del [label="CDKN2A/p16 deletion\n(progression event)"];
    DMD_deletion [label="Dystrophin (DMD)\ndeletion (metastasis)"];
    Mitotic_index [label="Mitotic index\n(/5 mm², risk criterion)"];
    Proliferation [label="Tumor cell\nproliferation rate", fillcolor="#f2d79b"];
    BIM_BCL2L11 [label="BIM (BCL2L11)\npro-apoptotic induction"];
    BIM_polymorphism [label="BIM intron-2 2903-bp\ndeletion polymorphism\n(~12% East Asian)", fillcolor="#f2d79b"];
    MCL1_BCLxL [label="MCL-1 / BCL-xL\n(anti-apoptotic)"];
    Caspase39 [label="Caspase-9 / -3\nactivation"];
    Apoptosis [label="Tumor cell\napoptosis", fillcolor="#f2d79b"];
    Autophagy_LC3 [label="Autophagy (LC3-II,\nATG7-dependent)"];
    Quiescent_persister [label="Quiescent drug-tolerant\npersister pool\n(source of relapse)", fillcolor="#f2d79b"];
    Myxoid_degeneration [label="Myxoid / cystic\ndegeneration"];
  }

  //==========================================================================
  subgraph cluster_sdh {
    label="6. SDH-Deficient / Pseudohypoxia Axis (KIT-independent biology)";
    style=filled; color="#f0dcc4"; fillcolor="#fbf1e3";
    SDH_complexII [label="Succinate dehydrogenase\n(mitochondrial complex II)"];
    Succinate_accum [label="Succinate\naccumulation"];
    PHD_inhibition [label="Prolyl hydroxylase\n(PHD) inhibition"];
    HIF1a [label="HIF-1α\nstabilization"];
    VEGFA_sdh [label="VEGF-A\ntranscription ↑"];
    IGF1R_over [label="IGF1R\noverexpression"];
    DNA_hypermethylation [label="Global DNA\nhypermethylation"];
    SDHB_IHC_loss [label="SDHB IHC loss\n(diagnostic)"];
    Pediatric_pheno [label="Young/pediatric, gastric,\nmultifocal, epithelioid,\nnodal metastasis phenotype"];
    Indolent_course [label="Indolent but\nchemo/TKI-refractory course"];
  }

  //==========================================================================
  subgraph cluster_tme {
    label="7. Tumor Microenvironment, Angiogenesis & Immunity";
    style=filled; color="#dcecd3"; fillcolor="#eef8e8";
    VEGFA [label="VEGF-A"];
    VEGFR2 [label="VEGFR-2 (KDR)\nendothelial"];
    Microvessel_density [label="Microvessel density /\ntumor perfusion", fillcolor="#c9e3b8"];
    PDGFRB_pericyte [label="PDGFR-β pericyte\ncoverage"];
    TIE2_ANGPT [label="TIE2 / angiopoietin-2"];
    FGF2_bypass [label="FGF2-FGFR bypass\nsignaling (TKI escape)"];
    AXL_MET [label="AXL / MET\nkinase switch"];
    TAM_M2 [label="Tumor-associated\nmacrophages (M2)"];
    IDO_Treg [label="IDO / Treg\nimmunosuppression"];
    CD8_Tcell [label="CD8+ tumor-infiltrating\nlymphocytes"];
    PD1_PDL1 [label="PD-1 / PD-L1 axis\n(imatinib ↑ CD8 via IDO ↓)"];
    NK_cells [label="NK-cell activity\n(imatinib-augmented)"];
    ECM_collagen [label="ECM / collagen\nstroma"];
    Interstitial_pressure [label="Interstitial fluid\npressure"];
  }

  //==========================================================================
  subgraph cluster_clonal {
    label="8. Clonal Evolution & Secondary (Acquired) Resistance";
    style=filled; color="#f2cfd8"; fillcolor="#fbe8ed";
    Clone_sensitive [label="Sensitive clone\n(primary driver only)", fillcolor="#f6bccb"];
    Selective_pressure [label="TKI selective\npressure"];
    Mutation_acquisition [label="Secondary mutation\nacquisition (kinase domain)"];
    Sec_V654A [label="Exon 13 V654A\n(ATP pocket)", fillcolor="#f6bccb"];
    Sec_T670I [label="Exon 14 T670I\n(gatekeeper)", fillcolor="#f6bccb"];
    Sec_D816 [label="Exon 17 D816H/V\n(activation loop)", fillcolor="#f6bccb"];
    Sec_D820_N822K [label="Exon 17 D820Y / N822K", fillcolor="#f6bccb"];
    Sec_Y823D [label="Exon 17 Y823D", fillcolor="#f6bccb"];
    Polyclonal_resistance [label="POLYCLONAL resistance:\ndifferent mutations in\ndifferent metastases", fillcolor="#f19bb2"];
    Intralesional_hetero [label="Intra-lesional\nheterogeneity"];
    Nodule_in_mass [label="'Nodule-in-a-mass'\nradiologic progression"];
    KIT_independent_escape [label="KIT-independent escape\n(bypass / lineage switch)"];
    Clonal_sweep [label="Clonal sweep on\ndrug withdrawal (rebound)"];
  }

  //==========================================================================
  subgraph cluster_imatinib {
    label="9. Imatinib PK / PD (1st line; type II, DFG-out binder)";
    style=filled; color="#cddff0"; fillcolor="#e7f0fa";
    IMA_dose [label="Imatinib 400 mg/d PO\n(800 mg for exon 9)", shape=ellipse, fillcolor="#a9c9ea"];
    IMA_absorb [label="Near-complete oral\nabsorption (F ≈ 98%)"];
    hOCT1 [label="hOCT1 (SLC22A1)\ninflux transporter"];
    ABCB1_ABCG2 [label="ABCB1 / ABCG2\nefflux transporters"];
    CYP3A4_ima [label="CYP3A4 / CYP2C8\nmetabolism"];
    CGP74588 [label="CGP74588\nactive N-desmethyl metabolite"];
    AAG_binding [label="α1-acid glycoprotein\nbinding (fu ≈ 5%)", fillcolor="#a9c9ea"];
    IMA_free [label="Free (unbound)\nimatinib concentration", fillcolor="#a9c9ea"];
    IMA_Cmin [label="Steady-state trough Cmin\nthreshold ≈ 1100 ng/mL", fillcolor="#a9c9ea"];
    IMA_TDM [label="Therapeutic drug monitoring\n& dose escalation"];
    IMA_clearance_drift [label="Time-dependent clearance\n(~30% exposure fall by 1 y)"];
    IMA_DDI [label="CYP3A4 DDI\n(rifampin ↓, ketoconazole ↑)"];
    IMA_adherence [label="Adherence\n(chronic oral therapy)"];
    IMA_KIT_binding [label="Binds inactive DFG-out\nKIT/PDGFRA/ABL"];
  }

  //==========================================================================
  subgraph cluster_sun_reg {
    label="10. Sunitinib & Regorafenib PK / PD (2nd & 3rd line multikinase)";
    style=filled; color="#d6e3f5"; fillcolor="#ecf2fc";
    SUN_dose [label="Sunitinib 50 mg 4/2\nor 37.5 mg continuous", shape=ellipse, fillcolor="#b3c9ea"];
    SUN_metab [label="CYP3A4 → SU12662\n(equipotent metabolite)"];
    SUN_targets [label="KIT, VEGFR1-3, PDGFR,\nFLT3, RET, CSF1R"];
    SUN_ex13_activity [label="Potent on exon 13/14\nATP-pocket mutants", fillcolor="#b3c9ea"];
    SUN_ex17_gap [label="Weak on exon 17\nactivation-loop mutants", fillcolor="#b3c9ea"];
    REG_dose [label="Regorafenib 160 mg 3/1", shape=ellipse, fillcolor="#b3c9ea"];
    REG_metab [label="CYP3A4/UGT1A9 → M-2, M-5\n(active metabolites)"];
    REG_ex17_activity [label="Activity on exon 17\nmutants", fillcolor="#b3c9ea"];
    REG_targets [label="KIT, VEGFR1-3, TIE2,\nRAF, RET, PDGFR, FGFR"];
    Antiangiogenic_effect [label="Anti-angiogenic\ncomponent of effect"];
  }

  //==========================================================================
  subgraph cluster_new_tki {
    label="11. Ripretinib, Avapritinib & Genotype-Directed Agents";
    style=filled; color="#e0d7f2"; fillcolor="#f0ebfa";
    RIP_dose [label="Ripretinib 150 mg/d\n(DCC-2618)", shape=ellipse, fillcolor="#c5b6e6"];
    RIP_switch_control [label="SWITCH-CONTROL mechanism:\nbinds switch pocket +\nactivation loop", fillcolor="#c5b6e6"];
    RIP_broad [label="Broad-spectrum: exon\n9/11/13/14/17/18", fillcolor="#c5b6e6"];
    DP5439 [label="DP-5439\nactive metabolite"];
    AVA_dose [label="Avapritinib 300 mg/d\n(BLU-285)", shape=ellipse, fillcolor="#c5b6e6"];
    AVA_type1 [label="TYPE I inhibitor —\nbinds ACTIVE conformation", fillcolor="#c5b6e6"];
    AVA_D842V [label="Potent on PDGFRA D842V\n(ORR ~88-95%)", fillcolor="#c5b6e6"];
    Bezuclastinib [label="Bezuclastinib\n(exon 17-selective, trials)"];
    Larotrectinib [label="Larotrectinib /\nentrectinib (NTRK fusion)"];
    BRAF_MEK_combo [label="Dabrafenib + trametinib\n(BRAF V600E)"];
    Cabozantinib [label="Cabozantinib / pazopanib\n(investigational)"];
    Surgery_debulk [label="Cytoreductive surgery /\nablation of resistant nodule"];
    Adjuvant_3y [label="Adjuvant imatinib × 3 y\n(high-risk resected)"];
  }

  //==========================================================================
  subgraph cluster_endpoints {
    label="12. Tumor Burden, Imaging & Clinical Endpoints";
    style=filled; color="#cfe5e5"; fillcolor="#e7f5f5";
    Tumor_burden [label="Total tumor burden\n(sum of lesions)", fillcolor="#a9d5d5"];
    Liver_mets [label="Hepatic metastases\n(dominant site)"];
    Peritoneal_mets [label="Peritoneal\nsarcomatosis"];
    RECIST_size [label="RECIST 1.1\nlongest-diameter sum", fillcolor="#a9d5d5"];
    Choi_density [label="Choi criteria: CT density\n(HU) ≥15% fall", fillcolor="#a9d5d5"];
    FDG_SUV [label="FDG-PET SUVmax\n(falls within 24-48 h)", fillcolor="#a9d5d5"];
    ctDNA_VAF [label="Plasma ctDNA KIT VAF\n(polyclonal resistance detection)", fillcolor="#a9d5d5"];
    Molecular_progression [label="Molecular progression\nPRECEDES radiologic", fillcolor="#8fc9c9"];
    PFS [label="Progression-free\nsurvival"];
    OS_endpoint [label="Overall survival"];
    Risk_strat [label="AFIP/Miettinen risk:\nsize × mitoses × site"];
    Tumor_rupture [label="Tumor rupture\n(highest-risk feature)"];
    GI_bleed [label="GI bleeding / anemia\n(mucosal ulceration)"];
    Abd_symptoms [label="Abdominal mass, pain,\nearly satiety, obstruction"];
    QoL_endpoint [label="Quality of life /\nperformance status"];
  }

  //==========================================================================
  subgraph cluster_tox {
    label="13. Organ-System Toxicity & Tolerability";
    style=filled; color="#f5dede"; fillcolor="#fcefef";
    Periorbital_edema [label="Periorbital / peripheral edema\n(PDGFR-β inhibition)", fillcolor="#f0c3c3"];
    Myelosuppression [label="Neutropenia / anemia\n(KIT on progenitors)", fillcolor="#f0c3c3"];
    Hepatotoxicity [label="Transaminase elevation /\nhepatotoxicity", fillcolor="#f0c3c3"];
    Hypothyroidism [label="Hypothyroidism\n(sunitinib, TSH ↑)", fillcolor="#f0c3c3"];
    Hypertension_tox [label="Hypertension\n(VEGFR blockade)", fillcolor="#f0c3c3"];
    HFSR [label="Hand-foot skin reaction\n(regorafenib, sunitinib)", fillcolor="#f0c3c3"];
    Alopecia_rip [label="Alopecia / PPES\n(ripretinib)", fillcolor="#f0c3c3"];
    Cognitive_ICH [label="Cognitive effects /\nintracranial bleed (avapritinib)", fillcolor="#f0c3c3"];
    Muscle_cramps [label="Muscle cramps,\nfatigue, nausea"];
    Cardiac_LVEF [label="LVEF decline\n(sunitinib)"];
    Dose_reduction [label="Dose reduction /\ninterruption"];
    Exposure_loss [label="Loss of effective\nexposure"];
  }

  //==========================================================================
  subgraph cluster_management {
    label="14. Management Strategy & Decision Nodes";
    style=filled; color="#e3e3e3"; fillcolor="#f2f2f2";
    Mutation_testing [label="Mandatory mutational\ngenotyping at diagnosis", shape=diamond, fillcolor="#d0d0d0"];
    Neoadjuvant [label="Neoadjuvant imatinib\n(organ preservation)"];
    Complete_resection [label="Complete R0\nresection"];
    Micrometastatic [label="Micrometastatic\nresidual disease"];
    Continuation_decision [label="Continue vs interrupt TKI\n(BFR14: interruption →\nrapid regrowth)", shape=diamond, fillcolor="#d0d0d0"];
    Line_sequencing [label="Line sequencing:\nIMA → SUN → REG → RIP", shape=diamond, fillcolor="#d0d0d0"];
    INTRIGUE_result [label="INTRIGUE: ripretinib not\nsuperior to sunitinib overall;\nctDNA subgroups differ", shape=diamond, fillcolor="#d0d0d0"];
    Rechallenge [label="Imatinib rechallenge\n(RIGHT trial)"];
    Trial_referral [label="Clinical trial referral\n(quadruple-WT, SDH-def)"];
  }

  //==========================================================================
  // ---- Lineage & driver wiring
  ICC_precursor -> KIT_expression;
  SCF_ligand -> KIT_expression [label="ligand"];
  KIT_expression -> ANO1_DOG1;
  KIT_expression -> GI_pacemaker;
  Interstitial_niche -> ICC_precursor;
  ETV1_TF -> KIT_expression [label="lineage program"];
  ICC_precursor -> ETV1_TF;
  ICC_precursor -> Hyperplasia_ICC;
  Hyperplasia_ICC -> Micro_GIST;
  Micro_GIST -> Clone_sensitive;
  Germline_KIT -> Hyperplasia_ICC;
  Carney_triad -> SDH_deficient;

  KIT_ex11 -> JM_loss;
  JM_autoinhibition -> Ligand_indep_dimer [label="restrains", style=dashed, color=firebrick];
  JM_loss -> Ligand_indep_dimer;
  KIT_ex9 -> Ligand_indep_dimer;
  KIT_ex13_prim -> Autophosphorylation;
  KIT_ex17_prim -> Activation_loop;
  PDGFRA_ex18_D842V -> DFG_in [label="locks active"];
  PDGFRA_ex12_14 -> Ligand_indep_dimer;
  NF1_GIST -> RAS_GTP;
  BRAF_V600E -> RAF;
  RAS_mut -> RAS_GTP;
  NTRK_FGFR_fusion -> RAS_GTP;
  Quadruple_WT -> Trial_referral;
  SDH_deficient -> SDH_complexII [label="loss of function"];

  Ligand_indep_dimer -> Autophosphorylation;
  Autophosphorylation -> KIT_phospho;
  DFG_out -> ATP_pocket;
  DFG_in -> Activation_loop;
  Switch_pocket -> Activation_loop [label="switch control"];
  Gatekeeper_T670 -> ATP_pocket;
  KIT_phospho -> KIT_internalization;
  KIT_amplification -> KIT_phospho;

  // ---- Signaling
  KIT_phospho -> PI3K;
  KIT_phospho -> RAS_GTP;
  KIT_phospho -> JAK_STAT3;
  KIT_phospho -> SRC_family;
  KIT_phospho -> PLCg;
  PI3K -> AKT;
  PTEN -> PI3K [label="inhibits", style=dashed, color=firebrick];
  AKT -> mTORC1;
  mTORC1 -> S6K_4EBP1;
  AKT -> FOXO3a [label="phosphorylates/inactivates", style=dashed, color=firebrick];
  RAS_GTP -> RAF;
  RAF -> MEK12;
  MEK12 -> ERK12;
  ERK12 -> ETV1_stability;
  ETV1_TF -> ETV1_stability;
  ETV1_stability -> MYC;
  ERK12 -> CCND1;
  S6K_4EBP1 -> Proliferation;
  AKT -> GLUT1;
  ERK12 -> GLUT1;
  GLUT1 -> FDG_SUV;

  // ---- Cycle / apoptosis
  MYC -> CCND1;
  CCND1 -> CDK4_6;
  CDK4_6 -> RB_phospho;
  CDKN2A_del -> CDK4_6 [label="loss of p16 brake"];
  RB_phospho -> Proliferation;
  Proliferation -> Mitotic_index;
  Mitotic_index -> Risk_strat;
  DMD_deletion -> Liver_mets;
  FOXO3a -> BIM_BCL2L11 [label="transcribes"];
  ERK12 -> BIM_BCL2L11 [label="degrades BIM", style=dashed, color=firebrick];
  BIM_polymorphism -> BIM_BCL2L11 [label="deletes BH3 exon", style=dashed, color=firebrick];
  BIM_BCL2L11 -> Caspase39;
  MCL1_BCLxL -> Caspase39 [label="blocks", style=dashed, color=firebrick];
  Caspase39 -> Apoptosis;
  Apoptosis -> Myxoid_degeneration;
  Myxoid_degeneration -> Choi_density [label="density falls"];
  AKT -> Autophagy_LC3 [label="suppresses", style=dashed, color=firebrick];
  Autophagy_LC3 -> Quiescent_persister;
  Quiescent_persister -> Clone_sensitive [label="re-seeds on withdrawal"];
  Apoptosis -> ctDNA_VAF [label="DNA shedding"];

  // ---- SDH axis
  SDH_complexII -> Succinate_accum [style=dashed, color=firebrick, label="loss → accumulate"];
  Succinate_accum -> PHD_inhibition;
  PHD_inhibition -> HIF1a;
  HIF1a -> VEGFA_sdh;
  HIF1a -> IGF1R_over;
  Succinate_accum -> DNA_hypermethylation;
  DNA_hypermethylation -> Pediatric_pheno;
  SDH_complexII -> SDHB_IHC_loss;
  VEGFA_sdh -> VEGFA;
  IGF1R_over -> PI3K;
  Pediatric_pheno -> Indolent_course;
  Indolent_course -> Trial_referral;

  // ---- TME / angiogenesis
  VEGFA -> VEGFR2;
  VEGFR2 -> Microvessel_density;
  PDGFRB_pericyte -> Microvessel_density;
  TIE2_ANGPT -> Microvessel_density;
  Microvessel_density -> Proliferation [label="nutrient/O2 supply"];
  ECM_collagen -> Interstitial_pressure;
  Interstitial_pressure -> IMA_free [label="limits delivery", style=dashed, color=firebrick];
  FGF2_bypass -> RAS_GTP;
  AXL_MET -> PI3K;
  KIT_independent_escape -> FGF2_bypass;
  KIT_independent_escape -> AXL_MET;
  TAM_M2 -> IDO_Treg;
  IDO_Treg -> CD8_Tcell [label="suppresses", style=dashed, color=firebrick];
  CD8_Tcell -> Apoptosis;
  PD1_PDL1 -> CD8_Tcell [label="checkpoint", style=dashed, color=firebrick];
  NK_cells -> Apoptosis;
  IMA_KIT_binding -> IDO_Treg [label="↓ IDO, ↑ CD8", style=dashed, color=firebrick];

  // ---- Clonal evolution
  Clone_sensitive -> Proliferation;
  Selective_pressure -> Mutation_acquisition;
  Clone_sensitive -> Mutation_acquisition [label="mutant supply ∝ clone size"];
  Mutation_acquisition -> Sec_V654A;
  Mutation_acquisition -> Sec_T670I;
  Mutation_acquisition -> Sec_D816;
  Mutation_acquisition -> Sec_D820_N822K;
  Mutation_acquisition -> Sec_Y823D;
  Sec_V654A -> ATP_pocket;
  Sec_T670I -> Gatekeeper_T670;
  Sec_D816 -> Activation_loop;
  Sec_D820_N822K -> Activation_loop;
  Sec_Y823D -> Activation_loop;
  Sec_V654A -> Polyclonal_resistance;
  Sec_D816 -> Polyclonal_resistance;
  Sec_D820_N822K -> Polyclonal_resistance;
  Polyclonal_resistance -> Intralesional_hetero;
  Intralesional_hetero -> Nodule_in_mass;
  Nodule_in_mass -> RECIST_size;
  Polyclonal_resistance -> ctDNA_VAF;
  ctDNA_VAF -> Molecular_progression;
  Molecular_progression -> Line_sequencing;
  Quiescent_persister -> Clonal_sweep;
  Clonal_sweep -> Tumor_burden;

  // ---- Imatinib PK/PD
  IMA_dose -> IMA_absorb;
  IMA_absorb -> AAG_binding;
  hOCT1 -> IMA_free [label="cellular influx"];
  ABCB1_ABCG2 -> IMA_free [label="efflux", style=dashed, color=firebrick];
  IMA_absorb -> CYP3A4_ima;
  CYP3A4_ima -> CGP74588;
  CGP74588 -> IMA_KIT_binding;
  CYP3A4_ima -> IMA_Cmin [label="clearance", style=dashed, color=firebrick];
  IMA_DDI -> CYP3A4_ima;
  IMA_clearance_drift -> IMA_Cmin [style=dashed, color=firebrick];
  AAG_binding -> IMA_free [label="fu ≈ 5%", style=dashed, color=firebrick];
  IMA_absorb -> IMA_Cmin;
  IMA_Cmin -> IMA_free;
  IMA_Cmin -> IMA_TDM;
  IMA_TDM -> IMA_dose [label="escalate if <1100 ng/mL"];
  IMA_adherence -> IMA_Cmin;
  IMA_free -> IMA_KIT_binding;
  IMA_KIT_binding -> DFG_out [label="stabilizes inactive"];
  DFG_out -> KIT_phospho [label="blocks", style=dashed, color=firebrick];
  IMA_KIT_binding -> Periorbital_edema;
  IMA_KIT_binding -> Myelosuppression;
  IMA_KIT_binding -> Hepatotoxicity;
  IMA_KIT_binding -> Muscle_cramps;

  // ---- Sunitinib / regorafenib
  SUN_dose -> SUN_metab;
  SUN_metab -> SUN_targets;
  SUN_targets -> SUN_ex13_activity;
  SUN_targets -> SUN_ex17_gap;
  SUN_ex13_activity -> Sec_V654A [label="suppresses", style=dashed, color=firebrick];
  SUN_ex13_activity -> Sec_T670I [label="suppresses", style=dashed, color=firebrick];
  SUN_targets -> VEGFR2 [label="blocks", style=dashed, color=firebrick];
  SUN_targets -> Hypothyroidism;
  SUN_targets -> Hypertension_tox;
  SUN_targets -> HFSR;
  SUN_targets -> Cardiac_LVEF;
  REG_dose -> REG_metab;
  REG_metab -> REG_targets;
  REG_targets -> REG_ex17_activity;
  REG_ex17_activity -> Sec_D816 [label="suppresses", style=dashed, color=firebrick];
  REG_ex17_activity -> Sec_D820_N822K [label="suppresses", style=dashed, color=firebrick];
  REG_targets -> VEGFR2 [label="blocks", style=dashed, color=firebrick];
  REG_targets -> TIE2_ANGPT [label="blocks", style=dashed, color=firebrick];
  REG_targets -> HFSR;
  REG_targets -> Hypertension_tox;
  Antiangiogenic_effect -> Microvessel_density [label="reduces", style=dashed, color=firebrick];
  SUN_targets -> Antiangiogenic_effect;
  REG_targets -> Antiangiogenic_effect;

  // ---- Ripretinib / avapritinib
  RIP_dose -> RIP_switch_control;
  RIP_dose -> DP5439;
  DP5439 -> RIP_switch_control;
  RIP_switch_control -> Switch_pocket;
  RIP_switch_control -> Activation_loop [label="dual-site block", style=dashed, color=firebrick];
  RIP_switch_control -> RIP_broad;
  RIP_broad -> Sec_D816 [label="suppresses", style=dashed, color=firebrick];
  RIP_broad -> Sec_V654A [label="partial", style=dashed, color=firebrick];
  RIP_broad -> Sec_Y823D [label="suppresses", style=dashed, color=firebrick];
  RIP_dose -> Alopecia_rip;
  AVA_dose -> AVA_type1;
  AVA_type1 -> DFG_in [label="binds active state"];
  AVA_type1 -> AVA_D842V;
  AVA_D842V -> PDGFRA_ex18_D842V [label="suppresses", style=dashed, color=firebrick];
  AVA_dose -> Cognitive_ICH;
  Bezuclastinib -> Sec_D816 [label="exon 17 selective", style=dashed, color=firebrick];
  Larotrectinib -> NTRK_FGFR_fusion [style=dashed, color=firebrick];
  BRAF_MEK_combo -> BRAF_V600E [style=dashed, color=firebrick];
  Cabozantinib -> Antiangiogenic_effect;
  Surgery_debulk -> Tumor_burden [label="debulks", style=dashed, color=firebrick];

  // ---- Burden & endpoints
  Proliferation -> Tumor_burden;
  Apoptosis -> Tumor_burden [label="reduces", style=dashed, color=firebrick];
  Tumor_burden -> Liver_mets;
  Tumor_burden -> Peritoneal_mets;
  Tumor_burden -> RECIST_size;
  Tumor_burden -> Abd_symptoms;
  Tumor_burden -> GI_bleed;
  RECIST_size -> PFS;
  Choi_density -> PFS [label="earlier signal"];
  FDG_SUV -> PFS [label="earliest signal"];
  PFS -> OS_endpoint;
  Abd_symptoms -> QoL_endpoint;
  GI_bleed -> QoL_endpoint;
  Risk_strat -> Adjuvant_3y;
  Tumor_rupture -> Risk_strat;
  Tumor_rupture -> Peritoneal_mets;

  // ---- Toxicity → exposure feedback
  Periorbital_edema -> Dose_reduction;
  Myelosuppression -> Dose_reduction;
  Hepatotoxicity -> Dose_reduction;
  HFSR -> Dose_reduction;
  Hypertension_tox -> Dose_reduction;
  Alopecia_rip -> QoL_endpoint;
  Cognitive_ICH -> Dose_reduction;
  Hypothyroidism -> QoL_endpoint;
  Cardiac_LVEF -> Dose_reduction;
  Muscle_cramps -> IMA_adherence [label="impairs", style=dashed, color=firebrick];
  Dose_reduction -> Exposure_loss;
  Exposure_loss -> IMA_Cmin [style=dashed, color=firebrick];
  Exposure_loss -> Selective_pressure [label="sub-therapeutic → resistance"];

  // ---- Management decisions
  Mutation_testing -> KIT_ex11;
  Mutation_testing -> KIT_ex9;
  Mutation_testing -> PDGFRA_ex18_D842V;
  Mutation_testing -> SDH_deficient;
  Mutation_testing -> Line_sequencing;
  Neoadjuvant -> Complete_resection;
  IMA_dose -> Neoadjuvant;
  Complete_resection -> Micrometastatic;
  Micrometastatic -> Clone_sensitive;
  Adjuvant_3y -> Micrometastatic [label="suppresses", style=dashed, color=firebrick];
  Continuation_decision -> Clonal_sweep;
  Line_sequencing -> SUN_dose;
  Line_sequencing -> REG_dose;
  Line_sequencing -> RIP_dose;
  Line_sequencing -> Rechallenge;
  INTRIGUE_result -> Line_sequencing;
  ctDNA_VAF -> INTRIGUE_result [label="exon 13/14 → sunitinib\nexon 17/18 → ripretinib"];
  Selective_pressure -> Clone_sensitive [label="depletes", style=dashed, color=firebrick];
  IMA_KIT_binding -> Selective_pressure;
  SUN_targets -> Selective_pressure;
  REG_targets -> Selective_pressure;
  RIP_broad -> Selective_pressure;
}
