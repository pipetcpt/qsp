/* ===========================================================================
   oic_qsp_model.dot
   Opioid-Induced Constipation (OIC) — mechanistic QSP map
   오피오이드 유발 변비 — 기계론적 QSP 지도

   The organising idea of the map
     Read it as ONE receptor drawn TWICE.  The mu-opioid receptor in the
     myenteric and submucosal plexus (LEFT/CENTRE) and the mu-opioid receptor
     in the CNS (RIGHT) are the same protein binding the same agonist.  The
     only thing that separates them is the blood-brain barrier, and the only
     thing that runs the blood-brain barrier is P-glycoprotein.  Every
     therapeutic claim in this disease is therefore a RATIO of two occupancies
     taken across that one membrane — not a potency, and not a selectivity that
     has to be asserted.

     The second idea is the loop at the bottom left.  Colonic transit and stool
     hydration feed each other: slower transit means more contact time means
     drier stool means harder to propel means slower transit.  That loop is why
     a drug that wins ~0.5 of enteric receptor occupancy buys a ~3-fold change
     in bowel-movement frequency, and why it is the same loop that osmotic
     laxatives and secretagogues plug into from the other side.

   Reading order
      1  opioid PK: absorption, metabolism, the two destinations
      2  the blood-brain barrier and P-glycoprotein — the selectivity organ
      3  CNS mu receptor: analgesia, tolerance, withdrawal
      4  receptor trafficking — why tolerance is asymmetric
      5  myenteric plexus: the motility arm
      6  submucosal plexus: the secretion arm
      7  Gi/Gs convergence on adenylyl cyclase
      8  interstitial cells of Cajal, smooth muscle, motor patterns
      9  the four-segment colonic transit chain
     10  epithelial ion transport and the water balance
     11  the transit-hydration positive feedback loop
     12  anorectal function: sphincter tone, RAIR, rectal sensation
     13  microbiome, fermentation, gas
     14  PAMORAs — the four drugs and their Kp,uu
     15  secretagogues and prokinetics
     16  osmotic, stimulant and bulk laxatives
     17  drug-drug interactions that move Kp,uu or clearance
     18  clinical endpoints, symptom scores, complications

   Colour key
     opioid / agonist .............. salmon
     antagonist / PAMORA ........... pale green
     barrier / transporter ......... gold
     CNS ........................... lavender
     enteric neuron ................ light blue
     second messenger .............. periwinkle
     epithelium / ion transport .... pale cyan
     smooth muscle / motility ...... wheat
     lumen / content ............... light grey
     microbiome .................... pale olive
     other drug class .............. pale pink
     clinical endpoint ............. light yellow
     complication .................. light coral
   =========================================================================== */

digraph OIC_QSP {
    graph [rankdir=LR, splines=spline, overlap=false, nodesep=0.30, ranksep=1.05, newrank=true,
           fontname="Helvetica", fontsize=11,
           labelloc="t", fontcolor="#1a1a1a",
           label=<<B>Opioid-Induced Constipation — Quantitative Systems Pharmacology Map</B><BR/>
                  <FONT POINT-SIZE="12">오피오이드 유발 변비 (OIC) · 160 nodes · 236 edges · 18 clusters<BR/>
                  One receptor, two compartments, one barrier: the therapeutic window of a PAMORA is a ratio, not a potency</FONT>>];
    node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10,
           color="#555555", penwidth=1.0];
    edge  [fontname="Helvetica", fontsize=8, color="#666666", arrowsize=0.7];

    /* ---------- 1. OPIOID PK ------------------------------------------- */
    subgraph cluster_pk {
        label="1 · 오피오이드 PK (Opioid pharmacokinetics)";
        style="rounded,filled"; fillcolor="#fff2ee"; color="#c98f7e"; fontsize=13;
        OP_DOSE   [label="경구 오피오이드 용량\nOral opioid dose\n(oxycodone 60 mg/day)", fillcolor="#f4a582"];
        OP_DEPOT  [label="위·소장 depot\nGI depot", fillcolor="#f4a582"];
        OP_FPM    [label="장·간 초회통과\nfirst-pass (CYP3A4/2D6)", fillcolor="#f4a582"];
        OP_PORTAL [label="문맥 혈류\nportal flow (60 L/h)\n→ 전신 전 장벽 노출", fillcolor="#f4a582"];
        OP_PLASMA [label="혈장 오피오이드\nplasma opioid\nfu 0.55", fillcolor="#f4a582"];
        OP_PERIPH [label="말초 구획\nperipheral compartment", fillcolor="#f4a582"];
        OP_LUMEN  [label="장관 내강 오피오이드\nluminal opioid\n(경구 투여 특이적)", fillcolor="#f4a582"];
        OP_M1     [label="활성 대사체\noxymorphone / M6G", fillcolor="#f4a582"];
        OP_CLR    [label="간 청소율\nCL 45 L/h", fillcolor="#f4a582"];
        OP_ALT1   [label="모르핀 (Kp,uu ~0.3)\nP-gp 기질", fillcolor="#f6c4ad"];
        OP_ALT2   [label="메타돈\nMOR + ClC-2 차단", fillcolor="#f6c4ad"];
        OP_ALT3   [label="펜타닐 (경피)\n내강 노출 없음", fillcolor="#f6c4ad"];
        OP_ALT4   [label="트라마돌·코데인\nCYP2D6 의존 프로드러그", fillcolor="#f6c4ad"];
    }

    /* ---------- 2. BLOOD-BRAIN BARRIER --------------------------------- */
    subgraph cluster_bbb {
        label="2 · 혈액뇌장벽과 P-당단백 (BBB · the selectivity organ)";
        style="rounded,filled"; fillcolor="#fffaea"; color="#c9a227"; fontsize=13;
        BBB_TJ    [label="뇌모세혈관 내피 밀착연접\nBBB tight junction", fillcolor="#ffe699"];
        PGP       [label="P-당단백 (ABCB1)\nP-glycoprotein efflux", fillcolor="#ffd24d"];
        BCRP      [label="BCRP (ABCG2)", fillcolor="#ffe699"];
        KPUU      [label="Kp,uu = 뇌 유리농도 / 혈장 유리농도\nthe ONE number that sets selectivity", fillcolor="#ffd24d", shape=box, penwidth=2.2];
        OP_BRAIN  [label="뇌 유리 오피오이드\nbrain unbound opioid\noxycodone Kp,uu ≈ 3 (능동 유입)", fillcolor="#f4a582"];
        ABCB1_G   [label="ABCB1 3435C>T 유전형\nP-gp 발현 변이", fillcolor="#ffe699"];
        BBB_INFLM [label="염증·패혈증에 의한\nBBB 투과성 증가", fillcolor="#ffe699"];
    }

    /* ---------- 3. CNS MU RECEPTOR ------------------------------------- */
    subgraph cluster_cns {
        label="3 · 중추 MOR: 진통·내성·금단 (CNS mu receptor)";
        style="rounded,filled"; fillcolor="#f4f0fb"; color="#8b7bb8"; fontsize=13;
        MOR_CNS   [label="중추 MOR\nCNS mu-opioid receptor\n(PAG · RVM · 척수후각 · LC)", fillcolor="#cdb4e8", penwidth=2.0];
        PAG       [label="수도관주위회백질 PAG\n하행 억제 활성화", fillcolor="#ddcdf0"];
        RVM       [label="문측 복내측 연수 RVM\noff-cell / on-cell", fillcolor="#ddcdf0"];
        DH        [label="척수 후각\ndorsal horn 전달 억제", fillcolor="#ddcdf0"];
        LC        [label="청반 LC\n노르아드레날린 뉴런", fillcolor="#ddcdf0"];
        ANALG     [label="진통 효과\nanalgesia (NRS 감소)", fillcolor="#ddcdf0"];
        RESP      [label="호흡 억제\nrespiratory depression", fillcolor="#ddcdf0"];
        SEDATION  [label="진정·인지장애\nsedation", fillcolor="#ddcdf0"];
        EUPH      [label="보상회로 (VTA-NAc)\n도파민 탈억제", fillcolor="#ddcdf0"];
        WITHDRAW  [label="금단 증후군\nopioid withdrawal (COWS)", fillcolor="#ddcdf0"];
        CAMP_CNS  [label="LC cAMP 상향조절\ncAMP superactivation", fillcolor="#ddcdf0"];
    }

    /* ---------- 4. RECEPTOR TRAFFICKING -------------------------------- */
    subgraph cluster_traffic {
        label="4 · 수용체 이동과 내성의 비대칭 (trafficking: why tolerance is asymmetric)";
        style="rounded,filled"; fillcolor="#f0eefa"; color="#7b6bab"; fontsize=13;
        GRK2      [label="GRK2/GRK5 인산화", fillcolor="#c5b3e6"];
        ARRB2     [label="β-arrestin-2 동원", fillcolor="#c5b3e6"];
        INTERN    [label="수용체 내재화\nclathrin-mediated internalisation", fillcolor="#c5b3e6"];
        RECYC     [label="재순환 vs 리소좀 분해\nrecycling / degradation", fillcolor="#c5b3e6"];
        RC_AVAIL  [label="중추 MOR 가용도 ↓↓\nCNS receptor availability\n(24주 적정 후 0.373)", fillcolor="#c5b3e6", penwidth=2.0];
        RG_AVAIL  [label="장관 MOR 가용도 ~유지\nenteric availability 0.915\n(탈감작 속도 1/7.5)", fillcolor="#a8d5e8", penwidth=2.0];
        TOL_CNS   [label="진통 내성\nanalgesic tolerance", fillcolor="#c5b3e6"];
        NO_TOL_GI [label="변비에는 내성이 생기지 않는다\nNO tolerance to constipation\n단, 악화되지도 않는다 — 전달이 이미 포화\n(60→200 mg/일에서 SBM 1.49→1.34)", fillcolor="#a8d5e8", penwidth=2.0];
        DOSE_ESC  [label="용량 증량 나선\ndose escalation to hold analgesia", fillcolor="#c5b3e6"];
    }

    /* ---------- 5. MYENTERIC PLEXUS ------------------------------------ */
    subgraph cluster_myent {
        label="5 · 근층간 신경총 — 운동 arm (myenteric plexus · motility)";
        style="rounded,filled"; fillcolor="#eaf4fa"; color="#5b8fb0"; fontsize=13;
        MOR_ENT   [label="장관 MOR\nenteric mu receptor\n(근층간 + 점막하 신경총)", fillcolor="#8fc7de", penwidth=2.2];
        EXC_MN    [label="흥분성 운동뉴런\nexcitatory motor neuron", fillcolor="#a8d5e8"];
        INH_MN    [label="억제성 운동뉴런\ninhibitory motor neuron", fillcolor="#a8d5e8"];
        IPAN      [label="내인성 일차구심뉴런 IPAN\n(기계·화학 감수)", fillcolor="#a8d5e8"];
        INTERNEUR [label="상행·하행 개재뉴런\nascending/descending interneuron", fillcolor="#a8d5e8"];
        ACH_REL   [label="아세틸콜린 유리 ↓\nACh release (M2/M3)", fillcolor="#a8d5e8"];
        SUBP      [label="Substance P / NK1 ↓", fillcolor="#a8d5e8"];
        NO_VIP    [label="NO · VIP · PACAP 억제성 톤 ↑\ninhibitory tone", fillcolor="#a8d5e8"];
        PERIST    [label="연동반사 (오름·내림)\nperistaltic reflex 붕괴", fillcolor="#a8d5e8"];
        HT5_EC    [label="장크롬친화세포 5-HT 유리\nEC-cell serotonin", fillcolor="#a8d5e8"];
        HT4R      [label="5-HT4 수용체 (Gs)\non the SAME neuron", fillcolor="#a8d5e8"];
    }

    /* ---------- 6. SUBMUCOSAL PLEXUS ----------------------------------- */
    subgraph cluster_submuc {
        label="6 · 점막하 신경총 — 분비 arm (submucosal plexus · secretion)";
        style="rounded,filled"; fillcolor="#e6f2f7"; color="#4f88a8"; fontsize=13;
        SECRETOMOTOR [label="분비운동뉴런\nsecretomotor neuron (VIP/ACh)", fillcolor="#a8d5e8"];
        MOR_SUBMUC   [label="점막하 MOR\n분비 억제", fillcolor="#8fc7de", penwidth=2.0];
        SEC_DRIVE    [label="능동 음이온 분비 ↓\nactive anion secretion\n(빠른 arm · 수 분 단위)", fillcolor="#a8d5e8", penwidth=2.0];
        ENTEROENDO   [label="장내분비세포\nGLP-1 · PYY · 5-HT", fillcolor="#a8d5e8"];
    }

    /* ---------- 7. SECOND MESSENGERS ----------------------------------- */
    subgraph cluster_2nd {
        label="7 · 이차전령 — Gi와 Gs가 만나는 곳 (Gi/Gs convergence)";
        style="rounded,filled"; fillcolor="#eef0fb"; color="#6b74b0"; fontsize=13;
        GI        [label="Gi/Go α 소단위", fillcolor="#b6bde8"];
        GBG       [label="Gβγ", fillcolor="#b6bde8"];
        AC        [label="아데닐산 고리화효소\nadenylyl cyclase", fillcolor="#9aa4e0", penwidth=2.0];
        CAMP_ENT  [label="장관 뉴런 cAMP ↓\nenteric cAMP", fillcolor="#9aa4e0", penwidth=2.0];
        PKA       [label="PKA 활성 ↓", fillcolor="#b6bde8"];
        GIRK      [label="GIRK K⁺ 통로 개방\n→ 과분극", fillcolor="#b6bde8"];
        CAV       [label="N/P-type Ca²⁺ 통로 억제\n→ 신경전달물질 유리 ↓", fillcolor="#b6bde8"];
        GS_5HT4   [label="Gs (5-HT4 작용제)\n같은 효소를 반대편에서", fillcolor="#b6bde8"];
    }

    /* ---------- 8. SMOOTH MUSCLE / MOTOR PATTERNS ---------------------- */
    subgraph cluster_muscle {
        label="8 · 카할 간질세포·평활근·운동양식 (ICC · smooth muscle · motor patterns)";
        style="rounded,filled"; fillcolor="#fbf5e8"; color="#b09a5b"; fontsize=13;
        ICC       [label="카할 간질세포 ICC\npacemaker (ANO1)", fillcolor="#e8d9a8"];
        SLOWWAVE  [label="서파 slow wave", fillcolor="#e8d9a8"];
        HAPC      [label="고진폭 전파성 수축 HAPC ↓↓\nhigh-amplitude propagating contraction\n(실제 추진 사건)", fillcolor="#dcc98a", penwidth=2.2];
        SEGTONE   [label="분절성 비추진 긴장 ↑↑\nnon-propulsive segmental tone\n(오피오이드의 역설)", fillcolor="#dcc98a", penwidth=2.2];
        PYLORO    [label="유문·회맹판 긴장 ↑", fillcolor="#e8d9a8"];
        GASTRIC   [label="위 배출 지연\ngastroparesis 성분", fillcolor="#e8d9a8"];
        GASTCOL   [label="위대장 반사 ↓\ngastrocolic reflex", fillcolor="#e8d9a8"];
        SMC_CA    [label="평활근 Ca²⁺ 감작\nRhoA/ROCK", fillcolor="#e8d9a8"];
    }

    /* ---------- 9. COLONIC TRANSIT CHAIN ------------------------------- */
    subgraph cluster_transit {
        label="9 · 대장 통과 사슬 (4-segment colonic transit chain)";
        style="rounded,filled"; fillcolor="#f2f2f2"; color="#888888"; fontsize=13;
        ILEO      [label="회맹부 유입\n1500 mL 물 + 35 g 고형/일", fillcolor="#dddddd"];
        SEG1      [label="상행결장 S1/W1\nascending colon", fillcolor="#dddddd"];
        SEG2      [label="횡행결장 S2/W2\ntransverse colon", fillcolor="#dddddd"];
        SEG3      [label="하행결장 S3/W3\ndescending colon", fillcolor="#dddddd"];
        SEG4      [label="직장S상부 S4/W4\nrectosigmoid (저장고)", fillcolor="#dddddd"];
        CTT       [label="대장 통과시간 CTT\n건강 35 h → OIC ~145 h", fillcolor="#cccccc", penwidth=2.0];
        STOOLMASS [label="분변 질량·경도\nstool mass & consistency", fillcolor="#dddddd"];
        MASSBAL   [label="정상상태 항등식:\n배변빈도 × 분변량 = 식이 잔사 유입\nfrequency × mass = residue input", fillcolor="#cccccc", penwidth=2.0];
    }

    /* ---------- 10. EPITHELIAL ION TRANSPORT --------------------------- */
    subgraph cluster_epith {
        label="10 · 상피 이온수송과 수분 균형 (epithelial ion transport · water)";
        style="rounded,filled"; fillcolor="#e8f7f7"; color="#4f9a9a"; fontsize=13;
        CFTR      [label="CFTR Cl⁻ 통로", fillcolor="#a6dede"];
        CLC2      [label="ClC-2 Cl⁻ 통로\n(루비프로스톤 표적)", fillcolor="#a6dede", penwidth=2.0];
        GCC       [label="구아닐산 고리화효소 C (GC-C)", fillcolor="#a6dede"];
        CGMP      [label="세포내 cGMP ↑", fillcolor="#a6dede"];
        NKCC1     [label="기저측 NKCC1\nCl⁻ 유입", fillcolor="#a6dede"];
        NHE3      [label="NHE3 Na⁺/H⁺ 교환\n흡수", fillcolor="#a6dede"];
        ENAC      [label="ENaC (알도스테론 의존)\n원위 Na⁺ 흡수", fillcolor="#a6dede"];
        AQP       [label="아쿠아포린 3/4/8\n수분 이동", fillcolor="#a6dede"];
        WATER_ABS [label="순 수분 흡수\nnet water absorption\n≈ 1400 mL/일", fillcolor="#8fd0d0", penwidth=2.0];
        BOUNDWAT  [label="고형상 결합수 (흡수 불가)\nbound water floor w_min ≈ 0.62", fillcolor="#8fd0d0", penwidth=2.0];
        OSM_OBL   [label="삼투압적으로 구속된 물\nosmotically obliged water\n= mmol / 0.29", fillcolor="#a6dede"];
        SCFA_ABS  [label="SCFA 흡수 (Na 동반)\n→ 물 흡수 촉진", fillcolor="#a6dede"];
    }

    /* ---------- 11. THE FEEDBACK LOOP ---------------------------------- */
    subgraph cluster_loop {
        label="11 · 통과–수분 양성 되먹임 고리 (the amplifier)";
        style="rounded,filled"; fillcolor="#fdeef0"; color="#c0707f"; fontsize=13;
        RESIDENCE [label="① 체류시간 ↑\nresidence time", fillcolor="#f3c4cb"];
        CONTACT   [label="② 상피 접촉시간 ↑\ncontact time for absorption", fillcolor="#f3c4cb"];
        DRYSTOOL  [label="③ 분변 수분율 ↓\nstool water fraction 0.77→0.64", fillcolor="#f3c4cb"];
        PROPEFF   [label="④ 추진 효율 ↓\npropulsive efficiency\nWFUN(w) = wⁿ/(wⁿ+w50ⁿ)", fillcolor="#f3c4cb"];
        LOOPGAIN  [label="※ 이 고리는 증폭기가 아니다\n고리를 제거해도 약효 배수 2.89 → 2.91\n분변 수분의 절대 수준만 정한다\n(저자 가설의 반증 — 분석 D)", fillcolor="#eda9b4", penwidth=2.2];
        BISTAB    [label="실제 증폭기는 항문직장 항이다\n변의 역치 제거 시 배수 1.60\n괄약근 긴장 제거 시 1.88\n대장 추진 제거 시 2.16", fillcolor="#f3c4cb", penwidth=2.0];
    }

    /* ---------- 12. ANORECTAL FUNCTION --------------------------------- */
    subgraph cluster_anorect {
        label="12 · 항문직장 기능 (anorectal function)";
        style="rounded,filled"; fillcolor="#fdf0e8"; color="#c08a5b"; fontsize=13;
        IAS       [label="내항문괄약근 긴장 ↑\ninternal anal sphincter tone", fillcolor="#f0cba8"];
        EAS       [label="외항문괄약근\n수의적 조절", fillcolor="#f0cba8"];
        RAIR      [label="직장항문 억제반사 둔화\nblunted RAIR", fillcolor="#f0cba8"];
        RECTSENS  [label="직장 감각 역치 ↑↑\nrectal hyposensitivity\n(변의 소실)", fillcolor="#e8b98a", penwidth=2.2];
        DYSSYN    [label="배변 협조장애\ndyssynergic defaecation", fillcolor="#f0cba8"];
        PUBOREC   [label="치골직장근 이완 실패", fillcolor="#f0cba8"];
        URGE      [label="변의 urge\n= f(직장 부하 / 역치)", fillcolor="#f0cba8"];
        EVAC      [label="배출 완전도\nevacuation completeness", fillcolor="#f0cba8"];
    }

    /* ---------- 13. MICROBIOME ----------------------------------------- */
    subgraph cluster_micro {
        label="13 · 장내미생물과 발효 (microbiome · fermentation)";
        style="rounded,filled"; fillcolor="#f3f5e8"; color="#8a9a5b"; fontsize=13;
        MICROBIOTA [label="대장 세균총\ncolonic microbiota", fillcolor="#d6de9a"];
        FERMENT    [label="발효 fermentation\n락툴로스 1 → SCFA/가스 ~3.6 삼투질", fillcolor="#c6d17a", penwidth=2.0];
        SCFA       [label="단쇄지방산\nacetate · propionate · butyrate", fillcolor="#d6de9a"];
        GAS        [label="가스 (H₂ · CO₂ · CH₄)\n→ 팽만", fillcolor="#d6de9a"];
        METHANO    [label="메탄생성균\nM. smithii → 통과 지연", fillcolor="#d6de9a"];
        BILEACID   [label="담즙산 신호 (TGR5/FXR)\n→ 분비·운동", fillcolor="#d6de9a"];
        DYSBIOSIS  [label="오피오이드 유발 이상세균증\n점막 장벽 변화", fillcolor="#d6de9a"];
    }

    /* ---------- 14. PAMORAs -------------------------------------------- */
    subgraph cluster_pamora {
        label="14 · PAMORA — 말초 선택적 MOR 길항제 (the four drugs and their Kp,uu)";
        style="rounded,filled"; fillcolor="#eef8ee"; color="#5b9a5b"; fontsize=13;
        NALOXEGOL [label="날록세골 25 mg qd\nnaloxegol · PEG화 날록솔\nKi 7.4 nM · Kp,uu 0.020", fillcolor="#a8dca8", penwidth=2.0];
        NALDEMED  [label="날데메딘 0.2 mg qd\nnaldemedine\nKi 0.34 nM · Kp,uu 0.012", fillcolor="#a8dca8", penwidth=2.0];
        MNTX_SC   [label="메틸날트렉손 12 mg SC\n4급 암모늄 (영구 하전)\nKi 28 nM · Kp,uu 0.005", fillcolor="#a8dca8", penwidth=2.0];
        MNTX_PO   [label="메틸날트렉손 450 mg PO\n내강에서 작용 (F ~1%)", fillcolor="#c2e6c2"];
        NALOXONE  [label="날록손 PO\nKp,uu ≈ 1.0 — 음성 대조군", fillcolor="#c2e6c2"];
        ALVIMOPAN [label="알비모판\n수술후 장폐색 적응증 (단기)", fillcolor="#c2e6c2"];
        OXN_PR    [label="옥시코돈/날록손 서방정\n국소 길항 + 간 초회통과", fillcolor="#c2e6c2"];
        PEGYL     [label="PEG화 = 설계된 P-gp 기질화\nPEGylation as a design choice", fillcolor="#c2e6c2"];
        SI_NODE   [label="선택지수 SI\n= 장관 점유율 / 중추 점유율\n≈ 1/Kp,uu × (작용제 경쟁 보정)", fillcolor="#7fc97f", penwidth=2.4, shape=box];
        COMPETE   [label="경쟁적 결합\nOCC = (X/Ki) / (1 + A/Ki_A + B/Ki_B)", fillcolor="#c2e6c2"];
    }

    /* ---------- 15. SECRETAGOGUES & PROKINETICS ------------------------ */
    subgraph cluster_secre {
        label="15 · 분비촉진제·촉진운동제 (secretagogues · prokinetics)";
        style="rounded,filled"; fillcolor="#fdeef8"; color="#b06ba0"; fontsize=13;
        LUBIPRO   [label="루비프로스톤 24 µg bid\nClC-2 활성화", fillcolor="#f0c2e0"];
        LINACLO   [label="리나클로타이드 145 µg qd\nGC-C 작용제 (비흡수 펩타이드)", fillcolor="#f0c2e0"];
        PLECANA   [label="플레카나타이드\nGC-C, pH 의존", fillcolor="#f0c2e0"];
        PRUCALO   [label="프루칼로프리드 2 mg qd\n5-HT4 선택적 작용제", fillcolor="#f0c2e0"];
        TEGASEROD [label="테가세로드\n5-HT4 부분작용제", fillcolor="#f0c2e0"];
        ELOBIX    [label="엘로빅시밧\nIBAT 억제 → 담즙산 유입", fillcolor="#f0c2e0"];
        METH_CLC2 [label="메타돈에 의한 ClC-2 직접 차단\n약과 해독제가 같은 단백질에서 충돌", fillcolor="#e8a8d4", penwidth=2.2];
    }

    /* ---------- 16. LAXATIVES ------------------------------------------ */
    subgraph cluster_lax {
        label="16 · 삼투성·자극성·팽창성 완하제 (osmotic · stimulant · bulk)";
        style="rounded,filled"; fillcolor="#f7f0e8"; color="#a08a6b"; fontsize=13;
        PEG3350   [label="PEG 3350 17 g/일\nMW 3350 → 5.1 mmol → ~17 mL", fillcolor="#ead9c2"];
        LACTUL    [label="락툴로스 20 g/일\nMW 342 → 58 mmol → 발효 증폭", fillcolor="#ead9c2"];
        MGSALT    [label="마그네슘염\n삼투 + CCK 유리", fillcolor="#ead9c2"];
        BISACODYL [label="비사코딜·센나\n자극성 (구제약)", fillcolor="#ead9c2"];
        DOCUSATE  [label="도쿠세이트\n연화제 (근거 약함)", fillcolor="#ead9c2"];
        FIBER     [label="식이섬유·차전자피\n유입 잔사 자체를 늘림", fillcolor="#ead9c2"];
        ENEMA     [label="관장·좌약\n직장 배출 직접 유도", fillcolor="#ead9c2"];
        RESCUE    [label="구제 완하제 사용\n(72시간 무배변 시 프로토콜 허용)\nSBM 정의에서 제외됨", fillcolor="#dcc4a4", penwidth=2.0];
    }

    /* ---------- 17. DRUG INTERACTIONS ---------------------------------- */
    subgraph cluster_ddi {
        label="17 · 약물상호작용 — 노출을 바꾸는 것과 비를 바꾸는 것 (DDI)";
        style="rounded,filled"; fillcolor="#fff6e8"; color="#c09a4b"; fontsize=13;
        CYP3A4I   [label="강력 CYP3A4 억제제\n(케토코나졸·클라리스로마이신)\n→ AUC ↑ 만", fillcolor="#f0d9a8"];
        PGPI      [label="P-gp 억제제\n(퀴니딘·베라파밀·딜티아젬)\n→ Kp,uu ↑ = 비의 회전", fillcolor="#e8c47a", penwidth=2.2];
        DUAL      [label="이중 억제 (딜티아젬·베라파밀)\nAUC와 Kp,uu를 동시에", fillcolor="#f0d9a8"];
        DOSERED   [label="라벨 지시: 12.5 mg로 감량\ndose reduction", fillcolor="#f0d9a8"];
        SI_INVAR  [label="감량은 CYP3A4는 고치고 P-gp는 못 고친다\nCYP3A4: SI 17.5 → 31.3 (회복)\nP-gp: SI 9.8 → 13.3 (미회복)\n대신 효능만 잃는다 SBM 4.30 → 3.11", fillcolor="#e8c47a", penwidth=2.2];
        ANTICHOL  [label="항콜린제·TCA·5-HT3 길항제\n변비 부하 가중", fillcolor="#f0d9a8"];
        CCB_IRON  [label="칼슘차단제·철·알루미늄\n추가 변비 유발", fillcolor="#f0d9a8"];
    }

    /* ---------- 18. ENDPOINTS & COMPLICATIONS -------------------------- */
    subgraph cluster_end {
        label="18 · 임상 종말점과 합병증 (clinical endpoints · complications)";
        style="rounded,filled"; fillcolor="#fffdf0"; color="#b0a84b"; fontsize=13;
        SBM       [label="SBM/주\nspontaneous bowel movement\n(구제약 24 h 내 사용 시 제외)", fillcolor="#f5f0a8", penwidth=2.2];
        CSBM      [label="CSBM/주\ncomplete SBM", fillcolor="#f5f0a8"];
        RESPOND   [label="반응자 정의\n≥3 SBM/주 AND 기저 대비 ≥1 증가", fillcolor="#f5f0a8", penwidth=2.0];
        BSFS      [label="브리스톨 대변 척도\nBristol Stool Form Scale 1–7", fillcolor="#f5f0a8"];
        STRAINING [label="배변 시 힘주기\nstraining 0–4", fillcolor="#f5f0a8"];
        BLOAT     [label="복부 팽만·불편감\nbloating / distension", fillcolor="#f5f0a8"];
        PACSYM    [label="PAC-SYM 증상 점수", fillcolor="#f5f0a8"];
        PACQOL    [label="PAC-QOL 삶의 질", fillcolor="#f5f0a8"];
        PAINSCORE [label="통증 NRS (유지되어야 함)\npain must NOT worsen", fillcolor="#f5f0a8"];
        COWS      [label="COWS 금단 점수\n(안전성 종말점)", fillcolor="#f5f0a8"];
        IMPACT    [label="분변 매복\nfaecal impaction", fillcolor="#f4a6a0"];
        OVERFLOW  [label="넘침 실금\noverflow incontinence", fillcolor="#f4a6a0"];
        PERF      [label="장천공·거대결장\nperforation (희귀)", fillcolor="#f4a6a0"];
        HEMORR    [label="치핵·열창\nhaemorrhoids · fissure", fillcolor="#f4a6a0"];
        NBS       [label="마약성 장 증후군\nnarcotic bowel syndrome", fillcolor="#f4a6a0"];
        NONADH    [label="진통 비순응·용량 자의 감량\nanalgesia forgone to avoid OIC", fillcolor="#f4a6a0", penwidth=2.0];
    }

    /* ================= EDGES ============================================ */

    /* 1 opioid PK */
    OP_DOSE   -> OP_DEPOT;
    OP_DEPOT  -> OP_FPM        [label="ka 1.2/h"];
    OP_DEPOT  -> OP_LUMEN      [label="비흡수 분획"];
    OP_FPM    -> OP_PORTAL;
    OP_FPM    -> OP_M1         [label="CYP2D6/3A4"];
    OP_PORTAL -> OP_PLASMA     [label="F 0.75"];
    OP_PORTAL -> MOR_ENT       [label="전신 전 장벽 노출\npre-systemic", style=dashed];
    OP_PLASMA -> OP_PERIPH     [dir=both];
    OP_PLASMA -> OP_CLR        [label="CL 45 L/h"];
    OP_M1     -> OP_PLASMA;
    OP_ALT1   -> OP_PLASMA;    OP_ALT2 -> OP_PLASMA;
    OP_ALT3   -> OP_PLASMA;    OP_ALT4 -> OP_M1;
    OP_ALT3   -> OP_LUMEN      [label="없음 (경피)", style=dotted, color="#bbbbbb"];

    /* 2 BBB */
    OP_PLASMA -> BBB_TJ;
    BBB_TJ    -> KPUU;
    PGP       -> KPUU          [label="유출이 Kp,uu를 정한다", penwidth=2.0, color="#c9a227"];
    BCRP      -> KPUU;
    ABCB1_G   -> PGP;
    BBB_INFLM -> BBB_TJ        [label="투과성 ↑"];
    KPUU      -> OP_BRAIN;
    OP_BRAIN  -> MOR_CNS       [penwidth=2.0];

    /* 3 CNS */
    MOR_CNS -> PAG; MOR_CNS -> RVM; MOR_CNS -> DH; MOR_CNS -> LC;
    PAG -> ANALG; RVM -> ANALG; DH -> ANALG;
    MOR_CNS -> RESP; MOR_CNS -> SEDATION; MOR_CNS -> EUPH;
    LC -> CAMP_CNS [label="만성 노출"];
    CAMP_CNS -> WITHDRAW [label="길항제 결합 시 반동", penwidth=1.6];
    ANALG -> PAINSCORE;
    RESP -> NONADH [style=dotted];

    /* 4 trafficking */
    MOR_CNS -> GRK2; GRK2 -> ARRB2; ARRB2 -> INTERN; INTERN -> RECYC;
    RECYC -> RC_AVAIL [label="분해 우세 → 가용도 ↓"];
    RC_AVAIL -> TOL_CNS; TOL_CNS -> DOSE_ESC;
    DOSE_ESC -> OP_DOSE [label="진통 유지를 위한 증량", color="#c0392b", penwidth=2.0];
    MOR_ENT -> RG_AVAIL [label="탈감작 속도 1/24", color="#2874a6"];
    RG_AVAIL -> NO_TOL_GI [penwidth=2.0];
    DOSE_ESC -> MOR_ENT [label="증량분 전량이\n적응하지 않은 수용체에", color="#c0392b", penwidth=2.2];
    NO_TOL_GI -> SBM [label="OIC는 관해되지 않는다", color="#c0392b"];

    /* 5 myenteric */
    OP_PLASMA -> MOR_ENT [label="유리 혈장농도", penwidth=1.8];
    OP_LUMEN  -> MOR_ENT [label="내강 접근 (경구 특이)", style=dashed];
    MOR_ENT -> EXC_MN; MOR_ENT -> INH_MN; MOR_ENT -> IPAN; MOR_ENT -> INTERNEUR;
    EXC_MN -> ACH_REL; EXC_MN -> SUBP;
    INH_MN -> NO_VIP;
    MOR_ENT -> NO_VIP [label="탈억제 → 억제성 톤 ↑"];
    ACH_REL -> PERIST; SUBP -> PERIST; NO_VIP -> PERIST [label="억제"];
    HT5_EC -> IPAN [label="점막 자극"];
    HT4R -> EXC_MN;
    MOR_ENT -> MOR_SUBMUC [style=dotted, color="#888888"];

    /* 6 submucosal */
    MOR_SUBMUC -> SECRETOMOTOR;
    SECRETOMOTOR -> SEC_DRIVE;
    MOR_SUBMUC -> SEC_DRIVE [label="분비 억제 (최대 55%)", penwidth=2.0, color="#2874a6"];
    ENTEROENDO -> SECRETOMOTOR;
    SEC_DRIVE -> WATER_ABS [label="순 수분 균형을 흡수 쪽으로", penwidth=1.8];

    /* 7 second messengers */
    MOR_ENT -> GI [penwidth=1.8];
    GI -> AC [label="억제"];
    GBG -> GIRK; GBG -> CAV;
    GI -> GBG;
    AC -> CAMP_ENT; CAMP_ENT -> PKA;
    PKA -> ACH_REL [label="유리 촉진"];
    GIRK -> ACH_REL [label="과분극 → 억제"];
    CAV -> ACH_REL [label="Ca²⁺ 유입 ↓"];
    GS_5HT4 -> AC [label="자극 — 같은 효소", color="#2e8b57", penwidth=2.0];
    HT4R -> GS_5HT4;
    CAMP_ENT -> SEC_DRIVE;

    /* 8 muscle */
    ICC -> SLOWWAVE; SLOWWAVE -> HAPC;
    ACH_REL -> HAPC [penwidth=1.8];
    NO_VIP -> HAPC [label="억제"];
    MOR_ENT -> SEGTONE [label="긴장 ↑ (추진은 ↓)", penwidth=2.0, color="#b8860b"];
    SMC_CA -> SEGTONE;
    MOR_ENT -> PYLORO; MOR_ENT -> GASTRIC; MOR_ENT -> GASTCOL;
    GASTCOL -> HAPC [label="식후 유발 소실"];
    PERIST -> HAPC;

    /* 9 transit */
    ILEO -> SEG1; SEG1 -> SEG2; SEG2 -> SEG3; SEG3 -> SEG4;
    HAPC -> SEG1 [label="추진 속도상수", color="#b8860b"];
    HAPC -> SEG2 [color="#b8860b"]; HAPC -> SEG3 [color="#b8860b"];
    SEGTONE -> SEG1 [label="추진 저하", color="#b8860b"];
    SEGTONE -> SEG2 [color="#b8860b"]; SEGTONE -> SEG3 [color="#b8860b"];
    SEG4 -> STOOLMASS; SEG1 -> CTT; SEG2 -> CTT; SEG3 -> CTT; SEG4 -> CTT;
    STOOLMASS -> MASSBAL; SBM -> MASSBAL [dir=both, style=dashed];

    /* 10 epithelium */
    NKCC1 -> CFTR; CFTR -> WATER_ABS [label="분비 (음의 흡수)"];
    CLC2  -> WATER_ABS [label="분비"];
    GCC -> CGMP; CGMP -> CFTR [label="PKG-II → CFTR 인산화"];
    NHE3 -> WATER_ABS; ENAC -> WATER_ABS; AQP -> WATER_ABS;
    CGMP -> NHE3 [label="억제"];
    SCFA_ABS -> WATER_ABS;
    WATER_ABS -> SEG1 [label="수분 제거", color="#4f9a9a"];
    WATER_ABS -> SEG2 [color="#4f9a9a"]; WATER_ABS -> SEG3 [color="#4f9a9a"];
    WATER_ABS -> SEG4 [color="#4f9a9a"];
    BOUNDWAT -> WATER_ABS [label="흡수의 하한선\n(이것이 없으면 모델이 발산한다)", penwidth=2.0, color="#4f9a9a"];
    OSM_OBL -> WATER_ABS [label="흡수 불가 분획"];

    /* 11 the loop */
    SEGTONE -> RESIDENCE; HAPC -> RESIDENCE [label="감소 시 ↑"];
    RESIDENCE -> CONTACT; CONTACT -> DRYSTOOL;
    WATER_ABS -> DRYSTOOL;
    DRYSTOOL -> PROPEFF [label="WFUN(w)", penwidth=2.0];
    PROPEFF -> RESIDENCE [label="되먹임 (양성) — 실재하나\n약효를 나르지는 않는다", color="#c0392b", penwidth=2.4];
    PROPEFF -> LOOPGAIN; DRYSTOOL -> LOOPGAIN;
    LOOPGAIN -> SBM [penwidth=2.0];
    LOOPGAIN -> BISTAB;
    DRYSTOOL -> BSFS; DRYSTOOL -> STOOLMASS;
    RESIDENCE -> CTT;

    /* 12 anorectal */
    MOR_ENT -> IAS [label="괄약근 긴장 ↑"];
    MOR_ENT -> RAIR; MOR_ENT -> RECTSENS [label="감각 역치 ↑", penwidth=2.2, color="#c08a5b"];
    SEG4 -> URGE [label="직장 부하"];
    RECTSENS -> URGE [label="역치를 올려 변의를 지운다", penwidth=2.2, color="#c08a5b"];
    IAS -> EVAC; RAIR -> EVAC; DYSSYN -> EVAC; PUBOREC -> DYSSYN;
    EAS -> EVAC;
    URGE -> SBM [penwidth=2.0];
    EVAC -> CSBM; EVAC -> STRAINING;
    DRYSTOOL -> STRAINING;

    /* 13 microbiome */
    MICROBIOTA -> FERMENT; FERMENT -> SCFA; FERMENT -> GAS;
    SCFA -> SCFA_ABS; GAS -> BLOAT [penwidth=1.6];
    METHANO -> CTT [label="통과 지연"];
    MICROBIOTA -> BILEACID; BILEACID -> SEC_DRIVE;
    DYSBIOSIS -> MICROBIOTA;
    MOR_ENT -> DYSBIOSIS [style=dotted];
    LACTUL -> FERMENT [label="발효 기질", penwidth=2.0, color="#8a9a5b"];
    FERMENT -> OSM_OBL [label="삼투질 ×3.6", penwidth=2.0, color="#8a9a5b"];

    /* 14 PAMORAs */
    NALOXEGOL -> COMPETE; NALDEMED -> COMPETE; MNTX_SC -> COMPETE;
    MNTX_PO -> OP_LUMEN [style=dotted, label="내강 작용"];
    MNTX_PO -> COMPETE; NALOXONE -> COMPETE; ALVIMOPAN -> COMPETE;
    OXN_PR -> NALOXONE;
    PEGYL -> NALOXEGOL [label="설계된 P-gp 기질"];
    PEGYL -> PGP;
    COMPETE -> MOR_ENT [label="장관 점유 (치료)", color="#2e8b57", penwidth=2.2];
    COMPETE -> MOR_CNS [label="중추 점유 (독성)", color="#c0392b", penwidth=1.4];
    COMPETE -> SI_NODE;
    KPUU -> SI_NODE [label="SI ≈ 1/Kp,uu", penwidth=2.4, color="#c9a227"];
    OP_BRAIN -> SI_NODE [label="작용제 뇌농도가 높을수록\n중추 경쟁이 어려워진다 → SI ↑", style=dashed];
    SI_NODE -> COWS [label="낮으면 금단", color="#c0392b"];
    SI_NODE -> PAINSCORE [label="낮으면 진통 소실", color="#c0392b"];
    NALOXONE -> COWS [label="Kp,uu≈1 → 회피 불가", color="#c0392b", penwidth=1.6];
    MOR_CNS -> WITHDRAW;

    /* 15 secretagogues / prokinetics */
    LUBIPRO -> CLC2 [penwidth=2.0, color="#b06ba0"];
    LINACLO -> GCC [penwidth=2.0, color="#b06ba0"];
    PLECANA -> GCC;
    PRUCALO -> HT4R [penwidth=2.0, color="#b06ba0"];
    TEGASEROD -> HT4R;
    ELOBIX -> BILEACID;
    OP_ALT2 -> METH_CLC2 [penwidth=2.0];
    METH_CLC2 -> CLC2 [label="직접 통로 차단\n(MOR 경유 아님)", color="#c0392b", penwidth=2.2];
    LINACLO -> METH_CLC2 [label="이 차단을 우회한다", style=dashed, color="#2e8b57"];

    /* 16 laxatives */
    PEG3350 -> OSM_OBL [label="5.1 mmol"];
    LACTUL -> OSM_OBL [label="58 mmol (발효 전)"];
    MGSALT -> OSM_OBL;
    BISACODYL -> RESCUE; ENEMA -> RESCUE;
    RESCUE -> SEG4 [label="배출 (SBM으로 세지 않음)", color="#a08a6b", penwidth=1.8];
    RESCUE -> SEG3 [color="#a08a6b"];
    FIBER -> ILEO [label="잔사 유입 자체를 늘림", penwidth=1.8];
    DOCUSATE -> STOOLMASS [style=dotted, color="#bbbbbb"];
    SBM -> RESCUE [label="72 h 무배변 시 촉발", style=dashed];

    /* 17 DDI */
    CYP3A4I -> OP_CLR [style=dotted];
    CYP3A4I -> NALOXEGOL [label="AUC ×3.4"];
    PGPI -> PGP [label="유출 억제", penwidth=2.2, color="#c09a4b"];
    DUAL -> CYP3A4I; DUAL -> PGPI;
    DOSERED -> NALOXEGOL [label="12.5 mg"];
    DOSERED -> SI_INVAR [label="SI는 바뀌지 않는다", penwidth=2.0];
    SI_INVAR -> SI_NODE [dir=both, style=dashed];
    PGPI -> SI_NODE [label="비를 회전시킨다\n(감량으로 못 고친다)", color="#c0392b", penwidth=2.2];
    ANTICHOL -> ACH_REL [label="추가 억제"];
    CCB_IRON -> STOOLMASS;

    /* 18 endpoints */
    SBM -> RESPOND; CSBM -> RESPOND;
    SBM -> PACSYM; BSFS -> PACSYM; STRAINING -> PACSYM; BLOAT -> PACSYM;
    PACSYM -> PACQOL;
    SEG1 -> BLOAT [label="총 부하"]; SEG2 -> BLOAT;
    SBM -> IMPACT [label="빈도 ↓ + 경변 → 위험 ↑", color="#c0392b"];
    DRYSTOOL -> IMPACT [color="#c0392b"];
    IMPACT -> OVERFLOW; IMPACT -> PERF;
    STRAINING -> HEMORR;
    OP_DOSE -> NBS [style=dotted];
    PACQOL -> NONADH; PAINSCORE -> NONADH;
    NONADH -> OP_DOSE [label="환자가 스스로 진통을 포기한다", style=dashed, color="#c0392b"];
    COWS -> NONADH [style=dotted];
    IMPACT -> RESCUE [style=dashed];
}
