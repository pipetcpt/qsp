/* ===========================================================================
   aad_qsp_model.dot
   Acute Type B Aortic Dissection (AAD) — mechanistic QSP map
   급성 B형 대동맥 박리 — 기계론적 QSP 지도

   The organising idea of the map
     Read it as ONE PRODUCT and ONE DIVIDER.

     THE PRODUCT (clusters 5-8, centre).  What tears an aorta is not blood
     pressure.  It is

         ASI  =  (sigma_FL_sys / sigma_ref)  x  (dP/dt_max / dPdt_ref)

     a STRESS term and an IMPULSE term, and they are generated by different
     organs.  sigma = P*r/h comes from the pressure inside a false lumen whose
     outer wall is media+adventitia only (h_FL = 0.40 * h_aorta, so the false
     lumen carries ~2.5x the true lumen's circumferential stress at identical
     pressure).  dP/dt_max comes from the left ventricle, and is set by
     contractility and heart rate — which the arterial baroreflex RAISES when
     the pressure falls.  A pure vasodilator therefore lowers the first factor
     and pushes up the second.  In the simulations that ship with this map, a
     nicardipine infusion titrated to systolic 118 mmHg leaves dP/dt max
     UNCHANGED (1468 vs 1463 mmHg/s untreated, +0.3%), grows the entry tear
     13.3% in 72 h against 1.0% for an esmolol-first regimen at the same
     pressure, and comes out with a HIGHER 72-h mortality than giving nothing
     at all (5.1% vs 2.3%).  "Beta-blockade before vasodilatation" is a
     statement about a product, and it can be computed.

     THE DIVIDER (cluster 4, upper centre).  The false lumen is a compliant
     chamber joined to the true lumen by an entry-tear conductance G_en and a
     distal re-entry conductance G_re.  Everything the false lumen does follows
     from that resistive divider plus its RC time constant tau_FL:

       G_en high, G_re high -> brisk through-flow, pulsatile, no thrombus
       G_en high, G_re ~ 0  -> BLIND SAC.  No outflow, so no pressure drop:
                               mean false-lumen pressure equals systemic mean,
                               and because the pulse is low-pass filtered out,
                               false-lumen DIASTOLIC pressure rises to the
                               systemic MEAN — above true-lumen diastolic.
                               The stagnant distal sac clots while the entry
                               tear stays wide open.  This is "partial
                               thrombosis", and it is the worst configuration
                               in the model (5-y survival 0.613 vs 0.813 for a
                               patent false lumen; implied hazard ratio 2.36
                               against the 2.69 reported by Tsai in IRAD).
       G_en small           -> the whole sac clots, the entry seals, the false
                               lumen depressurises to 9 mmHg and the aorta
                               stops growing (-0.2 mm/y, survival 0.890).

     Nowhere does the map assert that partial thrombosis is dangerous.  Two
     anatomical numbers produce it.

   Reading order
      1  substrate and trigger: what makes a medial layer splittable
      2  the medial wall: elastin, collagen, SMC, MMP/TIMP, TGF-beta
      3  the tear and the two lumens
      4  THE HYDRAULIC DIVIDER — G_en, G_re, tau_FL, false-lumen pressure
      5  Laplace mechanics — where thinness becomes stress
      6  THE PRODUCT — ASI and the propagation threshold
      7  the left ventricle as an impulse generator (dP/dt max)
      8  systemic haemodynamics: resistance, compliance, pulse pressure
      9  autonomic control and baroreflex resetting
     10  pain as a haemodynamic drug
     11  false-lumen thrombus: support and proteolysis at the same time
     12  inflammation, IL-6, MMP-9, D-dimer
     13  branch malperfusion: static vs dynamic obstruction
     14  the renin trap — why aggressive BP control can fail
     15  the spinal collateral network as a clock
     16  beta-blockers (esmolol, labetalol, metoprolol)
     17  vasodilators (nicardipine, clevidipine, nitroprusside + cyanide)
     18  analgesia and RAAS blockade
     19  interventions: TEVAR, PETTICOAT, open repair, staged coverage
     20  clinical endpoints and complications

   Colour key
     substrate / genetics .......... pale olive
     aortic wall / ECM ............. wheat
     lumen / haemodynamic state .... light blue
     THE PRODUCT / index ........... gold (heavy border)
     cardiac ....................... salmon
     autonomic / neural ............ lavender
     inflammation .................. pale pink
     thrombus ...................... light grey
     organ perfusion ............... pale cyan
     RAAS .......................... periwinkle
     beta-blocker .................. pale green
     vasodilator ................... pale turquoise
     analgesic / ARB ............... light violet
     intervention .................. light steel
     clinical endpoint ............. light yellow
     complication .................. light coral
   =========================================================================== */

digraph AAD_QSP {
    graph [rankdir=LR, splines=spline, overlap=false, nodesep=0.30, ranksep=1.05, newrank=true,
           fontname="Helvetica", fontsize=11,
           labelloc="t", fontcolor="#1a1a1a",
           label=<<B>Acute Type B Aortic Dissection — Quantitative Systems Pharmacology Map</B><BR/>
                  <FONT POINT-SIZE="12">급성 B형 대동맥 박리 (AAD) · 191 nodes · 323 edges · 20 clusters<BR/>
                  One product (stress x impulse) and one divider (entry tear vs re-entry): the tearing index is arithmetic, not a pressure</FONT>>];
    node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10,
           color="#555555", penwidth=1.0];
    edge  [fontname="Helvetica", fontsize=8, color="#666666", arrowsize=0.7];

    /* ---------- 1. SUBSTRATE AND TRIGGER -------------------------------- */
    subgraph cluster_sub {
        label="1 · 기질과 유발인자 (Substrate & trigger)";
        style="rounded,filled"; fillcolor="#f7f8ee"; color="#a3a86a"; fontsize=13;
        HTN_CHRON [label="만성 고혈압\nchronic hypertension\n(IRAD B형의 ~75%)", fillcolor="#dfe3bd"];
        AGE       [label="연령·남성\nage 65 · male\n탄성판 피로 누적", fillcolor="#dfe3bd"];
        FBN1      [label="FBN1 (마르판)\nfibrillin-1 결핍\n→ TGF-β 격리 실패", fillcolor="#c9d18f"];
        TGFBR     [label="TGFBR1/2 · SMAD3\nLoeys-Dietz", fillcolor="#c9d18f"];
        ACTA2     [label="ACTA2 · MYH11 · MYLK\n수축장치 돌연변이", fillcolor="#c9d18f"];
        COL3A1    [label="COL3A1\n혈관형 엘러스-단로스", fillcolor="#c9d18f"];
        BAV       [label="이엽성 대동맥판\nbicuspid aortic valve", fillcolor="#dfe3bd"];
        COARCT    [label="대동맥 축소증·터너\ncoarctation · Turner", fillcolor="#dfe3bd"];
        COCAINE   [label="코카인·암페타민\n급성 교감신경 폭발", fillcolor="#dfe3bd"];
        PREG      [label="임신 3분기·산후\n호르몬성 벽 변화", fillcolor="#dfe3bd"];
        FQ        [label="플루오로퀴놀론\nMMP 유도 (논쟁적)", fillcolor="#dfe3bd"];
        DECEL     [label="감속 손상\ndeceleration trauma", fillcolor="#dfe3bd"];
        IATRO     [label="의인성\ncatheter · CABG · TAVR", fillcolor="#dfe3bd"];
        WEIGHTLIFT[label="등척성 운동·발살바\n순간 dP/dt 급등", fillcolor="#dfe3bd"];
    }

    /* ---------- 2. THE MEDIAL WALL -------------------------------------- */
    subgraph cluster_wall {
        label="2 · 중막 구조와 ECM (Medial wall & extracellular matrix)";
        style="rounded,filled"; fillcolor="#fdf6e8"; color="#c9a45c"; fontsize=13;
        LAMELLA   [label="탄성판 단위\nelastic lamellar unit\n(하행흉부 ~55층)", fillcolor="#f0d9a8"];
        ELASTIN   [label="엘라스틴 완전성 ELN\n0-1 (기준 0.82)\n반감기 ~수십 년", fillcolor="#e8c477", penwidth=1.8];
        COLLAGEN  [label="I·III형 콜라겐\n인장 강도의 담당자", fillcolor="#f0d9a8"];
        VSMC      [label="중막 평활근세포\ncontractile → synthetic 전환", fillcolor="#f0d9a8"];
        VSMC_APO  [label="VSMC 세포자멸\n중막 세포성 소실", fillcolor="#f0d9a8"];
        GAG       [label="글리코사미노글리칸 축적\ncystic medial degeneration", fillcolor="#f0d9a8"];
        MMP2      [label="MMP-2\n구성적 엘라스타아제", fillcolor="#f0d9a8"];
        MMP9_W    [label="MMP-9\n유도성 엘라스타아제\n(모델 상태변수)", fillcolor="#e8c477", penwidth=1.8];
        TIMP      [label="TIMP-1/2\n내인성 억제제", fillcolor="#f0d9a8"];
        TGFB_W    [label="TGF-β 신호\nfibrosis ↔ proteolysis 양면", fillcolor="#e8c477", penwidth=1.8];
        ADVENT    [label="외막 콜라겐 COL\n적응성 두께 증가\n(유일한 음성 되먹임)", fillcolor="#e8c477", penwidth=1.8];
        HFL_N     [label="가강 외벽 두께 h_FL\n= 0.40 × h_aorta = 0.76 mm\n박리면이 외측 1/3에 위치", fillcolor="#e8c477", penwidth=2.2];
        VASA      [label="영양혈관 vasa vasorum\n외측 중막 산소 공급", fillcolor="#f0d9a8"];
        WALL_STR  [label="벽 인장 강도 S\n= 760 kPa × ELN^0.3 × (0.6+0.4·COL)", fillcolor="#e8c477", penwidth=1.8];
    }

    /* ---------- 3. THE TEAR AND THE TWO LUMENS -------------------------- */
    subgraph cluster_tear {
        label="3 · 파열구와 두 개의 내강 (The tear & the two lumens)";
        style="rounded,filled"; fillcolor="#eef4fb"; color="#6a90bd"; fontsize=13;
        INTIMAL_T [label="내막 파열구 (entry tear)\n면적 A_en (기준 42 mm² ≈ 7 mm)", fillcolor="#b8d0ea", penwidth=2.0];
        FLAP      [label="내막 판막 flap\n가동성 ∝ √(A_en/A_ref)", fillcolor="#b8d0ea"];
        PROPAG    [label="박리 전파\nantegrade / retrograde", fillcolor="#b8d0ea"];
        TL        [label="진강 true lumen\n직경 D_TL (20 mm)", fillcolor="#b8d0ea"];
        FL        [label="가강 false lumen\n직경 D_FL (17 mm)", fillcolor="#b8d0ea", penwidth=2.0];
        REENTRY   [label="재유입구 re-entry tear\n원위 유출로 (G_re)", fillcolor="#b8d0ea", penwidth=2.0];
        DEBAKEY   [label="분류: Stanford B\nDeBakey III · 좌쇄골하 원위", fillcolor="#d6e4f2"];
        EXTENT    [label="박리 길이\n하행흉부 → 복부 → 장골", fillcolor="#d6e4f2"];
        TL_COLL   [label="진강 압박 collapse\nD_TL ← 1 − 0.32·collapse", fillcolor="#b8d0ea"];
        DAO       [label="총 대동맥 직경\nD_ao = √(D_TL² + D_FL²)", fillcolor="#b8d0ea", penwidth=1.8];
    }

    /* ---------- 4. THE HYDRAULIC DIVIDER -------------------------------- */
    subgraph cluster_div {
        label="4 · 유체역학적 분압기 (THE DIVIDER — 표현형을 만드는 산수)";
        style="rounded,filled"; fillcolor="#fffaea"; color="#c9a227"; fontsize=13;
        G_EN      [label="입구 전도도 G_en\n∝ A_en · (혈전 봉인) · (스텐트 봉인)", fillcolor="#ffd24d", penwidth=2.2];
        G_RE      [label="재유입 전도도 G_re\n∝ (1 − 원위혈전)²", fillcolor="#ffd24d", penwidth=2.2];
        TAU_FL    [label="가강 RC 시정수\nτ_FL = 0.30 s / (G_en + G_re)", fillcolor="#ffd24d", penwidth=2.0];
        PFL_MEAN  [label="가강 평균압 P_FL\ndP/dt = k[G_en(MAP−P_FL) + G_re(P_dist−P_FL)]\n − (P_FL − 9)/336h", fillcolor="#ffd24d", penwidth=2.2];
        PPFL      [label="가강 맥압 PP_FL\n= PP / √(1 + (ω·τ_FL)²)\n저역통과 필터", fillcolor="#ffd24d", penwidth=2.0];
        PFL_DIA   [label="가강 확장기압 P_FL,dia\n맹관에서 전신 평균압까지 상승\n(진강 확장기압보다 높음)", fillcolor="#ffd24d", penwidth=2.2];
        FL_FLOW   [label="가강 유량 FLOW\n= 통과류(직렬) + 왕복류(입구 단독)\n× (1 − 0.60·혈전)", fillcolor="#ffd24d", penwidth=2.0];
        BLIND     [label="맹관 blind sac\nG_re → 0: 유출 없음 = 압력강하 없음", fillcolor="#ffe699", penwidth=1.8];
        PATENT    [label="개통형 patent FL\nG_re 큼: 통과류 활발, 혈전 없음", fillcolor="#ffe699", penwidth=1.8];
        SEALED    [label="완전 혈전화 sealed\nG_en → 0: P_FL → 9 mmHg", fillcolor="#ffe699", penwidth=1.8];
        TOFRO     [label="왕복류 to-and-fro\n∝ G_en · (PP − PP_FL)\n감쇠가 클수록 왕복류 커짐", fillcolor="#ffe699"];
    }

    /* ---------- 5. LAPLACE MECHANICS ------------------------------------ */
    subgraph cluster_lap {
        label="5 · 라플라스 역학 (Where thinness becomes stress)";
        style="rounded,filled"; fillcolor="#fdf1e6"; color="#c98f5e"; fontsize=13;
        LAPLACE   [label="라플라스 법칙\nσ = P · r / h", fillcolor="#f3c9a0", penwidth=2.2];
        SIG_FL    [label="가강 원주응력 σ_FL\n= P_FL · (D_FL/2) / h_FL\n기준 118 kPa · 제시 시 ~176 kPa", fillcolor="#f3c9a0", penwidth=2.2];
        SIG_TL    [label="진강 원주응력 σ_TL\n온전한 벽 두께 1.14 mm 사용", fillcolor="#f3c9a0"];
        SIG_FLAP  [label="판막 응력 σ_flap\n= |SBP − P_FL,sys| · r / 0.25 mm\n× 노출도(1−혈전)(1−스텐트)", fillcolor="#f3c9a0", penwidth=2.2];
        ASYM      [label="핵심 비대칭\n같은 압력에서 가강 응력 ≈ 진강의 2.5배", fillcolor="#f9dfc6", penwidth=1.8];
        CYCLIC    [label="주기적 피로\ncyclic stretch (PP_FL)", fillcolor="#f9dfc6"];
        SR        [label="응력/강도 비 σ/S\n파열 위험의 단일 지표", fillcolor="#f3c9a0", penwidth=2.0];
        GROWTH    [label="가강 확장 속도\n∝ (σ_FL/118)^1.9 × (1 − 0.85·혈전)", fillcolor="#f3c9a0", penwidth=2.0];
    }

    /* ---------- 6. THE PRODUCT ------------------------------------------ */
    subgraph cluster_asi {
        label="6 · 응력 × 충격량 곱 (THE PRODUCT — the tearing index)";
        style="rounded,filled"; fillcolor="#fff5d6"; color="#b8860b"; fontsize=13;
        ASI       [label="ASI = (σ_FL,sys/σ_ref) × (dP/dt / dPdt_ref)\n대동맥 응력-충격량 지수", fillcolor="#ffc72c", penwidth=3.0];
        ASI_FLAP  [label="판막 응력-충격량\nASI_flap = (σ_flap/σ_ref)·(dP/dt/ref)^1.2", fillcolor="#ffc72c", penwidth=2.6];
        TEAR_TH   [label="전파 임계값 TEAR_TH = 0.45\n이 값 아래에서만 파열구가 안정", fillcolor="#ffc72c", penwidth=2.6];
        TEAR_RATE [label="파열구 성장률 dA_en/dt\n= k·A_en·softplus(ASI_flap − 0.45)", fillcolor="#ffc72c", penwidth=2.2];
        WHEAT     [label="Wheat 원리 (1965)\n압력이 아니라 dP/dt를 낮춰라", fillcolor="#ffe9a8", penwidth=1.8];
        DISSOC    [label="해리 dissociation\n혈관확장제 단독: SBP −33 mmHg, dP/dt +0.3%\nASI 1.65 vs β차단 1.16", fillcolor="#ffe9a8", penwidth=2.2];
    }

    /* ---------- 7. THE LEFT VENTRICLE ----------------------------------- */
    subgraph cluster_lv {
        label="7 · 좌심실 = 충격량 발생기 (LV as an impulse generator)";
        style="rounded,filled"; fillcolor="#fff2ee"; color="#c98f7e"; fontsize=13;
        CTR       [label="심근 수축력 CTR\n(상대값, 기준 1.0)", fillcolor="#f4a582", penwidth=2.0];
        HR        [label="심박수 HR\n기준 62 · 미치료 71 · β차단 57", fillcolor="#f4a582", penwidth=2.0];
        DPDT      [label="dP/dt max\n= 1180 · CTR · (HR/62)^0.25 · (DBP/80)^0.35\nmmHg/s", fillcolor="#f4a582", penwidth=3.0];
        SV        [label="일회박출량 SV\n= 76 · CTR · preload^0.6 · SVR^−0.2", fillcolor="#f4a582"];
        CO        [label="심박출량 CO = HR × SV", fillcolor="#f4a582"];
        PRELOAD   [label="전부하 preload\n혈액량 · 정맥 용적", fillcolor="#f6c4ad"];
        B1_HEART  [label="β1 수용체 (심장)\n수축력 −42% · HR −46% (최대차단)", fillcolor="#f6c4ad"];
        AV_VALVE  [label="대동맥판 (B형에서는 정상)\nA형에서 역류의 원인", fillcolor="#f6c4ad"];
        EJECT     [label="구혈 가속도\nejection acceleration = 판막 충격량", fillcolor="#f6c4ad"];
    }

    /* ---------- 8. SYSTEMIC HAEMODYNAMICS ------------------------------- */
    subgraph cluster_haemo {
        label="8 · 전신 혈역학 (Systemic haemodynamics)";
        style="rounded,filled"; fillcolor="#eef4fb"; color="#6a90bd"; fontsize=13;
        SVR       [label="전신혈관저항 SVR\n기준 17.5 mmHg·min/L", fillcolor="#b8d0ea", penwidth=2.0];
        CART      [label="동맥 컴플라이언스 C_art\n= 1.72 / (1+0.55(1−ELN))\n× (1 + 0.25·CCB + 0.30·NO)", fillcolor="#b8d0ea", penwidth=1.8];
        PP_N      [label="맥압 PP = SV / C_art\n미치료 52 · 혈관확장제 55 mmHg", fillcolor="#b8d0ea", penwidth=1.8];
        MAP_N     [label="평균동맥압 MAP\n= CO × SVR + 5", fillcolor="#b8d0ea", penwidth=2.0];
        SBP_N     [label="수축기압 SBP = MAP + 2PP/3", fillcolor="#b8d0ea", penwidth=2.0];
        DBP_N     [label="확장기압 DBP = MAP − PP/3", fillcolor="#b8d0ea"];
        BV        [label="순환 혈액량 BV\n알도스테론 매개 Na·수분", fillcolor="#d6e4f2"];
        VENO      [label="정맥 용량 venodilation\nNO 공여체에서 전부하 −25%", fillcolor="#d6e4f2"];
        PDIST     [label="원위 진강압 P_dist\n= MAP − 4 mmHg", fillcolor="#d6e4f2"];
        STIFF_N   [label="대동맥 경직도\nELN 소실 → PP 확대", fillcolor="#d6e4f2"];
    }

    /* ---------- 9. AUTONOMIC CONTROL ------------------------------------ */
    subgraph cluster_auto {
        label="9 · 자율신경 조절과 압수용체 재설정 (Autonomic control)";
        style="rounded,filled"; fillcolor="#f4f0fb"; color="#8b7bb8"; fontsize=13;
        BARO_R    [label="대동맥·경동맥 압수용체\narterial baroreceptors", fillcolor="#cdb4e8"];
        BAROSET   [label="압수용체 작동점 BAROSET\ndP/dt = (0.55·106 + 0.45·MAP − set)/48h\n부분 재설정만 일어남", fillcolor="#cdb4e8", penwidth=2.2];
        SNA       [label="교감신경 출력 SNA\n= baro × (1+0.55·통증/10) × (1+0.35·AngII)", fillcolor="#cdb4e8", penwidth=2.6];
        VAGAL     [label="부교감 미주 긴장도", fillcolor="#ddcdf0"];
        REFLEX_T  [label="반사성 빈맥 reflex tachycardia\n혈관확장제에서 HR 71 → 84", fillcolor="#cdb4e8", penwidth=2.2];
        NE_SPILL  [label="노르에피네프린 유출\nα1 + β1 동시 자극", fillcolor="#ddcdf0"];
        A1_VASC   [label="α1 수용체 (혈관)\n라베탈롤이 차단하는 축", fillcolor="#ddcdf0"];
        B1_JG     [label="β1 수용체 (신장 JG세포)\n레닌 분비 −40% (β차단 시)", fillcolor="#ddcdf0"];
        BARO_BLUNT[label="65세 고혈압에서 압수용체 감도 저하\nKBARO 1.25", fillcolor="#ddcdf0"];
    }

    /* ---------- 10. PAIN ------------------------------------------------ */
    subgraph cluster_pain {
        label="10 · 통증 = 혈역학적 약물 (Pain as a haemodynamic drug)";
        style="rounded,filled"; fillcolor="#f6f0f8"; color="#a07bb0"; fontsize=13;
        NOCICEPT  [label="외막 기계수용성 통각수용체\nC-fibre · Aδ", fillcolor="#e0c8ea"];
        PAIN_ONSET[label="찢어지는 발병 통증\n= 손상신호 INJ (τ 30 h)", fillcolor="#e0c8ea", penwidth=2.0];
        PAIN_PERS [label="지속·재발 통증\n= 벽 응력 (판막 취약성으로 gate)", fillcolor="#e0c8ea", penwidth=2.2];
