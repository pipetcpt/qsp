    /* ======================= EDGES ======================================= */

    /* 1 -> 2 : substrate weakens the media */
    HTN_CHRON -> LAMELLA [label="주기적 부하"];
    HTN_CHRON -> STIFF_N;
    AGE -> ELASTIN [label="피로 파괴"];
    FBN1 -> TGFB_W [label="격리 실패"];
    TGFBR -> TGFB_W;
    ACTA2 -> VSMC;
    COL3A1 -> COLLAGEN;
    BAV -> LAMELLA;
    COARCT -> HTN_CHRON;
    COCAINE -> SNA [label="급성"];
    COCAINE -> DPDT;
    PREG -> ELASTIN;
    FQ -> MMP9_W;
    DECEL -> INTIMAL_T;
    IATRO -> INTIMAL_T;
    WEIGHTLIFT -> DPDT [label="순간 급등"];
    VASA -> VSMC [label="산소"];

    /* 2 : ECM balance */
    LAMELLA -> ELASTIN;
    ELASTIN -> WALL_STR;
    COLLAGEN -> WALL_STR;
    VSMC -> COLLAGEN [label="합성"];
    VSMC -> VSMC_APO;
    VSMC_APO -> GAG;
    GAG -> LAMELLA [label="점액성 변성"];
    MMP2 -> ELASTIN [label="분해", color="#b22222"];
    MMP9_W -> ELASTIN [label="분해", color="#b22222"];
    MMP9_W -> HFL_N [label="얇아짐", color="#b22222"];
    TIMP -> MMP9_W [label="억제", color="#2e7d32", arrowhead=tee];
    TGFB_W -> ADVENT [label="콜라겐 침착", color="#2e7d32"];
    TGFB_W -> MMP9_W [label="양면성"];
    ADVENT -> HFL_N [label="두께 회복", color="#2e7d32"];
    ADVENT -> WALL_STR [color="#2e7d32"];
    ELASTIN -> CART [label="경직도"];

    /* 3 : the tear */
    LAMELLA -> INTIMAL_T [label="분리면 제공"];
    INTIMAL_T -> FLAP;
    INTIMAL_T -> FL [label="혈액 유입"];
    FLAP -> TL;
    FLAP -> FL;
    PROPAG -> EXTENT;
    INTIMAL_T -> PROPAG;
    FL -> REENTRY;
    DEBAKEY -> EXTENT;
    TL -> TL_COLL;
    TL_COLL -> DAO;
    FL -> DAO;

    /* 4 : the divider */
    INTIMAL_T -> G_EN [label="면적", penwidth=2.0];
    REENTRY -> G_RE [label="면적", penwidth=2.0];
    G_EN -> TAU_FL;
    G_RE -> TAU_FL;
    G_EN -> PFL_MEAN [penwidth=2.0];
    G_RE -> PFL_MEAN [penwidth=2.0];
    MAP_N -> PFL_MEAN [label="구동압"];
    PDIST -> PFL_MEAN;
    TAU_FL -> PPFL [label="저역통과", penwidth=2.0];
    PP_N -> PPFL;
    HR -> PPFL [label="ω = 2πHR/60", penwidth=2.0];
    PFL_MEAN -> PFL_DIA;
    PPFL -> PFL_DIA [label="감쇠 → 확장기압 상승", penwidth=2.0];
    G_EN -> FL_FLOW;
    G_RE -> FL_FLOW;
    PPFL -> TOFRO;
    PP_N -> TOFRO;
    TOFRO -> FL_FLOW [penwidth=1.8];
    G_RE -> PATENT [style=dashed];
    G_RE -> BLIND [label="→ 0", style=dashed];
    G_EN -> SEALED [label="→ 0", style=dashed];
    BLIND -> PFL_DIA [label="확장기압 = 전신 평균압", penwidth=2.2, color="#b8860b"];
    PATENT -> FL_FLOW [style=dashed];
    SEALED -> PFL_MEAN [label="9 mmHg로 감압", style=dashed, color="#2e7d32"];

    /* 5 : Laplace */
    PFL_MEAN -> SIG_FL [penwidth=2.2];
    FL -> SIG_FL [label="반지름 r"];
    HFL_N -> SIG_FL [label="÷ h", penwidth=2.2];
    LAPLACE -> SIG_FL;
    LAPLACE -> SIG_TL;
    SBP_N -> SIG_TL;
    TL -> SIG_TL;
    SBP_N -> SIG_FLAP [penwidth=2.0];
    PFL_MEAN -> SIG_FLAP [label="압력차", penwidth=2.0];
    PPFL -> SIG_FLAP;
    FLAP -> SIG_FLAP [label="가동성"];
    THR_FL -> SIG_FLAP [label="혈전이 판막을 지지", color="#2e7d32", arrowhead=tee];
    HFL_N -> ASYM [penwidth=1.8];
    SIG_FL -> ASYM;
    SIG_TL -> ASYM;
    PPFL -> CYCLIC;
    SIG_FL -> SR [penwidth=2.0];
    WALL_STR -> SR [label="÷ S", penwidth=2.0];
    SIG_FL -> GROWTH [label="^1.9", penwidth=2.2];
    MMP9_W -> GROWTH;
    GROWTH -> FL [penwidth=2.0];
    SIG_FL -> ADVENT [label="응력 유발 콜라겐 합성", color="#2e7d32", penwidth=1.8];

    /* 6 : the product */
    SIG_FL -> ASI [label="응력 항", penwidth=2.6];
    DPDT -> ASI [label="충격량 항", penwidth=2.6];
    SIG_FLAP -> ASI_FLAP [penwidth=2.2];
    DPDT -> ASI_FLAP [penwidth=2.2];
    ASI_FLAP -> TEAR_TH [penwidth=2.2];
    TEAR_TH -> TEAR_RATE [penwidth=2.2];
    TEAR_RATE -> INTIMAL_T [label="파열구 확대", penwidth=2.2, color="#b22222"];
    ADVENT -> TEAR_RATE [label="섬유화로 안정화", color="#2e7d32", arrowhead=tee];
    WHEAT -> ASI [style=dashed];
    ASI -> DISSOC [style=dashed];
    DISSOC -> VD_ALONE [style=dashed, penwidth=1.8];
    ASI_FLAP -> E_EXT [penwidth=2.0];

    /* 7 : the ventricle */
    CTR -> DPDT [label="지수 1.0", penwidth=2.2];
    HR -> DPDT [label="지수 0.25"];
    DBP_N -> DPDT [label="지수 0.35"];
    CTR -> SV;
    PRELOAD -> SV;
    SV -> CO;
    HR -> CO;
    SV -> PP_N [penwidth=2.0];
    B1_HEART -> CTR [color="#2e7d32", arrowhead=tee, penwidth=2.0];
    B1_HEART -> HR [color="#2e7d32", arrowhead=tee, penwidth=2.0];
    EJECT -> DPDT;
    CTR -> EJECT;
    AV_VALVE -> EJECT;
    BV -> PRELOAD;
    VENO -> PRELOAD [color="#2e7d32", arrowhead=tee];

    /* 8 : systemic */
    CO -> MAP_N [penwidth=2.0];
    SVR -> MAP_N [penwidth=2.0];
    MAP_N -> SBP_N;
    PP_N -> SBP_N [penwidth=2.0];
    MAP_N -> DBP_N;
    PP_N -> DBP_N;
    CART -> PP_N [label="÷ C", penwidth=2.0];
    STIFF_N -> CART [arrowhead=tee];
    MAP_N -> PDIST;
    ALDO -> BV;

    /* 9 : autonomic */
    MAP_N -> BARO_R [label="감지"];
    BARO_R -> SNA [label="억제", arrowhead=tee, penwidth=2.0];
    BAROSET -> SNA [label="작동점", penwidth=2.0];
    MAP_N -> BAROSET [label="부분 재설정 (45%)"];
    BARO_BLUNT -> SNA;
    SNA -> HR [label="지수 0.85", penwidth=2.2];
    SNA -> CTR [label="지수 0.60", penwidth=2.2];
    SNA -> SVR [label="지수 0.70", penwidth=2.2];
    SNA -> VENO;
    SNA -> NE_SPILL;
    NE_SPILL -> A1_VASC;
    A1_VASC -> SVR;
    SNA -> B1_JG;
    B1_JG -> PRA [penwidth=2.0];
    VAGAL -> HR [arrowhead=tee];
    SNA -> REFLEX_T [penwidth=2.2];
    REFLEX_T -> HR [penwidth=2.2];
    REFLEX_T -> DPDT [label="충격량 회복", penwidth=2.2, color="#b22222"];
    REFLEX_T -> PPFL [label="ω 증가 → 감쇠 증가", penwidth=2.0, color="#b22222"];

    /* 10 : pain */
    INTIMAL_T -> NOCICEPT;
    SIG_FL -> NOCICEPT [label="기계적 자극"];
    INJ -> PAIN_ONSET [penwidth=2.0];
    SIG_FL -> PAIN_PERS [penwidth=2.0];
    ADVENT -> PAIN_PERS [label="섬유화로 gate", arrowhead=tee];
    NOCICEPT -> PAIN_SCORE;
    PAIN_ONSET -> PAIN_SCORE;
    PAIN_PERS -> PAIN_SCORE;
    PAIN_SCORE -> SYMPEXC [penwidth=2.0];
    SYMPEXC -> SNA [penwidth=2.2, color="#b22222"];
    PAIN_SCORE -> PAIN_HTN;
    PAIN_HTN -> SBP_N [style=dashed];
    PAIN_PERS -> REFRACT [penwidth=2.0];
    REFRACT -> TEVAR_T [label="class I", penwidth=2.0];
    PAIN_SCORE -> E_PAIN;

    /* 11 : thrombus */
    FL_FLOW -> STASIS [label="역수", arrowhead=tee, penwidth=2.0];
    STASIS -> THR_FL [penwidth=2.2];
    STASIS -> THR_DIST [penwidth=2.2];
    FL_FLOW -> LYSIS;
    LYSIS -> THR_FL [arrowhead=tee];
    THR_DIST -> G_RE [label="재유입 폐쇄", arrowhead=tee, penwidth=2.2, color="#b22222"];
    THR_FL -> SUPPORT [penwidth=2.0];
    SUPPORT -> GROWTH [arrowhead=tee, color="#2e7d32", penwidth=2.0];
    THR_FL -> ILT_PROT [penwidth=2.0];
    ILT_PROT -> HFL_N [label="1/(1+THR)", color="#b22222", penwidth=2.2];
    THR_FL -> MMP9_S;
    SUPPORT -> PARADOX [penwidth=2.2];
    ILT_PROT -> PARADOX [penwidth=2.2];
    PARADOX -> GROWTH [label="THR* = 0.426에서 최대", penwidth=2.4, color="#b8860b"];
    THR_FL -> G_EN [label="완전 혈전화만 봉인 (>0.70)", arrowhead=tee, penwidth=2.0];
    THR_FL -> ORGANISE;
    ORGANISE -> FL [label="서행성 축소", arrowhead=tee, color="#2e7d32"];
    THR_FL -> DDIMER;
    FL_FLOW -> DDIMER;

    /* 12 : inflammation */
    INTIMAL_T -> INJ [penwidth=2.0];
    INJ -> IL6 [penwidth=2.0];
    SIG_FL -> IL6 [label="기계전달 (포화)"];
    IL6 -> CRP;
    IL6 -> NEUT;
    NEUT -> MAC;
    MAC -> MMP9_S [penwidth=2.0];
    IL6 -> MMP9_S [penwidth=2.0];
    ANGII -> MMP9_S [label="AT1 매개", penwidth=2.0];
    MMP9_S -> MMP9_W [penwidth=2.2];
    ELASTIN -> SMC_SIG;
    SMC_SIG -> NEUT;
    INJ -> FEVER;
    INJ -> TGFB_W [penwidth=2.0];
    NEUT -> ILT_PROT;

    /* 13 : malperfusion */
    FL -> STATIC;
    PFL_DIA -> DYNAMIC [penwidth=2.2];
    DBP_N -> DYNAMIC [arrowhead=tee];
    FL -> DYNAMIC [label="가강 우위"];
    DYNAMIC -> TL_COLL [penwidth=2.0];
    STATIC -> RENAL_P [arrowhead=tee, penwidth=2.0];
    DYNAMIC -> RENAL_P [arrowhead=tee, penwidth=2.0];
    DYNAMIC -> MESENT [arrowhead=tee];
    DYNAMIC -> LIMB [arrowhead=tee];
    MAP_N -> RENAL_P;
    MAP_N -> SPINAL_P;
    MAP_N -> MESENT;
    CELIAC -> MESENT;
    RENAL_P -> CREAT_N [arrowhead=tee];
    MESENT -> LACT_N [arrowhead=tee];
    RENAL_P -> E_AKI [arrowhead=tee];
    MESENT -> E_MESENT [arrowhead=tee, penwidth=2.0];
    LIMB -> FENEST;
    PETTIC -> TL_COLL [arrowhead=tee, color="#2e7d32"];
    PETTIC -> DYNAMIC [arrowhead=tee, color="#2e7d32"];

    /* 14 : the renin trap */
    RENAL_P -> JG [label="관류압 하강", arrowhead=tee, penwidth=2.2];
    JG -> PRA [penwidth=2.4];
    PRA -> ANGII [penwidth=2.4];
    ANGII -> SVR [label="+30%", penwidth=2.2, color="#b22222"];
    ANGII -> SNA [penwidth=2.0];
    ANGII -> ALDO;
    ANGII -> AT1;
    AT1 -> SVR;
    ANGII -> TRAP [penwidth=2.2];
    RENAL_P -> TRAP [penwidth=2.2];
    TRAP -> REFRAC_HTN [penwidth=2.4];
    REFRAC_HTN -> FIX [penwidth=2.0];
    FIX -> RENAL_P [color="#2e7d32", penwidth=2.0];
    B1_JG -> PRA [label="β차단 −40%", arrowhead=tee, color="#2e7d32", penwidth=2.0];

    /* 15 : the cord */
    THR_FL -> SEGM [label="늑간동맥 소실", arrowhead=tee, penwidth=2.0];
    TEVAR -> SEGM [label="피복 30%", arrowhead=tee, penwidth=2.2];
    SEGM -> SCI_N [arrowhead=tee];
    SPINAL_P -> SCI_N [arrowhead=tee, penwidth=2.0];
    SCI_N -> COLLAT [label="허혈이 모집을 유발", penwidth=2.0];
    COLLAT -> SCI_N [label="대체 공급", arrowhead=tee, color="#2e7d32", penwidth=2.2];
    SUBCLAV -> COLLAT;
    ILIAC -> COLLAT;
    ASA -> SCI_N;
    CSF_D -> SPINAL_P [color="#2e7d32"];
    SCI_N -> PARA_N [penwidth=2.0];
    MAP_AUG -> SPINAL_P [color="#2e7d32", penwidth=2.0];
    MAP_AUG -> SIG_FL [label="같은 압력이 대동맥도 부하", color="#b22222"];
    STAGED -> COLLAT [color="#2e7d32"];
    PARA_N -> E_PARA;

    /* 16 : beta-blockers */
    ESM_INF -> ESM_PK;
    ESM_PK -> ESM_CONC;
    ESM_CONC -> B1_OCC [penwidth=2.0];
    LAB_INF -> LAB_PK;
    LAB_PK -> B1_OCC [penwidth=2.0];
    LAB_PK -> A1_VASC [label="α1 차단", arrowhead=tee, penwidth=2.0];
    MET_PO -> B1_OCC;
    B1_OCC -> B1_HEART [penwidth=2.4];
    B1_OCC -> B1_JG [arrowhead=tee, penwidth=2.0];
    B1_OCC -> BB_TRIPLE [penwidth=2.2];
    BB_TRIPLE -> DPDT [arrowhead=tee, penwidth=2.6, color="#2e7d32"];
    BB_TRIPLE -> ASI [arrowhead=tee, penwidth=2.6, color="#2e7d32"];
    BB_CAUTION -> ESM_INF [style=dashed];

    /* 17 : vasodilators */
    NIC_INF -> NIC_PK;
    NIC_PK -> DHP_OCC [penwidth=2.0];
    CLV_INF -> DHP_OCC;
    DHP_OCC -> SVR [arrowhead=tee, penwidth=2.2, color="#2e7d32"];
    DHP_OCC -> CART [label="컴플라이언스 증가", color="#2e7d32"];
    SNP_INF -> SNP_NO;
    SNP_NO -> SVR [arrowhead=tee, penwidth=2.0, color="#2e7d32"];
    SNP_NO -> VENO [penwidth=2.0];
    SNP_INF -> CN [label="화학량론 5:1", penwidth=2.2, color="#b22222"];
    CN -> RHODAN;
    RHODAN -> SCN;
    RENAL_P -> SCN [label="신배설 의존", arrowhead=tee, penwidth=2.0];
    CN -> CN_TOX [penwidth=2.2];
    SCN -> CN_TOX;
    CN_TOX -> LACT_N [penwidth=2.0, color="#b22222"];
    CN_TOX -> E_CNTOX;
    DHP_OCC -> MAP_N [arrowhead=tee, penwidth=2.0];
    MAP_N -> BARO_R;
    VD_ALONE -> REFLEX_T [penwidth=2.2, color="#b22222"];
    VD_ALONE -> E_MORT72 [label="72h 사망률 5.1% > 무치료 2.3%", penwidth=2.6, color="#b22222"];
    NITRO_ALT -> SVR [arrowhead=tee];

    /* 18 : analgesia and ARB */
    FENT -> MOR_OCC [penwidth=2.0];
    MORPH -> MOR_OCC;
    MOR_OCC -> PAIN_SCORE [arrowhead=tee, penwidth=2.2, color="#2e7d32"];
    LOS -> E3174 [penwidth=2.0];
    LOS -> AT1_BLK;
    E3174 -> AT1_BLK [penwidth=2.0];
    AT1_BLK -> AT1 [arrowhead=tee, penwidth=2.2, color="#2e7d32"];
    AT1_BLK -> MMP9_S [arrowhead=tee, color="#2e7d32"];
    AT1_BLK -> TGFB_W [label="콜라겐도 함께 잃는다", arrowhead=tee, color="#b22222", penwidth=2.0];
    AT1_BLK -> ARB_NET [penwidth=2.2];
    TGFB_W -> ARB_NET [penwidth=2.0];
    ARB_NET -> E_GROWTH [style=dashed];
    STATIN -> E_SURV5 [style=dashed];
    NOSMOKE -> E_QOL;

    /* 19 : interventions */
    TEVAR -> G_EN [label="입구 봉인", arrowhead=tee, penwidth=2.6, color="#2e7d32"];
    TEVAR -> FLAP [label="판막 고정", arrowhead=tee, penwidth=2.0];
    G_EN -> FL_FLOW;
    TEVAR -> FL_THROMB [penwidth=2.2];
    FL_THROMB -> THR_FL [penwidth=2.2];
    FL_THROMB -> REMODEL [penwidth=2.0];
    REMODEL -> E_GROWTH [penwidth=2.0, color="#2e7d32"];
    TEVAR_T -> TEVAR [penwidth=2.0];
    TEVAR -> RETRO_D [color="#b22222"];
    TEVAR -> ENDOLEAK [color="#b22222"];
    ENDOLEAK -> PFL_MEAN [label="재가압", color="#b22222", penwidth=2.0];
    OPEN_REP -> REMODEL;
    FENEST -> RENAL_P [color="#2e7d32"];
    SURV_MON -> THRESH55;
    THRESH55 -> TEVAR [penwidth=2.0];
    E_T55 -> THRESH55 [penwidth=2.0];

    /* 20 : endpoints */
    GROWTH -> E_GROWTH [penwidth=2.2];
    DAO -> E_T55 [penwidth=2.0];
    SR -> E_RUPT [penwidth=2.4];
    E_RUPT -> E_MORT72 [penwidth=2.0];
    E_EXT -> E_MORT72 [penwidth=2.2];
    E_MESENT -> E_MORT72 [penwidth=2.0];
    SBP_N -> E_BPTGT;
    HR -> E_BPTGT;
    E_RUPT -> E_SURV5 [penwidth=2.0];
    E_GROWTH -> E_SURV5 [penwidth=2.0];
    ENDOLEAK -> E_REINT;
    THRESH55 -> E_REINT;
    E_QOL -> SBP_N [label="순응도", style=dashed];
    ASI -> E_MORT72 [label="72h 사망률의 순서를 정하는 것은\n압력이 아니라 이 곱이다", penwidth=2.8, color="#b8860b"];
}
