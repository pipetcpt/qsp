        Furos      [label = "Furosemide /\nbumetanide"];
        NKCC1_inh  [label = "NKCC1 inhibition\n→ If ↓ ~20 %"];
        Melatonin  [label = "Melatonin 2 mg\nnightly", fillcolor = "#a8c4e0", penwidth = 2.4];
        Sleep_qual [label = "Sleep consolidation ·\nslow-wave enhancement"];
        Solifen    [label = "Solifenacin /\nmirabegron\n(overactive bladder)", fillcolor = "#a8c4e0", penwidth = 2.4];
        M3_block   [label = "Detrusor M₃\nblockade"];
        M1_central [label = "Central M₁ blockade\n→ cognition ↓", fillcolor = "#a8c4e0", penwidth = 2.4];
        Donepezil  [label = "Donepezil\n(comorbid AD)"];
        AChE       [label = "AChE inhibition"];
        Topiram    [label = "Topiramate\n(weak CA inhibitor)"];
