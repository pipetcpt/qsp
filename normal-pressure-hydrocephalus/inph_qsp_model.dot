        PSP_ddx -> Postural [style = dotted, color = "#666666"];
        PD_ddx -> Gait_apraxia [style = dotted, color = "#666666"];
        DLB_ddx -> Cognition [style = dotted, color = "#666666"];
        Spond_ddx -> Gait_apraxia [style = dotted, color = "#666666"];
