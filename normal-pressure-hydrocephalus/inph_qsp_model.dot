        SIH_ddx -> Low_head [style = dotted, color = "#666666"];
    }

    /* ===================================================================== */
    /* 19. MODEL STRUCTURE — the 44 ODE compartments                          */
    /* ===================================================================== */
    subgraph cluster_model {
        label = <<B>19 · MODEL STRUCTURE — 44 ODE states + 1 closed-form fast state</B>>;
        style = "filled,rounded"; fillcolor = "#ecebf7"; color = "#5a55a3";
        fontsize = 18; penwidth = 2.0;
        node [shape = note, fillcolor = "#d5d3ee", color = "#4a4590"];

        M_hydro    [label = "HYDRO / STRUCTURE (10)\nVv · Vsas · Vsdh · Rout · E1\nVplast · Wpv · AQ · Cart · Autoreg"];
        M_wm       [label = "WHITE MATTER / GLIA (5)\nWMint · WMperm · Myel\nAstro · Micro"];
        M_bio      [label = "BIOMARKERS (7)\nAb_isf · Ab_plq · Tau_isf\nA_ab · A_pt · A_nfl · A_lrg"];
        M_pk       [label = "DRUG PK (11)\nacetazolamide gut/central/RBC\nbumetanide · solifenacin\ndonepezil · melatonin"];
        M_safety   [label = "SYSTEMIC (2)\nHCO3 · K⁺"];
        M_device   [label = "DEVICE (2)\nOccl · Vdr"];
        M_clin     [label = "CLINICAL (7)\nGslow · Gfast · Cslow · Cfast\nUrin · Headx · SDHhaz"];
        M_fast     [label = "CLOSED FORM\ndVac (tap-test volume,\nexact exponential step)\nP, Qsh, Qabs, C, AMP\n(algebraic flow balance)"];

        M_hydro -> M_wm -> M_clin [style = invis];
        M_bio -> M_pk [style = invis];
        M_safety -> M_device [style = invis];
    }

    /* ===================================================================== */
    /* 20. ENDPOINTS AND TRIALS                                              */
    /* ===================================================================== */
    subgraph cluster_trials {
        label = <<B>20 · ENDPOINTS &amp; EVIDENCE ANCHORS</B>>;
        style = "filled,rounded"; fillcolor = "#e6f7f2"; color = "#2e8b70";
        fontsize = 18; penwidth = 2.0;
        node [fillcolor = "#c2ebdf", color = "#237059";
              shape = box, style = "rounded,filled"];

        Ep_gait    [label = "PRIMARY: gait velocity\nor 10-m walk time"];
        Ep_inphgs  [label = "iNPHGS · mRS ·\nKiefer index"];
        Ep_mmse    [label = "MMSE / MoCA ·\nexecutive battery"];
        Ep_cont    [label = "Continence diary"];
        Ep_safety  [label = "Subdural collection ·\nrevision · infection"];
        Tr_dutch   [label = "Dutch NPH Study\nlow vs medium\nvalve pressure"];
        Tr_svasona [label = "SVASONA:\ngravitational unit\nvs programmable alone"];
        Tr_sinphoni [label = "SINPHONI / SINPHONI-2\nDESH · LP shunt"];
        Tr_place   [label = "PLACID / PENS\nplacebo-controlled\nshunt designs"];
        Guide      [label = "Japanese iNPH\nguidelines · international\nevidence-based guidelines"];

        Gait_vel -> Ep_gait [style = dotted, color = "#666666"];
        iNPHGS -> Ep_inphgs [style = dotted, color = "#666666"];
        MMSE -> Ep_mmse [style = dotted, color = "#666666"];
        Urgency -> Ep_cont [style = dotted, color = "#666666"];
        Subdural -> Ep_safety [style = dotted, color = "#666666"];
        Revision -> Ep_safety [style = dotted, color = "#666666"];
        Tr_dutch -> DP_valve [style = dotted, color = "#666666"];
        Tr_svasona -> Grav_unit [style = dotted, color = "#666666"];
        Tr_sinphoni -> DESH_node [style = dotted, color = "#666666"];
        Tr_place -> Ep_gait [style = dotted, color = "#666666"];
        Guide -> Tap_test [style = dotted, color = "#666666"];
    }

    /* ===================================================================== */
    /* Cross-cluster spine (kept few, so the layout stays readable)           */
    /* ===================================================================== */
    If_node   -> Vent_lat   [penwidth = 2.6, label = "  secretion", fontsize = 12];
    Vent_lat  -> Vv_node    [style = dotted, color = "#666666"];
    Vv_node   -> Vent_lat   [style = dashed, color = "#c0392b",
                             label = "enlargement\nsqueezes convexity", fontsize = 11];
    Vv_node   -> SAS_conv   [style = dashed, color = "#c0392b", penwidth = 1.8];
    Qsh_node  -> Vent_lat   [style = dashed, color = "#c0392b", penwidth = 2.4,
                             label = "  CSF removed", fontsize = 12];
    ICP_mean  -> Qabs       [penwidth = 2.0];
    ICP_mean  -> Qsh_node   [penwidth = 2.4];
    Wpv_node  -> Vp_pulse   [label = "oedema raises\npulse transmission", fontsize = 11];
    AD_burden -> Slow_comp  [style = dashed, color = "#c0392b"];
    Gly_flux  -> Astrogliosis [style = dashed, color = "#c0392b"];
    E1_node   -> AMP_node   [penwidth = 2.4, label = "  stiffer → larger pulse", fontsize = 12];
    ICP_mean  -> E1_node    [style = dashed, color = "#c0392b", penwidth = 2.0,
                             label = "sustained decompression\n→ elastance recovers\n(months)", fontsize = 11];
    Wpv_node  -> E1_node    [style = dashed, color = "#c0392b"];
}
