        VaD_ddx    [label = "Vascular dementia ·\nsubcortical SVD"];
        PSP_ddx    [label = "Progressive\nsupranuclear palsy"];
        PD_ddx     [label = "Parkinson disease ·\nvascular parkinsonism"];
        DLB_ddx    [label = "Dementia with\nLewy bodies"];
        Spond_ddx  [label = "Cervical / lumbar\nspondylotic myelopathy"];
