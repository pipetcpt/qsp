        NKCC1_inh -> NKCC1_cp [style = dashed, color = "#c0392b"];
        Melatonin -> Sleep_qual -> Sleep_SWS [penwidth = 2.4];
        CPAP_node -> Sleep_qual [penwidth = 2.0];
        Solifen -> M3_block -> Detrusor [style = dashed, color = "#c0392b", penwidth = 2.4];
        Solifen -> M1_central -> Cognition [style = dashed, color = "#c0392b", penwidth = 2.4];
        Donepezil -> AChE -> Cognition [penwidth = 2.0];
        Topiram -> CAII [style = dashed, color = "#c0392b"];
        Statin_ctl -> Vasc_risk [style = dashed, color = "#c0392b"];
    }

    /* ===================================================================== */
    /* 17. ENDOSCOPIC THIRD VENTRICULOSTOMY                                  */
    /* ===================================================================== */
    subgraph cluster_etv {
        label = <<B>17 · ETV — the intervention with no hydrostatic column, and no benefit here</B>>;
        style = "filled,rounded"; fillcolor = "#f7f2e4"; color = "#9a7a2e";
        fontsize = 18; penwidth = 2.0;
        node [fillcolor = "#e9dcbb", color = "#856823"];

        ETV_node   [label = "Endoscopic third\nventriculostomy", fillcolor = "#d9c58f", penwidth = 2.6];
        Stoma      [label = "Floor of the third\nventricle → prepontine\ncistern"];
        Bypass     [label = "Bypasses INTRA-\nventricular resistance\n(aqueduct, foramina)"];
        Downstream [label = "But Rout in iNPH is\nDOWNSTREAM of the\nstoma (arachnoid /\nglymphatic)", fillcolor = "#d9c58f", penwidth = 2.8];
        No_siphon  [label = "No distal catheter →\nNO siphoning,\nNO subdural risk", fillcolor = "#d9c58f", penwidth = 2.6];
        ETV_fail   [label = "Predicted near-zero\nbenefit in\nCOMMUNICATING iNPH"];
        Obstructive [label = "(Contrast: OBSTRUCTIVE\nhydrocephalus / LOVA →\nETV works)"];

        ETV_node -> Stoma -> Bypass -> Downstream -> ETV_fail [penwidth = 2.0];
        ETV_node -> No_siphon [penwidth = 2.0];
        Bypass -> Aqueduct [style = dashed, color = "#c0392b"];
        Downstream -> Rout_node [style = dotted, color = "#666666",
                                 label = "≈ 6 % reduction only", fontsize = 11];
        Obstructive -> ETV_node [style = dotted, color = "#666666"];
    }

