digraph CAD_QSP {
  rankdir=LR;
  fontname="Helvetica";
  labelloc="t";
  label="Cold Agglutinin Disease (CAD) — Mechanistic QSP Map\nClonal IgM Cold Agglutinin → Classical Complement Activation → Hemolysis";
  node [style=filled, fontname="Helvetica", fontsize=10, shape=box];
  edge [fontname="Helvetica", fontsize=8];

  subgraph cluster_gen {
    label="1. Genetic / Clonal Predisposition"; style=filled; color="#e8ddf0"; fillcolor="#f3ecf9";
    MYD88_WT [label="MYD88 wild-type\n(clone, unlike WM)"];
    KMT2D_mut [label="KMT2D mutation\n(~15%)"];
    CXCR4_variant [label="CXCR4 variant\n(rare)"];
    Trisomy3 [label="Trisomy 3\n(clonal cytogenetics)"];
    Clonal_LPL [label="Clonal marrow\nlymphoproliferative disorder"];
    Age_immunosenescence [label="Age-related\nimmunosenescence"];
    Infection_trigger_Mycoplasma [label="Mycoplasma pneumoniae\ninfection (secondary CAD)"];
    Infection_trigger_EBV [label="EBV / infectious\nmononucleosis (secondary)"];
  }

  subgraph cluster_bcell {
    label="2. Clonal B-cell Lymphoproliferation & IgM Production"; style=filled; color="#dbe8f5"; fillcolor="#eaf3fb";
    BoneMarrow_ClonalBcell [label="Bone marrow\nclonal B-lymphocyte population"];
    Clonal_burden [label="Clonal B-cell\nburden"];
    Plasmacytoid_differentiation [label="Plasmacytoid\ndifferentiation"];
    IL6_BAFF_support [label="IL-6 / BAFF\nmicroenvironment support"];
    Monoclonal_IgM_secretion [label="Monoclonal IgM\nsecretion"];
    IgM_pentamer_assembly [label="IgM pentamer\nassembly (J chain)"];
    J_chain [label="J-chain\nlinkage"];
    Anti_I_specificity [label="Anti-I\nspecificity (~90%)"];
    Anti_i_specificity [label="Anti-i\nspecificity (rare)"];
    Serum_FLC [label="Serum free\nlight chain (κ-restricted)"];
  }

  subgraph cluster_bind {
    label="3. Cold-Dependent Antibody–RBC Binding"; style=filled; color="#d9f0ea"; fillcolor="#eafaf5";
    Peripheral_cooling [label="Peripheral\nacral cooling (<30°C)"];
    Acral_circulation_temp [label="Acral circulation\ntemperature gradient"];
    Thermal_amplitude [label="Thermal amplitude\n(biomarker)"];
    IgM_conformational_change [label="IgM cold-induced\nconformational change"];
    RBC_I_antigen [label="RBC surface\nI/i antigen"];
    IgM_RBC_binding [label="IgM–RBC\nbinding"];
    Agglutination [label="RBC\nagglutination"];
    Microvascular_sludging [label="Microvascular\nsludging"];
    Rewarming_dissociation [label="Core rewarming →\nIgM dissociation"];
    Core_temp_gradient [label="Core-to-periphery\ntemperature gradient"];
  }

  subgraph cluster_cp {
    label="4. Classical Complement Pathway Activation"; style=filled; color="#f5e3d3"; fillcolor="#fbf1e6";
    C1q_binding [label="C1q binding\nto IgM Fc"];
    C1r_activation [label="C1r\nactivation"];
    C1s_activation [label="C1s serine\nprotease activation"];
    C4_cleavage [label="C4\ncleavage"];
    C4b_deposition [label="C4b\ndeposition"];
    C2_cleavage [label="C2\ncleavage"];
    C3_convertase [label="C3 convertase\n(C4b2a)"];
    C3_cleavage [label="C3\ncleavage"];
    C3b_deposition [label="C3b deposition\non RBC surface"];
    iC3b_formation [label="iC3b\nformation"];
    C3d_deposition [label="C3d\nresidual deposition"];
    Complement_regulators [label="RBC regulators\n(CD55/DAF, CD59, MCP)"];
  }

  subgraph cluster_tc {
    label="5. Terminal Complement / MAC"; style=filled; color="#fbdede"; fillcolor="#fdeeee";
    C5_convertase [label="C5 convertase\n(C4b2a3b)"];
    C5_cleavage [label="C5\ncleavage"];
    C5a_anaphylatoxin [label="C5a\nanaphylatoxin"];
    C5b67_complex [label="C5b-6-7\ncomplex"];
    C5b9_MAC [label="C5b-9\nMembrane Attack Complex"];
    RBC_membrane_pore [label="RBC membrane\npore formation"];
    Intravascular_hemolysis [label="Intravascular\nhemolysis"];
    Free_hemoglobin_plasma [label="Free plasma\nhemoglobin"];
  }

  subgraph cluster_ev {
    label="6. Extravascular Hemolysis (Liver Kupffer Cells)"; style=filled; color="#e3ecd8"; fillcolor="#eef5e5";
    CR1_CRIg_receptor [label="Kupffer cell\nCR1 / CRIg receptor"];
    Kupffer_cell_phagocytosis [label="Kupffer cell\nphagocytosis"];
    Erythrophagocytosis [label="Erythrophagocytosis\n(C3b-opsonized RBC)"];
    Spherocyte_formation [label="Partial\nspherocyte formation"];
    Splenic_clearance [label="Splenic clearance\n(minor role)"];
    Liver_iron_recycling [label="Hepatic iron\nrecycling"];
    Macrophage_activation [label="Macrophage\nactivation state"];
    Extravascular_hemolysis_rate [label="Extravascular\nhemolysis rate"];
  }

  subgraph cluster_bio {
    label="7. Hemolysis Consequences / Biomarkers"; style=filled; color="#fdeacb"; fillcolor="#fef5e3";
    Hemoglobin_level [label="Hemoglobin\nlevel (g/dL)"];
    Anemia_severity [label="Anemia\nseverity"];
    Reticulocyte_count [label="Reticulocyte\ncount"];
    Indirect_bilirubin [label="Indirect\nbilirubin"];
    LDH_release [label="LDH\nrelease"];
    Haptoglobin_depletion [label="Haptoglobin\ndepletion"];
    Urine_hemoglobinuria [label="Urine\nhemoglobinuria"];
    Plasma_free_Hb [label="Plasma\nfree Hb"];
    Compensatory_erythropoiesis [label="Compensatory\nerythropoiesis"];
    EPO_response [label="Renal EPO\nresponse"];
  }

  subgraph cluster_clin {
    label="8. Clinical Manifestations"; style=filled; color="#e0e0f5"; fillcolor="#ececfb";
    Fatigue [label="Fatigue"];
    Acrocyanosis [label="Acrocyanosis"];
    Raynaud_like [label="Raynaud-like\nphenomenon"];
    Livedo_reticularis [label="Livedo\nreticularis"];
    Cold_crisis [label="Cold-induced\nhemolytic crisis"];
    Hemoglobinuria_symptom [label="Symptomatic\nhemoglobinuria"];
    Jaundice [label="Jaundice /\nscleral icterus"];
    Dyspnea_exertional [label="Exertional\ndyspnea"];
    Cognitive_fatigue [label="Cognitive\nfatigue / brain fog"];
    QoL_score [label="QoL /\nFACIT-Fatigue score"];
  }

  subgraph cluster_assoc {
    label="9. Associated / Secondary Conditions"; style=filled; color="#f0d9df"; fillcolor="#faeaef";
    LPL_transformation [label="Lymphoplasmacytic\nlymphoma transformation"];
    Waldenstrom_overlap [label="Waldenström\nmacroglobulinemia overlap"];
    Cold_agglutinin_syndrome [label="Cold agglutinin\nsyndrome (secondary CAD)"];
    Thrombosis_risk [label="Complement-mediated\nprocoagulant / thrombosis risk"];
  }

  subgraph cluster_rtx {
    label="10. Drug PK/PD — Rituximab (anti-CD20)"; style=filled; color="#cfe8db"; fillcolor="#e3f4ea";
    Rituximab_dose [label="Rituximab\nIV dose", shape=ellipse, fillcolor="#b7ddc4"];
    Rituximab_central [label="Rituximab\ncentral compartment", shape=ellipse, fillcolor="#b7ddc4"];
    Rituximab_peripheral [label="Rituximab\nperipheral compartment", shape=ellipse, fillcolor="#b7ddc4"];
    CD20_binding [label="CD20\nbinding on clonal B cells"];
    ADCC_CDC_lysis [label="ADCC / CDC\nB-cell lysis"];
    Bcell_depletion [label="Clonal B-cell\ndepletion"];
    IgM_titer_decline [label="IgM titer\ndecline (weeks-months)"];
    Bcell_repopulation [label="B-cell repopulation\n→ relapse"];
  }

  subgraph cluster_benda {
    label="11. Drug PK/PD — Bendamustine"; style=filled; color="#d8e0ee" fillcolor="#e9eef8";
    Bendamustine_dose [label="Bendamustine\nIV dose", shape=ellipse, fillcolor="#b9c6e8"];
    Bendamustine_central [label="Bendamustine\ncentral compartment", shape=ellipse, fillcolor="#b9c6e8"];
    Bendamustine_peripheral [label="Bendamustine\nperipheral compartment", shape=ellipse, fillcolor="#b9c6e8"];
    DNA_crosslinking [label="Alkylation /\nDNA cross-linking"];
    Clonal_apoptosis [label="Clonal\nlymphocyte apoptosis"];
    Marrow_suppression [label="Marrow\nsuppression"];
    Combination_synergy [label="Synergy with\nrituximab (RB regimen)"];
    Cytopenia_risk [label="Cytopenia /\ninfection risk"];
  }

  subgraph cluster_sutim {
    label="12. Drug PK/PD — Sutimlimab (anti-C1s)"; style=filled; color="#f0d8ce" fillcolor="#faeae2";
    Sutimlimab_dose [label="Sutimlimab\nIV dose", shape=ellipse, fillcolor="#e8b79a"];
    Sutimlimab_central [label="Sutimlimab\ncentral compartment", shape=ellipse, fillcolor="#e8b79a"];
    Sutimlimab_peripheral [label="Sutimlimab\nperipheral compartment", shape=ellipse, fillcolor="#e8b79a"];
    C1s_target_binding [label="C1s target\nbinding (TMDD)"];
    TMDD_saturation [label="Target-mediated\ndisposition saturation"];
    Classical_pathway_blockade [label="Classical pathway\nblockade (upstream of C3)"];
    Rapid_Hb_response [label="Rapid Hb\nresponse (days)"];
    Infusion_reaction_risk [label="Infusion-related\nreaction risk"];
  }

  subgraph cluster_pegce {
    label="13. Drug PK/PD — Pegcetacoplan (C3 inhibitor)"; style=filled; color="#e6d8ee" fillcolor="#f2eaf8";
    Pegcetacoplan_depot [label="Pegcetacoplan\nSC depot", shape=ellipse, fillcolor="#cdaee0"];
    Pegcetacoplan_central [label="Pegcetacoplan\ncentral compartment", shape=ellipse, fillcolor="#cdaee0"];
    C3_binding [label="C3 / C3b\nbinding"];
    C3_convertase_blockade [label="C3 convertase\nblockade"];
    Dual_pathway_inhibition [label="Dual classical +\nalternative pathway inhibition"];
    Breakthrough_hemolysis_risk [label="Breakthrough\nhemolysis risk"];
  }

  subgraph cluster_endpt {
    label="14. Clinical Endpoints & Management"; style=filled; color="#e5e5e5" fillcolor="#f2f2f2";
    Transfusion_requirement [label="RBC transfusion\nrequirement"];
    Hb_response_criteria [label="Hb response\n(≥1.5 g/dL rise)"];
    Steroid_refractory [label="Steroid-refractory\nstatus (hallmark of CAD)"];
    Cold_avoidance [label="Behavioral cold\navoidance"];
    Folate_supplementation [label="Folate\nsupplementation"];
    Thromboprophylaxis [label="Thrombo-\nprophylaxis"];
  }

  /* ---- Genetic/clonal -> B-cell clone ---- */
  MYD88_WT -> Clonal_LPL;
  KMT2D_mut -> Clonal_LPL;
  CXCR4_variant -> Clonal_LPL;
  Trisomy3 -> Clonal_LPL;
  Age_immunosenescence -> Clonal_LPL;
  Infection_trigger_Mycoplasma -> Cold_agglutinin_syndrome;
  Infection_trigger_EBV -> Cold_agglutinin_syndrome;
  Clonal_LPL -> BoneMarrow_ClonalBcell;

  /* ---- B-cell clone -> IgM production ---- */
  BoneMarrow_ClonalBcell -> Clonal_burden;
  Clonal_burden -> Plasmacytoid_differentiation;
  IL6_BAFF_support -> Plasmacytoid_differentiation;
  Plasmacytoid_differentiation -> Monoclonal_IgM_secretion;
  Monoclonal_IgM_secretion -> IgM_pentamer_assembly;
  J_chain -> IgM_pentamer_assembly;
  IgM_pentamer_assembly -> Anti_I_specificity;
  IgM_pentamer_assembly -> Anti_i_specificity;
  Clonal_burden -> Serum_FLC;
  Clonal_burden -> LPL_transformation;
  LPL_transformation -> Waldenstrom_overlap;

  /* ---- Cold-dependent binding ---- */
  Peripheral_cooling -> Acral_circulation_temp;
  Acral_circulation_temp -> Core_temp_gradient;
  Core_temp_gradient -> Thermal_amplitude;
  Thermal_amplitude -> IgM_conformational_change;
  Anti_I_specificity -> IgM_RBC_binding;
  Anti_i_specificity -> IgM_RBC_binding;
  RBC_I_antigen -> IgM_RBC_binding;
  IgM_conformational_change -> IgM_RBC_binding;
  IgM_RBC_binding -> Agglutination;
  Agglutination -> Microvascular_sludging;
  Microvascular_sludging -> Acrocyanosis;
  Microvascular_sludging -> Raynaud_like;
  Microvascular_sludging -> Livedo_reticularis;
  Core_temp_gradient -> Rewarming_dissociation;
  Rewarming_dissociation -> IgM_RBC_binding [style=dashed, label="dissociates on rewarming"];

  /* ---- Classical complement activation ---- */
  IgM_RBC_binding -> C1q_binding;
  C1q_binding -> C1r_activation;
  C1r_activation -> C1s_activation;
  C1s_activation -> C4_cleavage;
  C4_cleavage -> C4b_deposition;
  C4b_deposition -> C2_cleavage;
  C2_cleavage -> C3_convertase;
  C3_convertase -> C3_cleavage;
  C3_cleavage -> C3b_deposition;
  C3b_deposition -> iC3b_formation;
  iC3b_formation -> C3d_deposition;
  Complement_regulators -> C3b_deposition [style=dashed, label="down-regulates"];
  Complement_regulators -> C5b9_MAC [style=dashed, label="down-regulates"];

  /* ---- Terminal complement ---- */
  C3_convertase -> C5_convertase;
  C3b_deposition -> C5_convertase;
  C5_convertase -> C5_cleavage;
  C5_cleavage -> C5a_anaphylatoxin;
  C5_cleavage -> C5b67_complex;
  C5b67_complex -> C5b9_MAC;
  C5b9_MAC -> RBC_membrane_pore;
  RBC_membrane_pore -> Intravascular_hemolysis;
  Intravascular_hemolysis -> Free_hemoglobin_plasma;
  Free_hemoglobin_plasma -> Plasma_free_Hb;
  Free_hemoglobin_plasma -> Urine_hemoglobinuria;
  C5a_anaphylatoxin -> Macrophage_activation;

  /* ---- Extravascular hemolysis ---- */
  iC3b_formation -> CR1_CRIg_receptor;
  CR1_CRIg_receptor -> Kupffer_cell_phagocytosis;
  Macrophage_activation -> Kupffer_cell_phagocytosis;
  Kupffer_cell_phagocytosis -> Erythrophagocytosis;
  Erythrophagocytosis -> Spherocyte_formation;
  Erythrophagocytosis -> Extravascular_hemolysis_rate;
  Spherocyte_formation -> Splenic_clearance;
  Extravascular_hemolysis_rate -> Liver_iron_recycling;

  /* ---- Hemolysis consequences ---- */
  Intravascular_hemolysis -> Hemoglobin_level [label="-"];
  Extravascular_hemolysis_rate -> Hemoglobin_level [label="-"];
  Hemoglobin_level -> Anemia_severity;
  Anemia_severity -> EPO_response;
  EPO_response -> Compensatory_erythropoiesis;
  Compensatory_erythropoiesis -> Reticulocyte_count;
  Erythrophagocytosis -> Indirect_bilirubin;
  Intravascular_hemolysis -> LDH_release;
  Extravascular_hemolysis_rate -> LDH_release;
  Free_hemoglobin_plasma -> Haptoglobin_depletion;

  /* ---- Clinical manifestations ---- */
  Anemia_severity -> Fatigue;
  Fatigue -> QoL_score;
  Cognitive_fatigue -> QoL_score;
  Anemia_severity -> Cognitive_fatigue;
  Anemia_severity -> Dyspnea_exertional;
  Indirect_bilirubin -> Jaundice;
  Urine_hemoglobinuria -> Hemoglobinuria_symptom;
  Peripheral_cooling -> Cold_crisis;
  Agglutination -> Cold_crisis;
  Cold_crisis -> Intravascular_hemolysis [label="acute exacerbation"];
  Thrombosis_risk -> Cold_crisis [style=dashed];
  C5a_anaphylatoxin -> Thrombosis_risk;

  /* ---- Management / endpoints ---- */
  Anemia_severity -> Transfusion_requirement;
  Hemoglobin_level -> Hb_response_criteria;
  Steroid_refractory -> Rituximab_dose [style=dashed, label="prompts B-cell-directed therapy"];
  Cold_avoidance -> Peripheral_cooling [style=dashed, label="mitigates"];
  Folate_supplementation -> Compensatory_erythropoiesis [style=dashed, label="supports"];
  Thromboprophylaxis -> Thrombosis_risk [style=dashed, label="mitigates"];

  /* ---- Rituximab PK/PD ---- */
  Rituximab_dose -> Rituximab_central;
  Rituximab_central -> Rituximab_peripheral [dir=both];
  Rituximab_central -> CD20_binding;
  CD20_binding -> ADCC_CDC_lysis;
  ADCC_CDC_lysis -> Bcell_depletion;
  Bcell_depletion -> Clonal_burden [label="-", color="#2e7d32"];
  Bcell_depletion -> IgM_titer_decline;
  IgM_titer_decline -> Monoclonal_IgM_secretion [label="-", color="#2e7d32"];
  Bcell_depletion -> Bcell_repopulation [style=dashed];
  Bcell_repopulation -> Clonal_burden [style=dashed, label="relapse"];

  /* ---- Bendamustine PK/PD ---- */
  Bendamustine_dose -> Bendamustine_central;
  Bendamustine_central -> Bendamustine_peripheral [dir=both];
  Bendamustine_central -> DNA_crosslinking;
  DNA_crosslinking -> Clonal_apoptosis;
  Clonal_apoptosis -> Clonal_burden [label="-", color="#2e7d32"];
  Bendamustine_central -> Marrow_suppression;
  Marrow_suppression -> Cytopenia_risk;
  Combination_synergy -> Clonal_apoptosis [style=dashed];
  Rituximab_central -> Combination_synergy [style=dashed];
  Bendamustine_central -> Combination_synergy [style=dashed];

  /* ---- Sutimlimab PK/PD ---- */
  Sutimlimab_dose -> Sutimlimab_central;
  Sutimlimab_central -> Sutimlimab_peripheral [dir=both];
  Sutimlimab_central -> C1s_target_binding;
  C1s_target_binding -> TMDD_saturation;
  TMDD_saturation -> Classical_pathway_blockade;
  Classical_pathway_blockade -> C1s_activation [label="-", color="#c62828"];
  Classical_pathway_blockade -> Rapid_Hb_response;
  Rapid_Hb_response -> Hemoglobin_level [label="+", color="#2e7d32"];
  Sutimlimab_central -> Infusion_reaction_risk;

  /* ---- Pegcetacoplan PK/PD ---- */
  Pegcetacoplan_depot -> Pegcetacoplan_central;
  Pegcetacoplan_central -> C3_binding;
  C3_binding -> C3_convertase_blockade;
  C3_convertase_blockade -> C3_cleavage [label="-", color="#c62828"];
  C3_convertase_blockade -> Dual_pathway_inhibition;
  Dual_pathway_inhibition -> C5_convertase [label="-", color="#c62828"];
  Dual_pathway_inhibition -> Breakthrough_hemolysis_risk [style=dashed];
}
