    PIT     [label = "★ π_t — 간질 교질삼투압\nπ_t = 4 + 21·(1 − σ/0.92)·0.75\n4 → 13 mmHg as protein leaks", fillcolor = "#80cbc4", penwidth = 2.0];
    PTISS   [label = "P_t — 간질 정수압\n≈ 12 mmHg", fillcolor = "#b2dfdb"];
