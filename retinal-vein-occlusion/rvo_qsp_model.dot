    style = "rounded,filled"; fillcolor = "#ede7f6"; color = "#4527a0"; fontsize = 13;
    OZUR    [label = "덱사메타손 임플란트 0.7 mg\nDexamethasone implant (Ozurdex)\nPLGA, ~180 d release", fillcolor = "#bbdefb"];
    IMPST   [label = "★ IMP → CDEX\ndIMP/dt = −0.0128·IMP\ndCDEX/dt = release/V_vit − 2.5·CDEX\nplateau ≈ 900 ng/mL", fillcolor = "#90caf9", penwidth = 2.2];
    TRIAM   [label = "트리암시놀론 4 mg (SCORE)\nTriamcinolone acetonide", fillcolor = "#bbdefb"];
    FLUO    [label = "플루오시놀론 임플란트 0.19 mg\nFluocinolone acetonide (36 mo)", fillcolor = "#bbdefb"];
    GR      [label = "글루코코르티코이드 수용체\nGR → GRE / tethered NF-κB, AP-1", fillcolor = "#d1c4e9"];
    ESTER   [label = "★★ ESTER — 스테로이드 효과\nESTER = CDEX/(120 + CDEX)\nVEGF −45% · IL-6 −80% · Ang-2 −50%",
             fillcolor = "#b39ddb", penwidth = 2.6];
    TJUP    [label = "접합 단백 상향\nOccludin / claudin-5 transcription ↑\n(a direct effect anti-VEGF lacks)", fillcolor = "#d1c4e9"];
    OZUR -> IMPST [penwidth = 2.4]; TRIAM -> ESTER [style = dashed];
    FLUO -> ESTER [style = dashed];
    IMPST -> ESTER [penwidth = 2.6]; GR -> ESTER [penwidth = 2.0];
    ESTER -> VEGFGENE [color = "#1565c0", arrowhead = tee, penwidth = 2.2, label = "−45%"];
    ESTER -> IL6N [color = "#1565c0", arrowhead = tee, penwidth = 2.4, label = "−80%"];
    ESTER -> ANG2 [color = "#1565c0", arrowhead = tee, penwidth = 2.0, label = "−50%"];
    ESTER -> TJUP [penwidth = 2.0];
    TJUP -> TJSTATE [color = "#2e7d32", penwidth = 2.0];
  }

  /* =====================================================================
     21 · LASER AND SURGERY
     ===================================================================== */
  subgraph cluster_21 {
    label = "21 · 레이저와 수술 (Laser and surgery)";
    style = "rounded,filled"; fillcolor = "#e3f2fd"; color = "#1565c0"; fontsize = 12;
    PRPN    [label = "범망막 광응고 (PRP)\nPanretinal photocoagulation\nABLA += 0.35 → VEGF production −72%·ABLA", fillcolor = "#bbdefb"];
    GRID    [label = "격자 레이저 (BRVO)\nGrid macular laser (BVOS)", fillcolor = "#bbdefb"];
    ANTIVEGF_PRP [label = "PRP는 부종을 낫게 하지 않는다\nPRP treats the NV drive, not the oedema", fillcolor = "#bbdefb"];
    ILM     [label = "유리체절제 + ILM 제거\nVitrectomy with ILM peel\n(chronic refractory oedema)", fillcolor = "#bbdefb"];
    ROTN    [label = "방사상 시신경절개술 (역사적)\nRadial optic neurotomy — attacks R_v\n(largely abandoned)", fillcolor = "#bbdefb"];
    CRAA    [label = "망막맥락막 문합 (역사적)\nChorioretinal anastomosis — attacks R_v", fillcolor = "#bbdefb"];
    AVSHEATH[label = "동정맥 초 절개 (BRVO, 역사적)\nArteriovenous sheathotomy", fillcolor = "#bbdefb"];
    PRPN -> VEGFGENE [color = "#1565c0", arrowhead = tee, penwidth = 2.2,
                      label = "ablate the\nhypoxic factory"];
    PRPN -> NVISTATE [color = "#1565c0", arrowhead = tee, penwidth = 2.0];
    PRPN -> ANTIVEGF_PRP [style = dashed];
    NPAREA -> PRPN [style = dotted, color = "#616161", label = "indication:\nNP + NVI"];
    GRID -> CST [color = "#1565c0", arrowhead = tee, style = dashed];
    ILM -> JOUTN [color = "#1565c0", penwidth = 1.8, label = "raises clearance"];
    ROTN -> RVEN [color = "#1565c0", arrowhead = tee, penwidth = 1.8,
                  label = "the rare LEFT-half\nintervention"];
    CRAA -> RVEN [color = "#1565c0", arrowhead = tee, penwidth = 1.8];
    AVSHEATH -> RVEN [color = "#1565c0", arrowhead = tee, style = dashed];
  }

  /* =====================================================================
     22 · SYSTEMIC AND ADJUNCTIVE THERAPY
     ===================================================================== */
  subgraph cluster_22 {
    label = "22 · 전신 · 보조 치료 — 좌측(압력항)으로 가는 유일한 화살표 (Systemic therapy: the only arrows into the pressure arm)";
    style = "rounded,filled"; fillcolor = "#e0f7fa"; color = "#00838f"; fontsize = 13;
    BPRX    [label = "★★ 혈압 강하 치료\nACEi/ARB · CCB · thiazide\nlowers P_a — the pressure arm's input", fillcolor = "#80deea", penwidth = 2.6];
    RAAS    [label = "RAAS · 조직 ACE\nAT1R on retinal vessels; local RAS", fillcolor = "#b2ebf2"];
    STATIN  [label = "스타틴 · 지질 관리\nStatin, lipid control", fillcolor = "#b2ebf2"];
    ANTIPLT [label = "항혈소판 · 항응고\nAspirin, DOAC — NO benefit for the\nestablished occlusion; bleeding risk", fillcolor = "#b2ebf2"];
    TPA     [label = "tPA (전신/유리체내/정맥내 캐뉼러)\nHistorical; no proven benefit", fillcolor = "#b2ebf2"];
    HEMOD   [label = "혈액희석 (isovolaemic haemodilution)\nlowers viscosity → lowers R_v\n(European trials, marginal)", fillcolor = "#b2ebf2"];
    IOPRX   [label = "안압 강하제\nIOP-lowering drops / surgery\nlowers P_v", fillcolor = "#b2ebf2"];
    OSA     [label = "수면무호흡 치료 · 금연 · 운동\nOSA treatment, smoking cessation", fillcolor = "#b2ebf2"];
    HOMOCY  [label = "엽산 · B6 · B12\nfor hyperhomocysteinaemia", fillcolor = "#b2ebf2"];
    BPRX -> PAIN [color = "#00838f", arrowhead = tee, penwidth = 3.0,
                  label = "P_a 40 → 32 mmHg\n⇒ R_v* 1.65 → 21.1 (12.8×)"];
    RAAS -> HTN [style = dashed]; BPRX -> RAAS [color = "#00838f", arrowhead = tee];
    HEMOD -> RVEN [color = "#00838f", arrowhead = tee, penwidth = 1.8];
    IOPRX -> PVEN [color = "#00838f", arrowhead = tee, penwidth = 2.0];
    STATIN -> ENDO [color = "#00838f", arrowhead = tee, style = dashed];
    ANTIPLT -> THR [color = "#00838f", arrowhead = tee, style = dashed,
                    label = "prevention only"];
    TPA -> THR [color = "#00838f", arrowhead = tee, style = dashed];
    OSA -> HTN [color = "#00838f", arrowhead = tee, style = dashed];
    HOMOCY -> HYPERC [color = "#00838f", arrowhead = tee, style = dashed];
  }

  /* =====================================================================
     23 · ADVERSE EFFECTS
     ===================================================================== */
  subgraph cluster_23 {
    label = "23 · 이상반응 — 원장의 비용 측면 (Adverse effects)";
    style = "rounded,filled"; fillcolor = "#fce4ec"; color = "#ad1457"; fontsize = 12;
    ENDOPH  [label = "안내염\nEndophthalmitis ~0.02–0.05% / injection\ncumulative with injection number", fillcolor = "#f8bbd0"];
    IOPSPIKE[label = "주사 직후 안압 급상승\nTransient IOP spike (0.05 mL into 4 mL)", fillcolor = "#f8bbd0"];
    STEROIOP[label = "★ 스테로이드 안압 상승\nIOP ≥ 10 mmHg rise in ~16% (GENEVA)\nglaucoma surgery ~1%", fillcolor = "#f48fb1"];
    CATN    [label = "★★ CAT — 백내장\ndCAT/dt = 0.0024·CDEX/(150+CDEX) + age\n~30%/yr with implants; 68% at 3 yr (MEAD)", fillcolor = "#f48fb1", penwidth = 2.4];
    IOI     [label = "안내 염증 · 폐색성 망막혈관염\nIntraocular inflammation / retinal\nvasculitis (brolucizumab ~4%)", fillcolor = "#f8bbd0"];
    RPETEAR [label = "RPE 파열 · 유리체 출혈 · 망막 박리\nRPE tear, vitreous haemorrhage, RD", fillcolor = "#f8bbd0"];
    SYSVEGF [label = "★ 전신 VEGF 억제\naflibercept: plasma free VEGF ~99% suppressed\nranibizumab: ~40%\n→ theoretical ATE / BP / renal signal", fillcolor = "#f48fb1", penwidth = 2.2];
    GEOATR  [label = "위축 · 망막 얇아짐 (장기)\nMacular atrophy with chronic\nVEGF suppression (trophic role)", fillcolor = "#f8bbd0"];
    TACHY   [label = "타키필락시스 · 항약물항체\nTachyphylaxis, anti-drug antibodies", fillcolor = "#f8bbd0"];
    IVT -> ENDOPH [penwidth = 1.8]; IVT -> IOPSPIKE [penwidth = 1.6];
    IVT -> RPETEAR [style = dashed]; BROLU -> IOI [penwidth = 1.8];
    ESTER -> STEROIOP [penwidth = 2.2]; ESTER -> CATN [penwidth = 2.4];
    STEROIOP -> IOPN [penwidth = 2.2]; CATN -> LCAT [penwidth = 2.4];
    ASYSN -> SYSVEGF [penwidth = 2.2];
    CRETN -> GEOATR [style = dashed]; DVITN -> TACHY [style = dashed];
    ENDOPH -> BCVAN [color = "#c62828", style = dashed];
  }

  /* =====================================================================
     24 · BIOMARKERS AND IMAGING
     ===================================================================== */
  subgraph cluster_24 {
    label = "24 · 바이오마커 · 영상 (Biomarkers and imaging)";
    style = "rounded,filled"; fillcolor = "#eceff1"; color = "#455a64"; fontsize = 12;
    OCTM    [label = "OCT — CST · 낭포 · SRF · EZ · DRIL\nthe workhorse", fillcolor = "#e0e0e0"];
    OCTA    [label = "OCT-A — FAZ 면적 · 혈관 밀도\nSCP / DCP perfusion, DCP loss\npredicts letters", fillcolor = "#e0e0e0"];
    FA      [label = "형광안저촬영 (FA) — 비관류 면적\nUltra-widefield FA: DA of non-perfusion", fillcolor = "#e0e0e0"];
    AQHUM   [label = "전방수 사이토카인\nAqueous VEGF, IL-6, IL-8, MCP-1, Ang-2\n(research; correlates with CST)", fillcolor = "#e0e0e0"];
    ERGB    [label = "ERG b/a 비 · 동공 반응\nERG b-wave, RAPD (ischaemia marker)", fillcolor = "#e0e0e0"];
    GONIO   [label = "전방각 검사 · 홍채 형광촬영\nGonioscopy (undilated!), iris FA", fillcolor = "#e0e0e0"];
    BPMON   [label = "24시간 활동혈압 · 야간 강하\n24-h ABPM, nocturnal dip", fillcolor = "#e0e0e0"];
    CST -> OCTM [style = dotted, color = "#616161"];
    EZONE -> OCTM [style = dotted, color = "#616161"];
    DRILN -> OCTM [style = dotted, color = "#616161"];
    MISCH -> OCTA [style = dotted, color = "#616161"];
    NPAREA -> FA [style = dotted, color = "#616161"];
    VTONE -> AQHUM [style = dotted, color = "#616161"];
    IL6N -> AQHUM [style = dotted, color = "#616161"];
    ANG2 -> AQHUM [style = dotted, color = "#616161"];
    MISCH -> ERGB [style = dotted, color = "#616161"];
    NVISTATE -> GONIO [style = dotted, color = "#616161"];
    PAIN -> BPMON [style = dotted, color = "#616161"];
  }

  /* =====================================================================
     25 · CLINICAL DECISION LAYER
     ===================================================================== */
  subgraph cluster_25 {
    label = "25 · 임상 의사결정 층 (The decision layer)";
    style = "rounded,filled"; fillcolor = "#fffde7"; color = "#f9a825"; fontsize = 13;
    LOAD    [label = "부하 요법\nLoading: q4w × 3–6 injections", fillcolor = "#fff59d"];
    PRN     [label = "PRN (as-needed)\nmonthly monitoring, treat if wet", fillcolor = "#fff59d"];
    TAE     [label = "치료-연장 (treat-and-extend)\nextend +4 w if dry, shorten −4 w if wet\ncap 16 w", fillcolor = "#fff59d"];
    FIXEDQ  [label = "고정 간격 q8w\nFixed q8w maintenance", fillcolor = "#fff59d"];
    SWITCH  [label = "약제 전환\nSwitch agent for persistent oedema\n★ useless if the eye is a FLOOR eye", fillcolor = "#ffe082", penwidth = 2.2];
    ADDSTER [label = "스테로이드 추가\nAdd steroid for the non-VEGF mediators\n(pseudophakic, non-responder)", fillcolor = "#fff59d"];
    NVGWATCH[label = "허혈 감시\nIschaemia surveillance: gonioscopy,\nwidefield FA, do NOT stop the drug\nwhile NP persists", fillcolor = "#ffe082", penwidth = 2.2];
    UNDER   [label = "★ 실제 진료의 과소치료\nReal world: 4–5 injections/yr\n→ about half the trial letter gain", fillcolor = "#ffcc80", penwidth = 2.2];
    SYSWORK [label = "전신 검사\nBP, lipids, glucose, CBC;\nthrombophilia only if young/bilateral", fillcolor = "#fff59d"];
    FELLOW  [label = "반대 눈 위험\nFellow-eye RVO risk ~7–10% / 5 yr\n→ systemic risk control matters twice", fillcolor = "#fff59d"];
    CST -> PRN [style = dotted, color = "#616161", label = "retreat if\nCST > 310 µm"];
    CST -> TAE [style = dotted, color = "#616161"];
    LOAD -> PRN; LOAD -> TAE; LOAD -> FIXEDQ;
    PRN -> IVT [color = "#1565c0", style = dashed];
    TAE -> IVT [color = "#1565c0", style = dashed];
    FIXEDQ -> IVT [color = "#1565c0", style = dashed];
    SWITCH -> IVT [color = "#1565c0", style = dashed];
    DRYDAYS -> SWITCH [style = dashed, color = "#bf360c",
                       label = "if wet WHILE suppressed,\ndo not switch"];
    PCSTAR -> ADDSTER [style = dashed];
    PCSTAR -> BPRX [style = dashed, color = "#00838f", penwidth = 2.0,
                    label = "treat the LEFT half"];
    NPAREA -> NVGWATCH [style = dotted, color = "#616161"];
    REBOUND -> NVGWATCH [style = dashed, color = "#c62828"];
    ADDSTER -> OZUR [color = "#1565c0", style = dashed];
    UNDER -> BCVAN [color = "#c62828", style = dashed];
    SYSWORK -> BPRX [style = dashed]; SYSWORK -> FELLOW [style = dashed];
    HTN -> SYSWORK [style = dotted, color = "#616161"];
  }

  /* =====================================================================
     GLOBAL LAYOUT HINTS
     ===================================================================== */
  { rank = same; PCAP; TJSTATE; }
  { rank = same; BRACK; LPNODE; }
  { rank = same; JVNODE; PCSTAR; }
  { rank = same; CST; BCVAN; }
}
