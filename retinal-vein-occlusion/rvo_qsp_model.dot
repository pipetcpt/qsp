/* ===========================================================================
   rvo_qsp_model.dot
   Retinal vein occlusion (CRVO / BRVO) macular oedema — mechanistic QSP map
   망막정맥폐쇄(중심/분지) 황반부종 — 기계론적 QSP 지도

   THE ORGANISING IDEA OF THE MAP
     Read it as ONE equation with THREE inputs.  The centre of the map
     (cluster 13) is the Starling flux across the inner blood-retina barrier:

         Jv  =  Lp · S · [ (Pc - Pt)  -  sigma · (pi_c - pi_t) ]
                \______/   \________/    \___________________/
              PERMEABILITY   PRESSURE           ONCOTIC
                  ARM          ARM                ARM

     Everything on the LEFT of the map feeds the PRESSURE arm: the thrombus,
     the resistance network, arterial inlet pressure, autoregulation, the
     collateral clock.  Everything on the RIGHT feeds the PERMEABILITY and
     ONCOTIC arms: hypoxia, HIF-1alpha, VEGF-A, IL-6, Ang-2, the tight
     junction, the reflection coefficient.

     EVERY anti-VEGF arrow in this map lands on the RIGHT.  Not one lands on
     the left.  That asymmetry is the whole model: anti-VEGF is a multiplier
     in front of a bracket it cannot change.  Hence

         Pc* = Pt + sigma_max·(pi_c - pi_t)   (cluster 13, node PCSTAR)

     is a hard threshold: above it the bracket stays positive with the
     permeability arm already at its floor, and the macula cannot be dried by
     any dose of any agent.  The only arrows that reach the left half are
     systemic blood-pressure lowering (cluster 22), the collateral /
     recanalisation clock (cluster 6), and surgery aimed at the outflow
     (cluster 21).

   READING ORDER
      1  who occludes, and where — the two anatomies (AV crossing vs lamina)
      2  systemic and ocular risk factors
      3  thrombus biology (Virchow) and the natural lysis clock
      4  the resistance network and retinal capillary pressure = PRESSURE ARM
      5  autoregulation: the hypoxic vasodilatation feedback that WORSENS Pc
      6  the collateral / recanalisation clock — the only endogenous cure
      7  stasis, leukostasis and capillary non-perfusion
      8  hypoxia sensing: HIF-1alpha
      9  the VEGF-A axis and its receptors
     10  the non-VEGF permeability mediators (IL-6, Ang-2/Tie2, and others)
     11  the inner blood-retina barrier: junctions, transcytosis, glycocalyx
     12  the outer barrier and the water pumps that fight the flux
     13  THE STARLING NODE and the critical capillary pressure Pc*
     14  retinal morphology: CST, cysts, SRF, DRIL, ellipsoid zone
     15  vision as a sum of a reversible and an irreversible term
     16  neovascularisation: posterior and anterior
     17  intraocular pressure and neovascular glaucoma
     18  anti-VEGF pharmacokinetics (vitreous / retina / plasma)
     19  anti-VEGF pharmacodynamics and the suppression-duration equation
     20  corticosteroids — the mediators anti-VEGF cannot reach, at a price
     21  laser and surgery
     22  systemic and adjunctive therapy — the only arrows into the left half
     23  adverse effects: the cost side of the ledger
     24  biomarkers and imaging
     25  the clinical decision layer

   EDGE SEMANTICS
     solid black arrow ....... mass flux or causal activation
     dashed arrow ............ modulation / signalling (no mass transfer)
     red arrow, "-|" head .... inhibition / blockade
     blue arrow .............. drug or intervention acting on the target
     bold arrow .............. a term that appears explicitly in the ODEs
     grey dotted ............. measurement / read-out
   =========================================================================== */

digraph RVO_QSP {
  rankdir = TB;
  compound = true;
  newrank = true;
  splines = spline;
  concentrate = false;
  nodesep = 0.28;
  ranksep = 0.52;
  fontname = "Helvetica";
  labelloc = "t";
  label = <<b>Retinal Vein Occlusion — Quantitative Systems Pharmacology Map</b><br/>
<font point-size="13">망막정맥폐쇄(CRVO/BRVO) 황반부종 · 기계론적 QSP 지도</font><br/>
<font point-size="11">J<sub>v</sub> = L<sub>p</sub>·S·[(P<sub>c</sub> − P<sub>t</sub>) − σ(π<sub>c</sub> − π<sub>t</sub>)] &nbsp;·&nbsp; anti-VEGF acts on L<sub>p</sub> and σ only &nbsp;·&nbsp; P<sub>c</sub>* = P<sub>t</sub> + σ<sub>max</sub>(π<sub>c</sub> − π<sub>t</sub>) = 31.3 mmHg</font>>;
  fontsize = 20;

  node [shape = box, style = "rounded,filled", fontname = "Helvetica",
        fontsize = 10, penwidth = 1.1, margin = "0.10,0.055"];
  edge [fontname = "Helvetica", fontsize = 8, penwidth = 1.0,
        arrowsize = 0.65, color = "#37474f"];

  /* ---------- colour key ------------------------------------------------ */
  subgraph cluster_key {
    label = "0 · 범례 (Legend)";
    style = "rounded,filled"; fillcolor = "#fafafa"; color = "#9e9e9e";
    fontsize = 12;
    K1 [label = "해부/혈역학\nanatomy · haemodynamics", fillcolor = "#ffe0b2"];
    K2 [label = "허혈/신호전달\nhypoxia · signalling", fillcolor = "#ffcdd2"];
    K3 [label = "장벽/체액\nbarrier · fluid", fillcolor = "#c8e6c9"];
    K4 [label = "약물 PK\ndrug PK", fillcolor = "#bbdefb"];
    K5 [label = "약물 PD/표적\ndrug PD · target", fillcolor = "#d1c4e9"];
    K6 [label = "임상 종점\nclinical endpoint", fillcolor = "#fff9c4"];
    K7 [label = "이상반응\nadverse effect", fillcolor = "#f8bbd0"];
    K8 [label = "바이오마커\nbiomarker", fillcolor = "#e0e0e0"];
    K1 -> K2 -> K3 -> K4 [style = invis];
    K5 -> K6 -> K7 -> K8 [style = invis];
  }

  /* =====================================================================
     1 · ANATOMY OF THE OCCLUSION
     ===================================================================== */
  subgraph cluster_1 {
    label = "1 · 폐쇄 해부학 (Where the vein occludes)";
    style = "rounded,filled"; fillcolor = "#fff8e1"; color = "#ff8f00"; fontsize = 12;
    AVCROSS  [label = "동정맥 교차부\nArterio-venous crossing\n(shared adventitia, artery anterior)", fillcolor = "#ffe0b2"];
    LAMINA   [label = "시신경 사판\nLamina cribrosa\n(central retinal vein, narrow canal)", fillcolor = "#ffe0b2"];
    CRVSITE  [label = "중심망막정맥\nCentral retinal vein (CRV)\ndrains 100% of retina", fillcolor = "#ffe0b2"];
    BRVSITE  [label = "분지망막정맥\nBranch retinal vein\ndrains 1 sector (~25–50%)", fillcolor = "#ffe0b2"];
    HEMISITE [label = "반망막정맥폐쇄\nHemiretinal vein occlusion\n(congenital bifurcation)", fillcolor = "#ffe0b2"];
    SECTOR   [label = "침범 분획 f_sec\nsector fraction of macula\nCRVO 1.00 · BRVO ≈ 0.45", fillcolor = "#ffcc80"];
    AVCROSS -> BRVSITE  [label = "sclerotic artery\ncompresses vein"];
    LAMINA  -> CRVSITE  [label = "canal narrowing\n+ glaucomatous cupping"];
    LAMINA  -> HEMISITE;
    CRVSITE -> SECTOR   [label = "f_sec = 1"];
    BRVSITE -> SECTOR   [label = "f_sec < 1"];
    HEMISITE -> SECTOR;
  }

  /* =====================================================================
     2 · RISK FACTORS
     ===================================================================== */
  subgraph cluster_2 {
    label = "2 · 위험인자 (Systemic and ocular risk)";
    style = "rounded,filled"; fillcolor = "#fff8e1"; color = "#ff8f00"; fontsize = 12;
    HTN     [label = "고혈압\nHypertension (63–73% of CRVO)", fillcolor = "#ffe0b2"];
    DLP     [label = "이상지질혈증\nDyslipidaemia", fillcolor = "#ffe0b2"];
    DM      [label = "당뇨병\nDiabetes mellitus", fillcolor = "#ffe0b2"];
    AGE     [label = "연령 · 동맥경화\nAge, arteriolosclerosis", fillcolor = "#ffe0b2"];
    GLC     [label = "녹내장 · 안압 상승\nGlaucoma, raised IOP\n(raises P_v at lamina)", fillcolor = "#ffe0b2"];
    THROMB  [label = "혈액응고 이상\nFactor V Leiden · prothrombin G20210A\nantiphospholipid · hyperhomocysteinaemia", fillcolor = "#ffe0b2"];
    VISCO   [label = "과점도\nHyperviscosity\npolycythaemia · myeloma · Waldenström", fillcolor = "#ffe0b2"];
    OCP     [label = "경구 피임약 · 임신\nOCP, pregnancy (young patients)", fillcolor = "#ffe0b2"];
    INFL    [label = "혈관염 · 염증\nVasculitis, Behçet, sarcoid", fillcolor = "#ffe0b2"];
    HTN -> AVCROSS   [label = "arteriolar wall\nthickening", style = dashed];
    DLP -> AVCROSS   [style = dashed];
    AGE -> AVCROSS   [style = dashed];
    DM  -> AVCROSS   [style = dashed];
    GLC -> LAMINA    [label = "cup enlargement", style = dashed];
    INFL -> AVCROSS  [style = dashed];
  }

  /* =====================================================================
     3 · THROMBUS BIOLOGY
     ===================================================================== */
  subgraph cluster_3 {
    label = "3 · 혈전 형성과 자연 용해 (Virchow triad and the lysis clock)";
    style = "rounded,filled"; fillcolor = "#ffebee"; color = "#c62828"; fontsize = 12;
    ENDO    [label = "내피 손상\nEndothelial injury\n(mechanical + oxidative)", fillcolor = "#ffcdd2"];
    STASIS  [label = "혈류 정체\nStasis, turbulent flow", fillcolor = "#ffcdd2"];
    HYPERC  [label = "과응고 상태\nHypercoagulability", fillcolor = "#ffcdd2"];
    THR     [label = "정맥 내 혈전\nIntraluminal thrombus\n(fibrin + platelet + RBC)", fillcolor = "#ef9a9a"];
    OCCST   [label = "★ OCC\nocclusion severity multiplier\nR_v = R_v0·(1+OCC)/(1+COLL)", fillcolor = "#e57373", penwidth = 2.2];
    FIBRINO [label = "내인성 섬유소 용해\nEndogenous fibrinolysis\nplasmin, tPA, uPA", fillcolor = "#ffcdd2"];
    KLYS    [label = "용해 속도상수 k_lys\nCRVO ~0.002–0.0035 /d (t½ 200–350 d)\nBRVO ~0.0075 /d (t½ ~90 d)", fillcolor = "#ffcdd2"];
    ENDO   -> THR;
    STASIS -> THR;
    HYPERC -> THR;
    THROMB -> HYPERC [style = dashed];
    VISCO  -> STASIS [style = dashed];
    OCP    -> HYPERC [style = dashed];
    AVCROSS -> ENDO;
    LAMINA  -> ENDO;
    THR -> OCCST [penwidth = 2.0];
    FIBRINO -> KLYS;
    KLYS -> OCCST [label = "dOCC/dt = −k_lys·OCC", color = "#c62828", arrowhead = tee];
  }

  /* =====================================================================
     4 · RESISTANCE NETWORK AND CAPILLARY PRESSURE  (PRESSURE ARM)
     ===================================================================== */
  subgraph cluster_4 {
    label = "4 · 저항망과 모세혈관 압력 — 압력항 (Resistance network → P_c : the PRESSURE ARM)";
    style = "rounded,filled"; fillcolor = "#fff3e0"; color = "#e65100"; fontsize = 13;
    MAP     [label = "전신 평균동맥압\nSystemic MAP", fillcolor = "#ffe0b2"];
    OPP     [label = "안관류압\nOcular perfusion pressure\nOPP = MAP − IOP", fillcolor = "#ffe0b2"];
    PAIN    [label = "★ P_a\npost-arteriolar inlet pressure\n≈ 40 mmHg (model)", fillcolor = "#ffcc80", penwidth = 2.0];
    RART    [label = "★ R_a\narteriolar resistance\nR_a = R_a0·(1 − 0.35·HIF)", fillcolor = "#ffcc80", penwidth = 2.0];
    RVEN    [label = "★ R_v\nvenular + venous resistance\nR_v0 = 0.25 (healthy)", fillcolor = "#ffcc80", penwidth = 2.0];
    PVEN    [label = "★ P_v\nvenous outflow pressure\nP_v ≈ IOP + 2 mmHg", fillcolor = "#ffcc80", penwidth = 2.0];
    PCAP    [label = "★★ P_c — 모세혈관 정수압\nP_c = (P_a·R_v + P_v·R_a)/(R_a + R_v)\nnormal ≈ 21.6 · CRVO 34–38 mmHg",
             fillcolor = "#ff8a65", penwidth = 2.8, shape = box3d];
    QFLOW   [label = "★ Q — 망막 혈류\nQ = (P_a − P_v)/(R_a + R_v)\nQ_rel = Q/Q₀", fillcolor = "#ffcc80", penwidth = 2.0];
    TRANSM  [label = "압력 전달계수\ndP_c/dP_a = R_v/(R_a+R_v)\nnormal 0.20 → occluded → 1.0", fillcolor = "#ffab91"];
    MAP -> OPP;   GLC -> PVEN [style = dashed, label = "IOP"];
    OPP -> PAIN;
    MAP -> PAIN [penwidth = 1.8];
    OCCST -> RVEN [penwidth = 2.4, label = "occlusion\nmultiplier"];
    PAIN -> PCAP [penwidth = 2.2];
    RVEN -> PCAP [penwidth = 2.4];
    RART -> PCAP [penwidth = 2.2];
    PVEN -> PCAP [penwidth = 1.8];
    PAIN -> QFLOW; RVEN -> QFLOW [penwidth = 2.0]; RART -> QFLOW; PVEN -> QFLOW;
    RVEN -> TRANSM [style = dashed];
    RART -> TRANSM [style = dashed];
    TRANSM -> PCAP [style = dashed, label = "sensitivity of P_c\nto systemic BP"];
  }

  /* =====================================================================
     5 · AUTOREGULATION FEEDBACK
     ===================================================================== */
  subgraph cluster_5 {
    label = "5 · 자동조절 되먹임 (Hypoxic vasodilatation: a feedback that WORSENS the pressure arm)";
    style = "rounded,filled"; fillcolor = "#ffebee"; color = "#c62828"; fontsize = 12;
    MYOG    [label = "근육긴장성 자동조절\nMyogenic autoregulation\n(Bayliss)", fillcolor = "#ffcdd2"];
    NOEND   [label = "NO · 프로스타사이클린\nNO, PGI₂ from endothelium", fillcolor = "#ffcdd2"];
    ADENO   [label = "아데노신 · 젖산 · H⁺\nAdenosine, lactate, H⁺", fillcolor = "#ffcdd2"];
    VASODIL [label = "세동맥 확장\nArteriolar dilatation\nR_a ↓ up to 35%", fillcolor = "#ef9a9a"];
    ET1     [label = "엔도텔린-1\nEndothelin-1 (ET-1) ↑\nlate vasoconstriction", fillcolor = "#ffcdd2"];
    QFLOW -> ADENO [label = "↓ flow → ↑ metabolites", style = dashed];
    ADENO -> VASODIL; NOEND -> VASODIL; MYOG -> VASODIL [style = dashed];
    VASODIL -> RART [color = "#c62828", arrowhead = tee, penwidth = 2.0,
                     label = "R_a ↓"];
    RART -> PCAP [style = invis];
    ET1 -> RART [style = dashed, label = "chronic\nvasoconstriction"];
    VASODIL -> PCAP [style = dashed, color = "#c62828",
                     label = "vicious circle:\nless R_a → more P_c"];
  }

  /* =====================================================================
     6 · COLLATERAL / RECANALISATION CLOCK
     ===================================================================== */
  subgraph cluster_6 {
    label = "6 · 우회로 · 재개통 시계 (The collateral clock — the only endogenous cure)";
    style = "rounded,filled"; fillcolor = "#e8f5e9"; color = "#2e7d32"; fontsize = 12;
    COLLAT  [label = "★ COLL — 우회 전도도\ncollateral conductance\ndCOLL/dt = k_coll(1+2·HIF)(COLL_max − COLL)", fillcolor = "#a5d6a7", penwidth = 2.0];
    COLLMAX [label = "우회로 상한 COLL_max\nBRVO ≈ 5.0 (rich sectoral routes)\nCRVO ≈ 0.9–1.2 (few options)", fillcolor = "#c8e6c9"];
    OPTOCIL [label = "시신경섬모 단락\nOptociliary shunt vessels\n(CRVO, uncommon)", fillcolor = "#c8e6c9"];
    RECAN   [label = "혈전 재개통\nRecanalisation of the lumen", fillcolor = "#c8e6c9"];
    COLLMAX -> COLLAT [penwidth = 1.8];
    OPTOCIL -> COLLAT [style = dashed];
    RECAN -> COLLAT [style = dashed];
    KLYS -> RECAN;
    COLLAT -> RVEN [color = "#2e7d32", arrowhead = tee, penwidth = 2.4,
                    label = "R_v ↓ : the ONLY endogenous\nroute into the pressure arm"];
    SECTOR -> COLLMAX [style = dashed, label = "BRVO has\nneighbours to drain into"];
  }

  /* =====================================================================
     7 · STASIS, LEUKOSTASIS, NON-PERFUSION
     ===================================================================== */
  subgraph cluster_7 {
    label = "7 · 정체 · 백혈구정체 · 비관류 (Stasis → leukostasis → capillary closure)";
    style = "rounded,filled"; fillcolor = "#ffebee"; color = "#c62828"; fontsize = 12;
    ICAM    [label = "ICAM-1 · VCAM-1 · P-selectin\nendothelial adhesion molecules ↑", fillcolor = "#ffcdd2"];
    LEUKO   [label = "★ LEUK — 백혈구 정체\nleukostasis, CD18-mediated plugging", fillcolor = "#ef9a9a", penwidth = 2.0];
    CAPDROP [label = "모세혈관 탈락\nCapillary dropout, acellular capillaries", fillcolor = "#ffcdd2"];
    NPAREA  [label = "★ NP — 비관류 면적\nnon-perfusion, disc areas (DA)\nischaemic CRVO > 10 DA (30 DA on 7-field FA)", fillcolor = "#e57373", penwidth = 2.2];
    MISCH   [label = "★ MI — 황반 허혈 지수\nmacular / foveal ischaemia\nFAZ enlargement, DCP loss", fillcolor = "#e57373", penwidth = 2.0];
    QFLOW -> LEUKO [style = dashed, label = "Q_rel ↓"];
    ICAM -> LEUKO [penwidth = 1.6];
    LEUKO -> CAPDROP [penwidth = 1.6];
    QFLOW -> NPAREA [penwidth = 2.0, label = "dNP/dt = k_NP·(0.45 − Q_rel)^1.2·(1+0.8·LEUK)"];
    CAPDROP -> NPAREA [penwidth = 1.8];
    QFLOW -> MISCH [penwidth = 1.8];
    NPAREA -> MISCH [style = dashed];
    COLLAT -> NPAREA [color = "#2e7d32", arrowhead = tee, label = "reperfusion"];
  }

  /* =====================================================================
     8 · HYPOXIA SENSING
     ===================================================================== */
  subgraph cluster_8 {
    label = "8 · 저산소 감지 (Hypoxia sensing — HIF-1α)";
    style = "rounded,filled"; fillcolor = "#ffebee"; color = "#c62828"; fontsize = 12;
    O2DEL   [label = "산소 전달\nO₂ delivery ∝ Q_rel", fillcolor = "#ffcdd2"];
    PHD     [label = "PHD1-3 · FIH\nprolyl hydroxylases (O₂ sensors)", fillcolor = "#ffcdd2"];
    VHL     [label = "pVHL · 유비퀴틴화\nubiquitin-proteasome degradation", fillcolor = "#ffcdd2"];
    HIF1A   [label = "★ HIF — HIF-1α 안정화\nHIF-1α/HIF-2α + ARNT → HRE\ntau ≈ 2 d", fillcolor = "#e57373", penwidth = 2.4];
    ROS     [label = "산화 스트레스\nROS, NOX, peroxynitrite", fillcolor = "#ffcdd2"];
    QFLOW -> O2DEL [penwidth = 1.8];
    O2DEL -> PHD [penwidth = 1.6];
    PHD -> VHL;
    VHL -> HIF1A [color = "#c62828", arrowhead = tee, label = "degrades HIF\nwhen O₂ present"];
    O2DEL -> HIF1A [color = "#c62828", arrowhead = tee, penwidth = 2.0,
                    label = "hypox = 1 − Q_rel^0.8"];
    NPAREA -> HIF1A [style = dashed, label = "area of\nhypoxic retina"];
    HIF1A -> ROS [style = dashed]; ROS -> ENDO [style = dashed];
    HIF1A -> ADENO [style = invis];
    HIF1A -> VASODIL [style = dashed, label = "hypoxic\nvasodilatation"];
  }

  /* =====================================================================
     9 · VEGF-A AXIS
     ===================================================================== */
  subgraph cluster_9 {
    label = "9 · VEGF-A 축 (The VEGF-A axis)";
    style = "rounded,filled"; fillcolor = "#f3e5f5"; color = "#6a1b9a"; fontsize = 13;
    VEGFGENE [label = "VEGFA 유전자 전사\nHRE-driven transcription\nMüller cells, RPE, endothelium, RGC", fillcolor = "#e1bee7"];
    VEGFISO  [label = "동형체\nVEGF₁₂₁ · VEGF₁₆₅ · VEGF₁₈₉ · VEGF₂₀₆\n(165 dominant, heparin-binding)", fillcolor = "#e1bee7"];
    VTONE    [label = "★ VTONE — VEGF-A 톤\nfree VEGF that WOULD be present\nnormal ≈ 3 pM (135 pg/mL)\nischaemic CRVO ≈ 39 pM (1750 pg/mL)",
              fillcolor = "#ce93d8", penwidth = 2.4];
    VACT     [label = "★★ VACT — 전달된 VEGF 신호\nVACT = VTONE / (1 + C_ret/(α·K_D))\nthe only VEGF node a drug can move",
              fillcolor = "#ba68c8", penwidth = 2.8, shape = box3d];
    VEGFR2   [label = "VEGFR2 (KDR)\nY951 · Y1175 autophosphorylation", fillcolor = "#e1bee7"];
    VEGFR1   [label = "VEGFR1 (Flt-1)\ndecoy + PlGF receptor", fillcolor = "#e1bee7"];
    NRP1     [label = "Neuropilin-1\nco-receptor, boosts VEGFR2", fillcolor = "#e1bee7"];
    SRCPATH  [label = "Src → Vav2 → Rac1 → PAK\n+ eNOS, PLCγ→PKC, uPAR", fillcolor = "#e1bee7"];
    PLGF     [label = "★ PTONE / PACT — PlGF\nVEGFR1 ligand, ~2 → 12 pM", fillcolor = "#ce93d8", penwidth = 1.8];
    HIF1A -> VEGFGENE [penwidth = 2.4, label = "RV = RV₀(1 + 12·HIF)"];
    VEGFGENE -> VEGFISO -> VTONE [penwidth = 2.0];
    VTONE -> VACT [penwidth = 2.6];
    VACT -> VEGFR2 [penwidth = 2.4];
    VACT -> VEGFR1; VACT -> NRP1 [style = dashed];
    NRP1 -> VEGFR2 [style = dashed];
    VEGFR2 -> SRCPATH [penwidth = 2.0];
    HIF1A -> PLGF [penwidth = 1.6]; PLGF -> VEGFR1 [penwidth = 1.6];
  }

  /* =====================================================================
     10 · NON-VEGF PERMEABILITY MEDIATORS
     ===================================================================== */
  subgraph cluster_10 {
    label = "10 · 비VEGF 매개체 (The mediators anti-VEGF does not touch)";
    style = "rounded,filled"; fillcolor = "#f3e5f5"; color = "#6a1b9a"; fontsize = 12;
    IL6N    [label = "★ IL6 — 인터루킨-6\n5 → 85 pg/mL (aqueous)\nSTAT3, trans-signalling via sIL-6R", fillcolor = "#ce93d8", penwidth = 2.0];
    IL8     [label = "IL-8 · MCP-1 · IP-10\nchemokines ↑", fillcolor = "#e1bee7"];
    ANG2    [label = "★ ATONE / AACT — Ang-2\n5 → 40 pM; Tie2 antagonist", fillcolor = "#ce93d8", penwidth = 2.0];
    TIE2    [label = "Tie2 수용체\nAng-1/Tie2 = junction stabilising\nAng-2 = destabilising", fillcolor = "#e1bee7"];
    VEPTP   [label = "VE-PTP\ndephosphorylates Tie2", fillcolor = "#e1bee7"];
    PROSTA  [label = "프로스타글란딘\nPGE₂, COX-2", fillcolor = "#e1bee7"];
    MMP9    [label = "MMP-2 · MMP-9\ndegrade occludin, claudin-5", fillcolor = "#e1bee7"];
    TNF     [label = "TNF-α · IL-1β\nNF-κB axis", fillcolor = "#e1bee7"];
    HIF1A -> IL6N [penwidth = 2.0, label = "IL6 = f(1 + 16·HIF)"];
    HIF1A -> ANG2 [penwidth = 2.0];
    HIF1A -> IL8 [style = dashed];
    LEUKO -> TNF [style = dashed]; TNF -> ICAM [style = dashed];
    ANG2 -> TIE2 [color = "#c62828", arrowhead = tee, penwidth = 2.0,
                  label = "competitive\nantagonism"];
    VEPTP -> TIE2 [color = "#c62828", arrowhead = tee];
    IL6N -> ICAM [style = dashed]; IL6N -> VEGFGENE [style = dashed, label = "cross-induction"];
    PROSTA -> IL6N [style = dashed]; MMP9 -> IL6N [style = invis];
  }

  /* =====================================================================
