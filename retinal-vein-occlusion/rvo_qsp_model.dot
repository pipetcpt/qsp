    ALPHAN  [label = "★ α — 겉보기 계수 (calibrated = 120)\nIC50_app = α · K_D\nwhy: VEGFR2 competition, local flux,\ndiffusional limitation", fillcolor = "#d1c4e9", penwidth = 2.2];
    SUPPR   [label = "★★ 억제비 (suppression ratio)\nR = 1 + C_ret/(α·K_D)\nVACT = VTONE / R", fillcolor = "#b39ddb", penwidth = 2.6];
    TSUPN   [label = "★★★ 억제 지속시간\nt_sup = (t½/ln2)·ln[C₀,eff /((R−1)·α·K_D)]\nRBZ 24 d · BEV 26 d · BRO 43 d\nFAR 44 d · AFL 96 d · AFL 8 mg 114 d",
             fillcolor = "#9575cd", penwidth = 3.0, shape = doubleoctagon];
