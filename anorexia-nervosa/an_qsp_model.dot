digraph AN_QSP {
  rankdir=LR;
  fontname="Helvetica";
  labelloc="t";
  fontsize=20;
  label="Anorexia Nervosa (AN) — Mechanistic QSP Map\nStarvation Energy Balance × Neuroendocrine Adaptation × Reward/Habit Circuitry × Refeeding Safety × Pharmacotherapy";
  node [style=filled, fontname="Helvetica", fontsize=10, shape=box, fillcolor="#ffffff"];
  edge [fontname="Helvetica", fontsize=8, color="#5a5a5a"];
  compound=true;

  //==========================================================================
  subgraph cluster_risk {
    label="1. Predisposition & Risk Architecture"; style=filled; color="#e8ddf0"; fillcolor="#f5eefb"; fontsize=13;
    Genetic_liability      [label="Polygenic liability\n(h² ≈ 0.5-0.6)"];
    GWAS_metabopsych       [label="GWAS metabo-psychiatric loci\n(CADM1, MGMT, FOXP1, PTBP2,\nNCAM1, CADM1; BMI/insulin/HDL\ngenetic correlations)"];
    Female_sex             [label="Female sex\n(~8-10:1 ratio)"];
    Puberty_estrogen_surge [label="Pubertal estrogen surge\n(gene-expression unmasking)"];
    Trait_perfectionism    [label="Trait perfectionism /\ncognitive rigidity"];
    Trait_anxiety_OCPD     [label="Premorbid anxiety /\nobsessive-compulsive traits"];
    Harm_avoidance         [label="High harm avoidance,\nlow novelty seeking"];
    Sociocultural_thin     [label="Sociocultural thin-ideal /\nweight-teasing exposure"];
    Dieting_onset          [label="Dieting / caloric\nrestriction onset (trigger)"];
    Gut_microbiome_shift   [label="Gut microbiome dysbiosis\n(↓diversity, ↑Methanobrevibacter)"];
    Autoimmune_history     [label="Autoimmune / infection\nhistory (PANDAS-like, rare)"];
    Life_stressor          [label="Psychosocial stressor /\ntransition, trauma"];
  }

  //==========================================================================
  subgraph cluster_circuit {
    label="2. Cognitive-Affective Neurocircuitry"; style=filled; color="#dbe8f5"; fillcolor="#ecf4fc"; fontsize=13;
    Ventral_striatum       [label="Ventral striatum\n(reward valuation)"];
    Dorsal_striatum_habit  [label="Dorsal striatum\n(habit / stimulus-response)"];
    Habit_restriction      [label="Restriction as\nentrenched habit"];
    Reward_prediction_err  [label="Altered reward\nprediction error signal"];
    Food_anticipation_anx  [label="Food-cue anticipatory\nanxiety (not anhedonia)"];
    Insula_interoception   [label="Insula\ninteroceptive deficit"];
    Body_image_distortion  [label="Parietal/EBA body-image\ndistortion"];
    Amygdala_fear          [label="Amygdala\nfear of weight gain"];
    dlPFC_control          [label="dlPFC excessive\ncognitive control"];
    OFC_valuation          [label="OFC food-value\ndevaluation"];
    Set_shifting_deficit   [label="Set-shifting deficit /\nweak central coherence"];
    ED_cognition_drive     [label="ED cognition drive\n(EDE-Q global proxy)", fillcolor="#ffe0e0"];
    Starvation_perpetuation[label="Starvation-induced\ncognitive perpetuation\n(Minnesota effect)", fillcolor="#ffe0e0"];
  }

  subgraph cluster_nt {
    label="3. Neurotransmitter & Neurotrophic Systems"; style=filled; color="#d9f0ea"; fillcolor="#ecfaf6"; fontsize=13;
    Serotonin_5HT1A        [label="5-HT1A receptor ↑\n(anxiety tone)"];
    Serotonin_5HT2A        [label="5-HT2A receptor ↓\n(recovered-state persistence)"];
    Trp_availability       [label="Dietary tryptophan\navailability ↓ (starvation)"];
    Brain_5HT_synthesis    [label="Brain 5-HT synthesis\n(dampened by restriction)"];
    Dopamine_D2D3          [label="Striatal D2/D3\nreceptor binding ↑"];
    Norepinephrine_tone    [label="Central noradrenergic\ntone"];
    GABA_glutamate         [label="GABA/glutamate\nE-I balance"];
    Endogenous_opioid      [label="Endogenous opioid /\nexercise-induced reward"];
    BDNF_level             [label="Serum BDNF ↓\n(nutritional marker)"];
  }

  //==========================================================================
  subgraph cluster_hypo {
    label="4. Hypothalamic Energy-Balance Circuitry"; style=filled; color="#f5e3d3"; fillcolor="#fdf2e6"; fontsize=13;
    ARC_NPY_AgRP           [label="ARC NPY/AgRP neurons ↑\n(orexigenic drive)"];
    ARC_POMC_CART          [label="ARC POMC/CART neurons ↓\n(anorexigenic)"];
    Alpha_MSH              [label="α-MSH release"];
    MC4R_signaling         [label="PVN MC4R\nsignaling"];
    PVN_integration        [label="PVN integrative\nnode"];
    LHA_orexin             [label="LHA orexin / MCH\n(arousal, hyperactivity)"];
    NTS_brainstem          [label="NTS brainstem\nsatiety relay"];
    Hypothalamic_AMPK      [label="Hypothalamic AMPK ↑\n(energy sensor)"];
    mTOR_signaling         [label="Hypothalamic mTOR ↓"];
    Leptin_receptor_ObRb   [label="LepRb (ObRb)\nJAK2-STAT3 signaling ↓"];
    GHSR_receptor          [label="GHSR-1a ghrelin\nreceptor (resistance)"];
    Kisspeptin_neurons     [label="ARC/AVPV kisspeptin\nneurons ↓"];
    Hyperactivity_drive    [label="Semi-starvation induced\nhyperactivity (SIH)"];
  }

  subgraph cluster_gut {
    label="5. Gut-Brain Peptides & GI Physiology"; style=filled; color="#e6e6fa"; fillcolor="#f2f2fd"; fontsize=13;
    Ghrelin_plasma         [label="Plasma acyl-ghrelin ↑\n(with central resistance)"];
    PYY_336                [label="PYY 3-36 ↑\n(paradoxical satiety)"];
    GLP1_secretion         [label="GLP-1 secretion"];
    CCK_release            [label="CCK release\n(post-prandial)"];
    Insulin_plasma         [label="Plasma insulin ↓\n(fasting)"];
    Gastroparesis          [label="Delayed gastric\nemptying"];
    Early_satiety          [label="Early satiety /\npostprandial fullness"];
    Bloating_pain          [label="Bloating, abdominal\ndiscomfort"];
    Constipation           [label="Slow-transit\nconstipation"];
    SMA_syndrome           [label="SMA syndrome\n(duodenal compression)"];
    Microbiome_SCFA        [label="Microbiome SCFA /\nClpB antigen mimicry"];
  }

  //==========================================================================
  subgraph cluster_energy {
    label="6. Energy Balance & Body Composition"; style=filled; color="#fde2e4"; fillcolor="#fef0f1"; fontsize=13;
    Energy_intake          [label="Energy intake\n(kcal/day)", fillcolor="#ffd6d6"];
    Meal_plan_prescribed   [label="Prescribed meal plan /\nnutritional rehabilitation"];
    Restriction_behavior   [label="Restrictive behavior\n(intake suppression)"];
    Purging_behavior       [label="Purging (vomiting,\nlaxative, diuretic)"];
    Compulsive_exercise    [label="Compulsive exercise\n(activity energy expenditure ↑)"];
    Resting_EE             [label="Resting energy\nexpenditure (REE)"];
    Adaptive_thermogenesis [label="Adaptive thermogenesis\n(REE suppression beyond FFM)"];
    TEF_dit                [label="Thermic effect\nof food"];
    Total_EE               [label="Total energy\nexpenditure (TEE)"];
    Energy_balance         [label="Net energy balance\n(EI − TEE)", fillcolor="#ffd6d6"];
    Fat_mass               [label="Fat mass (FM, kg)"];
    Fat_free_mass          [label="Fat-free mass (FFM, kg)"];
    Body_weight_BMI        [label="Body weight → BMI\n(kg/m²)", fillcolor="#ffd6d6"];
    Percent_mBMI           [label="% median BMI /\n% expected body weight"];
  }

  subgraph cluster_adipose {
    label="7. Adipose Endocrine Axis"; style=filled; color="#fff3cd"; fillcolor="#fffbe9"; fontsize=13;
    Adipocyte_mass         [label="Adipocyte mass /\nlipid droplet depletion"];
    Leptin_plasma          [label="Plasma leptin ↓↓\n(hypoleptinemia)", fillcolor="#ffe9a8"];
    Adiponectin_level      [label="Adiponectin ↑\n(paradoxical)"];
    Free_fatty_acids       [label="Free fatty acids ↑\n(lipolysis)"];
    Ketone_bodies          [label="Ketone bodies\n(β-hydroxybutyrate)"];
    Brown_adipose_activity [label="Brown adipose\nthermogenic activity ↓"];
    Hypothermia            [label="Hypothermia,\ncold intolerance"];
    Lanugo_hair            [label="Lanugo hair /\ninsulation response"];
  }

  //==========================================================================
  subgraph cluster_hpa {
    label="8. HPA Axis — Starvation Hypercortisolemia"; style=filled; color="#f8d7da"; fillcolor="#fdeff0"; fontsize=13;
    CRH_hypothalamic       [label="Hypothalamic CRH ↑"];
    ACTH_pituitary         [label="Pituitary ACTH"];
    Cortisol_plasma        [label="Plasma cortisol ↑\n(hypercortisolemia)", fillcolor="#f5b7bb"];
    Cortisol_free_urinary  [label="24-h urinary free\ncortisol ↑"];
    GR_feedback_resistance [label="Glucocorticoid receptor\nfeedback resistance"];
    Cortisol_catabolic     [label="Catabolic drive on\nmuscle & bone"];
    Stress_reactivity      [label="Psychological stress\nreactivity"];
  }

  subgraph cluster_hpg {
    label="9. HPG Axis & Functional Hypothalamic Amenorrhea"; style=filled; color="#ffe0f0"; fillcolor="#fff0f8"; fontsize=13;
    GnRH_pulsatility       [label="GnRH pulse generator ↓\n(prepubertal pattern)"];
    LH_pulses              [label="LH pulse frequency\n& amplitude ↓"];
    FSH_level              [label="FSH ↓"];
    Ovarian_follicle       [label="Ovarian follicular\ndevelopment arrest"];
    Estradiol_plasma       [label="Estradiol ↓↓", fillcolor="#ffc9e2"];
    Progesterone_luteal    [label="Luteal progesterone\nabsent (anovulation)"];
    Amenorrhea             [label="Functional hypothalamic\namenorrhea", fillcolor="#ffc9e2"];
    Testosterone_male      [label="Testosterone ↓\n(males, ~25% of cases)"];
    Vaginal_atrophy_libido [label="Genitourinary atrophy,\nlow libido"];
    Fertility_impairment   [label="Subfertility /\npregnancy complications"];
  }

  subgraph cluster_gh {
    label="10. GH / IGF-1 Resistance Axis"; style=filled; color="#d1ecf1"; fillcolor="#eaf7fa"; fontsize=13;
    GH_secretion           [label="GH secretion ↑\n(pulse amplitude)"];
    Hepatic_GHR            [label="Hepatic GH receptor /\nJAK2-STAT5 ↓ (resistance)"];
    IGF1_plasma            [label="Plasma IGF-1 ↓↓", fillcolor="#b6e2ea"];
    IGFBP1_level           [label="IGFBP-1 ↑ (insulinopenia)"];
    IGFBP3_level           [label="IGFBP-3 ↓"];
    Linear_growth_arrest   [label="Linear growth arrest\n(adolescents)"];
    Fibroblast_FGF21       [label="FGF21 ↑\n(starvation hormone)"];
  }

  subgraph cluster_thyroid {
    label="11. Thyroid — Low-T3 (Euthyroid Sick) Syndrome"; style=filled; color="#e2f0d9"; fillcolor="#f1f9ec"; fontsize=13;
    TRH_TSH                [label="TRH/TSH normal or\nlow-normal"];
    T4_total               [label="Total T4 low-normal"];
    Deiodinase_D1_D3       [label="Deiodinase shift\n(D1 ↓ / D3 ↑)"];
    T3_free                [label="Free T3 ↓↓\n(low-T3 syndrome)", fillcolor="#cbe7bb"];
    Reverse_T3             [label="Reverse T3 ↑"];
    Metabolic_rate_down    [label="Metabolic rate\nsuppression"];
  }

  //==========================================================================
  subgraph cluster_bone {
    label="12. Bone Remodeling & Skeletal Outcomes"; style=filled; color="#e7e0d5"; fillcolor="#f5f1ea"; fontsize=13;
    Osteoblast_activity    [label="Osteoblast activity ↓\n(IGF-1 & E2 dependent)"];
    Osteoclast_activity    [label="Osteoclast activity ↑"];
    RANKL_OPG_ratio        [label="RANKL/OPG ratio ↑"];
    Sclerostin_level       [label="Sclerostin ↑\n(Wnt inhibition)"];
    Preadipocyte_switch    [label="Marrow MSC switch to\nadipocyte lineage"];
    Marrow_adiposity       [label="Marrow adiposity ↑\n(paradoxical)"];
    P1NP_marker            [label="P1NP (formation) ↓"];
    CTX_marker             [label="CTX (resorption) ↑"];
    Bone_mineral_density   [label="BMD Z-score\n(spine, hip)", fillcolor="#d9cfbd"];
    Cortical_microarch     [label="Cortical thickness /\ntrabecular microarchitecture ↓"];
    Peak_bone_mass_loss    [label="Failure to accrue\npeak bone mass"];
    Fracture_risk          [label="Fragility / stress\nfracture risk ↑", fillcolor="#d9cfbd"];
  }

  subgraph cluster_cv {
    label="13. Cardiovascular & Autonomic Adaptation"; style=filled; color="#ffe5d0"; fillcolor="#fff3e8"; fontsize=13;
    Vagal_tone_up          [label="Parasympathetic (vagal)\npredominance"];
    Sympathetic_withdrawal [label="Sympathetic\nwithdrawal"];
    Sinus_bradycardia      [label="Sinus bradycardia\n(HR < 50 bpm)", fillcolor="#ffd0ad"];
    Hypotension_orthostat  [label="Hypotension /\northostatic intolerance"];
    LV_mass_loss           [label="LV mass loss,\n↓ stroke volume"];
    Mitral_valve_prolapse  [label="Mitral valve prolapse\n(relative)"];
    Pericardial_effusion   [label="Pericardial effusion"];
    QTc_interval           [label="QTc interval\n(dispersion ↑)", fillcolor="#ffd0ad"];
    Arrhythmia_risk        [label="Ventricular arrhythmia /\nsudden death risk"];
    Refeeding_cardiac_fail [label="Refeeding cardiac\nfailure (volume overload)"];
  }

  subgraph cluster_heme {
    label="14. Hematologic · Hepatic · Immune · Renal"; style=filled; color="#dfe7ef"; fillcolor="#eff4f8"; fontsize=13;
    Gelatinous_marrow      [label="Gelatinous marrow\ntransformation"];
    Leukopenia_neutropenia [label="Leukopenia /\nneutropenia"];
    Anemia_thrombocytopenia[label="Anemia,\nthrombocytopenia"];
    Starvation_hepatitis   [label="Starvation hepatitis\n(autophagy, ALT ↑)"];
    Refeeding_hepatitis    [label="Refeeding hepatic\nsteatosis (ALT ↑)"];
    Hypoglycemia           [label="Hypoglycemia\n(glycogen depletion)"];
    Immune_dysfunction     [label="Cell-mediated immune\ndysfunction"];
    Renal_concentrating    [label="Renal concentrating\ndefect, ↑ BUN/Cr"];
    Pseudo_Bartter         [label="Pseudo-Bartter syndrome\n(purging, RAAS ↑)"];
  }

  //==========================================================================
  subgraph cluster_refeed {
    label="15. Electrolytes, Refeeding Syndrome & Micronutrients"; style=filled; color="#f1d4d4"; fillcolor="#fbeaea"; fontsize=13;
    Total_body_phos_depl   [label="Total-body phosphate\ndepletion (occult)"];
    Carb_refeeding_load    [label="Carbohydrate refeeding\nload (kcal/day rate)"];
    Insulin_surge          [label="Refeeding insulin\nsurge"];
    Intracellular_shift    [label="Intracellular shift of\nPO₄, K⁺, Mg²⁺"];
    Serum_phosphate        [label="Serum phosphate\n(refeeding nadir)", fillcolor="#eab8b8"];
    Serum_potassium        [label="Serum potassium", fillcolor="#eab8b8"];
    Serum_magnesium        [label="Serum magnesium"];
    ATP_23DPG_depletion    [label="ATP / 2,3-DPG\ndepletion"];
    Thiamine_stores        [label="Thiamine (B1) stores ↓"];
    Wernicke_risk          [label="Wernicke encephalopathy\nrisk"];
    Fluid_retention_edema  [label="Sodium/fluid retention,\nrefeeding edema"];
    Refeeding_syndrome     [label="Refeeding syndrome\n(composite risk)", fillcolor="#eab8b8"];
    Phosphate_supplement   [label="Prophylactic phosphate /\nelectrolyte repletion"];
    Thiamine_supplement    [label="Thiamine repletion\n(before glucose)"];
  }

  subgraph cluster_purge {
    label="16. Purging-Subtype Complications"; style=filled; color="#e0f0e0"; fillcolor="#f0f8f0"; fontsize=13;
    Self_induced_vomiting  [label="Self-induced vomiting"];
    Laxative_abuse         [label="Laxative / diuretic\nabuse"];
    Metabolic_alkalosis    [label="Hypochloremic\nmetabolic alkalosis"];
    Hypokalemia_purge      [label="Hypokalemia"];
    Dental_erosion         [label="Dental erosion,\nparotid hypertrophy"];
    Esophageal_injury      [label="Esophagitis /\nMallory-Weiss tear"];
    Russell_sign           [label="Russell's sign\n(knuckle callus)"];
  }

  //==========================================================================
  subgraph cluster_olz {
    label="17. Drug PK/PD — Olanzapine (weight & cognition)"; style=filled; color="#d6e4ff"; fillcolor="#ecf2ff"; fontsize=13;
    OLZ_dose               [label="Olanzapine PO\n2.5-10 mg qHS", shape=ellipse, fillcolor="#bcd3ff"];
    OLZ_absorption         [label="GI absorption\n(ka, F ≈ 0.6)"];
    OLZ_plasma             [label="Olanzapine plasma\nconcentration"];
    OLZ_CYP1A2             [label="CYP1A2 / UGT1A4\nmetabolism (smoking ↑CL)"];
    OLZ_H1_5HT2C           [label="H1 / 5-HT2C antagonism\n→ appetite ↑"];
    OLZ_D2_occupancy       [label="Striatal D2 occupancy\n→ obsessive rumination ↓"];
    OLZ_metabolic_ae       [label="Metabolic AE\n(lipids, glucose, sedation)"];
  }

  subgraph cluster_flx {
    label="18. Drug PK/PD — Fluoxetine (relapse prevention)"; style=filled; color="#d9e8d9"; fillcolor="#eef6ee"; fontsize=13;
    FLX_dose               [label="Fluoxetine PO\n20-60 mg qd", shape=ellipse, fillcolor="#bcd9bc"];
    FLX_plasma             [label="Fluoxetine plasma\n(t½ 1-4 d)"];
    Norfluoxetine          [label="Norfluoxetine\n(active, t½ 7-15 d)"];
    SERT_occupancy         [label="SERT occupancy\n→ synaptic 5-HT ↑"];
    FLX_nutrition_gate     [label="Efficacy GATED by\nnutritional restoration\n(Trp/BMI dependent)", fillcolor="#ffd6d6"];
    FLX_relapse_prevention [label="Anxiety / obsessionality ↓\n→ relapse prevention"];
  }

  subgraph cluster_bonedrug {
    label="19. Drug PK/PD — Bone-Targeted Therapy"; style=filled; color="#efe0f0"; fillcolor="#f9eefa"; fontsize=13;
    E2_patch_dose          [label="Transdermal 17β-estradiol\n100 µg + cyclic P4", shape=ellipse, fillcolor="#e2c2e5"];
    E2_transdermal_PK      [label="Transdermal E2 PK\n(no hepatic first pass →\nIGF-1 preserved)"];
    Oral_OCP_caution       [label="Oral contraceptive\n(first-pass IGF-1 ↓,\nnot bone-protective)"];
    TPTD_dose              [label="Teriparatide SC\n20 µg qd (adults)", shape=ellipse, fillcolor="#e2c2e5"];
    TPTD_anabolic          [label="Intermittent PTH(1-34)\nanabolic window"];
    Risedronate_dose       [label="Risedronate PO\n35 mg weekly (adults)", shape=ellipse, fillcolor="#e2c2e5"];
    Bisphos_antiresorptive [label="Bisphosphonate\nantiresorptive effect\n(teratogenicity caution)"];
    Vitamin_D_calcium      [label="Vitamin D / calcium\nrepletion"];
  }

  subgraph cluster_psy {
    label="20. Psychological & Nutritional Interventions"; style=filled; color="#fff0d9"; fillcolor="#fff8ec"; fontsize=13;
    FBT_family             [label="Family-Based Treatment\n(FBT, adolescents)", shape=ellipse, fillcolor="#ffd9a0"];
    CBT_E                  [label="Enhanced CBT (CBT-E)\n(adults)", shape=ellipse, fillcolor="#ffd9a0"];
    MANTRA_SSCM            [label="MANTRA / SSCM\n(alternatives)"];
    Therapy_engagement     [label="Therapy engagement\n/ alliance"];
    Inpatient_admission    [label="Inpatient / medical\nstabilization admission"];
    Higher_cal_refeeding   [label="Higher-calorie refeeding\n(≥2000 kcal start)"];
    Slow_refeeding         [label="Conservative refeeding\n(1000-1200 kcal start)"];
    Post_discharge_relapse [label="Post-discharge therapy\ndiscontinuation → relapse"];
  }

  //==========================================================================
  subgraph cluster_endpoint {
    label="21. Clinical Endpoints & Outcomes"; style=filled; color="#d4edda"; fillcolor="#eaf7ee"; fontsize=13;
    EP_BMI                 [label="ENDPOINT: BMI /\n%mBMI trajectory", shape=octagon, fillcolor="#a9dfbf"];
    EP_EDEQ                [label="ENDPOINT: EDE-Q\nglobal score", shape=octagon, fillcolor="#a9dfbf"];
    EP_menses              [label="ENDPOINT: menses\nresumption probability", shape=octagon, fillcolor="#a9dfbf"];
    EP_BMD                 [label="ENDPOINT: BMD\nZ-score change", shape=octagon, fillcolor="#a9dfbf"];
    EP_HR_stability        [label="ENDPOINT: HR / medical\nstability criteria", shape=octagon, fillcolor="#a9dfbf"];
    EP_phos_nadir          [label="ENDPOINT: phosphate\nnadir & RS incidence", shape=octagon, fillcolor="#a9dfbf"];
    EP_weight_restoration  [label="ENDPOINT: weight\nrestoration (≥95% mBMI)", shape=octagon, fillcolor="#a9dfbf"];
    EP_LOS                 [label="ENDPOINT: length of\nhospital stay", shape=octagon, fillcolor="#a9dfbf"];
    EP_relapse             [label="ENDPOINT: 12-month\nrelapse rate", shape=octagon, fillcolor="#a9dfbf"];
    EP_mortality           [label="ENDPOINT: SMR ~5.9\n(highest of psychiatric\ndisorders)", shape=octagon, fillcolor="#a9dfbf"];
    EP_QoL                 [label="ENDPOINT: quality of\nlife / functioning", shape=octagon, fillcolor="#a9dfbf"];
  }

  //==========================================================================
  // ---- Risk → circuitry / behavior
  Genetic_liability -> GWAS_metabopsych;
  GWAS_metabopsych -> Energy_balance [label="metabolic component", style=dashed];
  Genetic_liability -> Trait_perfectionism;
  Genetic_liability -> Trait_anxiety_OCPD;
  Female_sex -> Puberty_estrogen_surge;
  Puberty_estrogen_surge -> Genetic_liability [label="expression unmasking", style=dashed];
  Trait_perfectionism -> ED_cognition_drive;
  Trait_anxiety_OCPD -> Amygdala_fear;
  Harm_avoidance -> Food_anticipation_anx;
  Sociocultural_thin -> Body_image_distortion;
  Life_stressor -> Dieting_onset;
  Sociocultural_thin -> Dieting_onset;
  Dieting_onset -> Restriction_behavior;
  Gut_microbiome_shift -> Microbiome_SCFA;
  Autoimmune_history -> Microbiome_SCFA [style=dashed];

  // ---- Circuitry internal
  Ventral_striatum -> Reward_prediction_err;
  Reward_prediction_err -> Dorsal_striatum_habit;
  Dorsal_striatum_habit -> Habit_restriction;
  Habit_restriction -> Restriction_behavior;
  Food_anticipation_anx -> Restriction_behavior;
  Amygdala_fear -> Food_anticipation_anx;
  Amygdala_fear -> ED_cognition_drive;
  Body_image_distortion -> ED_cognition_drive;
  Insula_interoception -> Early_satiety;
  Insula_interoception -> Body_image_distortion;
  dlPFC_control -> Habit_restriction;
  OFC_valuation -> Ventral_striatum;
  Set_shifting_deficit -> Habit_restriction;
  ED_cognition_drive -> Restriction_behavior [color="#c0392b", penwidth=2];
  ED_cognition_drive -> Compulsive_exercise;
  ED_cognition_drive -> Purging_behavior;
  Starvation_perpetuation -> ED_cognition_drive [color="#c0392b", penwidth=2];
  Body_weight_BMI -> Starvation_perpetuation [label="low weight sustains\nrigidity", color="#c0392b", style=dashed];

  // ---- Neurotransmitters
  Restriction_behavior -> Trp_availability [label="↓"];
  Trp_availability -> Brain_5HT_synthesis;
  Brain_5HT_synthesis -> Serotonin_5HT1A;
  Serotonin_5HT1A -> Food_anticipation_anx;
  Serotonin_5HT2A -> ED_cognition_drive [style=dashed];
  Dopamine_D2D3 -> Reward_prediction_err;
  Norepinephrine_tone -> Sympathetic_withdrawal [label="↓ with starvation"];
  GABA_glutamate -> dlPFC_control;
  Endogenous_opioid -> Compulsive_exercise;
  Energy_balance -> BDNF_level;
  BDNF_level -> ED_cognition_drive [style=dashed];

  // ---- Hypothalamic circuit
  Leptin_plasma -> Leptin_receptor_ObRb;
  Leptin_receptor_ObRb -> ARC_POMC_CART;
  Leptin_receptor_ObRb -> ARC_NPY_AgRP [label="inhibits", arrowhead=tee];
  ARC_NPY_AgRP -> MC4R_signaling [arrowhead=tee];
  ARC_POMC_CART -> Alpha_MSH;
  Alpha_MSH -> MC4R_signaling;
  MC4R_signaling -> PVN_integration;
  PVN_integration -> Energy_intake [arrowhead=tee];
  LHA_orexin -> Hyperactivity_drive;
  Hyperactivity_drive -> Compulsive_exercise;
  Hypothalamic_AMPK -> ARC_NPY_AgRP;
  Energy_balance -> Hypothalamic_AMPK [label="deficit → ↑"];
  Hypothalamic_AMPK -> mTOR_signaling [arrowhead=tee];
  Ghrelin_plasma -> GHSR_receptor;
  GHSR_receptor -> ARC_NPY_AgRP;
  GHSR_receptor -> GH_secretion;
  Leptin_receptor_ObRb -> Kisspeptin_neurons [color="#8e44ad", penwidth=2];
  NTS_brainstem -> PVN_integration;
  Restriction_behavior -> Hyperactivity_drive [style=dashed];

  // ---- Gut peptides
  Fat_mass -> Adipocyte_mass;
  Energy_intake -> CCK_release;
  Energy_intake -> GLP1_secretion;
  Energy_intake -> Insulin_plasma;
  Body_weight_BMI -> Ghrelin_plasma [label="inverse", arrowhead=tee];
  PYY_336 -> Early_satiety;
