/* =====================================================================
   Cutaneous T-cell lymphoma (mycosis fungoides / Sezary syndrome)
   Mechanistic QSP map
   ---------------------------------------------------------------------
   ORGANISING PRINCIPLE OF THE DRAWING
   The malignant clone is ONE population drawn in THREE boxes (skin /
   blood / node) because its residency programme -- not its genotype --
   decides which box it lives in. Every therapy edge is annotated with
   WHICH BOX it can reach, and every response-criterion edge reads only
   ONE box. Two independent host variables are drawn separately:
   CLONE KILL (red edges) and SURVEILLANCE (blue edges). ORR is a
   function of the first; TTNT is a function of the second.
   ===================================================================== */
digraph CTCL_QSP {
  graph [rankdir=TB, splines=spline, overlap=false, nodesep=0.26,
         ranksep=0.62, fontname="Helvetica", fontsize=11,
         labelloc="t", compound=true, newrank=true, ratio=0.55, bgcolor="white",
         label=<<b>Cutaneous T-Cell Lymphoma (Mycosis Fungoides / Sézary Syndrome) — QSP Mechanistic Map</b><br/>
                <i>피부 T세포 림프종 정량적 시스템 약리학 기계론적 지도 · one clone, three compartments, two host variables</i>>];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=9,
         color="#4a4a4a", penwidth=0.8, margin="0.06,0.035"];
  edge  [fontname="Helvetica", fontsize=7.5, color="#666666", penwidth=0.85,
         arrowsize=0.62];

  /* ---------- colour legend ------------------------------------------ */
  subgraph cluster_legend {
    label="범례 (Legend)"; style="rounded,filled"; fillcolor="#fbfbfb"; color="#999999"; fontsize=10;
    L1 [label="악성 클론 / Malignant clone", fillcolor="#f8cdd0"];
    L2 [label="숙주 면역감시 / Host surveillance", fillcolor="#cfe3f7"];
    L3 [label="사이토카인·매개체 / Cytokine", fillcolor="#fdf0c8"];
    L4 [label="약물 · PK / Drug & PK", fillcolor="#d9f0da"];
    L5 [label="임상 종말점 / Clinical endpoint", fillcolor="#e6d9f2"];
    L6 [label="독성 / Toxicity", fillcolor="#f6ded0"];
    L7 [label="구조 상수 (문헌 고정) / Fixed structural constant", fillcolor="#e0e0e0", shape=note];
    L1 -> L2 [label="죽임 kill", color="#c0392b", style=bold];
    L2 -> L3 [label="감시 surveillance", color="#1f6fb2", style=bold];
    L3 -> L4 [label="억제 inhibition", color="#7f8c8d", arrowhead=tee];
  }

  /* =================================================================== */
  /* 1. 클론 기원과 조직상주 프로그램                                      */
  /* =================================================================== */
  subgraph cluster_origin {
    label="1. 클론 기원 · 조직상주 프로그램 (Clonal Origin & Residency Programme)";
    style="rounded,filled"; fillcolor="#fdf5f5"; color="#c98f92";
    NAIVE   [label="나이브 CD4 T세포\nNaive CD4+ T cell", fillcolor="#ffffff"];
    PRIME   [label="피부 유래 DC에 의한 프라이밍\nSkin-draining LN priming\n(retinoic acid / vitamin D3)", fillcolor="#ffffff"];
    CLAgen  [label="CLA (cutaneous lymphocyte antigen)\nFucT-VII 의존 sLe-x 당쇄", fillcolor="#f8cdd0"];
    CCR4r   [label="CCR4 수용체 발현\nCCR4 (CD194) — 클론의 90%+", fillcolor="#f8cdd0"];
    CCR10r  [label="CCR10 (CCL27 수용체)", fillcolor="#f8cdd0"];
    CD69n   [label="CD69 ↑\n= S1PR1 내재화 → 조직 정착", fillcolor="#f8cdd0"];
    CD103n  [label="CD103 (αEβ7) — E-cadherin 결합\n표피친화성(epidermotropism)", fillcolor="#f8cdd0"];
    S1PR1   [label="S1PR1\n(조직 밖으로 나가는 유일한 출구)", fillcolor="#ffffff"];
    CCR7n   [label="CCR7 / L-selectin (CD62L)\n중심기억(T_CM) 재순환 프로그램", fillcolor="#f8cdd0"];
    TRM     [label="T_RM 표현형\nCD69+ CD103+ CCR7− → 비재순환", fillcolor="#f2a7ab"];
    TCM     [label="T_CM 표현형\nCD69− CCR7+ CD62L+ → 재순환", fillcolor="#f2a7ab"];
    PHEN    [label="표현형 분기점\n같은 방정식, 다른 CD69/CCR7 값", shape=diamond, fillcolor="#ffffff"];
  }
  NAIVE -> PRIME -> CLAgen;
  PRIME -> CCR4r; PRIME -> CCR10r;
  CD69n -> S1PR1 [arrowhead=tee, label="내재화"];
  CD69n -> TRM; CD103n -> TRM; S1PR1 -> TCM [style=dashed];
  CCR7n -> TCM;
  TRM -> PHEN; TCM -> PHEN;

  /* =================================================================== */
  /* 2. 유전체 병변                                                        */
  /* =================================================================== */
  subgraph cluster_genome {
    label="2. 유전체 병변 (Genomic Lesions — Choi 2015 / da Silva Almeida 2015 / Wang 2015)";
    style="rounded,filled"; fillcolor="#fdf5f5"; color="#c98f92";
    TP53x   [label="TP53 결손/변이 (~90% SS)\n17p13 loss", fillcolor="#f8cdd0"];
    CDKN2A  [label="CDKN2A/B 결손 (9p21)", fillcolor="#f8cdd0"];
    ARID1A  [label="ARID1A 소실 (~60%)", fillcolor="#f8cdd0"];
    ZEB1x   [label="ZEB1 소실", fillcolor="#f8cdd0"];
    FASx    [label="FAS / FASLG 신호 소실\n세포자멸사 저항", fillcolor="#f8cdd0"];
    PLCG1x  [label="PLCG1 S345F 등 (~20%)", fillcolor="#f8cdd0"];
    CARD11x [label="CARD11 GOF", fillcolor="#f8cdd0"];
    RHOAx   [label="RHOA G17V", fillcolor="#f8cdd0"];
    JAKmut  [label="JAK1 / JAK3 활성화 변이", fillcolor="#f8cdd0"];
    STATmut [label="STAT3 / STAT5B GOF", fillcolor="#f8cdd0"];
    CTLA4f  [label="CTLA4–CD28 융합", fillcolor="#f8cdd0"];
    MYCamp  [label="MYC 증폭 (8q24)", fillcolor="#f8cdd0"];
    TNFR2x  [label="TNFRSF1B(TNFR2) 변이 → NF-κB", fillcolor="#f8cdd0"];
    CCR4gof [label="CCR4 C-말단 절단형 GOF\n(수용체 내재화 소실 → 신호 지속)", fillcolor="#f8cdd0"];
    TOXg    [label="TOX 과발현\n(진단 표지 + 탈진 전사인자)", fillcolor="#f8cdd0"];
  }

  /* =================================================================== */
  /* 3. TCR / NF-κB 신호                                                  */
  /* =================================================================== */
  subgraph cluster_tcr {
    label="3. TCR–NF-κB 신호축 (TCR / NF-κB Axis)";
    style="rounded,filled"; fillcolor="#fffaf3"; color="#d0b48a";
    TCRc    [label="TCR–CD3 복합체 (클론성 Vβ)", fillcolor="#ffffff"];
    LCKz    [label="LCK → ZAP70", fillcolor="#ffffff"];
    PLCG    [label="PLCγ1 → DAG / IP3", fillcolor="#ffffff"];
    PKCT    [label="PKCθ", fillcolor="#ffffff"];
    CBM     [label="CARD11–BCL10–MALT1 (CBM)", fillcolor="#ffffff"];
    IKKc    [label="IKKα/β/γ", fillcolor="#ffffff"];
    NFKB    [label="NF-κB (p65/p50) 핵 전위", fillcolor="#fdf0c8"];
    NFATc   [label="NFAT", fillcolor="#fdf0c8"];
    AP1     [label="AP-1 (JUN/FOS)", fillcolor="#fdf0c8"];
    GATA3   [label="GATA3 → Th2 전사 프로그램", fillcolor="#fdf0c8"];
    BCL2f   [label="BCL2 / MCL1 → 세포자멸사 저항", fillcolor="#f8cdd0"];
    PROLIF  [label="클론 증식률 g_sk / g_bl", fillcolor="#f2a7ab", shape=ellipse];
  }
  TCRc -> LCKz -> PLCG -> PKCT -> CBM -> IKKc -> NFKB;
  PLCG -> NFATc; PKCT -> AP1;
  NFKB -> BCL2f; NFKB -> PROLIF; NFATc -> GATA3; AP1 -> PROLIF;
  PLCG1x -> PLCG [color="#c0392b"]; CARD11x -> CBM [color="#c0392b"];
  RHOAx -> CBM [color="#c0392b"]; TNFR2x -> NFKB [color="#c0392b"];
  CTLA4f -> NFKB [color="#c0392b", label="억제성 수용체가\n자극성 신호로 전환"];
  FASx -> BCL2f [color="#c0392b"]; TP53x -> PROLIF [color="#c0392b"];
  CDKN2A -> PROLIF [color="#c0392b"]; MYCamp -> PROLIF [color="#c0392b"];
  ARID1A -> PROLIF [color="#c0392b", style=dashed]; ZEB1x -> GATA3 [color="#c0392b"];

  /* =================================================================== */
  /* 4. JAK–STAT 사이토카인 자율성                                         */
  /* =================================================================== */
  subgraph cluster_jak {
    label="4. JAK–STAT 축 · 사이토카인 자율성 (Cytokine Autonomy)";
    style="rounded,filled"; fillcolor="#fffaf3"; color="#d0b48a";
    IL2     [label="IL-2 / IL-15 / IL-21 (γc 사이토카인)", fillcolor="#fdf0c8"];
    IL2R    [label="IL-2Rα (CD25) / γc", fillcolor="#ffffff"];
    JAK13   [label="JAK1 / JAK3", fillcolor="#ffffff"];
    STAT35  [label="STAT3 / STAT5 이량체", fillcolor="#fdf0c8"];
    SOCS    [label="SOCS1/3 (음성 되먹임, 흔히 소실)", fillcolor="#ffffff"];
    IL31g   [label="IL-31 유전자 전사", fillcolor="#fdf0c8"];
    IL10g   [label="IL-10 전사", fillcolor="#fdf0c8"];
    sIL2R   [label="가용성 IL-2R (sCD25) 유리\n→ 혈청 바이오마커", fillcolor="#e6d9f2"];
  }
  IL2 -> IL2R -> JAK13 -> STAT35;
  JAKmut -> JAK13 [color="#c0392b"]; STATmut -> STAT35 [color="#c0392b"];
  STAT35 -> SOCS [style=dashed]; SOCS -> JAK13 [arrowhead=tee, style=dashed];
  STAT35 -> IL31g; STAT35 -> IL10g; STAT35 -> BCL2f; STAT35 -> PROLIF;
  IL2R -> sIL2R;

  /* =================================================================== */
  /* 5. 피부 구획                                                          */
  /* =================================================================== */
  subgraph cluster_skin {
    label="5. 피부 구획 (SKIN — the T_RM box; mSWAT reads only this box)";
    style="rounded,filled"; fillcolor="#fdeff0"; color="#c0392b"; penwidth=1.6;
    NSKs    [label="NSK — 피부 클론(약물 감수성)\nskin clone, drug-sensitive", fillcolor="#f2a7ab", shape=box3d];
    NSKRs   [label="NSKR — 피부 클론(약물 저항성)\ndrug-resistant subclone", fillcolor="#e07a80", shape=box3d];
    NTRs    [label="NTR — 대세포 전환 아클론\nlarge-cell transformed, CD30-high", fillcolor="#c0392b", fontcolor="white", shape=box3d];
    EPID    [label="표피 / Pautrier 미세농양\nepidermotropism", fillcolor="#ffffff"];
    KERAT   [label="각질형성세포\n→ CCL27 · TSLP · IL-7/IL-15", fillcolor="#ffffff"];
    LANG    [label="랑게르한스세포 / 진피 DC\n항원 제시", fillcolor="#cfe3f7"];
    ESEL    [label="E-selectin / ICAM-1 (진피 미세혈관)", fillcolor="#ffffff"];
    CCL17s  [label="CCL17(TARC) · CCL22 구배\n(DC·각질형성세포 유래)", fillcolor="#fdf0c8"];
    KSKcap  [label="피부 니치 수용능 KSK\n(홍피증 = 포화)", shape=note, fillcolor="#e0e0e0"];
    JHOME   [label="J_home = k·CLA·CCR4·NBL\n혈액 → 피부 유입", shape=parallelogram, fillcolor="#ffffff"];
    JEGR    [label="J_egress = k·(1−CD69)·CCR7·NSK\n피부 → 혈액 유출", shape=parallelogram, fillcolor="#ffffff"];
  }
  CLAgen -> ESEL [label="구름(rolling)"];
  CCL17s -> CCR4r [label="화학주성"];
  ESEL -> JHOME; CCR4r -> JHOME; CD103n -> EPID;
  JHOME -> NSKs; JHOME -> NSKRs;
  NSKs -> JEGR; NSKRs -> JEGR; CD69n -> JEGR [arrowhead=tee];
  NSKs -> EPID; NSKs -> NSKRs [label="약물압 하 전환\nk_conv·DRG", color="#c0392b", style=dashed];
  NSKs -> NTRs [label="대세포 전환\nk_trans", color="#c0392b"];
  KERAT -> CCL17s; LANG -> CCL17s; KSKcap -> NSKs [arrowhead=tee, style=dashed];
  PROLIF -> NSKs; PROLIF -> NSKRs;

  /* =================================================================== */
  /* 6. 혈액 구획                                                          */
  /* =================================================================== */
  subgraph cluster_blood {
    label="6. 혈액 구획 (BLOOD — the T_CM box; B-score reads only this box)";
    style="rounded,filled"; fillcolor="#fdeff0"; color="#c0392b"; penwidth=1.6;
    NBLs    [label="NBL — 혈액 클론(감수성)", fillcolor="#f2a7ab", shape=box3d];
    NBLRs   [label="NBLR — 혈액 클론(저항성)", fillcolor="#e07a80", shape=box3d];
    SEZC    [label="Sézary 세포\nCD4+CD26− / CD4+CD7− / 뇌회상 핵", fillcolor="#f2a7ab"];
    KIR3DL2 [label="KIR3DL2 (CD158k)\nSS 클론의 60–80%", fillcolor="#f8cdd0"];
    BSCORE  [label="B-score (B0/B1/B2)\nB2 = ≥1000 Sézary/µL", fillcolor="#e6d9f2"];
    KBLcap  [label="혈액 구획 수용능 KBL", shape=note, fillcolor="#e0e0e0"];
  }
  NBLs -> SEZC; NBLRs -> SEZC; SEZC -> BSCORE; SEZC -> KIR3DL2;
  JEGR -> NBLs; JEGR -> NBLRs;
  NBLs -> JHOME; NBLRs -> JHOME;
  CCR7n -> NBLs; KBLcap -> NBLs [arrowhead=tee, style=dashed];

  /* =================================================================== */
  /* 7. 림프절 · 내장                                                      */
  /* =================================================================== */
  subgraph cluster_node {
    label="7. 림프절 · 내장 구획 (NODE / VISCERA — N-score, M-score)";
    style="rounded,filled"; fillcolor="#fdeff0"; color="#c0392b";
    NLNs    [label="NLN — 림프절 클론\n(피부병증성 → N1/N2 → N3)", fillcolor="#f2a7ab", shape=box3d];
    NVSs    [label="NVS — 내장 침범 (M1)", fillcolor="#e07a80", shape=box3d];
    NSCORE  [label="N-score (N0–N3)", fillcolor="#e6d9f2"];
    MSCORE  [label="M-score (M0/M1)", fillcolor="#e6d9f2"];
  }
  NBLs -> NLNs [label="k_node"]; NLNs -> NBLs [label="k_nout"];
  NLNs -> NVSs [label="k_vis"]; NLNs -> NSCORE; NVSs -> MSCORE;

  /* =================================================================== */
  /* 8. Th2 편향 · 억제성 미세환경                                          */
  /* =================================================================== */
  subgraph cluster_th2 {
    label="8. Th2 편향 · 억제성 미세환경 (Th2 Skew & Suppressive Microenvironment)";
    style="rounded,filled"; fillcolor="#fffaf3"; color="#d0b48a";
    TH2n    [label="Th2 사이토카인 톤 (TH2)\nIL-4 · IL-5 · IL-13", fillcolor="#fdf0c8"];
    IL4n    [label="IL-4 / IL-13 → STAT6", fillcolor="#fdf0c8"];
    IL31n   [label="IL-31", fillcolor="#fdf0c8"];
    IL10n   [label="IL-10", fillcolor="#fdf0c8"];
    TSLPn   [label="TSLP (각질형성세포)", fillcolor="#fdf0c8"];
    TREGn   [label="조절 T세포 (Treg)\nFOXP3+ CCR4-high", fillcolor="#cfe3f7"];
    M2      [label="M2 대식세포 / MDSC", fillcolor="#cfe3f7"];
    PD1     [label="PD-1 / PD-L1 · LAG3 · TIGIT", fillcolor="#cfe3f7"];
    ESCAPE  [label="감시효율 esc = 1/(1+k·(TH2−1))\n면역 회피 계수", shape=ellipse, fillcolor="#fdf0c8"];
  }
  GATA3 -> TH2n; STAT35 -> TH2n; TH2n -> IL4n; IL31g -> IL31n; IL10g -> IL10n;
  KERAT -> TSLPn -> TH2n; TH2n -> TREGn; IL10n -> TREGn; TREGn -> M2;
  TH2n -> ESCAPE; IL10n -> ESCAPE;

  /* =================================================================== */
  /* 9. 항종양 감시                                                        */
  /* =================================================================== */
  subgraph cluster_surv {
    label="9. 항종양 감시 — 두 번째 독립 상태변수 (Anti-tumour Surveillance: the SECOND state variable)";
    style="rounded,filled"; fillcolor="#eef5fd"; color="#1f6fb2"; penwidth=1.6;
    DCA     [label="활성 수지상세포 DCA\n교차제시 능력", fillcolor="#cfe3f7", shape=box3d];
    E8SK    [label="E8SK — 피부 클론특이 CD8 T_RM", fillcolor="#a8cdf0", shape=box3d];
    E8BL    [label="E8BL — 혈중 클론특이 CD8", fillcolor="#a8cdf0", shape=box3d];
    NKcell  [label="NK 세포 (혈중 풀 NKB)", fillcolor="#a8cdf0", shape=box3d];
    NKSKIN  [label="피부 내 NK 밀도\n= NKB × NKRSK", fillcolor="#cfe3f7"];
    IFNGn   [label="IFN-γ → CXCL9/10/11", fillcolor="#fdf0c8"];
    GZMB    [label="퍼포린 / 그랜자임 B / FasL", fillcolor="#cfe3f7"];
    IMMSK   [label="IMM_SK — 피부 면역 살해율", shape=ellipse, fillcolor="#a8cdf0"];
    IMMBL   [label="IMM_BL — 혈중 면역 살해율", shape=ellipse, fillcolor="#a8cdf0"];
    ANTIG   [label="종양 항원 부하 → 프라이밍", fillcolor="#ffffff"];
  }
  LANG -> DCA; ANTIG -> DCA; NSKs -> ANTIG; NTRs -> ANTIG;
  DCA -> E8SK [color="#1f6fb2", style=bold]; DCA -> E8BL [color="#1f6fb2", style=bold];
  TREGn -> E8SK [arrowhead=tee, color="#7f8c8d", label="supp"];
  IL10n -> E8SK [arrowhead=tee, color="#7f8c8d"];
  PD1 -> E8SK [arrowhead=tee, color="#7f8c8d"];
  E8SK -> GZMB -> IMMSK; E8BL -> IMMBL; E8SK -> IFNGn;
  NKcell -> NKSKIN; NKcell -> IMMBL;
  ESCAPE -> IMMSK [arrowhead=tee]; ESCAPE -> IMMBL [arrowhead=tee];
  IMMSK -> NSKs  [color="#1f6fb2", style=bold, label="살해"];
  IMMSK -> NSKRs [color="#1f6fb2", style=bold, label="저항성 아클론도\n동일하게 살해"];
  IMMSK -> NTRs  [color="#1f6fb2", style=bold];
  IMMBL -> NBLs  [color="#1f6fb2", style=bold];
  IMMBL -> NBLRs [color="#1f6fb2", style=bold];

  /* =================================================================== */
  /* 10. 피부장벽 · 황색포도상구균 · 초항원                                 */
  /* =================================================================== */
  subgraph cluster_barrier {
    label="10. 피부장벽 · 황색포도상구균 · 초항원 되먹임 (Barrier – S. aureus – Superantigen Loop)";
    style="rounded,filled"; fillcolor="#fdf6f0"; color="#c98f92";
    BARRn   [label="장벽 무결성 BARR\nfilaggrin · 지질 · 각질층", fillcolor="#ffffff", shape=box3d];
    AMP     [label="항균펩타이드 (LL-37 · HBD-2/3)\nTh2에 의해 억제", fillcolor="#ffffff"];
    SAURn   [label="황색포도상구균 집락화 SAUR", fillcolor="#f6ded0", shape=box3d];
    SAGn    [label="초항원 SEA/SEB/TSST-1 (SAG)", fillcolor="#f6ded0", shape=box3d];
    VBETA   [label="Vβ 제한 클론 확장\n(MHC-II 외부에서 TCR 교차결합)", fillcolor="#f8cdd0"];
    ATOX    [label="α-toxin → CD8/비악성 T세포 사멸", fillcolor="#f6ded0"];
    SCRATCH [label="긁기 → 장벽 추가 손상", fillcolor="#ffffff"];
    BACTER  [label="균혈증 · 패혈증 위험", fillcolor="#f6ded0"];
  }
  NSKs -> BARRn [arrowhead=tee, label="병변 밀도"];
  TH2n -> AMP [arrowhead=tee]; BARRn -> AMP;
  AMP -> SAURn [arrowhead=tee]; BARRn -> SAURn [arrowhead=tee];
  SAURn -> SAGn -> VBETA -> PROLIF [color="#c0392b", label="증식 자극 sag"];
  SAGn -> IL31n; SAURn -> ATOX -> E8SK [arrowhead=tee];
  SCRATCH -> BARRn [arrowhead=tee]; BARRn -> BACTER [arrowhead=tee];

  /* =================================================================== */
  /* 11. 소양증 회로                                                       */
  /* =================================================================== */
  subgraph cluster_itch {
    label="11. 소양증 회로 (Pruritus Circuit — decouples from tumour burden)";
    style="rounded,filled"; fillcolor="#fffaf3"; color="#d0b48a";
    IL31R   [label="IL31RA / OSMRβ (DRG 감각뉴런)", fillcolor="#ffffff"];
    TRPV    [label="TRPV1 / TRPA1 개방", fillcolor="#ffffff"];
    NPPB    [label="NPPB / GRP → GRPR (척수 후각)", fillcolor="#ffffff"];
    SENS    [label="SENS — 중추 감작(느린 상태변수)", fillcolor="#fdf0c8", shape=box3d];
    NRS     [label="소양증 NRS 0–10\n(≥3점 감소 = 반응)", fillcolor="#e6d9f2"];
    SKINDEX [label="Skindex-29 · 삶의 질", fillcolor="#e6d9f2"];
  }
  IL31n -> IL31R -> TRPV -> NPPB -> NRS;
  TH2n -> NRS; BARRn -> NRS [arrowhead=tee]; SAGn -> NRS;
  NRS -> SENS -> NRS [label="증폭 루프"]; NRS -> SCRATCH; NRS -> SKINDEX;

  /* =================================================================== */
  /* 12. 병변 형태 · 임상 구획 점수                                         */
  /* =================================================================== */
  subgraph cluster_score {
    label="12. 병변 형태 · 구획별 반응 점수 (Lesion Morphology & Compartment Response)";
    style="rounded,filled"; fillcolor="#f6f2fb"; color="#8e6bb5";
    APATn   [label="반점 면적 APAT (τ≈8 d)", fillcolor="#e6d9f2", shape=box3d];
    APLQn   [label="판 면적 APLQ (τ≈25 d)", fillcolor="#e6d9f2", shape=box3d];
    ATUMn   [label="종양결절 면적 ATUM (τ≈12 d)", fillcolor="#e6d9f2", shape=box3d];
    ERYTH   [label="홍피증 (erythroderma, T4)\n혈중 클론 유래 성분", fillcolor="#e6d9f2"];
    MSWAT   [label="mSWAT = 1·반점 + 2·판 + 4·종양\n(피부 구획 점수)", fillcolor="#d3bce8"];
    SKRESP  [label="피부 반응: ≥50% mSWAT 감소", fillcolor="#d3bce8"];
    BLRESP  [label="혈액 반응: B-score 개선", fillcolor="#d3bce8"];
    NDRESP  [label="림프절 반응", fillcolor="#d3bce8"];
    GLOBAL  [label="GLOBAL 반응 (Olsen 2011)\n= 모든 침범 구획의 논리곱(AND)", fillcolor="#b79ada", penwidth=1.6];
    STAGE   [label="TNMB 병기 (IA–IVB)", fillcolor="#d3bce8"];
  }
  NSKs -> APATn; NSKs -> APLQn; NTRs -> ATUMn; NSKRs -> APLQn;
  NBLs -> ERYTH [label="(1−CD69)"];
  ERYTH -> APATn;
  APATn -> MSWAT; APLQn -> MSWAT; ATUMn -> MSWAT;
  MSWAT -> SKRESP; BSCORE -> BLRESP; NSCORE -> NDRESP;
  SKRESP -> GLOBAL [color="#8e6bb5", penwidth=1.4];
  BLRESP -> GLOBAL [color="#8e6bb5", penwidth=1.4];
  NDRESP -> GLOBAL [color="#8e6bb5", penwidth=1.4];
  MSCORE -> GLOBAL [color="#8e6bb5"];
  MSWAT -> STAGE; BSCORE -> STAGE; NSCORE -> STAGE; MSCORE -> STAGE;

  /* =================================================================== */
  /* 13. 혈청 바이오마커                                                   */
  /* =================================================================== */
  subgraph cluster_biomk {
    label="13. 혈청 바이오마커 (Serum Biomarkers)";
    style="rounded,filled"; fillcolor="#f6f2fb"; color="#8e6bb5";
    TARCb   [label="혈청 TARC / CCL17 (pg/mL)", fillcolor="#e6d9f2"];
    SIL2Rb  [label="가용성 IL-2R (U/mL)", fillcolor="#e6d9f2"];
    LDHb    [label="LDH (U/L)", fillcolor="#e6d9f2"];
    B2M     [label="β2-마이크로글로불린", fillcolor="#e6d9f2"];
    ASC     [label="절대 Sézary 세포수 (/µL)", fillcolor="#e6d9f2"];
  }
  CCL17s -> TARCb; TH2n -> TARCb; sIL2R -> SIL2Rb;
  NSKs -> LDHb; NBLs -> LDHb; NTRs -> LDHb; NBLs -> B2M; SEZC -> ASC;

  /* =================================================================== */
  /* 14. 피부지향 치료                                                     */
  /* =================================================================== */
  subgraph cluster_sdt {
    label="14. 피부지향 치료 (Skin-Directed Therapy — reaches the SKIN box only)";
    style="rounded,filled"; fillcolor="#eefaef"; color="#3d8b40";
    TCSd    [label="국소 코르티코스테로이드\n(class I–II)", fillcolor="#d9f0da"];
    NBUVB   [label="협대역 UVB 311 nm\n(표피 침투 한정)", fillcolor="#d9f0da"];
    PUVAd   [label="PUVA (8-MOP + UVA)\n진피 상부까지", fillcolor="#d9f0da"];
    CHLOR   [label="클로르메틴(메클로레타민) 젤\n알킬화, 표면 한정", fillcolor="#d9f0da"];
    BEXGEL  [label="벡사로텐 젤 1%", fillcolor="#d9f0da"];
    TSEBd   [label="전신전자선 TSEB\n저선량 12 Gy / 8분할", fillcolor="#d9f0da"];
    LOCRT   [label="국소 방사선 (8 Gy / 2분할)", fillcolor="#d9f0da"];
    DEPTH   [label="침투 깊이 계수 depth\n반점 1.0 · 판 0.45 · 종양 0.12", shape=note, fillcolor="#e0e0e0"];
    SDTexp  [label="SDT — 피부지향 노출 상태변수", fillcolor="#d9f0da", shape=box3d];
  }
  TCSd -> SDTexp; NBUVB -> SDTexp; PUVAd -> SDTexp; CHLOR -> SDTexp; BEXGEL -> SDTexp;
  DEPTH -> SDTexp;
  SDTexp -> NSKs [color="#c0392b", style=bold, label="피부 살해만"];
  SDTexp -> DCA  [color="#1f6fb2", label="면역원성 세포사"];
  TSEBd -> NSKs [color="#c0392b", style=bold];
  TSEBd -> NTRs [color="#c0392b", style=bold];
  TSEBd -> E8SK [arrowhead=tee, color="#c0392b", label="피부 CD8 T_RM도 함께 소각\n→ 재발의 이유"];
  LOCRT -> NTRs [color="#c0392b"];

  /* =================================================================== */
  /* 15. 면역조절 치료                                                     */
  /* =================================================================== */
  subgraph cluster_immuno {
    label="15. 면역조절 치료 — 감시 변수를 움직이는 약 (Immunomodulators: they move the SURVEILLANCE variable)";
    style="rounded,filled"; fillcolor="#eefaef"; color="#3d8b40";
    IFNa    [label="인터페론 알파-2b\n3 MU SC 주 3회", fillcolor="#d9f0da"];
    ECPd    [label="체외광분리교환술 ECP\n8-MOP + UVA, 2일 연속 q4wk", fillcolor="#d9f0da"];
    IMIQ    [label="이미퀴모드 (TLR7)", fillcolor="#d9f0da"];
    IL12d   [label="IL-12 / IL-2 (실험적)", fillcolor="#d9f0da"];
    ALLOH   [label="동종조혈모세포이식 (RIC)\n이식편대림프종(GVL)", fillcolor="#d9f0da"];
    APOPT   [label="ECP 유래 자멸 클론세포\n→ DC 적재", fillcolor="#ffffff"];
  }
  IFNa -> DCA [color="#1f6fb2", style=bold, label="DC 성숙"];
  IFNa -> NKcell [color="#1f6fb2"]; IFNa -> TH2n [arrowhead=tee];
  IFNa -> NSKs [color="#c0392b", style=dashed, label="약한 직접 살해"];
  ECPd -> APOPT -> DCA [color="#1f6fb2", style=bold];
  ECPd -> NBLs [color="#c0392b", label="처리 혈액량만큼"];
  IMIQ -> DCA [color="#1f6fb2"]; IL12d -> E8SK [color="#1f6fb2"];
  ALLOH -> E8SK [color="#1f6fb2", style=bold, label="GVL"];

  /* =================================================================== */
  /* 16. 표적 전신 치료                                                    */
  /* =================================================================== */
  subgraph cluster_systemic {
    label="16. 표적 · 세포독성 전신치료 (Targeted & Cytotoxic Systemic Therapy)";
    style="rounded,filled"; fillcolor="#eefaef"; color="#3d8b40";
    MOGA    [label="모가물리주맙 (항CCR4, defucosylated)\n1 mg/kg IV", fillcolor="#d9f0da"];
    BVd     [label="브렌툭시맙 베도틴 (항CD30–MMAE)\n1.8 mg/kg q3w ×16", fillcolor="#d9f0da"];
    ALEMd   [label="알렘투주맙 (항CD52) 저용량 SC", fillcolor="#d9f0da"];
    DENIL   [label="데닐류킨 디프티톡스 (IL-2–디프테리아독소)", fillcolor="#d9f0da"];
    LACUT   [label="라쿠타맙 (항KIR3DL2)", fillcolor="#d9f0da"];
    VORd    [label="보리노스타트 400 mg qd (HDACi)", fillcolor="#d9f0da"];
    ROMd    [label="로미뎁신 14 mg/m² d1,8,15 (HDACi)", fillcolor="#d9f0da"];
    BEXo    [label="벡사로텐 300 mg/m² qd (RXR)", fillcolor="#d9f0da"];
    MTXd    [label="저용량 메토트렉세이트 주 1회", fillcolor="#d9f0da"];
    GEMd    [label="젬시타빈 1000 mg/m² d1,8,15", fillcolor="#d9f0da"];
    PLDd    [label="리포솜 독소루비신 · 프랄라트렉세이트", fillcolor="#d9f0da"];
    JAKi    [label="JAK 억제제 (룩솔리티닙 등, 실험적)", fillcolor="#d9f0da"];
  }

  /* =================================================================== */
  /* 17. PK 구획과 조직 노출                                               */
  /* =================================================================== */
  subgraph cluster_pk {
    label="17. PK 구획 · 조직 노출 (Pharmacokinetics & Tissue Exposure)";
    style="rounded,filled"; fillcolor="#eefaef"; color="#3d8b40";
    MOGC    [label="MOG1/MOG2 — 항체 중심·말초구획\nCL 0.30 L/d, t½ ≈ 15 d", fillcolor="#d9f0da", shape=box3d];
    ABCsk   [label="ABC_skin = 0.157\n항체 피부 분포계수 (Shah & Betts 2013)", shape=note, fillcolor="#e0e0e0", penwidth=1.6];
    ABCln   [label="ABC_lymph node = 0.085", shape=note, fillcolor="#e0e0e0"];
    CSKIN   [label="피부 간질 항체농도 = 0.157 × C_plasma", fillcolor="#ffffff"];
    OCCsk   [label="피부 CCR4 점유율 ≈ 1.0\n(KD 0.02 µg/mL ≪ 노출)", fillcolor="#ffffff"];
    BVpk    [label="BV1/BV2 — ADC (t½ ≈ 4–6 d)", fillcolor="#d9f0da", shape=box3d];
    MMAEp   [label="유리 MMAE (0.019 mg/mg ADC)", fillcolor="#d9f0da", shape=box3d];
    ROMpk   [label="로미뎁신 2구획 (t½ ≈ 3 h)", fillcolor="#d9f0da", shape=box3d];
    ORALp   [label="경구 depot (보리노스타트·벡사로텐·MTX)", fillcolor="#d9f0da", shape=box3d];
    GEMpk   [label="세포내 dFdCTP 대리구획 (t½ ≈ 1.5 d)", fillcolor="#d9f0da", shape=box3d];
    ALEMpk  [label="알렘투주맙 (SC, 항원 sink)", fillcolor="#d9f0da", shape=box3d];
    NKRSKn  [label="NKRSK = 0.12\n피부/혈액 NK 밀도비", shape=note, fillcolor="#e0e0e0", penwidth=1.6];
  }
  MOGA -> MOGC -> CSKIN; ABCsk -> CSKIN; ABCln -> CSKIN [style=dashed];
  CSKIN -> OCCsk;
  BVd -> BVpk -> MMAEp; ROMd -> ROMpk; VORd -> ORALp; BEXo -> ORALp; MTXd -> ORALp;
  GEMd -> GEMpk; ALEMd -> ALEMpk;

  /* =================================================================== */
  /* 18. 저항성 · 항원 소실                                                */
  /* =================================================================== */
  subgraph cluster_resist {
    label="18. 저항성 · 항원 소실 (Resistance & Antigen Loss)";
    style="rounded,filled"; fillcolor="#fdf6f0"; color="#c98f92";
    FRESn   [label="기저 약물저항 분획 FRES\n(전치료 이력의 대리변수)", fillcolor="#e07a80", shape=box3d];
    CCR4sel [label="FCCR4 — CCR4 양성 분획\n복제자 동역학 dF/dt = −s·F(1−F)", fillcolor="#e07a80", shape=box3d];
    CD30e   [label="CD30E — 평균 CD30 발현\n(HDACi로 유도 가능)", fillcolor="#e07a80", shape=box3d];
    RESK    [label="RESK = 0.12\n저항성 아클론에 남는 약물효과", shape=note, fillcolor="#e0e0e0"];
    IMMED   [label="면역편집 (immunoediting)\nMHC-I 소실 · 항원 소실", fillcolor="#e07a80"];
  }
  FRESn -> NSKRs; FRESn -> NBLRs; RESK -> NSKRs;
  MOGC -> CCR4sel [arrowhead=tee, label="항원 소실 선택압"];
  CCR4sel -> OCCsk; BVpk -> CD30e [arrowhead=tee, style=dashed, label="CD30 소실 선택압"];
  CD30e -> BVpk [style=dashed];
  IMMED -> IMMSK [arrowhead=tee];

  /* =================================================================== */
  /* 19. 독성 · 안전성                                                     */
  /* =================================================================== */
  subgraph cluster_tox {
    label="19. 독성 · 안전성 (Toxicity & Safety)";
    style="rounded,filled"; fillcolor="#fdf1ea"; color="#c0662a";
    MARash  [label="모가물리주맙 연관 발진 (MAR)\nTreg 고갈의 직접 결과 (~24–32%)", fillcolor="#f6ded0"];
    GVHD    [label="이식편대숙주병 (특히 이식 전 MOGA 노출)", fillcolor="#f6ded0"];
    NEURO   [label="MMAE 말초신경병증 (누적, ~67%)", fillcolor="#f6ded0", shape=box3d];
    MYELO   [label="골수억제 (Friberg 전이구획 → ANC/PLT)", fillcolor="#f6ded0", shape=box3d];
    TSHax   [label="중추성 갑상선기능저하\nTSH 억제 → FT4 ↓", fillcolor="#f6ded0", shape=box3d];
    TGtox   [label="고중성지방혈증", fillcolor="#f6ded0", shape=box3d];
    CD4N    [label="정상 CD4 수 (면역억제 정도)", fillcolor="#f6ded0", shape=box3d];
    INFEC   [label="감염 (봉와직염 · 균혈증 · 패혈증)\nCTCL 최다 사인", fillcolor="#f6ded0"];
    ADAn    [label="항약물항체 (ADA)", fillcolor="#f6ded0"];
    IRR     [label="주입관련 반응", fillcolor="#f6ded0"];
  }
  BACTER -> INFEC; CD4N -> INFEC [arrowhead=tee]; MYELO -> INFEC [arrowhead=tee];
  MARash -> E8SK [color="#1f6fb2", style=dashed, label="Treg 고갈의 다른 얼굴 —\n발진과 반응이 함께 간다"];

  /* =================================================================== */
  /* 20. 임상 종말점 · 생존                                                */
  /* =================================================================== */
  subgraph cluster_endpoint {
    label="20. 임상 종말점 · 생존 (Clinical Endpoints & Survival)";
    style="rounded,filled"; fillcolor="#f6f2fb"; color="#8e6bb5"; penwidth=1.6;
    ORRg    [label="GLOBAL ORR\n= 구획별 ORR의 논리곱", fillcolor="#d3bce8"];
    ORRc    [label="구획별 ORR (피부 / 혈액 / 림프절)", fillcolor="#d3bce8"];
    PFSe    [label="무진행생존 PFS", fillcolor="#d3bce8"];
    TTNTe   [label="다음치료까지의 기간 TTNT\n(감시 변수가 결정)", fillcolor="#b79ada", penwidth=1.6];
    DORe    [label="반응지속기간 DOR", fillcolor="#d3bce8"];
    ITCHe   [label="소양증 반응 (NRS ≥3점 감소)", fillcolor="#d3bce8"];
    LCTe    [label="대세포 전환 발생", fillcolor="#d3bce8"];
    HZD     [label="질환 사망위험 HZD", fillcolor="#d3bce8"];
    HZI     [label="감염 사망위험 HZI", fillcolor="#d3bce8"];
    OSe     [label="전체생존 OS\n(병기별: IB ~정상 · IIB 4.7 y · IVA1 3.8 y · IVB 1.4 y)", fillcolor="#b79ada"];
  }
  GLOBAL -> ORRg; SKRESP -> ORRc; BLRESP -> ORRc; NDRESP -> ORRc;
  GLOBAL -> PFSe; MSWAT -> TTNTe; IMMSK -> TTNTe [color="#1f6fb2", style=bold, penwidth=1.6];
  GLOBAL -> DORe; NRS -> ITCHe; NTRs -> LCTe;
  NSKs -> HZD; NBLs -> HZD; NTRs -> HZD; NVSs -> HZD;
  INFEC -> HZI; HZD -> OSe; HZI -> OSe; LCTe -> HZD;
  STAGE -> OSe;

  /* ---- mechanism edges: which BOX does each drug reach? -------------- */
  MOGC  -> NBLs  [color="#c0392b", style=bold, label="ADCC (혈중 NK 풍부)\n빠름: 수일"];
  MOGC  -> NBLRs [color="#c0392b", style=bold];
  OCCsk -> NSKs  [color="#c0392b", style=dashed, label="피부 ADCC — 점유율은 충분하나\n효과세포가 없어 8배 약함"];
  NKRSKn -> NKSKIN [color="#7f8c8d"];
  NKSKIN -> NSKs [color="#c0392b", style=dashed];
  MOGC  -> TREGn [color="#c0392b", style=bold, label="CCR4-high Treg 우선 제거"];
  TREGn -> MARash [color="#c0392b", style=dashed];
  MOGC  -> JHOME [arrowhead=tee, color="#c0392b", style=bold, label="귀소 경로 차단\n(세포가 아니라 길을 막는다)"];
  BVpk  -> NTRs  [color="#c0392b", style=bold, label="CD30 결합 → 내재화 → MMAE"];
  BVpk  -> NSKs  [color="#c0392b", style=bold, label="효과세포 불필요\n→ 구획 격차 작음"];
  MMAEp -> NSKRs [color="#c0392b", label="bystander 살해"];
  MMAEp -> NEURO [color="#c0392b"];
  MMAEp -> MYELO [color="#c0392b"];
  ALEMpk -> NBLs [color="#c0392b", style=bold, label="CD52 고밀도 + 보체\n혈액에서 매우 강함"];
  ALEMpk -> E8SK [arrowhead=tee, color="#c0392b", style=bold, label="CD8·NK도 함께 제거"];
  ALEMpk -> CD4N [arrowhead=tee, color="#c0392b"];
  DENIL -> NSKs [color="#c0392b", label="CD25+ 세포"];
  DENIL -> TREGn [color="#c0392b"];
  LACUT -> KIR3DL2 [color="#c0392b"];
  ROMpk -> NSKs [color="#c0392b"]; ROMpk -> NBLs [color="#c0392b"];
  ROMpk -> CD30e [color="#3d8b40", style=bold, label="CD30 발현 상향\n→ BV 순차치료 근거"];
  ORALp -> NSKs [color="#c0392b", label="세포내재적 — 구획 격차 없음"];
  ORALp -> NBLs [color="#c0392b"];
  BEXo -> CCR4r [arrowhead=tee, label="CLA/CCR4 하향"];
  BEXo -> TSHax [color="#c0392b"]; BEXo -> TGtox [color="#c0392b"];
  GEMpk -> NSKs [color="#c0392b", style=bold, label="증식세포 강력 살해"];
  GEMpk -> E8SK [arrowhead=tee, color="#c0392b", style=bold, label="감시 변수도 함께 파괴\n→ ORR은 높고 TTNT는 짧다"];
  GEMpk -> MYELO [color="#c0392b"];
  PLDd -> NSKs [color="#c0392b"]; JAKi -> STAT35 [arrowhead=tee];
  MTXd -> E8SK [arrowhead=tee, color="#c0392b", style=dashed];

  ALLOH -> GVHD [color="#c0392b", label="이식 전 CCR4 차단은\nGVHD 위험을 올린다"];

  /* ---- cross-cluster structural annotations -------------------------- */
  PHEN -> NSKs [style=dotted, label="CD69 높음 → 피부 우세 (MF)"];
  PHEN -> NBLs [style=dotted, label="CD69 낮음 → 혈액 우세 (SS)"];
  TOXg -> PROLIF [style=dashed];
  CCR4gof -> CCR4r [color="#c0392b"];
  KIR3DL2 -> LACUT [style=dotted];
}
