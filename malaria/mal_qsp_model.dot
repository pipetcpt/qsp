digraph Malaria_QSP_Model {
    rankdir=TB;
    compound=true;
    splines=ortho;
    nodesep=0.35;
    ranksep=0.55;
    fontname="Helvetica";
    node [fontname="Helvetica", fontsize=9, style="filled,rounded", shape=box];
    edge [fontname="Helvetica", fontsize=7, arrowsize=0.7];

    // ─────────────────────────────────────────────────────────
    // CLUSTER 1: MOSQUITO TRANSMISSION & LIVER (PRE-ERYTHROCYTIC) STAGE
    // ─────────────────────────────────────────────────────────
    subgraph cluster_transmission {
        label="① Mosquito Transmission & Liver Stage";
        style="filled,rounded";
        fillcolor="#F0FFF4";
        color="#006633";
        fontsize=11; fontcolor="#006633";

        Anopheles_bite    [label="Anopheles Mosquito\nBite (Probing)", fillcolor="#99DDAA"];
        Sporozoite_inject [label="Sporozoite\nInoculation (~100)", fillcolor="#88CC99"];
        Skin_transit      [label="Dermal Transit &\nLymphatic Drainage", fillcolor="#99DDAA"];
        Sporozoite_blood  [label="Sporozoite\nBloodstream Transit", fillcolor="#88CC99"];
        Kupffer_evasion   [label="Kupffer Cell\nTraversal/Evasion (CSP)", fillcolor="#77BB88"];
        Hepatocyte_invasion[label="Hepatocyte Invasion\n(CSP-HSPG binding)", fillcolor="#66AA77"];
        PV_formation      [label="Parasitophorous\nVacuole Formation", fillcolor="#77BB88"];
        Liver_schizogony  [label="Exo-erythrocytic\nSchizogony (6-16d)", fillcolor="#55AA66"];
        Hypnozoite_form   [label="Hypnozoite\nDormant Form (P. vivax)", fillcolor="#448855"];
        Hypnozoite_reactivation[label="Hypnozoite\nReactivation (Relapse)", fillcolor="#336644"];
        Merosome_release  [label="Merosome Budding\n& Release", fillcolor="#66AA77"];
        Liver_merozoites  [label="Liver-Stage\nMerozoites (~40,000/schizont)", fillcolor="#448855"];
        Prepatent_period  [label="Pre-Patent Period\n(6-16 days)", fillcolor="#337744"];
    }

    // ─────────────────────────────────────────────────────────
    // CLUSTER 2: BLOOD-STAGE (ERYTHROCYTIC) PARASITE LIFE CYCLE
    // ─────────────────────────────────────────────────────────
    subgraph cluster_blood_cycle {
        label="② Blood-Stage Erythrocytic Cycle (48h P.f.)";
        style="filled,rounded";
        fillcolor="#FFF8EE";
        color="#CC6600";
        fontsize=11; fontcolor="#CC6600";

        Uninfected_RBC    [label="Uninfected\nRBC Pool", fillcolor="#FFD599"];
        Merozoite_free    [label="Free Merozoite\n(extracellular, <60s)", fillcolor="#FFB347"];
        EBA_RH_invasion   [label="EBA/RH Ligand-\nReceptor Invasion", fillcolor="#FFCC88"];
        Ring_stage        [label="Ring Stage\n(0-18h)", fillcolor="#FFB347"];
        Trophozoite_stage [label="Trophozoite Stage\n(18-30h, feeding)", fillcolor="#FF9900"];
        Hemoglobin_digest [label="Hemoglobin\nDigestion (DV)", fillcolor="#FFCC88"];
        Hemozoin_formation[label="Hemozoin (Malaria\nPigment) Formation", fillcolor="#FFB347"];
        Schizont_stage    [label="Schizont Stage\n(30-48h, nuclear division)", fillcolor="#FF8800"];
        Schizont_rupture  [label="Schizont Rupture\n(Synchronous)", fillcolor="#FF7700"];
        Merozoite_egress  [label="Merozoite Egress\n(~16-32/schizont)", fillcolor="#FFB347"];
        Parasitemia       [label="Peripheral\nParasitemia (parasites/µL)", fillcolor="#FF6600"];
        Multiplication_rate[label="Parasite Multiplication\nRate (PMR, ~10x/cycle)", fillcolor="#FF9900"];
        Gametocytogenesis [label="Gametocytogenesis\n(commitment, AP2-G)", fillcolor="#FFCC88"];
        Gametocyte_stage_I_IV[label="Gametocyte\nStages I-IV (sequestered)", fillcolor="#FFB347"];
        Gametocyte_stage_V[label="Mature Gametocyte\n(Stage V, circulating)", fillcolor="#FF9900"];
        Transmission_infectivity[label="Mosquito\nInfectivity (Xenodiagnosis)", fillcolor="#FF8800"];
    }

    // ─────────────────────────────────────────────────────────
    // CLUSTER 3: SEQUESTRATION & CYTOADHERENCE
    // ─────────────────────────────────────────────────────────
    subgraph cluster_sequestration {
        label="③ Sequestration & Cytoadherence";
        style="filled,rounded";
        fillcolor="#FFF0F5";
        color="#CC0044";
        fontsize=11; fontcolor="#CC0044";

        PfEMP1_display    [label="PfEMP1 Display\n(var gene, knob)", fillcolor="#FFB3C6"];
        Var_gene_switch   [label="var Gene Antigenic\nSwitching (~60 genes)", fillcolor="#FF99BB"];
        ICAM1_binding     [label="ICAM-1 Binding\n(Brain microvasculature)", fillcolor="#FF8899"];
        CD36_binding      [label="CD36 Binding\n(Peripheral/dermal)", fillcolor="#FFCCDD"];
        EPCR_binding      [label="EPCR Binding\n(Severe malaria domain)", fillcolor="#FF8899"];
        CSA_binding       [label="Chondroitin Sulfate A\nBinding (Placenta, VAR2CSA)", fillcolor="#FFB3C6"];
        Rosetting         [label="Rosetting\n(uRBC adherence)", fillcolor="#FFCCDD"];
        Platelet_clumping [label="Platelet-Mediated\nClumping", fillcolor="#FFB3C6"];
        Microvascular_obstruction[label="Microvascular\nObstruction", fillcolor="#FF7788"];
        Endothelial_activation[label="Endothelial\nActivation (Ang-2/Tie2)", fillcolor="#FF8899"];
        BBB_breakdown     [label="Blood-Brain Barrier\nBreakdown", fillcolor="#FF6677"];
    }

    // ─────────────────────────────────────────────────────────
    // CLUSTER 4: HOST INNATE IMMUNE RESPONSE
    // ─────────────────────────────────────────────────────────
    subgraph cluster_innate {
        label="④ Host Innate Immune Response";
        style="filled,rounded";
        fillcolor="#F0F8FF";
        color="#0055AA";
        fontsize=11; fontcolor="#0055AA";

        GPI_anchor_PAMP   [label="GPI Anchor /\nHemozoin PAMPs", fillcolor="#AACCFF"];
        TLR2_TLR9_sensing [label="TLR2/TLR9/TLR4\nPattern Recognition", fillcolor="#99BBEE"];
        Inflammasome_NLRP3[label="NLRP3\nInflammasome Activation", fillcolor="#88AADD"];
        Monocyte_macrophage[label="Monocyte/\nMacrophage Activation", fillcolor="#77AACC"];
        TNF_alpha_mal     [label="TNF-α\n(Fever, severity)", fillcolor="#6699CC"];
        IL6_mal           [label="IL-6\n(Acute phase)", fillcolor="#6699CC"];
        IL1b_mal          [label="IL-1β", fillcolor="#77AACC"];
        IL10_mal          [label="IL-10\n(Counter-regulatory)", fillcolor="#99BBEE"];
        IFN_gamma_mal     [label="IFN-γ\n(NK/γδT early)", fillcolor="#6699CC"];
        NK_cell_mal       [label="NK Cell\nActivation", fillcolor="#77AACC"];
        gamma_delta_T     [label="γδ T Cell\nResponse", fillcolor="#88AADD"];
        Complement_activation[label="Complement\nActivation (C5a)", fillcolor="#88AADD"];
        NO_pathway        [label="Nitric Oxide\nBioavailability↓", fillcolor="#5588BB"];
        Fever_response    [label="Fever/Rigor\n(Paroxysm, cytokine-driven)", fillcolor="#4477AA"];
    }

    // ─────────────────────────────────────────────────────────
    // CLUSTER 5: ADAPTIVE IMMUNITY & IMMUNE EVASION
    // ─────────────────────────────────────────────────────────
    subgraph cluster_adaptive {
        label="⑤ Adaptive Immunity & Immune Evasion";
        style="filled,rounded";
        fillcolor="#FFFCE8";
        color="#886600";
        fontsize=11; fontcolor="#886600";

        Tfh_cell_mal      [label="T Follicular Helper\nCell Response", fillcolor="#EEDD88";];
        Atypical_memB     [label="Atypical Memory\nB Cells (exhaustion)", fillcolor="#DDCC77"];
        MSP1_AMA1_Ab      [label="Anti-MSP1/AMA1\nInvasion-Blocking Ab", fillcolor="#EEBB55"];
        PfEMP1_Ab         [label="Anti-PfEMP1\nVariant-Specific Ab", fillcolor="#EEBB55"];
        Opsonic_phagocytosis[label="Opsonic\nPhagocytosis (Spleen)", fillcolor="#DDCC77"];
        Clinical_immunity [label="Naturally-Acquired\nClinical Immunity (age/exposure)", fillcolor="#CCAA55"];
        Premunition       [label="Premunition\n(Asymptomatic Parasitemia)", fillcolor="#DDBB66"];
        Antigenic_variation[label="Antigenic Variation\n(Immune Evasion)", fillcolor="#EECC66"];
        Splenic_clearance [label="Splenic Filtration\n(Pitting, rigidity sensing)", fillcolor="#DDCC77"];
        Maternal_Ab_transfer[label="Maternal Antibody\nTransfer (Infant protection)", fillcolor="#EEDD88"];
    }

    // ─────────────────────────────────────────────────────────
    // CLUSTER 6: SEVERE MALARIA PATHOPHYSIOLOGY
    // ─────────────────────────────────────────────────────────
    subgraph cluster_severe {
        label="⑥ Severe Malaria Pathophysiology";
        style="filled,rounded";
        fillcolor="#FFF0F0";
        color="#AA0000";
        fontsize=11; fontcolor="#AA0000";

        Cerebral_malaria  [label="Cerebral Malaria\n(Coma, seizures)", fillcolor="#FF8888"];
        Retinopathy_mal   [label="Malarial\nRetinopathy", fillcolor="#FFAAAA"];
        Raised_ICP        [label="Raised Intracranial\nPressure", fillcolor="#EE7777"];
        Hemolysis_mal     [label="Intravascular/\nExtravascular Hemolysis", fillcolor="#FF9999"];
        Dyserythropoiesis [label="Bone Marrow\nDyserythropoiesis", fillcolor="#FFAAAA"];
        Severe_anemia     [label="Severe Malarial\nAnemia (Hb<5 g/dL)", fillcolor="#EE7777"];
        Lactic_acidosis   [label="Lactic Acidosis\n(Anaerobic glycolysis)", fillcolor="#FF8888"];
        Hypoglycemia_mal  [label="Hypoglycemia\n(Quinine-worsened)", fillcolor="#FFAAAA"];
        AKI_mal           [label="Acute Kidney\nInjury (Blackwater fever)", fillcolor="#EE7777"];
        Pulmonary_edema_mal[label="Pulmonary Edema/\nARDS", fillcolor="#FF9999"];
        Hepatic_dysfunction_mal[label="Hepatic\nDysfunction (Jaundice)", fillcolor="#FFAAAA"];
        DIC_mal           [label="Disseminated\nIntravascular Coagulation", fillcolor="#EE7777"];
        Placental_malaria [label="Placental Malaria\n(IUGR, low birth weight)", fillcolor="#FF9999"];
        Multiorgan_failure[label="Multi-Organ\nDysfunction", fillcolor="#CC5555"];
    }

    // ─────────────────────────────────────────────────────────
    // CLUSTER 7: ARTEMISININ PK/PD
    // ─────────────────────────────────────────────────────────
    subgraph cluster_artemisinin_pk {
        label="⑦ Artemisinin Derivative PK/PD";
        style="filled,rounded";
        fillcolor="#F5F0FF";
        color="#5500AA";
        fontsize=11; fontcolor="#5500AA";

        AS_dose           [label="Artesunate Dose\n(Oral/IV/IM/Rectal)", fillcolor="#CCAAEE"];
        AS_plasma         [label="Artesunate\nPlasma (t½ ~30min)", fillcolor="#BB99DD"];
        DHA_active        [label="Dihydroartemisinin\n(Active Metabolite)", fillcolor="#AA88CC"];
        DHA_plasma        [label="DHA Plasma\n(t½ ~45min)", fillcolor="#9977BB"];
        Heme_activation   [label="Heme/Fe2+-Mediated\nEndoperoxide Activation", fillcolor="#8866AA"];
        Free_radical_alkylation[label="Carbon-Centered\nRadical Alkylation", fillcolor="#775599"];
        PfATP6_SERCA_target[label="PfATP6 (SERCA)\n& Multi-Target Damage", fillcolor="#664488"];
        Ring_stage_kill   [label="Broad-Stage Killing\n(incl. Ring, unique)", fillcolor="#553377"];
        PRR_kinetics      [label="Parasite Reduction\nRatio (PRR ~10,000/cycle)", fillcolor="#7766AA";];
        UGT1A9_metabolism [label="UGT1A9/2B7\nGlucuronidation", fillcolor="#AA88CC"];
    }

    // ─────────────────────────────────────────────────────────
    // CLUSTER 8: PARTNER DRUG PK/PD (ACT LONG-ACTING COMPONENT)
    // ─────────────────────────────────────────────────────────
    subgraph cluster_partner_pk {
        label="⑧ Partner Drug PK/PD (ACT)";
        style="filled,rounded";
        fillcolor="#FFF5EE";
        color="#AA5500";
        fontsize=11; fontcolor="#AA5500";

        Lumefantrine_dose [label="Lumefantrine Dose\n(with fatty food, F↑)", fillcolor="#FFCC99"];
        Lumefantrine_central[label="Lumefantrine\nCentral (t½ ~4-6d)", fillcolor="#FFBB77"];
        Lumefantrine_peripheral[label="Lumefantrine\nPeripheral Compartment", fillcolor="#FFAA55"];
        Piperaquine_dose  [label="Piperaquine Dose\n(DHA-PPQ combo)", fillcolor="#FFCC99"];
        Piperaquine_PK    [label="Piperaquine\nPK (t½ ~20-28d)", fillcolor="#FFAA55"];
        Amodiaquine_dose  [label="Amodiaquine\n(ASAQ combo)", fillcolor="#FFCC99"];
        Desethylamodiaquine[label="Desethylamodiaquine\n(Active metabolite, t½~10d)", fillcolor="#FFAA55"];
        Mefloquine_PK     [label="Mefloquine\nPK (t½ ~14-21d)", fillcolor="#FFBB77"];
        Post_treatment_prophylaxis[label="Post-Treatment\nProphylaxis Window", fillcolor="#EE9944"];
        CYP3A4_metabolism [label="CYP3A4/2C8\nMetabolism", fillcolor="#FFCC99"];
        QTc_prolongation  [label="QTc Prolongation\nRisk (PPQ/Mefloquine)", fillcolor="#EE8833"];
    }

    // ─────────────────────────────────────────────────────────
    // CLUSTER 9: RADICAL CURE & TRANSMISSION-BLOCKING (8-AMINOQUINOLINES)
    // ─────────────────────────────────────────────────────────
    subgraph cluster_radical_cure {
        label="⑨ Radical Cure & Transmission-Blocking";
        style="filled,rounded";
        fillcolor="#F0FFFF";
        color="#008888";
        fontsize=11; fontcolor="#008888";

        Primaquine_dose   [label="Primaquine Dose\n(14-day course)", fillcolor="#99DDDD"];
        Primaquine_metabolite[label="CYP2D6 Active\nMetabolite (Carboxyprimaquine)", fillcolor="#77CCCC"];
        Tafenoquine_dose  [label="Tafenoquine\n(Single-dose)", fillcolor="#88CCCC"];
        Hypnozoiticidal_action[label="Hypnozoiticidal\nAction (Liver)", fillcolor="#66BBBB"];
        Gametocytocidal_action[label="Gametocytocidal\nAction (Stage V)", fillcolor="#66BBBB"];
        G6PD_status       [label="G6PD Enzyme\nStatus (Deficiency risk)", fillcolor="#55AAAA"];
        Oxidative_hemolysis[label="Oxidative\nHemolysis Risk", fillcolor="#448899"];
        CYP2D6_polymorphism[label="CYP2D6 Poor\nMetabolizer Genotype", fillcolor="#77CCCC"];
        Transmission_blocking_index[label="Transmission-Blocking\nEfficacy", fillcolor="#339988"];
    }

    // ─────────────────────────────────────────────────────────
    // CLUSTER 10: DRUG RESISTANCE MECHANISMS
    // ─────────────────────────────────────────────────────────
    subgraph cluster_resistance {
        label="⑩ Drug Resistance Mechanisms";
        style="filled,rounded";
        fillcolor="#FFF0FA";
        color="#AA0077";
        fontsize=11; fontcolor="#AA0077";

        K13_propeller     [label="K13 Propeller\nMutation (C580Y, R561H)", fillcolor="#EE99CC";];
        Delayed_clearance [label="Delayed Parasite\nClearance Phenotype", fillcolor="#DD77BB"];
        Ring_stage_survival[label="Ring-Stage Survival\nAssay (RSA0-3h)", fillcolor="#DD88CC"];
        PfCRT_mutation    [label="pfcrt Mutation\n(Chloroquine/AQ resistance)", fillcolor="#EE99CC"];
        PfMDR1_mutation   [label="pfmdr1 Copy Number/\nMutation (Lumefantrine)", fillcolor="#EE99CC"];
        Plasmepsin23_amp  [label="plasmepsin 2/3\nAmplification (PPQ resist.)", fillcolor="#DD77BB"];
        PfDHFR_DHPS       [label="pfdhfr/pfdhps\nMutation (SP resistance)", fillcolor="#EE99CC"];
        Partner_drug_failure[label="Partner Drug\nFailure (Recrudescence)", fillcolor="#CC5599"];
        ACT_resistance_spread[label="ACT Multidrug\nResistance Spread (GMS)", fillcolor="#BB4488"];
        Recrudescence     [label="Recrudescence\n(Day 28-42 recurrence)", fillcolor="#CC5599"];
    }

    // ─────────────────────────────────────────────────────────
    // CLUSTER 11: CLINICAL OUTCOMES & ENDPOINTS
    // ─────────────────────────────────────────────────────────
    subgraph cluster_clinical {
        label="⑪ Clinical Outcomes & Endpoints";
        style="filled,rounded";
        fillcolor="#F0F0FF";
        color="#000066";
        fontsize=11; fontcolor="#000066";

        Parasite_clearance_time[label="Parasite Clearance\nTime (PCT, hr)", fillcolor="#9999EE"];
        Parasite_clearance_halflife[label="Parasite Clearance\nHalf-Life (WWARN)", fillcolor="#8888DD"];
        Fever_clearance_time[label="Fever Clearance\nTime (FCT)", fillcolor="#7777CC"];
        Day3_positivity   [label="Day-3 Microscopy\nPositivity (WHO marker)", fillcolor="#7777CC"];
        ACPR              [label="Adequate Clinical &\nParasitological Response (Day 28/42)", fillcolor="#5555BB"];
        Treatment_failure [label="Early/Late\nTreatment Failure", fillcolor="#4444AA"];
        Severe_malaria_score[label="Severe Malaria\nCriteria (WHO 2015)", fillcolor="#5555BB"];
        Case_fatality_rate[label="Case Fatality\nRate", fillcolor="#3333AA"];
        Relapse_event     [label="P. vivax Relapse\n(Hypnozoite-derived)", fillcolor="#7777CC"];
        Onward_transmission[label="Onward Transmission\nPotential (R0 component)", fillcolor="#8888DD"];
    }

    // ─────────────────────────────────────────────────────────
    // INTRA-CLUSTER EDGES
    // ─────────────────────────────────────────────────────────

    // Cluster 1: Transmission & Liver Stage
    Anopheles_bite -> Sporozoite_inject;
    Sporozoite_inject -> Skin_transit;
    Skin_transit -> Sporozoite_blood;
    Sporozoite_blood -> Kupffer_evasion;
    Kupffer_evasion -> Hepatocyte_invasion [label="CSP-HSPG"];
    Hepatocyte_invasion -> PV_formation;
    PV_formation -> Liver_schizogony;
    Liver_schizogony -> Hypnozoite_form [label="P. vivax/ovale only", style=dashed];
    Hypnozoite_form -> Hypnozoite_reactivation [label="Weeks-years later"];
    Liver_schizogony -> Merosome_release;
    Merosome_release -> Liver_merozoites;
    Liver_schizogony -> Prepatent_period;

    // Cluster 2: Blood-Stage Cycle
    Liver_merozoites -> Merozoite_free [lhead=cluster_blood_cycle];
    Merozoite_free -> EBA_RH_invasion;
    EBA_RH_invasion -> Uninfected_RBC [label="Invades"];
    Uninfected_RBC -> Ring_stage;
    Ring_stage -> Trophozoite_stage;
    Trophozoite_stage -> Hemoglobin_digest [label="~75% Hb consumed"];
    Hemoglobin_digest -> Hemozoin_formation;
    Trophozoite_stage -> Schizont_stage;
    Schizont_stage -> Schizont_rupture;
    Schizont_rupture -> Merozoite_egress;
    Merozoite_egress -> Merozoite_free [label="New cycle"];
    Merozoite_egress -> Parasitemia;
    Parasitemia -> Multiplication_rate;
    Multiplication_rate -> Merozoite_free [label="~x10/48h", style=dashed];
    Ring_stage -> Gametocytogenesis [label="~1-2% commitment", style=dashed];
    Gametocytogenesis -> Gametocyte_stage_I_IV;
    Gametocyte_stage_I_IV -> Gametocyte_stage_V [label="8-12 days maturation"];
    Gametocyte_stage_V -> Transmission_infectivity;

    // Cluster 3: Sequestration
    Trophozoite_stage -> PfEMP1_display [lhead=cluster_sequestration];
    PfEMP1_display -> Var_gene_switch;
    Var_gene_switch -> PfEMP1_display [style=dashed, label="Clonal antigenic variation"];
    PfEMP1_display -> ICAM1_binding;
    PfEMP1_display -> CD36_binding;
    PfEMP1_display -> EPCR_binding;
    PfEMP1_display -> CSA_binding [label="Pregnancy-specific"];
    PfEMP1_display -> Rosetting;
    Rosetting -> Platelet_clumping;
    ICAM1_binding -> Microvascular_obstruction;
    EPCR_binding -> Microvascular_obstruction;
    Platelet_clumping -> Microvascular_obstruction;
    Microvascular_obstruction -> Endothelial_activation;
    Endothelial_activation -> BBB_breakdown;
    Schizont_stage -> Parasitemia [style=dashed, arrowhead=tee, label="Sequestered, not seen\non smear"];

    // Cluster 4: Innate Immunity
    Hemozoin_formation -> GPI_anchor_PAMP [lhead=cluster_innate];
    Schizont_rupture -> GPI_anchor_PAMP [label="GPI/hemozoin release"];
    GPI_anchor_PAMP -> TLR2_TLR9_sensing;
    TLR2_TLR9_sensing -> Inflammasome_NLRP3;
    Inflammasome_NLRP3 -> Monocyte_macrophage;
    Monocyte_macrophage -> TNF_alpha_mal;
    Monocyte_macrophage -> IL6_mal;
    Monocyte_macrophage -> IL1b_mal;
    Monocyte_macrophage -> IL10_mal [label="Regulatory feedback"];
    IL10_mal -> TNF_alpha_mal [style=dashed, arrowhead=tee];
    NK_cell_mal -> IFN_gamma_mal;
    gamma_delta_T -> IFN_gamma_mal;
    TLR2_TLR9_sensing -> Complement_activation;
    TNF_alpha_mal -> NO_pathway [style=dashed, arrowhead=tee];
    TNF_alpha_mal -> Fever_response;
    IL6_mal -> Fever_response;
    Schizont_rupture -> Fever_response [label="Paroxysmal, synchronous"];

    // Cluster 5: Adaptive Immunity
    IFN_gamma_mal -> Tfh_cell_mal [lhead=cluster_adaptive, style=dashed];
    Tfh_cell_mal -> MSP1_AMA1_Ab;
    Tfh_cell_mal -> PfEMP1_Ab;
    Tfh_cell_mal -> Atypical_memB [label="Chronic exposure exhaustion", style=dashed];
    Atypical_memB -> MSP1_AMA1_Ab [style=dashed, arrowhead=tee, label="Impaired recall"];
    MSP1_AMA1_Ab -> Opsonic_phagocytosis;
    PfEMP1_Ab -> Antigenic_variation [style=dashed, arrowhead=tee];
    Opsonic_phagocytosis -> Splenic_clearance;
    Splenic_clearance -> Merozoite_free [ltail=cluster_adaptive, lhead=cluster_blood_cycle, style=dashed, arrowhead=tee];
    Clinical_immunity -> Premunition [label="Repeated exposure"];
    Premunition -> Parasitemia [ltail=cluster_adaptive, lhead=cluster_blood_cycle, style=dashed, arrowhead=tee, label="Tolerates low-level"];
    Maternal_Ab_transfer -> Clinical_immunity [label="Infant <6mo protection"];

    // Cluster 6: Severe Malaria
    BBB_breakdown -> Cerebral_malaria [ltail=cluster_sequestration, lhead=cluster_severe];
    Cerebral_malaria -> Retinopathy_mal;
    Cerebral_malaria -> Raised_ICP;
    Hemolysis_mal -> Severe_anemia;
    Dyserythropoiesis -> Severe_anemia;
    TNF_alpha_mal -> Dyserythropoiesis [ltail=cluster_innate, lhead=cluster_severe, style=dashed];
    Schizont_rupture -> Hemolysis_mal [ltail=cluster_blood_cycle, lhead=cluster_severe];
    Microvascular_obstruction -> Lactic_acidosis [ltail=cluster_sequestration, lhead=cluster_severe];
    Lactic_acidosis -> Multiorgan_failure;
    Hypoglycemia_mal -> Multiorgan_failure [style=dashed];
    Microvascular_obstruction -> AKI_mal [ltail=cluster_sequestration];
    Hemolysis_mal -> AKI_mal [label="Hemoglobinuria\n(Blackwater fever)"];
    Microvascular_obstruction -> Pulmonary_edema_mal [ltail=cluster_sequestration];
    Hemozoin_formation -> Hepatic_dysfunction_mal [ltail=cluster_blood_cycle];
    Endothelial_activation -> DIC_mal [ltail=cluster_sequestration];
    CSA_binding -> Placental_malaria [ltail=cluster_sequestration];
    Cerebral_malaria -> Multiorgan_failure;
    AKI_mal -> Multiorgan_failure;
    DIC_mal -> Multiorgan_failure;

    // Cluster 7: Artemisinin PK/PD
    AS_dose -> AS_plasma [label="F~60% (oral)"];
    AS_plasma -> DHA_active [label="Rapid esterase\nhydrolysis"];
    DHA_active -> DHA_plasma;
    DHA_plasma -> UGT1A9_metabolism;
    DHA_plasma -> Heme_activation [label="Fe2+ from\ndigested Hb"];
    Hemoglobin_digest -> Heme_activation [ltail=cluster_blood_cycle, lhead=cluster_artemisinin_pk];
    Heme_activation -> Free_radical_alkylation;
    Free_radical_alkylation -> PfATP6_SERCA_target;
    PfATP6_SERCA_target -> Ring_stage_kill;
    Ring_stage_kill -> Ring_stage [ltail=cluster_artemisinin_pk, lhead=cluster_blood_cycle, style=dashed, arrowhead=tee, label="Unique ring-stage activity"];
    Ring_stage_kill -> PRR_kinetics;
    PRR_kinetics -> Parasitemia [ltail=cluster_artemisinin_pk, lhead=cluster_blood_cycle, style=dashed, arrowhead=tee];

    // Cluster 8: Partner Drug PK/PD
    Lumefantrine_dose -> Lumefantrine_central [label="High-fat meal\nF↑ 2-16x"];
    Lumefantrine_central -> Lumefantrine_peripheral;
    Lumefantrine_central -> CYP3A4_metabolism;
    Lumefantrine_central -> Trophozoite_stage [ltail=cluster_partner_pk, lhead=cluster_blood_cycle, style=dashed, arrowhead=tee, label="Kills residual\ntrophozoites/schizonts"];
    Lumefantrine_central -> Post_treatment_prophylaxis;
    Piperaquine_dose -> Piperaquine_PK;
    Piperaquine_PK -> Post_treatment_prophylaxis;
    Piperaquine_PK -> QTc_prolongation;
    Amodiaquine_dose -> Desethylamodiaquine;
    Desethylamodiaquine -> Trophozoite_stage [ltail=cluster_partner_pk, lhead=cluster_blood_cycle, style=dashed, arrowhead=tee];
    Mefloquine_PK -> QTc_prolongation;
    Post_treatment_prophylaxis -> Merozoite_free [ltail=cluster_partner_pk, lhead=cluster_blood_cycle, style=dashed, arrowhead=tee, label="Suppresses\nnew invasion"];

    // Cluster 9: Radical Cure & Transmission-Blocking
    Primaquine_dose -> Primaquine_metabolite [label="CYP2D6-dependent"];
    CYP2D6_polymorphism -> Primaquine_metabolite [style=dashed, arrowhead=tee, label="PM genotype↓ efficacy"];
    Primaquine_metabolite -> Hypnozoiticidal_action;
    Hypnozoiticidal_action -> Hypnozoite_form [ltail=cluster_radical_cure, lhead=cluster_transmission, style=dashed, arrowhead=tee, label="Radical cure"];
    Tafenoquine_dose -> Hypnozoiticidal_action;
    Primaquine_metabolite -> Gametocytocidal_action;
    Gametocytocidal_action -> Gametocyte_stage_V [ltail=cluster_radical_cure, lhead=cluster_blood_cycle, style=dashed, arrowhead=tee];
    Gametocytocidal_action -> Transmission_blocking_index;
    G6PD_status -> Oxidative_hemolysis [style=dashed];
    Primaquine_metabolite -> Oxidative_hemolysis [style=dashed, label="Deficient host"];
    Oxidative_hemolysis -> Severe_anemia [ltail=cluster_radical_cure, lhead=cluster_severe, style=dashed];

    // Cluster 10: Resistance
    K13_propeller -> Delayed_clearance;
    K13_propeller -> Ring_stage_survival;
    Ring_stage_survival -> Ring_stage_kill [ltail=cluster_resistance, lhead=cluster_artemisinin_pk, style=dashed, arrowhead=tee, label="Reduced ring susceptibility"];
    Delayed_clearance -> PRR_kinetics [ltail=cluster_resistance, lhead=cluster_artemisinin_pk, style=dashed, arrowhead=tee];
    PfCRT_mutation -> Desethylamodiaquine [ltail=cluster_resistance, lhead=cluster_partner_pk, style=dashed, arrowhead=tee];
    PfMDR1_mutation -> Lumefantrine_central [ltail=cluster_resistance, lhead=cluster_partner_pk, style=dashed, arrowhead=tee];
    Plasmepsin23_amp -> Piperaquine_PK [ltail=cluster_resistance, lhead=cluster_partner_pk, style=dashed, arrowhead=tee];
    PfDHFR_DHPS -> Partner_drug_failure [label="SP-based IPTp"];
    PfMDR1_mutation -> Partner_drug_failure;
    Plasmepsin23_amp -> Partner_drug_failure;
    Partner_drug_failure -> Recrudescence;
    Delayed_clearance -> ACT_resistance_spread;
    ACT_resistance_spread -> Partner_drug_failure [label="Selects for partner\ndrug resistance"];

    // Cluster 11: Clinical Outcomes
    Parasitemia -> Parasite_clearance_time [ltail=cluster_blood_cycle, lhead=cluster_clinical];
    Parasite_clearance_time -> Parasite_clearance_halflife;
    Delayed_clearance -> Parasite_clearance_halflife [ltail=cluster_resistance];
    Fever_response -> Fever_clearance_time [ltail=cluster_innate, lhead=cluster_clinical];
    Parasite_clearance_halflife -> Day3_positivity;
    Day3_positivity -> ACPR [style=dashed, arrowhead=tee];
    Recrudescence -> Treatment_failure [ltail=cluster_resistance, lhead=cluster_clinical];
    ACPR -> Treatment_failure [style=dashed, arrowhead=tee];
    Cerebral_malaria -> Severe_malaria_score [ltail=cluster_severe, lhead=cluster_clinical];
    Severe_anemia -> Severe_malaria_score [ltail=cluster_severe];
    AKI_mal -> Severe_malaria_score [ltail=cluster_severe];
    Multiorgan_failure -> Case_fatality_rate [ltail=cluster_severe];
    Severe_malaria_score -> Case_fatality_rate;
    Hypnozoite_reactivation -> Relapse_event [ltail=cluster_transmission, lhead=cluster_clinical];
    Transmission_infectivity -> Onward_transmission [ltail=cluster_blood_cycle, lhead=cluster_clinical];
    Transmission_blocking_index -> Onward_transmission [ltail=cluster_radical_cure, style=dashed, arrowhead=tee];
}
