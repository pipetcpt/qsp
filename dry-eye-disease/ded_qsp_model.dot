digraph DED_QSP {
  graph [rankdir=LR, fontname="Helvetica", fontsize=11, labelloc=t,
         label="Dry Eye Disease (건성안) — Integrated QSP Mechanistic Map\nTear-Film Instability · Hyperosmolar Stress · Innate/Adaptive Ocular-Surface Inflammation · Corneal Neurosensory Dysfunction · Vicious-Cycle Self-Perpetuation\nCyclosporine 0.05%/0.09% · Lifitegrast · Loteprednol · Perfluorohexyloctane · Varenicline nasal spray · Diquafosol · Punctal plugs",
         splines=spline, overlap=false, nodesep=0.28, ranksep=0.55,
         bgcolor="#fbfbfd"];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10,
         fillcolor="#ffffff", color="#7d8590"];
  edge  [fontname="Helvetica", fontsize=9, color="#6e7681", arrowsize=0.7];

  /* ───────────────────────── 1. Risk Factors / Drivers ───────────────────── */
  subgraph cluster_risk {
    label="1. Epidemiologic & Environmental Drivers";
    style="filled,rounded"; color="#5c6370"; fillcolor="#f3f0ff"; fontsize=12;
    Age         [label="Age > 50y\n(prevalence ~15-30%)"];
    FemaleSex   [label="Female sex\n(2-3× risk, postmenopausal)"];
    AndrogenDef [label="Androgen deficiency\n(menopause, anti-androgen Rx)"];
    ScreenTime  [label="Digital screen time\n(↓ blink rate 66%)"];
    LowHumidity [label="Low ambient humidity /\nA/C, wind, altitude"];
    CLWear      [label="Contact lens wear\n(chronic)"];
    RefractiveSurg [label="Refractive surgery\n(LASIK/PRK, corneal nerve transection)"];
    SystemicDrugs [label="Systemic drugs\n(antihistamines, BB, isotretinoin,\nantidepressants)"];
    Autoimmune  [label="Autoimmune disease\n(Sjögren, RA, GVHD)"];
    Blepharitis [label="Anterior blepharitis /\nDemodex"];
    VitADef     [label="Vitamin A deficiency"];
    BAK_Preservative [label="Chronic BAK-preserved\ndrop exposure (toxic)"];
    DiabetesMellitus [label="Diabetes mellitus\n(neurotrophic deficit)"];
    Age -> AndrogenDef;
    Age -> MGD_Obstruct;
    FemaleSex -> AndrogenDef;
    AndrogenDef -> MeibumViscosity;
    ScreenTime -> BlinkRate;
    LowHumidity -> EvapRate;
    CLWear -> TearFilmDisrupt;
    CLWear -> CornealNerveLoss;
    RefractiveSurg -> CornealNerveLoss;
    SystemicDrugs -> AqueousProd;
    Autoimmune -> LacrimalInfiltrate;
    Blepharitis -> MGD_Obstruct;
    VitADef -> GobletCellLoss;
    BAK_Preservative -> ApoptosisEpith [style=dashed, color="#c0392b"];
    BAK_Preservative -> GobletCellLoss [style=dashed, color="#c0392b"];
    DiabetesMellitus -> CornealNerveLoss [style=dashed];
  }

  /* ───────────────────────── 2. Tear Film Structure & Dynamics ───────────── */
  subgraph cluster_tearfilm {
    label="2. Trilaminar Tear-Film Homeostasis";
    style="filled,rounded"; color="#5c6370"; fillcolor="#fff4e6"; fontsize=12;
    LipidLayer   [label="Lipid layer\n(meibum, ~42 nm, outer)"];
    AqueousLayer [label="Aqueous layer\n(lacrimal, ~7 µm, middle)"];
    MucinLayer   [label="Mucin/glycocalyx layer\n(MUC1/4/5AC, inner)"];
    TearVolume   [label="Tear-film volume\n(~7 µL)"];
    TearTurnover [label="Tear turnover rate"];
    EvapRate     [label="Tear evaporation rate ↑"];
    BlinkRate    [label="Blink rate/completeness ↓"];
    TBUT         [label="Tear break-up time (TBUT) ↓\n(<10 s abnormal)"];
    TearFilmDisrupt [label="Tear-film instability"];
    LipidLayer -> EvapRate [style=dashed, label="↓ barrier ⇒ ↑evap", color="#c0392b"];
    BlinkRate -> LipidLayer [label="spreads meibum"];
    AqueousLayer -> TearVolume;
    MucinLayer -> TearFilmDisrupt [style=dashed, label="deficiency destabilizes"];
    TearVolume -> TearTurnover;
    EvapRate -> TearFilmDisrupt;
    TearFilmDisrupt -> TBUT;
    TBUT -> Osmolarity [label="faster break-up\n⇒ more evap"];
  }

  /* ───────────────────────── 3. Meibomian Gland Dysfunction (Evaporative) ── */
  subgraph cluster_mgd {
    label="3. Meibomian Gland Dysfunction (Evaporative DED)";
    style="filled,rounded"; color="#5c6370"; fillcolor="#eaf7ea"; fontsize=12;
    MeiboGland     [label="Meibomian gland\nacinar unit"];
    Keratinization [label="Ductal hyperkeratinization"];
    MGD_Obstruct   [label="Terminal-duct obstruction"];
    MeibumViscosity [label="Meibum viscosity ↑ /\nquality score ↓"];
    GlandDropout   [label="Gland dropout\n(meibography atrophy)"];
    MeiboGland -> Keratinization;
    Keratinization -> MGD_Obstruct;
    MGD_Obstruct -> MeibumViscosity;
    MGD_Obstruct -> GlandDropout [label="chronic stasis"];
    MeibumViscosity -> LipidLayer [style=dashed, label="↓ delivery", color="#c0392b"];
    Bacteria_Lipase [label="Lid-margin bacterial\nlipase/esterase"];
    Bacteria_Lipase -> MeibumViscosity [label="free fatty-acid\nirritant byproducts"];
  }

  /* ───────────────────────── 4. Lacrimal Gland / Aqueous-Deficient DED ───── */
  subgraph cluster_addE {
    label="4. Lacrimal Gland Dysfunction (Aqueous-Deficient DED)";
    style="filled,rounded"; color="#5c6370"; fillcolor="#fdeef0"; fontsize=12;
    LacrimalGland    [label="Lacrimal gland\nacinar/ductal unit"];
    LacrimalInfiltrate [label="Focal lymphocytic\ninfiltrate (Sjögren)"];
    AcinarApoptosis  [label="Acinar cell apoptosis\n(Fas/FasL)"];
    AqueousProd      [label="Aqueous tear\nproduction ↓"];
    NeuralReflexArc  [label="Trigeminal-parasympathetic\nlacrimal reflex arc"];
    ReflexImpair     [label="Reflex secretion\nimpairment"];
    LacrimalGland -> AqueousProd;
    SjogrenSubtype   [label="Primary vs secondary\nSjögren subtype"];
    SjogrenSubtype -> LacrimalInfiltrate;
    LacrimalInfiltrate -> AcinarApoptosis;
    AcinarApoptosis -> AqueousProd;
    AqueousProd -> AqueousLayer;
    NeuralReflexArc -> AqueousProd [label="afferent→efferent\ncholinergic drive"];
    CornealNerveLoss -> ReflexImpair [style=dashed];
    ReflexImpair -> AqueousProd [style=dashed, color="#c0392b"];
  }

  /* ───────────────────────── 5. Hyperosmolar Stress Signaling ────────────── */
  subgraph cluster_hyperosm {
    label="5. Hyperosmolar Stress → Epithelial Signaling";
    style="filled,rounded"; color="#5c6370"; fillcolor="#fff0f0"; fontsize=12;
    Osmolarity     [label="Tear-film osmolarity ↑\n(>308 mOsm/L, inter-eye Δ>8)"];
    MAPK_Signal    [label="MAPK (p38/JNK/ERK)\nactivation"];
    NFkB_Signal    [label="NF-κB\nnuclear translocation"];
    NLRP3_Inflammasome [label="NLRP3 inflammasome\nassembly"];
    ROS_Ocular     [label="Reactive oxygen species\n(ROS) generation"];
    CellShrinkage  [label="Epithelial cell\nshrinkage/volume loss"];
    Osmolarity -> CellShrinkage;
    CellShrinkage -> MAPK_Signal;
    Osmolarity -> MAPK_Signal;
    MAPK_Signal -> NFkB_Signal;
    MAPK_Signal -> ROS_Ocular;
    ROS_Ocular -> NLRP3_Inflammasome;
    NFkB_Signal -> NLRP3_Inflammasome;
  }

  /* ───────────────────────── 6. Innate Immune / Inflammatory Cascade ─────── */
  subgraph cluster_innate {
    label="6. Innate Inflammatory Cascade";
    style="filled,rounded"; color="#5c6370"; fillcolor="#e8f0fe"; fontsize=12;
    IL1beta   [label="IL-1β release\n(caspase-1 cleaved)"];
    TNFalpha  [label="TNF-α"];
    IL6       [label="IL-6"];
    IL8       [label="IL-8/CXCL8\n(neutrophil chemoattractant)"];
    NeutrophilRecruit [label="Neutrophil\nrecruitment"];
    MMP9      [label="MMP-9\n(matrix metalloproteinase-9) ↑"];
    TightJunctionLoss [label="Tight-junction protein\n(ZO-1/occludin) degradation"];
    DC_Activation [label="Corneal/conjunctival\ndendritic-cell activation"];
    NLRP3_Inflammasome -> IL1beta;
    NFkB_Signal -> TNFalpha;
    NFkB_Signal -> IL6;
    NFkB_Signal -> IL8;
    NFkB_Signal -> MMP9;
    IL1beta -> MMP9 [label="amplifies"];
    TNFalpha -> MMP9;
    MMP9 -> TightJunctionLoss;
    TightJunctionLoss -> BarrierDysfunction;
    IL1beta -> DC_Activation;
    TNFalpha -> DC_Activation;
    IL8 -> NeutrophilRecruit;
    NeutrophilRecruit -> MMP9 [label="degranulation"];
  }

  /* ───────────────────────── 7. Adaptive Immunity / Vicious Cycle ────────── */
  subgraph cluster_adaptive {
    label="7. Adaptive Immunity — Self-Perpetuating Vicious Cycle";
    style="filled,rounded"; color="#5c6370"; fillcolor="#f0eafc"; fontsize=12;
    DC_Maturation  [label="DC maturation &\nmigration to draining LN"];
    LN_Priming     [label="Cervical lymph-node\nnaive CD4+ T-cell priming"];
    Th17_Diff      [label="Th17 differentiation\n(IL-6/TGF-β/IL-23 driven)"];
    Th1_Diff       [label="Th1 differentiation\n(IFN-γ)"];
    Treg_Suppression [label="Treg function\nsuppressed/impaired"];
    IL17A          [label="IL-17A\n(effector cytokine)"];
    IFNgamma       [label="IFN-γ"];
    HomingOcular   [label="CCR6+ effector T-cell\nhoming back to ocular surface"];
    ChronicInflamm [label="Chronic self-sustaining\nocular-surface inflammation"];
    MemoryTcell    [label="Resident memory\nT-cell persistence"];
    DC_Activation -> DC_Maturation;
    DC_Maturation -> LN_Priming;
    LN_Priming -> Th17_Diff;
    LN_Priming -> Th1_Diff;
    LN_Priming -> Treg_Suppression [style=dashed];
    Th17_Diff -> IL17A;
    Th1_Diff -> IFNgamma;
    IL17A -> HomingOcular;
    IFNgamma -> HomingOcular;
    HomingOcular -> ChronicInflamm;
    ChronicInflamm -> MMP9 [label="feed-forward", color="#c0392b"];
    IL17A -> GobletCellLoss [color="#c0392b"];
    IFNgamma -> GobletCellLoss [color="#c0392b"];
    ChronicInflamm -> Osmolarity [style=dashed, label="perpetuates\ninstability", color="#c0392b"];
    ChronicInflamm -> MemoryTcell;
    MemoryTcell -> HomingOcular [style=dashed, label="rapid\nrecall response"];
  }

  /* ───────────────────────── 8. Corneal Nerve / Neurosensory ─────────────── */
  subgraph cluster_neuro {
    label="8. Corneal Neurosensory Dysfunction";
    style="filled,rounded"; color="#5c6370"; fillcolor="#e6f7f5"; fontsize=12;
    TRPM8_ColdRc  [label="TRPM8 cold\nthermoreceptors"];
    Polymodal_Noci [label="Polymodal\nnociceptors"];
    CornealNerveDensity [label="Sub-basal corneal\nnerve-fiber density ↓"];
    CornealNerveLoss [label="Corneal nerve\ndamage/dysfunction"];
    NerveRegenAbnormal [label="Aberrant nerve\nregeneration/sprouting"];
    PeripheralSensitization [label="Peripheral\nsensitization"];
    CentralSensitization [label="Central (trigeminal\nbrainstem) sensitization"];
    NeuropathicPain [label="Neuropathic ocular\npain / dysesthesia"];
    Photophobia    [label="Photophobia"];
    Osmolarity -> TRPM8_ColdRc [label="cooling-rate\nsignal ↑"];
    Polymodal_Noci -> PeripheralSensitization;
    ChronicInflamm -> Polymodal_Noci [label="mediator\nsensitization"];
    CornealNerveLoss -> CornealNerveDensity;
    CornealNerveDensity -> NerveRegenAbnormal [style=dashed];
    NerveRegenAbnormal -> PeripheralSensitization;
    PeripheralSensitization -> CentralSensitization;
    CentralSensitization -> NeuropathicPain;
    TRPM8_ColdRc -> BlinkRate [label="reflex blink\ndrive"];
    TRPM8_ColdRc -> NeuralReflexArc [label="afferent"];
    CentralSensitization -> Photophobia;
  }

  /* ───────────────────────── 9. Epithelial Damage / Barrier ──────────────── */
  subgraph cluster_epithelium {
    label="9. Ocular-Surface Epithelial Damage";
    style="filled,rounded"; color="#5c6370"; fillcolor="#fef6e0"; fontsize=12;
    GobletCellLoss  [label="Conjunctival goblet-cell\ndensity ↓ (MUC5AC ↓)"];
    SquamousMetaplasia [label="Squamous metaplasia"];
    ApoptosisEpith  [label="Epithelial apoptosis\n(Fas/FasL, caspase-3)"];
    BarrierDysfunction [label="Epithelial barrier\ndysfunction"];
    CornealStainingBio [label="Corneal fluorescein\nuptake (biological)"];
    ConjStainingBio [label="Conjunctival lissamine-green\nuptake (biological)"];
    FilamentaryKeratitis [label="Filamentary keratitis\n(severe complication)"];
    VisualFluctuation [label="Functional visual\nacuity fluctuation"];
    CellShrinkage -> ApoptosisEpith;
    ChronicInflamm -> ApoptosisEpith;
    ApoptosisEpith -> BarrierDysfunction;
    BarrierDysfunction -> CornealStainingBio;
    BarrierDysfunction -> ConjStainingBio;
    GobletCellLoss -> SquamousMetaplasia;
    GobletCellLoss -> MucinLayer [style=dashed, color="#c0392b"];
    SquamousMetaplasia -> BarrierDysfunction;
    BarrierDysfunction -> FilamentaryKeratitis [style=dashed];
    TearFilmDisrupt -> VisualFluctuation;
  }

  /* ───────────────────────── 10. Drug PK/PD ──────────────────────────────── */
  subgraph cluster_drugpk {
    label="10. Topical & Systemic Drug PK/PD";
    style="filled,rounded"; color="#5c6370"; fillcolor="#eef2ff"; fontsize=12;
    CsA_Dose       [label="Cyclosporine A\n0.05%/0.09% BID (topical)"];
    CsA_OcularConc [label="Ocular-surface/\nlacrimal-gland CsA conc."];
    CsA_Calcineurin [label="Calcineurin inhibition\n⊣ NFAT"];
    Lifitegrast_Dose [label="Lifitegrast 5% BID\n(topical)"];
    Lifitegrast_LFA1 [label="LFA-1/ICAM-1\nbinding blockade"];
    Loteprednol_Dose [label="Loteprednol 0.25%\n(short-course pulse)"];
    Loteprednol_GR   [label="Glucocorticoid-receptor\nNF-κB/AP-1 transrepression"];
    PFHO_Dose      [label="Perfluorohexyloctane\n(semifluorinated alkane, QID)"];
    PFHO_Film      [label="Monolayer film ⊣\nevaporation"];
    Varenicline_Dose [label="Varenicline nasal\nspray (Tyrvaya)"];
    Varenicline_TrigeminalNic [label="Nasal trigeminal\nnicotinic-receptor agonism"];
    Diquafosol_Dose [label="Diquafosol 3%\n(P2Y2 agonist, topical)"];
    Diquafosol_P2Y2 [label="P2Y2-mediated mucin +\naqueous secretagogue effect"];
    PunctalPlug    [label="Punctal occlusion\n(silicone/collagen plug)"];
    AutoSerumTears [label="Autologous serum\ntears (growth factors)"];
    OmegaFA        [label="Oral omega-3\nfatty acid supplementation"];
    ThermalPulsation [label="Thermal pulsation /\nIPL device therapy"];

    CsA_Dose -> CsA_OcularConc;
    CsA_OcularConc -> CsA_Calcineurin;
    CsA_Calcineurin -> Th17_Diff [color="#1a7a3c", label="⊣ IL-2/NFAT"];
    CsA_Calcineurin -> DC_Maturation [style=dashed, color="#1a7a3c"];

    Lifitegrast_Dose -> Lifitegrast_LFA1;
    Lifitegrast_LFA1 -> HomingOcular [color="#1a7a3c", label="⊣ T-cell\nadhesion/homing"];
    Lifitegrast_LFA1 -> DC_Maturation [style=dashed, color="#1a7a3c"];

    Loteprednol_Dose -> Loteprednol_GR;
    Loteprednol_GR -> NFkB_Signal [color="#1a7a3c", label="⊣ transrepression"];
    Loteprednol_GR -> IL6 [style=dashed, color="#1a7a3c"];

    PFHO_Dose -> PFHO_Film;
    PFHO_Film -> EvapRate [color="#1a7a3c", label="⊣ evaporation"];

    Varenicline_Dose -> Varenicline_TrigeminalNic;
    Varenicline_TrigeminalNic -> NeuralReflexArc [color="#1a7a3c", label="stimulates\nreflex tearing"];

    Diquafosol_Dose -> Diquafosol_P2Y2;
    Diquafosol_P2Y2 -> MucinLayer [color="#1a7a3c"];
    Diquafosol_P2Y2 -> AqueousProd [style=dashed, color="#1a7a3c"];

    PunctalPlug -> TearTurnover [color="#1a7a3c", label="⊣ drainage"];
    PunctalPlug -> TearVolume [color="#1a7a3c"];

    AutoSerumTears -> ApoptosisEpith [style=dashed, color="#1a7a3c", label="⊣"];
    AutoSerumTears -> CornealNerveDensity [style=dashed, color="#1a7a3c", label="trophic\nsupport"];

    OmegaFA -> MeibumViscosity [style=dashed, color="#1a7a3c", label="⊣ (anti-inflammatory)"];
    ThermalPulsation -> MGD_Obstruct [color="#1a7a3c", label="liquefies\nmeibum"];
  }

  /* ───────────────────────── 11. Clinical Endpoints ───────────────────────── */
  subgraph cluster_clin {
    label="11. Clinical Endpoints & Biomarkers";
    style="filled,rounded"; color="#5c6370"; fillcolor="#f5f5f5"; fontsize=12;
    OSDI        [label="OSDI symptom score\n(0-100)"];
    EyeDrynessScore [label="Eye Dryness Score\n(VAS 0-100)"];
    TBUT_Clin   [label="Clinical TBUT (s)"];
    Schirmer    [label="Schirmer I test (mm/5min)"];
    CornealStainScore [label="Corneal fluorescein\nstaining score (NEI, 0-15)"];
    ConjStainScore [label="Conjunctival lissamine-\ngreen score (0-6)"];
    OsmolarityTest [label="Point-of-care tear\nosmolarity (mOsm/L)"];
    MMP9_POC    [label="Point-of-care MMP-9\nimmunoassay (+/-)"];
    MeibographyScore [label="Meibography gland-\ndropout grade"];
    NEI_VFQ     [label="NEI-VFQ-25 quality-\nof-life score"];

    TBUT -> TBUT_Clin;
    Osmolarity -> OsmolarityTest;
    AqueousProd -> Schirmer;
    CornealStainingBio -> CornealStainScore;
    ConjStainingBio -> ConjStainScore;
    MMP9 -> MMP9_POC;
    GlandDropout -> MeibographyScore;
    NeuropathicPain -> OSDI [color="#c0392b"];
    BarrierDysfunction -> OSDI [color="#c0392b"];
    TearFilmDisrupt -> OSDI [color="#c0392b"];
    NeuropathicPain -> EyeDrynessScore [color="#c0392b"];
    OSDI -> EyeDrynessScore [style=dashed];
    VisualFluctuation -> NEI_VFQ [color="#c0392b"];
    OSDI -> NEI_VFQ [style=dashed];
  }
}
