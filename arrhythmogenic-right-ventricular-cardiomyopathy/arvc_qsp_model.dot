// ============================================================================
//  Arrhythmogenic Right Ventricular Cardiomyopathy (ARVC / arrhythmogenic
//  cardiomyopathy) — Mechanistic QSP Map
//  ---------------------------------------------------------------------------
//  Render:  dot -Tsvg arvc_qsp_model.dot -o arvc_qsp_model.svg
//           dot -Tpng -Gdpi=150 arvc_qsp_model.dot -o arvc_qsp_model.png
//
//  Companion files
//    arvc_mrgsolve_model.R      the same structure as 54 ODEs
//    arvc_reference_impl.py     dependency-free numerical twin (--check)
//    arvc_references.md         every claim below, with PubMed links
//
//  ---------------------------------------------------------------------------
//  WHAT THIS MAP IS ARGUING
//  ---------------------------------------------------------------------------
//  ARVC is usually drawn as a linear cascade: desmosomal variant -> junction
//  failure -> myocyte death -> fibrofatty replacement -> arrhythmia.  That
//  drawing is not wrong, but it cannot survive contact with five facts:
//
//   (A) PKP2 truncating variants are far commoner in the population than ARVC
//       is; most carriers of ARVC-gene loss-of-function variants in an
//       unselected biobank have no phenotype at all.  A linear cascade from
//       genotype predicts complete penetrance.
//       [Carruth 2019 PMID 31638835; Groeneweg 2015 PMID 25820315]
//   (B) Exercise dose is graded and large: desmosomal carriers in the highest
//       exercise tertile reached the phenotype far younger, with about a
//       3-fold hazard of VT/death.  [James 2013 PMID 23871885;
//       Ruwald 2015 PMID 25896080]
//   (C) The same phenotype occurs in athletes with NO desmosomal variant, and
//       those patients had done MORE exercise than the gene-positive ones.
//       [Sawant 2014 PMID 25516436]
//   (D) The right ventricle goes first, although PKP2 is expressed equally in
//       both ventricles.  Left dominance is a DSP/FLNC phenomenon.
//       [Corrado 2024 PMID 37844667; Brandao 2023 PMID 37048743]
//   (E) The therapy hierarchy is upside down for a single-cascade disease:
//       sotalol came out no better than nothing, flecainide (a class IC drug,
//       in a structural cardiomyopathy) reduces VT as an add-on, endocardial
//       ablation recurs where endo-epicardial ablation does not, and the ICD
//       — which touches no part of the cascade — is the only therapy with an
//       unambiguous mortality benefit.
//       [Marcus 2009 PMID 19660690; Ermakov 2017 PMID 27939893;
//        Santangeli 2015 PMID 26546346; Berruezo 2012 PMID 22205683]
//
//  So the map is built around three structural commitments instead.
//
//  ---------------------------------------------------------------------------
//  COMMITMENT 1 — THE CLOCK IS CUMULATIVE MECHANICAL WORK, NOT TIME
//       (clusters 3 and 4, the violet/red spine down the left)
//  ---------------------------------------------------------------------------
//  A desmosomal variant does not destroy myocardium.  It lowers the load at
//  which the intercalated disc fails.  Myocyte loss is therefore drawn as a
//  FATIGUE-FAILURE process — rate = beats x (wall stress / reserve)^4 — and
//  genotype enters ONLY through the reserve term.  Age is not a variable in
//  the model at all; it appears only as the integral of load.
//
//  The loop marked "AUTOCATALYSIS" is the reason ARVC has a concealed phase
//  followed by rapid overt progression with no phase-transition parameter in
//  the model: wall stress depends on wall thickness, wall thickness depends on
//  how much myocardium is left, so every myocyte lost raises the price of the
//  next beat.
//
//  This commitment has a clean experimental test it was NOT fitted to: in
//  plakoglobin-deficient mice, LOAD-REDUCING THERAPY (furosemide + nitrate) —
//  a regimen with no desmosomal, ion-channel or anti-fibrotic action whatever
//  — prevented RV enlargement, preserved conduction and prevented the
//  arrhythmic phenotype.  [Fabritz 2011 PMID 21292134;
//  Kirchhof 2006 PMID 17030684]  It enters the map at node LOADRED.
//
//  ---------------------------------------------------------------------------
//  COMMITMENT 2 — RV SELECTIVITY IS LAPLACE, NOT BIOLOGY
//       (cluster 3, nodes SIG_RV / SIG_LV and the K_EX edges)
//  ---------------------------------------------------------------------------
//  No chamber-specific gene expression is used for PKP2 disease.  Two
//  measured asymmetries do the work: the RV free wall is ~4 mm against the
//  LV's ~9 mm, and during maximal exercise RV end-systolic wall stress rises
//  about 125% while the LV rises about 14%, because pulmonary vascular
//  resistance falls far less than systemic.  [La Gerche 2011 PMID 21085033;
//  La Gerche 2012 PMID 22160404; La Gerche 2017 PMID 28957535]
//  Raised to the fourth power that 125%-vs-14% gap becomes roughly fifteen-
//  fold per exercising beat.  The RV therefore goes first, and — a prediction,
//  not an input — the RV/LV gap WIDENS with training.  Left dominance needs
//  the separate, genotype-specific edge KAPPA_LV, drawn dashed, which is
//  switched on only for DSP and FLNC.
//
//  ---------------------------------------------------------------------------
//  COMMITMENT 3 — TWO ARRHYTHMIA GENERATORS, AND A DRUG CANNOT OUTPERFORM
//       THE GENERATOR IT OCCUPIES  (clusters 9, 10 and 17)
//  ---------------------------------------------------------------------------
//  GENERATOR I  (cluster 9, blue): early, catecholaminergic, and completely
//    independent of structure.  PKP2 loss strips Nav1.5 and Cx43 from the
//    intercalated disc and destabilises RyR2, so diastolic Ca leak and
//    triggered activity exist in a structurally normal heart.  This is the
//    concealed-phase arrhythmia, and it is why young carriers die during
//    exertion with a normal echocardiogram.
//    [Sato 2009 PMID 19661460; Cerrone 2014 PMID 24352520;
//     van Opbergen 2019 PMID 31438494]
//    Occupied by: beta-blockade, flecainide (RyR2 open-state block), and
//    exercise restriction (which removes the catecholamine surges as well as
//    the load).
//  GENERATOR II (cluster 10, brown): late, re-entrant, scar-dependent.
//    Maximal when viable myocardium and fibrofatty replacement interdigitate
//    about 50/50 — a homogeneous scar has no conducting channels and neither
//    does normal myocardium, which is exactly the principle ablation
//    exploits.  Subepicardial before endocardial, which is why endocardial-
//    only mapping under-reads the substrate.
//    [Tschabrunn 2022 PMID 34883271; Berruezo 2012 PMID 22205683]
//    Occupied by: epicardial ablation and amiodarone; NOT by beta-blockade.
//
//  Two consequences are drawn explicitly because they are the map's most
//  falsifiable claims:
//    * FLECAINIDE HAS TWO SIGNS.  It removes Generator I (RyR2 block) and it
//      slows conduction (Nav1.5 block), which FEEDS Generator II.  Its sign
//      therefore depends on where the patient sits on the trajectory — the
//      CAST lesson arriving from geometry rather than from a warning label.
//    * THE ICD IS ATTACHED TO THE OUTCOME, NOT TO EITHER GENERATOR.  That is
//      simultaneously why it is the only unambiguous mortality therapy and
//      why it cannot substitute for anything upstream of it.
//
//  ---------------------------------------------------------------------------
//  COLOUR KEY
//    Grey        genotype / desmosomal and non-desmosomal genes
//    Violet      the mechanical clock (load, wall stress, fatigue dose)
//    Red         myocyte injury and death
//    Orange-red  innate immunity / the hot phase
//    Tan         fibrogenesis
//    Yellow      adipogenesis and its Wnt/Hippo switch
//    Blue        GENERATOR I — Ca handling and triggered activity
//    Brown       GENERATOR II — conduction, scar re-entry
//    Teal        chamber mechanics and neurohormonal
//    Light green diagnostics: ECG, imaging, Task Force Criteria
//    Orange      drugs and interventions
//    Pink        devices and procedures
//    Dark green  clinical endpoints
//
//  Edge convention:  solid = activation/flux;  dashed red = inhibition;
//  bold violet = the fatigue clock;  dotted = a switch that is off unless the
//  genotype or scenario turns it on.
//
//  DISCLAIMER: educational / research QSP model.  Semi-quantitative, not
//  independently validated, NOT for clinical decision-making.
// ============================================================================

digraph ARVC_QSP {
    rankdir = TB;
    compound = true;
    newrank = true;
    splines = spline;
    concentrate = false;
    nodesep = 0.24;
    ranksep = 0.52;
    fontname = "Helvetica";
    labelloc = "t";
    label = <<B>Arrhythmogenic Right Ventricular Cardiomyopathy — Mechanistic QSP Map</B><BR/>
<FONT POINT-SIZE="13">The clock is cumulative mechanical work, not time · RV selectivity is Laplace, not biology · two arrhythmia generators on different clocks</FONT><BR/>
<FONT POINT-SIZE="11">54-ODE companion model: arvc_mrgsolve_model.R · numerical twin: arvc_reference_impl.py --check · references: arvc_references.md</FONT>>;
    fontsize = 22;

    node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10,
          margin="0.09,0.05", penwidth=1.1];
    edge [fontname="Helvetica", fontsize=8, arrowsize=0.65, color="#555555"];

    // =======================================================================
    //  CLUSTER 1 — GENOTYPE
    // =======================================================================
    subgraph cluster_geno {
        label = "1. GENOTYPE — desmosomal and non-desmosomal substrates\n(the variant sets the PRICE per unit load, not the amount of damage)";
        style = "filled,rounded"; fillcolor = "#f2f2f2"; color = "#9e9e9e";
        fontsize = 12; fontname = "Helvetica-Bold";
        node [fillcolor = "#e0e0e0", color = "#757575"];

        PKP2  [label="PKP2\nplakophilin-2\n~40-60% of ARVC\ntruncating >> missense", fillcolor="#bdbdbd", penwidth=2.0];
        DSP   [label="DSP\ndesmoplakin\nleft-dominant, episodic\nmyocardial injury"];
        DSG2  [label="DSG2\ndesmoglein-2\nbiventricular"];
        DSC2  [label="DSC2\ndesmocollin-2"];
        JUP   [label="JUP\nplakoglobin (γ-catenin)\nNaxos disease (recessive)"];
        FLNC  [label="FLNC\nfilamin-C truncating\nleft-dominant + LGE ring"];
        TMEM43 [label="TMEM43 p.S358L\nfully penetrant, male-lethal\nfounder variant"];
        PLN   [label="PLN p.Arg14del\nSERCA regulation\nlow-voltage ECG"];
        DES   [label="DES\ndesmin\nconduction disease"];
        CTNNA3 [label="CTNNA3\nαT-catenin"];
        GENE_ELUSIVE [label="GENE-ELUSIVE\nno variant found\n~40-50% of probands\nHIGHEST exercise dose", fillcolor="#ffe0b2", color="#e65100", penwidth=1.8];
        PHENOCOPY [label="phenocopies\ncardiac sarcoidosis · myocarditis\nCPVT (RYR2) · LMNA · Chagas\nidiopathic RVOT VT", fillcolor="#eceff1"];

        DESMO_RESERVE [label="DESMOSOMAL RESERVE\nload at which the intercalated\ndisc fails\n(the ONLY route from genotype\ninto this model)", shape=octagon, fillcolor="#9e9e9e", fontcolor="white", penwidth=2.2];
    }

    // =======================================================================
    //  CLUSTER 2 — THE INTERCALATED DISC / CONNEXOME
    // =======================================================================
    subgraph cluster_id {
        label = "2. THE INTERCALATED DISC AS ONE ORGANELLE (the 'connexome')\nmechanical, electrical and signalling functions share the same protein complex";
        style = "filled,rounded"; fillcolor = "#eceff1"; color = "#607d8b";
        fontsize = 12; fontname = "Helvetica-Bold";
        node [fillcolor = "#cfd8dc", color = "#546e7a"];

        AREA_COMP [label="area composita\ndesmosome + adherens junction\nfused, cardiac-specific"];
        DSM [label="desmosome core\nDSG2·DSC2–PKP2–DSP\n–desmin IF anchor"];
        ADH [label="adherens junction\nN-cadherin–αT/β-catenin\n–actin"];
        GJ [label="gap junction plaque\nCx43 (GJA1)"];
        NAV_CPLX [label="Nav1.5 complex\nSCN5A–ankyrin-G–PKP2\nat the ID crest"];
        KIR [label="Kir2.1 / SK3\nID-localised K+ channels"];
        MECH_COUPL [label="mechanical continuity\nmyocyte-to-myocyte\nforce transmission", fillcolor="#b0bec5", penwidth=1.6];

        PKP2_ID [label="PKP2 protein AT THE DISC\n(state variable PKP2_ID)\nhaploinsufficiency ≈ 0.5", shape=ellipse, fillcolor="#90a4ae", penwidth=1.8];
        PG_NUC [label="nuclear plakoglobin\n(γ-catenin translocation)\nthe diagnostic 'signal loss'", shape=ellipse, fillcolor="#b39ddb", color="#5e35b1"];
        NAV_ID [label="Nav1.5 AT THE DISC\nINa ↓ ~30% in PKP2-het", shape=ellipse, fillcolor="#90caf9", color="#1565c0"];
        CX43_ID [label="Cx43 AT THE DISC\ncoupling ↓, lateralisation", shape=ellipse, fillcolor="#a5d6a7", color="#2e7d32"];
    }

    // =======================================================================
    //  CLUSTER 3 — THE MECHANICAL CLOCK  (COMMITMENT 1 + 2)
    // =======================================================================
    subgraph cluster_load {
        label = "3. THE MECHANICAL CLOCK — COMMITMENTS 1 AND 2\nage is not a variable: it is the integral of load. RV selectivity is Laplace + the exercise stress asymmetry";
        style = "filled,rounded"; fillcolor = "#f3e5f5"; color = "#6a1b9a";
        fontsize = 12; fontname = "Helvetica-Bold";
        node [fillcolor = "#e1bee7", color = "#6a1b9a"];

        EX_DOSE [label="EXERCISE DOSE\nMET-hours / week\nsedentary 6 · guideline 15\ncompetitive 60 · elite 100", shape=octagon, fillcolor="#ce93d8", penwidth=2.2];
        DUTY [label="duty cycle f_ex\nfraction of the week at\nvigorous intensity"];
        HR_BEATS [label="beat count\n62 bpm rest → 158 bpm exercise\n(the fatigue CYCLE count)"];
        PRELOAD [label="venous return / preload\nRV filling ↑ 2-3× at max output"];
        PVR [label="pulmonary vascular resistance\nfalls only modestly\n(the RV's Achilles heel)"];
        PAP [label="pulmonary artery pressure\nmPAP 14 → 35-40 mmHg\nat maximal exercise"];
        SVR [label="systemic vascular resistance\nfalls steeply\n→ LV afterload barely rises"];

        H_RV [label="RV free-wall thickness\n~4 mm (load-bearing:\nmyocyte + 0.7·fibrous + 0.35·fat)"];
        H_LV [label="LV wall thickness\n~9 mm"];
        R_RV [label="RV chamber radius\n∝ RVEDV^(1/3)"];
        R_LV [label="LV chamber radius"];

        SIG_RV [label="RV WALL STRESS  σ_RV\nσ = P·r / 2h  (Laplace)\nEXERCISE: +125%", shape=ellipse, fillcolor="#ba68c8", fontcolor="white", penwidth=2.2];
        SIG_LV [label="LV WALL STRESS  σ_LV\nEXERCISE: +14%", shape=ellipse, fillcolor="#d1c4e9", penwidth=1.6];

        FATIGUE_RV [label="RV FATIGUE DOSE RATE\nbeats × (σ_RV)^NMECH\nNMECH = 4, fixed a priori\n(Basquin exponent range)", shape=doubleoctagon, fillcolor="#8e24aa", fontcolor="white", penwidth=2.6];
        FATIGUE_LV [label="LV FATIGUE DOSE RATE\nbeats × (σ_LV)^4 × KAPPA_LV", shape=octagon, fillcolor="#b39ddb", penwidth=1.8];
        D_RV [label="cumulative RV dose  D_RV\n(load-years)", shape=ellipse, fillcolor="#ce93d8"];
        D_LV [label="cumulative LV dose  D_LV", shape=ellipse, fillcolor="#e1bee7"];
        KAPPA_LV [label="KAPPA_LV\nLV-intrinsic vulnerability\nON only for DSP / FLNC\n(the only chamber-specific term\nin the whole model)", shape=hexagon, fillcolor="#fff9c4", color="#f9a825", penwidth=1.8];
        PHI_EX [label="PHI_EX — THE FALSIFIER\nset to 0 and damage becomes\nload-INDEPENDENT: the model\nturns into a calendar clock\nand (A)–(D) all invert", shape=hexagon, fillcolor="#ffcdd2", color="#b71c1c", penwidth=2.2];
    }

    // =======================================================================
    //  CLUSTER 4 — FATIGUE FAILURE AND MYOCYTE DEATH
    // =======================================================================
    subgraph cluster_death {
        label = "4. FATIGUE FAILURE OF THE DISC → MYOCYTE DEATH\nrate = beats × (stress/reserve)^4 · the AUTOCATALYSIS loop needs no phase-transition parameter";
        style = "filled,rounded"; fillcolor = "#ffebee"; color = "#c62828";
        fontsize = 12; fontname = "Helvetica-Bold";
        node [fillcolor = "#ffcdd2", color = "#c62828"];

        ID_STRAIN [label="strain concentrated at the disc\n(desmosome bears the peak load)"];
        ID_RUPTURE [label="intercalated disc failure\ngap widening · desmosome\ndissolution on EM", penwidth=1.7];
        MYO_DETACH [label="myocyte detachment\nfrom its neighbours"];
        MYO_STRETCH [label="unopposed stretch of the\nsurviving myocytes\n(load transferred, not removed)"];
        APOPT [label="apoptosis\ncaspase-3 activation"];
        NECROP [label="necrosis / necroptosis\nRIPK3 · membrane rupture"];
        MYO_LOSS [label="MYOCYTE LOSS\nstate variable MYO_RV\n(irreversible: no meaningful\nadult regeneration)", shape=ellipse, fillcolor="#ef5350", fontcolor="white", penwidth=2.2];
        NEC_POOL [label="acutely injured pool\nNEC_RV — the DAMP source", shape=ellipse, fillcolor="#e57373"];
        TNI_REL [label="troponin release\n(episodic, without\ncoronary disease)"];
        WALL_THIN [label="wall thinning\n→ σ rises for the same pressure", penwidth=1.7];
        ANEURYSM [label="regional aneurysm\nsubtricuspid · apex · infundibulum\n('triangle of dysplasia')"];
        MYO_FLOOR [label="REGIONAL SPARING (MYO_FLOOR)\nthis is a lumped free-wall model but\nthe disease is regional: subtricuspid\nwall, apex and infundibulum carry the\nhighest local stress and go first,\nwhile septum-adjacent and outflow\nmyocardium stays subcritical\n→ the lumped average cannot reach 0,\nand this is what caps the runaway\nwithout a phase-transition parameter",
                   shape=hexagon, fillcolor="#fff3e0", color="#bf360c", penwidth=1.8];
        AUTOCAT [label="AUTOCATALYSIS\nmyocyte loss → thinner wall →\nhigher σ → faster loss\n= concealed phase, then\nrapid overt progression", shape=doubleoctagon, fillcolor="#b71c1c", fontcolor="white", penwidth=2.4];
    }

    // =======================================================================
    //  CLUSTER 5 — Wnt / plakoglobin
    // =======================================================================
    subgraph cluster_wnt {
        label = "5. CANONICAL Wnt / β-CATENIN — the adipogenic brake being released";
        style = "filled,rounded"; fillcolor = "#ede7f6"; color = "#4527a0";
        fontsize = 12; fontname = "Helvetica-Bold";
        node [fillcolor = "#d1c4e9", color = "#4527a0"];

        PG_COMPETE [label="nuclear plakoglobin competes\nβ-catenin off TCF/LEF"];
        GSK3B [label="GSK-3β\nphosphorylates β-catenin\n→ degradation", penwidth=1.6];
        BCAT [label="β-catenin nuclear pool ↓"];
        WNT_ACT [label="canonical Wnt activity ↓\n(state variable WNT_ACT)\nthe brake on adipogenesis", shape=ellipse, fillcolor="#b39ddb", penwidth=1.8];
        TCF_TARGETS [label="TCF/LEF targets ↓\nc-Myc · cyclin D1 · Axin2"];
    }

    // =======================================================================
    //  CLUSTER 6 — Hippo / YAP and adipogenesis
    // =======================================================================
    subgraph cluster_adipo {
        label = "6. HIPPO/YAP AND ADIPOGENESIS — why the replacement tissue is FAT\nboth switches must be thrown: Wnt suppressed AND Hippo activated";
        style = "filled,rounded"; fillcolor = "#fffde7"; color = "#f9a825";
        fontsize = 12; fontname = "Helvetica-Bold";
        node [fillcolor = "#fff9c4", color = "#f9a825"];

        NF2_MST [label="NF2 / MST1 / LATS1-2\nHippo kinase cascade"];
        HIPPO_ACT [label="Hippo pathway ACTIVE\n(state variable HIPPO)\ndriven by junction loss AND\nby mechanical load", shape=ellipse, fillcolor="#ffe082", penwidth=1.8];
        YAP_SEQ [label="YAP phosphorylated,\nsequestered in cytoplasm\n(14-3-3 binding)"];
        PPARG [label="PPARγ ↑"];
        CEBPA [label="C/EBPα ↑"];
        ADIPOQ [label="adiponectin · perilipin\nadipocyte gene programme"];
        FAP [label="fibro-adipogenic progenitors\nPDGFRα+ cardiac mesenchyme\n(state variable FAP)", shape=ellipse, fillcolor="#ffcc80", color="#ef6c00", penwidth=1.7];
        ADIPOCYTE [label="mature adipocyte"];
        FAT_TISSUE [label="FATTY REPLACEMENT\nstate variable FAT_RV\nepicardium → endocardium,\nwavefront direction", shape=ellipse, fillcolor="#ffd54f", penwidth=2.0];
        SPACE [label="vacated space\nreplacement fills the volume the\nmyocytes left — it does not\ncreate it", shape=hexagon, fillcolor="#f0f4c3"];
    }

    // =======================================================================
    //  CLUSTER 7 — fibrogenesis
    // =======================================================================
    subgraph cluster_fib {
        label = "7. FIBROGENESIS — the other half of 'fibrofatty'";
        style = "filled,rounded"; fillcolor = "#efebe9"; color = "#5d4037";
        fontsize = 12; fontname = "Helvetica-Bold";
        node [fillcolor = "#d7ccc8", color = "#5d4037"];

        TGFB [label="TGF-β1 ↑\n(TGFB3 is itself an ARVC locus)"];
        SMAD [label="SMAD2/3 phosphorylation"];
        CTGF [label="CTGF / CCN2"];
        MYOFIB [label="myofibroblast\nαSMA+ · contractile"];
        COL13 [label="collagen I / III deposition"];
        LOX [label="lysyl oxidase\ncross-linking → stiffness"];
        MMP_TIMP [label="MMP-2/9 vs TIMP-1\nmatrix turnover balance"];
        FIB_TISSUE [label="FIBROUS REPLACEMENT\nstate variable FIB_RV\nbears load (0.7) but does not\ncontract", shape=ellipse, fillcolor="#a1887f", fontcolor="white", penwidth=2.0];
        ALDO [label="aldosterone\nprofibrotic drive"];
    }

    // =======================================================================
    //  CLUSTER 8 — innate immunity / the hot phase
    // =======================================================================
    subgraph cluster_inf {
        label = "8. INNATE IMMUNITY AND THE 'HOT PHASE'\nmyocyte death here is immunogenic — inflammation both follows injury AND feeds it";
        style = "filled,rounded"; fillcolor = "#fbe9e7"; color = "#d84315";
        fontsize = 12; fontname = "Helvetica-Bold";
        node [fillcolor = "#ffccbc", color = "#d84315"];

        DAMPS [label="DAMPs\nmtDNA · HMGB1 · ATP"];
        TLR [label="TLR4 / NLRP3 inflammasome"];
        NFKB [label="NF-κB activation\n(also driven directly by\ndesmosome loss)", penwidth=1.7];
        IL1B [label="IL-1β"];
        IL6 [label="IL-6"];
        TNFA [label="TNF-α"];
        MACRO [label="macrophage infiltration\nCCR2+ monocyte recruitment"];
        TCELL [label="T-cell infiltrate\n(myocarditis-like histology)"];
        ANTI_HEART_AB [label="anti-heart / anti-intercalated\ndisc autoantibodies"];
        INF_STATE [label="INFLAMMATORY STATE\nstate variable INF_RV\nthe injury AMPLIFIER (×PHI_INF)", shape=ellipse, fillcolor="#ff8a65", penwidth=2.0];
        HOT_PHASE [label="HOT PHASE\nchest pain + troponin rise +\nnormal coronaries; often\nmisdiagnosed as myocarditis", shape=box, style="rounded,filled,bold", fillcolor="#ff7043", fontcolor="white", penwidth=1.8];
        STUN [label="reversible contractile stunning\n(why RVEF can recover after\na hot phase)"];
    }

    // =======================================================================
    //  CLUSTER 9 — GENERATOR I
    // =======================================================================
    subgraph cluster_gen1 {
        label = "9. GENERATOR I — TRIGGERED ACTIVITY, INDEPENDENT OF STRUCTURE\nthis is why a young carrier can die during exertion with a normal echocardiogram";
        style = "filled,rounded"; fillcolor = "#e3f2fd"; color = "#0d47a1";
        fontsize = 12; fontname = "Helvetica-Bold";
        node [fillcolor = "#bbdefb", color = "#0d47a1"];

        RYR2 [label="RyR2 destabilisation\nPKP2 loss alters Ca-handling\ntranscriptome (Ryr2 · Ank2 ·\nCacna1c · Trdn)", penwidth=1.7];
        RYR_LEAK [label="diastolic SR Ca²⁺ leak\nstate variable RYR_LEAK", shape=ellipse, fillcolor="#90caf9", penwidth=1.8];
        CASR [label="SR Ca²⁺ load (CA_SR)"];
        CAMKII [label="CaMKII autophosphorylation\n(feed-forward on RyR2)"];
        PKA_P [label="PKA phosphorylation of\nRyR2-S2808 / PLN-S16"];
        SERCA [label="SERCA2a / phospholamban\n(the PLN p.R14del route in)"];
        CA_DIA [label="diastolic cytosolic Ca²⁺\nstate variable CA_DIA", shape=ellipse, fillcolor="#64b5f6"];
        NCX [label="NCX forward mode\n→ transient inward current"];
        DAD [label="delayed afterdepolarisation"];
        SOURCE_SINK [label="source–sink relationship\nmyocyte loss REMOVES the\nelectrotonic suppression of\nectopy", penwidth=1.6];
        PVC [label="PVC BURDEN / 24 h\nstate variable PVC24\n(>500/24h = TFC minor)", shape=ellipse, fillcolor="#42a5f5", fontcolor="white", penwidth=2.0];
        NSVT_G1 [label="catecholaminergic\ncouplets · NSVT\n(exertional, RV morphology)"];
        GEN1 [label="GENERATOR I DRIVE", shape=doubleoctagon, fillcolor="#1565c0", fontcolor="white", penwidth=2.4];
    }

    // =======================================================================
    //  CLUSTER 10 — GENERATOR II
    // =======================================================================
    subgraph cluster_gen2 {
        label = "10. GENERATOR II — SCAR RE-ENTRY\nmaximal at ~50/50 interdigitation: a homogeneous scar has no conducting channels either";
        style = "filled,rounded"; fillcolor = "#efebe9"; color = "#4e342e";
        fontsize = 12; fontname = "Helvetica-Bold";
        node [fillcolor = "#bcaaa4", color = "#4e342e"];

        CV_RV [label="RV conduction velocity\nstate variable CV_RV\n55 → <25 cm/s\n∝ (gNa × coupling)^0.30", shape=ellipse, fillcolor="#a1887f", fontcolor="white", penwidth=1.9];
        ANISO [label="anisotropy ↑\nzig-zag conduction between\nfibrofatty septa"];
        ERP [label="effective refractory period\n(lengthened by IKr block)"];
        WAVELENGTH [label="re-entrant wavelength\nλ = CV × ERP\nshort λ → re-entry fits", penwidth=1.7];
        SCAR_HET [label="SCAR HETEROGENEITY\nstate variable SCAR_HET\n= 4 × fibrofatty × viable\n(peaks at 50/50)", shape=ellipse, fillcolor="#8d6e63", fontcolor="white", penwidth=2.0];
        CHANNELS [label="conducting channels /\nisthmuses in the scar"];
        SUBEPI [label="SUBEPICARDIAL onset\nthe substrate starts outside and\nworks inward — endocardial-only\nmapping under-reads it", penwidth=1.7];
        LATE_POT [label="fragmented electrograms\nlate potentials on SAECG"];
        DISPERSION [label="DISPERSION OF REPOLARISATION\nheterogeneous ERP across the scar\n→ re-entry INITIATION\n(the arm that cancels sotalol's\nwavelength benefit)", fillcolor="#a1887f", penwidth=1.8];
        FF_THRESH [label="CIRCUIT-SIZE THRESHOLD\nre-entry needs a path longer than\nthe wavelength, so a few percent of\ndiffuse interstitial fibrosis cannot\nhost one — which is why ordinary\nage-related fibrosis is not\narrhythmogenic", shape=hexagon, fillcolor="#efebe9", penwidth=1.6];
        SMVT [label="sustained monomorphic VT\nmultiple morphologies\n(multiple isthmuses)"];
        GEN2 [label="GENERATOR II DRIVE", shape=doubleoctagon, fillcolor="#4e342e", fontcolor="white", penwidth=2.4];
    }

    // =======================================================================
    //  CLUSTER 11 — autonomic
    // =======================================================================
    subgraph cluster_auto {
        label = "11. AUTONOMIC DRIVE — the trigger that shares a cause with the clock";
        style = "filled,rounded"; fillcolor = "#e8eaf6"; color = "#283593";
        fontsize = 12; fontname = "Helvetica-Bold";
        node [fillcolor = "#c5cae9", color = "#283593"];

        SNS [label="sympathetic tone\nstate variable SNS", shape=ellipse, fillcolor="#9fa8da"];
        NE_SURGE [label="catecholamine surge\nexercise · emotion · competition"];
        B1_REC [label="β1-adrenoceptor density\ndownregulates with chronic drive\n(state variable BETA1_D)"];
        B1_SIG [label="β1 → Gs → AC → cAMP → PKA"];
        BARO [label="baroreflex withdrawal\nas stroke volume falls"];
        DENERV [label="regional sympathetic\ndenervation on ¹²³I-MIBG"];
        EXERT_TRIGGER [label="EXERTIONAL TRIGGERING\nthe same exercise that drives the\nclock also fires the trigger —\nwhich is why restriction does\nboth jobs", shape=hexagon, fillcolor="#7986cb", fontcolor="white", penwidth=2.0];
    }

    // =======================================================================
