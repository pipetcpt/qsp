    // =======================================================================
    subgraph cluster_ecg {
        label = "15. ELECTROCARDIOGRAPHIC AND IMAGING PHENOTYPE\nevery item here is an OUTPUT of the state variables, not an input";
        style = "filled,rounded"; fillcolor = "#f1f8e9"; color = "#558b2f";
        fontsize = 12; fontname = "Helvetica-Bold";
        node [fillcolor = "#dcedc8", color = "#558b2f"];

        TWI [label="T-wave inversion V1-V3\n≥3 leads = TFC MAJOR\n2 leads = minor", penwidth=1.6];
        EPSILON [label="epsilon wave V1-V3\nTFC MAJOR\n(model: CV_RV < 22 cm/s)"];
        TAD [label="terminal activation duration\n≥55 ms = TFC minor\n(model: 32 ms × CV0/CV_RV)"];
        SAECG [label="SAECG late potentials\nTFC minor"];
        LOW_VOLT [label="low QRS voltage\n(PLN · advanced disease)"];
        CMR_LGE [label="CMR: RV LGE ·\nregional dyssynchrony ·\nfat-suppression imaging"];
        ECHO [label="echo: regional akinesia /\ndyskinesia / bulging"];
        EAM [label="electroanatomic mapping\nlow-voltage areas,\nEPI ≫ ENDO"];
        BIOPSY_N [label="endomyocardial biopsy\nresidual myocytes <60% = MAJOR\n60-75% = minor"];
