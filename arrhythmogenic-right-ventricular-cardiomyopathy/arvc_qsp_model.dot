    FLNC -> DESMO_RESERVE;
    PLN -> DESMO_RESERVE [style=dotted];
    GENE_ELUSIVE -> DESMO_RESERVE [label="reserve = normal\n(load alone must\ndo the work)", style=dashed, color="#e65100", fontcolor="#e65100"];
    PHENOCOPY -> TFC_CALL [style=dotted, label="must be excluded", color="#9e9e9e"];

    DSP -> KAPPA_LV [label="ON", style=dotted, color="#f9a825", penwidth=1.6];
    FLNC -> KAPPA_LV [label="ON", style=dotted, color="#f9a825", penwidth=1.6];
    PKP2 -> KAPPA_LV [label="OFF", style=dotted, color="#bdbdbd"];

    PKP2 -> PKP2_ID [penwidth=1.8];
    DESMO_RESERVE -> DSM [penwidth=1.6];
