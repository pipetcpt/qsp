        LVEF [label="LVEF"];
        LGE_RING [label="subepicardial / ring-like LGE\ninferolateral first\n(FLNC · DSP signature)"];
        LV_FIB [label="LV fibrofatty replacement\nFIB_LV · FAT_LV", shape=ellipse, fillcolor="#4dd0e1"];
        BIV [label="biventricular arrhythmogenic\ncardiomyopathy"];
        LV_MORPH_VT [label="VT of LV morphology,\nsuperior axis\n= TFC MAJOR arrhythmia"];
