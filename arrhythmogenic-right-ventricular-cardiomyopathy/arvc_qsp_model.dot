        RV_CONT [label="RV contractile function\nstate variable RV_CONT\n∝ (viable myocyte)^1.3", shape=ellipse, fillcolor="#80cbc4"];
        RVEDV [label="RVEDV / RVEDVi\nstate variable RVEDV\nTFC major ≥110 mL/m² (M)", shape=ellipse, fillcolor="#4db6ac", fontcolor="white", penwidth=1.8];
        RVEF [label="RVEF\nTFC major ≤40%", shape=ellipse, fillcolor="#4db6ac", fontcolor="white"];
        RVFAC [label="RV fractional area change\nTFC major ≤33%"];
        TAPSE [label="TAPSE · RV free-wall strain"];
        RVOT [label="RVOT dilatation\nPLAX ≥32 mm = TFC major"];
        TR [label="functional tricuspid\nregurgitation → more preload"];
        ATH_RV [label="athlete's RV\nPHYSIOLOGICAL dilatation —\nthe diagnostic trap, and a real\ncontributor to σ", fillcolor="#c8e6c9", color="#2e7d32"];
        RV_FAIL [label="right heart failure\nascites · hepatic congestion ·\nlow output", penwidth=1.7];
    }

    // =======================================================================
