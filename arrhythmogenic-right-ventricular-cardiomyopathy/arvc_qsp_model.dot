    subgraph cluster_dev {
        label = "18. DEVICES AND PROCEDURES";
        style = "filled,rounded"; fillcolor = "#fce4ec"; color = "#ad1457";
        fontsize = 12; fontname = "Helvetica-Bold";
        node [fillcolor = "#f8bbd0", color = "#ad1457"];

        ICD [label="ICD\nattached to the OUTCOME,\nnot to either generator\n→ all of the mortality benefit,\nexactly none of the disease", shape=octagon, fillcolor="#f06292", fontcolor="white", penwidth=2.4];
        SICD [label="subcutaneous ICD\n(no bradycardia/ATP support)"];
        ICD_COMP [label="lead failure · pocket infection ·\ninappropriate shocks\n(the cost of a device in a\n25-year-old)"];
        ABL_ENDO [label="ENDOCARDIAL-ONLY ABLATION\nremoves ~35% of the Gen-II\nsubstrate — recurs, because the\nsubstrate is subepicardial"];
        ABL_EPI [label="COMBINED ENDO-EPICARDIAL\nABLATION\n~78% of the substrate\nscar dechannelling", fillcolor="#f48fb1", penwidth=2.0];
        SYMPATH [label="cardiac sympathetic\ndenervation (refractory VT)"];
        TRANSPLANT [label="heart transplantation\n(refractory arrhythmia or\nRV failure)"];
        RVAD [label="mechanical support\n(rarely feasible in an\nRV-dominant phenotype)"];
    }

