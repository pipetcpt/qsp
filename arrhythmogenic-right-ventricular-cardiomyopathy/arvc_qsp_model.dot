    PKP2_ID -> GJ [label="PKP2 required for\nCx43 plaque"];
    NAV_CPLX -> NAV_ID [penwidth=1.7];
    GJ -> CX43_ID [penwidth=1.7];
    KIR -> ERP [style=dotted];
    DSM -> PG_NUC [label="junction failure\nreleases plakoglobin", color="#5e35b1", penwidth=1.6];
    AREA_COMP -> ID_STRAIN;

    // =======================================================================
    //  EDGES — the mechanical clock (COMMITMENT 1 + 2)
    // =======================================================================
    EX_DOSE -> DUTY [penwidth=2.0, color="#6a1b9a"];
    EX_DOSE -> HR_BEATS [penwidth=2.0, color="#6a1b9a"];
    EX_DOSE -> PRELOAD [penwidth=1.8, color="#6a1b9a"];
    EX_DOSE -> NE_SURGE [penwidth=1.8, color="#283593", label="the SAME exposure\nfires the trigger"];
    PRELOAD -> PAP;
    PVR -> PAP [label="falls only modestly", penwidth=1.7];
    PAP -> SIG_RV [label="+125% at max\nexercise", penwidth=2.2, color="#6a1b9a"];
    SVR -> SIG_LV [label="+14% only", penwidth=1.4];
    H_RV -> SIG_RV [label="σ ∝ 1/h", arrowhead=tee, color="#c62828", style=dashed, penwidth=1.8];
    H_LV -> SIG_LV [arrowhead=tee, color="#c62828", style=dashed];
    R_RV -> SIG_RV [label="σ ∝ r", penwidth=1.7];
    R_LV -> SIG_LV;
    DUTY -> FATIGUE_RV [penwidth=2.0, color="#6a1b9a"];
    HR_BEATS -> FATIGUE_RV [label="cycle count", penwidth=2.0, color="#6a1b9a"];
    DUTY -> FATIGUE_LV;
    HR_BEATS -> FATIGUE_LV;
    SIG_RV -> FATIGUE_RV [label="(σ)^4", penwidth=2.6, color="#6a1b9a"];
    SIG_LV -> FATIGUE_LV [label="(σ)^4", penwidth=1.8, color="#9575cd"];
    KAPPA_LV -> FATIGUE_LV [style=dotted, color="#f9a825", penwidth=1.8];
    DESMO_RESERVE -> FATIGUE_RV [label="÷ (reserve)^2\nthe ONLY genotype edge", arrowhead=tee, color="#424242", penwidth=2.2];
    DESMO_RESERVE -> FATIGUE_LV [arrowhead=tee, color="#424242"];
    PHI_EX -> SIG_RV [label="PHI_EX = 0 removes\nthe stress term", style=dashed, color="#b71c1c", arrowhead=tee, penwidth=2.0];
    PHI_EX -> SIG_LV [style=dashed, color="#b71c1c", arrowhead=tee];
    FATIGUE_RV -> D_RV [penwidth=2.2, color="#6a1b9a"];
    FATIGUE_LV -> D_LV;

    // clock -> death
    FATIGUE_RV -> ID_STRAIN [penwidth=2.6, color="#6a1b9a", label="the clock enters\nthe tissue here"];
    FATIGUE_LV -> LV_FIB [penwidth=1.6, color="#9575cd"];
    ID_STRAIN -> ID_RUPTURE [penwidth=1.9];
    MECH_COUPL -> ID_RUPTURE [arrowhead=tee, style=dashed, color="#c62828", label="intact coupling\nprotects"];
    ID_RUPTURE -> MYO_DETACH [penwidth=1.8];
    MYO_DETACH -> MYO_STRETCH;
    MYO_STRETCH -> ID_STRAIN [label="load transferred to\nthe survivors", color="#b71c1c", penwidth=1.6];
    MYO_DETACH -> APOPT;
    MYO_DETACH -> NECROP;
    APOPT -> MYO_LOSS [penwidth=1.8];
    NECROP -> MYO_LOSS [penwidth=1.8];
    NECROP -> NEC_POOL [penwidth=1.8];
    NEC_POOL -> TNI_REL;
    TNI_REL -> HOT_PHASE;
    MYO_LOSS -> WALL_THIN [penwidth=2.0];
    WALL_THIN -> H_RV [arrowhead=tee, color="#c62828", penwidth=2.0];
    WALL_THIN -> ANEURYSM;
    ANEURYSM -> R_RV [penwidth=1.6];
    MYO_LOSS -> AUTOCAT [penwidth=2.2, color="#b71c1c"];
    AUTOCAT -> SIG_RV [label="every myocyte lost raises\nthe price of the next beat", penwidth=2.4, color="#b71c1c"];
    MYO_FLOOR -> MYO_LOSS [arrowhead=tee, style=dashed, color="#bf360c", penwidth=1.9,
                           label="injury acts on\n(MYO − floor) only"];
    MYO_FLOOR -> AUTOCAT [arrowhead=tee, style=dashed, color="#bf360c", penwidth=1.7];
    MYO_LOSS -> SPACE [penwidth=1.8];
    MYO_LOSS -> SOURCE_SINK [penwidth=1.7, color="#1565c0"];

    // =======================================================================
    //  EDGES — Wnt / Hippo / adipogenesis
    // =======================================================================
    PG_NUC -> PG_COMPETE [penwidth=1.7];
    PG_COMPETE -> BCAT [arrowhead=tee, style=dashed, color="#c62828", penwidth=1.7];
    GSK3B -> BCAT [arrowhead=tee, style=dashed, color="#c62828"];
    BCAT -> WNT_ACT [penwidth=1.8];
    WNT_ACT -> TCF_TARGETS;
    WNT_ACT -> PPARG [arrowhead=tee, style=dashed, color="#c62828", penwidth=1.9, label="Wnt is the BRAKE\non adipogenesis"];
    DESMO_RESERVE -> NF2_MST [arrowhead=tee, style=dashed, color="#c62828", label="junction loss\nactivates Hippo"];
    FATIGUE_RV -> NF2_MST [label="load also\nactivates Hippo", color="#6a1b9a", penwidth=1.6];
    NF2_MST -> HIPPO_ACT [penwidth=1.8];
    HIPPO_ACT -> YAP_SEQ [penwidth=1.7];
    YAP_SEQ -> PPARG [penwidth=1.8];
    HIPPO_ACT -> WNT_ACT [arrowhead=tee, style=dashed, color="#c62828", label="cross-talk"];
    PPARG -> CEBPA;
    CEBPA -> ADIPOQ;
    PPARG -> FAP [penwidth=1.8];
    ADIPOQ -> ADIPOCYTE;
    FAP -> ADIPOCYTE [penwidth=1.8];
    ADIPOCYTE -> FAT_TISSUE [penwidth=2.0];
    SPACE -> FAT_TISSUE [label="replacement fills\nvacated volume", penwidth=1.8];
    SPACE -> FIB_TISSUE [penwidth=1.8];

    // =======================================================================
    //  EDGES — fibrogenesis
    // =======================================================================
    INF_STATE -> TGFB [penwidth=1.7];
    NEC_POOL -> TGFB;
    ALDO -> TGFB [penwidth=1.6];
    TGFB -> SMAD [penwidth=1.7];
    SMAD -> CTGF;
    CTGF -> MYOFIB;
    FAP -> MYOFIB [penwidth=1.8];
    MYOFIB -> COL13 [penwidth=1.8];
    COL13 -> LOX;
    MMP_TIMP -> COL13;
    LOX -> FIB_TISSUE [penwidth=1.7];
    COL13 -> FIB_TISSUE [penwidth=2.0];
    FIB_TISSUE -> H_RV [label="bears load (0.7)\nbut cannot contract\n= the brake on runaway", penwidth=1.7];
    FAT_TISSUE -> H_RV [label="bulk only (0.35)", penwidth=1.3];

    // =======================================================================
    //  EDGES — inflammation
    // =======================================================================
    NEC_POOL -> DAMPS [penwidth=1.9];
    DAMPS -> TLR [penwidth=1.8];
    TLR -> NFKB [penwidth=1.8];
    DESMO_RESERVE -> NFKB [arrowhead=tee, style=dashed, color="#d84315", label="desmosome loss\nprimes NF-κB directly"];
    NFKB -> IL1B [penwidth=1.8];
    NFKB -> IL6;
    NFKB -> TNFA;
    IL1B -> MACRO [penwidth=1.7];
    TNFA -> MACRO;
    MACRO -> INF_STATE [penwidth=1.9];
    IL1B -> INF_STATE [penwidth=1.9];
    TCELL -> INF_STATE;
    MACRO -> TCELL;
    ANTI_HEART_AB -> INF_STATE [style=dotted];
    INF_STATE -> ID_STRAIN [label="× PHI_INF = 1.3\nthe AMPLIFIER, not the clock",
                            color="#d84315", penwidth=1.9];
    INF_STATE -> HOT_PHASE [penwidth=1.8];
    INF_STATE -> STUN [penwidth=1.6];
    STUN -> RV_CONT [arrowhead=tee, style=dashed, color="#c62828"];
    HOT_PHASE -> SUST_VA [style=dashed, label="arrhythmic storms\ncluster in hot phases"];

    // =======================================================================
    //  EDGES — GENERATOR I
    // =======================================================================
    PKP2_ID -> RYR2 [arrowhead=tee, style=dashed, color="#0d47a1", penwidth=1.8,
                     label="Ca-handling transcriptome"];
    RYR2 -> RYR_LEAK [penwidth=2.0];
    CAMKII -> RYR_LEAK [penwidth=1.7];
    PKA_P -> RYR_LEAK [penwidth=1.8];
    B1_SIG -> PKA_P [penwidth=1.9];
    SERCA -> CASR [penwidth=1.7];
    PLN -> SERCA [style=dotted, label="p.R14del"];
    CASR -> RYR_LEAK [penwidth=1.6];
    RYR_LEAK -> CA_DIA [penwidth=2.0];
    RYR_LEAK -> CAMKII [label="feed-forward", color="#0d47a1"];
    CA_DIA -> NCX [penwidth=1.8];
    NCX -> DAD [penwidth=1.9];
    DAD -> PVC [penwidth=2.0];
    SOURCE_SINK -> PVC [label="loss of electrotonic\nsuppression", penwidth=1.8];
    PVC -> NSVT_G1 [penwidth=1.8];
    PVC -> GEN1 [penwidth=2.4, color="#1565c0"];
    NSVT_G1 -> GEN1 [penwidth=1.8];
    EXERT_TRIGGER -> GEN1 [penwidth=2.0, color="#283593"];

    // =======================================================================
    //  EDGES — GENERATOR II
    // =======================================================================
    NAV_ID -> CV_RV [label="∝ gNa^0.30", penwidth=2.0];
    CX43_ID -> CV_RV [label="∝ coupling^0.30", penwidth=2.0];
    FIB_TISSUE -> CV_RV [arrowhead=tee, style=dashed, color="#c62828", penwidth=1.9,
                         label="tortuosity"];
    FAT_TISSUE -> CV_RV [arrowhead=tee, style=dashed, color="#c62828", penwidth=1.9];
    FIB_TISSUE -> ANISO [penwidth=1.7];
    FAT_TISSUE -> ANISO [penwidth=1.7];
    ANISO -> CHANNELS;
    CV_RV -> WAVELENGTH [penwidth=2.0];
    ERP -> WAVELENGTH [penwidth=1.7];
    WAVELENGTH -> GEN2 [label="short λ → re-entry\nfits inside the scar",
                        arrowhead=tee, style=dashed, color="#c62828", penwidth=2.0];
    FIB_TISSUE -> SCAR_HET [penwidth=2.0];
    FAT_TISSUE -> SCAR_HET [penwidth=2.0];
    MYO_LOSS -> SCAR_HET [label="peaks at 50/50:\nboth normal myocardium and\nhomogeneous scar are SAFE",
                          penwidth=1.9];
    SCAR_HET -> CHANNELS [penwidth=1.9];
    SUBEPI -> SCAR_HET [penwidth=1.7];
    FAT_TISSUE -> SUBEPI [label="epicardium first", penwidth=1.7];
    CHANNELS -> SMVT [penwidth=2.0];
    SCAR_HET -> GEN2 [penwidth=2.4, color="#4e342e"];
    FF_THRESH -> SCAR_HET [arrowhead=tee, style=dashed, color="#4e342e", penwidth=1.7,
                           label="below threshold:\nno Generator II at all"];
    DISPERSION -> GEN2 [penwidth=2.0, color="#4e342e"];
    SCAR_HET -> DISPERSION [penwidth=1.6];
    SMVT -> GEN2 [penwidth=1.8];
    CV_RV -> LATE_POT [arrowhead=tee, style=dashed, color="#5d4037", penwidth=1.7];
    CV_RV -> TAD [arrowhead=tee, style=dashed, color="#5d4037", penwidth=1.7];
    CV_RV -> EPSILON [arrowhead=tee, style=dashed, color="#5d4037", penwidth=1.7];
    SUBEPI -> EAM [penwidth=1.7];

    // =======================================================================
    //  EDGES — autonomic
    // =======================================================================
    NE_SURGE -> SNS [penwidth=1.9];
    RV_CONT -> SNS [arrowhead=tee, style=dashed, color="#c62828", penwidth=1.7];
    BARO -> SNS;
    SNS -> B1_SIG [penwidth=1.9];
    SNS -> B1_REC [arrowhead=tee, style=dashed, color="#c62828",
                   label="chronic drive downregulates"];
    B1_REC -> B1_SIG [penwidth=1.8];
    NE_SURGE -> EXERT_TRIGGER [penwidth=2.0];
    SNS -> DENERV [style=dotted];
    DENERV -> GEN1 [style=dotted];
    SNS -> RAAS [penwidth=1.7];

    // =======================================================================
    //  EDGES — chamber mechanics
    // =======================================================================
    MYO_LOSS -> RV_CONT [arrowhead=tee, style=dashed, color="#c62828", penwidth=2.0];
    FIB_TISSUE -> RV_CONT [arrowhead=tee, style=dashed, color="#c62828"];
    RV_CONT -> RVEF [penwidth=2.0];
    RV_CONT -> RVEDV [arrowhead=tee, style=dashed, color="#00695c", penwidth=1.9,
                      label="dilates to defend\nstroke volume"];
    ATH_RV -> RVEDV [penwidth=1.8];
    EX_DOSE -> ATH_RV [penwidth=1.8, color="#6a1b9a"];
    RVEDV -> R_RV [penwidth=2.0];
    RVEDV -> RVOT;
    RVEF -> RVFAC;
    RV_CONT -> TAPSE;
    RVEDV -> TR [penwidth=1.6];
    TR -> PRELOAD [label="regurgitant volume\nre-enters the clock",
                   color="#b71c1c", penwidth=1.8];
    RV_CONT -> RV_FAIL [arrowhead=tee, style=dashed, color="#c62828", penwidth=1.8];
    RVEDV -> PAP [label="P_RV rises as the\nRV meets its afterload", penwidth=1.6];

    // LV
    FATIGUE_LV -> LV_CONT [arrowhead=tee, style=dashed, color="#c62828", penwidth=1.7];
    LV_FIB -> LV_CONT [arrowhead=tee, style=dashed, color="#c62828", penwidth=1.8];
    LV_CONT -> LVEF [penwidth=1.9];
    LV_FIB -> LGE_RING [penwidth=1.8];
    LV_FIB -> LV_MORPH_VT [penwidth=1.8];
    LV_FIB -> BIV;
    MYO_LOSS -> BIV [style=dotted];
    LV_MORPH_VT -> TFC_V [penwidth=1.8];
    LV_FIB -> SCAR_HET [style=dotted];

    // =======================================================================
    //  EDGES — neurohormonal
    // =======================================================================
    RAAS -> ALDO [penwidth=1.8];
    RAAS -> NA_RET [penwidth=1.7];
    NA_RET -> CONGEST [penwidth=1.8];
    RVEDV -> NTBNP [penwidth=1.8];
    LV_CONT -> NTBNP [arrowhead=tee, style=dashed, color="#1b5e20"];
    CONGEST -> PRELOAD [label="congestion feeds the\nclock — this is why load\nreduction works",
                        color="#b71c1c", penwidth=2.0];
    RV_FAIL -> CONGEST [penwidth=1.8];
    RV_FAIL -> CARDIORENAL;
    RV_FAIL -> HF_DEATH_HAZ [penwidth=1.9];
    LV_CONT -> HF_DEATH_HAZ [arrowhead=tee, style=dashed, color="#1b5e20", penwidth=1.8];
    HF_DEATH_HAZ -> HFD [penwidth=1.9];

    // =======================================================================
    //  EDGES — diagnostics
    // =======================================================================
    MYO_LOSS -> TWI [penwidth=1.8];
    MYO_LOSS -> ECHO [penwidth=1.7];
    FIB_TISSUE -> CMR_LGE [penwidth=1.7];
    FAT_TISSUE -> CMR_LGE [penwidth=1.7];
    MYO_LOSS -> BIOPSY_N [penwidth=1.7];
    FIB_TISSUE -> BIOPSY_N;
    FAT_TISSUE -> BIOPSY_N;
    RVEF -> TFC_I [penwidth=1.9];
    RVEDV -> TFC_I [penwidth=1.9];
    RVFAC -> TFC_I;
    RVOT -> TFC_I;
    ECHO -> TFC_I;
    CMR_LGE -> PADUA [penwidth=1.7];
    LGE_RING -> PADUA [penwidth=1.7];
    BIOPSY_N -> TFC_II [penwidth=1.9];
    TWI -> TFC_III [penwidth=1.9];
    EPSILON -> TFC_IV [penwidth=1.9];
    TAD -> TFC_IV [penwidth=1.7];
    SAECG -> TFC_IV [penwidth=1.7];
    LATE_POT -> SAECG [penwidth=1.8];
    LOW_VOLT -> PADUA [style=dotted];
    PVC -> TFC_V [penwidth=1.9];
    NSVT_G1 -> TFC_V [penwidth=1.8];
    SMVT -> TFC_V [penwidth=1.8];
    PKP2 -> TFC_VI [penwidth=1.9];
    CASCADE -> TFC_VI [penwidth=1.7];
    TFC_I -> TFC_CALL [penwidth=1.8];
    TFC_II -> TFC_CALL [penwidth=1.8];
    TFC_III -> TFC_CALL [penwidth=1.8];
    TFC_IV -> TFC_CALL [penwidth=1.8];
    TFC_V -> TFC_CALL [penwidth=1.8];
    TFC_VI -> TFC_CALL [penwidth=1.8];
    PADUA -> TFC_CALL [style=dotted];
    SYNCOPE -> RISK_CALC;
    PVC -> RISK_CALC;
    TWI -> RISK_CALC;
    RVEF -> RISK_CALC;
    NSVT_G1 -> RISK_CALC;
    RISK_CALC -> ICD [label="drives the primary-prevention\ndecision", penwidth=1.8];

    // =======================================================================
    //  EDGES — DRUGS, each onto the node it occupies (COMMITMENT 3)
    // =======================================================================
    RESTRICT -> EX_DOSE [arrowhead=tee, style=dashed, color="#e65100", penwidth=2.6,
                         label="THE CLOCK ITSELF"];
    RESTRICT -> NE_SURGE [arrowhead=tee, style=dashed, color="#e65100", penwidth=2.0,
                          label="and the trigger"];
    LOADRED -> RVEDV [arrowhead=tee, style=dashed, color="#e65100", penwidth=2.4,
                      label="−26% volume set point\n→ σ ↓ → clock slows"];
    LOADRED -> CONGEST [arrowhead=tee, style=dashed, color="#e65100", penwidth=1.8];
    ARNI_N -> RVEDV [arrowhead=tee, style=dashed, color="#e65100", penwidth=1.6];
    ARNI_N -> RAAS [arrowhead=tee, style=dashed, color="#e65100"];
    SGLT2 -> CONGEST [arrowhead=tee, style=dashed, color="#e65100"];
    BB -> B1_SIG [arrowhead=tee, style=dashed, color="#e65100", penwidth=2.2,
                  label="Kd ≈ 4 nM"];
    BB -> NO_DRUG [style=dotted, color="#bf360c"];
    FLEC -> RYR_LEAK [arrowhead=tee, style=dashed, color="#e65100", penwidth=2.2,
                      label="RyR2 open state\nIC50 2.5 µM → Gen I ↓"];
    FLEC -> CV_RV [arrowhead=tee, style=dashed, color="#b71c1c", penwidth=2.2,
                   label="Nav1.5 IC50 6 µM\n→ CV ↓ → Gen II ↑\nTHE COST"];
    SOT -> B1_SIG [arrowhead=tee, style=dashed, color="#e65100", penwidth=1.4,
                   label="weak, Kd 320 nM"];
    SOT -> ERP [penwidth=1.9, label="IKr block\nlengthens λ"];
    SOT -> DAD [penwidth=1.6, color="#b71c1c", label="EAD risk"];
    SOT -> DISPERSION [penwidth=2.0, color="#b71c1c"];
    AMIO -> DISPERSION [penwidth=1.0, color="#bdbdbd",
                        label="much weaker: marked QT\nprolongation, low TdP rate"];
    AMIO -> RYR_LEAK [arrowhead=tee, style=dashed, color="#e65100", penwidth=1.8];
    AMIO -> ERP [penwidth=1.9];
    AMIO -> GEN2 [arrowhead=tee, style=dashed, color="#e65100", penwidth=1.9];
    AMIO -> ICD_COMP [style=dotted, label="thyroid · lung · liver ·\nskin toxicity accumulates\nover 40 years"];
    MRA -> COL13 [arrowhead=tee, style=dashed, color="#e65100", penwidth=1.9];
    MRA -> ALDO [arrowhead=tee, style=dashed, color="#e65100"];
    IL1BLK -> IL1B [arrowhead=tee, style=dashed, color="#e65100", penwidth=2.0];
    GC -> INF_STATE [arrowhead=tee, style=dashed, color="#e65100", penwidth=1.7];
    GC -> NO_DRUG [style=dotted, color="#bf360c", label="amplifier only"];
    GSK3I -> GSK3B [arrowhead=tee, style=dashed, color="#e65100", penwidth=2.0];
    GSK3I -> HIPPO_ACT [arrowhead=tee, style=dashed, color="#e65100", penwidth=1.8];
    AAV -> PKP2_ID [penwidth=2.4, color="#bf360c",
                    label="restores reserve →\nlowers the price per beat"];
    AAV -> NO_DRUG [style=dotted, color="#bf360c",
                    label="but removes no existing scar\n→ TIMING dominates dose"];

    // =======================================================================
    //  EDGES — devices
    // =======================================================================
    ICD -> SCD [arrowhead=tee, style=dashed, color="#ad1457", penwidth=2.6,
                label="88% of episodes\nterminated"];
    ICD -> SHOCKS [penwidth=1.8];
    ICD -> ICD_COMP [penwidth=1.7];
    ICD -> NO_DRUG [style=dotted, color="#bf360c",
                    label="touches neither generator"];
    SICD -> SCD [arrowhead=tee, style=dashed, color="#ad1457"];
    ABL_ENDO -> SCAR_HET [arrowhead=tee, style=dashed, color="#ad1457", penwidth=1.7,
                          label="−35%: recurs"];
    ABL_EPI -> SCAR_HET [arrowhead=tee, style=dashed, color="#ad1457", penwidth=2.4,
                         label="−78%"];
    EAM -> ABL_EPI [penwidth=1.8];
    SUBEPI -> ABL_EPI [label="the reason epicardial\naccess matters", penwidth=1.8];
    SYMPATH -> SNS [arrowhead=tee, style=dashed, color="#ad1457"];
    RV_FAIL -> TRANSPLANT [penwidth=1.7];
    SMVT -> TRANSPLANT [style=dotted];
    RV_FAIL -> RVAD [style=dotted];

    // =======================================================================
    //  EDGES — the two generators into the endpoints
    // =======================================================================
    GEN1 -> SUST_VA [penwidth=2.4, color="#1565c0"];
    GEN2 -> SUST_VA [label="× LAM2 (fitted)", penwidth=2.4, color="#4e342e"];
    GEN1 -> PALP;
    SUST_VA -> SYNCOPE [penwidth=1.7];
    SUST_VA -> SCD [penwidth=2.2, label="P(SCD | VA) ≈ 0.30\nwithout an ICD"];
    SUST_VA -> SHOCKS [penwidth=1.8];
    SCD -> SURVIVAL [arrowhead=tee, style=dashed, color="#1b5e20", penwidth=2.2];
    HFD -> SURVIVAL [arrowhead=tee, style=dashed, color="#1b5e20", penwidth=1.9];
    SUST_VA -> SURVIVAL [arrowhead=tee, style=dashed, color="#1b5e20"];
    ICD_COMP -> QOL [arrowhead=tee, style=dashed, color="#1b5e20"];
    SHOCKS -> QOL [arrowhead=tee, style=dashed, color="#1b5e20"];
    RESTRICT -> SPORT_STOP [penwidth=1.8];
    SPORT_STOP -> QOL [arrowhead=tee, style=dashed, color="#1b5e20",
                       label="the cost patients\nactually feel"];
    RV_FAIL -> QOL [arrowhead=tee, style=dashed, color="#1b5e20"];

    // =======================================================================
    //  EDGES — the family loop
    // =======================================================================
    PKP2 -> CASCADE [penwidth=1.7];
    CASCADE -> GPOS_PNEG [penwidth=1.9];
    GPOS_PNEG -> SERIAL [penwidth=1.8];
    GPOS_PNEG -> RESTRICT [penwidth=2.0, color="#e65100",
                           label="how much sport?\nthe model's main\nclinical question"];
    GPOS_PNEG -> AAV [style=dotted, label="the concealed phase is\nwhere gene therapy\nhas its effect"];
    SERIAL -> TFC_CALL [penwidth=1.7];
    CASCADE -> PRECONCEPT;
    GENE_ELUSIVE -> RESTRICT [style=dashed, color="#e65100",
                              label="restriction still applies:\nload was the cause"];

    // =======================================================================
    //  LEGEND
    // =======================================================================
    subgraph cluster_legend {
        label = "READING THIS MAP";
        style = "filled,rounded"; fillcolor = "#ffffff"; color = "#000000";
        fontsize = 13; fontname = "Helvetica-Bold";
        node [shape=plaintext, fillcolor="#ffffff", style="", fontsize=10];

        LEG1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2">
<TR><TD ALIGN="LEFT"><B>The three commitments, and where to attack them</B></TD></TR>
<TR><TD ALIGN="LEFT">1. <B>The clock is cumulative mechanical work.</B>  Follow the bold violet spine: EX_DOSE → σ → (σ)⁴ → ID_STRAIN.</TD></TR>
<TR><TD ALIGN="LEFT">    Genotype enters at exactly one edge (DESMO_RESERVE ⊣ FATIGUE).  Age is not a variable anywhere.</TD></TR>
<TR><TD ALIGN="LEFT">    <B>Falsifier:</B> PHI_EX = 0.  Damage becomes load-independent, and exercise dose-response, incomplete</TD></TR>
<TR><TD ALIGN="LEFT">    penetrance, gene-elusive ARVC, RV selectivity and the Fabritz load-reduction result all disappear at once.</TD></TR>
<TR><TD ALIGN="LEFT">2. <B>RV selectivity is Laplace.</B>  Two measured numbers do it: +125% RV vs +14% LV wall stress on exercise.</TD></TR>
<TR><TD ALIGN="LEFT">    No RV-specific biology is used.  KAPPA_LV — the one chamber-specific term — is ON only for DSP/FLNC.</TD></TR>
<TR><TD ALIGN="LEFT">3. <B>Two generators, and a drug cannot outperform the one it occupies.</B>  Blue cluster 9 is trigger-driven and</TD></TR>
<TR><TD ALIGN="LEFT">    exists before any structural change; brown cluster 10 is scar re-entry.  Every drug in cluster 17 is drawn</TD></TR>
<TR><TD ALIGN="LEFT">    onto a specific node, which is why FLECAINIDE has an arrow into each generator with opposite sign, why</TD></TR>
<TR><TD ALIGN="LEFT">    SOTALOL's two arrows cancel, and why the ICD's only arrow is into the outcome.</TD></TR>
<TR><TD ALIGN="LEFT"> </TD></TR>
<TR><TD ALIGN="LEFT"><B>Edges:</B>  solid = activation/flux · dashed with a bar = inhibition · bold violet = the fatigue clock ·</TD></TR>
<TR><TD ALIGN="LEFT">dotted = a switch that is off unless the genotype or the scenario turns it on.</TD></TR>
<TR><TD ALIGN="LEFT"><B>Shapes:</B>  octagon = an intervention point or an exposure · double octagon = a load-bearing claim ·</TD></TR>
<TR><TD ALIGN="LEFT">ellipse = an ODE state variable in arvc_mrgsolve_model.R · hexagon = a switch parameter · note = a stated limit.</TD></TR>
<TR><TD ALIGN="LEFT"> </TD></TR>
<TR><TD ALIGN="LEFT"><B>Fitted:</B> only K_INJ, H0_VA, LAM2, K_DIL.  <B>Predicted:</B> the ~3× exercise hazard ratio, incomplete</TD></TR>
<TR><TD ALIGN="LEFT">penetrance, gene-elusive ARVC, RV-before-LV, load-reduction efficacy, the sotalol null, flecainide's sign</TD></TR>
<TR><TD ALIGN="LEFT">flip, the endo-vs-epi ablation gap, the ICD's outcome-only benefit, and gene-therapy timing.</TD></TR>
</TABLE>>];
    }
}
