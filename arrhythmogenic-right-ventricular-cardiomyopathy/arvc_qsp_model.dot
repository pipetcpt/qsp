        TFC_I [label="I. structure / function"];
        TFC_II [label="II. tissue characterisation"];
        TFC_III [label="III. repolarisation"];
        TFC_IV [label="IV. depolarisation / conduction"];
        TFC_V [label="V. arrhythmias"];
        TFC_VI [label="VI. family history / genetics\n(a FREE major for any\nvariant carrier — which is why\nrelatives are diagnosed earlier)"];
        TFC_CALL [label="DIAGNOSTIC CALL\ndefinite: 2 major, or 1 major +\n2 minor, or 4 minor\nborderline · possible · none", shape=doubleoctagon, fillcolor="#c0ca33", penwidth=2.2];
        PADUA [label="Padua / 2024 European criteria\nadd LV tissue characterisation\nand LGE phenotypes"];
        RISK_CALC [label="ARVC risk calculator inputs\nage · sex · syncope · NSVT ·\nPVC/24h · TWI leads · RVEF\n(the model EMITS all seven)", fillcolor="#e6ee9c", penwidth=1.6];
    }

    // =======================================================================
    //  CLUSTER 17 — drugs
    // =======================================================================
    subgraph cluster_drug {
        label = "17. DRUGS AND INTERVENTIONS — each attached to the NODE it occupies\nnot to 'arrhythmia' in general. This is where commitment 3 does its work.";
        style = "filled,rounded"; fillcolor = "#fff3e0"; color = "#e65100";
        fontsize = 12; fontname = "Helvetica-Bold";
        node [fillcolor = "#ffe0b2", color = "#e65100"];

        RESTRICT [label="EXERCISE RESTRICTION\nthe only intervention that acts on\nthe CLOCK itself — and it also\nremoves the trigger\n(guideline: no competitive sport)", shape=octagon, fillcolor="#ff9800", penwidth=2.4];
        LOADRED [label="LOAD-REDUCING THERAPY\nloop diuretic + nitrate, or ARNI\n26% ↓ RV volume set point\n→ σ ↓ → clock slows\n[Fabritz 2011: prevented the\nphenotype in mice]", shape=octagon, fillcolor="#ffb74d", penwidth=2.2];
        BB [label="β-BLOCKER (nadolol)\nKd ≈ 4 nM · occupies\nGENERATOR I via β1\nno effect on the clock", penwidth=1.7];
        FLEC [label="FLECAINIDE\nRyR2 open-state block (IC50 2.5 µM)\n→ Generator I ↓\nNav1.5 block (IC50 6 µM)\n→ CV ↓ → GENERATOR II ↑\nTWO SIGNS, ONE DRUG", fillcolor="#ffcc80", penwidth=2.2];
        SOT [label="SOTALOL\nweak β1 (Kd 320 nM) + IKr block\nARM 1: lengthens λ → anti-Gen-II\nARM 2: dispersion of repolarisation\nin a HETEROGENEOUS substrate\n→ promotes re-entry INITIATION\nThe two arms cancel → NET ≈ 0,\nwhich is what the registry found", penwidth=1.9];
        AMIO [label="AMIODARONE\nmulti-channel: Gen I AND Gen II\nVc 60 L · Vp 4600 L · t½ ≈ 58 d\nmost effective per year,\nworst 40-year bet"];
        MRA [label="MRA (spironolactone)\nfibrogenesis ↓ 30%"];
        ARNI_N [label="ARNI / ACE-i / ARB\nafterload + neurohormonal"];
        IL1BLK [label="IL-1 blockade\nanakinra · canakinumab\n(hot phase / amplifier)"];
        GC [label="corticosteroid\namplifier only — does NOT\ntouch the clock"];
        GSK3I [label="GSK-3β INHIBITION\nSB216763: restores Wnt,\nlowers the adipogenic switch\n(preclinical)"];
        AAV [label="AAV9-PKP2 GENE THERAPY\nrestores DESMOSOMAL RESERVE\n→ lowers the price per beat\nbut removes no existing scar\n→ TIMING dominates dose\n(TN-401 · RP-A601, phase 1)", shape=octagon, fillcolor="#ffab91", color="#bf360c", penwidth=2.2];
        SGLT2 [label="SGLT2 inhibitor\n(HF background therapy)"];
        NO_DRUG [label="what nothing here does:\nreverse established\nfibrofatty replacement", shape=note, fillcolor="#fbe9e7", color="#bf360c"];
    }

    // =======================================================================
