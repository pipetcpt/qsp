        PALP [label="palpitations"];
        SYNCOPE [label="syncope\n(a risk-calculator input)"];
        SUST_VA [label="SUSTAINED VT / VF\n~10%/yr in definite disease\n~0.5-1%/yr before phenotype", shape=ellipse, fillcolor="#66bb6a", fontcolor="white", penwidth=2.0];
        SCD [label="SUDDEN CARDIAC DEATH\noften the first presentation,\noften during exertion", shape=doubleoctagon, fillcolor="#2e7d32", fontcolor="white", penwidth=2.2];
        SHOCKS [label="appropriate + inappropriate\nICD shocks"];
        HFD [label="heart-failure death /\ntransplantation"];
        SPORT_STOP [label="sports disqualification\n(the intervention patients\nresist most, and the one that\nmoves the trajectory most)"];
