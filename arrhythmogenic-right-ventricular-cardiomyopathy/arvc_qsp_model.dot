        RAAS [label="RAAS activation\nrenin → Ang II → aldosterone"];
        NTBNP [label="NT-proBNP\nstate variable NTBNP", shape=ellipse, fillcolor="#a5d6a7"];
        CONGEST [label="venous congestion\n→ preload ↑ → σ ↑\n(a vicious loop into cluster 3)", penwidth=1.7];
        NA_RET [label="sodium and water retention"];
        CARDIORENAL [label="cardio-renal interaction\neGFR ↓"];
        HF_DEATH_HAZ [label="HF-death hazard"];
