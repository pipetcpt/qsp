    // =======================================================================
    //  EDGES — genotype into the single reserve term
    // =======================================================================
    PKP2 -> DESMO_RESERVE [penwidth=2.0, color="#424242"];
    DSP -> DESMO_RESERVE;
    DSG2 -> DESMO_RESERVE;
    DSC2 -> DESMO_RESERVE;
    JUP -> DESMO_RESERVE;
    CTNNA3 -> DESMO_RESERVE;
