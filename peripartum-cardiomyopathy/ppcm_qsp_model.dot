  NRG1_axis -> CM_survival_signal;
  Nras -> CM_survival_signal;
  Notch1 -> CM_survival_signal;
  CM_survival_signal -> CM_apoptosis [arrowhead=tee, style=bold];
  CM_survival_signal -> ATP_production;
  miR146a_endo -> Endothelial_apoptosis [label="anti-angiogenic in endothelium"];
  miR146a_serum -> LVEF_recovery [label="prognostic marker", style=dotted];

  //==========================================================================
