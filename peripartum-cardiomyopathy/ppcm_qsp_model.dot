  SGLT2i_effect -> Mito_dysfunction [arrowhead=tee, label="metabolic benefit"];
  Loop_diuretic -> Na_water_retention [arrowhead=tee, style=bold];
  Loop_diuretic -> Pulmonary_congestion [arrowhead=tee];
  Hydralazine_nitrate -> Afterload_reduction;
  Afterload_reduction -> Wall_stress [arrowhead=tee, style=bold];
  Ivabradine -> HR_rise [arrowhead=tee];
  Digoxin -> LV_contractility [label="modest inotropy"];
  Anticoagulation -> Thromboembolism [arrowhead=tee, style=bold];
