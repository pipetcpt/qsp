  BRC_PRL_suppression -> PRL16 [arrowhead=tee, label="substrate withdrawal", style=bold, color="#2e8b57"];
  BRC_D2_agonism -> BRC_lactation_supp;
  BRC_lactation_supp -> Maternal_bonding [label="trade-off", color="#b03060"];
  BRC_lactation_supp -> Suckling_reflex [arrowhead=tee];
  BRC_1wk -> BRC_dose;
  BRC_8wk -> BRC_dose;
  BRC_8wk -> LVEF_recovery [label="68% vs 52% (1wk)", color="#2e8b57"];
  BRC_central -> BRC_thrombotic_risk;
  BRC_thrombotic_risk -> LV_thrombus [color="#b03060"];
  BRC_thrombotic_risk -> Anticoagulation [label="mandates", style=dashed];
  BRC_central -> BRC_AE;
