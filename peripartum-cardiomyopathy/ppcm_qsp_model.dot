  BB_beta1_block -> Beta1_downreg [arrowhead=tee, label="receptor resensitization"];
  BB_beta1_block -> HR_rise [arrowhead=tee];
  BB_beta1_block -> Ventricular_arrhythmia [arrowhead=tee];
  ACEI_ARB -> RAAS [arrowhead=tee, style=bold];
