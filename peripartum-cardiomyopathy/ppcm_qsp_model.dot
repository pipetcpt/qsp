digraph PPCM_QSP {
  rankdir=LR;
  fontname="Helvetica";
  labelloc="t";
  fontsize=20;
  label="Peripartum Cardiomyopathy (PPCM) — Mechanistic QSP Map\nOxidative Stress / STAT3-MnSOD Loss → Cathepsin D → 16-kDa Prolactin (Vasoinhibin) + Placental sFlt-1 →\nAnti-angiogenic Coronary Microvascular Injury → miR-146a Exosome Transfer → Cardiomyocyte Energetic Failure → Postpartum Systolic Heart Failure";
  node [style=filled, fontname="Helvetica", fontsize=10, shape=box];
  edge [fontname="Helvetica", fontsize=8];
  compound=true;
  newrank=true;
  ranksep=0.45;
  nodesep=0.22;
  concentrate=false;

  //==========================================================================
  subgraph cluster_gen {
    label="1. Genetic Substrate & Predisposing Risk Factors"; style=filled; color="#e8ddf0"; fillcolor="#f3ecf9";
    TTN_trunc [label="TTN truncating variant\n(~15% of PPCM; Ware 2016)", fillcolor="#e5d0f5"];
    Sarcomere_reserve [label="Reduced sarcomere\nreserve (titin haploinsufficiency)"];
    BAG3_var [label="BAG3 variant\n(chaperone/proteostasis)"];
    DSP_var [label="DSP variant\n(desmosomal)"];
    MYH7_TNNT2 [label="MYH7 / TNNT2\nvariants"];
    LMNA_var [label="LMNA variant\n(arrhythmia-prone)"];
    FLNC_var [label="FLNC truncating\nvariant"];
    DCM_shared_arch [label="Shared genetic architecture\nwith idiopathic DCM"];
    Family_history [label="Family history of\nDCM / PPCM"];
    African_ancestry [label="African ancestry\n(earlier onset, lower recovery)"];
    Multiparity [label="Multiparity\n(≥2 prior pregnancies)"];
    Advanced_age [label="Advanced maternal\nage (>30 y)"];
    Multiple_gestation [label="Twin / multiple\ngestation"];
    Preeclampsia_HDP [label="Preeclampsia /\nhypertensive disorder (~22%)", fillcolor="#f7d6d6"];
    Tocolytic_exposure [label="Prolonged β-agonist\ntocolysis"];
    Anemia_malnutrition [label="Anemia /\nmicronutrient deficiency"];
    Selenium_def [label="Selenium deficiency\n(regional cofactor)"];
    Low_SES_access [label="Low socioeconomic status /\ndelayed care access"];
  }

  //==========================================================================
  subgraph cluster_hemo {
    label="2. Late-Pregnancy & Peripartum Hemodynamic / Hormonal Load"; style=filled; color="#dbe8f5"; fillcolor="#eaf3fb";
    Gestational_age [label="Gestational age\n(3rd trimester peak load)"];
    Plasma_volume [label="Plasma volume\nexpansion (+40-50%)"];
    Cardiac_output_preg [label="Physiologic ↑cardiac\noutput (+30-50%)"];
    SVR_fall [label="↓Systemic vascular\nresistance (placental shunt)"];
    HR_rise [label="↑Resting heart rate\n(+10-20 bpm)"];
    Physiologic_hypertrophy [label="Physiologic eccentric\nLV hypertrophy"];
    Relaxin [label="Relaxin\n(vascular remodeling)"];
    Estrogen_progesterone [label="Estrogen /\nprogesterone surge"];
    Delivery_event [label="DELIVERY\n(placental separation)", shape=octagon, fillcolor="#ffe9b3"];
    Autotransfusion [label="Postpartum uterine\nautotransfusion (preload spike)"];
    Lactation_demand [label="Lactation metabolic\ndemand"];
    Suckling_reflex [label="Suckling reflex →\nprolactin surge"];
    Wall_stress_peripartum [label="Peak LV wall stress\n(late gestation → early postpartum)"];
  }

  //==========================================================================
  subgraph cluster_prl {
    label="3. Prolactin Axis & Cathepsin D Cleavage (Core PPCM Driver)"; style=filled; color="#f5d9e8"; fillcolor="#fceaf3";
    Hypothalamic_dopamine [label="Hypothalamic dopamine\n(tonic D2 inhibition)"];
    D2_receptor_lactotroph [label="Pituitary lactotroph\nD2 receptor"];
    Lactotroph [label="Anterior pituitary\nlactotroph"];
    PRL23 [label="23-kDa PROLACTIN\n(full-length, prolactinemia)", fillcolor="#f7c2dd"];
    PRLR_JAK2_STAT5 [label="PRLR → JAK2/STAT5\n(pro-survival, pro-angiogenic)"];
    Cathepsin_D_pro [label="Pro-cathepsin D\n(lysosomal)"];
    Cathepsin_D_active [label="ACTIVE CATHEPSIN D\n(acidic/oxidative activation)", fillcolor="#f79ec8"];
    Cleavage_site [label="PRL cleavage at\nSer-Asn (aa 145-150)"];
    PRL16 [label="16-kDa PROLACTIN\n(VASOINHIBIN)", fillcolor="#e8478f", fontcolor="white"];
    PRL16_clearance [label="16K PRL\nclearance"];
    Bromocriptine_target [label="→ Pharmacologic target\n(D2 agonist)", shape=note, fillcolor="#d5f0d5"];
  }

  //==========================================================================
  subgraph cluster_ox {
    label="4. Oxidative Stress · STAT3 · MnSOD Axis"; style=filled; color="#fbdede"; fillcolor="#fdeeee";
    STAT3_cardio [label="Cardiomyocyte STAT3\n(↓ in PPCM myocardium)", fillcolor="#f7c9c9"];
    MnSOD_SOD2 [label="MnSOD (SOD2)\nmitochondrial antioxidant"];
    ROS_myocardial [label="MYOCARDIAL ROS\n(superoxide burden)", fillcolor="#f2a0a0"];
    NOX2_NOX4 [label="NOX2 / NOX4\nNADPH oxidase"];
    Peroxynitrite [label="Peroxynitrite\n(ONOO⁻)"];
    Uncoupled_eNOS [label="Uncoupled eNOS\n(BH4 depletion)"];
    Nrf2_pathway [label="↓Nrf2 antioxidant\nresponse"];
    Lysosomal_destab [label="Lysosomal\ndestabilization"];
    Mito_ROS_loop [label="Mitochondrial\nROS feed-forward loop", shape=ellipse];
    Oxidized_LDL_8iso [label="8-isoprostane /\noxLDL (oxidative markers)"];
  }

  //==========================================================================
  subgraph cluster_angio {
    label="5. Anti-Angiogenic Milieu (Placental & Metabolic)"; style=filled; color="#e3ecd8"; fillcolor="#eef5e5";
    Placenta [label="Placenta\n(late gestation)"];
    sFlt1 [label="sFlt-1 (soluble VEGFR-1)\nplacental release", fillcolor="#cfe0b8"];
    sEng [label="Soluble endoglin\n(sEng)"];
    PlGF_low [label="↓Placental growth\nfactor (PlGF)"];
    VEGF_total [label="Myocardial VEGF\nproduction"];
    PGC1a [label="Cardiac PGC-1α\n(metabolic/angiogenic master regulator)"];
    VEGF_free [label="FREE VEGF\n(bioavailable)", fillcolor="#bcd69c"];
    VEGFR2_signaling [label="Endothelial VEGFR-2\nsignaling"];
    Angiogenic_balance [label="Anti-angiogenic\nsignature (sFlt-1/PlGF ratio)", shape=ellipse, fillcolor="#dfeacb"];
    Two_hit_model [label="TWO-HIT MODEL:\n16K PRL + sFlt-1", shape=hexagon, fillcolor="#ffe0b3"];
  }

  //==========================================================================
  subgraph cluster_endo {
    label="6. Coronary Microvascular Endothelium"; style=filled; color="#d9f0ea"; fillcolor="#eafaf5";
    Coronary_endothelium [label="Coronary microvascular\nendothelial cell"];
    Endothelial_apoptosis [label="Endothelial\napoptosis"];
    Capillary_density [label="Myocardial capillary\ndensity (rarefaction)", fillcolor="#bfe8dc"];
    NO_bioavailability [label="↓NO bioavailability"];
    Endothelin1 [label="↑Endothelin-1"];
    Coronary_flow_reserve [label="↓Coronary flow\nreserve"];
    Microvascular_ischemia [label="Microvascular\nischemia", fillcolor="#a8ddcb"];
    Endothelial_dysfunction [label="Endothelial\ndysfunction (FMD↓)"];
    Pericyte_loss [label="Pericyte\ndetachment"];
    Vascular_permeability [label="↑Vascular\npermeability"];
  }

  //==========================================================================
  subgraph cluster_mir {
    label="7. 16K PRL → Endothelial Exosome → miR-146a Cardiomyocyte Axis"; style=filled; color="#e0dcf5"; fillcolor="#eeecfb";
    NFkB_endo [label="Endothelial\nNF-κB activation"];
    miR146a_endo [label="Endothelial\nmiR-146a-5p ↑"];
    Exosome_packaging [label="Exosome packaging\n& secretion"];
    Exosome_transfer [label="Exosome transfer to\ncardiomyocyte", shape=parallelogram];
    miR146a_serum [label="Serum miR-146a\n(PPCM-specific biomarker)", fillcolor="#cbc4f0"];
    miR146a_CM [label="Cardiomyocyte\nmiR-146a load", fillcolor="#b8afeb"];
    Erbb4 [label="↓Erbb4\n(neuregulin receptor)"];
    Nras [label="↓Nras"];
    Notch1 [label="↓Notch1"];
    Irak1 [label="↓Irak1"];
    NRG1_axis [label="Impaired neuregulin-1/\nErbB survival signaling"];
    CM_survival_signal [label="Cardiomyocyte survival &\nmetabolic signaling capacity", fillcolor="#a99ce6"];
  }

  //==========================================================================
  subgraph cluster_cm {
    label="8. Cardiomyocyte Injury, Energetics & Structural Remodeling"; style=filled; color="#f5e3d3"; fillcolor="#fbf1e6";
    Mito_dysfunction [label="Mitochondrial\ndysfunction"];
    ATP_production [label="↓ATP production /\nPCr:ATP ratio"];
    FAO_impairment [label="↓Fatty acid\noxidation"];
    Glucose_shift [label="Substrate shift to\nglycolysis"];
    Sarcomere_dysfunction [label="Sarcomere contractile\ndysfunction"];
    Ca_handling [label="Impaired Ca²⁺ handling\n(SERCA2a↓, RyR2 leak)"];
    CM_apoptosis [label="Cardiomyocyte\napoptosis"];
    CM_hypertrophy [label="Pathologic\nhypertrophy"];
    Autophagy_flux [label="Dysregulated\nautophagy flux"];
    Viable_CM_mass [label="VIABLE CONTRACTILE\nCARDIOMYOCYTE MASS", fillcolor="#f0c48f"];
    Fibroblast_activation [label="Cardiac fibroblast\nactivation"];
    TGFb_signal [label="TGF-β1 /\nSMAD2-3"];
    Collagen_deposition [label="Collagen I/III\ndeposition"];
    MMP_TIMP [label="MMP-2/9 : TIMP\nimbalance"];
    Myocardial_fibrosis [label="MYOCARDIAL FIBROSIS\n(LGE / T1 mapping)", fillcolor="#e8b476"];
    Galectin3 [label="Galectin-3\n(fibrosis biomarker)"];
  }

  //==========================================================================
  subgraph cluster_immune {
    label="9. Immune / Inflammatory & Viral Contribution"; style=filled; color="#f0e6d0"; fillcolor="#faf3e3";
    IFNg [label="IFN-γ"];
    TNFa [label="TNF-α"];
    IL6 [label="IL-6"];
    sFas_Fas [label="sFas / Fas\n(apoptosis marker, prognostic)"];
    CRP_hsCRP [label="hs-CRP"];
    Macrophage_infiltration [label="Myocardial macrophage\ninfiltration"];
    Anti_cardiac_autoAb [label="Anti-cardiac\nautoantibodies"];
    Fetal_microchimerism [label="Fetal microchimerism\n(alloimmune hypothesis)"];
    Parvo_B19_HHV6 [label="Parvovirus B19 /\nHHV-6 genomes"];
    Myocarditis_overlap [label="Myocarditis\nphenotype overlap"];
    Inflammatory_burden [label="SYSTEMIC INFLAMMATORY\nBURDEN", fillcolor="#eddfc0"];
  }

  //==========================================================================
  subgraph cluster_lv {
    label="10. LV Dysfunction, Chamber Remodeling & Hemodynamics"; style=filled; color="#d6e4f7"; fillcolor="#e7effc";
    LV_contractility [label="LV contractility\n(intrinsic)"];
    LVEF [label="LVEF (%)\nPRIMARY ENDPOINT", fillcolor="#9fc3f0", shape=doubleoctagon];
    LVEDD_LVEDV [label="LV end-diastolic\ndiameter / volume", fillcolor="#b8d3f5"];
    LVESV [label="LV end-systolic\nvolume"];
    Stroke_volume [label="Stroke volume"];
    Cardiac_output [label="Cardiac output"];
    LV_filling_pressure [label="↑LV filling pressure\n(E/e′, LVEDP)"];
    Functional_MR [label="Functional mitral\nregurgitation"];
    RV_involvement [label="RV dysfunction\n(TAPSE↓, ~30%)"];
    Pulmonary_congestion [label="Pulmonary\ncongestion"];
    Systemic_congestion [label="Systemic congestion\n(JVP, edema)"];
    GLS_strain [label="↓Global longitudinal\nstrain"];
    Wall_stress [label="LV wall stress\n(Laplace)", shape=ellipse];
    Reverse_remodeling [label="REVERSE REMODELING\n(recovery pathway)", fillcolor="#c8e6c9", shape=hexagon];
  }

  //==========================================================================
  subgraph cluster_neuro {
    label="11. Neurohormonal Activation"; style=filled; color="#f7e0f0"; fillcolor="#fcefF8";
    RAAS [label="RAAS activation\n(renin → Ang II)"];
    Aldosterone [label="Aldosterone"];
    AT1_receptor [label="AT1 receptor\nsignaling"];
    SNS_NE [label="Sympathetic activation\n(norepinephrine)"];
    Beta1_downreg [label="β1-adrenoceptor\ndownregulation"];
    Vasopressin [label="Arginine vasopressin\n(ADH)"];
    Na_water_retention [label="Renal Na⁺/water\nretention"];
    Renal_perfusion [label="↓Renal perfusion\n(cardiorenal)"];
    NPs_ANP_BNP [label="ANP / BNP release\n(wall-stress driven)"];
    Neprilysin [label="Neprilysin (NEP)\nNP degradation"];
    NTproBNP [label="NT-proBNP (pg/mL)\nKEY BIOMARKER", fillcolor="#eeb8e0"];
    cGMP_axis [label="NP → cGMP\ncounter-regulation"];
    Neurohormonal_index [label="COMPOSITE NEUROHORMONAL\nACTIVATION", fillcolor="#e8a5d8"];
  }

  //==========================================================================
  subgraph cluster_pk_brc {
    label="12. Drug PK/PD — Bromocriptine (Disease-Specific, BOARD Concept)"; style=filled; color="#d5f0d5"; fillcolor="#e9f9e9";
    BRC_dose [label="Bromocriptine PO\n2.5 mg BID → OD", shape=note];
    BRC_gut [label="GI absorption\n(F ≈ 6%, high first-pass)"];
    BRC_central [label="Bromocriptine\nplasma (central)", fillcolor="#b8e6b8"];
    BRC_periph [label="Peripheral\ndistribution"];
    BRC_CYP3A4 [label="CYP3A4 hepatic\nmetabolism"];
    BRC_biliary [label="Biliary/fecal\nelimination"];
    BRC_D2_agonism [label="Pituitary D2 receptor\nAGONISM", fillcolor="#8fd98f"];
    BRC_PRL_suppression [label="↓↓23-kDa prolactin\nsecretion", fillcolor="#8fd98f"];
    BRC_lactation_supp [label="Lactation\nsuppression"];
    BRC_1wk [label="1-week regimen\n(2.5 mg BID × 7 d)"];
    BRC_8wk [label="8-week regimen\n(BID × 2 wk → OD × 6 wk)"];
    BRC_thrombotic_risk [label="Prothrombotic risk →\nMANDATORY anticoagulation", fillcolor="#f7d6d6"];
    BRC_AE [label="Headache, nausea,\northostatic hypotension"];
    BOARD_bundle [label="BOARD: Bromocriptine,\nOral HF therapy, Anticoagulation,\nvasoRelaxing agents, Diuretics", shape=note, fillcolor="#ffe9b3"];
  }

  //==========================================================================
  subgraph cluster_pk_hf {
    label="13. Drug PK/PD — Guideline Heart-Failure Pharmacotherapy"; style=filled; color="#dde8f0"; fillcolor="#edf4fa";
    BB_drug [label="β-blocker\n(metoprolol succ. / bisoprolol / carvedilol)", fillcolor="#c5dcee"];
    BB_beta1_block [label="β1 blockade → ↓HR,\n↓NE toxicity, ↑β1 density"];
    ACEI_ARB [label="ACE inhibitor / ARB\n(POSTPARTUM ONLY)", fillcolor="#c5dcee"];
    ACEI_fetotoxicity [label="Antepartum\nFETOTOXICITY (renal)", fillcolor="#f7d6d6"];
    ARNI [label="Sacubitril/valsartan\n(ARNI, post-lactation)"];
    ARNI_NEP_inhib [label="Neprilysin inhibition\n→ ↑NP/cGMP"];
    MRA_drug [label="MRA (spironolactone /\neplerenone)"];
    MRA_antifibrotic [label="Aldosterone blockade\n→ antifibrotic"];
    SGLT2i [label="SGLT2 inhibitor\n(dapagliflozin/empagliflozin)"];
    SGLT2i_effect [label="Natriuresis, ↓preload,\nmetabolic/anti-remodeling"];
    Loop_diuretic [label="Loop diuretic\n(furosemide)"];
    Hydralazine_nitrate [label="Hydralazine + nitrate\n(ANTEPARTUM-safe vasodilator)"];
    Ivabradine [label="Ivabradine\n(HR control if BB-limited)"];
    Digoxin [label="Digoxin\n(low dose, lactation-compatible)"];
    Anticoagulation [label="Anticoagulation\n(LMWH → warfarin)", fillcolor="#c5dcee"];
    Levosimendan [label="Levosimendan\n(no proven benefit)"];
    IVIG_PTX [label="IVIG / pentoxifylline\n(historical, unproven)"];
    Afterload_reduction [label="Afterload / preload\nreduction"];
    Breastfeeding_compat [label="Breastfeeding\ncompatibility filter", shape=diamond, fillcolor="#ffe9b3"];
  }

  //==========================================================================
  subgraph cluster_device {
    label="14. Device, Mechanical Support & Obstetric Management"; style=filled; color="#e6e6e6"; fillcolor="#f2f2f2";
    WCD [label="Wearable cardioverter\ndefibrillator (bridge)"];
    ICD_decision [label="ICD deferral pending\nrecovery (3-6 mo)", shape=diamond];
    IABP_ECMO [label="IABP / VA-ECMO\n(cardiogenic shock)"];
    LVAD [label="LVAD\n(bridge to recovery/transplant)"];
    Transplant [label="Heart\ntransplantation"];
    Delivery_timing [label="Delivery timing &\nmode decision", shape=diamond];
    Preterm_delivery [label="Preterm delivery /\nneonatal outcome"];
    CRT_consider [label="CRT if persistent\ndyssynchrony"];
    Contraception_counsel [label="Contraception &\nsubsequent-pregnancy counseling", shape=diamond];
  }

  //==========================================================================
  subgraph cluster_end {
    label="15. Clinical Endpoints, Complications & Outcomes"; style=filled; color="#fce8d5"; fillcolor="#fef4ea";
    NYHA_class [label="NYHA functional\nclass I-IV", fillcolor="#f7cfa8"];
    SixMWT [label="6-minute walk\ndistance"];
    LVEF_recovery [label="LVEF RECOVERY ≥50%\n(6-12 mo; ~46-72%)", fillcolor="#f7b877", shape=doubleoctagon];
    Persistent_dysfunction [label="Persistent LV\ndysfunction"];
    LV_thrombus [label="LV thrombus\n(risk ↑ if LVEF<35%)", fillcolor="#f7d6d6"];
    Thromboembolism [label="Stroke / systemic\nthromboembolism"];
    Ventricular_arrhythmia [label="Ventricular arrhythmia /\nsudden cardiac death"];
    Cardiogenic_shock [label="Cardiogenic shock\n(~5-10%)", fillcolor="#f2a0a0"];
    Rehospitalization [label="HF\nrehospitalization"];
    Mortality [label="Mortality\n(6 mo ~2-6%; regional variation)", fillcolor="#e07070", fontcolor="white"];
    MACE_composite [label="MACE composite\n(death/LVAD/transplant)"];
    Subsequent_pregnancy [label="Subsequent pregnancy\nRELAPSE risk", shape=hexagon, fillcolor="#ffd9b3"];
    QoL_KCCQ [label="Quality of life\n(KCCQ)"];
    Maternal_bonding [label="Lactation cessation /\nmaternal-infant bonding impact"];
    Depression_anxiety [label="Peripartum depression /\nanxiety burden"];
  }

  //==========================================================================
  // EDGES — 1. Genetic substrate
  //==========================================================================
  TTN_trunc -> Sarcomere_reserve [label="haploinsufficiency"];
  Sarcomere_reserve -> Sarcomere_dysfunction [label="fails under peripartum load"];
  BAG3_var -> Autophagy_flux;
  DSP_var -> CM_apoptosis;
  MYH7_TNNT2 -> Sarcomere_dysfunction;
  LMNA_var -> Ventricular_arrhythmia;
  FLNC_var -> Myocardial_fibrosis;
  DCM_shared_arch -> TTN_trunc [style=dashed];
  Family_history -> DCM_shared_arch;
  TTN_trunc -> LVEF_recovery [label="↓recovery at 12 mo", color="#b03060", style=bold];
  African_ancestry -> LVEF_recovery [label="↓recovery (59% vs 77%)", color="#b03060"];
  African_ancestry -> Mortality [color="#b03060"];
  Multiparity -> PRL23;
  Advanced_age -> Endothelial_dysfunction;
  Multiple_gestation -> Placenta [label="↑placental mass"];
  Multiple_gestation -> Plasma_volume;
  Preeclampsia_HDP -> sFlt1 [label="↑↑", color="#b03060", style=bold];
  Preeclampsia_HDP -> Wall_stress [label="↑afterload"];
  Preeclampsia_HDP -> Endothelial_dysfunction;
  Tocolytic_exposure -> SNS_NE;
  Anemia_malnutrition -> Cardiac_output_preg;
  Selenium_def -> MnSOD_SOD2 [label="↓selenoprotein antioxidants"];
  Low_SES_access -> Mortality [label="delayed diagnosis"];

  //==========================================================================
  // EDGES — 2. Peripartum hemodynamic load
  //==========================================================================
  Gestational_age -> Plasma_volume;
  Gestational_age -> Placenta;
  Plasma_volume -> Cardiac_output_preg;
  SVR_fall -> Cardiac_output_preg;
  HR_rise -> Cardiac_output_preg;
  Cardiac_output_preg -> Physiologic_hypertrophy;
  Physiologic_hypertrophy -> Wall_stress_peripartum;
  Relaxin -> SVR_fall;
  Estrogen_progesterone -> Plasma_volume;
  Estrogen_progesterone -> Lactotroph [label="lactotroph hyperplasia"];
  Gestational_age -> Delivery_event;
  Delivery_event -> Autotransfusion;
  Delivery_event -> Suckling_reflex;
  Delivery_event -> Placenta [label="placental separation → sFlt-1 falls", style=dashed];
  Autotransfusion -> Wall_stress_peripartum [label="preload spike"];
  Suckling_reflex -> PRL23 [label="↑↑ postpartum surge", style=bold];
  Lactation_demand -> ATP_production [label="metabolic drain", style=dashed];
  Wall_stress_peripartum -> Wall_stress;
  Wall_stress_peripartum -> ROS_myocardial [label="mechanical → oxidative"];

  //==========================================================================
  // EDGES — 3. Prolactin / cathepsin D core axis
  //==========================================================================
  Hypothalamic_dopamine -> D2_receptor_lactotroph;
  D2_receptor_lactotroph -> Lactotroph [label="inhibits", arrowhead=tee];
  Lactotroph -> PRL23 [label="secretion"];
  PRL23 -> PRLR_JAK2_STAT5 [label="intact 23K signaling"];
  PRLR_JAK2_STAT5 -> VEGF_total [label="pro-angiogenic"];
  Cathepsin_D_pro -> Cathepsin_D_active [label="acidic/oxidative activation"];
  ROS_myocardial -> Cathepsin_D_active [label="ACTIVATES", color="#b03060", style=bold];
  Lysosomal_destab -> Cathepsin_D_active;
  Cathepsin_D_active -> Cleavage_site;
  PRL23 -> Cleavage_site [label="substrate"];
  Cleavage_site -> PRL16 [label="16-kDa fragment", style=bold];
  PRL16 -> PRL16_clearance;
  Bromocriptine_target -> D2_receptor_lactotroph [style=dashed, color="#2e8b57"];

  //==========================================================================
  // EDGES — 4. Oxidative stress / STAT3
  //==========================================================================
  STAT3_cardio -> MnSOD_SOD2 [label="transcriptional induction"];
  MnSOD_SOD2 -> ROS_myocardial [label="detoxifies O2⁻", arrowhead=tee];
  NOX2_NOX4 -> ROS_myocardial;
  Uncoupled_eNOS -> ROS_myocardial;
  ROS_myocardial -> Peroxynitrite;
  Peroxynitrite -> Uncoupled_eNOS [label="BH4 oxidation"];
  Peroxynitrite -> NO_bioavailability [arrowhead=tee];
  Nrf2_pathway -> ROS_myocardial [arrowhead=tee];
  ROS_myocardial -> Lysosomal_destab;
  ROS_myocardial -> Mito_ROS_loop;
  Mito_ROS_loop -> ROS_myocardial [label="feed-forward", style=bold, color="#b03060"];
  ROS_myocardial -> Oxidized_LDL_8iso;
  ROS_myocardial -> Mito_dysfunction;
  Inflammatory_burden -> NOX2_NOX4;
  Inflammatory_burden -> STAT3_cardio [label="IL-6/JAK partial compensation", style=dashed];

  //==========================================================================
  // EDGES — 5. Anti-angiogenic milieu
  //==========================================================================
  Placenta -> sFlt1;
  Placenta -> sEng;
  Placenta -> PlGF_low;
  sFlt1 -> VEGF_free [label="ligand trap", arrowhead=tee, style=bold, color="#b03060"];
  sEng -> VEGFR2_signaling [arrowhead=tee];
  PlGF_low -> Angiogenic_balance;
  sFlt1 -> Angiogenic_balance;
  PGC1a -> VEGF_total [label="drives VEGF transcription"];
  PGC1a -> MnSOD_SOD2 [label="antioxidant program"];
  PGC1a -> Mito_dysfunction [arrowhead=tee];
  VEGF_total -> VEGF_free;
  VEGF_free -> VEGFR2_signaling;
  VEGFR2_signaling -> Endothelial_apoptosis [arrowhead=tee, label="survival"];
  PRL16 -> Two_hit_model;
  sFlt1 -> Two_hit_model;
  Two_hit_model -> Capillary_density [label="synergistic rarefaction", arrowhead=tee, style=bold, color="#b03060"];
  Angiogenic_balance -> Microvascular_ischemia;

  //==========================================================================
  // EDGES — 6. Coronary microvascular endothelium
  //==========================================================================
  PRL16 -> Coronary_endothelium [label="anti-angiogenic, pro-apoptotic", style=bold, color="#b03060"];
  Coronary_endothelium -> Endothelial_apoptosis;
  Endothelial_apoptosis -> Capillary_density [arrowhead=tee];
  Capillary_density -> Coronary_flow_reserve;
  Coronary_flow_reserve -> Microvascular_ischemia [arrowhead=tee];
  NO_bioavailability -> Endothelial_dysfunction [arrowhead=tee];
  Endothelin1 -> Coronary_flow_reserve [arrowhead=tee];
  Endothelial_dysfunction -> Endothelin1;
  Pericyte_loss -> Capillary_density [arrowhead=tee];
  Endothelial_apoptosis -> Vascular_permeability;
  Vascular_permeability -> Pulmonary_congestion;
  Microvascular_ischemia -> ATP_production [arrowhead=tee, style=bold];
  Microvascular_ischemia -> CM_apoptosis;
  Microvascular_ischemia -> ROS_myocardial;

  //==========================================================================
