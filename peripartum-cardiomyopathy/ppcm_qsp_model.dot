  Levosimendan -> Cardiac_output [label="transient; neutral outcome", style=dashed];
  IVIG_PTX -> Inflammatory_burden [style=dashed, label="unproven"];
  Breastfeeding_compat -> ACEI_ARB [label="enalapril/captopril OK", style=dotted];
  Breastfeeding_compat -> ARNI [label="avoid", style=dotted];
  Breastfeeding_compat -> SGLT2i [label="avoid", style=dotted];
  Breastfeeding_compat -> BRC_dose [label="incompatible (suppresses lactation)", style=dotted];

  //==========================================================================
  // EDGES — 14. Devices & obstetric management
  //==========================================================================
  LVEF -> WCD [arrowhead=tee, label="bridge if EF<35%"];
  WCD -> Ventricular_arrhythmia [arrowhead=tee, label="terminates VT/VF"];
