  //==========================================================================
  LV_contractility -> LVEF [style=bold];
  LV_contractility -> Stroke_volume;
  LVEDD_LVEDV -> LVEF [arrowhead=tee, label="dilation dilutes EF"];
  LVEDD_LVEDV -> Wall_stress [label="Laplace radius term", style=bold];
