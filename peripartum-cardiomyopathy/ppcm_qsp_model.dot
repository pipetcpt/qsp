  //==========================================================================
  // EDGES — 11. Neurohormonal
  //==========================================================================
  Renal_perfusion -> RAAS [arrowhead=tee];
  RAAS -> AT1_receptor;
  RAAS -> Aldosterone;
  AT1_receptor -> Fibroblast_activation;
  AT1_receptor -> CM_hypertrophy;
