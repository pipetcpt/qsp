        VENLA    [label = "SNRI / 부프로피온\nvenlafaxine · bupropion\nsecond-line"];
        ESK      [label = "에스케타민 / 케타민\n(es)ketamine\nperi-caesarean prophylaxis\n0.2-0.5 mg/kg"];
