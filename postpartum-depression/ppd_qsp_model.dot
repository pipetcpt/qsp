        MILKEJ   [label = "사출 반사\nmilk ejection reflex\nfails under stress"];
        BFEED    [label = "모유수유 지속\nbreastfeeding continuation\nbidirectional with mood"];
        BOND     [label = "모아 결합\nmother-infant bonding\nMIBS-J / PBQ", fillcolor = "#f3bdd0", penwidth = 2.2];
        INFCUE   [label = "영아 신호 반응성\ninfant cue responsiveness\nface / cry processing"];
