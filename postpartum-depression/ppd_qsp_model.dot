        CYP2C19  [label = "CYP2C19 / 2D6 / 3A4\nsertraline metabolism\npoor-metaboliser exposure &#8593;"];
        SSRIPD   [label = "SERT 점유\nSERT occupancy &#8776; 80 %\nat therapeutic dose\nIMMEDIATE"];
