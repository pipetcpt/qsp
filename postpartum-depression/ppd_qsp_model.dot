        EPDS     [label = "EPDS\nEdinburgh scale (10 items)\ncut-off 12/13 &#183; screening"];
        EPDS3A   [label = "EPDS-3A\nanxiety subscale\n(items 3,4,5)"];
        MADRS    [label = "MADRS\nsecondary in trials"];
        CGII     [label = "CGI-I\nglobal impression"];
        GAD7     [label = "GAD-7 / HAM-A\ncomorbid anxiety\n&#8776; 2/3 of PPD"];
