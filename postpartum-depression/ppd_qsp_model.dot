                   shape = note, fillcolor = "#f9e79f", color = "#b7950b", penwidth = 2.6, fontsize = 12];
        GANAX    [label = "차세대 후보\nganaxolone · SAGE-324\nzuranolone in MDD\nnext-generation PAMs"];
