        PAMTOT   [label = "총 PAM 농도\nTOTAL PAM (ALLO-equivalents)\nendogenous + drug\nthe INPUT to potentiation", fillcolor = "#7dcea0", penwidth = 3.0];
        POTENT   [label = "잠재화 함수\npotentiation\nEmax &#183; PAM^h / (EC&#8325;&#8320;^h + PAM^h)\nEC&#8325;&#8320; &#8776; 60 nM (&#948;) · h &#8776; 1.4"];
        SEDATION [label = "진정·과다졸림\nsedation · somnolence\n(site-2 direct activation)\ndose-limiting"];
