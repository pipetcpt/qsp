    /* ================================================================= 14 */
    subgraph cluster_end {
        label = <<b>14 · 임상 엔드포인트</b><br/>Clinical endpoints and their model mapping>;
        style = "filled,rounded"; fillcolor = "#f2f4f4"; color = "#212f3d";
        fontsize = 14; fontcolor = "#17202a";
        node [fillcolor = "#dfe3e6", color = "#212f3d"];

        SYMPT    [label = "잠재 증상 부하\nlatent symptom load S\nthe model's core PD variable", fillcolor = "#aeb6bf", penwidth = 3.0];
        HAMD     [label = "HAM-D&#8321;&#8327;\nprimary endpoint of ALL\nPPD neurosteroid trials\nbaseline 26-29 (severe)", penwidth = 2.4];
        HAMDD3   [label = "HAM-D at day 3\nEARLY separation\ndiscriminates mechanisms"];
