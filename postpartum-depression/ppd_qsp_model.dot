        node [fillcolor = "#fbe3bc", color = "#9c640c"];

        MPRATIO  [label = "유즙/혈장 비\nmilk:plasma (M/P) ratio\nlipophilic drugs &#8805; 1"];
        MILKDRUG [label = "유즙 내 약물량\ndrug in milk compartment\nfat content &#215; M/P &#215; C_plasma"];
        MILKVOL  [label = "유즙 섭취량\ninfant milk intake\n150 mL/kg/day"];
