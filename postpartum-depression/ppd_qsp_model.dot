        BRXID    [label = "약리학적 동일성\nPHARMACOLOGICAL IDENTITY\nbrexanolone IS allopregnanolone\n&#8594; potency ratio exactly 1", shape = note, fillcolor = "#f9e79f", color = "#b7950b"];
        ZURPO    [label = "주라놀론 경구\nzuranolone (Zurzuvae)\nSAGE-217 · 50 mg &#215; 14 d\nonce daily with fat", penwidth = 2.4];
        ZURPK    [label = "주라놀론 PK\noral · t&#189; &#8776; 16-23 h\nfood &#8593; exposure &#8776; 3&#215;\naccumulation to day 3-5"];
