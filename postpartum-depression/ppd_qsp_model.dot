        THYRX    [label = "레보티록신\nlevothyroxine\nif postpartum thyroiditis"];
        CBT      [label = "CBT / IPT\npsychotherapy\nfirst-line for mild-moderate\nROSE program (prevention)"];
        BLT      [label = "광치료 / 운동\nbright light · exercise\ncircadian + BDNF arms"];
        ECT      [label = "ECT / rTMS\nsevere · psychotic · suicidal\nfastest for emergencies"];
        SLEEPIX  [label = "수면 보호 중재\nprotected sleep block\n(night nurse / partner shift)\nbreaks the vicious cycle"];
        SCREEN   [label = "선별검사\nEPDS screening\nUSPSTF · ACOG\ndetection is the bottleneck"];
    }

