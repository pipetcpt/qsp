/* ===========================================================================
   ppd_qsp_model.dot
   Postpartum depression (PPD) / 산후우울증 — QSP mechanistic map
   Peripartum-onset major depressive disorder · DSM-5-TR 296.xx with
   peripartum onset specifier

   14 mechanism clusters (+1 legend), 207 nodes, 294 edges.

   The map is laid out around ONE organising idea, and every cluster is
   positioned relative to it:

       The concentration of allopregnanolone (ALLO) FALLS with a half-life of
       hours after placental expulsion.  The extrasynaptic delta-subunit
       GABA_A receptor pool that allopregnanolone acts ON was homeostatically
       DOWN-regulated during pregnancy and re-expands with a half-life of
       DAYS.  Tonic inhibition is the PRODUCT of the two.  A product of a
       fast-falling ligand and a slow-recovering receptor has a TRANSIENT
       TROUGH that neither factor has on its own.

   So the disease in this map is not "low allopregnanolone" (levels are the
   same in women who do and do not become depressed) and not "abnormal
   receptors" (the plasticity is normal, adaptive pregnancy physiology).  It
   is a MISMATCH OF TIME CONSTANTS, gated by how much tonic-inhibition
   reserve a given woman has.  Cluster 3 is therefore the centre of the map:
   everything to its left sets the LIGAND trajectory, everything inside it
   sets the RECEPTOR trajectory, and everything to its right is what the
   product then does to circuits, the HPA axis, and the mother.

   Reading the map:
     * solid black edges       = mass flow / synthesis / conversion
     * blue edges              = neural / signalling drive
     * red edges (tee arrow)   = inhibition, suppression, down-regulation
     * green edges             = therapeutic action
     * dashed edges            = slow (days-weeks) adaptive / plastic change
     * dotted edges            = measurement / read-out mapping

   Render:
     dot -Tsvg ppd_qsp_model.dot -o ppd_qsp_model.svg
     dot -Tpng -Gdpi=150 ppd_qsp_model.dot -o ppd_qsp_model.png
   =========================================================================== */
digraph PPD_QSP {
    rankdir = LR;
    compound = true;
    newrank = true;
    splines = spline;
    fontname = "Helvetica";
    labelloc = "t";
    label = <<b>Postpartum Depression · 산후우울증 QSP Map</b><br/>
             <i>placental neurosteroid withdrawal (hours) &#215; delta-GABA<sub>A</sub> receptor re-expansion (days) &#8594; a transient trough in tonic inhibition</i><br/>
             <font point-size="12">the hormone trajectory is normal in PPD &#183; the response to it is not &#183; brexanolone and zuranolone are BRIDGES across the trough</font>>;
    fontsize = 26;
    bgcolor = "white";
    node [shape = box, style = "rounded,filled", fontname = "Helvetica",
          fontsize = 11, penwidth = 1.2, margin = "0.10,0.055"];
    edge [fontname = "Helvetica", fontsize = 9, penwidth = 1.1,
          color = "#5a6472", arrowsize = 0.7];

    /* ================================================================== 1 */
    subgraph cluster_synth {
        label = <<b>1 · 임신 중 신경스테로이드 생합성</b><br/>Placental and neural neurosteroidogenesis>;
        style = "filled,rounded"; fillcolor = "#eaf3fb"; color = "#2471a3";
        fontsize = 14; fontcolor = "#1a5276";
        node [fillcolor = "#cfe4f5", color = "#2471a3"];

        PLAC     [label = "태반 (합성영양세포)\nplacenta · syncytiotrophoblast\nmass &#8593; to term"];
        MATCHOL  [label = "모체 LDL 콜레스테롤\nmaternal LDL-C\nsubstrate supply"];
        LDLR     [label = "LDL 수용체\nLDLR · SR-B1\ntrophoblast uptake"];
        STAR     [label = "STAR / TSPO\ncholesterol import\nto inner mitochondrial\nmembrane"];
        CYP11A1  [label = "CYP11A1 (P450scc)\nrate-limiting step\ncholesterol &#8594; pregnenolone"];
        PREG     [label = "프레그네놀론\npregnenolone"];
        HSD3B1   [label = "3&#946;-HSD type 1\nHSD3B1 (placental)"];
        P4       [label = "프로게스테론 (P4)\n3rd trimester\n&#8776; 300-500 nM plasma\nplacental, not luteal", fillcolor = "#aed3f0", penwidth = 2.4];
        SRD5A1   [label = "5&#945;-환원효소 1형\nSRD5A1\nP4 &#8594; 5&#945;-DHP\n(irreversible, brain + liver)"];
        DHP      [label = "5&#945;-디하이드로프로게스테론\n5&#945;-DHP\nPR-active intermediate"];
        AKR1C2   [label = "3&#945;-HSD (AKR1C2/AKR1C1)\nreductive direction\n5&#945;-DHP &#8594; ALLO"];
        ALLOP    [label = "알로프레그나놀론 (혈장)\nallopregnanolone · ALLO\n3&#945;,5&#945;-THP\nterm &#8776; 30-150 nM\nday 4 pp &#8776; 1-5 nM", fillcolor = "#7fb8e6", penwidth = 3.0];
        ISOALLO  [label = "이소알로프레그나놀론\nisoallopregnanolone (3&#946;,5&#945;)\nfunctional ALLO ANTAGONIST\nratio matters, not ALLO alone"];
        PREGNANO [label = "프레그나놀론 (3&#945;,5&#946;)\npregnanolone\nsecond PAM species"];
        THDOC    [label = "THDOC (3&#945;,5&#945;-THDOC)\nfrom deoxycorticosterone\nSTRESS-inducible PAM"];
        AKR1C3   [label = "AKR1C3 / 20&#945;-HSD\noxidative back-conversion\nALLO &#8594; 5&#945;-DHP"];
        UGT2B7   [label = "UGT2B7 글루쿠론산 결합\n+ SULT2A1 sulfation\nALLO clearance\nCL &#8776; 1 L/h/kg"];
        ALLOGLU  [label = "ALLO-glucuronide\n/ ALLO-sulfate\ninactive, renal"];
        BRSYN    [label = "뇌 국소 신경스테로이드 합성\nde-novo brain synthesis\nastrocyte + principal neuron\nTSPO · SRD5A1 · AKR1C2"];
        ASTRO    [label = "성상교세포\nastrocyte\nlocal ALLO source\n(persists after delivery)"];
        BBBST    [label = "혈액뇌장벽 통과\nlipophilic · logP &#8776; 4\nfree diffusion\nKp(brain:plasma) &#8776; 1.5-3"];
        ALLOB    [label = "뇌 ALLO 농도\nbrain [ALLO]\nEFFECTOR SPECIES", fillcolor = "#5aa3dd", penwidth = 3.0, fontcolor = "white"];
    }

    /* ================================================================== 2 */
    subgraph cluster_delivery {
        label = <<b>2 · 분만 &#8212; 급성 스테로이드 금단</b><br/>Parturition: the fastest endocrine withdrawal in human physiology>;
        style = "filled,rounded"; fillcolor = "#fdf1e3"; color = "#ca6f1e";
        fontsize = 14; fontcolor = "#a04000";
        node [fillcolor = "#fbdfc0", color = "#ca6f1e"];

        LABOR    [label = "진통·분만\nlabour · delivery\nt = 0"];
        PLACDEL  [label = "태반 배출\nplacental expulsion\nSOURCE TERM &#8594; 0\nwithin minutes", penwidth = 2.4];
        P4FALL   [label = "P4 붕괴\nplasma P4 t&#189; &#8776; 3-6 h\n&#8594; <1 % of term by 72 h", fillcolor = "#f8cb9c"];
        ALLOFALL [label = "ALLO 붕괴\nplasma ALLO t&#189; &#8776; 8-20 h\nnadir by day 3-5\n90-98 % fall", fillcolor = "#f5b97e", penwidth = 2.4];
        E2FALL   [label = "E2 붕괴\nestradiol 60-80 nM &#8594; <0.2 nM\n100-1000&#215; fall in 5 days", fillcolor = "#f8cb9c"];
        CRHFALL  [label = "태반 CRH 소실\nplacental CRH withdrawal\npg/mL &#8594; undetectable"];
        LACTII   [label = "유선 분비 개시 II\nlactogenesis II\nday 2-4\n(requires P4 fall)"];
        PRLSURGE [label = "프로락틴 급증\nprolactin 200-400 ng/mL\nsuckling-driven pulses"];
        OXTSURGE [label = "옥시토신 방출\noxytocin pulses\nlabour + suckling"];
        BLEED    [label = "산후 출혈·빈혈\nPPH · Hb &#8595; · Fe deficiency\n(independent mood risk)"];
        ANESTH   [label = "제왕절개·마취\ncaesarean · neuraxial\nanaesthesia · opioids"];
        PPPAIN   [label = "산후 통증\nperineal / incisional pain\nnociceptive drive"];
        THYRPP   [label = "산후 갑상선염\npostpartum thyroiditis\n5-7 % &#183; TSH shift\nmimics + worsens PPD"];
    }

    /* ================================================================== 3 */
    subgraph cluster_receptor {
        label = <<b>3 · GABA&#8329; 수용체 가소성 &#8212; 지도의 중심</b><br/>delta-subunit GABA_A plasticity: the SLOW variable>;
        style = "filled,rounded"; fillcolor = "#eafaf1"; color = "#1e8449";
        fontsize = 15; fontcolor = "#145a32";
        node [fillcolor = "#c8ecd8", color = "#1e8449"];

        GABAAR   [label = "GABA&#8329; 수용체 펜타머\nGABA_A pentamer\n2&#945; : 2&#946; : 1(&#947;/&#948;)"];
        NSSITE1  [label = "신경스테로이드 결합부위 1\n&#946;(+)&#945;(-) transmembrane site\nPOTENTIATION (nM range)\nHosie 2006"];
        NSSITE2  [label = "결합부위 2\n&#945; intrasubunit site\nDIRECT ACTIVATION (&#956;M)\n&#8594; sedation / LOC"];
        DELTA    [label = "&#948; 소단위\ndelta subunit (GABRD)\nEXTRASYNAPTIC only\nno benzodiazepine site", fillcolor = "#9fdcbb", penwidth = 2.4];
        A4       [label = "&#945;4 소단위\nGABRA4\npartners &#948;"];
        A5       [label = "&#945;5 소단위\nGABRA5 (hippocampal)\ntonic component"];
        G2       [label = "&#947;2 소단위\nGABRG2 · SYNAPTIC\nreciprocal to &#948;"];
        A1       [label = "&#945;1 소단위\nGABRA1 · phasic"];
        TONICR   [label = "세포외 시냅스 수용체 풀\nextrasynaptic &#948;-receptor pool R&#948;\nDOWN-regulated by chronic\nhigh ALLO in pregnancy\nrecovery t&#189; &#8776; 5-10 DAYS", fillcolor = "#6ecb96", penwidth = 3.0];
        SETPOINT [label = "항상성 설정점\nhomeostatic set-point\nR&#948;,ss = R&#8320; / (1 + PAM/IC&#8325;&#8320;)\nADAPTIVE, not pathological", fillcolor = "#9fdcbb"];
        PHASICR  [label = "시냅스 수용체 풀\nsynaptic &#947;2 pool\nreciprocally UP in pregnancy"];
        TONICG   [label = "긴장성 억제 전도도\nG_tonic = G&#8320; &#215; R&#948; &#215; PAM-potentiation\nTHE PRODUCT\nthis is what troughs", fillcolor = "#27ae60", penwidth = 3.4, fontcolor = "white"];
        PHASICG  [label = "위상성 억제\nphasic IPSC\nmIPSC amplitude / decay"];
        KCC2     [label = "KCC2 (SLC12A5)\nCl&#8315; extruder\nsurface expression &#8595; by\nstress / BDNF-TrkB / PKC"];
        NKCC1    [label = "NKCC1 (SLC12A2)\nCl&#8315; importer"];
        ECL      [label = "E_Cl / E_GABA\nchloride reversal potential\nsets SIGN of GABA response"];
        DEPOL    [label = "탈분극성 GABA\ndepolarising GABA\nwhen KCC2 &#8595;&#8595;\n&#8594; PVN disinhibition", fillcolor = "#f5b7b1", color = "#c0392b"];
        TRAFFIC  [label = "수용체 인편·재순환\ntrafficking · phosphorylation\nPKC&#949; · radixin · gephyrin"];
        MISMATCH [label = "&#9204; 시간상수 불일치\nTIMESCALE MISMATCH\n&#964;(ligand) &#8776; 12 h\n&#964;(receptor) &#8776; 7 d\nratio &#8776; 14 &#8594; TROUGH WIDTH",
                  shape = note, fillcolor = "#f9e79f", color = "#b7950b", penwidth = 2.6, fontsize = 12];
        RESERVE  [label = "긴장성 억제 예비능\ntonic-inhibition RESERVE\ndistance from threshold\n= the vulnerability gate", fillcolor = "#9fdcbb", penwidth = 2.0];
    }

    /* ================================================================== 4 */
    subgraph cluster_circuit {
        label = <<b>4 · 피질-편도-해마-시상하부 회로</b><br/>Cortico-limbic and PVN circuits: where the trough is felt>;
        style = "filled,rounded"; fillcolor = "#f4ecf7"; color = "#7d3c98";
        fontsize = 14; fontcolor = "#4a235a";
        node [fillcolor = "#e0cef0", color = "#7d3c98"];

        DG       [label = "치아이랑 과립세포\ndentate gyrus granule cell\nhighest &#948; density\ngatekeeper of hippocampus"];
        CA1      [label = "CA1 / CA3\nhippocampal output\ncontext + memory"];
        PVNCRH   [label = "PVN CRH 뉴런\nPVN CRH neuron\n&#948;-GABA_A ON these cells\n&#8594; tonic brake on HPA", penwidth = 2.4];
        BLA      [label = "기저측 편도\nbasolateral amygdala\nthreat salience\ninfant-cry reactivity &#8593;"];
        CEA      [label = "중심 편도\ncentral amygdala\nCRF interneurons"];
        MPFC     [label = "내측 전전두피질\nmPFC\ntop-down control &#8595;"];
        SGACC    [label = "슬하 전대상피질\nsubgenual ACC\nnegative affect hub"];
        INSULA   [label = "섬피질\ninsula\ninteroception"];
        NAC      [label = "측좌핵\nnucleus accumbens\nreward &#8594; anhedonia"];
        VTA      [label = "VTA 도파민\nVTA dopamine\nmotivation · pup-seeking"];
        LC       [label = "청색반점 NE\nlocus coeruleus\nhyperarousal · insomnia"];
        PVINT    [label = "PV / SST 억제 뉴런\nPV / SST interneurons\nfeedforward inhibition"];
        GLU      [label = "글루타메이트 톤\nglutamate · Glx (MRS)\n&#8593; in PPD"];
        EIBAL    [label = "흥분/억제 균형\nE/I imbalance index\nEXC = drive &#247; G_tonic", fillcolor = "#c39bdb", penwidth = 2.6];
        DMN      [label = "기본상태 네트워크\nDMN &#8212; DLPFC connectivity\n&#8595; (Deligiannidis fMRI)"];
        MATBRAIN [label = "모성 뇌 회로\nmaternal caregiving circuit\nMPOA-VTA-NAc-mPFC"];
    }

    /* ================================================================== 5 */
    subgraph cluster_hpa {
        label = <<b>5 · HPA 축 &#8212; 두 번째 느린 변수</b><br/>Placental CRH, hypothalamic CRH suppression, and its 12-week recovery>;
        style = "filled,rounded"; fillcolor = "#fdedec"; color = "#c0392b";
        fontsize = 14; fontcolor = "#922b21";
        node [fillcolor = "#f9d5d0", color = "#c0392b"];

        PCRH     [label = "태반 CRH\nplacental CRH\nexponential rise to term\nPOSITIVE feedback with cortisol"];
        CRHBP    [label = "CRH 결합단백\nCRH-BP\nfalls in 3rd trimester\n&#8594; free CRH &#8593;&#8593;"];
        HCRH     [label = "시상하부 CRH 뉴런 억제\nhypothalamic CRH SUPPRESSED\nby months of high cortisol\nrecovery over &#8776; 12 WEEKS", fillcolor = "#f5b7b1", penwidth = 2.4];
        AVP      [label = "AVP 공동분비\nvasopressin\nsecondary ACTH drive"];
        POMC     [label = "뇌하수체 POMC\nanterior pituitary POMC"];
        ACTH     [label = "ACTH\nblunted pulse amplitude\npostpartum"];
        ADRENAL  [label = "부신 피질\nadrenal cortex\ntransient relative\nhypofunction"];
        CORT     [label = "코르티솔\ncortisol\nflattened diurnal slope\nblunted CAR", fillcolor = "#f1948a", penwidth = 2.4];
        CBG      [label = "CBG\ncorticosteroid-binding globulin\nfree fraction"];
        GR       [label = "글루코코르티코이드 수용체\nGR (NR3C1)\nfeedback sensitivity"];
        MR       [label = "MR\nmineralocorticoid receptor\ntonic feedback"];
        FKBP5    [label = "FKBP5\nchaperone · GR resistance\nrisk allele &#215; stress"];
        HSD11B   [label = "11&#946;-HSD1 / 2\nplacental barrier (HSD11B2)\ntissue cortisol control"];
        DEXCRH   [label = "Dex-CRH 검사 둔화\nblunted dex-CRH response\nweeks 3-12 postpartum"];
        DOC      [label = "데옥시코르티코스테론\nDOC &#8594; THDOC\nSTRESS &#8594; PAM synthesis\n(compensatory arm)"];
    }

    /* ================================================================== 6 */
    subgraph cluster_mono {
        label = <<b>6 · 모노아민·신경가소성</b><br/>Estradiol withdrawal, MAO-A, serotonin and BDNF-TrkB plasticity>;
        style = "filled,rounded"; fillcolor = "#fef9e7"; color = "#b7950b";
        fontsize = 14; fontcolor = "#7d6608";
        node [fillcolor = "#fbeeb6", color = "#b7950b"];

        ESR       [label = "ER&#945; / ER&#946;\nESR1 / ESR2\nbrain oestrogen signalling"];
        MAOA      [label = "MAO-A 결합능\nMAO-A V_T &#8593; &#8776; 21 %\nday 4-6 postpartum\n(Sacher PET)", penwidth = 2.4];
        TPH2      [label = "TPH2\ntryptophan hydroxylase 2\n5-HT synthesis"];
        FIVEHT    [label = "5-HT 톤\nserotonergic tone\n&#8595; via MAO-A &#8593; + TRP &#8595;", fillcolor = "#f7dc6f", penwidth = 2.4];
        SERTP     [label = "SERT (SLC6A4)\ntransporter · 5-HTTLPR"];
        HTR1A     [label = "5-HT&#8321;&#8329; 자가수용체\nautoreceptor desensitisation\n= the SSRI 2-4 week lag"];
        NE        [label = "노르아드레날린\nnoradrenaline\narousal"];
        DA        [label = "도파민\ndopamine · D2\nprolactin-coupled"];
        BDNF      [label = "BDNF\nserum + hippocampal\n&#8595; in PPD, &#8593; with recovery", fillcolor = "#f7dc6f"];
        TRKB      [label = "TrkB\nreceptor tyrosine kinase"];
        MTOR      [label = "mTORC1\nsynaptic protein synthesis"];
        AMPA      [label = "AMPA 수용체\nGluA1 surface &#8593;\n(ketamine mechanism)"];
        NMDAR     [label = "NMDA 수용체\nGluN2B\nblocked by (es)ketamine"];
        SYNAP     [label = "시냅스 재형성\nspine density · synaptogenesis\nSLOW arm (2-4 weeks)", fillcolor = "#fbeeb6"];
        GSK3      [label = "GSK-3&#946; / eEF2K\ndownstream switches"];
    }

    /* ================================================================== 7 */
    subgraph cluster_immune {
        label = <<b>7 · 면역·염증·키뉴레닌</b><br/>Delivery inflammatory surge, microglia and tryptophan diversion>;
        style = "filled,rounded"; fillcolor = "#eaeded"; color = "#5d6d7e";
        fontsize = 14; fontcolor = "#34495e";
        node [fillcolor = "#d5dbdb", color = "#5d6d7e";];

        DELINF   [label = "분만 염증 급등\ndelivery inflammatory surge\nWBC 15-20 k · IL-6 spike\n(sterile tissue injury)"];
        IL6      [label = "IL-6\nplasma + CSF"];
        TNFA     [label = "TNF-&#945;"];
        IL1B     [label = "IL-1&#946;"];
        IL10     [label = "IL-10 / TGF-&#946;\nregulatory arm\npregnancy Th2 skew reversal"];
        CRPN     [label = "CRP\nclinical inflammatory index"];
        MICROG   [label = "미세아교세포 활성화\nmicroglial priming\nM1 shift"];
        NLRP3    [label = "NLRP3 인플라마솜\nNLRP3 · caspase-1"];
        IDO1     [label = "IDO1 / TDO\ninduced by IL-6, TNF, cortisol"];
        TRP      [label = "트립토판\ntryptophan pool\ndiverted from 5-HT"];
        KYN      [label = "키뉴레닌\nkynurenine\nKYN/TRP ratio &#8593;"];
        QUIN     [label = "퀴놀린산\nquinolinic acid\nNMDA AGONIST · neurotoxic"];
        KYNA     [label = "키뉴렌산\nkynurenic acid\nNMDA antagonist\nQUIN/KYNA balance"];
        TREGP    [label = "Treg 소실\npregnancy Treg expansion\nreverses postpartum"];
        AUTOIM   [label = "자가면역 반동\npostpartum autoimmune rebound\nthyroid · RA flares"];
    }

    /* ================================================================== 8 */
    subgraph cluster_sleep {
        label = <<b>8 · 수면·일주기</b><br/>Infant-driven sleep fragmentation: the exogenous forcing function>;
        style = "filled,rounded"; fillcolor = "#e8f6f3"; color = "#117864";
        fontsize = 14; fontcolor = "#0e6251";
        node [fillcolor = "#cdeae3", color = "#117864"];

        INFWAKE  [label = "영아 야간 각성\ninfant night waking\n2-5 &#215; / night\nEXOGENOUS FORCING", penwidth = 2.2];
        SLEEPFRAG[label = "수면 분절화\nsleep fragmentation\nWASO &#8593; · efficiency &#8595;"];
        TST      [label = "총 수면시간\nTST 4.5-6 h\n(-2 h vs pre-pregnancy)"];
        SWS      [label = "서파수면\nSWS · N3 &#8595;\nGABAergic dependence"];
        REMS     [label = "REM 수면\nREM latency &#8595;\ndepression signature"];
        MELAT    [label = "멜라토닌\nmelatonin phase\namplitude &#8595;"];
        CIRC     [label = "일주기 위상\ncircadian phase\nmisalignment · light &#8595;"];
        SLEEPDEBT[label = "누적 수면부채\ncumulative sleep debt\nSLOW integrator", fillcolor = "#a9dfd3", penwidth = 2.2];
        FATIGUE  [label = "피로\nfatigue · HAM-D items 7,8,13"];
        VICIOUS  [label = "&#8635; 악순환 고리\nvicious cycle\ninsomnia &#8594; symptoms &#8594; insomnia\n(model closes this loop)",
                   shape = note, fillcolor = "#f9e79f", color = "#b7950b"];
    }

    /* ================================================================== 9 */
    subgraph cluster_lact {
        label = <<b>9 · 락토겐·옥시토신·모아 결합</b><br/>Prolactin, oxytocin, breastfeeding and the mother-infant dyad>;
        style = "filled,rounded"; fillcolor = "#fdeff5"; color = "#a93226";
        fontsize = 14; fontcolor = "#7b241c";
        node [fillcolor = "#f8d7e3", color = "#a93226"];

        PRL      [label = "프로락틴\nprolactin\nsuckling-driven"];
        DRD2     [label = "결절누두 도파민\ntuberoinfundibular DA\nD2 brake on PRL"];
        SUCKLE   [label = "포유 자극\nsuckling / nipple stimulation\nneuroendocrine reflex"];
        OXT      [label = "옥시토신 톤\noxytocin tone\nLOW oxytocin predicts PPD\n(Skrundz 2011)", penwidth = 2.2];
