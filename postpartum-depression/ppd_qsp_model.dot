        REMIT    [label = "관해\nremission: HAM-D &#8804; 7", penwidth = 2.2];
        RELAPSE  [label = "재발\nrelapse after washout\n= incomplete bridging"];
        SUIC     [label = "자살 사고\nsuicidality (HAM-D item 3)\nleading cause of maternal\ndeath in year 1", fillcolor = "#f5b7b1", color = "#c0392b", penwidth = 2.2];
        PSYCH    [label = "산후 정신증\npostpartum psychosis\n1-2 / 1000 &#183; distinct entity\nEMERGENCY"];
        FUNCT    [label = "기능·삶의 질\nSDS · function\nreturn to work"];
        DYAD     [label = "이자관계 결과\ndyadic outcome\nbonding + infant development", fillcolor = "#dfe3e6"];
    }

    /* =====================================================================
       EDGES
       ===================================================================== */

    /* ---- 1. synthesis chain (mass flow, black) ---- */
    MATCHOL -> LDLR   [color = "#212f3d"];
    LDLR    -> STAR   [color = "#212f3d"];
    PLAC    -> STAR   [color = "#212f3d", label = "capacity"];
    STAR    -> CYP11A1[color = "#212f3d"];
    CYP11A1 -> PREG   [color = "#212f3d"];
    PREG    -> HSD3B1 [color = "#212f3d"];
    HSD3B1  -> P4     [color = "#212f3d", penwidth = 2.0];
    P4      -> SRD5A1 [color = "#212f3d"];
    SRD5A1  -> DHP    [color = "#212f3d", penwidth = 2.0];
    DHP     -> AKR1C2 [color = "#212f3d"];
    AKR1C2  -> ALLOP  [color = "#212f3d", penwidth = 2.4];
    DHP     -> ISOALLO[color = "#212f3d", style = dashed, label = "3&#946;-HSD"];
    P4      -> PREGNANO [color = "#212f3d", style = dashed, label = "5&#946;-route"];
    DOC     -> THDOC  [color = "#212f3d"];
    ALLOP   -> AKR1C3 [color = "#212f3d"];
    AKR1C3  -> DHP    [color = "#212f3d", style = dashed, label = "back-conversion"];
    ALLOP   -> UGT2B7 [color = "#212f3d"];
    UGT2B7  -> ALLOGLU[color = "#212f3d"];
    ALLOP   -> BBBST  [color = "#212f3d"];
    BBBST   -> ALLOB  [color = "#212f3d", penwidth = 2.4];
    ASTRO   -> BRSYN  [color = "#2980b9"];
    BRSYN   -> ALLOB  [color = "#212f3d", label = "local source"];
    THDOC   -> ALLOB  [color = "#212f3d", style = dashed, label = "PAM-equivalent"];
    PREGNANO-> ALLOB  [color = "#212f3d", style = dashed];

    /* ---- 2. delivery = the step change ---- */
    LABOR    -> PLACDEL [color = "#ca6f1e", penwidth = 2.0];
    PLACDEL  -> PLAC    [color = "#c0392b", arrowhead = tee, penwidth = 2.8, label = "source &#8594; 0"];
    PLACDEL  -> P4FALL  [color = "#ca6f1e", penwidth = 2.4];
    P4FALL   -> ALLOFALL[color = "#ca6f1e", penwidth = 2.4];
    P4FALL   -> P4      [color = "#c0392b", arrowhead = tee];
    ALLOFALL -> ALLOP   [color = "#c0392b", arrowhead = tee, penwidth = 2.8];
    PLACDEL  -> E2FALL  [color = "#ca6f1e", penwidth = 2.0];
    PLACDEL  -> CRHFALL [color = "#ca6f1e"];
    E2FALL   -> ESR     [color = "#c0392b", arrowhead = tee, penwidth = 2.0];
    CRHFALL  -> PCRH    [color = "#c0392b", arrowhead = tee, penwidth = 2.0];
    P4FALL   -> LACTII  [color = "#ca6f1e", label = "P4 brake released"];
    LACTII   -> PRLSURGE[color = "#ca6f1e"];
    PRLSURGE -> PRL     [color = "#a93226", penwidth = 2.0];
    OXTSURGE -> OXT     [color = "#a93226", penwidth = 2.0];
    LABOR    -> OXTSURGE[color = "#ca6f1e"];
    LABOR    -> DELINF  [color = "#5d6d7e", penwidth = 2.0];
    BLEED    -> FATIGUE [color = "#117864", style = dashed];
    ANESTH   -> PPPAIN  [color = "#ca6f1e", style = dashed];
    PPPAIN   -> SLEEPFRAG [color = "#117864"];
    PPPAIN   -> LC      [color = "#2980b9"];
    THYRPP   -> SYMPT   [color = "#212f3d", style = dashed, label = "mimic + additive"];
    AUTOIM   -> THYRPP  [color = "#5d6d7e"];

    /* ---- 3. the receptor cluster: the two arms of the product ---- */
    ALLOB   -> NSSITE1 [color = "#1e8449", penwidth = 2.8, label = "nM: PAM"];
    ALLOB   -> NSSITE2 [color = "#1e8449", style = dashed, label = "&#956;M: direct gating"];
    ISOALLO -> NSSITE1 [color = "#c0392b", arrowhead = tee, label = "antagonises PAM"];
    NSSITE1 -> POTENT  [color = "#1e8449", penwidth = 2.4];
    NSSITE2 -> SEDATION[color = "#c0392b", penwidth = 2.0];
    GABAAR  -> DELTA   [color = "#1e8449"];
    GABAAR  -> G2      [color = "#1e8449"];
    DELTA   -> A4      [color = "#1e8449", dir = both, label = "obligate partner"];
    A5      -> TONICR  [color = "#1e8449", style = dashed];
    DELTA   -> TONICR  [color = "#1e8449", penwidth = 2.4];
    G2      -> PHASICR [color = "#1e8449"];
    A1      -> PHASICR [color = "#1e8449"];
    TRAFFIC -> TONICR  [color = "#1e8449", style = dashed];
    TRAFFIC -> PHASICR [color = "#1e8449", style = dashed];

    /* the homeostatic loop: chronic PAM down-regulates the pool it acts on */
    ALLOB    -> SETPOINT [color = "#c0392b", arrowhead = tee, penwidth = 2.4,
                          label = "chronic exposure lowers set-point"];
    SETPOINT -> TONICR   [color = "#1e8449", style = dashed, penwidth = 2.4,
                          label = "&#964; &#8776; 7 d"];
    SETPOINT -> PHASICR  [color = "#1e8449", style = dashed, label = "reciprocal &#8593;"];

    /* the product */
    TONICR  -> TONICG  [color = "#1e8449", penwidth = 3.0, label = "receptor arm"];
    POTENT  -> TONICG  [color = "#1e8449", penwidth = 3.0, label = "ligand arm"];
    PHASICR -> PHASICG [color = "#1e8449", penwidth = 2.0];
    ECL     -> TONICG  [color = "#1e8449", label = "driving force"];
    KCC2    -> ECL     [color = "#1e8449", penwidth = 2.0];
    NKCC1   -> ECL     [color = "#c0392b", arrowhead = tee];
    KCC2    -> DEPOL   [color = "#c0392b", arrowhead = tee, penwidth = 2.0];
    DEPOL   -> PVNCRH  [color = "#c0392b", penwidth = 2.0, label = "excites"];
    MISMATCH -> TONICG [color = "#b7950b", style = dashed, penwidth = 2.4,
                        label = "generates the TROUGH"];
    ALLOFALL -> MISMATCH [color = "#b7950b", style = dashed, label = "&#964;_fast"];
    SETPOINT -> MISMATCH [color = "#b7950b", style = dashed, label = "&#964;_slow"];
    TONICG  -> RESERVE [color = "#1e8449", penwidth = 2.4];
    RESERVE -> EIBAL   [color = "#c0392b", arrowhead = tee, penwidth = 2.8,
                        label = "reserve lost &#8594; E/I &#8593;"];

    /* ---- 4. circuits ---- */
    TONICG  -> DG      [color = "#2980b9", penwidth = 2.4];
    TONICG  -> PVNCRH  [color = "#2980b9", penwidth = 2.4, label = "tonic brake"];
    TONICG  -> BLA     [color = "#2980b9", penwidth = 2.0];
    TONICG  -> MPFC    [color = "#2980b9"];
    DG      -> CA1     [color = "#7d3c98"];
    CA1     -> MPFC    [color = "#7d3c98"];
    DG      -> PVNCRH  [color = "#7d3c98", style = dashed, label = "hippocampal restraint"];
    BLA     -> CEA     [color = "#7d3c98"];
    CEA     -> PVNCRH  [color = "#7d3c98"];
    BLA     -> SGACC   [color = "#7d3c98"];
    MPFC    -> BLA     [color = "#c0392b", arrowhead = tee, label = "top-down control"];
    PVINT   -> GLU     [color = "#c0392b", arrowhead = tee];
    GLU     -> EIBAL   [color = "#7d3c98", penwidth = 2.0];
    EIBAL   -> SGACC   [color = "#7d3c98", penwidth = 2.0];
    EIBAL   -> DMN     [color = "#7d3c98"];
    EIBAL   -> LC      [color = "#7d3c98"];
    NAC     -> MATBRAIN[color = "#7d3c98"];
    VTA     -> NAC     [color = "#7d3c98"];
    DA      -> VTA     [color = "#7d3c98"];
    EIBAL   -> NAC     [color = "#c0392b", arrowhead = tee, label = "anhedonia"];
    INSULA  -> SGACC   [color = "#7d3c98"];
    MATBRAIN-> BOND    [color = "#a93226", penwidth = 2.0];
    INFCUE  -> MATBRAIN[color = "#a93226"];
    LC      -> SLEEPFRAG [color = "#117864", label = "hyperarousal"];

    /* ---- 5. HPA ---- */
    PLAC    -> PCRH    [color = "#c0392b", penwidth = 2.0];
    CRHBP   -> PCRH    [color = "#c0392b", arrowhead = tee, label = "buffers free CRH"];
    PCRH    -> ACTH    [color = "#c0392b", penwidth = 2.0];
    PCRH    -> CORT    [color = "#c0392b", style = dashed, label = "3&#215; rise to term"];
    CORT    -> PCRH    [color = "#c0392b", style = dashed, label = "POSITIVE feedback (placenta)"];
    CORT    -> HCRH    [color = "#c0392b", arrowhead = tee, penwidth = 2.4,
                        label = "months of suppression"];
    HCRH    -> AVP     [color = "#c0392b"];
    HCRH    -> POMC    [color = "#c0392b", penwidth = 2.0];
    AVP     -> POMC    [color = "#c0392b"];
    POMC    -> ACTH    [color = "#c0392b", penwidth = 2.0];
    ACTH    -> ADRENAL [color = "#c0392b", penwidth = 2.0];
    ADRENAL -> CORT    [color = "#c0392b", penwidth = 2.4];
    CORT    -> CBG     [color = "#c0392b", dir = both];
    CORT    -> GR      [color = "#c0392b"];
    CORT    -> MR      [color = "#c0392b"];
    GR      -> POMC    [color = "#1e8449", arrowhead = tee, label = "negative feedback"];
    FKBP5   -> GR      [color = "#c0392b", arrowhead = tee];
    HSD11B  -> CORT    [color = "#c0392b", style = dashed];
    HCRH    -> DEXCRH  [style = dotted, color = "#7f8c8d"];
    PVNCRH  -> HCRH    [color = "#c0392b", penwidth = 2.0];
    CORT    -> DOC     [color = "#c0392b", style = dashed, label = "stress &#8594; THDOC arm"];
    CORT    -> KCC2    [color = "#c0392b", arrowhead = tee, style = dashed];
    CORT    -> EIBAL   [color = "#c0392b", penwidth = 2.0];
    CORT    -> BDNF    [color = "#c0392b", arrowhead = tee, style = dashed];
    CORT    -> SYMPT   [color = "#c0392b", style = dashed, label = "dysregulation, not level"];

    /* ---- 6. monoamine / plasticity ---- */
    ESR     -> MAOA    [color = "#c0392b", arrowhead = tee, penwidth = 2.4,
                        label = "E2 restrains MAO-A"];
    MAOA    -> FIVEHT  [color = "#c0392b", arrowhead = tee, penwidth = 2.4];
    TPH2    -> FIVEHT  [color = "#b7950b", penwidth = 2.0];
    TRP     -> TPH2    [color = "#b7950b"];
    SERTP   -> FIVEHT  [color = "#c0392b", arrowhead = tee];
    FIVEHT  -> HTR1A   [color = "#b7950b"];
    HTR1A   -> FIVEHT  [color = "#c0392b", arrowhead = tee, style = dashed,
                        label = "autoreceptor brake"];
    FIVEHT  -> BDNF    [color = "#b7950b", style = dashed, penwidth = 2.0];
    ESR     -> BDNF    [color = "#b7950b", style = dashed];
    BDNF    -> TRKB    [color = "#b7950b", penwidth = 2.0];
    TRKB    -> MTOR    [color = "#b7950b"];
    MTOR    -> SYNAP   [color = "#b7950b", penwidth = 2.0];
    AMPA    -> BDNF    [color = "#b7950b", penwidth = 2.0];
    NMDAR   -> GLU     [color = "#b7950b", style = dashed];
    GSK3    -> SYNAP   [color = "#c0392b", arrowhead = tee];
    TRKB    -> KCC2    [color = "#b7950b", style = dashed, label = "bidirectional"];
    SYNAP   -> EIBAL   [color = "#1e8449", arrowhead = tee, penwidth = 2.0,
                        label = "slow structural repair"];
    FIVEHT  -> SYMPT   [color = "#c0392b", arrowhead = tee, penwidth = 2.0];
    DA      -> NAC     [color = "#b7950b"];
    NE      -> LC      [color = "#b7950b"];

    /* ---- 7. immune / kynurenine ---- */
    DELINF  -> IL6     [color = "#5d6d7e", penwidth = 2.0];
    DELINF  -> TNFA    [color = "#5d6d7e"];
    DELINF  -> IL1B    [color = "#5d6d7e"];
    IL6     -> CRPN    [color = "#5d6d7e"];
    IL10    -> IL6     [color = "#1e8449", arrowhead = tee];
    TREGP   -> IL10    [color = "#5d6d7e", arrowhead = tee, label = "Treg contraction"];
    IL6     -> MICROG  [color = "#5d6d7e", penwidth = 2.0];
    IL1B    -> NLRP3   [color = "#5d6d7e", dir = both];
    NLRP3   -> MICROG  [color = "#5d6d7e"];
    MICROG  -> GLU     [color = "#5d6d7e", penwidth = 2.0];
    IL6     -> IDO1    [color = "#5d6d7e", penwidth = 2.0];
    TNFA    -> IDO1    [color = "#5d6d7e"];
    CORT    -> IDO1    [color = "#c0392b", style = dashed];
    IDO1    -> KYN     [color = "#5d6d7e", penwidth = 2.0];
    IDO1    -> TRP     [color = "#c0392b", arrowhead = tee, penwidth = 2.0,
                        label = "diverts 5-HT substrate"];
    KYN     -> QUIN    [color = "#5d6d7e"];
    KYN     -> KYNA    [color = "#5d6d7e"];
    QUIN    -> NMDAR   [color = "#5d6d7e", penwidth = 2.0, label = "agonist"];
    KYNA    -> NMDAR   [color = "#1e8449", arrowhead = tee];
    IL6     -> SLEEPDEBT [color = "#5d6d7e", style = dashed, dir = both];
    IL6     -> SYMPT   [color = "#5d6d7e", style = dashed, penwidth = 2.0];
    SLEEPDEBT -> IL6   [color = "#117864", style = dashed, label = "sleep loss &#8594; IL-6"];

    /* ---- 8. sleep ---- */
    INFWAKE -> SLEEPFRAG [color = "#117864", penwidth = 2.4];
    CRYING  -> INFWAKE   [color = "#a93226"];
    SLEEPFRAG -> TST     [color = "#c0392b", arrowhead = tee, penwidth = 2.0];
    SLEEPFRAG -> SWS     [color = "#c0392b", arrowhead = tee];
    TONICG  -> SWS       [color = "#2980b9", style = dashed, label = "GABAergic SWS"];
    SLEEPFRAG -> REMS    [color = "#117864"];
    TST     -> SLEEPDEBT [color = "#c0392b", arrowhead = tee, penwidth = 2.4];
    CIRC    -> MELAT     [color = "#117864"];
    MELAT   -> TST       [color = "#117864"];
    SLEEPDEBT -> FATIGUE [color = "#117864", penwidth = 2.0];
    SLEEPDEBT -> EIBAL   [color = "#117864", penwidth = 2.4];
    SLEEPDEBT -> CORT    [color = "#117864", style = dashed];
    SYMPT   -> SLEEPFRAG [color = "#c0392b", style = dashed, penwidth = 2.0,
                          label = "insomnia symptom"];
    VICIOUS -> SLEEPDEBT [color = "#b7950b", style = dashed];
    FATIGUE -> SYMPT     [color = "#117864", penwidth = 2.0];

    /* ---- 9. lactation / dyad ---- */
    SUCKLE  -> PRL     [color = "#a93226", penwidth = 2.0];
    DRD2    -> PRL     [color = "#c0392b", arrowhead = tee];
    SUCKLE  -> OXT     [color = "#a93226", penwidth = 2.0];
    OXT     -> OXTR    [color = "#a93226"];
    OXTR    -> MILKEJ  [color = "#a93226"];
    OXTR    -> MATBRAIN[color = "#a93226", penwidth = 2.0];
    OXTRM   -> OXTR    [color = "#7e5109", arrowhead = tee, style = dashed];
    MILKEJ  -> BFEED   [color = "#a93226"];
    BFEED   -> SUCKLE  [color = "#a93226", label = "closes loop"];
    SYMPT   -> BFEED   [color = "#c0392b", arrowhead = tee, style = dashed,
                        label = "early cessation"];
    OXT     -> SYMPT   [color = "#1e8449", arrowhead = tee, penwidth = 2.0];
    BOND    -> INFCUE  [color = "#a93226", dir = both];
    SYMPT   -> BOND    [color = "#c0392b", arrowhead = tee, penwidth = 2.4];
    BOND    -> INFDEV  [color = "#a93226", penwidth = 2.0];
    INFDEV  -> DYAD    [style = dotted, color = "#7f8c8d"];
    BOND    -> DYAD    [style = dotted, color = "#7f8c8d"];
    MATID   -> SYMPT   [color = "#c0392b", arrowhead = tee];
    PRL     -> DA      [color = "#c0392b", arrowhead = tee, style = dashed];
    BFEED   -> SLEEPFRAG [color = "#117864", style = dashed, label = "night feeds"];

    /* ---- 10. vulnerability -> gain ---- */
    PRIORPPD -> SENS   [color = "#7e5109", penwidth = 2.8];
    PRIORMDD -> SENS   [color = "#7e5109", penwidth = 2.0];
    FHX      -> GWASV  [color = "#7e5109"];
    GWASV    -> SENS   [color = "#7e5109"];
    ESR1V    -> SENS   [color = "#7e5109"];
    ESR1V    -> SRD5A1 [color = "#7e5109", style = dashed, label = "pathway variants"];
    OXTRM    -> SENS   [color = "#7e5109"];
    ACEV     -> SENS   [color = "#7e5109"];
    ACEV     -> FKBP5  [color = "#7e5109", style = dashed];
    STRESSV  -> SENS   [color = "#7e5109", penwidth = 2.0];
    SUPPORT  -> SENS   [color = "#7e5109", penwidth = 2.0];
    UNPLAN   -> SENS   [color = "#7e5109"];
    OBCOMP   -> SENS   [color = "#7e5109"];
    NICU     -> SENS   [color = "#7e5109"];
    BTRAUMA  -> SENS   [color = "#7e5109"];
    SENS     -> RESERVE [color = "#c0392b", arrowhead = tee, penwidth = 2.4,
                         label = "narrows reserve"];
    SENS     -> SYMPT  [color = "#c0392b", penwidth = 2.8, label = "GAIN on transfer"];
    SENS     -> SETPOINT [color = "#7e5109", style = dashed,
                          label = "slower k_rec phenotype"];

    /* ---- 11. neurosteroid drugs ---- */
    BRXIV   -> BRXTIT  [color = "#196f3d"];
    BRXTIT  -> BRXPK   [color = "#196f3d", penwidth = 2.0];
    BRXPK   -> PAMTOT  [color = "#196f3d", penwidth = 2.8];
    BRXID   -> BRXPK   [color = "#b7950b", style = dashed];
    ZURPO   -> ZURPK   [color = "#196f3d", penwidth = 2.0];
    ZURPK   -> ZURPOT  [color = "#196f3d"];
    ZURPOT  -> PAMTOT  [color = "#196f3d", penwidth = 2.8];
    ALLOB   -> PAMTOT  [color = "#196f3d", penwidth = 2.4, label = "endogenous"];
    PAMTOT  -> POTENT  [color = "#196f3d", penwidth = 3.0];
    PAMTOT  -> SETPOINT[color = "#c0392b", arrowhead = tee, style = dashed,
                        label = "drug ALSO acts on set-point"];
    SEDATION-> LOC     [color = "#c0392b", penwidth = 2.0];
    LOC     -> REMS    [color = "#196f3d"];
    REMS    -> BRXIV   [color = "#c0392b", arrowhead = tee, style = dashed,
                        label = "access barrier"];
    BRIDGE  -> TONICG  [color = "#b7950b", style = dashed, penwidth = 2.4];
    BRIDGE  -> HAMDD45 [color = "#b7950b", style = dashed, penwidth = 2.0,
                        label = "predicts durability"];
    GANAX   -> PAMTOT  [color = "#196f3d", style = dashed];
    BRXPK   -> MPRATIO [color = "#9c640c"];
    ZURPK   -> MPRATIO [color = "#9c640c"];
    BRXPK   -> SEDATION[color = "#c0392b", label = "C_max driven"];
    ZURPK   -> SEDATION[color = "#c0392b", style = dashed];

    /* ---- 12. other therapies ---- */
    SERTR   -> CYP2C19 [color = "#1f618d"];
    CYP2C19 -> SSRIPD  [color = "#1f618d"];
    SERTR   -> SSRIPD  [color = "#1f618d", penwidth = 2.0];
    SSRIPD  -> SERTP   [color = "#1e8449", arrowhead = tee, penwidth = 2.4,
                        label = "blocks reuptake"];
    SSRIPD  -> SSRILAG [color = "#1f618d", penwidth = 2.0];
    SSRILAG -> HTR1A   [color = "#1e8449", arrowhead = tee, style = dashed,
                        label = "desensitisation"];
    SSRILAG -> BDNF    [color = "#1e8449", style = dashed, penwidth = 2.0];
    VENLA   -> FIVEHT  [color = "#1f618d", style = dashed];
    ESK     -> ESKPD   [color = "#1f618d", penwidth = 2.0];
    ESKPD   -> NMDAR   [color = "#1e8449", arrowhead = tee, penwidth = 2.0];
    ESKPD   -> AMPA    [color = "#1e8449", penwidth = 2.0];
    E2PATCH -> ESR     [color = "#1e8449", penwidth = 2.0, label = "reverses withdrawal"];
    THYRX   -> THYRPP  [color = "#1e8449", arrowhead = tee];
    CBT     -> SENS    [color = "#1e8449", arrowhead = tee, penwidth = 2.0];
    CBT     -> SYMPT   [color = "#1e8449", arrowhead = tee];
    BLT     -> CIRC    [color = "#1e8449", penwidth = 2.0];
    BLT     -> BDNF    [color = "#1e8449", style = dashed];
    ECT     -> SYMPT   [color = "#1e8449", arrowhead = tee, penwidth = 2.0];
    SLEEPIX -> SLEEPFRAG [color = "#1e8449", arrowhead = tee, penwidth = 2.4];
    SLEEPIX -> SLEEPDEBT [color = "#1e8449", arrowhead = tee];
    SCREEN  -> EPDS    [style = dotted, color = "#7f8c8d", penwidth = 2.0];
    SUPPORT -> SLEEPIX [color = "#1f618d", style = dashed];

    /* ---- 13. milk transfer ---- */
    MPRATIO -> MILKDRUG [color = "#9c640c", penwidth = 2.0];
    MILKVOL -> MILKDRUG [color = "#9c640c"];
    MILKDRUG-> RID      [color = "#9c640c", penwidth = 2.4];
    RID     -> INFPK    [color = "#9c640c", penwidth = 2.0];
    INFCL   -> INFPK    [color = "#c0392b", arrowhead = tee, penwidth = 2.0];
    INFPK   -> INFSED   [color = "#9c640c", penwidth = 2.0];
    INFSED  -> PUMPD    [style = dotted, color = "#7f8c8d", penwidth = 2.0];
    SERTR   -> SERMILK  [color = "#9c640c", style = dashed];
    SERMILK -> RID      [color = "#9c640c", style = dashed];
    BFEED   -> MILKVOL  [color = "#a93226"];

    /* ---- 14. endpoint mapping ---- */
    EIBAL   -> SYMPT   [color = "#c0392b", penwidth = 3.0, label = "core transfer"];
    SYMPT   -> HAMD    [style = dotted, color = "#7f8c8d", penwidth = 2.8];
    SYMPT   -> EPDS    [style = dotted, color = "#7f8c8d", penwidth = 2.4];
    SYMPT   -> MADRS   [style = dotted, color = "#7f8c8d"];
    SYMPT   -> CGII    [style = dotted, color = "#7f8c8d"];
    SYMPT   -> GAD7    [style = dotted, color = "#7f8c8d"];
    SYMPT   -> FUNCT   [style = dotted, color = "#7f8c8d"];
    SYMPT   -> SUIC    [style = dotted, color = "#c0392b", penwidth = 2.0];
    HAMD    -> HAMDD3  [style = dotted, color = "#7f8c8d"];
    HAMD    -> HAMDD15 [style = dotted, color = "#7f8c8d"];
    HAMD    -> HAMDD45 [style = dotted, color = "#7f8c8d"];
    HAMD    -> RESP    [style = dotted, color = "#7f8c8d"];
    HAMD    -> REMIT   [style = dotted, color = "#7f8c8d", penwidth = 2.0];
    HAMDD45 -> RELAPSE [style = dotted, color = "#c0392b", penwidth = 2.0];
    EPDS    -> EPDS3A  [style = dotted, color = "#7f8c8d"];
    PSYCH   -> SUIC    [color = "#c0392b", style = dashed];
    SUIC    -> ECT     [color = "#1f618d", style = dashed, label = "emergency route"];

    /* ---- cross-cluster long-range couplings that carry the argument ---- */
    ALLOP   -> ALLOB   [color = "#212f3d", style = dashed, constraint = false];
    RESERVE -> HAMDD3  [style = dotted, color = "#b7950b", constraint = false,
                        label = "reserve predicts early response"];
    SETPOINT-> RELAPSE [style = dotted, color = "#b7950b", constraint = false,
                        label = "if k_rec &#8776; 0 &#8594; relapse"];
    E2FALL  -> MAOA    [color = "#c0392b", constraint = false, penwidth = 2.0,
                        label = "day 4-6 peak"];
    HCRH    -> SENS    [color = "#c0392b", style = dashed, constraint = false,
                        label = "12-week HPA vulnerability window"];

    /* ---- legend ---- */
    subgraph cluster_legend {
        label = <<b>범례 · Legend &amp; the model's central claim</b>>;
        style = "filled,rounded"; fillcolor = "#fcfcfc"; color = "#7f8c8d";
        fontsize = 13; fontcolor = "#5d6d7e";
        node [shape = plaintext, fillcolor = "#fcfcfc", color = "#fcfcfc", fontsize = 11];

        LEG1 [label = <<table border="0" cellborder="0" cellspacing="2">
          <tr><td align="left"><b>Edge semantics</b></td></tr>
          <tr><td align="left"><font color="#212f3d">&#8212;&#8212;&#9656;</font> mass flow / conversion</td></tr>
          <tr><td align="left"><font color="#2980b9">&#8212;&#8212;&#9656;</font> neural / signalling drive</td></tr>
          <tr><td align="left"><font color="#c0392b">&#8212;&#8212;&#8866;</font> inhibition / down-regulation</td></tr>
          <tr><td align="left"><font color="#1e8449">&#8212;&#8212;&#9656;</font> therapeutic action</td></tr>
          <tr><td align="left">- - -&#9656; slow plastic change (days-weeks)</td></tr>
          <tr><td align="left">&#183;&#183;&#183;&#183;&#9656; measurement mapping</td></tr>
        </table>>];

        LEG2 [label = <<table border="0" cellborder="0" cellspacing="2">
          <tr><td align="left"><b>The one equation this map is built around</b></td></tr>
          <tr><td align="left"><font face="Courier"><b>G_tonic(t) = G&#8320; &#215; R&#948;(t) &#215; [1 + E&#8320; &#183; PAM(t)^h/(EC&#8325;&#8320;^h + PAM(t)^h)]</b></font></td></tr>
          <tr><td align="left">PAM(t) falls with &#964; &#8776; 12 h after placental expulsion</td></tr>
          <tr><td align="left">R&#948;(t) re-expands with &#964; &#8776; 7 d (168 h)</td></tr>
          <tr><td align="left">A product of a fast fall and a slow rise <b>troughs</b>.</td></tr>
          <tr><td align="left">The trough &#8212; not the level &#8212; is the disease window.</td></tr>
          <tr><td align="left">Brexanolone / zuranolone <b>fill the trough</b> until R&#948; catches up:</td></tr>
          <tr><td align="left">a BRIDGE, which is why 60 h of drug buys 30 days of benefit.</td></tr>
        </table>>];

        LEG1 -> LEG2 [style = invis];
    }
}
