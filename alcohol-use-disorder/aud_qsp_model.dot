        LV_CIRR   [label = "Cirrhosis · portal hypertension\nvarices, ascites, HE", shape = hexagon, fillcolor = "#e2c895"];
        LV_HCC    [label = "Hepatocellular carcinoma risk", shape = hexagon, fillcolor = "#e2c895"];
        LV_REGR   [label = "Regression with abstinence\nsteatosis days-weeks, fibrosis months-years", shape = parallelogram, fillcolor = "#ecdcbb"];
        LV_PKIMP  [label = "Cirrhosis alters drug handling\nnaltrexone hepatic caution, lorazepam preferred", shape = diamond, fillcolor = "#ead9b6"];
    }

