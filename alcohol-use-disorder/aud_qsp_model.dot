    /* ================================================================
       16. DRUG PHARMACOKINETICS
       ================================================================ */
    subgraph cluster_pk {
        label = "16. Pharmacotherapy — pharmacokinetics";
        style = "filled,rounded"; fillcolor = "#eaf1f7"; color = "#7fa4c6";
        fontsize = 13; fontcolor = "#22496e";
        node [fillcolor = "#d5e4f0", shape = octagon, color = "#6b93b8"];

        D_NTX     [label = "Naltrexone PO 50 mg qd\nF ~ 5-40% (high first pass)\nt1/2 ~ 4 h"];
        D_NTXOL   [label = "6-beta-naltrexol (active metabolite)\nt1/2 ~ 13 h · 10-30x plasma of parent", shape = box, style = "rounded,filled", peripheries = 2, fillcolor = "#c6dbec"];
        D_XRNTX   [label = "XR-naltrexone 380 mg IM q4wk\nPLGA depot · plateau d3-d28\nbypasses first pass and adherence"];
        D_ACP     [label = "Acamprosate 666 mg tid\nF ~ 11% · Tmax 3-8 h · t1/2 ~ 20-33 h\nrenally cleared, no hepatic metabolism"];
        D_DSF     [label = "Disulfiram 250 mg qd\nprodrug -> DDC -> DDC-Me-SO\nirreversible ALDH2 inhibition"];
        D_TPM     [label = "Topiramate 25 -> 300 mg/d\nF ~ 80% · t1/2 ~ 21 h · renal"];
        D_GBP     [label = "Gabapentin 600 mg tid\nsaturable LAT1 absorption\nrenal, t1/2 ~ 6 h"];
        D_BAC     [label = "Baclofen 30 -> 300 mg/d\nt1/2 ~ 4 h · renal"];
        D_NMF     [label = "Nalmefene 18 mg as-needed\nt1/2 ~ 13 h · targeted dosing"];
        D_OND     [label = "Ondansetron 4 ug/kg bid\nCYP3A4/2D6 · t1/2 ~ 4 h"];
        D_BZD     [label = "Chlordiazepoxide / lorazepam\nsymptom-triggered (CIWA-Ar >= 8)\nlorazepam preferred in cirrhosis"];
        D_SEM     [label = "Semaglutide 0.25 -> 1.0 mg SC weekly\nt1/2 ~ 7 d · GLP-1R agonist"];
        D_THIA    [label = "Thiamine 500 mg IV tds (Wernicke)\nor 100 mg PO prophylaxis"];
        D_PRAZ    [label = "Prazosin / doxazosin\nalpha1 antagonist (off-label)"];
        D_DISU_ADH[label = "Supervised administration\nthe single largest disulfiram effect modifier", shape = diamond, style = "filled", fillcolor = "#cfe0ee"];
    }

