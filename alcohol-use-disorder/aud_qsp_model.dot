        P_MORBLK  [label = "MOR competitive blockade\nnaltrexone + 6-beta-naltrexol + nalmefene", shape = parallelogram, fillcolor = "#c7e2d4"];
        P_KORPART [label = "KOR partial agonism (nalmefene)\ncaps dysphoric limb"];
        P_NMDAMOD [label = "Acamprosate: NMDA/mGluR5 modulation\nrestores glutamate homeostasis", shape = parallelogram, fillcolor = "#c7e2d4"];
        P_AMPABLK [label = "Topiramate: AMPA/kainate GluK1 blockade\n+ GABA-A potentiation + CA inhibition", shape = parallelogram, fillcolor = "#c7e2d4"];
        P_A2D     [label = "Gabapentin: alpha2delta-1 (CACNA2D1)\nnormalises CeA GABA, restores sleep", shape = parallelogram, fillcolor = "#c7e2d4"];
        P_GABAB   [label = "Baclofen: GABA-B agonism on VTA", shape = parallelogram, fillcolor = "#c7e2d4"];
        P_5HT3BLK [label = "Ondansetron: 5-HT3 blockade\nreduces ethanol-evoked DA", shape = parallelogram, fillcolor = "#c7e2d4"];
        P_GLP1    [label = "Semaglutide: central GLP-1R\nreduces incentive salience and intake", shape = parallelogram, fillcolor = "#c7e2d4"];
        P_ALDHBLK [label = "Disulfiram: ALDH2 inactivation\n-> acetaldehyde 5-10x", shape = parallelogram, fillcolor = "#c7e2d4"];
        P_AVERS   [label = "Aversive expectancy\nflush, nausea, palpitations, hypotension", shape = diamond, fillcolor = "#cbe5d8"];
        P_BZDSUB  [label = "Benzodiazepine GABA-A substitution\nreplaces missing tone during detox", shape = parallelogram, fillcolor = "#c7e2d4"];
        P_A1BLK   [label = "alpha1 blockade (prazosin)\ndampens LC-driven arousal", shape = parallelogram, fillcolor = "#c7e2d4"];
        P_TOLER   [label = "Tolerance to the medication itself\n(baclofen sedation, topiramate cognition)"];
    }

