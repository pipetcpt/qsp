        LV_LEAK   [label = "Ethanol/ACD -> tight-junction loss\nleaky gut, dysbiosis", shape = parallelogram, fillcolor = "#ecdcbb"];
        LV_KUPF   [label = "Kupffer cell TLR4 / CD14 activation"];
