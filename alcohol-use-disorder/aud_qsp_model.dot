    /* --- 7. glutamate --------------------------------------------- */
    PK_BRAIN -> GL_INH    [penwidth = 1.3];
    GL_INH   -> GL_NMDA   [color = "#b04a4a", arrowhead = tee];
    PK_BRAIN -> GL_UP     [color = "#c06a2b", label = "compensatory upregulation"];
    GL_UP    -> GL_NMDA   [penwidth = 1.2];
    PK_BRAIN -> GL_GLT1   [color = "#b04a4a", arrowhead = tee, label = "chronic downregulation"];
    GL_GLT1  -> GL_EXT    [color = "#2f7a3f", arrowhead = tee, penwidth = 1.2];
    GL_NMDA  -> GL_EXT    [style = dashed];
    GL_EXT   -> GL_MGLU5;
    GL_EXT   -> GL_AMPA;
    GL_EXT   -> GL_EXCITO;
    GL_EXCITO-> PF_ATROPHY;
    GL_UP    -> GL_HYPER  [penwidth = 1.3];
    GL_GLT1  -> GL_HOMEO  [color = "#2f7a3f", arrowhead = tee];
    GL_EXT   -> GL_HOMEO;
    GL_HYPER -> WD_UNMASK [penwidth = 1.4];
    GL_HYPER -> GL_SEIZ;
    GL_SEIZ  -> WD_SEIZ;
    GL_HOMEO -> AM_NEGAFF [color = "#c06a2b", penwidth = 1.2];
    GL_MGLU5 -> DA_CUE    [color = "#c06a2b"];

    /* --- 8. opioid ------------------------------------------------ */
    OP_POMC  -> OP_BEND;
    PK_BRAIN -> OP_POMC   [penwidth = 1.2];
    OP_BEND  -> OP_MOR    [penwidth = 1.4];
    OP_ENK   -> OP_DOR;
    OP_MOR   -> OP_MOROCC;
    OP_MOR   -> OP_DISINH [penwidth = 1.4];
    OP_DISINH-> GA_VTAINT [color = "#b04a4a", arrowhead = tee, penwidth = 1.3];
    GA_VTAINT-> DA_VTA    [color = "#b04a4a", arrowhead = tee, penwidth = 1.3];
    OP_DISINH-> DA_VTA    [color = "#d2802a", penwidth = 1.5];
    OP_MOR   -> OP_SUBJ;
    OP_A118G -> OP_MOR    [style = dashed];
    OP_MOR   -> OP_PRIME  [penwidth = 1.2];
    OP_PRIME -> B_PRIMING [color = "#d2802a", penwidth = 1.4];
    OP_DOR   -> B_DPD     [style = dashed];

    /* --- 9. dopamine ---------------------------------------------- */
    DA_VTA   -> DA_NAC    [penwidth = 1.5];
    DA_NAC   -> DA_D1     [penwidth = 1.2];
    DA_NAC   -> DA_D2;
    DA_DAT   -> DA_NAC    [color = "#b04a4a", arrowhead = tee];
    DA_D1    -> DA_FOSB;
    DA_FOSB  -> DA_CUE    [penwidth = 1.3];
    DA_NAC   -> DA_CUE    [color = "#d2802a"];
    DA_CUE   -> DA_WANT;
    DA_WANT  -> CR_INCEN  [penwidth = 1.3];
    DA_FOSB  -> DA_HABIT;
    DA_SHIFT -> DA_HABIT  [penwidth = 1.3];
    DA_NAC   -> DA_SHIFT  [style = dashed, label = "repeated pairing"];
    DA_HABIT -> CR_HABITL [penwidth = 1.2];
    DA_D2    -> DA_ALLO   [color = "#b04a4a", arrowhead = tee, label = "D2 loss raises set point"];
    DA_ALLO  -> DA_ANHED  [penwidth = 1.2];
    DA_ALLO  -> CR_RELIEF [penwidth = 1.2];
    DA_5HT3  -> DA_NAC    [color = "#d2802a"];
    DA_GLP1R -> DA_NAC    [color = "#2f7a3f", arrowhead = tee];
    DA_GABAB -> DA_VTA    [color = "#2f7a3f", arrowhead = tee];
    DA_CB1   -> DA_VTA    [style = dashed];
    DA_ANHED -> E_QOL     [color = "#b04a4a"];

    /* --- 10. dynorphin -------------------------------------------- */
    DA_FOSB  -> DY_PDYN   [penwidth = 1.2];
    PK_BRAIN -> DY_PDYN   [color = "#c06a2b", label = "repeated binge"];
    DY_PDYN  -> DY_DYN    [penwidth = 1.3];
    DY_DYN   -> DY_KOR    [penwidth = 1.3];
    DY_KOR   -> DA_NAC    [color = "#b04a4a", arrowhead = tee, penwidth = 1.3];
    DY_KOR   -> DY_DYSPH  [penwidth = 1.2];
    DY_DYSPH -> AM_NEGAFF [penwidth = 1.3];
    DY_DYSPH -> DY_NEGREIN;
    DY_NEGREIN -> CR_RELIEF [penwidth = 1.3];
    DY_NMF   -> DY_KOR    [color = "#2f7a3f", arrowhead = tee];

    /* --- 11. extended amygdala ------------------------------------ */
    PK_BRAIN -> AM_CRF    [color = "#c06a2b", label = "chronic recruitment"];
    AM_CEA   -> AM_CRF;
    AM_CRF   -> AM_CRF1   [penwidth = 1.3];
    AM_CRF1  -> AM_NEGAFF [penwidth = 1.4];
    AM_NPY   -> AM_CRF    [color = "#2f7a3f", arrowhead = tee, penwidth = 1.2];
    PK_BRAIN -> AM_NPY    [color = "#b04a4a", arrowhead = tee, label = "chronic depletion"];
    AM_CRF   -> AM_NE     [penwidth = 1.2];
    AM_NE    -> AM_A1     [penwidth = 1.2];
    AM_NE    -> AM_A2;
    AM_A1    -> AM_NEGAFF [penwidth = 1.2];
    AM_A1    -> WD_EXC    [penwidth = 1.2];
    AM_NEGAFF-> AM_SLEEP  [penwidth = 1.2];
    AM_SLEEP -> AM_NEGAFF [penwidth = 1.0, style = dashed, label = "reciprocal"];
    AM_NEGAFF-> CR_RELIEF [penwidth = 1.4];
    AM_STRESSR -> B_DRIVE [color = "#d2802a", penwidth = 1.2];
    AM_CRF   -> AM_STRESSR;
    AM_OT    -> AM_CRF    [color = "#2f7a3f", arrowhead = tee, style = dashed];
    GA_CEAGABA -> AM_CRF  [color = "#2f7a3f", arrowhead = tee, style = dashed];

    /* --- 12. HPA --------------------------------------------------- */
    AM_CRF   -> HP_CRH    [penwidth = 1.2];
    HP_ACUTE -> HP_CRH;
    PK_BRAIN -> HP_ACUTE;
    HP_CRH   -> HP_ACTH   [penwidth = 1.3];
    HP_ACTH  -> HP_CORT   [penwidth = 1.3];
    HP_CORT  -> HP_FEED;
    HP_FEED  -> HP_CRH    [color = "#2f7a3f", arrowhead = tee];
    HP_GR    -> HP_FEED   [penwidth = 1.1];
    PK_BRAIN -> HP_GR     [color = "#b04a4a", arrowhead = tee, label = "chronic"];
    HP_GR    -> HP_BLUNT  [color = "#b04a4a", arrowhead = tee];
    HP_BLUNT -> B_RELAPSE [color = "#c06a2b", style = dashed, label = "low reactivity predicts relapse"];
    HP_CORT  -> CV_SYMP;
    HP_CORT  -> HP_ALLOP;
    HP_CORT  -> LV_STEAT  [style = dashed];

    /* --- 13. PFC --------------------------------------------------- */
    PF_DLPFC -> PF_CTRL   [penwidth = 1.3];
    PF_ACC   -> PF_CTRL;
    PF_CTRL  -> B_DRIVE   [color = "#2f7a3f", arrowhead = tee, penwidth = 1.4];
    PF_CTRL  -> DA_HABIT  [color = "#2f7a3f", arrowhead = tee];
    PK_BRAIN -> PF_CTRL   [color = "#b04a4a", arrowhead = tee, label = "chronic erosion"];
    GL_EXT   -> PF_CTRL   [color = "#b04a4a", arrowhead = tee];
    PF_CTRL  -> PF_DELAY  [color = "#2f7a3f", arrowhead = tee];
    PF_CTRL  -> PF_INHIB  [color = "#2f7a3f", arrowhead = tee];
    PF_ATROPHY -> PF_CTRL [color = "#b04a4a", arrowhead = tee];
    PF_RECOV -> PF_CTRL   [color = "#2f7a3f", penwidth = 1.2];
    PF_INSULA-> CR_CRAVE  [penwidth = 1.1];
    PF_DELAY -> B_DECIDE  [color = "#c06a2b"];

    /* --- 14. craving ---------------------------------------------- */
    CR_INCEN -> CR_CRAVE  [penwidth = 1.4];
    CR_RELIEF-> CR_CRAVE  [penwidth = 1.4];
    CR_HABITL-> CR_CRAVE  [penwidth = 1.2];
    CR_CRAVE -> B_DRIVE   [color = "#d2802a", penwidth = 1.6];
    CR_CRAVE -> CR_OCDS;
    CR_CRAVE -> CR_ALQ;
    DA_CUE   -> CR_CUEREAC;
    CR_CUEREAC -> B_RELAPSE [style = dashed];

    /* --- 15. withdrawal ------------------------------------------- */
    PK_BAC   -> WD_UNMASK [color = "#b04a4a", arrowhead = tee, label = "falling BAC triggers"];
    WD_UNMASK-> WD_EXC    [penwidth = 1.5];
    GL_HYPER -> WD_EXC    [penwidth = 1.3];
    GA_WDGAP -> WD_EXC    [penwidth = 1.3];
    WD_EXC   -> WD_CIWA   [penwidth = 1.5];
    WD_CIWA  -> WD_TREM;
    WD_EXC   -> WD_SEIZ   [penwidth = 1.2];
    WD_CIWA  -> WD_HALL;
    WD_CIWA  -> WD_DT     [penwidth = 1.2];
    WD_KINDLE-> WD_EXC    [penwidth = 1.3, label = "amplifies"];
    WD_UNMASK-> WD_KMECH;
    WD_KMECH -> WD_KINDLE [penwidth = 1.3];
    WD_KINDLE-> WD_SEIZ   [color = "#b04a4a"];
    WD_EXC   -> WD_PAWS;
    WD_PAWS  -> AM_NEGAFF [penwidth = 1.3];
    WD_PAWS  -> WD_PRED;
    WD_PRED  -> B_RELAPSE [color = "#c06a2b", penwidth = 1.2];
    WD_CIWA  -> E_CIWAEP;
    WD_SEIZ  -> E_CIWAEP;
    WD_DT    -> E_CIWAEP;
    NU_MG    -> WD_SEIZ   [color = "#c06a2b", style = dashed];

    /* --- 16/17. drugs: PK -> PD ----------------------------------- */
    D_NTX    -> D_NTXOL   [penwidth = 1.2];
    D_NTX    -> P_MORBLK  [penwidth = 1.3];
    D_NTXOL  -> P_MORBLK  [penwidth = 1.4, label = "dominant exposure"];
    D_XRNTX  -> P_MORBLK  [penwidth = 1.4];
    D_XRNTX  -> B_ADH     [color = "#2f7a3f", label = "removes daily adherence"];
    D_NMF    -> P_MORBLK  [penwidth = 1.2];
    D_NMF    -> P_KORPART;
    P_KORPART-> DY_NMF;
    D_ACP    -> P_NMDAMOD [penwidth = 1.3];
    D_TPM    -> P_AMPABLK [penwidth = 1.3];
    D_GBP    -> P_A2D     [penwidth = 1.3];
    D_BAC    -> P_GABAB   [penwidth = 1.3];
    D_OND    -> P_5HT3BLK [penwidth = 1.2];
    D_SEM    -> P_GLP1    [penwidth = 1.3];
    D_DSF    -> P_ALDHBLK [penwidth = 1.4];
    D_BZD    -> P_BZDSUB  [penwidth = 1.4];
    D_PRAZ   -> P_A1BLK;
    D_DISU_ADH -> D_DSF   [color = "#2f7a3f", penwidth = 1.4];
    D_THIA   -> NU_THIA   [color = "#2f7a3f", penwidth = 1.4];
    D_BAC    -> P_TOLER   [style = dashed];
    D_TPM    -> P_TOLER   [style = dashed];

    /* --- 17. PD -> mechanism -------------------------------------- */
    P_MORBLK -> OP_MOR    [color = "#b04a4a", arrowhead = tee, penwidth = 1.6];
    P_MORBLK -> OP_MOROCC [penwidth = 1.2];
    P_MORBLK -> OP_SUBJ   [color = "#b04a4a", arrowhead = tee];
    P_NMDAMOD-> GL_EXT    [color = "#2f7a3f", arrowhead = tee, penwidth = 1.4];
    P_NMDAMOD-> GL_HOMEO  [color = "#2f7a3f", arrowhead = tee, penwidth = 1.4];
    P_AMPABLK-> GL_AMPA   [color = "#b04a4a", arrowhead = tee, penwidth = 1.3];
    P_AMPABLK-> GA_TONE   [color = "#2f7a3f", penwidth = 1.1];
    P_AMPABLK-> DA_NAC    [color = "#b04a4a", arrowhead = tee];
    P_A2D    -> AM_NEGAFF [color = "#2f7a3f", arrowhead = tee, penwidth = 1.3];
    P_A2D    -> AM_SLEEP  [color = "#2f7a3f", arrowhead = tee, penwidth = 1.2];
    P_A2D    -> WD_EXC    [color = "#2f7a3f", arrowhead = tee];
    P_GABAB  -> DA_GABAB  [penwidth = 1.2];
    P_5HT3BLK-> DA_5HT3   [color = "#b04a4a", arrowhead = tee, penwidth = 1.2];
    P_GLP1   -> DA_GLP1R  [penwidth = 1.3];
    P_GLP1   -> DA_CUE    [color = "#2f7a3f", arrowhead = tee];
    P_ALDHBLK-> MB_ALDH2  [color = "#b04a4a", arrowhead = tee, penwidth = 1.6];
    MB_ACD   -> P_AVERS   [penwidth = 1.4, label = "flush reaction"];
    P_AVERS  -> B_DRIVE   [color = "#2f7a3f", arrowhead = tee, penwidth = 1.6];
    P_BZDSUB -> GA_TONE   [color = "#2f7a3f", penwidth = 1.5];
    P_BZDSUB -> WD_EXC    [color = "#2f7a3f", arrowhead = tee, penwidth = 1.4];
    P_A1BLK  -> AM_A1     [color = "#b04a4a", arrowhead = tee];

    /* --- 18. liver ------------------------------------------------- */
    PK_CENT  -> LV_LEAK;
    LV_LEAK  -> LV_LPS    [penwidth = 1.3];
    LV_LPS   -> LV_KUPF   [penwidth = 1.3];
    LV_KUPF  -> LV_TNF    [penwidth = 1.4];
    LV_STEAT -> LV_ALT    [penwidth = 1.2];
    LV_TNF   -> LV_ALT    [penwidth = 1.3];
    LV_ALT   -> LV_AST    [style = dashed];
    LV_TNF   -> LV_AST    [penwidth = 1.2];
    LV_TNF   -> LV_HSC    [penwidth = 1.3];
    LV_STEAT -> LV_HSC;
    LV_HSC   -> LV_FIB    [penwidth = 1.4];
    LV_TNF   -> LV_AH     [penwidth = 1.2];
    LV_FIB   -> LV_CIRR   [penwidth = 1.3];
    LV_CIRR  -> LV_HCC;
    LV_CIRR  -> LV_PKIMP;
    LV_PKIMP -> D_BZD     [style = dashed, label = "lorazepam"];
    LV_PKIMP -> D_NTX     [style = dashed];
    LV_REGR  -> LV_STEAT  [color = "#2f7a3f", arrowhead = tee, penwidth = 1.3];
    LV_REGR  -> LV_FIB    [color = "#2f7a3f", arrowhead = tee];
    B_ABSTG  -> LV_REGR   [color = "#2f7a3f"];
    LV_CIRR  -> E_MORT    [penwidth = 1.2];
    LV_FIB   -> E_MORT;

    /* --- 19. nutrition --------------------------------------------- */
    PK_CENT  -> NU_ABS    [color = "#b04a4a"];
    NU_ABS   -> NU_THIA   [color = "#b04a4a", arrowhead = tee, penwidth = 1.3];
    NU_THIA  -> NU_WERN   [color = "#2f7a3f", arrowhead = tee, penwidth = 1.4];
    NU_WERN  -> NU_KORS   [penwidth = 1.2];
    NU_THIA  -> NU_PN     [color = "#2f7a3f", arrowhead = tee];
    NU_THIA  -> NU_CEREB  [color = "#2f7a3f", arrowhead = tee];
    NU_MG    -> NU_K;
    NU_REFEED-> NU_K;
    NU_FOL   -> BM_MCV;
    NU_WERN  -> E_QOL     [color = "#b04a4a"];
    NU_KORS  -> E_QOL     [color = "#b04a4a"];

    /* --- 20. cardiovascular ---------------------------------------- */
    CV_SYMP  -> CV_SBP    [penwidth = 1.3];
    PK_CENT  -> CV_SBP    [color = "#c06a2b", label = "dose-dependent"];
    B_TAC    -> CV_AF;
    B_TAC    -> CV_CMYO   [penwidth = 1.2];
    CV_SBP   -> CV_STROKE;
    CV_CMYO  -> E_MORT;
    CV_CANCER-> E_MORT;
    CV_IMMUNE-> E_MORT;
    B_TAC    -> CV_PANCR;
    B_TAC    -> CV_OSTEO;
    B_TAC    -> CV_IMMUNE;
    B_ABSTG  -> CV_BPREV  [color = "#2f7a3f"];
    CV_BPREV -> CV_SBP    [color = "#2f7a3f", arrowhead = tee];

    /* --- 21. endpoints --------------------------------------------- */
    B_DPD    -> E_HDD     [penwidth = 1.4];
    B_DPD    -> E_DPDD    [penwidth = 1.4];
    B_DECIDE -> E_PDA     [penwidth = 1.4];
    E_HDD    -> E_PSNHD;
    E_HDD    -> E_TTR;
    E_PDA    -> E_ABST;
    E_HDD    -> E_WHO;
    E_PDA    -> E_GCO;
    E_HDD    -> E_GCO;
    BM_PETH  -> E_PETHEP;
    E_WHO    -> E_MORT    [style = dashed, label = "risk-level reduction"];
    E_GCO    -> E_QOL;

    /* --- THE CLOSED LOOP, drawn explicitly ------------------------- */
    DA_NAC   -> B_DRIVE   [color = "#e07b1f", penwidth = 2.0, style = bold, label = "reinforcement"];
    B_DPD    -> PK_ST     [color = "#e07b1f", penwidth = 2.0, style = bold, label = "dose = output"];
    WD_PAWS  -> CR_RELIEF [color = "#e07b1f", penwidth = 2.0, style = bold, label = "negative reinforcement"];
    DA_CUE   -> CR_INCEN  [color = "#e07b1f", penwidth = 2.0, style = bold];

    /* --- legend ---------------------------------------------------- */
    subgraph cluster_legend {
        label = "Legend";
        style = "filled,rounded"; fillcolor = "#ffffff"; color = "#9aa3ab";
        fontsize = 12; fontcolor = "#444c54";
        node [shape = plaintext, fillcolor = "#ffffff", style = "", fontsize = 10];
        LEG [label = <<table border="0" cellborder="0" cellspacing="2">
            <tr><td align="left"><b>double border</b></td><td align="left">ODE state in aud_mrgsolve_model.R</td></tr>
            <tr><td align="left"><b>octagon</b></td><td align="left">drug / intervention</td></tr>
            <tr><td align="left"><b>hexagon</b></td><td align="left">clinical endpoint / read-out</td></tr>
            <tr><td align="left"><b>diamond</b></td><td align="left">switch, moderator or decision node</td></tr>
            <tr><td align="left"><b>parallelogram</b></td><td align="left">flux / transfer process</td></tr>
            <tr><td align="left"><font color="#b04a4a"><b>red / tee</b></font></td><td align="left">inhibition or antagonism</td></tr>
            <tr><td align="left"><font color="#2f7a3f"><b>green</b></font></td><td align="left">restorative / protective</td></tr>
            <tr><td align="left"><font color="#e07b1f"><b>bold orange</b></font></td><td align="left">the closed reinforcement loop</td></tr>
            </table>>];
    }
}
