    R_TOLGEN -> B_DPD     [label = "more drinks for same effect"];
    R_SEX    -> PK_VD;
    R_BW     -> PK_VD;
    R_SEX    -> PK_GASTADH [label = "lower in women"];
    G_ADH1B  -> MB_ADH    [color = "#2f7a3f", label = "40x Vmax"];
    G_ALDH2  -> MB_ALDH2  [color = "#b04a4a", arrowhead = tee, label = "15-25% activity (het)"];
    G_OPRM1  -> OP_MOR    [label = "binding affinity"];
    G_OPRM1  -> P_MORBLK  [style = dashed, label = "moderates NTX effect"];
    G_GABRA2 -> GA_SYN;
    G_5HTT   -> DA_5HT3   [style = dashed, label = "moderates ondansetron"];
    G_KCNJ6  -> DA_VTA;
    R_TRAUMA -> AM_CRF    [color = "#c06a2b"];
    R_PSYCH  -> AM_NEGAFF [color = "#c06a2b"];
    R_SOCIAL -> B_CUEEXP;
    R_SOCIAL -> B_DECIDE;

    /* --- 2. behaviour -> dose ------------------------------------ */
    B_DRIVE  -> B_DECIDE  [color = "#d2802a", penwidth = 1.5];
    B_DECIDE -> B_DPD     [color = "#d2802a", penwidth = 1.5];
    B_ABSTG  -> B_DECIDE  [color = "#2f7a3f", arrowhead = tee];
    B_MM     -> B_ABSTG   [color = "#2f7a3f"];
    B_MM     -> B_ADH     [color = "#2f7a3f"];
    B_AA     -> B_ABSTG   [color = "#2f7a3f"];
    B_ADH    -> D_NTX     [style = dashed];
    B_ADH    -> D_ACP     [style = dashed];
    B_ADH    -> D_DSF     [style = dashed, label = "adherence dominates"];
    B_DPD    -> B_TAC;
    B_DPD    -> B_WINDOW;
    B_WINDOW -> B_PACE;
    B_PACE   -> PK_ST     [color = "#d2802a", penwidth = 1.6, label = "g/h into stomach"];
    B_FED    -> PK_EMPTY  [color = "#b04a4a", arrowhead = tee, label = "delays"];
    B_CUEEXP -> DA_CUE    [color = "#c06a2b"];
    B_PRIMING-> B_DPD     [color = "#d2802a"];
    B_LAPSE  -> B_PRIMING;
    B_PRIMING-> B_RELAPSE [color = "#d2802a"];
    B_RELAPSE-> B_TAC     [color = "#d2802a"];
