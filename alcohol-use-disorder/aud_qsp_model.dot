    /* --- 3. ethanol PK ------------------------------------------- */
    PK_ST    -> PK_GASTADH;
    PK_GASTADH -> MB_ACD  [label = "first-pass ACD"];
    PK_ST    -> PK_EMPTY;
    PK_EMPTY -> PK_GUT;
