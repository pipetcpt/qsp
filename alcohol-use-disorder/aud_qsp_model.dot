    PK_CENT  -> PK_VD     [style = dashed];
    PK_VD    -> PK_BAC;
    PK_CENT  -> PK_BAC    [penwidth = 1.4];
    PK_BAC   -> PK_BRAIN  [penwidth = 1.4];
    PK_BAC   -> PK_BREATH;
    PK_CENT  -> PK_RENAL;
    PK_BAC   -> PK_ASC;
    PK_BAC   -> PK_DESC;
