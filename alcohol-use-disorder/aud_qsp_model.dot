/* =====================================================================
   Alcohol Use Disorder (AUD) — QSP Mechanistic Map
   ---------------------------------------------------------------------
   The organising idea of this map (and of aud_mrgsolve_model.R):

   In almost every other disease in this library the dose is an input.
   In AUD the dose is an OUTPUT — the patient decides it, and the
   pharmacology of what they already drank is what does the deciding.
   The map is therefore drawn as a CLOSED LOOP, not a cascade:

     drinking  ->  ethanol PK (gastric first pass, Widmark Vd,
                   saturable ADH + inducible CYP2E1, ALDH2)
       -> acute pharmacology: GABA_A potentiation, NMDA block,
          beta-endorphin -> MOR -> disinhibition of VTA GABA
          -> phasic dopamine in nucleus accumbens          (REWARD)
       -> repetition -> allostatic adaptation:
            GABA_A subunit reconfiguration (alpha1/delta down)
            NR2B-NMDA up, GLT-1/xCT down
            dynorphin/KOR up, CRF up, NPY down
            reward set point shifts, PFC control erodes,
            dorsolateral-striatal HABIT takes over from goal-direction
       -> falling BAC now UNMASKS that adaptation:
            withdrawal, negative affect, insomnia, autonomic storm
            (and each detox increments the KINDLING index)
       -> craving = incentive salience + negative reinforcement
       -> DRINKING AGAIN.  The loop closes here.

   Every approved and emerging medication is placed by WHERE IT CUTS
   THE LOOP, because that is what distinguishes them clinically:

     naltrexone / nalmefene   cut the MOR->dopamine reinforcement arm
                              -> fewer drinks per drinking day
     acamprosate              cut the glutamatergic negative-affect arm
                              -> more days abstinent
     disulfiram               insert an aversive acetaldehyde branch
                              upstream of the decision (supervision-dependent)
     topiramate / gabapentin  cut both arms (AMPA/kainate + GABA, alpha2delta)
     baclofen                 GABA_B brake on VTA
     ondansetron              5-HT3 brake on dopamine (early-onset subtype)
     semaglutide              GLP-1R brake on incentive salience
     benzodiazepines          replace the missing GABA tone during detox only

   Render:
     dot -Tsvg aud_qsp_model.dot -o aud_qsp_model.svg
     dot -Tpng -Gdpi=150 aud_qsp_model.dot -o aud_qsp_model.png
   ===================================================================== */

digraph AUD_QSP {
    rankdir = TB;
    compound = true;
    newrank = true;
    splines = spline;
    concentrate = false;
    nodesep = 0.24;
    ranksep = 0.55;
    fontname = "Helvetica";
    labelloc = "t";
    label = <<b>Alcohol Use Disorder — Quantitative Systems Pharmacology Map</b><br/>
             <font point-size="13">drinking &#8594; ethanol PK &#8594; opioid/dopamine reinforcement &#8594; allostatic neuroadaptation &#8594; withdrawal &amp; craving &#8594; drinking (closed loop)</font><br/>
             <font point-size="11">21 mechanistic modules · 248 nodes · 403 edges · states carried as ODEs in aud_mrgsolve_model.R are drawn with a double border</font>>;
    fontsize = 22;
    bgcolor = "white";

    node [shape = box, style = "rounded,filled", fontname = "Helvetica",
          fontsize = 10, penwidth = 1.0, margin = "0.09,0.05"];
    edge [fontname = "Helvetica", fontsize = 8, color = "#5c6670",
          arrowsize = 0.62, penwidth = 0.9];

    /* ---------- shared visual vocabulary ------------------------------
       double border (peripheries=2) = ODE state in the mrgsolve model
       octagon                       = drug / intervention
       hexagon                       = clinical endpoint / read-out
       diamond                       = regulatory switch or decision node
       parallelogram                 = flux / transfer process
       red edge                      = inhibition / antagonism
       green edge                    = restorative / protective
       orange edge                   = the closed reinforcement loop
       ---------------------------------------------------------------- */

    /* ================================================================
       1. HOST, GENETIC AND ENVIRONMENTAL SUSCEPTIBILITY
       ================================================================ */
    subgraph cluster_risk {
        label = "1. Susceptibility · pharmacogenetics · environment";
        style = "filled,rounded"; fillcolor = "#f4f1ec"; color = "#b9ae9c";
        fontsize = 13; fontcolor = "#6b5f4b";
        node [fillcolor = "#efe8dc", color = "#a99a80"];

        G_OPRM1   [label = "OPRM1 A118G (rs1799971)\nAsn40Asp · G-allele ~ 15-30% (higher in East Asia)\nsteeper beta-endorphin binding, larger NTX effect", shape = diamond, fillcolor = "#e5dbc6"];
        G_ALDH2   [label = "ALDH2*2 (rs671, Glu504Lys)\nheterozygote ~ 15-25% residual activity\nhomozygote ~ null · East Asian 30-50%", shape = diamond, fillcolor = "#e5dbc6"];
        G_ADH1B   [label = "ADH1B*2 (rs1229984, Arg48His)\n~40x faster ethanol oxidation\nprotective, acetaldehyde-mediated", shape = diamond, fillcolor = "#e5dbc6"];
        G_GABRA2  [label = "GABRA2 haplotype\nGABA-A alpha2 subunit · subjective response"];
        G_5HTT    [label = "5-HTTLPR LL genotype\nearly-onset / Type B subtype\npredicts ondansetron response", shape = diamond, fillcolor = "#e5dbc6"];
        G_KCNJ6   [label = "GIRK2 / KCNJ6 variation\nethanol-sensitive K+ conductance"];
        G_FAMHX   [label = "Family history density\nheritability of AUD ~ 50%"];
        R_AGEONS  [label = "Age at first drink < 15 y\nmaturational vulnerability of PFC"];
        R_SEX     [label = "Sex\nWidmark r 0.68 (M) vs 0.55 (F)\nlower gastric ADH in women"];
        R_BW      [label = "Body weight · body water\ndetermines Vd for a given dose"];
        R_TRAUMA  [label = "Early-life adversity / PTSD\nsensitised CRF-HPA axis"];
        R_SOCIAL  [label = "Drinking environment\ncue density · availability · price"];
        R_PSYCH   [label = "Psychiatric comorbidity\nMDD · anxiety · ADHD · bipolar"];
        R_TOLGEN  [label = "Low level of response (LR)\nSchuckit low-LR phenotype\nneeds more drinks for same effect"];
    }

    /* ================================================================
       2. DRINKING BEHAVIOUR — THE DOSE IS AN OUTPUT
       ================================================================ */
    subgraph cluster_behav {
        label = "2. Drinking behaviour — dose generation (closed-loop input)";
        style = "filled,rounded"; fillcolor = "#fdf2e6"; color = "#e0b57a";
        fontsize = 13; fontcolor = "#8a5a20";
        node [fillcolor = "#fbe6cd", color = "#d3a25f"];

        B_DRIVE   [label = "DRIVE\nnet drinking drive\n= craving − control − aversion", peripheries = 2, fillcolor = "#f7d6a8"];
        B_DECIDE  [label = "Decision to drink today", shape = diamond, fillcolor = "#f2c98c"];
        B_DPD     [label = "Drinks per day\n(1 standard drink = 14 g ethanol US / 10 g WHO)", peripheries = 2, fillcolor = "#f7d6a8"];
        B_WINDOW  [label = "Within-day drinking window\ntypically 17:00-23:00 · sets absorption rate", shape = parallelogram, fillcolor = "#f2c98c"];
        B_PACE    [label = "Drinking pace (g/h)\nascending-limb steepness"];
        B_FED     [label = "Fed vs fasted state\nfood delays gastric emptying, cuts peak BAC ~ 40%"];
        B_ABSTG   [label = "Abstinence goal / treatment contract", shape = diamond, fillcolor = "#f2c98c"];
        B_ADH     [label = "Medication adherence\nsupervised vs self-administered"];
        B_MM      [label = "Medical management / CBT / MET\npsychosocial platform (COMBINE)", shape = octagon, fillcolor = "#f5deb9"];
        B_AA      [label = "Mutual-help attendance\n12-step facilitation"];
        B_CUEEXP  [label = "Cue exposure events\nbar · advertising · stress · anniversary"];
        B_PRIMING [label = "Priming dose effect\nfirst drink raises P(next drink)", shape = parallelogram, fillcolor = "#f2c98c"];
        B_LAPSE   [label = "Lapse", shape = diamond, fillcolor = "#f2c98c"];
        B_RELAPSE [label = "Relapse to heavy drinking", shape = diamond, fillcolor = "#eeb877"];
        B_TAC     [label = "Total alcohol consumption (g/day)", peripheries = 2, fillcolor = "#f7d6a8"];
    }

    /* ================================================================
       3. ETHANOL ABSORPTION, DISTRIBUTION, FIRST PASS
       ================================================================ */
    subgraph cluster_ethpk {
        label = "3. Ethanol ADME — gastric first pass · Widmark distribution";
        style = "filled,rounded"; fillcolor = "#eef4fa"; color = "#8fb4d9";
        fontsize = 13; fontcolor = "#2d5b8c";
        node [fillcolor = "#dceaf6", color = "#6f9fce"];

        PK_ST     [label = "ETH_ST\nstomach ethanol (g)", peripheries = 2, fillcolor = "#c9def2"];
        PK_GASTADH[label = "Gastric ADH (ADH7 / sigma-ADH)\nfirst-pass 5-10% · lower in women\nabolished by H2-blockers & fasting", shape = parallelogram, fillcolor = "#cfe2f4"];
        PK_EMPTY  [label = "Gastric emptying\nrate-limiting step for peak BAC", shape = parallelogram, fillcolor = "#cfe2f4"];
        PK_GUT    [label = "ETH_GUT\nduodenum/jejunum ethanol (g)", peripheries = 2, fillcolor = "#c9def2"];
        PK_ABS    [label = "Passive absorption\nka ~ 3-6 /h · no transporter required", shape = parallelogram, fillcolor = "#cfe2f4"];
        PK_PORTAL [label = "Portal delivery to liver"];
        PK_CENT   [label = "ETH_C\ncentral ethanol amount (g)\nBAC = ETH_C / (r x BW)", peripheries = 2, fillcolor = "#c9def2"];
        PK_VD     [label = "Widmark Vd\nr = 0.68 (M) / 0.55 (F) L/kg\ntotal body water compartment"];
        PK_BAC    [label = "Blood alcohol concentration (BAC)\ng/dL · the exposure driver", shape = hexagon, fillcolor = "#b9d5ef"];
        PK_BRAIN  [label = "Brain ethanol\nequilibrates in minutes (freely diffusible)"];
        PK_BREATH [label = "Breath / transdermal ethanol\nSCRAM-TAC continuous monitoring", shape = hexagon, fillcolor = "#b9d5ef"];
        PK_RENAL  [label = "Renal + pulmonary excretion\n~2-5% of dose unchanged", shape = parallelogram, fillcolor = "#cfe2f4"];
        PK_MEG    [label = "Mellanby effect\nacute tolerance: same BAC,\nless impairment on descending limb"];
        PK_ASC    [label = "Ascending limb\nstimulant / euphoric / reinforcing"];
        PK_DESC   [label = "Descending limb\nsedative / dysphoric"];
    }

    /* ================================================================
       4. OXIDATIVE METABOLISM AND REDOX
       ================================================================ */
    subgraph cluster_metab {
        label = "4. Oxidative metabolism — ADH · CYP2E1 · ALDH2 · redox shift";
        style = "filled,rounded"; fillcolor = "#f0f7ee"; color = "#93bd8b";
        fontsize = 13; fontcolor = "#33683a";
        node [fillcolor = "#dcecd8", color = "#7aa972"];

        MB_ADH    [label = "Hepatic ADH1B/1C (cytosolic)\nVmax ~ 0.15 g/L/h · Km ~ 0.05 g/L\nZERO-ORDER at any drinking BAC", shape = parallelogram, fillcolor = "#cee4c8"];
        MB_CYP    [label = "CYP2E1\nrelative induction (fold)", peripheries = 2, fillcolor = "#c6dfc0"];
        MB_MEOS   [label = "MEOS flux\nKm ~ 8-10 mM (0.4 g/L)\n10% of clearance -> 20-25% when induced", shape = parallelogram, fillcolor = "#cee4c8"];
        MB_CAT    [label = "Catalase / H2O2 pathway\nminor systemically, relevant in brain", shape = parallelogram, fillcolor = "#cee4c8"];
        MB_ACD    [label = "ACD\nacetaldehyde (uM)", peripheries = 2, fillcolor = "#c6dfc0"];
        MB_ALDH2  [label = "Mitochondrial ALDH2\nKm ~ 1 uM · keeps ACD at 1-2 uM\nTHE disulfiram / ALDH2*2 node", shape = parallelogram, fillcolor = "#cee4c8"];
        MB_ACT    [label = "ACT\nacetate (mM) -> peripheral acetyl-CoA", peripheries = 2, fillcolor = "#c6dfc0"];
        MB_NADH   [label = "NADH\nhepatic NADH/NAD+ ratio (relative)", peripheries = 2, fillcolor = "#c6dfc0"];
        MB_LACT   [label = "LACT\nlactate (mmol/L)", peripheries = 2, fillcolor = "#c6dfc0"];
        MB_GNG    [label = "Gluconeogenesis suppressed\npyruvate -> lactate shunt\nfasting hypoglycaemia"];
        MB_FAOX   [label = "Fatty-acid oxidation suppressed\nPPAR-alpha down, SREBP-1c up", shape = parallelogram, fillcolor = "#cee4c8"];
        MB_TG     [label = "Hepatic triglyceride synthesis up"];
        MB_URIC   [label = "Lactate blocks renal urate excretion\n-> hyperuricaemia / gout flare"];
        MB_ROS    [label = "CYP2E1-derived ROS\nsuperoxide · hydroxyethyl radical", fillcolor = "#e9d9d1", color = "#b98f7c"];
        MB_GSH    [label = "Hepatic glutathione depletion"];
        MB_NAPQI  [label = "CYP2E1 x paracetamol -> NAPQI\ntherapeutic-dose hepatotoxicity risk", fillcolor = "#e9d9d1", color = "#b98f7c"];
        MB_TOLMET [label = "Metabolic tolerance\nfaster clearance at same dose", shape = diamond, fillcolor = "#cadfc4"];
        MB_ACDADD [label = "Acetaldehyde-protein adducts\nneoantigen -> immune hepatitis", fillcolor = "#e9d9d1", color = "#b98f7c"];
        MB_SALSO  [label = "Salsolinol (ACD + dopamine condensate)\nVTA MOR-dependent reinforcement"];
    }

    /* ================================================================
       5. NON-OXIDATIVE METABOLISM AND OBJECTIVE BIOMARKERS
       ================================================================ */
    subgraph cluster_biomk {
        label = "5. Non-oxidative metabolism · objective consumption biomarkers";
        style = "filled,rounded"; fillcolor = "#f6f2fa"; color = "#b39ccd";
        fontsize = 13; fontcolor = "#5b3f80";
        node [fillcolor = "#e8ddf3", color = "#a087bf"];

        BM_PLD    [label = "Phospholipase D transphosphatidylation\n~0.05% of dose", shape = parallelogram, fillcolor = "#ded0ee"];
        BM_PETH   [label = "PETH\nphosphatidylethanol 16:0/18:1 (ng/mL)\nt1/2 ~ 4-10 d · window 2-4 weeks", peripheries = 2, fillcolor = "#d8c8ea"];
        BM_FAEE   [label = "Fatty-acid ethyl esters (FAEE)\nhair / meconium matrix"];
        BM_ETG    [label = "EtG / EtS (urine)\nUGT / SULT conjugates · window 2-3 d", shape = hexagon, fillcolor = "#d0bde6"];
        BM_CDT    [label = "CDT\ncarbohydrate-deficient transferrin (%)", peripheries = 2, fillcolor = "#d8c8ea"];
        BM_CDTMEC[label = "ACD inhibits Golgi glycosyltransferase\nneeds >= 60 g/day for 1-2 weeks", shape = parallelogram, fillcolor = "#ded0ee"];
        BM_GGT    [label = "GGT\ngamma-glutamyl transferase (U/L)", peripheries = 2, fillcolor = "#d8c8ea"];
        BM_MCV    [label = "MCV\nmean corpuscular volume (fL)\nslow marker, t1/2 ~ RBC lifespan", peripheries = 2, fillcolor = "#d8c8ea"];
        BM_COMBO  [label = "PEth + GGT + CDT combination\nbest sensitivity for relapse detection", shape = hexagon, fillcolor = "#d0bde6"];
        BM_SELFR  [label = "Self-report (TLFB / AUDIT-C)\nunder-reports by 30-50%", shape = hexagon, fillcolor = "#d0bde6"];
    }

    /* ================================================================
       6. GABA-A SIGNALLING, TOLERANCE AND SUBUNIT SWITCHING
       ================================================================ */
    subgraph cluster_gaba {
        label = "6. GABA-A signalling · sedation · tolerance · subunit reconfiguration";
        style = "filled,rounded"; fillcolor = "#eef6f6"; color = "#83b8b8";
        fontsize = 13; fontcolor = "#1f5f5f";
        node [fillcolor = "#d7ebeb", color = "#67a3a3"];

        GA_SYN    [label = "Synaptic GABA-A (alpha1/beta2/gamma2)\nphasic inhibition · sedation, ataxia"];
        GA_EXTRA  [label = "Extrasynaptic GABA-A (alpha4/alpha6-delta)\nTONIC current · sensitive to 3-30 mM ethanol"];
        GA_POT    [label = "Ethanol potentiation of GABA-A\nEC50 ~ 20-50 mM for synaptic,\nlower for delta-containing", shape = parallelogram, fillcolor = "#cde5e5"];
        GA_NAS    [label = "Neuroactive steroids (allopregnanolone)\nethanol raises them -> indirect GABA-A gain"];
        GA_TONE   [label = "GABA_TONE\nnet GABAergic inhibitory tone", peripheries = 2, fillcolor = "#c6e0e0"];
        GA_SUB    [label = "GABAA_SUB\nsubunit reconfiguration index\n(alpha1 down, alpha4 up, delta internalised)", peripheries = 2, fillcolor = "#c6e0e0"];
        GA_TOLF   [label = "Functional (pharmacodynamic) tolerance", shape = diamond, fillcolor = "#cbe4e4"];
        GA_XTOL   [label = "Cross-tolerance to benzodiazepines,\nbarbiturates, volatile anaesthetics"];
        GA_VTAINT [label = "VTA GABA interneuron\ntonic brake on dopamine neurons"];
        GA_CEAGABA[label = "CeA GABAergic transmission\nethanol-sensitive, CRF-amplified"];
        GA_WDGAP  [label = "Withdrawal GABA deficit\nadaptation persists after ethanol leaves", shape = diamond, fillcolor = "#cbe4e4"];
    }

    /* ================================================================
       7. GLUTAMATE / NMDA SYSTEM AND HOMEOSTASIS
       ================================================================ */
    subgraph cluster_glu {
        label = "7. Glutamate · NMDA · homeostatic transporters";
        style = "filled,rounded"; fillcolor = "#fdf0f0"; color = "#d99b9b";
        fontsize = 13; fontcolor = "#8c2f2f";
        node [fillcolor = "#f7dcdc", color = "#c98383"];

        GL_NMDA   [label = "NMDA receptor (GluN1/GluN2B)\nethanol is a non-competitive inhibitor"];
        GL_INH    [label = "Acute NMDA inhibition\namnesia (blackout), ataxia, anti-anxiety", shape = parallelogram, fillcolor = "#f2cccc"];
        GL_UP     [label = "NMDA_UP\nNR2B/GluN2B upregulation index", peripheries = 2, fillcolor = "#eec2c2"];
        GL_GLT1   [label = "GLT1\nastrocytic GLT-1 (EAAT2) + xCT capacity", peripheries = 2, fillcolor = "#eec2c2"];
        GL_EXT    [label = "GLU_NAC\nextracellular glutamate, NAc / mPFC", peripheries = 2, fillcolor = "#eec2c2"];
        GL_MGLU5  [label = "mGluR5 / Homer2 scaffold\nreinstatement of alcohol seeking"];
        GL_AMPA   [label = "AMPA / kainate receptors\nGluA1 trafficking · topiramate target"];
        GL_EXCITO [label = "Excitotoxic Ca2+ influx\nneuronal loss, cerebellar & PFC atrophy", fillcolor = "#f0d3cc", color = "#c08b7c"];
        GL_HYPER  [label = "Withdrawal hyperglutamatergia\nunopposed NMDA drive when ethanol stops", shape = diamond, fillcolor = "#f2cccc"];
        GL_HOMEO  [label = "Glutamate homeostasis deficit\nthe acamprosate / N-acetylcysteine target", shape = diamond, fillcolor = "#f2cccc"];
        GL_SEIZ   [label = "Withdrawal seizure generation\n(rum fits) 12-48 h", shape = hexagon, fillcolor = "#eeb9b9"];
    }

    /* ================================================================
       8. ENDOGENOUS OPIOID SYSTEM — THE REINFORCEMENT ARM
       ================================================================ */
    subgraph cluster_opioid {
        label = "8. Endogenous opioid reinforcement — the naltrexone / nalmefene arm";
        style = "filled,rounded"; fillcolor = "#fff7e4"; color = "#dcc077";
        fontsize = 13; fontcolor = "#7d6110";
        node [fillcolor = "#faeecb", color = "#cbb063";

        ];
        OP_POMC   [label = "Arcuate POMC neurons\nethanol-evoked release"];
        OP_BEND   [label = "BEND\nbeta-endorphin in NAc / VTA", peripheries = 2, fillcolor = "#f5e4b4"];
        OP_ENK    [label = "Met/Leu-enkephalin\nNAc shell, delta-opioid receptor"];
        OP_MOR    [label = "mu-opioid receptor (MOR)\nGi/o · Ki naltrexone ~ 0.2 nM"];
        OP_MOROCC [label = "MOR occupancy (%)\n50 mg naltrexone -> > 90% for 24 h", shape = hexagon, fillcolor = "#f0dba1"];
        OP_DOR    [label = "delta-opioid receptor\nmodulates consumption"];
        OP_DISINH [label = "Disinhibition of VTA GABA interneuron\nMOR-Gi on the brake -> dopamine burst", shape = parallelogram, fillcolor = "#f5e4b4"];
        OP_SUBJ   [label = "Subjective high / liking\nblunted by MOR blockade", shape = hexagon, fillcolor = "#f0dba1"];
        OP_A118G  [label = "OPRM1 118G carriers\nlarger blunting by naltrexone\n(pharmacogenetic moderator)", shape = diamond, fillcolor = "#f3e0ad"];
        OP_PRIME  [label = "Opioid-mediated priming\ndrives drinks-per-drinking-day, not P(any drink)", shape = diamond, fillcolor = "#f3e0ad"];
    }

    /* ================================================================
       9. MESOLIMBIC DOPAMINE AND INCENTIVE SALIENCE
       ================================================================ */
    subgraph cluster_da {
        label = "9. Mesolimbic dopamine · incentive sensitisation · habit";
        style = "filled,rounded"; fillcolor = "#f0f0fb"; color = "#9a9ad2";
        fontsize = 13; fontcolor = "#33338c";
        node [fillcolor = "#dcdcf5", color = "#8484c4"];

        DA_VTA    [label = "VTA dopamine neurons\nburst firing after MOR disinhibition"];
        DA_NAC    [label = "DA_NAC\naccumbal dopamine (relative to baseline)", peripheries = 2, fillcolor = "#cccdf0"];
        DA_D1     [label = "D1 MSN (direct pathway)\ngo / approach"];
        DA_D2     [label = "D2 MSN (indirect pathway)\ndownregulated in chronic AUD (PET D2/3 Bmax low)"];
        DA_DAT    [label = "DAT reuptake"];
        DA_FOSB   [label = "DeltaFosB accumulation\nmonths-long transcriptional memory"];
        DA_CUE    [label = "CUEREACT\ncue-conditioned incentive salience", peripheries = 2, fillcolor = "#cccdf0"];
        DA_WANT   [label = "Wanting dissociates from liking\n(incentive-sensitisation theory)", shape = diamond, fillcolor = "#d2d2f2"];
        DA_HABIT  [label = "HABIT\ndorsolateral striatal habit strength", peripheries = 2, fillcolor = "#cccdf0"];
        DA_SHIFT  [label = "Ventral -> dorsal striatal shift\ngoal-directed -> stimulus-response", shape = parallelogram, fillcolor = "#d2d2f2"];
        DA_ALLO   [label = "ALLO\nallostatic reward set-point shift", peripheries = 2, fillcolor = "#cccdf0"];
        DA_ANHED  [label = "Anhedonia / reward deficiency\nnatural rewards devalued", shape = hexagon, fillcolor = "#c2c2ec"];
        DA_5HT3   [label = "5-HT3 receptors on DA terminals\nethanol-evoked DA release component"];
        DA_GLP1R  [label = "GLP-1R on VTA / NAc neurons\nsuppresses ethanol-evoked DA"];
        DA_GABAB  [label = "GABA-B autoreceptors on VTA\nbaclofen brake"];
        DA_CB1    [label = "CB1 endocannabinoid tone\npermissive for ethanol reward"];
    }

    /* ================================================================
       10. DYNORPHIN / KOR ANTI-REWARD
       ================================================================ */
    subgraph cluster_dyn {
        label = "10. Dynorphin / kappa-opioid anti-reward (the dark side)";
        style = "filled,rounded"; fillcolor = "#f2eef2"; color = "#a98ba9";
        fontsize = 13; fontcolor = "#5c2f5c";
        node [fillcolor = "#e6dae6", color = "#9a789a"];

        DY_PDYN   [label = "Prodynorphin induction\nCREB-dependent, repeated binge"];
        DY_DYN    [label = "DYN\ndynorphin / KOR tone", peripheries = 2, fillcolor = "#dccadc"];
        DY_KOR    [label = "kappa-opioid receptor on DA terminals\nGi -> suppresses dopamine release"];
        DY_DYSPH  [label = "Dysphoria · aversive state", shape = hexagon, fillcolor = "#d4bcd4"];
        DY_NEGREIN[label = "Negative reinforcement\ndrinking to relieve, not to enjoy", shape = diamond, fillcolor = "#dfcadf"];
        DY_NMF    [label = "Nalmefene KOR partial agonism\ndistinguishes it from naltrexone"];
    }

    /* ================================================================
       11. EXTENDED AMYGDALA STRESS SYSTEM
       ================================================================ */
    subgraph cluster_amyg {
        label = "11. Extended amygdala — CRF · NPY · noradrenaline";
        style = "filled,rounded"; fillcolor = "#fdefe9"; color = "#e0a184";
        fontsize = 13; fontcolor = "#8c3f18";
        node [fillcolor = "#f8ddd0", color = "#cf8f70"];

        AM_CEA    [label = "Central nucleus of amygdala (CeA)\n+ BNST = extended amygdala"];
        AM_CRF    [label = "CRF_CEA\nCRF tone in extended amygdala", peripheries = 2, fillcolor = "#f4cdba"];
        AM_CRF1   [label = "CRF1 receptor signalling\nrecruited in dependence, not in social drinking"];
        AM_NPY    [label = "NPY_CEA\nneuropeptide Y (endogenous CRF brake)", peripheries = 2, fillcolor = "#f4cdba"];
        AM_NE     [label = "NE_LC\nlocus coeruleus noradrenergic output", peripheries = 2, fillcolor = "#f4cdba"];
        AM_A1     [label = "alpha1-adrenoceptor\nprazosin / doxazosin target"];
        AM_A2     [label = "alpha2-autoreceptor\nclonidine / dexmedetomidine target"];
        AM_NEGAFF [label = "NEGAFF\nnegative affect (anxiety, dysphoria, irritability)", peripheries = 2, fillcolor = "#f4cdba"];
        AM_SLEEP  [label = "SLEEPD\nsleep fragmentation / REM rebound", peripheries = 2, fillcolor = "#f4cdba"];
        AM_STRESSR[label = "Stress-induced reinstatement\nyohimbine / life-stress model", shape = diamond, fillcolor = "#f6d5c4"];
        AM_OT     [label = "Oxytocin (BNST)\nexperimental anti-craving"];
    }

    /* ================================================================
       12. HPA AXIS
       ================================================================ */
    subgraph cluster_hpa {
        label = "12. HPA axis — acute activation, chronic blunting";
        style = "filled,rounded"; fillcolor = "#f7f4ea"; color = "#c5b884";
        fontsize = 13; fontcolor = "#6e6120";
        node [fillcolor = "#ece5cd", color = "#b3a468"];

