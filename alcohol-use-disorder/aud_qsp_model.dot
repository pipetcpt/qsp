    PK_DESC  -> DY_DYSPH  [color = "#8a4a8a"];
    PK_ASC   -> PK_MEG;
    PK_MEG   -> PK_DESC   [style = dashed];

    /* --- 4. metabolism ------------------------------------------- */
    PK_CENT  -> MB_ADH    [penwidth = 1.4];
