        WD_CIWA   [label = "CIWA\nCIWA-Ar autonomic withdrawal score", peripheries = 2, fillcolor = "#eec2c2"];
        WD_TREM   [label = "Tremor, diaphoresis, tachycardia\n6-24 h"];
