digraph SIADH_QSP {
  graph [rankdir=LR, fontname="Helvetica", fontsize=11, labelloc=t,
         label="SIADH (항이뇨호르몬 부적절 분비 증후군) — Integrated QSP Mechanistic Map\nNon-Osmotic AVP Release · Renal V2R/Aquaporin-2 Hyperfunction · Euvolemic Hyponatremia · Cerebral Adaptation & Osmotic-Demyelination Risk\nTolvaptan · Conivaptan · Demeclocycline · Hypertonic Saline · Fluid Restriction · Urea",
         splines=spline, overlap=false, nodesep=0.28, ranksep=0.55,
         bgcolor="#fbfbfd"];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10,
         fillcolor="#ffffff", color="#7d8590"];
  edge  [fontname="Helvetica", fontsize=9, color="#6e7681", arrowsize=0.7];

  /* ───────────────────────── 1. Etiologies / Risk Factors ────────────────── */
  subgraph cluster_etio {
    label="1. Etiologies & Risk Factors";
    style="filled,rounded"; color="#5c6370"; fillcolor="#f3f0ff"; fontsize=12;
    SCLC_EctopicAVP   [label="Small-cell lung cancer\n(ectopic AVP-secreting tumor)"];
    OtherEctopicTumor [label="Other ectopic-AVP tumors\n(pancreatic, olfactory neuroblastoma)"];
    CNS_Disorders     [label="CNS disorders\n(meningitis, stroke, trauma,\nhydrocephalus, hemorrhage)"];
    PulmonaryDisease  [label="Pulmonary disease\n(pneumonia, TB, COPD exac.,\npositive-pressure ventilation)"];
    SSRI_Drugs        [label="SSRIs / SNRIs"];
    Carbamazepine_Ox  [label="Carbamazepine /\noxcarbazepine"];
    Cyclophos_Vinca   [label="Cyclophosphamide /\nvincristine"];
    MDMA_Ecstasy      [label="MDMA (ecstasy)\nuse"];
    Desmopressin_Exog [label="Exogenous desmopressin\n(DDAVP, enuresis/DI Rx)"];
    NSAID_Use         [label="NSAID use\n(potentiates AVP renal effect)"];
    PostopPainNausea  [label="Postoperative pain,\nnausea, stress"];
    HIV_Infection     [label="HIV infection /\nopportunistic disease"];
    Idiopathic_Elderly[label="Idiopathic SIADH\n(elderly, age-related AVP dysreg.)"];
    ExerciseInduced   [label="Exercise-associated\nhyponatremia (marathon,\nover-hydration + non-osm. AVP)"];
    LowSoluteIntake   [label="Low dietary solute\n(\"tea and toast\"/beer potomania)"];

    SCLC_EctopicAVP -> Ectopic_TumorAVP;
    OtherEctopicTumor -> Ectopic_TumorAVP;
    CNS_Disorders -> NonOsmotic_AVP_Stim;
    PulmonaryDisease -> NonOsmotic_AVP_Stim;
    SSRI_Drugs -> Hypothalamic_AVP_Neurons [label="potentiate\nrelease"];
    Carbamazepine_Ox -> V2_Receptor [label="renal V2R\nsensitization", style=dashed];
    Cyclophos_Vinca -> Hypothalamic_AVP_Neurons;
    MDMA_Ecstasy -> Hypothalamic_AVP_Neurons;
    Desmopressin_Exog -> V2_Receptor [label="direct exogenous\nagonism", color="#c0392b"];
    NSAID_Use -> AQP2_GeneExpression [label="↓prostaglandin\nantagonism of AVP", style=dashed];
    PostopPainNausea -> NonOsmotic_AVP_Stim;
    HIV_Infection -> NonOsmotic_AVP_Stim [style=dashed];
    Idiopathic_Elderly -> Osmostat_Reset [style=dashed];
    ExerciseInduced -> NonOsmotic_AVP_Stim [style=dashed];
    LowSoluteIntake -> UrineOsmolality [style=dashed, label="limits max\nfree-water excretion"];
  }

  /* ───────────────────────── 2. Hypothalamic-Neurohypophyseal AVP Axis ────── */
  subgraph cluster_avp {
    label="2. Hypothalamic-Neurohypophyseal AVP Axis";
    style="filled,rounded"; color="#5c6370"; fillcolor="#fff4e6"; fontsize=12;
    Osmoreceptors_OVLT   [label="Hypothalamic osmoreceptors\n(OVLT/SFO)"];
    BaroreceptorReflex   [label="Carotid/aortic\nbaroreceptor reflex"];
    Hypothalamic_AVP_Neurons [label="Supraoptic/paraventricular\nAVP neurons"];
    PosteriorPituitary_Rel [label="Posterior pituitary\nAVP release"];
    Ectopic_TumorAVP     [label="Ectopic tumoral\nAVP production"];
    NonOsmotic_AVP_Stim  [label="Non-osmotic AVP\nstimuli (pain/nausea/\nvolume/CNS)"];
    PlasmaAVP_Level      [label="Plasma AVP\n(copeptin surrogate) ↑\n— inappropriate for osmolality"];
    Osmostat_Reset       [label="Reset-osmostat\nvariant (Type C)"];
    SIADH_TypeClass      [label="Robertson SIADH\nsubtype A/B/C/D"];
    AVP_Degradation      [label="Hepatic/renal\nAVP clearance"];

    Osmoreceptors_OVLT -> Hypothalamic_AVP_Neurons [label="osmotic\ndrive"];
    BaroreceptorReflex -> Hypothalamic_AVP_Neurons [style=dashed, label="non-osmotic\nvolume/pressure drive"];
    Hypothalamic_AVP_Neurons -> PosteriorPituitary_Rel;
    NonOsmotic_AVP_Stim -> PosteriorPituitary_Rel [color="#c0392b", label="overrides\nosmotic feedback"];
    PosteriorPituitary_Rel -> PlasmaAVP_Level;
    Ectopic_TumorAVP -> PlasmaAVP_Level [color="#c0392b", label="autonomous,\nnon-suppressible"];
    PlasmaAVP_Level -> V2_Receptor;
    Osmostat_Reset -> Osmoreceptors_OVLT [style=dashed, label="lowered\nset-point"];
    SIADH_TypeClass -> PlasmaAVP_Level [style=dashed];
    AVP_Degradation -> PlasmaAVP_Level [style=dashed, color="#1a7a3c"];
    SerumOsmolality -> Osmoreceptors_OVLT [label="normal negative\nfeedback (lost in SIADH)", style=dashed];
  }

  /* ───────────────────────── 3. Renal V2R / Aquaporin-2 Signaling ─────────── */
  subgraph cluster_v2aqp {
    label="3. Renal V2-Receptor / Aquaporin-2 Signaling";
    style="filled,rounded"; color="#5c6370"; fillcolor="#eaf7ea"; fontsize=12;
    CollectingDuct_Cell [label="Collecting-duct\nprincipal cell"];
    V2_Receptor         [label="V2 receptor\n(Gs-coupled GPCR)"];
    Gs_AdenylateCyclase [label="Gs → adenylate\ncyclase activation"];
    cAMP_PKA            [label="cAMP → PKA\nactivation"];
    AQP2_Phosphorylation[label="AQP2 Ser256\nphosphorylation"];
    AQP2_ApicalTraffic  [label="AQP2 vesicle\napical trafficking"];
    AQP2_MembraneInsert [label="AQP2 apical\nmembrane insertion"];
    AQP2_GeneExpression [label="AQP2 gene\ntranscription ↑\n(chronic upregulation)"];
    WaterPermeability   [label="Collecting-duct\nwater permeability ↑"];
    NSIAD_GainOfFunction[label="Nephrogenic syndrome of\ninappropriate antidiuresis\n(V2R gain-of-function, AVP-independent)"];

    V2_Receptor -> Gs_AdenylateCyclase;
    Gs_AdenylateCyclase -> cAMP_PKA;
    cAMP_PKA -> AQP2_Phosphorylation;
    AQP2_Phosphorylation -> AQP2_ApicalTraffic;
    AQP2_ApicalTraffic -> AQP2_MembraneInsert;
    AQP2_MembraneInsert -> WaterPermeability;
    cAMP_PKA -> AQP2_GeneExpression [label="sustained\nchronic signal"];
    AQP2_GeneExpression -> WaterPermeability;
    CollectingDuct_Cell -> V2_Receptor;
    NSIAD_GainOfFunction -> AQP2_MembraneInsert [color="#c0392b", label="constitutive\nactivation"];
    WaterPermeability -> FreeWaterReabsorption;
  }

  /* ───────────────────────── 4. Water Balance & Osmoregulation ───────────── */
  subgraph cluster_water {
    label="4. Water Balance & Osmoregulation";
    style="filled,rounded"; color="#5c6370"; fillcolor="#fff0f0"; fontsize=12;
    FreeWaterReabsorption [label="Renal free-water\nreabsorption ↑"];
    UrineOsmolality       [label="Urine osmolality\n(>100 mOsm/kg, inappropriately\nconcentrated)"];
    SerumOsmolality       [label="Serum osmolality ↓\n(<275 mOsm/kg)"];
    ElectrolyteFreeWaterCl[label="Electrolyte-free\nwater clearance ↓"];
    WaterIntake_Oral      [label="Oral/IV\nwater intake"];
    TotalBodyWater        [label="Total body water ↑\n(dilutional, no edema)"];
    DilutionalHyponatremia[label="Dilutional\nhyponatremia"];
    LowSoluteLimit        [label="Maximal free-water\nexcretion capacity\n(solute-dependent)"];

    FreeWaterReabsorption -> UrineOsmolality;
    WaterIntake_Oral -> TotalBodyWater;
    FreeWaterReabsorption -> TotalBodyWater;
    TotalBodyWater -> DilutionalHyponatremia;
    DilutionalHyponatremia -> SerumSodium;
    DilutionalHyponatremia -> SerumOsmolality;
    UrineOsmolality -> ElectrolyteFreeWaterCl [style=dashed];
    ElectrolyteFreeWaterCl -> DilutionalHyponatremia [color="#c0392b"];
    LowSoluteLimit -> ElectrolyteFreeWaterCl [style=dashed, color="#c0392b"];
    SerumOsmolality -> DiagnosticAlgorithm;
  }

  /* ───────────────────────── 5. Volume Status & Sodium Handling ──────────── */
  subgraph cluster_volume {
    label="5. Volume Status & Renal Sodium Handling";
    style="filled,rounded"; color="#5c6370"; fillcolor="#e8f0fe"; fontsize=12;
    Euvolemia_Status    [label="Clinical euvolemia\n(hallmark of SIADH)"];
    RAAS_Suppression    [label="RAAS suppression\n(volume-expanded sensing)"];
    ANP_BNP_Release     [label="ANP/BNP release\n(mild volume expansion)"];
    Natriuresis         [label="Pressure/ANP-mediated\nnatriuresis"];
    UrineSodium         [label="Urine sodium\n(>30-40 mEq/L)"];
    PlasmaReninActivity [label="Plasma renin\nactivity ↓"];
    AldosteroneLevel    [label="Aldosterone ↓"];
    CSW_Differential    [label="Cerebral salt-wasting\n(differential — hypovolemic,\nopposite therapy)"];
    VolumeAssessClinical[label="Clinical volume\nassessment (JVP, skin turgor,\northostatics)"];

    Euvolemia_Status -> RAAS_Suppression;
    TotalBodyWater -> ANP_BNP_Release [style=dashed];
    ANP_BNP_Release -> Natriuresis;
    Natriuresis -> UrineSodium;
    RAAS_Suppression -> PlasmaReninActivity;
    RAAS_Suppression -> AldosteroneLevel;
    UrineSodium -> DiagnosticAlgorithm;
    VolumeAssessClinical -> Euvolemia_Status;
    CSW_Differential -> VolumeAssessClinical [style=dashed, label="hypovolemic —\nmust exclude"];
  }

  /* ───────────────────────── 6. Neurological Consequences ───────────────── */
  subgraph cluster_neuro {
    label="6. Neurological Consequences of Hyponatremia";
    style="filled,rounded"; color="#5c6370"; fillcolor="#f0eafc"; fontsize=12;
    SerumSodium         [label="Serum sodium\n(mEq/L)"];
    CerebralEdema       [label="Cerebral edema\n(acute, water shift into brain)"];
    AstrocyteSwelling   [label="Astrocyte\nswelling"];
    BrainOrganicOsmolytes[label="Brain organic-osmolyte\nefflux (adaptive, taurine/\nglutamate/myo-inositol)"];
    CerebralAdaptChronic[label="Chronic cerebral\nadaptation (>48h)"];
    IntracranialPressure[label="Intracranial\npressure ↑"];
    Seizures            [label="Seizures"];
    ComaRisk            [label="Coma"];
    HerniationRisk      [label="Brain herniation\n(severe acute)"];
    ODS_Risk            [label="Osmotic demyelination\nsyndrome (ODS/CPM) risk"];

    SerumSodium -> CerebralEdema [color="#c0392b", label="rapid ↓Na"];
    CerebralEdema -> AstrocyteSwelling;
    AstrocyteSwelling -> BrainOrganicOsmolytes [label="adaptive\nresponse, 24-48h"];
    BrainOrganicOsmolytes -> CerebralAdaptChronic;
    AstrocyteSwelling -> IntracranialPressure;
    IntracranialPressure -> Seizures;
    IntracranialPressure -> ComaRisk;
    IntracranialPressure -> HerniationRisk [style=dashed];
    NaCorrectionRate24h -> ODS_Risk [color="#c0392b", label="rapid correction of\nchronic hyponatremia"];
    CerebralAdaptChronic -> ODS_Risk [style=dashed, label="depleted osmolytes\ncannot re-accumulate fast"];
  }

  /* ───────────────────────── 7. Clinical Manifestations & Endpoints ──────── */
  subgraph cluster_clin {
    label="7. Clinical Manifestations & Endpoints";
    style="filled,rounded"; color="#5c6370"; fillcolor="#f5f5f5"; fontsize=12;
    AsymptomaticMild   [label="Asymptomatic /\nmild (Na 130-134)"];
    Nausea_Malaise     [label="Nausea, malaise,\nheadache"];
    Confusion_Lethargy [label="Confusion,\nlethargy"];
    GaitInstability    [label="Gait instability,\nattention deficit (even\nmild chronic hyponatremia)"];
    FallsFractureRisk  [label="Falls & fracture\nrisk (elderly)"];
    SevereSymptoms     [label="Severe symptoms\n(Na <120, vomiting,\ncardioresp. distress)"];
    AcuteVsChronic     [label="Acute (<48h) vs\nchronic (≥48h) classification"];
    CognitiveImpairChronic[label="Chronic cognitive\nimpairment / osteoporosis\n(subclinical falls-fracture link)"];
    MortalityRisk      [label="Hospital length-of-stay\n& mortality association"];
    NeuroSymptomScore  [label="Composite neuro-symptom\nseverity score (0-10)"];

    SerumSodium -> AsymptomaticMild [style=dashed];
    SerumSodium -> Nausea_Malaise [color="#c0392b"];
    SerumSodium -> Confusion_Lethargy [color="#c0392b"];
    SerumSodium -> SevereSymptoms [color="#c0392b"];
    GaitInstability -> FallsFractureRisk;
    Confusion_Lethargy -> GaitInstability;
    AcuteVsChronic -> ODS_Risk [style=dashed];
    CognitiveImpairChronic -> FallsFractureRisk [style=dashed];
    Seizures -> NeuroSymptomScore [color="#c0392b"];
    ComaRisk -> NeuroSymptomScore [color="#c0392b"];
    Confusion_Lethargy -> NeuroSymptomScore;
    Nausea_Malaise -> NeuroSymptomScore;
    NeuroSymptomScore -> MortalityRisk [style=dashed];
  }

  /* ───────────────────────── 8. Drug PK/PD — Treatment ───────────────────── */
  subgraph cluster_drugpk {
    label="8. Drug PK/PD — Treatment of SIADH";
    style="filled,rounded"; color="#5c6370"; fillcolor="#eef2ff"; fontsize=12;
    Tolvaptan_Dose     [label="Tolvaptan\n15-60 mg PO QD"];
    Tolvaptan_Conc     [label="Tolvaptan\nplasma concentration"];
    Tolvaptan_V2Block  [label="Selective V2-receptor\nantagonism (vaptan)"];
    Conivaptan_Dose    [label="Conivaptan IV\n20 mg load + infusion"];
    Conivaptan_Conc    [label="Conivaptan\nplasma concentration"];
    Conivaptan_V1aV2Block[label="Dual V1a/V2\nreceptor antagonism"];
    Demeclocycline_Dose[label="Demeclocycline\n600-1200 mg/d PO"];
    Demeclocycline_Conc[label="Demeclocycline\nplasma concentration"];
    Demeclo_NephroDI   [label="Induced partial\nnephrogenic DI\n(post-receptor AQP2 blockade)"];
    HypertonicSaline3  [label="Hypertonic saline 3%\n(bolus/infusion, severe/acute)"];
    FluidRestriction    [label="Fluid restriction\n(<800-1000 mL/d, first-line)"];
    UreaOral_Therapy    [label="Oral urea\n(osmotic diuresis,\nsolute-load therapy)"];
    LoopDiuretic_Salt   [label="Loop diuretic +\noral salt tablets"];
    SGLT2i_Emerging     [label="SGLT2 inhibitor\n(emerging adjunct, osmotic diuresis)"];
    DDAVP_Clamp         [label="DDAVP co-administration\n(\"clamp\" — prevents\novercorrection)"];

    Tolvaptan_Dose -> Tolvaptan_Conc;
    Tolvaptan_Conc -> Tolvaptan_V2Block;
    Tolvaptan_V2Block -> V2_Receptor [color="#1a7a3c", label="⊣ competitive\nantagonism"];

    Conivaptan_Dose -> Conivaptan_Conc;
    Conivaptan_Conc -> Conivaptan_V1aV2Block;
    Conivaptan_V1aV2Block -> V2_Receptor [color="#1a7a3c"];
    Conivaptan_V1aV2Block -> BaroreceptorReflex [style=dashed, color="#1a7a3c", label="V1a vascular\nantagonism"];

    Demeclocycline_Dose -> Demeclocycline_Conc;
    Demeclocycline_Conc -> Demeclo_NephroDI;
    Demeclo_NephroDI -> AQP2_MembraneInsert [color="#1a7a3c", label="⊣ post-receptor\n(cAMP-independent)"];

    HypertonicSaline3 -> SerumSodium [color="#1a7a3c", label="direct osmotic\nNa correction"];
    HypertonicSaline3 -> NaCorrectionRate24h;

    FluidRestriction -> WaterIntake_Oral [color="#1a7a3c", label="⊣"];

    UreaOral_Therapy -> ElectrolyteFreeWaterCl [color="#1a7a3c", label="↑ (obligate\nosmotic diuresis)"];

    LoopDiuretic_Salt -> UrineOsmolality [color="#1a7a3c", label="⊣ dilutes medullary\ngradient"];

    SGLT2i_Emerging -> ElectrolyteFreeWaterCl [style=dashed, color="#1a7a3c"];

    DDAVP_Clamp -> V2_Receptor [style=dashed, color="#1a7a3c", label="controlled re-agonism\n⊣ overcorrection"];
  }

  /* ───────────────────────── 9. Correction-Rate Safety ───────────────────── */
  subgraph cluster_safety {
    label="9. Na-Correction-Rate Safety & ODS Prevention";
    style="filled,rounded"; color="#5c6370"; fillcolor="#fdeef0"; fontsize=12;
    NaCorrectionRate24h [label="ΔNa over 24h\n(mEq/L)"];
    NaCorrectionRate48h [label="ΔNa over 48h\n(mEq/L)"];
    GuidelineLimit_8_18 [label="Guideline limits\n(≤8/24h, ≤18/48h;\n≤4-6/24h if high-risk)"];
    OverCorrectionEvent [label="Overcorrection\nevent flag"];
    RelowerProtocol     [label="Relowering protocol\n(D5W + DDAVP if\novercorrected)"];
    HighRiskFlag        [label="High-risk flag\n(alcoholism, malnutrition,\nliver disease, hypokalemia)"];

    HypertonicSaline3 -> NaCorrectionRate24h;
    Tolvaptan_V2Block -> NaCorrectionRate24h [style=dashed];
    Conivaptan_V1aV2Block -> NaCorrectionRate24h [style=dashed];
    NaCorrectionRate24h -> NaCorrectionRate48h;
    NaCorrectionRate24h -> OverCorrectionEvent [style=dashed];
    GuidelineLimit_8_18 -> OverCorrectionEvent [style=dashed, color="#1a7a3c", label="threshold\ncheck"];
    OverCorrectionEvent -> RelowerProtocol [color="#c0392b"];
    RelowerProtocol -> SerumSodium [style=dashed, color="#1a7a3c", label="controlled\nre-lowering"];
    HighRiskFlag -> ODS_Risk [style=dashed, color="#c0392b"];
  }

  /* ───────────────────────── 10. Biomarkers & Diagnostic Monitoring ──────── */
  subgraph cluster_biomarker {
    label="10. Biomarkers & Diagnostic Monitoring";
    style="filled,rounded"; color="#5c6370"; fillcolor="#e6f7f5"; fontsize=12;
    CopeptinLevel       [label="Plasma copeptin\n(stable AVP surrogate)"];
    SerumOsmTest        [label="Serum osmolality\ntest (point-of-care)"];
    UrineOsmTest        [label="Urine osmolality\ntest"];
    UrineNaTest         [label="Urine sodium\ntest"];
    FENa_FEUrea         [label="FENa / FEUrea\n(diuretic-confounded cases)"];
    DiagnosticAlgorithm [label="Bartter-Schwartz /\nVerbalis diagnostic algorithm"];
    UricAcid_Hypouricemia[label="Serum uric acid ↓\n(hypouricemia, volume-expansion marker)"];
    TSH_Cortisol_Exclude[label="TSH/cortisol testing\n(exclude hypothyroid/\nadrenal insufficiency mimics)"];

    PlasmaAVP_Level -> CopeptinLevel [style=dashed];
    SerumOsmolality -> SerumOsmTest;
    UrineOsmolality -> UrineOsmTest;
    UrineSodium -> UrineNaTest;
    UrineNaTest -> FENa_FEUrea [style=dashed];
    SerumOsmTest -> DiagnosticAlgorithm;
    UrineOsmTest -> DiagnosticAlgorithm;
    UrineNaTest -> DiagnosticAlgorithm;
    Euvolemia_Status -> UricAcid_Hypouricemia [style=dashed];
    TSH_Cortisol_Exclude -> DiagnosticAlgorithm [style=dashed, label="rule out\nmimics"];
  }
}
