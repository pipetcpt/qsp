digraph CAP_QSP {
  rankdir=LR;
  fontname="Helvetica";
  labelloc="t";
  fontsize=20;
  label="Community-Acquired Pneumonia (CAP) — Mechanistic QSP Map\nPathogen burden × Host inflammatory amplification × Antibiotic PK/PD × Lysis-coupled PAMP release × Conditional corticosteroid benefit";
  node [style=filled, fontname="Helvetica", fontsize=10, shape=box];
  edge [fontname="Helvetica", fontsize=8];
  compound=true;
  nodesep=0.22;
  ranksep=0.55;

  /* ============================================================
     1. Host susceptibility & portal of entry
     ============================================================ */
  subgraph cluster_host {
    label="1. 숙주 감수성 · 침입 경로 (Host Susceptibility & Portal of Entry)";
    style=filled; color="#e0dcf0"; fillcolor="#f2effa";
    Age [label="Age ≥65\n(immunosenescence)"];
    Comorbid_COPD [label="COPD / structural\nlung disease"];
    Comorbid_CHF [label="Heart failure /\ndiabetes / CKD"];
    Immunosupp [label="Immunosuppression\n(steroid, chemo, HIV)"];
    Smoking [label="Smoking\n(ciliary dysfunction)"];
    Alcohol_aspiration [label="Alcohol / impaired\nconsciousness → aspiration"];
    Vaccine_status [label="PCV20 / PPSV23 /\ninfluenza vaccination"];
    Nasoph_colonization [label="Nasopharyngeal\ncolonization (carriage)"];
    Microaspiration [label="Micro-aspiration of\noropharyngeal secretions"];
    Inhalation_droplet [label="Droplet / aerosol\ninhalation (Legionella, Mp)"];
    Mucociliary [label="Mucociliary\nescalator clearance"];
    Cough_reflex [label="Cough reflex /\nglottic closure"];
    IgA_secretory [label="Secretory IgA\n(mucosal)"];
    Anticapsular_Ab [label="Pre-existing\nanti-capsular IgG"];
  }

  /* ============================================================
     2. Pathogen & virulence factors
     ============================================================ */
  subgraph cluster_path {
    label="2. 병원체 · 병독인자 (Pathogen & Virulence Factors)";
    style=filled; color="#f2d6d6"; fillcolor="#fbecec";
    Spneumo [label="Streptococcus pneumoniae\n(~30-50% of typed CAP)", fillcolor="#f6c9c9"];
    Hinfluenzae [label="Haemophilus\ninfluenzae"];
    Mpneumoniae [label="Mycoplasma pneumoniae\n(atypical)"];
    Legionella [label="Legionella\npneumophila"];
    Saureus [label="Staphylococcus aureus\n(post-influenza)"];
    GramNeg [label="Enterobacterales /\nP. aeruginosa (risk-factored)"];
    Virus_flu [label="Influenza A / RSV /\nSARS-CoV-2"];
    Capsule [label="Polysaccharide capsule\n(anti-opsonophagocytic)"];
    Pneumolysin [label="Pneumolysin (Ply)\ncholesterol-dependent cytolysin", fillcolor="#f6c9c9"];
    LytA [label="LytA autolysin\n(cell-wall hydrolase)"];
    PspA_PspC [label="PspA / PspC\n(complement evasion)"];
    NanA [label="Neuraminidase A\n(desialylation)"];
    LTA_PGN [label="Lipoteichoic acid /\npeptidoglycan (PAMP)"];
    CpG_DNA [label="Bacterial CpG DNA\n(PAMP)"];
    Biofilm [label="Biofilm / intracellular\nsanctuary niche"];
    Bacterial_growth [label="Replication\n(kg, capacity-limited)"];
  }

  /* ============================================================
     3. Alveolar epithelium & barrier
     ============================================================ */
  subgraph cluster_epi {
    label="3. 폐포 상피 · 폐포-모세혈관 장벽 (Alveolar Epithelium & Barrier)";
    style=filled; color="#d4ead8"; fillcolor="#ecf7ee";
    AT1 [label="AT1 pneumocyte\n(gas-exchange surface)"];
    AT2 [label="AT2 pneumocyte\n(surfactant + progenitor)"];
    Tight_junction [label="Tight junctions\n(claudin-4/18, ZO-1)"];
    Glycocalyx [label="Endothelial\nglycocalyx"];
    Endothelium [label="Pulmonary capillary\nendothelium"];
    Surfactant [label="Surfactant\n(SP-A, SP-B, SP-C, SP-D)"];
    ENaC_NaK [label="ENaC / Na-K-ATPase\n(alveolar fluid clearance)"];
    Barrier_perm [label="Alveolar-capillary\npermeability ↑", fillcolor="#c9e6cf"];
    Alveolar_edema [label="Protein-rich alveolar\nedema / consolidation", fillcolor="#c9e6cf"];
    Hyaline_membrane [label="Hyaline membrane /\nfibrin deposition"];
    Epi_apoptosis [label="Epithelial apoptosis /\npyroptosis";];
  }

  /* ============================================================
     4. Innate immune recognition
     ============================================================ */
  subgraph cluster_pri {
    label="4. 선천면역 인지 (Pattern Recognition & Signalling)";
    style=filled; color="#f7e2c6"; fillcolor="#fdf2e2";
    TLR2 [label="TLR2\n(LTA, lipoproteins)"];
    TLR4 [label="TLR4\n(pneumolysin, LPS)"];
    TLR9 [label="TLR9\n(CpG DNA)"];
    NOD2 [label="NOD2\n(muramyl dipeptide)"];
    NLRP3 [label="NLRP3\ninflammasome", fillcolor="#f4d3a5"];
    cGAS_STING [label="cGAS–STING\n(cytosolic DNA)"];
    MyD88 [label="MyD88 /\nIRAK4"];
    NFkB [label="NF-κB\n(p65/p50)", fillcolor="#f4d3a5"];
    IRF3 [label="IRF3 / type-I\nIFN response"];
    Caspase1 [label="Caspase-1\n(pro-IL-1β → IL-1β)"];
    GSDMD [label="Gasdermin-D\npyroptosis"];
    PAMP_pool [label="Free PAMP pool\n(LTA/PGN/Ply/DNA)", fillcolor="#f4d3a5"];
    DAMP_pool [label="DAMPs (HMGB1,\nmtDNA, ATP)"];
  }

  /* ============================================================
     5. Cellular effectors
     ============================================================ */
  subgraph cluster_cell {
    label="5. 세포 효과기 (Cellular Effectors)";
    style=filled; color="#d9e3f5"; fillcolor="#eef2fb";
    AlvMac [label="Alveolar macrophage\n(first-line phagocyte)", fillcolor="#c6d5ee"];
    AlvMac_apop [label="AM apoptosis-associated\nintracellular killing"];
    Neut_blood [label="Circulating\nneutrophils"];
    Neut_lung [label="Lung-recruited\nneutrophils", fillcolor="#c6d5ee"];
    Monocyte [label="Recruited\nmonocytes"];
    MonoMac_M1 [label="M1 monocyte-derived\nmacrophage"];
    MonoMac_M2 [label="M2 / reparative\nmacrophage"];
    NK_gd [label="NK / γδ T cells\n(early IFN-γ)"];
    Th17 [label="Th17\n(IL-17A → G-CSF, CXCL)"];
    Complement_op [label="Complement C3b\nopsonization"];
    Phagocytosis [label="Opsonophagocytic\nkilling", fillcolor="#c6d5ee"];
    NETs [label="Neutrophil extracellular\ntraps (NETs)"];
    MPO_NE [label="Myeloperoxidase /\nneutrophil elastase"];
    ROS_burst [label="Oxidative burst\n(NADPH oxidase, ROS)"];
    Efferocytosis [label="Efferocytosis of\napoptotic neutrophils"];
    Lymphopenia [label="Lymphopenia\n(severity marker)"];
  }

  /* ============================================================
     6. Cytokine / chemokine network
     ============================================================ */
  subgraph cluster_cyt {
    label="6. 사이토카인 · 케모카인 네트워크 (Cytokine Network)";
    style=filled; color="#f3d5ea"; fillcolor="#fbeef7";
    TNFa [label="TNF-α", fillcolor="#eec0dd"];
    IL1b [label="IL-1β", fillcolor="#eec0dd"];
    IL6 [label="IL-6", fillcolor="#eec0dd"];
    IL8 [label="IL-8 / CXCL8\n(neutrophil chemotaxis)"];
    CXCL1_2 [label="CXCL1 / CXCL2\n(KC, MIP-2)"];
    CCL2 [label="CCL2\n(monocyte recruitment)"];
    IFNg [label="IFN-γ"];
    IL17A [label="IL-17A"];
    GCSF_GMCSF [label="G-CSF / GM-CSF\n(granulopoiesis)"];
    IL10 [label="IL-10\n(counter-regulatory)", fillcolor="#eec0dd"];
    TGFb [label="TGF-β\n(repair / fibrosis)"];
    Cytokine_amp [label="Feed-forward cytokine\namplification loop", fillcolor="#e5a8cd"];
    CARS [label="Compensatory anti-inflammatory\nresponse (immunoparalysis)"];
  }

  /* ============================================================
     7. Acute-phase response & biomarkers
     ============================================================ */
  subgraph cluster_bio {
    label="7. 급성기 반응 · 바이오마커 (Acute-Phase Response & Biomarkers)";
    style=filled; color="#e6f0c9"; fillcolor="#f4f9e6";
    Hepatocyte_APR [label="Hepatocyte\nacute-phase programme"];
    CRP [label="CRP\n(t½ ≈ 19 h, IL-6-driven)", fillcolor="#dbeaa8"];
    PCT [label="Procalcitonin\n(t½ ≈ 24 h, bacteria-specific)", fillcolor="#dbeaa8"];
    Ferritin [label="Ferritin /\nfibrinogen"];
    MRproADM [label="MR-proADM /\nsuPAR / presepsin"];
    WBC_left [label="Leukocytosis /\nleft shift"];
    Albumin_drop [label="Hypoalbuminaemia\n(negative APR)"];
    Blood_culture [label="Blood culture /\nurinary antigen / PCR"];
  }

  /* ============================================================
     8. Gas exchange & respiratory mechanics
     ============================================================ */
  subgraph cluster_gas {
    label="8. 가스교환 · 호흡역학 (Gas Exchange & Respiratory Mechanics)";
    style=filled; color="#cfe7ef"; fillcolor="#e8f5f9";
    Consolidation [label="Lobar / multilobar\nconsolidation (radiographic)"];
    VQ_mismatch [label="V/Q mismatch"];
    Shunt [label="True intrapulmonary\nshunt fraction Qs/Qt", fillcolor="#b8dbe8"];
    HPV [label="Hypoxic pulmonary\nvasoconstriction (protective)"];
    Deadspace [label="Dead-space\nventilation ↑"];
    Compliance [label="Static compliance ↓\n(loss of aerated lung)"];
    WOB [label="Work of breathing ↑\n(RR, accessory muscles)"];
    PaO2FiO2 [label="PaO₂/FiO₂ ratio", fillcolor="#b8dbe8"];
    SpO2 [label="SpO₂ / hypoxaemia"];
    Hypercapnia [label="Hypercapnia /\nrespiratory acidosis"];
    O2_therapy [label="O₂ / HFNC / NIV\n/ invasive ventilation"];
    VILI [label="Ventilator-induced\nlung injury"];
  }

  /* ============================================================
     9. Systemic spread & organ dysfunction
     ============================================================ */
  subgraph cluster_sys {
    label="9. 전신 파급 · 장기부전 (Systemic Spread & Organ Dysfunction)";
    style=filled; color="#f0dcd0"; fillcolor="#faeee6";
    Bacteremia [label="Bacteraemia\n(blood compartment)", fillcolor="#e6c3ad"];
    Endothelial_act [label="Systemic endothelial\nactivation"];
    iNOS_NO [label="iNOS → NO\nvasoplegia"];
    Cap_leak [label="Systemic capillary\nleak"];
    MAP_drop [label="MAP ↓ /\nvasopressor need", fillcolor="#e6c3ad"];
    Lactate [label="Lactate ↑\n(tissue hypoperfusion)", fillcolor="#e6c3ad"];
    AKI [label="Acute kidney injury\n(creatinine ↑, urea ↑)"];
    DIC_coag [label="Coagulopathy /\nDIC, platelet ↓"];
    Myocardial [label="Myocardial injury /\nnew AF, MI, HF"];
    Encephalopathy [label="Encephalopathy /\nconfusion (CURB 'C')"];
    SOFA [label="SOFA score", fillcolor="#e6c3ad"];
    CURB65 [label="CURB-65 / PSI /\nATS-IDSA severe-CAP criteria"];
  }

  /* ============================================================
     10. Antibiotic PK
     ============================================================ */
  subgraph cluster_pk {
    label="10. 항생제 약동학 (Antibiotic Pharmacokinetics)";
    style=filled; color="#d7d7e8"; fillcolor="#eeeef7";
    Ceftriaxone [label="Ceftriaxone 2 g IV q24h\n(β-lactam)", fillcolor="#c2c2dd"];
    Amoxicillin [label="Amoxicillin 1 g PO q8h\n(β-lactam)"];
    Azithromycin [label="Azithromycin 500 mg\n(macrolide)", fillcolor="#c2c2dd"];
    Levofloxacin [label="Levofloxacin 750 mg\n(fluoroquinolone)", fillcolor="#c2c2dd"];
    Oral_absorption [label="Oral absorption\n(ka, F)"];
    Protein_binding [label="Plasma protein binding\n(ceftriaxone ~85-95%)"];
    Vd_central [label="Central volume /\nplasma concentration"];
    Peripheral_cmt [label="Peripheral tissue\ncompartment"];
    ELF_partition [label="Epithelial lining fluid\npenetration (ELF/plasma)", fillcolor="#c2c2dd"];
    Lung_accum [label="Intracellular / lung-tissue\naccumulation (azithromycin ×100)"];
    Renal_CL [label="Renal clearance\n(CrCl-dependent)"];
    Hepatic_CL [label="Hepatic / biliary\nclearance, CYP3A4"];
    AUG_RC [label="Augmented renal clearance /\nAKI-reduced clearance"];
  }

  /* ============================================================
     11. Antibiotic PD & resistance
     ============================================================ */
  subgraph cluster_pd {
    label="11. 항생제 약력학 · 내성 (Antibiotic PD & Resistance)";
    style=filled; color="#e8d7c2"; fillcolor="#f7eee2";
    MIC [label="MIC of infecting\nstrain", fillcolor="#dcbf9e"];
    fT_MIC [label="fT>MIC\n(β-lactam index, emergent)", fillcolor="#dcbf9e"];
    AUC_MIC [label="fAUC₂₄/MIC\n(quinolone index)", fillcolor="#dcbf9e"];
    Emax_kill [label="Concentration-dependent\nEmax killing function"];
    PBP_target [label="PBP2x / PBP2b\n(mosaic penicillin-binding proteins)"];
    Ribosome_50S [label="50S ribosome\n(macrolide target)"];
    GyrA_ParC [label="GyrA / ParC\n(quinolone target)"];
    ermB_mefA [label="ermB / mefA\nmacrolide resistance"];
    Efflux [label="Efflux pumps /\nadaptive resistance"];
    MPC_window [label="Mutant selection\nwindow"];
    Persisters [label="Non-replicating persisters /\nintracellular refuge"];
    Lysis_mode [label="Bacteriolytic vs\nnon-lytic killing mode", fillcolor="#dcbf9e"];
  }

  /* ============================================================
     12. Adjunctive therapy
     ============================================================ */
  subgraph cluster_adj {
    label="12. 보조요법 (Adjunctive Therapy)";
    style=filled; color="#cfe3d8"; fillcolor="#e8f4ee";
    Hydrocortisone [label="Hydrocortisone 200 mg/d ×4-8 d\n(CAPE-COD)", fillcolor="#b3d4c3"];
    Dexamethasone [label="Dexamethasone /\nprednisone alternatives"];
    GR_receptor [label="Glucocorticoid receptor\n(cytosolic → nuclear)"];
    NFkB_transrepr [label="NF-κB transrepression /\nGRE transactivation"];
    AnnexinA1 [label="Annexin A1 /\nMKP-1 induction"];
    Steroid_immunosupp [label="Impaired phagocyte\nkilling (adverse arm)", fillcolor="#b3d4c3"];
    Hyperglycemia [label="Hyperglycaemia /\nsuperinfection risk"];
    Macrolide_immuno [label="Macrolide immunomodulation\n(non-antibacterial)", fillcolor="#b3d4c3"];
    Fluids_vasopressor [label="Fluid resuscitation /\nnoradrenaline"];
    VTE_ppx [label="VTE prophylaxis /\nsupportive care"];
    Antiviral [label="Oseltamivir / antiviral\n(if influenza)"];
  }

  /* ============================================================
     13. Resolution & repair
     ============================================================ */
  subgraph cluster_res {
    label="13. 해소 · 조직 복구 (Resolution & Repair)";
    style=filled; color="#dde8c8"; fillcolor="#f0f6e4";
    Bacterial_clearance [label="Bacterial clearance\n(sterilization)", fillcolor="#cadfab"];
    Neut_apoptosis [label="Neutrophil apoptosis\n(programmed shutdown)"];
    SPMs [label="Specialized pro-resolving mediators\n(lipoxin A4, resolvin D1)"];
    Edema_reabsorb [label="Alveolar fluid\nreabsorption"];
    AT2_to_AT1 [label="AT2 → AT1\ntransdifferentiation"];
    Matrix_remodel [label="Matrix remodelling\n(MMP/TIMP balance)"];
    Organizing_pna [label="Organizing pneumonia /\nfibroproliferation"];
    Radiographic_res [label="Radiographic resolution\n(weeks, lags clinical)", fillcolor="#cadfab"];
    Trained_immunity [label="Trained immunity /\npost-infection immune scar"];
  }

  /* ============================================================
     14. Clinical endpoints
     ============================================================ */
  subgraph cluster_out {
    label="14. 임상 결과 (Clinical Endpoints)";
    style=filled; color="#f0d2d2"; fillcolor="#fbe9e9";
    Fever_curve [label="Fever / temperature\ndefervescence"];
    TCS [label="Time to clinical stability\n(Halm criteria)", fillcolor="#eebcbc"];
    Symptom_score [label="Cough / dyspnoea /\nsymptom score (CAP-Sym)"];
    Treatment_failure [label="Early treatment failure\n(72 h deterioration)", fillcolor="#eebcbc"];
    ICU_transfer [label="ICU transfer /\nmechanical ventilation"];
    LOS [label="Hospital length\nof stay"];
    Mortality_28d [label="28-/30-day\nmortality", fillcolor="#e59d9d"];
    Relapse [label="Relapse after early\nantibiotic stop"];
    Readmission [label="30-day\nreadmission"];
    Long_CV [label="Long-term cardiovascular\nevents (1-10 y)"];
    Antibiotic_duration [label="Antibiotic duration\n(5 d vs 8-10 d; PCT-guided)"];
  }

  /* ============================================================
     EDGES — susceptibility → colonization → infection
     ============================================================ */
  Age -> Nasoph_colonization;
  Age -> Anticapsular_Ab [label="↓", style=dashed, color="#b03030"];
  Comorbid_COPD -> Mucociliary [label="↓", style=dashed, color="#b03030"];
  Comorbid_CHF -> Barrier_perm;
  Immunosupp -> Phagocytosis [label="↓", style=dashed, color="#b03030"];
  Smoking -> Mucociliary [label="↓", style=dashed, color="#b03030"];
  Smoking -> Nasoph_colonization;
  Alcohol_aspiration -> Microaspiration;
  Alcohol_aspiration -> Cough_reflex [label="↓", style=dashed, color="#b03030"];
  Vaccine_status -> Anticapsular_Ab [label="+"];
  Vaccine_status -> Nasoph_colonization [label="↓", style=dashed, color="#b03030"];
  Nasoph_colonization -> Microaspiration;
  Microaspiration -> Spneumo;
  Inhalation_droplet -> Legionella;
  Inhalation_droplet -> Mpneumoniae;
  Mucociliary -> Spneumo [label="clearance ↓", style=dashed, color="#b03030"];
  Cough_reflex -> Microaspiration [label="↓", style=dashed, color="#b03030"];
  IgA_secretory -> Nasoph_colonization [label="↓", style=dashed, color="#b03030"];
  Anticapsular_Ab -> Complement_op [label="+"];

  /* virulence */
  Spneumo -> Bacterial_growth;
  Spneumo -> Capsule; Spneumo -> Pneumolysin; Spneumo -> LytA;
  Spneumo -> PspA_PspC; Spneumo -> NanA; Spneumo -> LTA_PGN; Spneumo -> CpG_DNA;
  Spneumo -> Biofilm;
  Hinfluenzae -> Bacterial_growth; Mpneumoniae -> Bacterial_growth;
  Legionella -> Bacterial_growth; Saureus -> Bacterial_growth; GramNeg -> Bacterial_growth;
  Virus_flu -> NanA [label="synergy"];
  Virus_flu -> Epi_apoptosis;
  Virus_flu -> Nasoph_colonization [label="↑ adherence"];
  Virus_flu -> Saureus [label="post-influenza"];
  Capsule -> Phagocytosis [label="↓ opsonophagocytosis", style=dashed, color="#b03030"];
  PspA_PspC -> Complement_op [label="↓", style=dashed, color="#b03030"];
  NanA -> Tight_junction [label="desialylation"];
  Pneumolysin -> Epi_apoptosis;
  Pneumolysin -> Tight_junction [label="pore formation", color="#b03030"];
  Pneumolysin -> TLR4;
  Pneumolysin -> NLRP3;
  Pneumolysin -> Mucociliary [label="↓ ciliary beat", style=dashed, color="#b03030"];
  LytA -> PAMP_pool [label="autolysis → cell-wall release"];
  LTA_PGN -> TLR2; LTA_PGN -> NOD2; LTA_PGN -> PAMP_pool;
  CpG_DNA -> TLR9; CpG_DNA -> cGAS_STING; CpG_DNA -> PAMP_pool;
  Biofilm -> Persisters;
  Bacterial_growth -> Bacteremia;

  /* PRR signalling */
  TLR2 -> MyD88; TLR4 -> MyD88; TLR9 -> MyD88; NOD2 -> NFkB;
  MyD88 -> NFkB; TLR4 -> IRF3; cGAS_STING -> IRF3;
  NFkB -> TNFa; NFkB -> IL6; NFkB -> IL8; NFkB -> CXCL1_2; NFkB -> CCL2;
  NFkB -> NLRP3 [label="priming"];
  NLRP3 -> Caspase1; Caspase1 -> IL1b; Caspase1 -> GSDMD;
  GSDMD -> Epi_apoptosis; GSDMD -> DAMP_pool;
  Epi_apoptosis -> DAMP_pool;
  DAMP_pool -> TLR4; DAMP_pool -> NLRP3;
  PAMP_pool -> TLR2; PAMP_pool -> TLR4; PAMP_pool -> TLR9; PAMP_pool -> NLRP3;
  IRF3 -> IFNg;

  /* cellular effectors */
  AlvMac -> Phagocytosis; AlvMac -> TNFa; AlvMac -> IL1b; AlvMac -> IL6; AlvMac -> IL8;
  AlvMac -> AlvMac_apop; AlvMac_apop -> Phagocytosis [label="intracellular killing"];
  IL8 -> Neut_lung; CXCL1_2 -> Neut_lung;
  Neut_blood -> Neut_lung [label="transmigration"];
  GCSF_GMCSF -> Neut_blood;
  CCL2 -> Monocyte; Monocyte -> MonoMac_M1; MonoMac_M1 -> TNFa; MonoMac_M1 -> IL1b;
  MonoMac_M1 -> MonoMac_M2 [label="phenotype switch"];
  NK_gd -> IFNg; IFNg -> MonoMac_M1;
  Th17 -> IL17A; IL17A -> GCSF_GMCSF; IL17A -> CXCL1_2;
  Complement_op -> Phagocytosis;
  Neut_lung -> Phagocytosis; Neut_lung -> NETs; Neut_lung -> MPO_NE; Neut_lung -> ROS_burst;
  Phagocytosis -> Bacterial_clearance;
  NETs -> Barrier_perm; MPO_NE -> Barrier_perm; MPO_NE -> Surfactant [label="degradation", style=dashed, color="#b03030"];
  ROS_burst -> Epi_apoptosis;
  TNFa -> Barrier_perm; IL1b -> Barrier_perm; IL1b -> Tight_junction [label="↓", style=dashed, color="#b03030"];
  TNFa -> Tight_junction [label="↓", style=dashed, color="#b03030"];
  IFNg -> Lymphopenia;
  Cytokine_amp -> Lymphopenia;

  /* cytokine loop */
  TNFa -> Cytokine_amp; IL1b -> Cytokine_amp; IL6 -> Cytokine_amp;
  Cytokine_amp -> TNFa; Cytokine_amp -> IL1b; Cytokine_amp -> IL6; Cytokine_amp -> IL8;
  Cytokine_amp -> IL10 [label="delayed"];
  IL10 -> Cytokine_amp [label="−", color="#2060a0", style=dashed];
  IL10 -> Phagocytosis [label="−", color="#2060a0", style=dashed];
  IL10 -> CARS; CARS -> Bacterial_clearance [label="−", color="#2060a0", style=dashed];
  TGFb -> Matrix_remodel;

  /* acute-phase */
  IL6 -> Hepatocyte_APR; IL1b -> Hepatocyte_APR; TNFa -> Hepatocyte_APR;
  Hepatocyte_APR -> CRP; Hepatocyte_APR -> Ferritin; Hepatocyte_APR -> Albumin_drop;
  LTA_PGN -> PCT [label="bacterial-specific induction"];
  IL1b -> PCT; TNFa -> PCT;
  IFNg -> PCT [label="−(viral)", color="#2060a0", style=dashed];
  Cytokine_amp -> MRproADM;
  GCSF_GMCSF -> WBC_left;
  Bacteremia -> Blood_culture;

  /* gas exchange */
  Alveolar_edema -> Consolidation;
  Barrier_perm -> Alveolar_edema;
  Surfactant -> Compliance;
  Surfactant -> Alveolar_edema [label="↓ surface tension", style=dashed, color="#2060a0"];
  ENaC_NaK -> Edema_reabsorb;
  Alveolar_edema -> VQ_mismatch; Consolidation -> Shunt; VQ_mismatch -> Shunt;
  HPV -> Shunt [label="−", color="#2060a0", style=dashed];
  Cytokine_amp -> HPV [label="blunts", style=dashed, color="#b03030"];
  Shunt -> PaO2FiO2 [label="−", color="#b03030"];
  PaO2FiO2 -> SpO2;
  Consolidation -> Compliance [label="−", color="#b03030"];
  Compliance -> WOB [label="−", color="#b03030"];
  Deadspace -> WOB; Deadspace -> Hypercapnia;
  WOB -> Hypercapnia;
  PaO2FiO2 -> O2_therapy; O2_therapy -> SpO2;
  O2_therapy -> VILI; VILI -> Barrier_perm;
  AT1 -> Shunt [label="loss ↑", style=dashed, color="#b03030"];
  AT2 -> Surfactant; AT2 -> ENaC_NaK;
  Epi_apoptosis -> AT1 [label="−", color="#b03030"]; Epi_apoptosis -> AT2 [label="−", color="#b03030"];
  Tight_junction -> Barrier_perm [label="−", color="#2060a0", style=dashed];
  Glycocalyx -> Barrier_perm [label="−", color="#2060a0", style=dashed];
  Endothelium -> Glycocalyx;
  Hyaline_membrane -> Compliance [label="−", color="#b03030"];
  Alveolar_edema -> Hyaline_membrane;

  /* systemic */
  Bacteremia -> Endothelial_act; Cytokine_amp -> Endothelial_act;
  Endothelial_act -> iNOS_NO; Endothelial_act -> Cap_leak; Endothelial_act -> Glycocalyx [label="shedding", color="#b03030"];
  iNOS_NO -> MAP_drop; Cap_leak -> MAP_drop;
  MAP_drop -> Lactate; MAP_drop -> AKI; MAP_drop -> Encephalopathy;
  Lactate -> SOFA; MAP_drop -> SOFA; PaO2FiO2 -> SOFA; AKI -> SOFA;
  DIC_coag -> SOFA; Encephalopathy -> SOFA;
  Endothelial_act -> DIC_coag;
  Cytokine_amp -> Myocardial; Bacteremia -> Myocardial;
  SOFA -> Mortality_28d; CURB65 -> Mortality_28d;
  Encephalopathy -> CURB65; MAP_drop -> CURB65; Age -> CURB65; AKI -> CURB65; WOB -> CURB65;
  AKI -> Renal_CL [label="↓", style=dashed, color="#b03030"];
  AUG_RC -> Renal_CL;

  /* PK */
  Ceftriaxone -> Vd_central; Amoxicillin -> Oral_absorption; Oral_absorption -> Vd_central;
  Azithromycin -> Oral_absorption; Levofloxacin -> Oral_absorption;
  Vd_central -> Peripheral_cmt; Vd_central -> Protein_binding;
  Protein_binding -> ELF_partition [label="free fraction only"];
  Vd_central -> ELF_partition;
  Azithromycin -> Lung_accum; Lung_accum -> ELF_partition;
  Vd_central -> Renal_CL; Vd_central -> Hepatic_CL;
  Renal_CL -> Vd_central [label="elimination", style=dashed];
  Hepatic_CL -> Vd_central [label="elimination", style=dashed];

  /* PD */
  ELF_partition -> Emax_kill;
  MIC -> Emax_kill [label="EC50 ∝ MIC", color="#b03030"];
  Emax_kill -> fT_MIC; Emax_kill -> AUC_MIC;
  Ceftriaxone -> PBP_target; Amoxicillin -> PBP_target;
  Azithromycin -> Ribosome_50S; Levofloxacin -> GyrA_ParC;
  PBP_target -> Lysis_mode [label="bacteriolytic"];
  Ribosome_50S -> Lysis_mode [label="non-lytic", color="#2060a0"];
  GyrA_ParC -> Lysis_mode [label="low-lysis", color="#2060a0"];
  ermB_mefA -> Ribosome_50S [label="−", color="#b03030"];
  GyrA_ParC -> MPC_window;
  Efflux -> MIC [label="↑"];
  PBP_target -> MIC [label="mosaic → ↑"];
  Emax_kill -> Bacterial_growth [label="kill", color="#2060a0"];
  Emax_kill -> Bacterial_clearance;
  Persisters -> Emax_kill [label="phenotypic tolerance", style=dashed, color="#b03030"];
  Persisters -> Relapse;

  /* the central lysis-PAMP coupling */
  Lysis_mode -> PAMP_pool [label="lysis-coupled PAMP burst", color="#b03030", penwidth=2];
  Emax_kill -> PAMP_pool [label="∝ kill rate × lysis yield", color="#b03030", penwidth=2];
  Azithromycin -> Pneumolysin [label="↓ toxin synthesis", color="#2060a0", penwidth=2];
  Azithromycin -> Macrolide_immuno;
  Macrolide_immuno -> Cytokine_amp [label="−", color="#2060a0", penwidth=2];
  Macrolide_immuno -> IL8 [label="−", color="#2060a0", style=dashed];
  Macrolide_immuno -> Neut_lung [label="−", color="#2060a0", style=dashed];
  Macrolide_immuno -> Mortality_28d [label="− (independent of MIC)", color="#2060a0"];

  /* corticosteroid: two-armed */
  Hydrocortisone -> GR_receptor; Dexamethasone -> GR_receptor;
  GR_receptor -> NFkB_transrepr; GR_receptor -> AnnexinA1;
  NFkB_transrepr -> NFkB [label="−", color="#2060a0", penwidth=2];
  NFkB_transrepr -> Cytokine_amp [label="−", color="#2060a0", penwidth=2];
  AnnexinA1 -> Neut_lung [label="−", color="#2060a0", style=dashed];
  GR_receptor -> Steroid_immunosupp;
  Steroid_immunosupp -> Phagocytosis [label="−", color="#b03030", penwidth=2];
  Steroid_immunosupp -> Bacterial_clearance [label="−", color="#b03030", penwidth=2];
  GR_receptor -> Hyperglycemia; Hyperglycemia -> Treatment_failure;
  Hydrocortisone -> MAP_drop [label="− (vasopressor sparing)", color="#2060a0"];
  Fluids_vasopressor -> MAP_drop [label="−", color="#2060a0"];
  Antiviral -> Virus_flu [label="−", color="#2060a0"];
  VTE_ppx -> LOS;

  /* resolution */
  Bacterial_clearance -> PAMP_pool [label="source removed", style=dashed, color="#2060a0"];
  Bacterial_clearance -> Cytokine_amp [label="−", color="#2060a0"];
  Neut_apoptosis -> Efferocytosis; Efferocytosis -> SPMs; SPMs -> Cytokine_amp [label="−", color="#2060a0"];
  Efferocytosis -> MonoMac_M2; MonoMac_M2 -> TGFb; MonoMac_M2 -> Edema_reabsorb;
  Edema_reabsorb -> Alveolar_edema [label="−", color="#2060a0"];
  AT2_to_AT1 -> AT1; AT2 -> AT2_to_AT1;
  Matrix_remodel -> Organizing_pna; Organizing_pna -> Radiographic_res [label="delays", style=dashed, color="#b03030"];
  Alveolar_edema -> Radiographic_res [label="−", color="#b03030"];
  Bacterial_clearance -> Trained_immunity;

  /* clinical outcomes */
  Cytokine_amp -> Fever_curve; IL6 -> Fever_curve; IL1b -> Fever_curve;
  Fever_curve -> TCS; SpO2 -> TCS; MAP_drop -> TCS; WOB -> TCS; Encephalopathy -> TCS;
  Cytokine_amp -> Symptom_score; Consolidation -> Symptom_score;
  Bacterial_growth -> Treatment_failure;
  PAMP_pool -> Treatment_failure [label="early post-dose surge", color="#b03030"];
  Treatment_failure -> ICU_transfer; PaO2FiO2 -> ICU_transfer; MAP_drop -> ICU_transfer;
  ICU_transfer -> Mortality_28d; ICU_transfer -> LOS;
  TCS -> LOS; TCS -> Antibiotic_duration;
  PCT -> Antibiotic_duration [label="PCT-guided stop"];
  CRP -> Antibiotic_duration;
  Antibiotic_duration -> Relapse [label="too short + persisters", style=dashed, color="#b03030"];
  Relapse -> Readmission; LOS -> Readmission;
  Myocardial -> Long_CV; Trained_immunity -> Long_CV;
  Radiographic_res -> Readmission [label="−", color="#2060a0", style=dashed];
  Mortality_28d -> Long_CV [style=invis];

  /* cross-cluster severity feedback */
  Bacterial_growth -> PAMP_pool [label="living-cell shedding"];
  Bacteremia -> Bacterial_growth [style=dashed];
  Lymphopenia -> Bacterial_clearance [label="−", color="#b03030", style=dashed];
  WBC_left -> Neut_blood;
  Blood_culture -> MIC [label="susceptibility testing"];
  CURB65 -> Hydrocortisone [label="severe-CAP gate"];
  CURB65 -> Ceftriaxone; CURB65 -> Azithromycin;
  Houck_note [label="Door-to-antibiotic time\n(delay → ↑ mortality)", shape=note, fillcolor="#fff4c2"];
  Houck_note -> Ceftriaxone [style=dashed];
  Houck_note -> Mortality_28d [style=dashed, color="#b03030"];
}
