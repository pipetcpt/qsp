    COGD    [label="인지 저하 · 치매 위험", fillcolor="#cfd8dc"];
    ACCID   [label="교통사고 · 산업재해", fillcolor="#cfd8dc"];
    WORKP   [label="생산성 손실 (presenteeism)\n연간 사회적 비용", fillcolor="#cfd8dc"];
    SUICID  [label="자살 사고 위험 ↑\n(우울과 독립적)", fillcolor="#cfd8dc"];

    HTNc -> CVDc; MSNA -> HTNc; CORT -> IRc; IL6TNF -> CVDc;
    SWA -> GLYMc [arrowhead=tee, label="SWS ↓ → clearance ↓"]; GLYMc -> COGD;
    PSYCHO -> ACCID; SLEEPSUB -> ACCID; SLEEPSUB -> WORKP; MDD -> SUICID; AROU -> SUICID;
  }

  /* =================================================================
     18. Clinical endpoints (model outputs)
     ================================================================= */
  subgraph cluster_endpoint {
    label="⑱ 임상 엔드포인트 (모델 출력) / Clinical endpoints";
    style="rounded,filled"; fillcolor="#fff8e1"; color="#f57f17"; fontsize=13; penwidth=2.0;

    SOL_ep  [label="SOL / LPS\n수면 잠복기 (min)\n목표 <30 min", fillcolor="#fff59d", shape=note];
    WASO_ep [label="WASO\n입면 후 각성 시간 (min)\n목표 <30 min", fillcolor="#fff59d", shape=note];
    TST_ep  [label="TST\n총 수면 시간 (min)\n목표 ≥360 min", fillcolor="#fff59d", shape=note];
    SE_ep   [label="SE (%)\n수면 효율 = TST/TIB\n목표 ≥85%", fillcolor="#fff59d", shape=note];
    NAW_ep  [label="각성 횟수 (NAW)\nnumber of awakenings", fillcolor="#fff59d", shape=note];
    ISI_ep  [label="ISI (0–28)\nInsomnia Severity Index\n관해 <8 · 반응 ≥6점 감소", fillcolor="#fff59d", shape=note];
    PSQI_ep [label="PSQI (0–21)\n>5 = 수면의 질 불량", fillcolor="#fff59d", shape=note];
    sTST_ep [label="주관적 sTST / sSOL\n(수면일지 · 오지각 반영)", fillcolor="#fff59d", shape=note];
    N3_ep   [label="N3 (SWS) 분율 %", fillcolor="#fff59d", shape=note];
    REM_ep  [label="REM 분율 % · REM 잠복기", fillcolor="#fff59d", shape=note];
    DAYF_ep [label="주간 기능 지표\nFOSQ · ESS · MSLT/MWT", fillcolor="#fff59d", shape=note];
    QOL_ep  [label="삶의 질 SF-36 · EQ-5D", fillcolor="#fff59d", shape=note];
    REMIS   [label="관해율 Remission\nISI<8 & SE>85% 유지", fillcolor="#fff59d", shape=note];

    SOL_ep -> SE_ep; WASO_ep -> SE_ep; TST_ep -> SE_ep; NAW_ep -> WASO_ep;
    SOL_ep -> ISI_ep; WASO_ep -> ISI_ep; TST_ep -> ISI_ep; DAYF_ep -> ISI_ep;
    ISI_ep -> PSQI_ep; ISI_ep -> QOL_ep; ISI_ep -> REMIS; SE_ep -> REMIS;
    MISP -> sTST_ep; TST_ep -> sTST_ep;
    SWA -> N3_ep; REMst -> REM_ep;
    HANGOV -> DAYF_ep; SLEEPSUB -> DAYF_ep;
  }

  /* =================================================================
     Cross-cluster integrative edges — where the model actually lives
     ================================================================= */
  SPRESS -> FLIP [label="S ↑ → sleep", color="#00897b", penwidth=1.8];
  FLIP   -> WAKEst [label="wake state", color="#ef6c00"];
  FLIP   -> N1     [label="sleep state", color="#1565c0"];
  ONSETP [label="입면 확률 P(sleep)\nσ( wS·S + C(t) − A − θ + Σ drug effects )",
          fillcolor="#b2dfdb", shape=hexagon, penwidth=2.0];
  SPRESS -> ONSETP; CPROC -> ONSETP [label="−C(t)"]; AROU -> ONSETP [arrowhead=tee, color="#c62828", penwidth=1.8];
  GABAAR -> ONSETP [color="#7b1fa2", penwidth=1.6];
  OXOCC  -> ONSETP [color="#ad1457", penwidth=1.6];
  MT1R   -> ONSETP [color="#5e35b1"];
  H1R    -> ONSETP [arrowhead=tee, color="#5e35b1"];
  COND   -> ONSETP [arrowhead=tee, color="#f9a825"];
  SEFF   -> ONSETP [arrowhead=tee, color="#f9a825"];
  ONSETP -> SOL_ep [arrowhead=tee, penwidth=1.6];
  ONSETP -> WASO_ep [arrowhead=tee];
  ONSETP -> TST_ep [penwidth=1.6];
  TIBext -> SE_ep [arrowhead=tee];
  SRT    -> SE_ep [color="#2e7d32", penwidth=1.6];
  CBTemp -> ONSETP [label="CBT 하강 → 입면 촉진"];
  ZOLc   -> GABAAR [color="#7b1fa2", penwidth=1.8, label="α1 PAM"];
  ESZc   -> GABAAR [color="#7b1fa2", penwidth=1.8, label="α1/α2/α3 PAM"];
  TOLB   -> GABAAR [arrowhead=tee, label="효과 감쇠", color="#d84315"];
  ISI_ep -> DBAS [style=dashed, label="증상 → 신념 강화", color="#c62828"];
  CBTI   -> ISI_ep [color="#2e7d32", penwidth=1.8, label="지속 효과 (>12개월)"];
  ZOLdose -> ISI_ep [color="#7b1fa2", style=dashed, label="즉효 · 중단 시 소실"];
}
