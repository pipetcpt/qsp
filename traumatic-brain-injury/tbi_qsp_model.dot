    ICPDOSE->GOSE [penwidth=1.4]; CPPDOSE->GOSE; PBTDOSE->GOSE;
    CORE0->GOSE [penwidth=1.8]; PUPIL->GOSE [penwidth=1.4]; IMPACTM->GOSE;
    GCS->IMPACTM; CTMARSH->IMPACTM; PUPIL->IMPACTM;
    CORE0->MORTAL; BRAINDTH->MORTAL [penwidth=1.4];
    CHRONINF->PTE; CORE0->PITUIT; CORE0->COGN; NFLB->COGN;
    CTPERF->CBFPEN [dir=back, style=dashed];
  }

