              fillcolor="#78909c", fontcolor="white", shape=doubleoctagon, fontsize=12];
    MORTAL   [label="Mortality", fillcolor="#90a4ae"];
    PTE      [label="Post-traumatic epilepsy", fillcolor="#eceff1"];
    PITUIT   [label="Post-traumatic hypopituitarism", fillcolor="#eceff1"];
    COGN     [label="Cognitive / behavioural sequelae", fillcolor="#eceff1"];
    ICP->ICPMON; ICPMON->BESTTRIP; ICPMON->ICPDOSE; CPP->CPPDOSE; PBTO2->PBTDOSE;
