    TREPHINE [label="Syndrome of the trephined\nhygroma, cranioplasty", fillcolor="#fce4ec"];
    HEMEVAC  [label="Haematoma evacuation\n(the definitive volume therapy)", fillcolor="#f8bbd0"];
    BARB->BURSTSUP; BURSTSUP->CMRO2 [color="#880e4f", penwidth=1.3];
    BARB->BARBMAP; BARBMAP->MAP [color="#c0392b"];
    HYPOTHER->Q10N [penwidth=1.4]; HYPOTHER->REWARM; REWARM->ICP [color="#c0392b"];
    HYPOTHER->HYPOCOST;
    CRANI->PVCURVE [penwidth=1.8, color="#880e4f", label="PVI ↑ 3.7×"];
    CRANI->DECRA; CRANI->RESCUE; CRANI->TREPHINE;
    HEMEVAC->VLESION [color="#880e4f", penwidth=1.4];
  }

  /* ---------- 19. CPP MANAGEMENT AND HAEMOSTASIS ------------------------------- */
  subgraph cluster_cpp {
    label="19. 관류압 관리 · CPP management and haemostatic therapy";
    style="filled"; fillcolor="#ede7f6"; color="#4527a0";
    NORAD    [label="Noradrenaline\n(the usual first pressor)", fillcolor="#b39ddb"];
    NORADPD  [label="Effect-site model\nEmax 55 mmHg, EC50 0.30", fillcolor="#d1c4e9"];
    ROSNER   [label="ROSNER: CPP augmentation\n★ works ONLY if autoregulation is alive",
              fillcolor="#9575cd", shape=box3d, fontsize=10];
    LUND     [label="LUND concept: lower CPP,\nreduce capillary filtration", fillcolor="#d1c4e9"];
    SIGNFLIP [label="★ SAME DRUG, OPPOSITE SIGN\nintact → ICP falls\ndead  → ICP rises",
              fillcolor="#7e57c2", fontcolor="white", shape=octagon, fontsize=10];
    ARDSRISK [label="Fluid loading → ARDS\n(the CPP-70 lesson)", fillcolor="#d1c4e9"];
    TXA      [label="Tranexamic acid\n1 g bolus + 1 g / 8 h", fillcolor="#b39ddb"];
    CRASH3   [label="CRASH-3: benefit decays\n★ the SUBSTRATE expires,\nnot the drug", fillcolor="#d1c4e9"];
    REVERSAL [label="Anticoagulant reversal\nPCC, idarucizumab, andexanet", fillcolor="#d1c4e9"];
    NORAD->NORADPD; NORADPD->MAP [penwidth=1.4];
    NORAD->ROSNER; ROSNER->CASIG [color="#4527a0", penwidth=1.4];
    PRX->SIGNFLIP [penwidth=1.4]; ROSNER->SIGNFLIP; SIGNFLIP->ICP [color="#4527a0"];
    LUND->PC [color="#4527a0"]; NORAD->ARDSRISK;
    TXA->HYPERFIB [color="#4527a0", penwidth=1.4]; TXA->CRASH3;
    REVERSAL->ANTICOAG [dir=back];
    CPPOPT->NORAD [style=dashed, label="target"];
  }

  /* ---------- 20. MONITORING, BIOMARKERS AND OUTCOME ---------------------------- */
  subgraph cluster_out {
    label="20. 감시 · 바이오마커 · 예후  Monitoring, biomarkers and outcome";
    style="filled"; fillcolor="#eceff1"; color="#263238"; fontsize=11;
    ICPMON   [label="ICP monitor\n(EVD or parenchymal bolt)", fillcolor="#cfd8dc"];
    BESTTRIP [label="BEST:TRIP — monitoring alone\nis not the therapy", fillcolor="#eceff1"];
    ICPDOSE  [label="ICP pressure-time dose\n∫max(0, ICP−20) dt\n★ Güiza curve",
