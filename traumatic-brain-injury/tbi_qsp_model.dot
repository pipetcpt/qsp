    CPPDOSE  [label="CPP deficit dose\n∫max(0, 60−CPP) dt", fillcolor="#b0bec5"];
    PBTDOSE  [label="PbtO₂ deficit dose\n∫max(0, 20−PbtO₂) dt", fillcolor="#b0bec5"];
    TIL      [label="Therapy intensity level (TIL)", fillcolor="#cfd8dc"];
    GFAPB    [label="GFAP  t½ ≈ 24 h\n→ the integral", fillcolor="#cfd8dc"];
    UCHL1B   [label="UCH-L1  t½ ≈ 7 h\n→ the recent rate", fillcolor="#cfd8dc"];
    NFLB     [label="NfL  t½ ≈ 3 weeks\n→ cumulative axonal loss", fillcolor="#cfd8dc"];
    S100BB   [label="S100B  t½ ≈ 1 h\n→ the instantaneous rate", fillcolor="#cfd8dc"];
    SBDP     [label="SBDP145/150, tau, NSE", fillcolor="#eceff1"];
    MICRODIA [label="Cerebral microdialysis\nLPR, glucose, glutamate", fillcolor="#cfd8dc"];
    CTPERF   [label="CT perfusion / MRI DWI-PWI", fillcolor="#eceff1"];
    IMPACTM  [label="IMPACT / CRASH prognostic models\nage · motor · pupils · CT", fillcolor="#cfd8dc"];
