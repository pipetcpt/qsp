        MAGNORD      [label="PRL MAGNITUDE ORDERING\nis generated, not tabulated:\nmacro >250 · micro 100-250 ·\ndrug 25-200 · stalk 25-100", shape=note, fillcolor="#fbfbe8", penwidth=2];
    }

    /* ============ 20. SECOND-LINE AND AGGRESSIVE DISEASE ============ */
    subgraph cluster_second {
        label = <<b>20 · When dopamine is not enough</b>>;
        style="rounded,filled"; fillcolor="#eaf7f7"; color="#1e7f8f"; fontcolor="#12606d";
        DOSEUP       [label="DOSE ESCALATION\nup to 3.5-11 mg/wk\n(rescues shifted EC50,\nNOT lowered Emax)", shape=hexagon, fillcolor="#c8e8ec", penwidth=2];
        SWITCH       [label="Switch bromocriptine →\ncabergoline (rescues ~80%\nof BRC failures)", shape=hexagon, fillcolor="#c8e8ec"];
        TSS          [label="Transsphenoidal surgery\nmicro ~75-90% ·\nmacro ~30-40% remission", shape=hexagon, fillcolor="#c8e8ec", penwidth=2];
        SURGCOST     [label="Surgical cost: new\nhypopituitarism, DI,\nCSF leak", shape=diamond, fillcolor="#c8e8ec"];
        RTX          [label="Fractionated RT /\nstereotactic radiosurgery\n(slow, hypopituitarism)", shape=hexagon, fillcolor="#c8e8ec"];
        TMZ          [label="TEMOZOLOMIDE\n150-200 mg/m² × 5 d q28\n— first-line for aggressive\nPitNET/carcinoma", shape=hexagon, fillcolor="#c8e8ec", penwidth=2];
        MGMT         [label="MGMT expression\n(low ⇒ response ~50%)", fillcolor="#c8e8ec", penwidth=2];
        MMR          [label="MSH6 / MMR loss\n→ TMZ resistance"];
