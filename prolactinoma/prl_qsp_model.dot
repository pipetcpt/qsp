    }

    /* ============ 21. ENDPOINTS, MONITORING, WITHDRAWAL ============ */
    subgraph cluster_end {
        label = <<b>21 · Endpoints, monitoring and the withdrawal decision</b>>;
        style="rounded,filled"; fillcolor="#f7f7e8"; color="#8a8a2a"; fontcolor="#66661a";
        PRLNORM      [label="PRL NORMALISATION\ncabergoline ~83% vs\nbromocriptine ~59%", shape=diamond, fillcolor="#eaeac8", penwidth=2];
        SHRINK50     [label="Tumour shrinkage ≥50%", shape=diamond, fillcolor="#eaeac8", penwidth=2];
        RESIST       [label="RESISTANCE\n(~10% micro, ~18% macro\nto cabergoline)", shape=diamond, fillcolor="#eaeac8", penwidth=2];
        PARTRES      [label="PARTIAL resistance =\nshifted EC50 → dose rescues"];
        TRUERES      [label="TRUE resistance =\nlowered Emax → dose does NOT", shape=octagon, fillcolor="#dedec0"];
        WITHDR       [label="DA WITHDRAWAL after ≥2 y\nnormal PRL + no remnant", shape=hexagon, fillcolor="#eaeac8", penwidth=2];
        REMISS       [label="Sustained REMISSION\npooled ~21%\n(higher if NO remnant)", shape=diamond, fillcolor="#eaeac8", penwidth=2];
        RECUR        [label="RECURRENCE\n(remnant volume is the\nthreshold variable)", shape=diamond, fillcolor="#eaeac8", penwidth=2];
        MONMRI       [label="MRI · visual fields ·\nPRL · echocardiography ·\nDXA", shape=note, fillcolor="#fbfbe8"];
        DELAYCOST    [label="COST OF DIAGNOSTIC DELAY\npermanent MD loss ∝\nduration × severity", shape=octagon, fillcolor="#dedec0", penwidth=2];
    }

    /* ================= EDGES: hypothalamic control ================= */
    ARC -> TIDA;  TIDA -> TH [color="#3b6fb5"]; TH -> DASYN -> VMAT -> DAREL [color="#3b6fb5"];
    THDA -> DAREL; DAREL -> ME [color="#3b6fb5", penwidth=1.6];
    DAT -> DAREL [style=dashed, label="clearance", arrowhead=tee];
    ME -> PORTAL [color="#3b6fb5", penwidth=1.8]; PORTAL -> DAPORT [color="#3b6fb5", penwidth=1.8];
    STALK -> PORTAL [color="#3b6fb5"]; STALKC -> STALK [arrowhead=tee, color="#b52b2b", penwidth=1.6];
    STALKC -> DISCONN; STALK -> DAPORT [label="patency", color="#3b6fb5"];
    SYSDA -> DAPORT [style=dotted];
    GABAN -> TIDA [arrowhead=tee]; SUCK -> TIDA [arrowhead=tee]; STRESS -> TIDA [arrowhead=tee];
    SEROT -> EXO [label="+"]; TRHN -> PRLGENE [label="+"]; VIPN -> PRLGENE [label="+"];
    OXTN -> EXO [label="+"]; SLEEPP -> EXO [label="nocturnal +"]; SUCK -> EXO [label="reflex +"];
    HYPOTH -> TRHN [label="TRH ↑", color="gray30"];
    PRLB -> PRLRT [color="#b52b2b"]; PRLRT -> STAT5T [color="#b52b2b"]; STAT5T -> TH [color="#b52b2b", penwidth=2, label="short loop +"];
    STAT5T -> SHORTLOOP [color="#b52b2b"]; SHORTLOOP -> DAPORT [color="#b52b2b", penwidth=2];
    SHORTLOOP -> DISCONN [label="ceiling: feedback\nstill intact", style=dashed, color="#b52b2b"];

    /* ================= EDGES: D2 signalling ================= */
    DAPORT -> OCCUP [color="#26558f", penwidth=2.2, label="e=1.0, Ki µM"];
    D2R -> OCCUP [color="#26558f", penwidth=2.2]; D2S -> D2R; D2L -> D2R;
    DRD2V -> D2R [arrowhead=tee, color="#7a4fa8"]; FILAMIN -> D2R [arrowhead=tee, color="#7a4fa8"];
    NEUROD -> D2R [arrowhead=tee, style=dashed];
    OCCUP -> GIO [color="#26558f", penwidth=2]; GIO -> AC [arrowhead=tee]; AC -> CAMP;
    GIO -> GIRK [color="#26558f"]; GIRK -> VGCC [arrowhead=tee, color="#26558f"]; VGCC -> CAI [arrowhead=tee, color="#26558f", penwidth=1.8];
    CAI -> EXO [arrowhead=tee, color="#26558f", penwidth=2.2, label="BRANCH 1\nhours"];
    CAMP -> PRLGENE [arrowhead=tee, color="#26558f", penwidth=2.2, label="BRANCH 2\nweeks"];
    OCCUP -> ERKL [color="#26558f"]; OCCUP -> AKTL [color="#26558f"];
    ERKL -> P27; AKTL -> P27; P27 -> PROLIF [arrowhead=tee, color="#26558f", penwidth=2.2, label="BRANCH 3\nmonths"];
    OCCUP -> TGFB [color="#26558f"]; TGFB -> PROLIF [arrowhead=tee]; TGFB -> CASP;
    AKTL -> CASP [arrowhead=none, label="withdrawal →"]; CASP -> APOP [color="#26558f", penwidth=1.8];
    CAMP -> RER [label="+"]; GRAN -> CELLVOL [penwidth=1.6]; RER -> CELLVOL [penwidth=1.6];
    OCCUP -> CELLVOL [arrowhead=tee, color="#26558f", penwidth=2, label="rapid involution"];

    /* ================= EDGES: synthesis / secretion ================= */
    PIT1 -> PRLGENE [color="#c07a1e", penwidth=1.6]; ERA -> PRLGENE [color="#c07a1e", penwidth=1.8];
    PRLGENE -> PRLMRNA [color="#c07a1e", penwidth=1.8]; PRLMRNA -> PRLSYN [color="#c07a1e"];
    PRLSYN -> GRAN [color="#c07a1e", penwidth=1.8]; GRAN -> EXO [color="#c07a1e", penwidth=1.8];
    GRAN -> CRINO [style=dashed]; PRLSYN -> GLYCOS; GLYCOS -> GPRL; PRLSYN -> CATHD; CATHD -> PRL16;
    EXO -> PRLB [color="#c07a1e", penwidth=2.2];
    LACTN -> GRAN [style=dashed, label="normal pool"];
    LACTS -> GRAN [style=dashed, penwidth=1.4]; LACTR -> GRAN [style=dashed, penwidth=1.4];
    PULSAT -> PRLB [style=dotted];

    /* ================= EDGES: tumour dynamics ================= */
    SPORAD -> LACTS [color="#7a4fa8"]; SF3B1 -> PROLIF [color="#7a4fa8", penwidth=1.8];
    MEN1 -> LACTS [color="#7a4fa8"]; AIP -> D2R [arrowhead=tee, color="#7a4fa8", penwidth=1.8];
    AIP -> INVAS [color="#7a4fa8"]; MEN4 -> PROLIF [color="#7a4fa8"]; HMGA2 -> PROLIF [color="#7a4fa8"];
    MIRNA -> PROLIF [color="#7a4fa8"]; ESTROGENP -> LACTHYP;
    PROLIF -> LACTS [penwidth=1.8]; PROLIF -> LACTR [penwidth=1.8];
    APOP -> LACTS [arrowhead=tee, penwidth=1.8]; APOP -> LACTR [arrowhead=tee];
    LACTS -> CLONAL [color="#b52b2b"]; LACTR -> CLONAL [color="#b52b2b", penwidth=2];
    CLONAL -> RESIST [color="#b52b2b", penwidth=2];
    D2R -> LACTR [style=dashed, arrowhead=tee, label="low D2R clone\nescapes selection"];
    LACTS -> TVOL [penwidth=2]; LACTR -> TVOL [penwidth=2]; CELLVOL -> TVOL [penwidth=2.2];
    VEGFT -> TVOL; PROLIF -> KI67; KI67 -> CARCIN; INVAS -> CARCIN;
    NECRO -> APOPLEX; TVOL -> NECRO [style=dashed];
    LACTS -> FIBROS [style=dotted]; OCCUP -> FIBROS [label="cumulative\nexposure", style=dotted];
    FIBROS -> TSS [arrowhead=tee, style=dotted, label="harder"];
    SEXDIM -> TVOL [style=dotted];

    /* ================= EDGES: oestrogen ================= */
    E2P -> ERA [color="#b5418e", penwidth=1.8]; E2P -> ERAUP [color="#b5418e"];
    ERAUP -> PRLGENE [color="#b5418e", penwidth=1.8]; ERAUP -> D2R [arrowhead=tee, color="#b5418e", penwidth=1.8];
    E2P -> PROLIF [color="#b5418e", penwidth=1.8]; PREG -> E2P [color="#b5418e", penwidth=2.2];
    PREG -> HPL; HPL -> PRLB [style=dashed]; PREG -> LACTHYP [color="#b5418e"];
    LACTHYP -> LACTN [penwidth=1.6]; PREG -> PREGRISK [color="#b5418e", penwidth=1.8];
    TVOL -> PREGRISK [penwidth=1.8]; POSTP -> LACTHYP [arrowhead=tee]; LACTATION -> PRLB [style=dashed];
    OCP -> E2P [color="#b5418e"]; E2G -> E2P [style=dashed];
    PREG -> WITHDR [style=dotted, label="drug stopped"];

    /* ================= EDGES: plasma forms and assay ================= */
    PRLB -> PRLDIM; PRLB -> MACPRL [penwidth=1.6]; APAB -> MACPRL [penwidth=1.8];
    PRLB -> CLRREN [penwidth=1.6]; MACPRL -> CLRREN [style=dashed, label="slow"];
    CKDPRL -> CLRREN [arrowhead=tee, color="gray30"]; CIRRH -> CLRREN [arrowhead=tee, color="gray30"];
    PRLB -> ASSAY [style=dashed, penwidth=1.8]; MACPRL -> ASSAY [style=dashed, penwidth=1.8];
    PRLDIM -> ASSAY [style=dashed]; GPRL -> ASSAY [style=dashed];
    XREACT -> ASSAY [style=dashed]; ASSAY -> BRIDGE [style=dashed, penwidth=1.6];
    BRIDGE -> HOOK [style=dashed, penwidth=2]; BRIDGE -> PRLMEAS [style=dashed, penwidth=2];
    HOOK -> PRLMEAS [style=dashed, arrowhead=tee, penwidth=2]; HOOK -> FALSELOW [style=dashed, penwidth=2];
    DILUTE -> HOOK [style=dashed, arrowhead=tee, penwidth=2, label="1:100 recovers"];
    MACPRL -> FALSEHIGH [style=dashed, penwidth=1.8]; PEG -> FALSEHIGH [style=dashed, arrowhead=tee, penwidth=1.8];
    GELFIL -> PEG [style=dashed]; PRLB -> BIOASSAY [style=dashed, penwidth=1.6];
    VENIP -> PRLMEAS [style=dashed]; PRLMEAS -> MONMRI [style=dashed];
    FALSELOW -> TSS [style=dotted, label="wrong operation"];
    MAGNORD -> PRLMEAS [style=dotted];

    /* ================= EDGES: PRLR and HPG ================= */
    PRLB -> PRLR [color="#4d8f2a", penwidth=2.2]; PRLR -> JAK2 [color="#4d8f2a", penwidth=1.8];
    JAK2 -> SOCS [style=dashed]; SOCS -> JAK2 [arrowhead=tee, style=dashed];
    JAK2 -> MAPKP; PRLR -> BREAST; PRLR -> HYPOTAL [color="#4d8f2a", penwidth=1.8];
    PRLR -> ADIPOSE; PRLR -> OSTEO; PRLR -> IMMUNEP;
    GPRL -> PRLR [style=dashed, label="weak"]; MACPRL -> PRLR [style=dashed, arrowhead=tee, label="cannot reach\nextravascular target"];
    HYPOTAL -> KNDY [color="#4257a8", penwidth=2]; JAK2 -> KISS1 [arrowhead=tee, color="#4257a8", penwidth=2];
    KNDY -> KISS1 [color="#4257a8"]; KISS1 -> GNRHP [color="#4257a8", penwidth=2.2];
    GNRHP -> GONAD [color="#4257a8", penwidth=1.8]; GONAD -> LH [color="#4257a8", penwidth=1.8]; GONAD -> FSH [color="#4257a8"];
    LH -> OVARY [color="#4257a8"]; FSH -> OVARY [color="#4257a8"]; OVARY -> E2G [color="#4257a8", penwidth=1.8];
    OVARY -> OVUL [color="#4257a8", penwidth=1.8]; OVUL -> PROG; PROG -> OVUL [style=dotted];
    LH -> TESTIS [color="#4257a8"]; TESTIS -> TEST [color="#4257a8", penwidth=1.8];
    FSH -> SPERM; TEST -> SPERM; SHBGN -> TEST [style=dashed, label="free fraction"];
    BREAST -> GALACT [penwidth=1.6]; E2G -> GALACT [label="priming required", style=dashed];

    /* ================= EDGES: reproductive endpoints ================= */
    E2G -> AMEN [arrowhead=tee, penwidth=1.8]; OVUL -> INFERT [arrowhead=tee, penwidth=2];
    OVUL -> PREGOUT [penwidth=1.8]; E2G -> VAGATR [arrowhead=tee];
    TEST -> LIBIDO [arrowhead=tee, penwidth=1.6]; TEST -> ED [arrowhead=tee];
    TEST -> GYNEC [arrowhead=tee]; E2G -> HYPOG [arrowhead=tee, penwidth=1.8]; TEST -> HYPOG [arrowhead=tee, penwidth=1.8];
    PRLB -> LIBIDO [style=dotted, label="direct central"];
    HYPOG -> TRTREPL [style=dotted];

    /* ================= EDGES: bone ================= */
    HYPOG -> RANKL [penwidth=1.8]; E2G -> RANKL [arrowhead=tee]; TEST -> RANKL [arrowhead=tee];
    RANKL -> OCL [penwidth=1.8]; HYPOG -> OBL [arrowhead=tee]; OSTEO -> OBL [style=dashed, label="direct PRL"];
    OCL -> BTM; OBL -> BTM; OCL -> BMDLS [arrowhead=tee, penwidth=2]; OBL -> BMDLS [penwidth=1.6];
    OCL -> BMDFN [arrowhead=tee]; BMDLS -> TRABSCORE; BMDLS -> VFRACT [arrowhead=tee, penwidth=2];
    TRABSCORE -> VFRACT [arrowhead=tee]; BMDLS -> BMDIRR [penwidth=1.8]; VITD -> BMDLS;
    BMDIRR -> VFRACT [penwidth=1.6]; BMDLS -> MONMRI [style=dotted];

    /* ================= EDGES: metabolic ================= */
    PRLB -> APPET [penwidth=1.4]; APPET -> BWT [penwidth=1.6]; ADIPOSE -> INSRES [penwidth=1.4];
    PRLB -> INSRES [style=dotted]; BWT -> INSRES [penwidth=1.6]; INSRES -> LIPID; ADIPOK -> INSRES [arrowhead=tee];
    BWT -> METS [penwidth=1.6]; INSRES -> METS [penwidth=1.6]; LIPID -> METS;
    HYPOG -> BWT [penwidth=1.4];

    /* ================= EDGES: mass effect ================= */
    TVOL -> SELLA [penwidth=1.6]; SELLA -> SUPRA [penwidth=2]; TVOL -> SUPRA [penwidth=2.2];
    SUPRA -> CHIASM [penwidth=2.2]; CHIASM -> CONDBLK [penwidth=2]; CHIASM -> AXONLOSS [penwidth=2, label="× time"];
    CONDBLK -> VFMD [penwidth=2.2]; AXONLOSS -> VFMD [penwidth=2.2]; AXONLOSS -> RNFL;
    AXONLOSS -> DELAYCOST [penwidth=2]; TVOL -> CAVSIN; TVOL -> HEADACHE; TVOL -> HYPOPIT [penwidth=2];
    HYPOPIT -> CORTD; HYPOPIT -> FT4D; HYPOPIT -> IGF1D; HYPOPIT -> LH [arrowhead=tee, penwidth=1.6];
    TVOL -> DIABINS [style=dotted]; TVOL -> INVAS; INVAS -> CSFLEAK [penwidth=1.6];
    APOPLEX -> HYPOPIT; FT4D -> TRHN [style=dotted];
    OCCUP -> CSFLEAK [style=dotted, label="rapid shrinkage\nof invasive tumour"];
    HYPOPIT -> MONMRI [style=dotted];

    /* ================= EDGES: PK to receptor ================= */
    CABDOSE -> CABGUT [color="#26558f", penwidth=2]; CABGUT -> CABC [color="#26558f", penwidth=2];
    CABC -> CABP [dir=both, color="#26558f"]; CABC -> CABMET [color="#26558f"];
    CABC -> CABEFF [color="#26558f", penwidth=2.2, label="slow ke0"];
    CABEFF -> OCCUP [color="#26558f", penwidth=2.4, label="e=1.0, Ki ~0.7 nM"];
    CYP3A -> CABC [label="exposure ↑", style=dashed];
    BRCDOSE -> BRCC [color="#26558f", penwidth=1.8]; BRCC -> BRCEFF [color="#26558f", penwidth=1.8];
    BRCEFF -> OCCUP [color="#26558f", penwidth=2, label="e≈0.8, Ki ~5 nM"];
    VAGIN -> BRCC [color="#26558f", style=dashed];
    QUIDOSE -> QUIC [color="#26558f", penwidth=1.6]; QUIC -> OCCUP [color="#26558f", penwidth=1.8, label="e=1.0, non-ergot"];

    /* ================= EDGES: safety ================= */
    CABC -> D2CTZ [color="#b5502a", penwidth=1.8]; D2CTZ -> NAUSEA [color="#b5502a", penwidth=1.8];
    NAUSEA -> NTOL [color="#b5502a"]; NTOL -> NAUSEA [arrowhead=tee, color="#b5502a", penwidth=2];
    CABC -> ALPHA1 [color="#b5502a"]; ALPHA1 -> ORTHO [color="#b5502a"];
    CABC -> HT2B [color="#b5502a", penwidth=2]; HT2B -> VALVFIB [color="#b5502a", penwidth=2, label="CUMULATIVE"];
    VALVFIB -> TRICUSP [color="#b5502a", penwidth=2]; DOSESCALE -> TRICUSP [style=dotted];
    SELRATIO -> HT2B [style=dotted, penwidth=1.6];
    QUIDOSE -> HT2B [arrowhead=tee, style=dashed, label="non-ergot:\nno 5-HT2B agonism"];
    BRCC -> HT2B [style=dashed, label="weak/antagonist"];
    CABC -> D3MESO [color="#b5502a", penwidth=1.8]; D3MESO -> ICD [color="#b5502a", penwidth=2];
    QUIDOSE -> D3MESO [color="#b5502a", style=dashed, label="NOT spared"];
    D3MESO -> PSYCHO [color="#b5502a"]; CABC -> FIBROSER [color="#b5502a", style=dashed];
    CABC -> HEADAE [color="#b5502a"]; NAUSEA -> DOSEUP [arrowhead=tee, style=dotted, label="limits titration"];

    /* ================= EDGES: drug-induced hyperprolactinaemia ================= */
    RISP -> OCCUP [arrowhead=tee, color="gray20", penwidth=2, label="e=0 displaces DA"];
    AMISUL -> OCCUP [arrowhead=tee, color="gray20", penwidth=1.6];
    HALO -> OCCUP [arrowhead=tee, color="gray20"]; QUETI -> OCCUP [arrowhead=tee, color="gray20", style=dashed];
    ARIP -> OCCUP [color="gray20", penwidth=1.8, label="e=0.25"];
    ARIP -> ARIPADD [color="gray20", penwidth=1.8]; RISP -> ARIPADD [color="gray20"];
    ARIPADD -> PRLMEAS [style=dotted, label="PRL falls"];
    METOCLO -> OCCUP [arrowhead=tee, color="gray20"]; RISP -> DIHMAG [style=dotted];
    D3MESO -> RISP [style=dotted, arrowhead=none, label="treating DIH risks\npsychosis relapse"];
    PSYCHO -> RISP [style=dotted];

    /* ================= EDGES: differential diagnosis ================= */
    CHESTW -> SUCK [color="gray30"]; PCOSD -> PRLB [style=dotted, color="gray30"];
    SEIZ -> PRLB [style=dotted, color="gray30"]; MIXED -> IGF1D [style=dotted, arrowhead=none, label="check IGF-1"];
    MIXED -> LACTS [color="gray30"]; DISCONN -> MAGNORD [style=dotted]; DIHMAG -> MAGNORD [style=dotted];
    HYPOTH -> MAGNORD [style=dotted]; MAGNORD -> RESIST [style=dotted, arrowhead=none];

    /* ================= EDGES: second line ================= */
    RESIST -> DOSEUP [penwidth=1.8]; PARTRES -> DOSEUP [penwidth=1.6]; RESIST -> PARTRES; RESIST -> TRUERES;
    TRUERES -> DOSEUP [arrowhead=tee, penwidth=1.8, label="no rescue"];
    DOSEUP -> CABDOSE [penwidth=1.8]; RESIST -> SWITCH; SWITCH -> CABDOSE;
    TRUERES -> TSS [penwidth=1.8]; TSS -> TVOL [arrowhead=tee, penwidth=2]; TSS -> SURGCOST;
    SURGCOST -> HYPOPIT [penwidth=1.4]; TSS -> RTX [style=dotted]; RTX -> TVOL [arrowhead=tee];
    RTX -> HYPOPIT [style=dotted]; CARCIN -> TMZ [penwidth=2]; KI67 -> TMZ [penwidth=1.8];
    TMZ -> LACTS [arrowhead=tee, penwidth=1.8]; TMZ -> LACTR [arrowhead=tee, penwidth=1.8];
    MGMT -> TMZ [arrowhead=tee, penwidth=1.8]; MMR -> TMZ [arrowhead=tee];
    SSAX -> TVOL [arrowhead=tee, style=dashed]; ESTBLOCK -> ERA [arrowhead=tee, penwidth=1.6];
    ESTBLOCK -> PRLGENE [arrowhead=tee, style=dashed];
    TRTREPL -> BMDLS [penwidth=1.6]; TRTREPL -> LIBIDO [arrowhead=tee];

    /* ================= EDGES: endpoints and withdrawal ================= */
    PRLB -> PRLNORM [arrowhead=tee, penwidth=2]; TVOL -> SHRINK50 [arrowhead=tee, penwidth=2];
    PRLNORM -> WITHDR [penwidth=1.8]; SHRINK50 -> WITHDR [penwidth=1.8];
    WITHDR -> CABEFF [arrowhead=tee, penwidth=2, label="drug removed"];
    LACTS -> RECUR [penwidth=2, label="remnant is the\nthreshold variable"];
    SHORTLOOP -> REMISS [penwidth=2, label="endogenous tone\nmust hold the remnant"];
    WITHDR -> REMISS [penwidth=1.8]; WITHDR -> RECUR [penwidth=1.8];
    CELLVOL -> RECUR [style=dashed, label="volume rebound\nprecedes regrowth"];
    REMISS -> MONMRI [style=dotted]; PREGRISK -> MONMRI [style=dotted];
    VFMD -> TSS [style=dotted, label="failure to improve\n→ operate"];
    TRICUSP -> MONMRI [style=dotted];


}
