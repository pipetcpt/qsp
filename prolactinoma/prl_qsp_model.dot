    }

    /* ============ 17. RECEPTOR SELECTIVITY = SAFETY ============ */
    subgraph cluster_safety {
        label = <<b>17 · Adverse effects are OTHER receptors at the SAME concentration</b>>;
        style="rounded,filled"; fillcolor="#fbeee8"; color="#b5502a"; fontcolor="#8a3818";
        D2CTZ        [label="D2 in area postrema\n(outside BBB)", fillcolor="#f7d8c8"];
        NAUSEA       [label="Nausea / vomiting\n(dose-limiting early)", shape=diamond, fillcolor="#f7d8c8"];
        NTOL         [label="TOLERANCE state\n→ why bedtime dosing +\nslow titration work", fillcolor="#f7d8c8", penwidth=2];
        ALPHA1       [label="α1-adrenergic /\nperipheral D2"];
        ORTHO        [label="Orthostatic hypotension\n(first-dose)", shape=diamond, fillcolor="#f7d8c8"];
        HT2B         [label="5-HT2B on valve\ninterstitial cells\n(ERGOT skeleton only)", fillcolor="#f7d8c8", penwidth=2];
        VALVFIB      [label="Valve myofibroblast\nproliferation → cumulative\nECM deposition", shape=octagon, fillcolor="#e8cfc0", penwidth=2];
        TRICUSP      [label="Moderate-severe tricuspid /\naortic regurgitation\n— PD doses 3-4 mg/DAY", shape=diamond, fillcolor="#e8cfc0", penwidth=2];
        DOSESCALE    [label="Prolactinoma dose is 10-40x\nLOWER (0.5-2 mg/WEEK)\n→ the two literatures\nagree once scaled", shape=note, fillcolor="#fbfbe8", penwidth=2];
        D3MESO       [label="D3 / mesolimbic\nD2 (ventral striatum)", fillcolor="#f7d8c8"];
        ICD          [label="IMPULSE CONTROL DISORDER\ngambling · hypersexuality\n(~10-17%; NOT ergot-specific)", shape=diamond, fillcolor="#e8cfc0", penwidth=2];
        PSYCHO       [label="Psychosis exacerbation\n(mania, hallucinosis)", shape=diamond, fillcolor="#e8cfc0"];
        FIBROSER     [label="Ergot serosal fibrosis:\npleuropulmonary,\nretroperitoneal", shape=octagon, fillcolor="#e8cfc0"];
        HEADAE       [label="Headache · fatigue ·\nnasal congestion", shape=diamond, fillcolor="#f7d8c8"];
        SELRATIO     [label="SELECTIVITY SWEEP\n5-HT2B/D2 ratio over 4 decades:\nefficacy FLAT, valve risk COLLAPSES", shape=note, fillcolor="#fbfbe8", penwidth=2];
    }

    /* ============ 18. DRUG-INDUCED HYPERPROLACTINAEMIA ============ */
    subgraph cluster_dih {
        label = <<b>18 · The same equation with the sign reversed: antipsychotic-induced hyperprolactinaemia</b>>;
        style="rounded,filled"; fillcolor="#f0f0f0"; color="#555555"; fontcolor="#333333";
        RISP         [label="Risperidone / paliperidone\n(e = 0, poor BBB entry\n→ P-gp substrate)", shape=hexagon, fillcolor="#dcdcdc", penwidth=2];
        AMISUL       [label="Amisulpride / sulpiride\n(e = 0, high pituitary\nselectivity)", shape=hexagon, fillcolor="#dcdcdc"];
        HALO         [label="Haloperidol / typicals\n(e = 0)", shape=hexagon, fillcolor="#dcdcdc"];
        ARIP         [label="ARIPIPRAZOLE\nPARTIAL agonist e ≈ 0.25", shape=hexagon, fillcolor="#dcdcdc", penwidth=2.4];
        QUETI        [label="Quetiapine / clozapine\n(fast dissociation → minimal)", shape=hexagon, fillcolor="#dcdcdc"];
        ARIPADD      [label="ARIPIPRAZOLE ADD-ON\nreplaces e=0 with e=0.25\n⇒ SIGNAL UP ⇒ PRL FALLS", shape=note, fillcolor="#fbfbe8", penwidth=2];
        METOCLO      [label="Metoclopramide / domperidone\nSSRIs · verapamil · opioids ·\noestrogens · H2RA", shape=hexagon, fillcolor="#dcdcdc"];
        DIHMAG       [label="Typical magnitude 25-100\n(risperidone to 200) ng/mL\n— overlaps microadenoma", shape=note, fillcolor="#fbfbe8"];
    }

    /* ============ 19. DIFFERENTIAL DIAGNOSIS ============ */
    subgraph cluster_ddx {
        label = <<b>19 · Non-tumoral causes — the same model at different parameter settings</b>>;
        style="rounded,filled"; fillcolor="#eeeeee"; color="#555555"; fontcolor="#333333";
