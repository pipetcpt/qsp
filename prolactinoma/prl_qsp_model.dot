        CABMET       [label="Hepatic hydrolysis\n(CYP3A4 minor)"];
        BRCDOSE      [label="BROMOCRIPTINE\n2.5-15 mg/d BID-TID\n(ergoline, partial agonist)", shape=hexagon, fillcolor="#b9d3f2"];
        BRCC         [label="Plasma bromocriptine\nF ~6% (first-pass),\nt½ 6-15 h", fillcolor="#b9d3f2"];
        BRCEFF       [label="Pituitary biophase\n(shallower)"];
