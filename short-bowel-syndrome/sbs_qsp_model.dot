/* =====================================================================
   Short Bowel Syndrome with Chronic Intestinal Failure (SBS-IF)
   단장증후군 · 만성 장부전 — QSP Mechanistic Map
   ---------------------------------------------------------------------
   THE ORGANISING IDEA

     SBS-IF IS NOT A DISEASE OF A MISSING ORGAN. IT IS A DISEASE OF AN
     UNCLOSED MASS BALANCE. THE THING THE CLINICIAN PRESCRIBES —
     PARENTERAL SUPPORT — IS NOT A TREATMENT INTENSITY. IT IS THE
     ARITHMETIC RESIDUAL OF TWO CONSERVATION EQUATIONS.

   Almost every other model in this library has a disease severity state
   that a drug pushes down and a clinical score that follows it. SBS-IF
   is structurally different, and the difference is the whole point:

     PN VOLUME IS AN OUTPUT, NOT AN INPUT.

   A patient with 70 cm of jejunum ending in a stoma is not "sick" in
   the sense that a lupus patient is sick. Their mucosa is histologically
   near-normal. What has failed is a budget:

       FLUID :  intake + secretions  −  absorbed  =  output
                output + urine + insensible − oral absorbed  =  DEFICIT
                DEFICIT must be filled from a central vein.

       ENERGY:  oral kcal x absorptive coefficient + colonic SCFA salvage
                − total energy expenditure  =  DEFICIT
                DEFICIT must be filled from a central vein.

   Every arrow on this map earns its place by changing one of the terms
   in those two equations. A drug that raises villus height matters only
   because villus height raises the absorptive coefficient; the villus
   is not the endpoint, the litre is.

   ---------------------------------------------------------------------
   WHY THIS MAKES THE PHARMACOLOGY FALL OUT RATHER THAN BE ASSERTED

   FOUR consequences follow from taking the balance seriously, and all
   four are clinical facts that a severity-score model cannot generate:

     1. THE JEJUNUM SECRETES. Jejunal mucosa is the leakiest epithelium
        in the gut. Net water flux there is not "absorption with some
        loss" — it reverses sign. Sodium absorption is zero at luminal
        [Na+] near 90-100 mmol/L and NEGATIVE below it, because water
        follows the osmotic gradient into a hypotonic lumen dragging
        sodium with it. So a thirsty end-jejunostomy patient who drinks
        two litres of water LOSES sodium and volume, and the same patient
        given two litres of glucose-saline at 90 mmol/L Na+ GAINS both.
        This is the single most counter-intuitive fact in the disease and
        it is a sign change in one flux equation, not a warning label.

     2. THE COLON IS A DIGESTIVE ORGAN. A colon in continuity absorbs up
        to 3-4 L of water and 400-800 mmol of sodium per day, and ferments
        unabsorbed carbohydrate to short-chain fatty acids worth up to
        ~1000 kcal/day. This is why the anatomical thresholds for
        permanent intestinal failure differ almost threefold between
        anatomies (end-jejunostomy ~115 cm, jejunocolic ~60 cm,
        jejuno-ileo-colic ~35 cm). Anatomy is therefore a PARAMETER on
        this map that multiplies capacities, never a severity label.

     3. THE ILEAL BRAKE IS THE LOOP THAT CLOSES ON ITSELF. GLP-2, GLP-1,
        PYY and neurotensin come from L-cells, and L-cells live in the
        distal ileum and proximal colon — precisely the tissue most
        often resected. Losing them removes the feedback that slows
        gastric emptying and small-bowel transit. Faster transit means
        less mucosal contact time, less contact time means less
        absorption, less absorption means more unabsorbed load, and the
        L-cells that would have sensed it are gone. THE POSITIVE
        FEEDBACK IS WHY THE DISEASE IS SELF-SUSTAINING, and supplying
        exogenous GLP-2 is an attempt to re-close a broken loop rather
        than to suppress an overactive one.

     4. ADAPTATION IS NUTRIENT-GATED, SO THE DRUG NEEDS FOOD. Structural
        adaptation (villus height, crypt proliferation, mucosal mass) is
        driven by luminal nutrient contact acting THROUGH the same
        enterohormonal axis. A patient kept nil-by-mouth on full PN does
        not adapt, and — the part that matters pharmacologically — does
        not respond to a GLP-2 analogue either, because the trophic
        signal is drawn here as a PRODUCT of luminal nutrient and
        receptor occupancy, not a sum. Trophic feeding is not adjunctive
        comfort; it is a multiplicand.

   ---------------------------------------------------------------------
   THE WEANING ALGORITHM IS PART OF THE PATHOPHYSIOLOGY

   One further structural choice, unusual enough to state plainly. In the
   STEPS trial the investigator did not choose the PN reduction; a
   protocol did. PN volume was cut when 24-hour URINE OUTPUT rose ≥10%
   above baseline, because rising urine is the observable signature of a
   closed fluid balance. That algorithm is drawn on this map as a real
   feedback controller (cluster PN), which means:

     - the drug's effect on the registered endpoint (≥20% PN volume
       reduction) is produced by simulating the PROTOCOL, not by fitting
       a PN-reduction parameter;
     - and the placebo arm's substantial "response" emerges as a
       property of the algorithm itself — any patient carrying unused
       absorptive reserve will be weaned by a urine-triggered protocol
       whether or not they received drug. The placebo response in SBS
       trials is partly an artefact of good protocolised care.

   ---------------------------------------------------------------------
   WHAT KILLS THESE PATIENTS IS THE THERAPY'S PLUMBING, NOT THE BOWEL

   The right-hand third of the map is deliberately given to iatrogenic
   organ injury, because in modern SBS-IF that is where mortality lives:
   intestinal failure-associated liver disease driven by phytosterol load
   and choline deficiency from the lipid emulsion; catheter-related
   bloodstream infection consuming central venous access one vein at a
   time until transplantation becomes the only option; enteric
   hyperoxaluria that requires a colon to happen at all; and metabolic
   bone disease from divalent cation losses. These are not side notes.
   The competing-risk structure — bowel improving while liver and veins
   deteriorate — is the actual decision problem.

   ---------------------------------------------------------------------
   LAYOUT

     Left    ANAT ETIO CAP SECR    anatomy, cause, capacity, secretory load
     Centre  JEJ COLON NRG BAL     the two conservation equations
     Upper   LCELL MOT ADAPT FUNC  the loop and its trophic output
     Lower   BILE MICRO MICRO2     bile acids, bacteria, micronutrients
     Right   PN GLP2PK DRUG        prescription, GLP-2 analogues, adjuncts
     Far-R   IFALD CVC RENAL BONE  iatrogenic organ injury
     Bottom  ENDP TX               endpoints and transplantation

   Node shapes / colours
     box, blue        anatomy & parameters (not states)
     ellipse, grey    physiological fluxes and pools
     ellipse, green   adaptive / protective processes
     ellipse, red     maladaptive / injurious processes
     hexagon, orange  drugs and prescribed inputs
     diamond, purple  clinical endpoints
     octagon, gold    conservation-equation nodes (the balance itself)
     doubleoctagon    structural nulls / traps (effect must be ZERO or REVERSE)

   Edge semantics
     solid arrow       mass flux or causal activation
     dashed arrow      signal / regulation
     dotted arrow      measurement or surveillance
     tee (odiamond)    inhibition
     bold red          the self-sustaining positive feedback loop
   ===================================================================== */

digraph SBS_QSP {
    graph [rankdir=LR, splines=spline, overlap=false, nodesep=0.28, ranksep=1.05,
           fontname="Helvetica", fontsize=11, newrank=true,
           labelloc="t", labeljust="l",
           label=<<B>Short Bowel Syndrome with Chronic Intestinal Failure (SBS-IF) — QSP Mechanistic Map</B><BR/>
<FONT POINT-SIZE="12">단장증후군 · 만성 장부전 — 정량적 시스템 약리학 기계론적 지도</FONT><BR/>
<FONT POINT-SIZE="10">Parenteral support volume is an OUTPUT of two conservation equations (fluid, energy), not an input.<BR/>
Anatomy is a parameter that multiplies capacity. The ileal-brake loop is the positive feedback that makes the disease self-sustaining.<BR/>
Adaptation is nutrient-GATED, so GLP-2 analogue effect enters as a PRODUCT with luminal nutrient — never as a sum.</FONT>>];

    node [fontname="Helvetica", fontsize=9, style="filled", penwidth=1.1];
    edge [fontname="Helvetica", fontsize=8, arrowsize=0.65, color="#555555"];

    /* ============================================================
       CLUSTER 1 — ETIOLOGY: WHY THE BOWEL IS SHORT
       ============================================================ */
    subgraph cluster_ETIO {
        label=<<B>1. 원인 · Etiology of massive resection</B><BR/><FONT POINT-SIZE="8">the cause sets the remnant, the remnant sets everything else</FONT>>;
        style="filled"; fillcolor="#f2f6fb"; color="#5b7fa6"; fontsize=11;
        node [shape=box, fillcolor="#dbe7f3", color="#5b7fa6"];

        E_MESENT   [label="급성 상부장간막동맥\n허혈·색전\nAcute mesenteric ischaemia\n(adult SBS ~30-40%)"];
        E_VOLV     [label="중장 염전\nMidgut volvulus"];
        E_CROHN    [label="크론병 반복 절제\nCrohn disease\nrepeated resections"];
        E_TRAUMA   [label="외상·복부 관통상\nTrauma"];
        E_RADIAT   [label="방사선 장염\nRadiation enteritis\n(mucosa also injured)"];
        E_NEC      [label="신생아 괴사성 장염\nNecrotising enterocolitis\n(paediatric SBS ~1st cause)"];
        E_ATRESIA  [label="장 무공증·복벽결손\nIntestinal atresia /\ngastroschisis"];
        E_DESMOID  [label="데스모이드·복강내 종양\nDesmoid / intra-abdominal tumour"];
        E_ADHES    [label="유착성 폐색 반복수술\nRecurrent adhesive obstruction"];
        E_PSEUDO   [label="만성 장 가성폐색 (CIPO)\nfunctional short bowel\n— length NORMAL, motility absent"];

        E_MESENT -> E_RESECT; E_VOLV -> E_RESECT; E_CROHN -> E_RESECT;
        E_TRAUMA -> E_RESECT; E_RADIAT -> E_RESECT; E_NEC -> E_RESECT;
        E_ATRESIA -> E_RESECT; E_DESMOID -> E_RESECT; E_ADHES -> E_RESECT;
        E_RESECT   [label="광범위 소장 절제\nMassive small-bowel resection", shape=box, fillcolor="#c3d6e8"];
    }

    /* ============================================================
       CLUSTER 2 — ANATOMY AS PARAMETER
       ============================================================ */
    subgraph cluster_ANAT {
        label=<<B>2. 잔여 해부 = 파라미터 · Remnant anatomy as PARAMETER</B><BR/><FONT POINT-SIZE="8">these are not states; they multiply every capacity downstream</FONT>>;
        style="filled"; fillcolor="#eef4fa"; color="#3f6d99"; fontsize=11;
        node [shape=box, fillcolor="#cfe0ef", color="#3f6d99"];

        A_SBL      [label="잔여 소장 길이 SBL\nRemnant small-bowel length\n(cm from duodenojejunal flexure)", fillcolor="#b7d0e6"];
        A_ICV      [label="회맹판 보존 여부 ICV\nIleocaecal valve present?\n(0/1)"];
        A_COLON    [label="연속성 대장 비율 COLONFRAC\nColon in continuity (0-1)\n(0 = end-jejunostomy)", fillcolor="#b7d0e6"];
        A_ILEUM    [label="잔여 회장 길이\nRemnant ileum (cm)\n— site of B12, bile acid, L-cells"];
        A_STOMACH  [label="위 보존\nStomach intact?\n(gastric acid load)"];
        A_TYPE1    [label="Messing type 1\n말단 공장루 End-jejunostomy\nPN 영구의존 역치 ~115 cm"];
        A_TYPE2    [label="Messing type 2\n공장-대장 문합 Jejuno-colic\nPN 영구의존 역치 ~60 cm"];
        A_TYPE3    [label="Messing type 3\n공장-회장-대장 Jejuno-ileo-colic\nPN 영구의존 역치 ~35 cm"];
        A_MUCQUAL  [label="잔여 점막의 질\nRemnant mucosal quality\n(radiation / Crohn / normal)"];
        A_DILAT    [label="확장·정체 분절\nDilated stagnant loop\n(bacterial reservoir)"];
        A_SURFACE  [label="유효 흡수 표면적\nEffective absorptive surface\n= SBL x villus x microvillus", fillcolor="#9fc2de"];

        A_SBL -> A_TYPE1 [style=invis]; A_COLON -> A_TYPE2 [style=invis];
        A_SBL -> A_SURFACE; A_MUCQUAL -> A_SURFACE;
        A_ICV -> A_DILAT [label="loss →", style=dashed];
        E_RESECT -> A_SBL; E_RESECT -> A_ILEUM; E_RESECT -> A_COLON; E_RESECT -> A_ICV;
        E_PSEUDO -> A_SURFACE [label="normal length,\nzero motility", style=dashed, color="#b03030"];
    }

    /* ============================================================
       CLUSTER 3 — ABSORPTIVE CAPACITY (the coefficient)
       ============================================================ */
    subgraph cluster_CAP {
        label=<<B>3. 흡수 계수 · Absorptive capacity — the Damköhler product</B><BR/><FONT POINT-SIZE="8">absorbed fraction = 1 − exp(−k · surface · contact time): length AND time MULTIPLY</FONT>>;
        style="filled"; fillcolor="#f0f7f0"; color="#4a7a4a"; fontsize=11;
        node [shape=ellipse, fillcolor="#dcecdc", color="#4a7a4a"];

        C_KAPPA    [label="점막 투과-수송 상수 k\nintrinsic per-area\ntransport constant"];
        C_CONTACT  [label="점막 접촉 시간 Tc\nmucosal contact time\n(= transit time x mixing)", fillcolor="#c9e2c9"];
        C_DAMK     [label="Damköhler 수 Da = k·A·Tc\nabsorbed fraction = 1 − e^(−Da)", shape=octagon, fillcolor="#f6e3a0", color="#a08000"];
        C_FRACH2O  [label="수분 흡수 분율\nFluid absorption fraction"];
        C_FRACNA   [label="나트륨 흡수 분율\nSodium absorption fraction"];
        C_FRACCHO  [label="탄수화물 흡수 계수\nCHO coefficient (~0.6-0.9)"];
        C_FRACFAT  [label="지방 흡수 계수\nFat coefficient (~0.3-0.7)\nmost length-sensitive", fillcolor="#f5d9d9", color="#a04040"];
        C_FRACPRO  [label="단백 흡수 계수\nProtein coefficient (~0.6-0.8)"];
        C_SAT      [label="용량 포화\nSaturable capacity —\nbigger meals absorbed\nLESS efficiently"];

        A_SURFACE -> C_DAMK; C_KAPPA -> C_DAMK; C_CONTACT -> C_DAMK;
        C_DAMK -> C_FRACH2O; C_DAMK -> C_FRACNA; C_DAMK -> C_FRACCHO;
        C_DAMK -> C_FRACFAT; C_DAMK -> C_FRACPRO;
        C_SAT -> C_FRACCHO [style=dashed, arrowhead=odiamond];
        C_SAT -> C_FRACFAT [style=dashed, arrowhead=odiamond];
    }

    /* ============================================================
       CLUSTER 4 — SECRETORY LOAD (the numerator nobody counts)
       ============================================================ */
    subgraph cluster_SECR {
        label=<<B>4. 분비 부하 · Endogenous secretory load</B><BR/><FONT POINT-SIZE="8">~6-8 L/day enters the lumen before the patient drinks anything</FONT>>;
        style="filled"; fillcolor="#fdf4ec"; color="#a06a30"; fontsize=11;
        node [shape=ellipse, fillcolor="#f8e3cf", color="#a06a30"];

        S_SALIVA   [label="타액 Saliva\n~1.0-1.5 L/d"];
        S_GASTRIC  [label="위액 Gastric juice\n~1.5-2.5 L/d\n(H+ 150 mmol/L)"];
        S_HYPERSEC [label="절제후 위산 과분비\nPost-resection gastric\nHYPERsecretion\n(loss of inhibitory peptides,\nhypergastrinaemia)", fillcolor="#f5d9d9", color="#a04040"];
        S_BILE     [label="담즙 Bile\n~0.5-0.8 L/d"];
        S_PANC     [label="췌액 Pancreatic juice\n~0.8-1.5 L/d\n(HCO3− rich)"];
        S_JEJSEC   [label="공장 분비\nJejunal crypt secretion\n(CFTR, Cl− driven)"];
        S_TOTSEC   [label="총 분비량 SEC\nTotal secretory input\n≈ 4-6 L/d", shape=octagon, fillcolor="#f6e3a0", color="#a08000"];
        S_ACIDINAC [label="산에 의한 리파제 불활성화\nAcid inactivates pancreatic\nlipase & deconjugates bile\n→ steatorrhoea", fillcolor="#f5d9d9", color="#a04040"];

        S_SALIVA -> S_TOTSEC; S_GASTRIC -> S_TOTSEC; S_BILE -> S_TOTSEC;
        S_PANC -> S_TOTSEC; S_JEJSEC -> S_TOTSEC;
        S_HYPERSEC -> S_GASTRIC [label="x2-3\nfirst 6-12 mo"];
        S_HYPERSEC -> S_ACIDINAC;
        S_ACIDINAC -> C_FRACFAT [arrowhead=odiamond, color="#b03030"];
        A_STOMACH -> S_GASTRIC;
    }

    /* ============================================================
       CLUSTER 5 — JEJUNAL Na/WATER FLUX: THE SIGN CHANGE
       ============================================================ */
    subgraph cluster_JEJ {
        label=<<B>5. 공장 Na⁺/수분 flux · Jejunal flux — WHERE THE SIGN CHANGES</B><BR/><FONT POINT-SIZE="8">net Na absorption = 0 at luminal [Na⁺] ≈ 90-100 mmol/L; NEGATIVE below it</FONT>>;
        style="filled"; fillcolor="#eef6fb"; color="#2f6f9f"; fontsize=11;
        node [shape=ellipse, fillcolor="#d3e7f5", color="#2f6f9f"];

        J_CNA      [label="관내 Na⁺ 농도 [Na]lum\nLuminal sodium concentration", fillcolor="#b9d8ee"];
        J_CEQ      [label="등가 농도 [Na]eq ≈ 90-100 mmol/L\nzero-flux set point\n(Fordtran perfusion studies)", shape=octagon, fillcolor="#f6e3a0", color="#a08000"];
        J_JNA      [label="Na⁺ 순 flux JNa ∝ ([Na]lum − [Na]eq)\n→ SECRETION when hypotonic", fillcolor="#b9d8ee"];
        J_SGLT1    [label="SGLT1 포도당-Na⁺ 공수송\nglucose-coupled Na⁺ uptake\n(1 glucose : 2 Na⁺)", shape=ellipse, fillcolor="#dcecdc", color="#4a7a4a"];
        J_NHE3     [label="NHE3 Na⁺/H⁺ 교환체\nelectroneutral Na absorption"];
        J_PARAC    [label="세포간 경로 (claudin-2/15)\nparacellular water & Na flux\n— jejunum is the LEAKIEST gut"];
        J_OSM      [label="관내 삼투압\nLuminal osmolality\n(hyperosmolar feed → secretion)"];
        J_H2OFOLLOW[label="수분은 용질을 따른다\nWater follows solute\n(AQP, paracellular drag)"];
        J_WATERTRAP[label="저장액 물 마시기\nDRINKING PLAIN WATER\n→ [Na]lum ↓ → JNa NEGATIVE\n→ Na⁺ AND volume LOST", shape=doubleoctagon, fillcolor="#f3c9c9", color="#8b1a1a", penwidth=2];
        J_ORSFIX   [label="글루코스-전해질 용액 (ORS)\nORS Na⁺ ≈ 90-120 mmol/L\n+ glucose → SGLT1\n→ JNa POSITIVE", shape=doubleoctagon, fillcolor="#cfe8cf", color="#1a6b1a", penwidth=2];
        J_NETH2O   [label="공장 순 수분 흡수 (또는 분비)\nNet jejunal water flux", fillcolor="#b9d8ee"];

        J_CNA -> J_JNA; J_CEQ -> J_JNA;
        J_SGLT1 -> J_JNA [label="+", color="#2f7f2f"];
        J_NHE3 -> J_JNA [label="+", color="#2f7f2f"];
        J_JNA -> J_H2OFOLLOW -> J_NETH2O;
        J_PARAC -> J_NETH2O; J_OSM -> J_NETH2O [arrowhead=odiamond, color="#b03030"];
        J_WATERTRAP -> J_CNA [label="dilutes", color="#b03030"];
        J_ORSFIX -> J_CNA [label="raises to ~90", color="#2f7f2f"];
        J_ORSFIX -> J_SGLT1 [label="glucose\nsubstrate", color="#2f7f2f"];
        C_FRACNA -> J_JNA [style=dashed];
        S_TOTSEC -> J_CNA [label="secretions are\nisotonic (~140)", style=dashed];
    }

    /* ============================================================
       CLUSTER 6 — COLON AS A DIGESTIVE ORGAN
       ============================================================ */
    subgraph cluster_COLON {
        label=<<B>6. 대장 = 소화 기관 · The colon as a digestive organ</B><BR/><FONT POINT-SIZE="8">3-4 L water, 400-800 mmol Na⁺, and up to ~1000 kcal/day of SCFA salvage</FONT>>;
        style="filled"; fillcolor="#f3f0f8"; color="#6a4a95"; fontsize=11;
        node [shape=ellipse, fillcolor="#e2dbf0", color="#6a4a95"];

        K_CAP      [label="대장 수분 흡수 용량\nColonic water capacity\n≈ 3-4 L/d x COLONFRAC", fillcolor="#cfc4e6"];
        K_ENAC     [label="ENaC (알도스테론 유도)\nAldosterone-driven ENaC\n→ near-complete Na⁺ recovery"];
        K_ALDO     [label="알도스테론\nAldosterone (volume depletion →\nRAAS → colonic Na avidity)", shape=ellipse, fillcolor="#dcecdc", color="#4a7a4a"];
        K_FERMENT  [label="탄수화물 발효\nBacterial fermentation of\nunabsorbed carbohydrate & fibre"];
        K_SCFA     [label="단쇄지방산 SCFA\nacetate·propionate·butyrate\n~1.5-2 kcal per g CHO fermented", fillcolor="#cfc4e6"];
        K_SCFAKCAL [label="대장 에너지 회수\nColonic energy salvage\nup to ~1000 kcal/d\n(Nordgaard)", shape=octagon, fillcolor="#f6e3a0", color="#a08000"];
        K_BUTYRATE [label="부티레이트 → 대장세포 연료\n+ 점막 영양·장벽 강화", shape=ellipse, fillcolor="#dcecdc", color="#4a7a4a"];
        K_SCFANA   [label="SCFA 흡수가 Na⁺ 흡수를 촉진\nSCFA-stimulated Na absorption"];
        K_MICROAD  [label="발효능의 적응\nFermentative capacity adapts\nover months (microbiome shift)", shape=ellipse, fillcolor="#dcecdc", color="#4a7a4a"];
        K_TRANSIT  [label="대장 통과 시간\nColonic transit\n(long → more salvage)"];
        K_NOCOLON  [label="말단 공장루 = 회수 0\nEND-JEJUNOSTOMY:\nzero water, zero Na, zero SCFA salvage\n→ 3x higher PN requirement", shape=doubleoctagon, fillcolor="#f3c9c9", color="#8b1a1a", penwidth=2];

        A_COLON -> K_CAP; A_COLON -> K_FERMENT;
        K_ALDO -> K_ENAC -> K_CAP;
        K_FERMENT -> K_SCFA -> K_SCFAKCAL;
        K_SCFA -> K_BUTYRATE; K_SCFA -> K_SCFANA -> K_CAP;
        K_MICROAD -> K_FERMENT; K_TRANSIT -> K_FERMENT;
        A_COLON -> K_NOCOLON [label="COLONFRAC = 0", style=dashed, color="#b03030"];
        K_NOCOLON -> K_CAP [arrowhead=odiamond, color="#8b1a1a", penwidth=1.6];
        K_NOCOLON -> K_SCFAKCAL [arrowhead=odiamond, color="#8b1a1a", penwidth=1.6];
    }

    /* ============================================================
       CLUSTER 7 — L-CELL / ENTEROHORMONAL AXIS (the broken loop)
       ============================================================ */
    subgraph cluster_LCELL {
        label=<<B>7. L세포 · 장호르몬 축 · L-cell enterohormonal axis — THE BROKEN LOOP</B><BR/><FONT POINT-SIZE="8">L-cells live in distal ileum &amp; proximal colon — exactly the tissue that is resected</FONT>>;
        style="filled"; fillcolor="#fffbe8"; color="#8a7000"; fontsize=11;
        node [shape=ellipse, fillcolor="#faf0c0", color="#8a7000"];

        L_MASS     [label="L세포 질량\nL-cell mass\n∝ remnant ileum + colon", fillcolor="#f3e49a"];
        L_NUTSENS  [label="관내 영양소 감지\nLuminal nutrient sensing\n(FFAR2/3, GPR119, SGLT1)"];
        L_PROGLU   [label="프로글루카곤 유전자\nProglucagon → PC1/3 cleavage"];
        L_GLP2     [label="내인성 GLP-2 (1-33)\nEndogenous GLP-2\npostprandial surge", fillcolor="#f3e49a"];
        L_GLP1     [label="GLP-1\n(gastric emptying ↓, satiety)"];
        L_PYY      [label="PYY 3-36\n(ileal brake, transit ↓)"];
        L_NEUROT   [label="뉴로텐신 Neurotensin"];
        L_DPP4     [label="DPP-4\ncleaves GLP-2 at Ala2-Gly3\n→ native t½ ≈ 7 min", shape=ellipse, fillcolor="#f5d9d9", color="#a04040"];
        L_GLP2R    [label="GLP2R (장 하위상피 근섬유모세포·\n장신경세포에 발현, 상피에는 없음)\nGLP-2 receptor — INDIRECT action"];
        L_IGF1LOC  [label="국소 IGF-1 · KGF · ErbB 리간드\nlocal IGF-1 from subepithelial\nmyofibroblasts = the actual mitogen", shape=ellipse, fillcolor="#dcecdc", color="#4a7a4a"];
        L_ENS      [label="장신경계 NO/VIP 경로\nENS relay → blood flow ↑,\nmotility ↓"];
        L_BLUNTED  [label="절제 후 식후 GLP-2 반응 소실\nBLUNTED postprandial GLP-2/PYY\nin SBS with resected ileum", fillcolor="#f5d9d9", color="#a04040"];
        L_GHRELIN  [label="그렐린 Ghrelin ↑\n(hyperphagia drive)"];
        L_GASTRIN  [label="가스트린 Gastrin ↑\n(loss of inhibitory peptides)", fillcolor="#f5d9d9", color="#a04040"];
        L_CCK      [label="CCK\n(gallbladder contraction)"];

        A_ILEUM -> L_MASS; A_COLON -> L_MASS;
        L_NUTSENS -> L_PROGLU; L_MASS -> L_PROGLU;
        L_PROGLU -> L_GLP2; L_PROGLU -> L_GLP1; L_MASS -> L_PYY; L_MASS -> L_NEUROT;
        L_DPP4 -> L_GLP2 [arrowhead=odiamond, label="t½ 7 min", color="#b03030"];
        L_GLP2 -> L_GLP2R -> L_IGF1LOC;
        L_GLP2R -> L_ENS;
        L_MASS -> L_BLUNTED [label="mass ↓ →", style=dashed, color="#b03030"];
        L_BLUNTED -> L_GLP2 [arrowhead=odiamond, color="#b03030"];
        L_GASTRIN -> S_HYPERSEC;
        L_CCK -> S_BILE;
    }

    /* ============================================================
       CLUSTER 8 — MOTILITY / TRANSIT / THE ILEAL BRAKE
       ============================================================ */
    subgraph cluster_MOT {
        label=<<B>8. 운동성 · 통과시간 · Motility, transit and the ileal brake</B><BR/><FONT POINT-SIZE="8">contact time is a multiplicand in the Damköhler product — this is why transit drugs work</FONT>>;
        style="filled"; fillcolor="#f6f2ec"; color="#7a5a3a"; fontsize=11;
        node [shape=ellipse, fillcolor="#eadfd0", color="#7a5a3a"];

        M_GE       [label="위 배출 속도\nGastric emptying rate"];
        M_BRAKE    [label="회장 브레이크\nILEAL BRAKE\n(GLP-1 + PYY + neurotensin)", fillcolor="#dcd0bd"];
        M_TRANSIT  [label="소장 통과 시간 SBTT\nSmall-bowel transit time\n(normal 3-4 h; SBS <1 h)", fillcolor="#dcd0bd"];
        M_MMC      [label="이동성 운동 복합체 MMC\nMigrating motor complex\n(bacterial clearance)"];
        M_ICVLOSS  [label="회맹판 소실\nICV loss → colonic reflux,\nfaster emptying, SIBO", fillcolor="#f5d9d9", color="#a04040"];
        M_MU       [label="μ-오피오이드 수용체\nEnteric μ-opioid receptors\n→ transit ↓↓"];
        M_MIXING   [label="분절 수축·혼합\nSegmental mixing efficiency"];
        M_DILATLOOP[label="확장 분절의 정체\nStasis in dilated loop\n→ SIBO, not absorption", fillcolor="#f5d9d9", color="#a04040"];

        L_GLP1 -> M_BRAKE; L_PYY -> M_BRAKE; L_NEUROT -> M_BRAKE;
        M_BRAKE -> M_GE [arrowhead=odiamond]; M_BRAKE -> M_TRANSIT [label="prolongs", color="#2f7f2f"];
        L_ENS -> M_TRANSIT [label="prolongs", color="#2f7f2f", style=dashed];
        M_TRANSIT -> C_CONTACT; M_MIXING -> C_CONTACT;
        M_ICVLOSS -> M_TRANSIT [arrowhead=odiamond, color="#b03030"];
        A_ICV -> M_ICVLOSS [style=dashed];
        M_MU -> M_TRANSIT [label="prolongs", color="#2f7f2f"];
        A_DILAT -> M_DILATLOOP; M_MMC -> M_DILATLOOP [arrowhead=odiamond];
        M_GE -> J_OSM [label="rapid delivery →\nhyperosmolar jejunum", style=dashed];
    }

    /* ============================================================
       CLUSTER 9 — STRUCTURAL ADAPTATION
       ============================================================ */
    subgraph cluster_ADAPT {
        label=<<B>9. 구조적 적응 · Structural adaptation (weeks → 2 years)</B><BR/><FONT POINT-SIZE="8">NUTRIENT-GATED: the trophic signal is a PRODUCT of luminal nutrient x GLP2R occupancy</FONT>>;
        style="filled"; fillcolor="#eef7ee"; color="#3f7a3f"; fontsize=11;
        node [shape=ellipse, fillcolor="#d5ebd5", color="#3f7a3f"];

        D_LUMNUT   [label="관내 영양소 노출\nLuminal nutrient exposure\n(enteral feeding)", fillcolor="#bfe0bf"];
        D_TROPHIC  [label="영양 신호 = 관내영양소 x GLP2R 점유\nTROPHIC SIGNAL = PRODUCT\n(zero enteral feed → zero adaptation)", shape=octagon, fillcolor="#f6e3a0", color="#a08000"];
        D_CRYPT    [label="크립트 세포 증식\nCrypt cell proliferation\n(Ki-67, Lgr5+ ISC)"];
        D_VILLUS   [label="융모 높이\nVillus height\n(+30-50% achievable)", fillcolor="#bfe0bf"];
        D_CRYPTD   [label="크립트 깊이\nCrypt depth"];
        D_MUCMASS  [label="점막 질량\nMucosal absorptive mass", fillcolor="#bfe0bf"];
        D_APOPT    [label="세포자멸사 감소\nReduced enterocyte apoptosis"];
        D_DILATION [label="관 직경 확장 (보상)\nLuminal dilation\n(surface ↑ but stasis ↑)"];
        D_LENGTHEN [label="길이 신장 (소아에서만 유의)\nLengthening — meaningful\nonly in the growing child"];
        D_TIMECOURSE[label="적응 시간 상수\nτ ≈ 6-12 months,\nplateau by ~2 years", shape=box, fillcolor="#dbe7f3", color="#5b7fa6"];
        D_IGF1SYS  [label="전신 IGF-1\nSystemic IGF-1 (GH-driven)"];
        D_EGF      [label="EGF (침샘·브루너샘 유래)\nsalivary & Brunner gland EGF"];
        D_GLUT     [label="글루타민 = 장세포 주연료\nGlutamine, enterocyte fuel"];
        D_POLYAM   [label="폴리아민 (ODC)\nPolyamines — obligatory\nfor crypt mitosis"];
        D_NPO      [label="완전 금식 + 완전 PN\nNIL BY MOUTH on full PN\n→ villus atrophy, NO adaptation,\nand NO GLP-2 analogue response", shape=doubleoctagon, fillcolor="#f3c9c9", color="#8b1a1a", penwidth=2];

        D_LUMNUT -> D_TROPHIC; L_IGF1LOC -> D_TROPHIC;
        D_TROPHIC -> D_CRYPT -> D_VILLUS; D_CRYPT -> D_CRYPTD;
        D_TROPHIC -> D_APOPT [arrowhead=odiamond];
        D_VILLUS -> D_MUCMASS; D_CRYPTD -> D_MUCMASS; A_SBL -> D_MUCMASS;
        D_MUCMASS -> A_SURFACE; D_DILATION -> A_SURFACE;
        D_DILATION -> A_DILAT [style=dashed, color="#b03030"];
        D_LENGTHEN -> A_SBL [style=dashed];
        D_TIMECOURSE -> D_VILLUS [style=dashed];
        D_IGF1SYS -> D_CRYPT; D_EGF -> D_CRYPT; D_GLUT -> D_CRYPT;
        D_POLYAM -> D_CRYPT;
        D_NPO -> D_LUMNUT [arrowhead=odiamond, color="#8b1a1a", penwidth=1.6];
        D_NPO -> D_TROPHIC [arrowhead=odiamond, color="#8b1a1a", penwidth=1.6, label="PRODUCT → 0"];
        D_LUMNUT -> L_NUTSENS [label="also drives\nL-cell secretion", style=dashed, color="#2f7f2f"];
    }

    /* ============================================================
       CLUSTER 10 — FUNCTIONAL ADAPTATION
       ============================================================ */
    subgraph cluster_FUNC {
        label=<<B>10. 기능적 적응 · Functional adaptation</B><BR/><FONT POINT-SIZE="8">per-area transport capacity rises even when villus height does not</FONT>>;
        style="filled"; fillcolor="#f0f7f4"; color="#3f7a6a"; fontsize=11;
        node [shape=ellipse, fillcolor="#d5ebe4", color="#3f7a6a"];

        F_SGLT1UP  [label="SGLT1 상향조절\nSGLT1 density ↑"];
        F_NHE3UP   [label="NHE3 상향조절\nNHE3 density ↑"];
        F_PEPT1    [label="PEPT1 펩타이드 수송체\nPEPT1 di/tripeptide uptake ↑"];
        F_BBENZ    [label="쇄자연 효소\nBrush-border enzymes\n(lactase, sucrase-isomaltase)"];
        F_FABP     [label="FABP · 지방 재에스터화\nFatty acid binding &\nchylomicron assembly"];
        F_ZO       [label="밀착연접 재구성\nTight-junction remodelling\n(claudin switch)"];
        F_KAPPAUP  [label="유효 k 상승\nEffective per-area constant k ↑", fillcolor="#bfdfd4"];
        F_CAAB     [label="칼슘 흡수 (TRPV6, 활성 비타민D 의존)\nActive Ca²⁺ absorption"];
        F_MGAB     [label="마그네슘 흡수 (TRPM6/7, 주로 회장)\nMg²⁺ absorption — ileum-dependent"];

        D_TROPHIC -> F_SGLT1UP; D_TROPHIC -> F_NHE3UP; D_TROPHIC -> F_PEPT1;
        D_TROPHIC -> F_BBENZ; D_TROPHIC -> F_FABP; D_TROPHIC -> F_ZO;
        F_SGLT1UP -> J_SGLT1; F_NHE3UP -> J_NHE3;
        F_SGLT1UP -> F_KAPPAUP; F_NHE3UP -> F_KAPPAUP; F_PEPT1 -> F_KAPPAUP;
        F_BBENZ -> F_KAPPAUP; F_FABP -> F_KAPPAUP;
        F_KAPPAUP -> C_KAPPA;
        A_ILEUM -> F_MGAB [label="site-specific", style=dashed];
    }

    /* ============================================================
       CLUSTER 11 — BILE ACID ENTEROHEPATIC CIRCULATION
       ============================================================ */
    subgraph cluster_BILE {
        label=<<B>11. 담즙산 장간 순환 · Bile acid enterohepatic circulation</B><BR/><FONT POINT-SIZE="8">the 100 cm rule: below it, bile-acid diarrhoea; above it, pool depletion and steatorrhoea — OPPOSITE therapies</FONT>>;
        style="filled"; fillcolor="#fdf6e8"; color="#8a6a20"; fontsize=11;
        node [shape=ellipse, fillcolor="#f6ead0", color="#8a6a20"];

        B_SYNTH    [label="간 담즙산 합성 (CYP7A1)\nHepatic BA synthesis"];
        B_POOL     [label="담즙산 풀 크기\nBile acid pool (~3-4 g)", fillcolor="#eeda9f"];
        B_ASBT     [label="ASBT (회장 말단)\nIleal Na-dependent BA transporter\n— 95% reclaimed HERE"];
        B_FGF19    [label="FGF19 (회장 FXR 유래)\nileal FXR → FGF19 → feedback\ninhibition of CYP7A1"];
        B_MICELLE  [label="미셀 형성\nMicellar solubilisation\n(critical micellar conc.)"];
        B_LOSS     [label="담즙산 대장 유출\nBA spill into colon"];
        B_BAD      [label="담즙산 설사 (절제 <100 cm)\nBILE ACID DIARRHOEA\ncolonic secretory drive", fillcolor="#f5d9d9", color="#a04040"];
        B_DEPLETE  [label="풀 고갈 (절제 >100 cm)\nPOOL DEPLETION → micelles fail\n→ FAT malabsorption", fillcolor="#f5d9d9", color="#a04040"];
        B_100CM    [label="100 cm 규칙\nTHE 100 cm RULE\n<100 cm ileum resected → BAD\n>100 cm → steatorrhoea", shape=octagon, fillcolor="#f6e3a0", color="#a08000"];
        B_LITHO    [label="담석 형성\nCholelithiasis\n(stasis + BA loss + no CCK)", fillcolor="#f5d9d9", color="#a04040"];
        B_SEQTRAP  [label="콜레스티라민의 방향 전환\nCHOLESTYRAMINE REVERSES SIGN:\nhelps at <100 cm,\nWORSENS steatorrhoea at >100 cm", shape=doubleoctagon, fillcolor="#f3c9c9", color="#8b1a1a", penwidth=2];

        B_SYNTH -> B_POOL -> B_MICELLE -> C_FRACFAT;
        B_POOL -> B_ASBT -> B_POOL [label="recycle 6-10x/d"];
        B_ASBT -> B_FGF19 -> B_SYNTH [arrowhead=odiamond, style=dashed];
        A_ILEUM -> B_ASBT; B_ASBT -> B_LOSS [arrowhead=odiamond];
        B_LOSS -> B_BAD; B_LOSS -> B_DEPLETE [label="if synthesis\ncannot keep up"];
        B_100CM -> B_BAD; B_100CM -> B_DEPLETE;
        B_DEPLETE -> B_MICELLE [arrowhead=odiamond, color="#b03030"];
        B_BAD -> K_CAP [arrowhead=odiamond, color="#b03030", label="secretory"];
        B_POOL -> B_LITHO [arrowhead=odiamond]; L_CCK -> B_LITHO [arrowhead=odiamond];
        B_SEQTRAP -> B_POOL [arrowhead=odiamond, color="#8b1a1a"];
    }

    /* ============================================================
       CLUSTER 12 — SIBO / MICROBIOME / D-LACTATE
       ============================================================ */
    subgraph cluster_MICRO {
        label=<<B>12. 소장 세균 과증식 · SIBO, microbiome and D-lactic acidosis</B><BR/><FONT POINT-SIZE="8">D-lactic encephalopathy REQUIRES a colon — it cannot occur in end-jejunostomy</FONT>>;
        style="filled"; fillcolor="#f8f0f4"; color="#8a3a5a"; fontsize=11;
        node [shape=ellipse, fillcolor="#f0dbe4", color="#8a3a5a"];

        G_SIBO     [label="소장 세균 과증식 SIBO\nSmall intestinal bacterial\novergrowth (~60-70% of SBS)", fillcolor="#e4c3d1"];
        G_ICVGONE  [label="회맹판 소실 → 역류 집락화\nICV loss → retrograde colonisation"];
        G_STASIS   [label="정체 (확장·서행 분절)\nStasis in dilated segment"];
        G_ACIDGONE [label="위산 억제 (PPI)\nAcid suppression removes\nthe gastric bacterial filter", fillcolor="#f5d9d9", color="#a04040"];
        G_DECONJ   [label="담즙산 탈접합\nBacterial BA deconjugation\n→ micelles fail"];
        G_MUCINJ   [label="세균성 점막 손상\nBacterial mucosal injury,\nvillus blunting"];
        G_B12CONS  [label="세균의 B12 소비\nBacterial B12 consumption"];
        G_DLACT    [label="D-락트산 (Lactobacillus)\nD-lactate from colonic\ncarbohydrate overload", fillcolor="#e4c3d1"];
        G_ENCEPH   [label="D-락트산 산증·뇌증\nD-lactic acidosis:\nataxia, slurred speech,\nanion-gap acidosis", shape=diamond, fillcolor="#e6d0ea", color="#6a3a8a"];
        G_DYSBIOS  [label="Proteobacteria 우세 이생균증\nLactobacillus-dominant dysbiosis"];
        G_ENDOTOX  [label="장 투과성 ↑ → 내독소 전위\nBarrier failure → endotoxin\ntranslocation to portal vein"];
        G_NEEDCOL  [label="D-락트산증은 대장을 요구한다\nD-LACTIC ACIDOSIS REQUIRES A COLON\n— structural null in end-jejunostomy", shape=doubleoctagon, fillcolor="#cfe8cf", color="#1a6b1a", penwidth=2];

        G_ICVGONE -> G_SIBO; G_STASIS -> G_SIBO; G_ACIDGONE -> G_SIBO;
        M_ICVLOSS -> G_ICVGONE; M_DILATLOOP -> G_STASIS;
        G_SIBO -> G_DECONJ -> B_MICELLE [arrowhead=odiamond, color="#b03030"];
        G_SIBO -> G_MUCINJ -> D_VILLUS [arrowhead=odiamond, color="#b03030"];
        G_SIBO -> G_B12CONS; G_SIBO -> G_DYSBIOS -> G_DLACT;
        K_FERMENT -> G_DLACT [label="CHO overload"];
        G_DLACT -> G_ENCEPH;
        G_NEEDCOL -> G_DLACT [style=dashed, color="#1a6b1a"];
        G_SIBO -> G_ENDOTOX;
    }

    /* ============================================================
       CLUSTER 13 — ENERGY BALANCE
       ============================================================ */
    subgraph cluster_NRG {
        label=<<B>13. 에너지 균형 방정식 · The ENERGY conservation equation</B><BR/><FONT POINT-SIZE="8">absorbed − expended = deficit → PN calories</FONT>>;
        style="filled"; fillcolor="#fffbf0"; color="#8a7020"; fontsize=11;
        node [shape=ellipse, fillcolor="#f7edcf", color="#8a7020"];

        N_ORALKCAL [label="경구 섭취 열량\nOral energy intake"];
        N_HYPERPH  [label="과식 보상 (Hyperphagia)\nSpontaneous hyperphagia\nup to 1.5-2 x normal intake", shape=ellipse, fillcolor="#dcecdc", color="#4a7a4a"];
        N_ABSKCAL  [label="흡수 열량\nAbsorbed energy\n= oral x coefficient"];
        N_FECALKCAL[label="분변 열량 손실\nFaecal energy loss\n(often 40-60% of intake)", fillcolor="#f5d9d9", color="#a04040"];
        N_STEAT    [label="지방설사 Steatorrhoea\n(fat is the dominant loss)", fillcolor="#f5d9d9", color="#a04040"];
        N_REE      [label="휴식 에너지 소비 REE\n(∝ lean mass)"];
        N_TEE      [label="총 에너지 소비 TEE\n= REE x activity"];
        N_NRGBAL   [label="에너지 수지 = 흡수 + SCFA − TEE\nENERGY BALANCE", shape=octagon, fillcolor="#f6e3a0", color="#a08000"];
        N_LEAN     [label="제지방 체중\nLean body mass"];
        N_FAT      [label="체지방\nFat mass"];
        N_WEIGHT   [label="체중\nBody weight", shape=diamond, fillcolor="#e6d0ea", color="#6a3a8a"];
        N_SARCO    [label="근육소모·기능저하\nSarcopenia, weakness", fillcolor="#f5d9d9", color="#a04040"];

        N_HYPERPH -> N_ORALKCAL; N_ORALKCAL -> N_ABSKCAL;
        C_FRACCHO -> N_ABSKCAL; C_FRACFAT -> N_ABSKCAL; C_FRACPRO -> N_ABSKCAL;
        N_ORALKCAL -> N_FECALKCAL; C_FRACFAT -> N_STEAT [arrowhead=odiamond];
        N_STEAT -> N_FECALKCAL;
        N_ABSKCAL -> N_NRGBAL; K_SCFAKCAL -> N_NRGBAL;
        N_TEE -> N_NRGBAL [arrowhead=odiamond];
        N_REE -> N_TEE; N_LEAN -> N_REE;
        N_NRGBAL -> N_LEAN; N_NRGBAL -> N_FAT;
        N_LEAN -> N_WEIGHT; N_FAT -> N_WEIGHT;
        N_LEAN -> N_SARCO [arrowhead=odiamond];
        D_LUMNUT -> N_ORALKCAL [dir=back, style=dashed];
    }

    /* ============================================================
       CLUSTER 14 — FLUID BALANCE
       ============================================================ */
    subgraph cluster_BAL {
        label=<<B>14. 수분·나트륨 균형 방정식 · The FLUID conservation equation</B><BR/><FONT POINT-SIZE="8">this is the equation whose residual the central line fills</FONT>>;
        style="filled"; fillcolor="#eef8fb"; color="#20708a"; fontsize=11;
        node [shape=ellipse, fillcolor="#d0ebf2", color="#20708a"];

        W_ORAL     [label="경구 수분 섭취\nOral fluid intake"];
        W_DELIV    [label="공장 도달 수분\n= oral + secretions"];
        W_JEJABS   [label="공장 흡수 (or 분비)\nJejunal net absorption"];
        W_COLABS   [label="대장 회수\nColonic salvage"];
        W_OUTPUT   [label="변·장루 배출량\nStool / stoma output (L/d)\n— the measurable", fillcolor="#a8d8e6"];
        W_INSENS   [label="불감손실\nInsensible loss ~0.5-0.8 L/d"];
        W_URINE    [label="요량\n24-h urine output\n— THE WEANING SIGNAL", fillcolor="#a8d8e6"];
        W_FLUIDBAL [label="수분 수지 = 흡수 + PN − 배출 − 불감\nFLUID BALANCE", shape=octagon, fillcolor="#f6e3a0", color="#a08000"];
        W_NABAL    [label="나트륨 수지\nSODIUM balance\n(stoma Na ≈ 90-100 mmol/L)", shape=octagon, fillcolor="#f6e3a0", color="#a08000"];
        W_TBW      [label="총 체수분·순환 용적\nTotal body water /\neffective circulating volume", fillcolor="#a8d8e6"];
        W_DEHYD    [label="만성 탈수\nChronic volume depletion", fillcolor="#f5d9d9", color="#a04040"];
        W_RAAS     [label="RAAS 활성화\nRenin-angiotensin-aldosterone"];
        W_UNA      [label="요 Na⁺ <10 mmol/L\nUrinary Na — the earliest,\ncheapest depletion marker", shape=diamond, fillcolor="#e6d0ea", color="#6a3a8a"];

        W_ORAL -> W_DELIV; S_TOTSEC -> W_DELIV;
        W_DELIV -> W_JEJABS; J_NETH2O -> W_JEJABS;
        W_DELIV -> W_COLABS; K_CAP -> W_COLABS;
        W_DELIV -> W_OUTPUT; W_JEJABS -> W_OUTPUT [arrowhead=odiamond];
        W_COLABS -> W_OUTPUT [arrowhead=odiamond];
        W_JEJABS -> W_FLUIDBAL; W_COLABS -> W_FLUIDBAL;
        W_OUTPUT -> W_FLUIDBAL [arrowhead=odiamond]; W_INSENS -> W_FLUIDBAL [arrowhead=odiamond];
        W_FLUIDBAL -> W_TBW; W_FLUIDBAL -> W_URINE;
        J_JNA -> W_NABAL; K_ENAC -> W_NABAL; W_OUTPUT -> W_NABAL [arrowhead=odiamond];
        W_TBW -> W_DEHYD [arrowhead=odiamond]; W_DEHYD -> W_RAAS -> K_ALDO;
        W_DEHYD -> W_UNA; W_RAAS -> W_UNA;
    }

    /* ============================================================
       CLUSTER 15 — PN PRESCRIPTION AS A CLOSED-LOOP CONTROLLER
       ============================================================ */
    subgraph cluster_PN {
        label=<<B>15. 비경구영양 처방 = 폐쇄 루프 제어기 · PN prescription as a CLOSED-LOOP CONTROLLER</B><BR/><FONT POINT-SIZE="8">the STEPS weaning algorithm: cut PN when 24-h urine rises ≥10% above baseline</FONT>>;
        style="filled"; fillcolor="#fff2e8"; color="#a04a10"; fontsize=11;
        node [shape=hexagon, fillcolor="#fbd9bf", color="#a04a10"];

        P_DEFICIT  [label="계산된 결손\nComputed deficit\n(fluid L/d, energy kcal/d)", shape=octagon, fillcolor="#f6e3a0", color="#a08000"];
        P_PNVOL    [label="처방 PN 용적\nPRESCRIBED PN VOLUME\n(L/week) — an OUTPUT", fillcolor="#f7c49a"];
        P_PNKCAL   [label="처방 PN 열량\nPN energy (kcal/d)"];
        P_PNNA     [label="PN 나트륨·전해질\nPN sodium, K, Mg, PO4"];
        P_ILE      [label="지질 유탁액 선택\nLipid emulsion choice:\nsoybean / MCT-LCT / SMOF /\nfish-oil (Omegaven)", fillcolor="#f7c49a"];
        P_DAYSWK   [label="주당 투여 일수\nPN infusion days/week\n(cycling → 1-2 nights off)"];
        P_URINETRG [label="요량 트리거\nURINE-OUTPUT TRIGGER:\nurine ≥ 1.10 x baseline\n→ reduce PN", shape=octagon, fillcolor="#f6e3a0", color="#a08000"];
        P_WEIGHTG  [label="체중·전해질 가드레일\nWeight & electrolyte guardrails\n(block reduction if losing weight)"];
        P_TAPER    [label="감량 스텝\nTaper step\n(−10 to −20% volume,\nthen drop a day)"];
        P_HYDRSAFE [label="탈수 재상승 시 되돌림\nRe-escalate if urine falls /\nUNa <10 / weight drops"];
        P_PLACEBOART[label="위약군 반응의 정체\nTHE PLACEBO ARM RESPONSE:\nany patient with unused absorptive\nreserve is weaned BY THE ALGORITHM,\ndrug or no drug", shape=doubleoctagon, fillcolor="#f3c9c9", color="#8b1a1a", penwidth=2];

        W_FLUIDBAL -> P_DEFICIT; N_NRGBAL -> P_DEFICIT;
        P_DEFICIT -> P_PNVOL; P_DEFICIT -> P_PNKCAL; P_DEFICIT -> P_PNNA;
        W_URINE -> P_URINETRG [style=dotted, penwidth=1.4];
        P_URINETRG -> P_TAPER; P_WEIGHTG -> P_TAPER [arrowhead=odiamond];
        P_TAPER -> P_PNVOL [arrowhead=odiamond, color="#2f7f2f", penwidth=1.5];
        P_TAPER -> P_DAYSWK;
        P_HYDRSAFE -> P_PNVOL [color="#b03030"];
        W_UNA -> P_HYDRSAFE [style=dotted]; N_WEIGHT -> P_WEIGHTG [style=dotted];
        P_PNVOL -> W_FLUIDBAL [label="closes the loop", color="#2f7f2f", penwidth=1.5];
        P_PNKCAL -> N_NRGBAL [color="#2f7f2f"];
        P_URINETRG -> P_PLACEBOART [style=dashed, color="#8b1a1a"];
    }

    /* ============================================================
       CLUSTER 16 — GLP-2 ANALOGUE PHARMACOLOGY
       ============================================================ */
    subgraph cluster_GLP2PK {
        label=<<B>16. GLP-2 유사체 약리 · GLP-2 analogue pharmacology</B><BR/><FONT POINT-SIZE="8">one substitution (Ala2→Gly) buys a 20-fold half-life; that substitution IS the drug</FONT>>;
        style="filled"; fillcolor="#fff0f5"; color="#a01050"; fontsize=11;
        node [shape=hexagon, fillcolor="#fbc9dd", color="#a01050"];

        T_TEDSC    [label="테두글루타이드 SC\nTEDUGLUTIDE 0.05 mg/kg/day SC\n[Gly2]-GLP-2, DPP-4 resistant", fillcolor="#f7a8c6"];
        T_TEDPK    [label="테두글루타이드 PK\nF ≈ 88%, Tmax 3-5 h,\nt½ ≈ 2 h, Vd/F ≈ 26 L", shape=ellipse, fillcolor="#f2dbe4", color="#a01050"];
        T_APRA     [label="아프라글루타이드 SC 주 1회\nAPRAGLUTIDE weekly SC\n(albumin-binding, t½ ~30 h)"];
        T_GLEPA    [label="글레파글루타이드 SC 주 1-2회\nGLEPAGLUTIDE weekly/2x-weekly"];
        T_NATIVE   [label="천연 GLP-2 정주\nNATIVE GLP-2 infusion\nt½ 7 min — structural null:\nno sustained mucosal effect", shape=doubleoctagon, fillcolor="#f3c9c9", color="#8b1a1a", penwidth=2];
        T_OCC      [label="GLP2R 점유율\nGLP2R occupancy\n(Emax / EC50)", shape=ellipse, fillcolor="#f2dbe4", color="#a01050"];
        T_TURNOVER [label="점막 반응 turnover\nMucosal PD turnover\nτ ≈ 3-6 weeks ≫ drug t½\n→ once-daily works despite t½ 2 h", shape=octagon, fillcolor="#f6e3a0", color="#a08000"];
        T_ADA      [label="항약물항체 (ADA ~30-40%)\nAnti-drug antibodies —\nmostly non-neutralising"];
        T_CITRISE  [label="시트룰린 상승\nPlasma citrulline ↑\n(enterocyte mass biomarker)", shape=ellipse, fillcolor="#dcecdc", color="#4a7a4a"];
        T_FLUIDOL  [label="체액 과부하\nFluid overload / oedema\n(absorption improves faster\nthan PN is cut)", shape=ellipse, fillcolor="#f5d9d9", color="#a04040"];
        T_POLYP    [label="대장 폴립 성장 촉진 우려\nColorectal polyp growth —\nmandated colonoscopy surveillance", shape=ellipse, fillcolor="#f5d9d9", color="#a04040"];
        T_STOMAENL [label="장루 부종·확장\nStoma enlargement,\nabdominal distension"];
        T_BILIARY  [label="담도·췌 질환\nBiliary and pancreatic events\n(surveillance required)", shape=ellipse, fillcolor="#f5d9d9", color="#a04040"];
        T_GATED    [label="경구 섭취 없으면 효과 없음\nEFFECT IS GATED BY LUMINAL NUTRIENT\n(product, not sum)", shape=doubleoctagon, fillcolor="#cfe8cf", color="#1a6b1a", penwidth=2];

        T_TEDSC -> T_TEDPK -> T_OCC; T_APRA -> T_OCC; T_GLEPA -> T_OCC;
        T_NATIVE -> T_OCC [label="transient only", style=dashed, color="#8b1a1a"];
        L_DPP4 -> T_NATIVE [label="cleaves", color="#b03030"];
        L_DPP4 -> T_TEDPK [arrowhead=odiamond, style=dashed, label="resistant"];
        T_OCC -> L_GLP2R; T_OCC -> T_TURNOVER -> D_TROPHIC [color="#2f7f2f", penwidth=1.5];
        T_ADA -> T_OCC [arrowhead=odiamond, style=dashed];
        D_MUCMASS -> T_CITRISE;
        T_OCC -> T_FLUIDOL; T_OCC -> T_POLYP; T_OCC -> T_STOMAENL; T_OCC -> T_BILIARY;
        T_GATED -> T_TURNOVER [arrowhead=odiamond, color="#1a6b1a"];
        D_LUMNUT -> T_GATED [style=dashed, color="#1a6b1a"];
    }

    /* ============================================================
       CLUSTER 17 — ADJUNCTIVE PHARMACOTHERAPY
       ============================================================ */
    subgraph cluster_DRUG {
        label=<<B>17. 보조 약물요법 · Adjunctive pharmacotherapy</B><BR/><FONT POINT-SIZE="8">each drug changes ONE term of the balance — and two of them change it the wrong way</FONT>>;
        style="filled"; fillcolor="#fdf0e0"; color="#8a5a10"; fontsize=11;
        node [shape=hexagon, fillcolor="#f8dfb8", color="#8a5a10"];

        R_LOP      [label="로페라마이드 4-16 mg/d\nLOPERAMIDE (μ-agonist,\nP-gp limited CNS entry)"];
        R_COD      [label="코데인 인산염 30-60 mg\nCODEINE phosphate"];
        R_OPIUM    [label="아편 팅크\nTincture of opium\n(refractory high output)"];
        R_PPI      [label="PPI / H2 차단제 고용량\nHigh-dose PPI\n→ gastric secretion ↓ 1-2 L/d"];
        R_OCT      [label="옥트레오타이드 SC/LAR\nOCTREOTIDE — output ↓\nBUT suppresses IGF-1 and\nMAY IMPAIR ADAPTATION", fillcolor="#f5c9a0"];
        R_GH       [label="소마트로핀 0.1 mg/kg/d x 4주\nrhGH (Zorbtive) + glutamine\n— modest, transient"];
        R_CHOL     [label="콜레스티라민 4 g\nCHOLESTYRAMINE"];
        R_RIFAX    [label="리팍시민 550 mg bid\nRIFAXIMIN (SIBO)"];
        R_ORS      [label="경구 재수화 용액\nORS (Na 90-120 mmol/L\n+ glucose)", fillcolor="#c9e8d0"];
        R_CLON     [label="클로니딘 경피\nCLONIDINE (α2, secretion ↓)"];
        R_CHOLINE  [label="콜린·타우린 보충\nCholine / taurine supplementation"];
        R_ABXLOCK  [label="에탄올 · 타우롤리딘 잠금\nEthanol / taurolidine\ncatheter lock"];
        R_CITRATE  [label="구연산칼륨 · 저옥살산 식이\nPotassium citrate,\nlow-oxalate diet, Ca with meals"];
        R_AKI      [label="탈수성 신손상\n(context node) Volume-depletion AKI", shape=ellipse, fillcolor="#f5d9d9", color="#a04040"];
        R_OCTTRAP  [label="옥트레오타이드의 대가\nOCTREOTIDE TRADE-OFF:\noutput ↓ now, adaptation ↓ later\n— net benefit is time-dependent", shape=doubleoctagon, fillcolor="#f3c9c9", color="#8b1a1a", penwidth=2];

        R_LOP -> M_MU; R_COD -> M_MU; R_OPIUM -> M_MU;
        R_PPI -> S_GASTRIC [arrowhead=odiamond, color="#2f7f2f"];
        R_PPI -> G_ACIDGONE [color="#b03030", label="the cost"];
        R_OCT -> S_TOTSEC [arrowhead=odiamond, color="#2f7f2f"];
        R_OCT -> R_OCTTRAP; R_OCTTRAP -> D_IGF1SYS [arrowhead=odiamond, color="#8b1a1a"];
        R_OCT -> M_TRANSIT [label="prolongs"];
        R_GH -> D_IGF1SYS [color="#2f7f2f"]; R_GH -> W_TBW [label="Na retention"];
        R_CHOL -> B_SEQTRAP; R_CHOL -> B_BAD [arrowhead=odiamond, color="#2f7f2f"];
        R_RIFAX -> G_SIBO [arrowhead=odiamond, color="#2f7f2f"];
        R_ORS -> J_ORSFIX [color="#2f7f2f", penwidth=1.5];
        R_CLON -> S_JEJSEC [arrowhead=odiamond];
        R_CITRATE -> R_OXAL [arrowhead=odiamond, color="#2f7f2f"];
        R_GLUTS     [label="글루타민 보충 (경구)\nGlutamine supplementation\n— little effect alone"];
        R_GLUTS -> D_GLUT;
        R_OXAL      [label="(context) 요 옥살산\nUrinary oxalate", shape=ellipse, fillcolor="#f5d9d9", color="#a04040"];
    }

    /* ============================================================
       CLUSTER 18 — IFALD
       ============================================================ */
    subgraph cluster_IFALD {
        label=<<B>18. 장부전 관련 간질환 (IFALD) · Intestinal failure-associated liver disease</B><BR/><FONT POINT-SIZE="8">the lipid emulsion is the dose; changing the oil changes the disease</FONT>>;
        style="filled"; fillcolor="#f2f7ea"; color="#5a7a20"; fontsize=11;
        node [shape=ellipse, fillcolor="#e0ecc9", color="#5a7a20"];

        I_PHYTO    [label="식물스테롤 부하\nPHYTOSTEROL load\n(soybean ILE ~350 µg/mL;\nSMOF lower; fish-oil ≈ 0)", fillcolor="#f5d9d9", color="#a04040"];
        I_FXRANT   [label="식물스테롤 = FXR 길항\nPhytosterols antagonise\nhepatic FXR → BSEP ↓", fillcolor="#f5d9d9", color="#a04040"];
        I_CHOLINE  [label="콜린 결핍\nCholine deficiency\n(PN lacks choline)", fillcolor="#f5d9d9", color="#a04040"];
        I_NOENT    [label="경장 자극 부재\nAbsence of enteral stimulation\n→ biliary stasis, ↓ CCK", fillcolor="#f5d9d9", color="#a04040"];
        I_OVERFEED [label="과다 포도당·지질 공급\nGlucose / lipid overfeeding\n→ de novo lipogenesis"];
        I_STEATO   [label="간 지방증\nHepatic steatosis"];
        I_CHOLEST  [label="담즙정체\nCholestasis (conjugated\nbilirubin, GGT, ALP ↑)", fillcolor="#f5d9d9", color="#a04040"];
        H_INFLAM   [label="간 염증 (Kupffer, TLR4)\nHepatic inflammation"];
        I_FIB      [label="간 섬유화 → 담즙성 간경변\nPortal fibrosis → biliary cirrhosis", fillcolor="#f5d9d9", color="#a04040"];
        I_PHTN     [label="문맥압 상승·비장비대·혈소판↓\nPortal hypertension"];
        I_BILI     [label="총 빌리루빈\nTotal bilirubin (mg/dL)", shape=diamond, fillcolor="#e6d0ea", color="#6a3a8a"];
        I_FISHOIL  [label="어유 기반 유탁액\nFISH-OIL ILE: phytosterol → 0,\nω3 anti-inflammatory\n→ cholestasis reverses", shape=doubleoctagon, fillcolor="#cfe8cf", color="#1a6b1a", penwidth=2];
        I_LIPIDMIN [label="지질 최소화 (≤1 g/kg/wk)\nLipid minimisation strategy"];
        I_EFAD     [label="필수지방산 결핍 위험\nEssential fatty acid deficiency\n(the cost of lipid minimisation)", fillcolor="#f5d9d9", color="#a04040"];

        P_ILE -> I_PHYTO; I_PHYTO -> I_FXRANT -> I_CHOLEST;
        I_CHOLINE -> I_STEATO; I_NOENT -> I_CHOLEST; I_OVERFEED -> I_STEATO;
        I_STEATO -> H_INFLAM -> I_FIB; I_CHOLEST -> H_INFLAM;
        I_FIB -> I_PHTN; I_CHOLEST -> I_BILI;
        I_FISHOIL -> I_PHYTO [arrowhead=odiamond, color="#1a6b1a", penwidth=1.6];
        I_FISHOIL -> H_INFLAM [arrowhead=odiamond, color="#1a6b1a"];
        I_LIPIDMIN -> I_PHYTO [arrowhead=odiamond]; I_LIPIDMIN -> I_EFAD [color="#b03030"];
        D_LUMNUT -> I_NOENT [arrowhead=odiamond, color="#2f7f2f"];
        G_ENDOTOX -> H_INFLAM;
    }

    /* ============================================================
       CLUSTER 19 — CENTRAL VENOUS ACCESS: THE CONSUMABLE RESOURCE
       ============================================================ */
    subgraph cluster_CVC {
        label=<<B>19. 중심정맥 접근로 = 소모성 자원 · Central venous access as a CONSUMABLE resource</B><BR/><FONT POINT-SIZE="8">there are only so many veins; running out of them is what forces transplantation</FONT>>;
        style="filled"; fillcolor="#f7f0f0"; color="#8a2020"; fontsize=11;
        node [shape=ellipse, fillcolor="#f0d5d5", color="#8a2020"];

        V_CATHDAY  [label="누적 카테터 일수\nCumulative catheter-days", fillcolor="#e6bcbc"];
        V_CRBSI    [label="카테터 관련 혈류감염 CRBSI\n~0.5-2 episodes /\n1000 catheter-days", fillcolor="#e6bcbc"];
        V_ORG      [label="원인균\nCoNS · S. aureus · Candida ·\nenteric Gram-negatives\n(translocation)"];
        V_SEPSIS   [label="패혈증 · 입원\nSepsis, hospitalisation", shape=diamond, fillcolor="#e6d0ea", color="#6a3a8a"];
        V_THROMB   [label="중심정맥 혈전\nCatheter-related thrombosis"];
        V_STENOS   [label="정맥 협착·폐색\nVenous stenosis / occlusion"];
        V_ACCESS   [label="사용 가능 정맥 수\nPatent central veins remaining\n(6 → 0)", fillcolor="#e6bcbc"];
        V_ACCLOSS  [label="접근로 소실\nLOSS OF VENOUS ACCESS\n— an indication for transplant", shape=diamond, fillcolor="#e6d0ea", color="#6a3a8a"];
        V_MECH     [label="기계적 합병증\nOcclusion, breakage,\ndislodgement"];
        V_TECHNIQUE[label="무균 술기·전용 팀\nAseptic technique,\ndedicated HPN team\n(largest single risk modifier)", shape=ellipse, fillcolor="#dcecdc", color="#4a7a4a"];
        V_CYCLE    [label="주간 이탈 (cycling)\nCatheter-free interval"];

        P_PNVOL -> V_CATHDAY; P_DAYSWK -> V_CATHDAY;
        V_CATHDAY -> V_CRBSI; V_CRBSI -> V_ORG; V_CRBSI -> V_SEPSIS;
        V_CRBSI -> V_THROMB -> V_STENOS -> V_ACCESS [arrowhead=odiamond];
        V_ACCESS -> V_ACCLOSS [arrowhead=odiamond];
        V_TECHNIQUE -> V_CRBSI [arrowhead=odiamond, color="#2f7f2f", penwidth=1.4];
        V_CYCLE -> V_CRBSI [arrowhead=odiamond, color="#2f7f2f"];
        V_MECH -> V_ACCESS [arrowhead=odiamond];
        G_ENDOTOX -> V_ORG [label="gut-origin\norganisms", style=dashed];
        V_SEPSIS -> H_INFLAM [color="#b03030", label="each episode\nadvances IFALD"];
    }

    /* ============================================================
       CLUSTER 20 — RENAL, STONE AND BONE COMPLICATIONS
       ============================================================ */
    subgraph cluster_RENAL {
        label=<<B>20. 신장 · 결석 · 골 합병증 · Renal, stone and metabolic bone disease</B><BR/><FONT POINT-SIZE="8">enteric hyperoxaluria REQUIRES a colon; end-jejunostomy patients get dehydration stones instead</FONT>>;
        style="filled"; fillcolor="#eef2f8"; color="#3a4a8a"; fontsize=11;
        node [shape=ellipse, fillcolor="#d5ddf0", color="#3a4a8a"];

        Y_FATFA    [label="흡수되지 않은 지방산\nUnabsorbed fatty acids\nbind luminal Ca²⁺"];
        Y_FREEOX   [label="유리 옥살산\nFree (unbound) oxalate"];
        Y_COLPERM  [label="대장 옥살산 투과성 ↑\nColonic oxalate permeability ↑\n(bile acids & FA injure mucosa)"];
        Y_HYPEROX  [label="장성 고옥살산뇨\nENTERIC HYPEROXALURIA\n(needs a colon!)", fillcolor="#f5d9d9", color="#a04040"];
        Y_STONE    [label="칼슘옥살산 결석 · 신결석증\nCalcium oxalate nephrolithiasis", shape=diamond, fillcolor="#e6d0ea", color="#6a3a8a"];
        Y_OXALNEPH [label="옥살산 신병증\nOxalate nephropathy → CKD", fillcolor="#f5d9d9", color="#a04040"];
        Y_DEHYDST  [label="농축뇨·구연산↓ 결석\n(말단 공장루형)\nDehydration / low-citrate stones"];
        Y_CKD      [label="만성 신질환\nCKD (up to ~40% of long-term HPN)", shape=diamond, fillcolor="#e6d0ea", color="#6a3a8a"];
        Y_MGLOSS   [label="마그네슘 소실 (회장 의존적)\nMagnesium depletion", fillcolor="#f5d9d9", color="#a04040"];
        Y_PTHRES   [label="Mg 결핍성 PTH 저항·분비장애\nMg deficiency → impaired PTH\nsecretion AND end-organ resistance"];
        Y_HYPOCA   [label="저칼슘혈증\nHypocalcaemia\n— refractory until Mg replaced", shape=doubleoctagon, fillcolor="#f3c9c9", color="#8b1a1a", penwidth=2];
        Y_VITD     [label="비타민 D 결핍 (지용성)\n25-OH vitamin D deficiency"];
        Y_ACIDOSIS [label="만성 대사성 산증\nChronic metabolic acidosis\n(bicarbonate loss)"];
        Y_MBD      [label="대사성 골질환\nMetabolic bone disease:\nosteomalacia + osteoporosis", shape=diamond, fillcolor="#e6d0ea", color="#6a3a8a"];
        Y_ALUM     [label="PN 알루미늄 오염\nAluminium contamination of PN"];
        Y_BMD      [label="골밀도 T-score\nBone mineral density", shape=diamond, fillcolor="#e6d0ea", color="#6a3a8a"];

        C_FRACFAT -> Y_FATFA [arrowhead=odiamond]; Y_FATFA -> Y_FREEOX;
        B_LOSS -> Y_COLPERM; Y_FATFA -> Y_COLPERM;
        Y_FREEOX -> Y_HYPEROX; Y_COLPERM -> Y_HYPEROX; A_COLON -> Y_HYPEROX [label="requires colon", style=dashed];
        Y_HYPEROX -> R_OXAL; R_OXAL -> Y_STONE; Y_HYPEROX -> Y_OXALNEPH -> Y_CKD;
        W_DEHYD -> Y_DEHYDST -> Y_STONE; W_DEHYD -> Y_CKD; R_AKI -> Y_CKD;
        Y_MGLOSS -> Y_PTHRES -> Y_HYPOCA;
        F_MGAB -> Y_MGLOSS [arrowhead=odiamond];
        Y_VITD -> F_CAAB [arrowhead=odiamond]; C_FRACFAT -> Y_VITD;
        Y_VITD -> Y_MBD; Y_ACIDOSIS -> Y_MBD; Y_ALUM -> Y_MBD; Y_HYPOCA -> Y_MBD;
        Y_MBD -> Y_BMD [arrowhead=odiamond];
        Y_ACIDOSIS -> Y_STONE [label="citrate ↓"];
    }

    /* ============================================================
       CLUSTER 21 — MICRONUTRIENT DEFICITS
       ============================================================ */
    subgraph cluster_MICRO2 {
        label=<<B>21. 미량영양소 결핍 · Micronutrient deficits — site-specific, not generic</B><BR/><FONT POINT-SIZE="8">each deficiency maps to a named resected segment or a named stool loss</FONT>>;
        style="filled"; fillcolor="#f7f4ec"; color="#7a6a20"; fontsize=11;
        node [shape=ellipse, fillcolor="#eee7cd", color="#7a6a20"];

        X_B12      [label="비타민 B12 (말단 회장 전용)\nVitamin B12 — terminal ileum ONLY\n→ SC/IM replacement obligatory"];
        X_FOLATE   [label="엽산 (공장)\nFolate — jejunal"];
        X_IRON     [label="철 (십이지장·상부 공장)\nIron — duodenum/proximal jejunum"];
        X_ZN       [label="아연 (변·장루 손실 ~12 mg/L)\nZinc — lost in output"];
        X_SE       [label="셀레늄 (심근·갑상선)\nSelenium — cardiomyopathy risk"];
        X_CU       [label="구리 (담즙 배출·장루 손실)\nCopper"];
        X_VITA     [label="비타민 A (야맹증)\nVitamin A"];
        X_VITE     [label="비타민 E (신경병증)\nVitamin E"];
        X_VITK     [label="비타민 K (응고·골)\nVitamin K"];
        X_THIAM    [label="티아민 (Wernicke 위험)\nThiamine — days of reserve only", fillcolor="#f5d9d9", color="#a04040"];
        X_EFA      [label="필수지방산 (linoleic·α-linolenic)\nEssential fatty acids"];
        X_CARNIT   [label="카르니틴\nCarnitine"];
        X_ANEMIA   [label="빈혈 (B12·엽산·철 복합)\nAnaemia", shape=diamond, fillcolor="#e6d0ea", color="#6a3a8a"];
        X_NEURO    [label="신경학적 결손 (B12·E·구리·티아민)\nNeurological deficits", shape=diamond, fillcolor="#e6d0ea", color="#6a3a8a"];

        A_ILEUM -> X_B12 [arrowhead=odiamond]; G_B12CONS -> X_B12 [arrowhead=odiamond];
        C_FRACFAT -> X_VITA [arrowhead=odiamond]; C_FRACFAT -> X_VITE [arrowhead=odiamond];
        C_FRACFAT -> X_VITK [arrowhead=odiamond]; C_FRACFAT -> Y_VITD [arrowhead=odiamond];
        W_OUTPUT -> X_ZN [arrowhead=odiamond, label="12 mg per L"];
        W_OUTPUT -> Y_MGLOSS [label="Mg lost in output"];
        I_LIPIDMIN -> X_EFA [arrowhead=odiamond];
        X_B12 -> X_ANEMIA [arrowhead=odiamond]; X_FOLATE -> X_ANEMIA [arrowhead=odiamond];
        X_IRON -> X_ANEMIA [arrowhead=odiamond];
        X_B12 -> X_NEURO [arrowhead=odiamond]; X_VITE -> X_NEURO [arrowhead=odiamond];
        X_CU -> X_NEURO [arrowhead=odiamond]; X_THIAM -> X_NEURO [arrowhead=odiamond];
        X_ZN -> D_CRYPT [label="Zn required for\ncrypt mitosis", style=dashed];
        X_CARNIT -> I_STEATO [arrowhead=odiamond, style=dashed];
    }

    /* ============================================================
       CLUSTER 22 — CLINICAL ENDPOINTS
       ============================================================ */
    subgraph cluster_ENDP {
        label=<<B>22. 임상 엔드포인트 · Clinical endpoints</B><BR/><FONT POINT-SIZE="8">the registered endpoint (≥20% PN volume reduction) is a property of the weaning algorithm, not of a score</FONT>>;
        style="filled"; fillcolor="#f5f0f8"; color="#5a2a8a"; fontsize=11;
        node [shape=diamond, fillcolor="#e6d0ea", color="#5a2a8a"];

        Z_PNVOL    [label="주간 PN 용적 (L/주)\nWeekly PN volume", fillcolor="#d5b8e0"];
        Z_RESP20   [label="≥20% PN 용적 감소 반응자\n≥20% PN volume reduction\n(STEPS primary endpoint)", fillcolor="#d5b8e0"];
        Z_DAYSOFF  [label="PN 없는 날 수 (주당)\nDays per week off PN"];
        Z_AUTON    [label="장 자율성 (PN 완전 이탈)\nENTERAL AUTONOMY", fillcolor="#c9a8d8"];
        Z_OUTPUT   [label="배출량 (L/일)\nStool / stoma output"];
        Z_CITR     [label="혈장 시트룰린 (µmol/L)\nPlasma citrulline\n<20 predicts PN dependence"];
        Z_WT       [label="체중·BMI\nBody weight, BMI"];
        Z_QOL      [label="삶의 질 (SBS-QoL)\nQuality of life"];
        Z_INFEC    [label="연간 CRBSI 발생률\nCRBSI episodes/year"];
        Z_LIVER    [label="간기능 (빌리루빈·섬유화)\nLiver: bilirubin, fibrosis stage"];
        Z_SURV     [label="생존 (5년 HPN 생존 ~70-80%)\nSurvival on HPN", fillcolor="#c9a8d8"];
        Z_TX       [label="장 이식 (or 간-장 동시)\nIntestinal / combined\nliver-intestine transplant", fillcolor="#c9a8d8"];
        Z_TXFREE   [label="이식 없는 생존\nTransplant-free survival"];
        Z_HOSP     [label="입원 일수\nHospital days per year"];

        P_PNVOL -> Z_PNVOL; Z_PNVOL -> Z_RESP20; P_DAYSWK -> Z_DAYSOFF;
        Z_DAYSOFF -> Z_AUTON; Z_PNVOL -> Z_AUTON [arrowhead=odiamond];
        W_OUTPUT -> Z_OUTPUT; D_MUCMASS -> Z_CITR; N_WEIGHT -> Z_WT;
        Z_PNVOL -> Z_QOL [arrowhead=odiamond]; Z_AUTON -> Z_QOL;
        V_CRBSI -> Z_INFEC; I_BILI -> Z_LIVER; I_FIB -> Z_LIVER;
        Z_LIVER -> Z_TX [color="#b03030"]; Z_LIVER -> Z_SURV [arrowhead=odiamond];
        Z_INFEC -> Z_SURV [arrowhead=odiamond]; Z_INFEC -> Z_HOSP;
        Z_TX -> Z_TXFREE [arrowhead=odiamond]; Z_SURV -> Z_TXFREE;
        Y_CKD -> Z_SURV [arrowhead=odiamond]; Y_BMD -> Z_QOL [arrowhead=odiamond];
        G_ENCEPH -> Z_QOL [arrowhead=odiamond]; X_ANEMIA -> Z_QOL [arrowhead=odiamond];
        A_TYPE1 -> Z_AUTON [arrowhead=odiamond, style=dashed, label="anatomical floor:\nno drug crosses it"];
    }


    /* ============================================================
       CROSS-CLUSTER EDGES
       Declared here, after every cluster, so that each node is claimed
       by the cluster that DEFINES it rather than by whichever cluster
       happens to mention it first.
       ============================================================ */
    L_GHRELIN  -> N_HYPERPH  [label="hyperphagia drive", style=dashed];
    G_ENDOTOX  -> H_INFLAM   [color="#b03030"];
    W_DEHYD    -> R_AKI      [color="#b03030"];
    P_ILE      -> I_PHYTO    [label="the lipid emulsion\nIS the dose"];
    T_CITRISE  -> Z_CITR     [style=dotted];
    R_CHOLINE  -> I_CHOLINE  [arrowhead=odiamond, color="#2f7f2f"];
    R_ABXLOCK  -> V_CRBSI    [arrowhead=odiamond, color="#2f7f2f", penwidth=1.5];
    I_PHTN     -> Z_SURV     [color="#b03030"];
    V_ACCLOSS  -> Z_TX       [color="#b03030", penwidth=1.5];
    X_SE       -> Z_SURV     [style=dashed];

    /* ============================================================
       THE SELF-SUSTAINING POSITIVE FEEDBACK LOOP (drawn in bold red)
       ============================================================ */
    edge [color="#c01818", penwidth=2.2, arrowsize=0.9, fontcolor="#c01818"];
    L_BLUNTED -> M_BRAKE  [label="1. no ileal brake", arrowhead=odiamond];
    M_BRAKE   -> M_TRANSIT [label="2. transit accelerates", arrowhead=odiamond];
    M_TRANSIT -> C_CONTACT [label="3. contact time falls", arrowhead=odiamond];
    C_CONTACT -> C_DAMK    [label="4. Da falls"];
    C_DAMK    -> W_OUTPUT  [label="5. output rises"];
    W_OUTPUT  -> L_MASS    [label="6. unabsorbed load bypasses\nthe L-cells that are gone", arrowhead=odiamond, style=dashed];

    /* ============================================================
       LEGEND
       ============================================================ */
    subgraph cluster_LEGEND {
        label=<<B>범례 · Legend</B>>;
        style="filled"; fillcolor="#fafafa"; color="#999999"; fontsize=11;
        node [fontsize=8];
        LG1 [shape=box, fillcolor="#cfe0ef", color="#3f6d99", label="해부·파라미터\nanatomy / parameter\n(not a state)"];
        LG2 [shape=ellipse, fillcolor="#e8e8e8", color="#666666", label="생리적 flux·pool\nphysiological flux / pool"];
        LG3 [shape=ellipse, fillcolor="#dcecdc", color="#4a7a4a", label="적응·보호\nadaptive / protective"];
        LG4 [shape=ellipse, fillcolor="#f5d9d9", color="#a04040", label="부적응·손상\nmaladaptive / injurious"];
        LG5 [shape=hexagon, fillcolor="#fbd9bf", color="#a04a10", label="약물·처방 입력\ndrug / prescribed input"];
        LG6 [shape=diamond, fillcolor="#e6d0ea", color="#6a3a8a", label="임상 엔드포인트\nclinical endpoint"];
        LG7 [shape=octagon, fillcolor="#f6e3a0", color="#a08000", label="보존 방정식 노드\nconservation-equation node"];
        LG8 [shape=doubleoctagon, fillcolor="#f3c9c9", color="#8b1a1a", label="구조적 null / 함정\nstructural null or trap\n(effect must be ZERO or REVERSE)"];
        LG9 [shape=plaintext, fillcolor="#fafafa", label="굵은 빨강 화살표 = 자기지속 양성 피드백\nbold red = self-sustaining\npositive feedback loop"];
        LG1 -> LG2 -> LG3 -> LG4 [style=invis];
        LG5 -> LG6 -> LG7 -> LG8 -> LG9 [style=invis];
    }
}
