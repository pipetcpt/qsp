digraph Lpa_QSP_Model {
  graph [
    label=<<B>Elevated Lipoprotein(a) — QSP Mechanistic Map</B><BR/><FONT POINT-SIZE="14">ONE particle, made at ONE rate-limiting step, acting through THREE effector arms, read on TWO non-interchangeable scales.<BR/>Every pathogenic payload (1 apoB-100 · ~1 OxPL on KIV-10 · 1 strong lysine-binding site · a fixed cholesterol core) is present ONCE PER PARTICLE.<BR/>The only thing that varies with isoform size is apo(a) kringle protein mass — which is pathogenically inert. That single asymmetry is why nmol/L and mg/dL disagree exactly where it matters.</FONT>>
    labelloc=t fontsize=22 fontname="Helvetica"
    rankdir=LR bgcolor="#F7F8FA"
    splines=spline nodesep=0.30 ranksep=1.00
    newrank=true
    compound=true concentrate=false
  ]
  node [fontname="Helvetica" fontsize=10 style="filled,rounded" shape=box margin="0.14,0.05"]
  edge [fontname="Helvetica" fontsize=8 arrowsize=0.65 color="#5A6270"]

  //=========================================================
  // CLUSTER 1 : The LPA locus — variance is set before birth
  //=========================================================
  subgraph cluster_gene {
    label="🧬 1. LPA locus (6q25.3-q26) — 70-90% of plasma variance is genetic and fixed at conception"
    style=filled fillcolor="#EDE7F6" color="#4527A0" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    G_locus   [label="LPA gene · 6q25.3-q26\nplasminogen (PLG) paralogue\narisen by duplication ~40 Mya\n(Old World monkeys + hedgehog only)" fillcolor="#D1C4E9" color="#311B92"]
    G_kiv2    [label="★ KIV-2 copy-number variant\n1 to >40 repeats per allele\nINVERSELY sets plasma Lp(a)\n(explains 30-70% of variance)" fillcolor="#B39DDB" color="#311B92" penwidth=2]
    G_alleles [label="Two alleles co-expressed\nsmaller isoform usually dominates\n(≈ 2/3 of carriers)" fillcolor="#D1C4E9" color="#311B92"]
    G_penta   [label="Pentanucleotide (TTTTA)n repeat\npromoter -1373\n↑ n → ↓ transcription" fillcolor="#D1C4E9" color="#311B92"]
    G_rs104   [label="rs10455872 (intron 25)\nOR ≈ 1.7 for CHD\ntags small isoform + high Lp(a)" fillcolor="#D1C4E9" color="#311B92"]
    G_rs379   [label="rs3798220 (I4399M, protease dom.)\nhigh Lp(a) · aspirin-interaction\nsignal (WHS)" fillcolor="#D1C4E9" color="#311B92"]
    G_null    [label="LPA null / KIV-2 splice LoF\nLp(a) ≈ 0 nmol/L\n★ NO disease phenotype\n→ target is safely druggable" fillcolor="#C5E1A5" color="#33691E" penwidth=2]
    G_anc     [label="Ancestry\nAfrican ≈ 2-3x median of European\nSouth Asian intermediate\n(risk per nmol/L broadly similar)" fillcolor="#D1C4E9" color="#311B92"]
    G_il6re   [label="IL-6 response element\nin LPA promoter\n★ makes Lp(a) a mild\nacute-phase reactant" fillcolor="#FFCC80" color="#E65100" penwidth=2]
    G_sterol  [label="Sterol / SREBP-2 responsive\nelements (contested)\n→ statins ↑ LPA transcription" fillcolor="#FFCC80" color="#E65100"]
    G_farnx   [label="FXR · HNF-1α · HNF-4α\nhepatocyte-restricted expression" fillcolor="#D1C4E9" color="#311B92"]
  }

  //=========================================================
  // CLUSTER 2 : Hepatocyte — the ONE rate-limiting step
  //=========================================================
  subgraph cluster_hep {
    label="🏭 2. Hepatocyte apo(a) biosynthesis — the RATE-LIMITING step (Lp(a) is a production-controlled, not clearance-controlled, lipoprotein)"
    style=filled fillcolor="#E3F2FD" color="#0D47A1" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    H_tx      [label="LPA transcription  TRANS\n= KTX · f(IL6) · f(statin) · f(thyroid)\n· f(sex steroid) · f(nephrosis)" fillcolor="#BBDEFB" color="#0D47A1"]
    H_mrna    [label="apo(a) mRNA\n(state variable MRNA)" fillcolor="#90CAF9" color="#0D47A1" penwidth=2]
    H_tl      [label="Translation on rough ER\nvery large single polypeptide\n(4529 aa at 22 KIV-2 repeats)" fillcolor="#BBDEFB" color="#0D47A1"]
    H_fold    [label="★ ER folding of ~32 kringles\nresidence time ∝ isoform size\n(hours for large isoforms)" fillcolor="#64B5F6" color="#0D47A1" penwidth=2]
    H_glyc    [label="N- and O-glycosylation\n(~28% of mass is carbohydrate)" fillcolor="#BBDEFB" color="#0D47A1"]
    H_erad    [label="★ Presecretory proteasomal\ndegradation (ERAD)\nLARGE isoforms degraded more\n→ SECRETION EFFICIENCY ↓↓" fillcolor="#64B5F6" color="#0D47A1" penwidth=2]
    H_erpool  [label="Intracellular apo(a) pool\n(state APOA_ER)" fillcolor="#BBDEFB" color="#0D47A1"]
    H_sec     [label="Secretion flux SEC\n= KSEC · SECEFF(NKIV2) · APOA_ER\n★ where the 10-fold spread comes from" fillcolor="#42A5F5" color="#0D47A1" fontcolor="white" penwidth=2]
    H_apob    [label="apoB-100 synthesis\n(MTP-dependent, shared with VLDL)" fillcolor="#BBDEFB" color="#0D47A1"]
  }

  //=========================================================
  // CLUSTER 3 : Two-step assembly — a separate druggable node
  //=========================================================
  subgraph cluster_assy {
    label="🔗 3. Two-step particle assembly (extracellular / hepatocyte surface) — a SECOND, independent druggable node"
    style=filled fillcolor="#E0F7FA" color="#006064" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    A_free    [label="Free plasma apo(a)\n(state APOA_FREE ≈ 1% of Lp(a))\n★ RISES when assembly is blocked\n— the assay tell-tale" fillcolor="#80DEEA" color="#006064" penwidth=2]
    A_step1   [label="STEP 1 — non-covalent docking\nlysine-binding sites of KIV-7 / KIV-8\n→ Lys residues of apoB-100\n(weak, reversible, rate-setting)" fillcolor="#B2EBF2" color="#006064"]
    A_step2   [label="STEP 2 — covalent capture\ndisulfide Cys4057 apo(a) KIV-9\n↔ Cys4326 apoB-100\n(irreversible, fast)" fillcolor="#B2EBF2" color="#006064"]
    A_ldlsub  [label="LDL / small-dense-LDL substrate\napoB-100 particle supply\n(assembly is substrate-dependent)" fillcolor="#B2EBF2" color="#006064"]
    A_intact  [label="★ INTACT Lp(a) PARTICLE\napo(a)₁ · apoB-100₁ · lipid core\n(state LPA_P, nmol/L)" fillcolor="#26C6DA" color="#006064" fontcolor="white" penwidth=3]
    A_frag    [label="apo(a) fragmentation\n(elastase / MMP)\n→ urinary apo(a) fragments\n(a real clearance route)" fillcolor="#B2EBF2" color="#006064"]
  }

  //=========================================================
  // CLUSTER 4 : Catabolism — only ~1/4 is LDLR-dependent
  //=========================================================
  subgraph cluster_cat {
    label="♻️ 4. Catabolism — FCR ≈ 0.25 pools/day and essentially INVARIANT across levels; only ~24% is LDL-receptor dependent"
    style=filled fillcolor="#F1F8E9" color="#33691E" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    C_ldlr    [label="Hepatic LDL receptor  LDLR\n(state; drives 86% of LDL clearance\nbut only ~24% of Lp(a) clearance)" fillcolor="#C5E1A5" color="#33691E" penwidth=2]
    C_pcsk9   [label="Plasma PCSK9\n→ LDLR lysosomal degradation" fillcolor="#DCEDC8" color="#33691E"]
    C_asgr    [label="ASGR1 (asialoglycoprotein receptor)\nASGR1 LoF carriers: ↓ non-HDL, ↓ CAD\n— also the GalNAc drug portal" fillcolor="#DCEDC8" color="#33691E"]
    C_srb1    [label="SR-B1 (SCARB1)\nselective lipid uptake" fillcolor="#DCEDC8" color="#33691E"]
    C_plgr    [label="Plasminogen receptors\nPlgRKT · annexin A2 · enolase\n(apo(a) is a PLG homologue)" fillcolor="#DCEDC8" color="#33691E"]
    C_lrp1    [label="LRP1 · CD36 · TLR2\nmacrophage / hepatic uptake" fillcolor="#DCEDC8" color="#33691E"]
    C_kid     [label="Renal handling\nmegalin-mediated · apo(a) fragments\n(CKD/ESRD → Lp(a) ↑, large isoforms)" fillcolor="#DCEDC8" color="#33691E"]
    C_fcr     [label="★ FCR ≈ 0.25 /day is CONSTANT\nacross 10-fold Lp(a) range\n→ variance is ALL production\n(Rader / Frischmann kinetic studies)" fillcolor="#AED581" color="#33691E" penwidth=2]
  }

  //=========================================================
  // CLUSTER 5 : Measurement — where the field loses patients
  //=========================================================
  subgraph cluster_meas {
    label="📏 5. Measurement — the two scales are NOT interchangeable, and the error is largest in exactly the highest-risk patients"
    style=filled fillcolor="#FFF8E1" color="#FF6F00" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    M_molar   [label="★ MOLAR assay  nmol/L\nmonoclonal (a-4) to a SINGLE\nepitope present ONCE per particle\n→ counts PARTICLES, isoform-insensitive" fillcolor="#FFE082" color="#FF6F00" penwidth=2]
    M_mass    [label="MASS assay  mg/dL\nweighs particle + variable\napo(a) kringle protein" fillcolor="#FFECB3" color="#FF6F00"]
    M_mw      [label="Particle MW\n= 3.30 MDa (core+apoB, INERT-varying)\n+ 14 kDa x (NKIV2+10) + 35 kDa\n→ conversion 2.52-2.75 nmol/L per mg/dL" fillcolor="#FFECB3" color="#FF6F00"]
    M_bias    [label="★ ANALYTICAL isoform bias\npolyclonal anti-apo(a) sees repeated\nKIV-2 epitopes → signal ∝ (NKIV2+10)\nsmall isoform read at 0.69x TRUE" fillcolor="#FFCA28" color="#E65100" penwidth=2]
    M_calib   [label="Single-isoform calibrator\n(historic, ~22 KIV-2)\nWHO/IFCC SRM 2B reference" fillcolor="#FFECB3" color="#FF6F00"]
    M_thresh  [label="Guideline thresholds\n≥125 nmol/L  /  ≥50 mg/dL  (risk)\n≥180 nmol/L / ≥70 mg/dL (very high)\n— the PAIR is internally inconsistent" fillcolor="#FFECB3" color="#FF6F00"]
    M_miss    [label="★ MISCLASSIFICATION\nsmall-isoform patient: true 50 mg/dL\nreads 34 mg/dL (missed) while true\nparticle count 137 nmol/L (flagged)" fillcolor="#FF8A65" color="#BF360C" fontcolor="white" penwidth=2]
    M_ldlc    [label="★ 'LDL-C' CONTAMINATION\nstandard LDL-C already CONTAINS\nLp(a)-cholesterol (~30% of Lp(a) mass)" fillcolor="#FFCA28" color="#E65100" penwidth=2]
    M_dahl    [label="Dahlén correction\nLDL-Ccorr = LDL-C − 0.30·Lp(a)mass\n(over-corrects if true Chol% is 17-25%)" fillcolor="#FFECB3" color="#FF6F00"]
    M_apob    [label="Total apoB (nmol/L)\n= LDL-P + Lp(a)-P + remnant-P\nLp(a) 300 nmol/L ≈ 15% of apoB particles" fillcolor="#FFECB3" color="#FF6F00"]
    M_intact  [label="Intact-Lp(a) assay\n(apo(a)-AND-apoB sandwich)\nblind to FREE apo(a)\n→ needed for assembly inhibitors" fillcolor="#FFE082" color="#FF6F00"]
    M_oxpl    [label="OxPL-apoB (E06 antibody)\ntracks Lp(a) tightly\n(a second read-out of the SAME particle)" fillcolor="#FFECB3" color="#FF6F00"]
  }

  //=========================================================
  // CLUSTER 6 : ARM 1 — atherogenic (apoB / cholesterol)
  //=========================================================
  subgraph cluster_arm1 {
    label="🩸 6. ARM 1 — Atherogenic arm: retention of an apoB particle that binds matrix MORE avidly than LDL"
    style=filled fillcolor="#FFEBEE" color="#B71C1C" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    R_endo    [label="Endothelial permeability\nshear stress · smoking · HTN · DM\n(the common gate for ALL apoB particles)" fillcolor="#FFCDD2" color="#B71C1C"]
    R_pg      [label="Intimal proteoglycans\nbiglycan · decorin · versican\napoB site B ionic binding" fillcolor="#FFCDD2" color="#B71C1C"]
    R_fn      [label="★ apo(a)-specific matrix binding\nfibronectin · fibrin · defensin\nvia kringle lysine-binding sites\n→ retention avidity ≈ 2.5x LDL" fillcolor="#EF9A9A" color="#B71C1C" penwidth=2]
    R_retlpa  [label="Retained intimal Lp(a)\n(state INTIMA_LPA)" fillcolor="#FFCDD2" color="#B71C1C"]
    R_retldl  [label="Retained intimal LDL\n(state INTIMA_LDL)" fillcolor="#FFCDD2" color="#B71C1C"]
    R_ox      [label="Intimal oxidation / MPO\n→ oxLDL neo-epitopes" fillcolor="#FFCDD2" color="#B71C1C"]
    R_foam    [label="Macrophage foam cells\nCD36 · SR-A · LOX-1 uptake\n(state FOAM)" fillcolor="#FFCDD2" color="#B71C1C"]
    R_effl    [label="Cholesterol efflux\nABCA1/G1 → HDL / apoA-I\n(the only exit)" fillcolor="#C8E6C9" color="#1B5E20"]
    R_smc     [label="SMC migration · fibrous cap\ncollagen I/III synthesis" fillcolor="#FFCDD2" color="#B71C1C"]
    R_necro   [label="Necrotic core\nefferocytosis failure · apoptosis\n(state NECRO)" fillcolor="#FFCDD2" color="#B71C1C"]
    R_cap     [label="Fibrous cap thickness\n<65 µm = thin-cap fibroatheroma" fillcolor="#FFCDD2" color="#B71C1C"]
    R_plaq    [label="★ Plaque burden (PAV %)\nSLOW integrator, t½ ≈ 14 yr\n(state PLAQUE)" fillcolor="#E57373" color="#7F0000" fontcolor="white" penwidth=2]
    R_cac     [label="Coronary artery calcium (CAC)\nAgatston score" fillcolor="#FFCDD2" color="#B71C1C"]
  }

  //=========================================================
  // CLUSTER 7 : ARM 2 — OxPL / innate inflammation
  //=========================================================
  subgraph cluster_arm2 {
    label="🔥 7. ARM 2 — OxPL arm: Lp(a) is the preferential plasma carrier of oxidised phospholipids (a payload LDL does not carry)"
    style=filled fillcolor="#FFF3E0" color="#E65100" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    X_oxpl    [label="★ OxPL covalently bound to\napo(a) KIV-10 (~1 site / particle)\n(state OXPL, nM)" fillcolor="#FFCC80" color="#E65100" penwidth=2]
    X_lppla2  [label="Lp-PLA2 (PLA2G7) carried on Lp(a)\ngenerates lysoPC + oxNEFA" fillcolor="#FFE0B2" color="#E65100"]
    X_cd36    [label="Monocyte CD36 · TLR2 · TLR4\nscavenger/pattern recognition" fillcolor="#FFE0B2" color="#E65100"]
    X_nfkb    [label="NF-κB activation\n(monocyte / endothelium)" fillcolor="#FFE0B2" color="#E65100"]
    X_nlrp3   [label="NLRP3 inflammasome\ncaspase-1 → IL-1β" fillcolor="#FFE0B2" color="#E65100"]
    X_train   [label="★ Trained immunity\nmonocyte transendothelial migration ↑\nREVERSED by apo(a) ASO in humans\n(van der Valk, Circulation 2016)" fillcolor="#FFB74D" color="#BF360C" penwidth=2]
    X_il1b    [label="IL-1β" fillcolor="#FFE0B2" color="#E65100"]
    X_il6     [label="★ IL-6 (pg/mL)\n(state IL6) — the hub cytokine" fillcolor="#FFB74D" color="#BF360C" penwidth=2]
    X_crp     [label="hsCRP (mg/L)\n(state CRP) — downstream read-out" fillcolor="#FFE0B2" color="#E65100"]
    X_adh     [label="VCAM-1 · ICAM-1 · MCP-1\nendothelial adhesion programme" fillcolor="#FFE0B2" color="#E65100"]
    X_vuln    [label="★ Vulnerability index VULN\nFAST-responding (months)\n— this is what a 5-yr trial can move" fillcolor="#FF8A65" color="#BF360C" fontcolor="white" penwidth=2]
  }

  //=========================================================
  // CLUSTER 8 : ARM 3 — antifibrinolytic
  //=========================================================
  subgraph cluster_arm3 {
    label="🧵 8. ARM 3 — Antifibrinolytic arm: apo(a) is a catalytically DEAD plasminogen homologue (strong in vitro, contested in vivo — modelled at LOW weight)"
    style=filled fillcolor="#F3E5F5" color="#6A1B9A" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    F_homol   [label="apo(a) ≈ plasminogen\nKIV x n · KV · protease domain\nSer→Ser: CANNOT be activated" fillcolor="#E1BEE7" color="#6A1B9A"]
    F_lbs     [label="★ Strong lysine-binding site\nin KIV-10 — ONE per particle\n(so this arm scales with nmol/L,\nnot with mg/dL)" fillcolor="#CE93D8" color="#4A148C" penwidth=2]
    F_plg     [label="Plasminogen (2 µM)\nGlu-plg → Lys-plg" fillcolor="#E1BEE7" color="#6A1B9A"]
    F_fibrin  [label="Fibrin C-terminal lysines\n(the shared docking surface)" fillcolor="#E1BEE7" color="#6A1B9A"]
    F_comp    [label="Competitive displacement\nLBS occupancy = f(Lp(a)-P / PLG)" fillcolor="#E1BEE7" color="#6A1B9A"]
    F_tpa     [label="t-PA-mediated plasminogen\nactivation on fibrin ↓" fillcolor="#E1BEE7" color="#6A1B9A"]
    F_pai1    [label="PAI-1 expression ↑\n(endothelial, Lp(a)-induced)" fillcolor="#E1BEE7" color="#6A1B9A"]
    F_tafi    [label="TAFI activation ↑\n(removes C-terminal lysines)" fillcolor="#E1BEE7" color="#6A1B9A"]
    F_clt     [label="Clot lysis time ↑\n(state LYSRES — lysis resistance)" fillcolor="#E1BEE7" color="#6A1B9A"]
    F_vte     [label="⚠️ Honest caveat: Mendelian\nrandomisation shows NO Lp(a)–VTE\nassociation → arm weight set LOW" fillcolor="#F8BBD0" color="#880E4F"]
    F_thromb  [label="Arterial thrombus persistence\n· reduced thrombolysis efficacy" fillcolor="#E1BEE7" color="#6A1B9A"]
  }

  //=========================================================
  // CLUSTER 9 : ARM 4 — calcific aortic valve disease
  //=========================================================
  subgraph cluster_valve {
    label="🫀 9. Aortic valve arm — the steepest Lp(a) hazard of all, and the one with a SELF-SUSTAINING switch"
    style=filled fillcolor="#E8EAF6" color="#283593" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    V_dep     [label="Lp(a) deposition in valve\nfibrosa (subendothelial)" fillcolor="#C5CAE9" color="#1A237E"]
    V_atx     [label="★ Autotaxin (ENPP2)\ncarried INTO the valve ON Lp(a)\n(Bouchareb, Circulation 2015)" fillcolor="#9FA8DA" color="#1A237E" penwidth=2]
    V_lysopc  [label="LysoPC (from Lp-PLA2 on OxPL)" fillcolor="#C5CAE9" color="#1A237E"]
    V_lpalip  [label="LysoPA (lysophosphatidic acid)\n— the LIPID, not the lipoprotein" fillcolor="#C5CAE9" color="#1A237E"]
    V_lpar    [label="LPAR1/3 on valve interstitial cells\n→ NF-κB → BMP2" fillcolor="#C5CAE9" color="#1A237E"]
    V_bmp2    [label="BMP2 → SMAD1/5/8" fillcolor="#C5CAE9" color="#1A237E"]
    V_runx2   [label="RUNX2 · osterix\nosteogenic transcription programme" fillcolor="#C5CAE9" color="#1A237E"]
    V_vic     [label="Osteogenic VIC fraction\n(state VIC_OST)" fillcolor="#C5CAE9" color="#1A237E"]
    V_alp     [label="Alkaline phosphatase ↑\ninorganic pyrophosphate ↓" fillcolor="#C5CAE9" color="#1A237E"]
    V_micro   [label="Microcalcification\n(¹⁸F-NaF PET positive)" fillcolor="#C5CAE9" color="#1A237E"]
    V_macro   [label="★ Macrocalcification (AVC score)\nSELF-PERPETUATING beyond a\nthreshold — becomes Lp(a)-INDEPENDENT\n(state VALV_CALC)" fillcolor="#7986CB" color="#1A237E" fontcolor="white" penwidth=2]
    V_ava     [label="Aortic valve area (cm²)\n→ mean gradient (mmHg)" fillcolor="#C5CAE9" color="#1A237E"]
    V_avr     [label="AVR / TAVI · valve-related death\n(endpoint HAZ_AVS)" fillcolor="#9FA8DA" color="#1A237E"]
    V_fail    [label="⚠️ SEAS · ASTRONOMER · SALTIRE\nall NULL — because they treated\nESTABLISHED calcific AS\n(model reproduces this)" fillcolor="#FFCDD2" color="#B71C1C"]
  }

  //=========================================================
  // CLUSTER 10 : the feed-forward loop
  //=========================================================
  subgraph cluster_loop {
    label="🔁 10. The feed-forward loop — Lp(a) makes the cytokine that transcribes Lp(a)"
    style=filled fillcolor="#FFFDE7" color="#F57F17" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    L_a       [label="Lp(a) particles ↑" fillcolor="#FFF59D" color="#F57F17"]
    L_b       [label="OxPL payload ↑" fillcolor="#FFF59D" color="#F57F17"]
    L_c       [label="Monocyte NF-κB → IL-6 ↑" fillcolor="#FFF59D" color="#F57F17"]
    L_d       [label="IL-6 RE in LPA promoter\n→ transcription ↑" fillcolor="#FFF59D" color="#F57F17"]
    L_gain    [label="★ Measured open-loop gain g = 0.019\nSTRONGLY subcritical: amplification\n1/(1-g) = 1.02, i.e. negligible.\nThe LOOP is not the story —" fillcolor="#FFF176" color="#F57F17" penwidth=2]
    L_pred    [label="★ — the TONIC IL-6 term is.\nAt IL-6 2 pg/mL the promoter multiplier\nis already 1.33, so 25% of basal LPA\ntranscription is IL-6-driven. Hence\nRESCUE −26.6% and MEASURE −33.5%\nfrom ONE equation." fillcolor="#FFF176" color="#F57F17" penwidth=2]
  }

  //=========================================================
  // CLUSTER 11 : secondary / acquired modifiers
  //=========================================================
  subgraph cluster_mod {
    label="⚙️ 11. Acquired modifiers — the only levers that move Lp(a) without a drug"
    style=filled fillcolor="#ECEFF1" color="#37474F" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    D_neph    [label="Nephrotic syndrome\nLp(a) ↑ 2-3x (hepatic protein drive)" fillcolor="#CFD8DC" color="#263238"]
    D_ckd     [label="CKD / ESRD\n↑ especially LARGE isoforms\n(clearance route lost)" fillcolor="#CFD8DC" color="#263238"]
    D_thy     [label="Hypothyroidism ↑ · L-T4 ↓\n(thyroid hormone response element)" fillcolor="#CFD8DC" color="#263238"]
    D_meno    [label="Menopause ↑ ~20%\noral oestrogen / HRT ↓ 20-25%" fillcolor="#CFD8DC" color="#263238"]
    D_test    [label="Testosterone ↓ · tibolone ↓\nanabolic steroids ↓↓" fillcolor="#CFD8DC" color="#263238"]
    D_liver   [label="Advanced liver disease ↓\n(production organ fails)" fillcolor="#CFD8DC" color="#263238"]
    D_infl    [label="Acute phase / sepsis / RA\n↑ 20-40% transiently\n(measure when well!)" fillcolor="#CFD8DC" color="#263238"]
    D_diet    [label="⚠️ Diet · exercise · weight loss\n→ essentially NO effect\n(ketogenic diet may ↑)" fillcolor="#FFCDD2" color="#B71C1C"]
    D_preg    [label="Pregnancy ↑ (2nd-3rd trimester)" fillcolor="#CFD8DC" color="#263238"]
  }

  //=========================================================
  // CLUSTER 12 : RNA-directed drugs (the production node)
  //=========================================================
  subgraph cluster_rna {
    label="💊 12. RNA-directed therapeutics — hit the ONE rate-limiting step, therefore the ONLY class achieving >80% lowering"
    style=filled fillcolor="#E8F5E9" color="#1B5E20" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    P_galnac  [label="GalNAc₃ conjugate\n→ ASGR1 on hepatocyte\n→ hepatocyte-selective delivery" fillcolor="#C8E6C9" color="#1B5E20"]
    P_pela    [label="★ PELACARSEN (TQJ230)\nGalNAc-ASO, RNase-H1\n80 mg SC monthly → ~80% ↓\n(Tsimikas NEJM 2020)" fillcolor="#A5D6A7" color="#1B5E20" penwidth=2]
    P_rnaseh  [label="RNase H1 cleavage of LPA mRNA\n(nuclear + cytoplasmic)" fillcolor="#C8E6C9" color="#1B5E20"]
    P_olpa    [label="★ OLPASIRAN (AMG 890)\nGalNAc-siRNA, 75 mg SC Q12W\n≈ −95 to −101% placebo-adjusted\n(OCEAN(a)-DOSE NEJM 2022)" fillcolor="#A5D6A7" color="#1B5E20" penwidth=2]
    P_lepo    [label="LEPODISIRAN (LY3819469)\nsingle 608 mg → >90% ↓ for ~48 wk\n(ALPACA, NEJM 2025)" fillcolor="#C8E6C9" color="#1B5E20"]
    P_zerl    [label="ZERLASIRAN (SLN360)\n300-450 mg Q16-24W → ~80-90% ↓" fillcolor="#C8E6C9" color="#1B5E20"]
    P_risc    [label="★ RISC (AGO2) loading\nvery long intracellular t½\n→ PD outlives PK by MONTHS\n(state OLP_RISC)" fillcolor="#A5D6A7" color="#1B5E20" penwidth=2]
    P_hzn     [label="Lp(a)HORIZON — pelacarsen\n8,323 pts, Lp(a) ≥70 mg/dL\nprimary MACE readout" fillcolor="#DCEDC8" color="#33691E"]
    P_ocean   [label="OCEAN(a)-Outcomes — olpasiran\n≥200 nmol/L entry" fillcolor="#DCEDC8" color="#33691E"]
    P_accl    [label="ACCLAIM-Lp(a) — lepodisiran" fillcolor="#DCEDC8" color="#33691E"]
  }

  //=========================================================
  // CLUSTER 13 : assembly-directed drug
  //=========================================================
  subgraph cluster_muv {
    label="💊 13. Assembly-directed therapy — a DIFFERENT node, and therefore a different assay problem"
    style=filled fillcolor="#E0F2F1" color="#004D40" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    U_muv     [label="★ MUVALAPLIN (LY3473329)\nORAL small molecule\nbinds apo(a) KIV-7/8 lysine-binding site\n→ blocks STEP 1 docking" fillcolor="#80CBC4" color="#004D40" penwidth=2]
    U_krak    [label="KRAKEN Ph2 (JAMA 2024)\n−85.8% by INTACT-Lp(a) assay\n−70% by traditional apo(a) assay" fillcolor="#B2DFDB" color="#004D40"]
    U_freeup  [label="★ Free apo(a) RISES on drug\n→ any assay that detects free apo(a)\nUNDER-reports the true effect" fillcolor="#4DB6AC" color="#004D40" fontcolor="white" penwidth=2]
    U_oral    [label="Oral, daily · no injection\n(adherence / scale advantage)" fillcolor="#B2DFDB" color="#004D40"]
  }

  //=========================================================
  // CLUSTER 14 : clearance-directed drugs
  //=========================================================
  subgraph cluster_clr {
    label="💊 14. Clearance-directed drugs — capped at ~25-30% BY ARITHMETIC, because only ~24% of Lp(a) clearance is LDLR-dependent"
    style=filled fillcolor="#FCE4EC" color="#AD1457" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    K_statin  [label="★ STATINS — Lp(a) RISES 8-20%\nLDLR ↑ would lower it 16%, but LPA\ntranscription ↑ ~30% overrides\n(net +8.1%: the model DERIVES this)" fillcolor="#F48FB1" color="#880E4F" penwidth=2]
    K_pcsk9   [label="★ PCSK9 mAb (evolocumab/alirocumab)\nLDL-P −59.0% but Lp(a) only −30.1%\n— the SAME LDLR change, two answers" fillcolor="#F48FB1" color="#880E4F" penwidth=2]
    K_incl    [label="Inclisiran (PCSK9 siRNA)\nLp(a) −19 to −26%" fillcolor="#F8BBD0" color="#AD1457"]
    K_cetp    [label="CETP inhibitor (obicetrapib)\nLp(a) −30 to −35%\n(production + clearance)" fillcolor="#F8BBD0" color="#AD1457"]
    K_eze     [label="★ Ezetimibe — LDL-P −19%,\nLp(a) −6.6% (model, unfitted)\nobserved ≈ −7% — a quantitative\ntest of the 24% figure, and it passes" fillcolor="#F8BBD0" color="#AD1457"]
    K_aphe    [label="Lipoprotein apheresis\n−60-70% acute, −30-35% time-averaged\nPro(a)LiFe: large event reduction" fillcolor="#F8BBD0" color="#AD1457"]
    K_bemp    [label="Bempedoic acid — Lp(a) ≈ no change" fillcolor="#F8BBD0" color="#AD1457"]
    K_fourier [label="FOURIER / ODYSSEY OUTCOMES\nLp(a) reduction contributed to MACE\nbenefit INDEPENDENTLY of LDL-C" fillcolor="#F8BBD0" color="#AD1457"]
  }

  //=========================================================
  // CLUSTER 15 : inflammation-directed drugs
  //=========================================================
  subgraph cluster_infl {
    label="💊 15. Inflammation-directed drugs — act on the loop, not on the particle"
    style=filled fillcolor="#FFF3E0" color="#BF360C" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    N_zilti   [label="★ ZILTIVEKIMAB (anti-IL-6)\nhsCRP −90%, Lp(a) −16 to −25%\n(RESCUE) — ZEUS outcome trial" fillcolor="#FFCCBC" color="#BF360C" penwidth=2]
    N_toci    [label="Tocilizumab (anti-IL-6R)\nLp(a) −30-40% in RA (MEASURE)" fillcolor="#FFCCBC" color="#BF360C"]
    N_cana    [label="Canakinumab (anti-IL-1β)\nCANTOS: MACE ↓ with NO lipid change\n— Lp(a) itself unchanged" fillcolor="#FFCCBC" color="#BF360C"]
    N_colch   [label="Colchicine (LoDoCo2/COLCOT)\nplaque stabilisation, Lp(a) unchanged" fillcolor="#FFCCBC" color="#BF360C"]
    N_niacin  [label="⚠️ NIACIN — Lp(a) −20-25%\nbut AIM-HIGH & HPS2-THRIVE NULL\n(model: absolute Δ too small)" fillcolor="#FFAB91" color="#BF360C" penwidth=2]
  }

  //=========================================================
  // CLUSTER 16 : risk translation
  //=========================================================
  subgraph cluster_risk {
    label="📈 16. Risk translation — why Mendelian randomisation and a 5-year trial give different per-unit answers WITHOUT either being wrong"
    style=filled fillcolor="#EFEBE9" color="#3E2723" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    Z_auc     [label="Cumulative exposure\n∫ Lp(a) dt (nmol·yr/L)\n(state AUC_LPA)" fillcolor="#D7CCC8" color="#3E2723"]
    Z_slow    [label="★ SLOW component — plaque burden\nbuilt over decades, t½ ≈ 14 yr\n→ what MR measures" fillcolor="#BCAAA4" color="#3E2723" penwidth=2]
    Z_fast    [label="★ FAST component — vulnerability\nOxPL/IL-6-driven, t½ ≈ 3 months\n→ what a 5-yr trial can move" fillcolor="#BCAAA4" color="#3E2723" penwidth=2]
    Z_burg    [label="Burgess 2018 JAMA Cardiol:\n101.5 mg/dL lifelong ≈ 38.67 mg/dL LDL-C\n→ Lp(a) mass is 0.38x as potent per mg/dL\n(but ≈1.3x per unit CHOLESTEROL carried)" fillcolor="#D7CCC8" color="#3E2723"]
    Z_erfc    [label="ERFC 2009: HR 1.13 per 1-SD\nCopenhagen: >95th pct HR ≈ 2.0 for MI" fillcolor="#D7CCC8" color="#3E2723"]
    Z_abs     [label="★ ABSOLUTE Δ is what counts:\n80% off 60 nmol/L = 48 nmol/L\n25% off 300 nmol/L = 75 nmol/L\n→ trial ENTRY CRITERIA are the design" fillcolor="#A1887F" color="#3E2723" fontcolor="white" penwidth=2]
    Z_mace    [label="MACE hazard\n(CV death · MI · stroke · urgent revasc)\n(state HAZ)" fillcolor="#D7CCC8" color="#3E2723"]
    Z_ratio   [label="★ Model output: MR effect ÷ 5-yr trial\neffect ≈ 2.8x — emerges from the\ntwo time constants, not from a fudge" fillcolor="#A1887F" color="#3E2723" fontcolor="white" penwidth=2]
  }

  //=========================================================
  // CLUSTER 17 : clinical endpoints
  //=========================================================
  subgraph cluster_endp {
    label="🎯 17. Clinical endpoints"
    style=filled fillcolor="#E1F5FE" color="#01579B" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    E_mi      [label="Myocardial infarction" fillcolor="#B3E5FC" color="#01579B"]
    E_stroke  [label="Ischaemic stroke\n(strongest in young stroke)" fillcolor="#B3E5FC" color="#01579B"]
    E_pad     [label="Peripheral arterial disease\n(steep Lp(a) gradient)" fillcolor="#B3E5FC" color="#01579B"]
    E_as      [label="Calcific aortic stenosis / AVR" fillcolor="#B3E5FC" color="#01579B"]
    E_hf      [label="Heart failure (via MI + AS)" fillcolor="#B3E5FC" color="#01579B"]
    E_isr     [label="In-stent restenosis · SVG failure\n· recurrent events post-PCI" fillcolor="#B3E5FC" color="#01579B"]
    E_resid   [label="★ Residual risk despite LDL-C <55\n— the clinical niche Lp(a) defines" fillcolor="#81D4FA" color="#01579B" penwidth=2]
  }

  //=========================================================
