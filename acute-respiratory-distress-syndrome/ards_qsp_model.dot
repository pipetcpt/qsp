digraph ARDS_QSP {
  rankdir=LR;
  fontname="Helvetica";
  labelloc="t";
  fontsize=20;
  label="Acute Respiratory Distress Syndrome (ARDS) — Mechanistic QSP Map\nDiffuse alveolar damage: epithelial + endothelial barrier failure → protein-rich alveolar oedema → shunt, dead space, loss of aerated 'baby lung'\nVentilator-induced lung injury (volu-/baro-/atelec-/bio-trauma) as an iatrogenic amplifier · fibroproliferative vs resolution fork · hyper- vs hypo-inflammatory subphenotypes\nPharmacology & interventions: corticosteroids · neuromuscular blockade · prone position · conservative fluids · inhaled pulmonary vasodilators · VV-ECMO · IL-6R blockade / JAK inhibition (COVID-ARDS)";
  node [style=filled, fontname="Helvetica", fontsize=10, shape=box];
  edge [fontname="Helvetica", fontsize=8];
  newrank=true;
  nodesep=0.28;
  ranksep=0.90;

  /* ======================================================================
     1. Precipitating insults — direct (pulmonary) vs indirect (extrapulmonary)
     ====================================================================== */
  subgraph cluster_insult {
    label="1. Precipitating Insult: Direct (Pulmonary) vs Indirect (Extrapulmonary)";
    style=filled; color="#c9b8b8"; fillcolor="#f7eeee"; fontsize=13;
    Pneumonia [label="Bacterial / viral\npneumonia\n(commonest direct cause)", fillcolor="#f3d6d6"];
    SARSCoV2 [label="SARS-CoV-2\n(ACE2 · TMPRSS2\nAT2 tropism)", fillcolor="#f3d6d6"];
    Influenza [label="Influenza / RSV"];
    Aspiration [label="Gastric acid\naspiration (pH<2.5)"];
    Inhalation [label="Toxic inhalation /\nsmoke / vaping (EVALI)"];
    Contusion [label="Pulmonary contusion\n(blunt trauma)"];
    Drowning [label="Near-drowning"];
    Sepsis_extra [label="Extrapulmonary sepsis\n(abdominal · urinary)", fillcolor="#f3d6d6"];
    Pancreatitis [label="Acute severe\npancreatitis"];
    Trauma_shock [label="Polytrauma +\nhaemorrhagic shock"];
    TRALI [label="TRALI\n(anti-HLA/HNA antibody,\ntwo-hit)"];
    Transfusion_load [label="Massive transfusion /\nTACO overlap"];
    Drug_toxicity [label="Drug toxicity\n(amiodarone · bleomycin\n· opioid)"];
    Burns [label="Major burns +\ninhalation injury"];
    Insult_direct [label="DIRECT epithelial-first\ninjury pattern\n(consolidation, low recruitability)", fillcolor="#eebfbf"];
    Insult_indirect [label="INDIRECT endothelial-first\ninjury pattern\n(oedema, high recruitability)", fillcolor="#eebfbf"];
    PAMP [label="PAMPs\n(LPS · flagellin · ssRNA)", fillcolor="#f3d6d6"];
    DAMP [label="DAMPs\n(HMGB1 · mtDNA · histones\n· hyaluronan · S100A8/9)", fillcolor="#eebfbf"];
    Genetic_risk [label="Host susceptibility\n(ACE I/D · FAS · SFTPB\n· ANGPT2 variants)"];
    Alcohol_risk [label="Chronic alcohol /\nsmoking (glutathione↓)"];
  }

  /* ======================================================================
     2. Alveolar epithelium — AT1/AT2, surfactant, fluid clearance
     ====================================================================== */
  subgraph cluster_epi {
    label="2. Alveolar Epithelium: AT1/AT2 Injury, Surfactant, Fluid Clearance";
    style=filled; color="#b8c9b8"; fillcolor="#eef5ee"; fontsize=13;
    AT1 [label="AT1 cells\n(95% of surface area,\ngas exchange barrier)", fillcolor="#d7ead7"];
    AT2 [label="AT2 cells\n(surfactant + progenitor\n+ ion transport)", fillcolor="#d7ead7"];
    AT1_necrosis [label="AT1 necrosis /\ndenudation of\nbasement membrane", fillcolor="#c3dfc3"];
    AT2_apoptosis [label="AT2 apoptosis\n(FasL · TRAIL · caspase-3)"];
    Epi_barrier [label="EPITHELIAL BARRIER\nINTEGRITY\n(tight junctions: ZO-1,\nclaudin-4/-18, occludin)", fillcolor="#a9d3a9"];
    Claudin4 [label="Claudin-4 upregulation\n(protective, marks\nrepair capacity)"];
    Hyaline_membrane [label="Hyaline membranes\n(fibrin + cell debris\non denuded BM)", fillcolor="#c3dfc3"];
    ENaC [label="Apical ENaC\n(α/β/γ subunits)"];
    NaK_ATPase [label="Basolateral\nNa+/K+-ATPase"];
    AQP5 [label="Aquaporin-5\n(water follows Na+)"];
    AFC [label="ALVEOLAR FLUID\nCLEARANCE (AFC)\n(<3%/h = impaired,\npredicts mortality)", fillcolor="#a9d3a9"];
    cAMP_epi [label="Epithelial cAMP\n(β2-agonist / cGMP\nstimulated AFC)"];
    Surfactant_pool [label="Functional surfactant\npool (SP-B · SP-C\n· DPPC)", fillcolor="#d7ead7"];
    Surf_inactivation [label="Surfactant inactivation\nby plasma proteins,\nphospholipase A2", fillcolor="#c3dfc3"];
    Surf_tension [label="Alveolar surface\ntension ↑"];
    SPD_RAGE [label="Plasma biomarkers of\nepithelial injury:\nSP-D · RAGE · CC16", fillcolor="#d7ead7"];
    AT2_prolif [label="AT2 proliferation →\nAT1 transdifferentiation\n(KGF · HGF · Wnt/β-catenin)"];
    Damaged_AT2_state [label="Transitional / KRT5+\naberrant basaloid state\n(pro-fibrotic arrest)"];
  }

  /* ======================================================================
     3. Pulmonary endothelium and the glycocalyx
     ====================================================================== */
  subgraph cluster_endo {
    label="3. Pulmonary Microvascular Endothelium & Glycocalyx";
    style=filled; color="#b8bed9"; fillcolor="#eef0f9"; fontsize=13;
    Endo_cell [label="Pulmonary capillary\nendothelial cell", fillcolor="#d5d9ee"];
    Glycocalyx [label="Endothelial glycocalyx\n(syndecan-1 · heparan\nsulfate · hyaluronan)"];
    Glyx_shedding [label="Glycocalyx shedding\n(heparanase · MMP-9)\n→ plasma syndecan-1↑", fillcolor="#c2c8e5"];
    VE_cadherin [label="VE-cadherin adherens\njunctions"];
    VEcad_phos [label="Src/PAK-mediated\nVE-cadherin phosphorylation\n→ internalisation", fillcolor="#c2c8e5"];
    RhoA_stress [label="RhoA/ROCK → actomyosin\nstress fibres → cell\ncontraction, gap formation"];
    Rac1_S1P [label="Rac1 / S1P–S1PR1\nbarrier-enhancing axis"];
    Ang1_Tie2 [label="Ang-1 / Tie2\n(quiescence, barrier\nstabilising)"];
    Ang2 [label="Ang-2 release from\nWeibel-Palade bodies\n(Tie2 antagonist)", fillcolor="#c2c8e5"];
    VEGF_lung [label="VEGF-A\n(permeability ↑ in acute\nphase; repair later)"];
    vWF_plasma [label="Plasma vWF antigen\n(endothelial activation\nmarker)"];
    ICAM_VCAM [label="ICAM-1 / VCAM-1 /\nE-selectin upregulation"];
    Endo_barrier [label="ENDOTHELIAL BARRIER\nINTEGRITY", fillcolor="#b5bce4"];
    Endo_apopt [label="Endothelial apoptosis /\npyroptosis"];
    Perm_K [label="ALVEOLAR-CAPILLARY\nPERMEABILITY (Kf)", fillcolor="#a7b0e0"];
  }

  /* ======================================================================
     4. Innate immune activation and neutrophil-driven injury
     ====================================================================== */
  subgraph cluster_innate {
    label="4. Innate Immunity: TLR/Inflammasome Signalling & Neutrophil Injury";
    style=filled; color="#d9c8ab"; fillcolor="#faf3e6"; fontsize=13;
    TLR4 [label="TLR4 / MD-2 / CD14\n(LPS · HMGB1 · histones)", fillcolor="#f2e3c4"];
    TLR2_9 [label="TLR2 / TLR9\n(lipopeptide · mtDNA CpG)"];
    MyD88 [label="MyD88 / IRAK4 / TRAF6"];
    NFkB [label="NF-κB (p65) nuclear\ntranslocation", fillcolor="#eed9a8"];
    AP1_MAPK [label="MAPK (p38 · JNK · ERK)\n→ AP-1"];
    NLRP3 [label="NLRP3 inflammasome\n(ASC · pro-caspase-1)", fillcolor="#eed9a8"];
    Casp1 [label="Caspase-1 activation"];
    GSDMD [label="Gasdermin-D pores\n→ pyroptosis"];
    AlvMac_res [label="Resident alveolar\nmacrophages (SiglecF+)", fillcolor="#f2e3c4"];
    Mono_recruit [label="Recruited classical\nmonocytes (CCR2+)\n→ monocyte-derived MΦ"];
    MAC_M1 [label="M1 / pro-inflammatory\nmacrophage programme", fillcolor="#eed9a8"];
    MAC_M2 [label="M2 / pro-resolving\nmacrophage programme\n(efferocytosis)", fillcolor="#e2f0d9"];
    Neut_marrow [label="Bone-marrow\nemergency granulopoiesis\n(G-CSF)"];
    Neut_circ [label="Circulating neutrophils"];
    Neut_margin [label="Pulmonary capillary\nmargination + CD11b/CD18\nadhesion"];
    Neut_alv [label="ALVEOLAR NEUTROPHILS\n(BAL PMN % — hallmark\nof exudative phase)", fillcolor="#e8cd92"];
    NE_MPO [label="Neutrophil elastase ·\nMPO · MMP-8/9\n(matrix + junction cleavage)", fillcolor="#e8cd92"];
    NETs [label="NETosis (PAD4 · citH3)\n→ NETs: DNA-histone\ncytotoxic scaffolds", fillcolor="#e8cd92"];
    ROS_burst [label="NADPH-oxidase ROS ·\nperoxynitrite · HOCl", fillcolor="#e8cd92"];
    Antiox [label="Antioxidant reserve\n(glutathione · SOD ·\ncatalase)", fillcolor="#e2f0d9"];
    Complement [label="Complement activation\n(C3a · C5a · sC5b-9)"];
    Platelet_neut [label="Platelet-neutrophil\naggregates (P-selectin)"];
  }

  /* ======================================================================
     5. Cytokine network
     ====================================================================== */
  subgraph cluster_cyto {
    label="5. Cytokine / Chemokine Network (BAL and Plasma)";
    style=filled; color="#d3b3c8"; fillcolor="#f9eef5"; fontsize=13;
    TNFa [label="TNF-α\n(+ soluble TNFR1 —\nmortality predictor)", fillcolor="#eecfe1"];
    IL1b [label="IL-1β\n(most bioactive cytokine\nin early BAL fluid)", fillcolor="#eecfe1"];
    IL18 [label="IL-18"];
    IL6 [label="IL-6\n(central biomarker;\ntocilizumab target)", fillcolor="#e6bcd6"];
    IL8 [label="IL-8 / CXCL8\n(dominant neutrophil\nchemoattractant)", fillcolor="#e6bcd6"];
    CXCL1_2 [label="CXCL1/2 (GRO) ·\nCXCL5 · LTB4"];
    CCL2 [label="CCL2 / MCP-1\n(monocyte recruitment)"];
    IFNg [label="IFN-γ (Th1 / NK)"];
    IL17 [label="IL-17A (γδT / Th17)\n→ CXCL8 amplification"];
    IL10 [label="IL-10\n(counter-regulatory)", fillcolor="#e2f0d9"];
    IL1RA [label="IL-1RA · sIL-1RII\n(endogenous antagonists)", fillcolor="#e2f0d9"];
    GMCSF [label="GM-CSF\n(alveolar MΦ maturation —\ndual: injury vs repair)"];
    IL22_KGF [label="IL-22 · KGF/FGF-7 · HGF\n(epithelial trophic)", fillcolor="#e2f0d9"];
    JAK_STAT [label="JAK1/2–STAT1/3\nsignalling hub\n(baricitinib target)", fillcolor="#eecfe1"];
    Cytokine_storm [label="CYTOKINE BURDEN\n(hyperinflammatory\nsignature)", fillcolor="#dda6cb"];
  }

  /* ======================================================================
     6. Coagulation and fibrinolysis in the alveolar compartment
     ====================================================================== */
  subgraph cluster_coag {
    label="6. Alveolar Coagulopathy: Tissue Factor, Fibrin, Impaired Fibrinolysis";
    style=filled; color="#b8cfd3"; fillcolor="#eef6f7"; fontsize=13;
    TF_alv [label="Tissue factor on\nalveolar epithelium +\nmacrophages", fillcolor="#d3e8ea"];
    Thrombin [label="Thrombin generation\n(PAR-1 signalling →\nbarrier disruption)"];
    Fibrin_alv [label="Intra-alveolar fibrin\ndeposition", fillcolor="#c0dee1"];
    PAI1 [label="PAI-1 ↑ (alveolar and\nplasma; ARDS mortality\npredictor)", fillcolor="#c0dee1"];
    Protein_C [label="Protein C pathway ↓\n(thrombomodulin/EPCR\nshedding)", fillcolor="#e2f0d9"];
    Microthrombi [label="Pulmonary capillary\nmicrothrombosis\n(pronounced in COVID-19)", fillcolor="#c0dee1"];
    Platelets [label="Platelet consumption /\nthrombocytopenia"];
    Dead_space_thromb [label="Vascular occlusion →\nphysiological dead space ↑"];
  }

  /* ======================================================================
     7. Alveolar flooding — Starling forces and lung water
     ====================================================================== */
  subgraph cluster_edema {
    label="7. Alveolar Flooding: Starling Forces, Lung Water, Protein";
    style=filled; color="#aabfd6"; fillcolor="#edf3fa"; fontsize=13;
    Pcap [label="Pulmonary capillary\nhydrostatic pressure\n(PAOP / LAP)", fillcolor="#d3e0f0"];
    Oncotic [label="Plasma oncotic pressure\n(albumin)"];
    Fluid_balance [label="Cumulative fluid\nbalance (resuscitation\nvs diuresis)", fillcolor="#d3e0f0"];
    Filtration [label="Transvascular filtration\nQf = Kf·[(Pc−Pi)−σ(πc−πi)]", fillcolor="#bccfe8"];
    Interstitial_edema [label="Interstitial oedema\n(peribronchovascular\ncuffing)"];
    Alveolar_flood [label="ALVEOLAR FLOODING\n(protein-rich exudate)", fillcolor="#a9c2e4"];
    EVLW [label="EVLW index\n(>10 mL/kg PBW;\nPVPI >3 = permeability)", fillcolor="#a9c2e4"];
    BAL_protein [label="BAL/plasma protein\nratio >0.7\n(permeability oedema)"];
    Lymph_drain [label="Pulmonary lymphatic\ndrainage (limited\nreserve, ~10x)", fillcolor="#e2f0d9"];
  }

  /* ======================================================================
     8. Respiratory mechanics — the 'baby lung'
     ====================================================================== */
  subgraph cluster_mech {
    label="8. Respiratory Mechanics: Aerated 'Baby Lung', Compliance, Recruitability";
    style=filled; color="#c8c8b0"; fillcolor="#f6f6ec"; fontsize=13;
    Aerated_frac [label="AERATED LUNG FRACTION\n('baby lung' — often only\n20-35% of parenchyma)", fillcolor="#e8e8c8"];
    Consolidation [label="Dependent consolidation\n(gravitational\nsuperimposed pressure)"];
    Atelectasis [label="Compression atelectasis\n+ resorption atelectasis\n(high FiO2)"];
    Recruitability [label="Lung recruitability\n(R/I ratio; high in\nindirect ARDS)"];
    Cstat [label="Static compliance Crs\n= Vt / (Pplat − PEEP)", fillcolor="#e8e8c8"];
    Driving_P [label="DRIVING PRESSURE ΔP\n= Vt/Crs (strongest\nventilator mortality signal)", fillcolor="#dede9f"];
    Pplat [label="Plateau pressure\n(target ≤30 cmH2O)"];
    PEEP_set [label="PEEP setting\n(low vs high table ·\nΔP-guided · EIT)", fillcolor="#e8e8c8"];
    Vt_set [label="Tidal volume\n(6 vs 12 mL/kg PBW)", fillcolor="#e8e8c8"];
    RR_set [label="Respiratory rate /\nminute ventilation"];
    Strain [label="Global + regional strain\n(Vt / EELV)"];
    Stress [label="Lung stress\n(transpulmonary pressure,\noesophageal balloon)"];
    Mech_power [label="MECHANICAL POWER\n(J/min; ~12 J/min\nthreshold)", fillcolor="#dede9f"];
    Pendelluft [label="Pendelluft & regional\ninhomogeneity\n(stress raisers ×2)"];
    PSILI [label="P-SILI: vigorous\nspontaneous effort,\nhigh drive"];
  }

  /* ======================================================================
     9. Ventilator-induced lung injury
     ====================================================================== */
  subgraph cluster_vili {
    label="9. Ventilator-Induced Lung Injury (VILI): the Iatrogenic Amplifier";
    style=filled; color="#d6a9a9"; fillcolor="#faeded"; fontsize=13;
    Volutrauma [label="Volutrauma\n(overdistension of the\nbaby lung)", fillcolor="#f0cfcf"];
    Barotrauma [label="Barotrauma\n(pneumothorax ·\npneumomediastinum)"];
    Atelectrauma [label="Atelectrauma\n(cyclic opening/closing,\nshear at interfaces)", fillcolor="#f0cfcf"];
    Ergotrauma [label="Ergotrauma\n(energy load per breath\n× frequency)"];
    Biotrauma [label="BIOTRAUMA: mechano-\ntransduction → NF-κB →\ncytokine release into\nsystemic circulation", fillcolor="#e5b3b3"];
    Mechanotrans [label="Mechanosensors\n(Piezo1 · TRPV4 ·\nintegrin-FAK)"];
    VILI_burden [label="CUMULATIVE VILI\nBURDEN", fillcolor="#dd9c9c"];
    Hyperoxia [label="Hyperoxic injury\n(FiO2 >0.6 prolonged →\nROS, absorption atelectasis)"];
    Hypercapnia [label="Permissive hypercapnia\n(pH 7.15-7.30;\ndual effects)"];
  }

  /* ======================================================================
     10. Gas exchange
     ====================================================================== */
  subgraph cluster_gas {
    label="10. Gas Exchange: Shunt, Dead Space, Oxygenation Indices";
    style=filled; color="#a9c4c4"; fillcolor="#edf6f6"; fontsize=13;
    Shunt [label="Intrapulmonary shunt\nQs/Qt (perfused but\nnot ventilated)", fillcolor="#c8e3e3"];
    VQ_mismatch [label="V/Q heterogeneity"];
    HPV [label="Hypoxic pulmonary\nvasoconstriction\n(blunted by inflammation,\nvasodilators, sepsis)"];
    Diff_limit [label="Diffusion limitation\n(thickened barrier)"];
    PaO2FiO2 [label="PaO2/FiO2 RATIO\n(Berlin: ≤300 mild,\n≤200 moderate, ≤100 severe)", fillcolor="#b0d8d8"];
    OI [label="Oxygenation index\nOI = FiO2×MAP×100/PaO2"];
    VdVt [label="Dead-space fraction\nVd/Vt (>0.6 —\nindependent mortality risk)", fillcolor="#c8e3e3"];
    PaCO2 [label="PaCO2 / ventilatory\nratio"];
    SpO2_target [label="Oxygenation target\n(SpO2 88-95%;\nconservative vs liberal)"];
    Hypoxaemia [label="REFRACTORY\nHYPOXAEMIA", fillcolor="#9ecccc"];
  }

  /* ======================================================================
     11. Right ventricle and haemodynamics
     ====================================================================== */
  subgraph cluster_rv {
    label="11. Pulmonary Circulation & Right Ventricle";
    style=filled; color="#c3b0d3"; fillcolor="#f3eef8"; fontsize=13;
    PVR [label="Pulmonary vascular\nresistance ↑", fillcolor="#ded0ec"];
    Vasc_remod [label="Vascular obliteration,\nthrombosis, remodelling"];
    Hi_PEEP_effect [label="High PEEP / high Pplat\n→ West zone 1-2 →\nRV afterload ↑"];
    Acute_cor_pulm [label="ACUTE COR PULMONALE\n(~20-25% of moderate-\nsevere ARDS)", fillcolor="#cbb6e2"];
    RV_dilat [label="RV dilatation,\nseptal shift,\nLV underfilling"];
    CO_drop [label="Cardiac output ↓ →\nmixed venous O2 ↓ →\nshunt effect amplified"];
    Vasopressor [label="Vasopressor / inotrope\nrequirement"];
    Fluid_resus [label="Fluid resuscitation\n(worsens lung water)"];
  }

  /* ======================================================================
     12. Fibroproliferation vs resolution
     ====================================================================== */
  subgraph cluster_fibro {
    label="12. Late Phase Fork: Fibroproliferation vs Resolution";
    style=filled; color="#b7c9a8"; fillcolor="#f0f5ea"; fontsize=13;
    TGFb [label="TGF-β1 activation\n(αvβ6 integrin on\ninjured epithelium)", fillcolor="#d9e8c8"];
    Smad23 [label="Smad2/3 signalling"];
    Fibroblast [label="Lung fibroblast\nproliferation + migration\n(PDGF · CTGF)"];
    Myofibroblast [label="Myofibroblast\n(α-SMA+) accumulation", fillcolor="#c9dfb0"];
    Collagen [label="Collagen I/III deposition\n(BAL N-terminal\nprocollagen-III peptide)", fillcolor="#c9dfb0"];
    Fibrosis [label="FIBROPROLIFERATIVE\nARDS (after ~day 7-10;\nventilator dependence)", fillcolor="#b5d199"];
    EMT [label="Partial EMT of\ntransitional epithelium"];
    Efferocytosis [label="Efferocytosis of\napoptotic neutrophils\nby M2 macrophages", fillcolor="#e2f0d9"];
    SPM [label="Specialised pro-resolving\nmediators (lipoxin A4,\nresolvin D1, maresin)", fillcolor="#e2f0d9"];
    Treg [label="Tregs (FoxP3+) drive\nepithelial repair\n(amphiregulin)", fillcolor="#e2f0d9"];
    MMP_TIMP [label="MMP/TIMP balance\n(matrix remodelling)"];
    Resolution [label="RESOLUTION: barrier\nrestitution, fluid\nreabsorption, extubation", fillcolor="#a9d3a9"];
    Fibrotic_seq [label="Long-term fibrotic\nsequelae (DLCO↓,\nreticulation on CT)"];
  }

  /* ======================================================================
     13. Extrapulmonary organ crosstalk
     ====================================================================== */
  subgraph cluster_organ {
    label="13. Extrapulmonary Organ Crosstalk & Systemic Consequences";
    style=filled; color="#c9c9c9"; fillcolor="#f2f2f2"; fontsize=13;
    Systemic_spill [label="Systemic cytokine\nspillover from lung\n(biotrauma)", fillcolor="#e0e0e0"];
    AKI [label="Acute kidney injury\n(hypoxaemia · hypercapnia\n· venous congestion)", fillcolor="#e0e0e0"];
    Liver_dys [label="Hepatic dysfunction /\ncongestion"];
    GI_barrier [label="Gut barrier failure →\nbacterial translocation"];
    Brain_dys [label="Sedation load, delirium,\nlong-term cognitive\nimpairment"];
    ICUAW [label="ICU-acquired weakness\n(steroid + NMBA +\nimmobility · diaphragm\natrophy)", fillcolor="#e0e0e0"];
    Hyperglycaemia [label="Steroid-induced\nhyperglycaemia"];
    Nosocomial [label="Ventilator-associated\npneumonia · secondary\ninfection", fillcolor="#e0e0e0"];
    SOFA [label="Non-pulmonary SOFA\nscore", fillcolor="#d0d0d0"];
    Lactate [label="Lactate / tissue\nhypoperfusion"];
  }

  /* ======================================================================
     14. Subphenotypes and heterogeneity of treatment effect
     ====================================================================== */
  subgraph cluster_pheno {
    label="14. Subphenotypes: Hyper- vs Hypo-inflammatory (Latent Class Analysis)";
    style=filled; color="#d9bda1"; fillcolor="#fbf1e8"; fontsize=13;
    LCA [label="Latent class analysis of\nplasma biomarkers +\nclinical variables", fillcolor="#f2ddc6"];
    Hyperinflam [label="HYPERINFLAMMATORY\n(~1/3): IL-6↑↑ sTNFR1↑↑\nPAI-1↑ bicarbonate↓\nshock↑, mortality ~40-50%", fillcolor="#eecdaa"];
    Hypoinflam [label="HYPOINFLAMMATORY\n(~2/3): lower cytokines,\nbetter perfusion,\nmortality ~15-20%", fillcolor="#e2f0d9"];
    HTE [label="Heterogeneity of treatment\neffect (PEEP · fluids ·\nsteroids · statins differ\nby class)", fillcolor="#eecdaa"];
    Parsimonious [label="Parsimonious 3-variable\nclassifier (IL-8, bicarbonate,\nsTNFR1) for prospective\nenrichment"];
    Focal_diffuse [label="Radiological phenotype:\nfocal vs non-focal\n(LIVE trial — mismatched\nstrategy harms)"];
    COVID_pheno [label="COVID-ARDS: near-normal\ncompliance with severe\nshunt (L-type) → H-type"];
  }

  /* ======================================================================
     15. Pharmacology: PK/PD of tested and used agents
     ====================================================================== */
  subgraph cluster_drug {
    label="15. Pharmacotherapy: PK/PD of Agents Tested in ARDS";
    style=filled; color="#a9b8d6"; fillcolor="#eef1fa"; fontsize=13;
    Dexamethasone [label="DEXAMETHASONE IV\n20 mg d1-5 → 10 mg d6-10\n(DEXA-ARDS; RECOVERY\nin COVID)", fillcolor="#cdd8f0"];
    Methylpred [label="Methylprednisolone\n1-2 mg/kg/d taper\n(Meduri; LaSRS caution\nafter day 14)", fillcolor="#cdd8f0"];
    GR_binding [label="Glucocorticoid receptor\n(NR3C1) binding →\ntransrepression of NF-κB /\nAP-1 + transactivation", fillcolor="#cdd8f0"];
    GC_effects [label="↓IL-6/IL-8/TNF ·\n↓neutrophil influx ·\n↑ENaC & Na/K-ATPase ·\n↓TGF-β/collagen"];
    GC_adverse [label="Hyperglycaemia ·\nmyopathy · secondary\ninfection · delayed\nviral clearance"];
    Cisatracurium [label="CISATRACURIUM 37.5 mg/h\n×48 h (ACURASYS benefit;\nROSE neutral with light\nsedation)", fillcolor="#cdd8f0"];
    NMBA_effect [label="Abolished spontaneous\neffort → ΔP↓, pendelluft↓,\nP-SILI↓, VO2↓"];
    Hofmann [label="Hofmann elimination\n(organ-independent,\nt½ ~22 min)"];
    iNO [label="INHALED NITRIC OXIDE\n5-20 ppm", fillcolor="#cdd8f0"];
    iNO_effect [label="Selective vasodilation of\nventilated units → V/Q\nmatch↑, PVR↓; PaO2/FiO2\n+15-25% transiently"];
    iNO_risk [label="No mortality benefit;\nrenal impairment,\nmethaemoglobinaemia,\nrebound"];
    Epoprostenol [label="Inhaled epoprostenol\n(cheaper alternative,\nsame physiology)"];
    Tocilizumab [label="TOCILIZUMAB 8 mg/kg\n(IL-6R blockade —\nCOVID-ARDS: RECOVERY,\nREMAP-CAP)", fillcolor="#cdd8f0"];
    Baricitinib [label="Baricitinib 4 mg PO\n(JAK1/2 inhibition —\nACTT-2, COV-BARRIER)", fillcolor="#cdd8f0"];
    Furosemide [label="Furosemide ± albumin\n(FACTT conservative\nfluid strategy)", fillcolor="#cdd8f0"];
    Beta2 [label="Salbutamol (BALTI-2 —\nHARM: tachyarrhythmia,\nlactataemia)", fillcolor="#f0cfcf"];
    Surfactant_rx [label="Exogenous surfactant\n(effective in neonates,\nNEGATIVE in adults)", fillcolor="#f0cfcf"];
    Statin [label="Simvastatin / rosuvastatin\n(HARP-2, SAILS — neutral\noverall; possible benefit\nin hyperinflammatory)"];
    VitC [label="Vitamin C / thiamine /\nhydrocortisone bundles\n(CITRIS-ALI, VITAMINS —\nno benefit)", fillcolor="#f0cfcf"];
    Sivelestat [label="Sivelestat (neutrophil\nelastase inhibitor —\nSTRIVE stopped for harm)", fillcolor="#f0cfcf"];
    MSC [label="Mesenchymal stromal cells\n(START phase 2a;\nparacrine KGF/Ang-1)"];
    Anticoag [label="Therapeutic-dose heparin\n(benefit in non-critical\nCOVID; not in critical)"];
  }

  /* ======================================================================
     16. Non-pharmacological interventions
     ====================================================================== */
  subgraph cluster_nonpharm {
    label="16. Non-Pharmacological Interventions & Rescue Therapies";
    style=filled; color="#a8ccc0"; fillcolor="#ecf7f3"; fontsize=13;
    LTVV [label="LUNG-PROTECTIVE\nVENTILATION 6 mL/kg PBW,\nPplat ≤30 (ARMA:\n31%→39.8% ARR 8.8%)", fillcolor="#c8e6da"];
    HighPEEP [label="Higher-PEEP strategy\n(ALVEOLI/LOVS/EXPRESS;\nbenefit only if\nrecruitable)", fillcolor="#c8e6da"];
    RM [label="Recruitment manoeuvres\n(ART trial: HARM with\naggressive stepwise RM)", fillcolor="#f0cfcf"];
    Prone [label="PRONE POSITIONING ≥16 h\n(PROSEVA: 32.8%→16.0%\nmortality at 28 d)", fillcolor="#a8ddc9"];
    Prone_mech [label="Prone mechanism: more\nhomogeneous stress/strain,\ndorsal recruitment,\nheart off lung, RV unload"];
    ECMO [label="VV-ECMO (EOLIA; CESAR)\nultraprotective settings", fillcolor="#c8e6da"];
    ECMO_effect [label="Extracorporeal gas exchange\n→ decouples oxygenation\nfrom ventilator → VILI↓"];
    Conservative_fluid [label="Conservative fluid strategy\n(FACTT: +2.5 more\nventilator-free days)", fillcolor="#c8e6da"];
    Sedation [label="Sedation / analgesia depth,\nventilator synchrony"];
    HFNC_NIV [label="HFNC / NIV / helmet CPAP\n(pre-intubation; P-SILI\nrisk if effort high)"];
    Awake_prone [label="Awake prone positioning\n(COVID-19 meta-trial)"];
    ABCDEF [label="Early mobilisation,\nnutrition, ABCDEF bundle"];
  }

  /* ======================================================================
     17. Clinical endpoints
     ====================================================================== */
  subgraph cluster_endpoint {
    label="17. Clinical Endpoints & Long-Term Outcome";
    style=filled; color="#c7a9a9"; fillcolor="#f7eeee"; fontsize=13;
    Berlin [label="Berlin definition class\n(mild/moderate/severe)\n+ Global (Kigali) update", fillcolor="#eed6d6"];
    VFD [label="Ventilator-free days\nat day 28\n(primary endpoint in\nmost ARDS trials)", fillcolor="#e5bebe"];
    Mortality28 [label="28-day / 60-day / hospital\nmortality (~35-46% in\nmoderate-severe)", fillcolor="#dda6a6"];
    ICU_LOS [label="ICU and hospital\nlength of stay"];
    Extubation [label="Successful liberation\nfrom ventilation /\ntracheostomy"];
    PICS [label="Post-intensive care\nsyndrome: 6-min walk↓,\nPTSD/anxiety, cognitive\nimpairment at 1-5 y"];
    QoL [label="Health-related quality\nof life (SF-36),\nreturn to work"];
    Murray [label="Murray lung injury score\n· SOFA respiratory\nsubscore"];
  }

  /* ---------- 1 → 2/3/4: how the insult lands ---------- */
  Pneumonia -> Insult_direct; SARSCoV2 -> Insult_direct; Influenza -> Insult_direct;
  Aspiration -> Insult_direct; Inhalation -> Insult_direct; Contusion -> Insult_direct;
  Drowning -> Insult_direct; Burns -> Insult_direct;
  Sepsis_extra -> Insult_indirect; Pancreatitis -> Insult_indirect;
  Trauma_shock -> Insult_indirect; TRALI -> Insult_indirect;
  Transfusion_load -> Insult_indirect; Drug_toxicity -> Insult_indirect;
  Pneumonia -> PAMP; SARSCoV2 -> PAMP; Influenza -> PAMP; Sepsis_extra -> PAMP;
  Insult_direct -> DAMP; Insult_indirect -> DAMP;
  Aspiration -> DAMP; Contusion -> DAMP; Pancreatitis -> DAMP;
  Genetic_risk -> Perm_K [style=dashed,label="modifier"];
  Alcohol_risk -> Antiox [label="depletes",color="#b03030"];
  Insult_direct -> AT1_necrosis [color="#2f7a2f",penwidth=2];
  Insult_direct -> AT2_apoptosis;
  Insult_indirect -> Endo_cell [color="#33418f",penwidth=2];
  SARSCoV2 -> AT2 [label="ACE2 entry",color="#b03030"];
  SARSCoV2 -> Microthrombi [label="endothelialitis"];
  TRALI -> Neut_margin [label="antibody-primed"];

  /* ---------- 4: innate cascade ---------- */
  PAMP -> TLR4; PAMP -> TLR2_9; DAMP -> TLR4; DAMP -> TLR2_9; DAMP -> NLRP3;
  TLR4 -> MyD88; TLR2_9 -> MyD88; MyD88 -> NFkB; MyD88 -> AP1_MAPK;
  NFkB -> TNFa; NFkB -> IL1b [label="pro-IL-1β"]; NFkB -> IL6; NFkB -> IL8;
  NFkB -> CXCL1_2; NFkB -> CCL2; NFkB -> NLRP3 [label="priming"];
  AP1_MAPK -> IL8; AP1_MAPK -> IL6;
  NLRP3 -> Casp1; Casp1 -> IL1b [color="#b03030",penwidth=2]; Casp1 -> IL18; Casp1 -> GSDMD;
  GSDMD -> Endo_apopt; GSDMD -> AT2_apoptosis;
  AlvMac_res -> NFkB; AlvMac_res -> MAC_M1; Mono_recruit -> MAC_M1;
  CCL2 -> Mono_recruit; MAC_M1 -> TNFa; MAC_M1 -> IL1b; MAC_M1 -> IL6; MAC_M1 -> IL8;
  IL8 -> Neut_margin [color="#b03030",penwidth=2]; CXCL1_2 -> Neut_margin;
  LTB4_dummy_removed [style=invis];
  Complement -> Neut_margin; C5a_note [style=invis];
  ICAM_VCAM -> Neut_margin; Neut_marrow -> Neut_circ; Neut_circ -> Neut_margin;
  Neut_margin -> Neut_alv [color="#b03030",penwidth=2];
  Neut_alv -> NE_MPO; Neut_alv -> NETs; Neut_alv -> ROS_burst;
  Platelet_neut -> NETs; Platelets -> Platelet_neut;
  NE_MPO -> Epi_barrier [label="cleaves TJ",color="#b03030"];
  NE_MPO -> VE_cadherin [label="cleaves",color="#b03030"];
  NETs -> Endo_cell [label="histone cytotoxicity",color="#b03030"];
  NETs -> Microthrombi; ROS_burst -> AT1_necrosis; ROS_burst -> Endo_apopt;
  ROS_burst -> Surf_inactivation; Antiox -> ROS_burst [label="buffers",color="#2f7a2f"];
  Complement -> ROS_burst; PAMP -> Complement; DAMP -> Complement;
  IL17 -> IL8; IFNg -> MAC_M1; IL1b -> IL6; IL1b -> IL8; TNFa -> IL6; TNFa -> ICAM_VCAM;
  IL6 -> JAK_STAT; IFNg -> JAK_STAT; JAK_STAT -> Cytokine_storm;
  TNFa -> Cytokine_storm; IL1b -> Cytokine_storm; IL6 -> Cytokine_storm; IL8 -> Cytokine_storm;
  IL10 -> Cytokine_storm [label="restrains",color="#2f7a2f"];
  IL1RA -> IL1b [label="antagonises",color="#2f7a2f"];
  MAC_M2 -> IL10; GMCSF -> AlvMac_res; GMCSF -> MAC_M2;

  /* ---------- 2/3: barrier failure ---------- */
  AT1_necrosis -> Epi_barrier [color="#b03030",penwidth=2];
  AT2_apoptosis -> Epi_barrier; AT2_apoptosis -> Surfactant_pool;
  AT1_necrosis -> Hyaline_membrane; Fibrin_alv -> Hyaline_membrane;
  AT1 -> Epi_barrier; AT2 -> Epi_barrier; AT2 -> Surfactant_pool; AT2 -> ENaC;
  Epi_barrier -> Claudin4 [dir=none,style=dotted];
  AT2 -> NaK_ATPase; ENaC -> AFC [color="#2f7a2f",penwidth=2];
  NaK_ATPase -> AFC [color="#2f7a2f"]; AQP5 -> AFC; cAMP_epi -> ENaC; cAMP_epi -> NaK_ATPase;
  Epi_barrier -> AFC [color="#2f7a2f"];
  TNFa -> ENaC [label="downregulates",color="#b03030"];
  IL1b -> ENaC [label="downregulates",color="#b03030"];
  Hypoxaemia -> NaK_ATPase [label="impairs",color="#b03030"];
  Surfactant_pool -> Surf_tension [label="lowers",color="#2f7a2f"];
  Surf_inactivation -> Surfactant_pool [color="#b03030"];
  BAL_protein -> Surf_inactivation; Alveolar_flood -> Surf_inactivation;
  Surf_tension -> Atelectasis [color="#b03030",penwidth=2];
  AT1_necrosis -> SPD_RAGE; AT2_apoptosis -> SPD_RAGE;
  AT2 -> AT2_prolif; AT2_prolif -> AT1 [label="repair",color="#2f7a2f",penwidth=2];
  IL22_KGF -> AT2_prolif [color="#2f7a2f"]; TGFb -> Damaged_AT2_state;
  AT2_prolif -> Damaged_AT2_state [style=dashed,label="arrested"];
  Damaged_AT2_state -> Fibrosis;
  Endo_cell -> Glycocalyx; Endo_cell -> VE_cadherin; Endo_cell -> Endo_barrier;
  Glyx_shedding -> Glycocalyx [color="#b03030"]; NE_MPO -> Glyx_shedding; ROS_burst -> Glyx_shedding;
  Glycocalyx -> Endo_barrier [color="#2f7a2f"];
  VEcad_phos -> VE_cadherin [color="#b03030"]; VE_cadherin -> Endo_barrier [color="#2f7a2f"];
  TNFa -> VEcad_phos; Thrombin -> VEcad_phos [label="PAR-1"]; VEGF_lung -> VEcad_phos;
  RhoA_stress -> Endo_barrier [color="#b03030"]; Thrombin -> RhoA_stress; Ang2 -> RhoA_stress;
  Rac1_S1P -> Endo_barrier [color="#2f7a2f"]; Ang1_Tie2 -> Endo_barrier [color="#2f7a2f"];
  Ang2 -> Ang1_Tie2 [label="antagonises",color="#b03030",penwidth=2];
  IL1b -> Ang2; TNFa -> Ang2; Endo_cell -> vWF_plasma; Endo_cell -> Ang2;
  TNFa -> ICAM_VCAM; Endo_apopt -> Endo_barrier [color="#b03030"];
  Endo_barrier -> Perm_K [label="inverse",color="#b03030",penwidth=2];
  Epi_barrier -> Perm_K [label="inverse",color="#b03030",penwidth=2];

  /* ---------- 6: coagulation ---------- */
  MAC_M1 -> TF_alv; AT1_necrosis -> TF_alv; TF_alv -> Thrombin;
  Thrombin -> Fibrin_alv; IL1b -> PAI1; TNFa -> PAI1; Thrombin -> PAI1;
  PAI1 -> Fibrin_alv [label="blocks lysis",color="#b03030",penwidth=2];
  Protein_C -> Thrombin [label="inhibits",color="#2f7a2f"];
  IL6 -> Protein_C [label="reduces",color="#b03030"];
  Fibrin_alv -> Hyaline_membrane; Thrombin -> Microthrombi;
  Microthrombi -> Dead_space_thromb [penwidth=2]; Microthrombi -> PVR;
  Fibrin_alv -> Surf_inactivation; Fibrin_alv -> Fibroblast [label="provisional matrix"];
  Microthrombi -> Platelets;

  /* ---------- 7: flooding ---------- */
  Perm_K -> Filtration [color="#b03030",penwidth=2];
  Pcap -> Filtration; Oncotic -> Filtration [label="opposes",color="#2f7a2f"];
  Fluid_balance -> Pcap [penwidth=2]; Fluid_resus -> Fluid_balance;
  Filtration -> Interstitial_edema; Interstitial_edema -> Alveolar_flood;
  Lymph_drain -> Interstitial_edema [label="drains",color="#2f7a2f"];
  AFC -> Alveolar_flood [label="clears",color="#2f7a2f",penwidth=2];
  Alveolar_flood -> EVLW; Interstitial_edema -> EVLW;
  Perm_K -> BAL_protein; Alveolar_flood -> BAL_protein;
  EVLW -> Consolidation [penwidth=2]; Alveolar_flood -> Consolidation;

  /* ---------- 8: mechanics ---------- */
  Consolidation -> Aerated_frac [label="reduces",color="#b03030",penwidth=2];
  Atelectasis -> Aerated_frac [color="#b03030",penwidth=2];
  Hyaline_membrane -> Aerated_frac [color="#b03030"];
  Aerated_frac -> Cstat [color="#2f7a2f",penwidth=2];
  Vt_set -> Driving_P; Cstat -> Driving_P [label="inverse",color="#b03030",penwidth=2];
  Driving_P -> Pplat; PEEP_set -> Pplat; Vt_set -> Strain; Aerated_frac -> Strain [label="inverse"];
  Strain -> Stress; PEEP_set -> Atelectasis [label="prevents",color="#2f7a2f",penwidth=2];
  PEEP_set -> Recruitability [dir=none,style=dotted]; Recruitability -> Aerated_frac [color="#2f7a2f"];
  Vt_set -> Mech_power [penwidth=2]; RR_set -> Mech_power [penwidth=2];
  Driving_P -> Mech_power; PEEP_set -> Mech_power; RR_set -> PaCO2 [label="lowers",color="#2f7a2f"];
  Pendelluft -> Stress; PSILI -> Pendelluft; PSILI -> Strain;
  Sedation -> PSILI [label="suppresses",color="#2f7a2f"];

  /* ---------- 9: VILI ---------- */
  Strain -> Volutrauma [penwidth=2]; Stress -> Volutrauma; Pplat -> Barotrauma;
  Atelectasis -> Atelectrauma [penwidth=2]; PEEP_set -> Atelectrauma [label="reduces",color="#2f7a2f"];
  Mech_power -> Ergotrauma [penwidth=2];
  Volutrauma -> VILI_burden [penwidth=2]; Atelectrauma -> VILI_burden [penwidth=2];
  Barotrauma -> VILI_burden; Ergotrauma -> VILI_burden;
  Volutrauma -> Mechanotrans; Atelectrauma -> Mechanotrans; Mechanotrans -> Biotrauma;
  Biotrauma -> NFkB [color="#b03030",penwidth=2];
  VILI_burden -> Epi_barrier [color="#b03030",penwidth=2];
  VILI_burden -> Endo_barrier [color="#b03030",penwidth=2];
  VILI_burden -> Biotrauma;
  Biotrauma -> Systemic_spill [penwidth=2];
  Hyperoxia -> ROS_burst [penwidth=2]; Hyperoxia -> Atelectasis [label="absorption"];
  SpO2_target -> Hyperoxia [label="liberal targets",color="#b03030"];
  Hypercapnia -> PVR; Hypercapnia -> Biotrauma [label="attenuates",color="#2f7a2f",style=dashed];

  /* ---------- 10: gas exchange ---------- */
  Alveolar_flood -> Shunt [penwidth=2]; Consolidation -> Shunt [penwidth=2];
  Atelectasis -> Shunt [penwidth=2];
  HPV -> Shunt [label="limits",color="#2f7a2f",penwidth=2];
  Cytokine_storm -> HPV [label="blunts",color="#b03030"];
  VQ_mismatch -> PaO2FiO2 [color="#b03030"]; Shunt -> PaO2FiO2 [label="inverse",color="#b03030",penwidth=2];
  Diff_limit -> PaO2FiO2; Interstitial_edema -> Diff_limit;
  Shunt -> Hypoxaemia [penwidth=2]; PaO2FiO2 -> Hypoxaemia [label="inverse"];
  PaO2FiO2 -> Berlin [penwidth=2]; PaO2FiO2 -> OI; PEEP_set -> OI;
  Dead_space_thromb -> VdVt [penwidth=2]; Aerated_frac -> VdVt [label="inverse"];
  VdVt -> PaCO2 [penwidth=2]; VdVt -> Mortality28 [penwidth=2,color="#b03030"];
  PaCO2 -> Hypercapnia; PaCO2 -> PVR; Hypoxaemia -> PVR [label="HPV"];
  PaO2FiO2 -> Murray; Cstat -> Murray; PEEP_set -> Murray;
  CO_drop -> Shunt [label="↓SvO2 amplifies",color="#b03030"];

  /* ---------- 11: RV ---------- */
  Vasc_remod -> PVR; PVR -> Acute_cor_pulm [penwidth=2];
  Hi_PEEP_effect -> PVR [penwidth=2]; PEEP_set -> Hi_PEEP_effect; Pplat -> Hi_PEEP_effect;
  Acute_cor_pulm -> RV_dilat; RV_dilat -> CO_drop [penwidth=2];
  CO_drop -> Vasopressor; CO_drop -> Lactate; Vasopressor -> SOFA;
  CO_drop -> AKI; RV_dilat -> Liver_dys [label="congestion"];
  Fluid_resus -> RV_dilat [label="preload"];

  /* ---------- 12: late fork ---------- */
  Epi_barrier -> TGFb [label="αvβ6 on injured epi",color="#b03030"];
  IL1b -> TGFb; Thrombin -> TGFb; VILI_burden -> TGFb;
  TGFb -> Smad23; Smad23 -> Fibroblast; Smad23 -> Myofibroblast;
  Fibroblast -> Myofibroblast; Myofibroblast -> Collagen [penwidth=2];
  Collagen -> Fibrosis [penwidth=2]; EMT -> Myofibroblast; TGFb -> EMT;
  Fibrin_alv -> Fibroblast; MMP_TIMP -> Collagen [dir=none,style=dotted];
  Fibrosis -> Cstat [label="stiffens",color="#b03030",penwidth=2];
  Fibrosis -> VdVt; Fibrosis -> Fibrotic_seq; Fibrosis -> Extubation [label="delays",color="#b03030"];
  Neut_alv -> Efferocytosis [dir=none,style=dotted];
  MAC_M2 -> Efferocytosis [color="#2f7a2f",penwidth=2];
  Efferocytosis -> Neut_alv [label="clears",color="#2f7a2f",penwidth=2];
  MAC_M1 -> MAC_M2 [label="phenotype switch",style=dashed];
  SPM -> MAC_M2 [color="#2f7a2f"]; SPM -> Neut_margin [label="stops influx",color="#2f7a2f"];
  Treg -> Resolution [color="#2f7a2f"]; Treg -> AT2_prolif [label="amphiregulin",color="#2f7a2f"];
  IL10 -> MAC_M2 [color="#2f7a2f"];
  Efferocytosis -> Resolution [color="#2f7a2f",penwidth=2];
  AT2_prolif -> Resolution [color="#2f7a2f",penwidth=2];
  AFC -> Resolution [color="#2f7a2f",penwidth=2];
  Resolution -> Extubation [color="#2f7a2f",penwidth=2];
  Resolution -> Fibrosis [label="competing fate",dir=both,style=dashed];

  /* ---------- 13: organ crosstalk ---------- */
  Systemic_spill -> AKI [penwidth=2]; Systemic_spill -> Liver_dys; Systemic_spill -> GI_barrier;
  Hypoxaemia -> AKI; Hypercapnia -> AKI; GI_barrier -> Sepsis_extra [style=dashed,label="second hit"];
  Sedation -> Brain_dys; Sedation -> ICUAW; Cisatracurium -> ICUAW;
  GC_adverse -> ICUAW; GC_adverse -> Hyperglycaemia; GC_adverse -> Nosocomial;
  Nosocomial -> PAMP [style=dashed,label="second hit",color="#b03030"];
  AKI -> SOFA [penwidth=2]; Liver_dys -> SOFA; Lactate -> SOFA; Vasopressor -> SOFA;
  AKI -> Fluid_balance [label="oliguria"]; SOFA -> Mortality28 [penwidth=2,color="#b03030"];
  ICUAW -> PICS; Brain_dys -> PICS;

  /* ---------- 14: subphenotypes ---------- */
  IL6 -> LCA; IL8 -> LCA; TNFa -> LCA; PAI1 -> LCA; Lactate -> LCA; Vasopressor -> LCA;
  LCA -> Hyperinflam; LCA -> Hypoinflam; LCA -> Parsimonious;
  Hyperinflam -> Mortality28 [color="#b03030",penwidth=2];
  Hyperinflam -> HTE; Hypoinflam -> HTE; Focal_diffuse -> HTE; COVID_pheno -> HTE;
  HTE -> Dexamethasone [style=dashed,label="effect modifier"];
  HTE -> HighPEEP [style=dashed]; HTE -> Conservative_fluid [style=dashed];
  HTE -> Statin [style=dashed]; SARSCoV2 -> COVID_pheno;
  Focal_diffuse -> Recruitability;

  /* ---------- 15: drug actions ---------- */
  Dexamethasone -> GR_binding [penwidth=2]; Methylpred -> GR_binding [penwidth=2];
  GR_binding -> GC_effects [penwidth=2]; GR_binding -> GC_adverse;
  GC_effects -> NFkB [label="transrepression",color="#2f7a2f",penwidth=2];
  GC_effects -> IL6 [color="#2f7a2f"]; GC_effects -> IL8 [color="#2f7a2f"];
  GC_effects -> TNFa [color="#2f7a2f"]; GC_effects -> Neut_margin [color="#2f7a2f"];
  GC_effects -> ENaC [label="upregulates",color="#2f7a2f",penwidth=2];
  GC_effects -> NaK_ATPase [color="#2f7a2f"];
  GC_effects -> TGFb [label="↓ late fibrosis",color="#2f7a2f"];
  GC_effects -> Collagen [color="#2f7a2f"];
  Cisatracurium -> Hofmann [dir=none,style=dotted];
  Cisatracurium -> NMBA_effect [penwidth=2];
  NMBA_effect -> PSILI [color="#2f7a2f",penwidth=2];
  NMBA_effect -> Driving_P [label="lowers",color="#2f7a2f"];
  NMBA_effect -> Biotrauma [color="#2f7a2f"];
  iNO -> iNO_effect [penwidth=2]; Epoprostenol -> iNO_effect;
  iNO_effect -> HPV [label="redistributes flow",color="#2f7a2f"];
  iNO_effect -> Shunt [label="reduces",color="#2f7a2f",penwidth=2];
  iNO_effect -> PVR [label="lowers",color="#2f7a2f",penwidth=2];
  iNO -> iNO_risk; iNO_risk -> AKI;
  Tocilizumab -> IL6 [label="IL-6R blockade",color="#2f7a2f",penwidth=2];
  Tocilizumab -> JAK_STAT [color="#2f7a2f"];
  Baricitinib -> JAK_STAT [color="#2f7a2f",penwidth=2];
  Furosemide -> Fluid_balance [label="negative balance",color="#2f7a2f",penwidth=2];
  Conservative_fluid -> Furosemide;
  Beta2 -> cAMP_epi [label="theoretical AFC↑"];
  Beta2 -> CO_drop [label="tachyarrhythmia",color="#b03030"];
  Surfactant_rx -> Surfactant_pool [style=dashed,label="negative trials"];
  Statin -> NFkB [style=dashed,color="#2f7a2f"];
  VitC -> ROS_burst [style=dashed,color="#2f7a2f"];
  Sivelestat -> NE_MPO [style=dashed,color="#2f7a2f"];
  MSC -> IL22_KGF [color="#2f7a2f"]; MSC -> Ang1_Tie2 [color="#2f7a2f"];
  MSC -> AFC [color="#2f7a2f"];
  Anticoag -> Microthrombi [color="#2f7a2f",style=dashed];

  /* ---------- 16: non-pharmacological ---------- */
  LTVV -> Vt_set [label="6 mL/kg PBW",penwidth=2,color="#2f7a2f"];
  LTVV -> Driving_P [color="#2f7a2f",penwidth=2];
  LTVV -> VILI_burden [label="the single largest\nmortality benefit",color="#2f7a2f",penwidth=3];
  HighPEEP -> PEEP_set [penwidth=2]; RM -> Aerated_frac [style=dashed];
  RM -> CO_drop [label="haemodynamic harm",color="#b03030"];
  Prone -> Prone_mech [penwidth=2];
  Prone_mech -> Aerated_frac [label="dorsal recruitment",color="#2f7a2f",penwidth=2];
  Prone_mech -> Strain [label="homogenises",color="#2f7a2f",penwidth=2];
  Prone_mech -> Shunt [color="#2f7a2f",penwidth=2];
  Prone_mech -> Acute_cor_pulm [label="RV unloading",color="#2f7a2f"];
  Prone -> Mortality28 [label="PROSEVA ARR 16.8%",color="#2f7a2f",penwidth=3];
  ECMO -> ECMO_effect [penwidth=2];
  ECMO_effect -> Vt_set [label="ultraprotective",color="#2f7a2f"];
  ECMO_effect -> Mech_power [color="#2f7a2f",penwidth=2];
  ECMO_effect -> Hypoxaemia [label="rescue",color="#2f7a2f",penwidth=2];
  Conservative_fluid -> Fluid_balance [color="#2f7a2f",penwidth=2];
  Conservative_fluid -> VFD [label="+2.5 days",color="#2f7a2f"];
  HFNC_NIV -> PSILI [label="risk if effort high",color="#b03030"];
  Awake_prone -> Prone_mech; ABCDEF -> ICUAW [label="reduces",color="#2f7a2f"];
  Sedation -> ABCDEF [dir=none,style=dotted];

  /* ---------- 17: endpoints ---------- */
  Berlin -> Mortality28; Hypoxaemia -> Mortality28 [penwidth=2,color="#b03030"];
  Driving_P -> Mortality28 [label="ΔP>15 → risk↑",color="#b03030",penwidth=2];
  Mech_power -> Mortality28 [color="#b03030"];
  Extubation -> VFD [color="#2f7a2f",penwidth=2];
  VILI_burden -> Mortality28 [color="#b03030",penwidth=2];
  Fibrosis -> Mortality28 [color="#b03030"];
  Mortality28 -> ICU_LOS [dir=none,style=dotted];
  Extubation -> ICU_LOS; ICU_LOS -> PICS; PICS -> QoL;
  Murray -> Berlin [dir=none,style=dotted];
  EVLW -> Mortality28 [color="#b03030"];
  Resolution -> Mortality28 [label="survival",color="#2f7a2f",penwidth=2];
}
