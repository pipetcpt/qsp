digraph RHABDO_QSP_Model {
  graph [
    label=<<B>Rhabdomyolysis-Induced Acute Kidney Injury — QSP Mechanistic Map</B><BR/><FONT POINT-SIZE="14">Tubular toxic exposure is a PRODUCT of three terms — filtered myoglobin load ÷ urine flow × f<SUB>diss</SUB>(urine pH) — and the three standard therapies each move exactly ONE of them,<BR/>so the marginal value of each falls as the others succeed. One pressure variable (ΔP = MAP − P<SUB>compartment</SUB>) gates TWO opposite processes: necrosis needs ischaemia, washout needs perfusion.<BR/>One release drives TWO clocks: creatine kinase (t½ ≈ 36 h) integrates the insult while myoglobin (t½ ≈ 2.4 h) tracks its instantaneous rate — which is why the number the clinician sees peaks a day late.</FONT>>
    labelloc=t fontsize=22 fontname="Helvetica"
    rankdir=LR bgcolor="#F7F8FA"
    splines=spline nodesep=0.30 ranksep=1.00
    newrank=true compound=true
  ]
  node [fontname="Helvetica" fontsize=10 style="filled,rounded" shape=box margin="0.14,0.05"]
  edge [fontname="Helvetica" fontsize=8 arrowsize=0.65 color="#5A6270"]

  //=========================================================
  // 1 : AETIOLOGY — many causes, two entry points only
  //=========================================================
  subgraph cluster_aeti {
    label="⚡ Aetiology — every cause enters through one of only TWO doors: mechanical/ischaemic or metabolic/toxic"
    style=filled fillcolor="#FFEBEE" color="#B71C1C" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    A_crush   [label="Crush / entrapment\nEarthquake · building collapse\n(bilateral limbs ≈ 6–12 kg at risk)" fillcolor="#FFCDD2" color="#B71C1C"]
    A_immob   [label="Prolonged immobilisation\n\"found down\" · coma · restraint\npressure necrosis of dependent muscle" fillcolor="#FFCDD2" color="#B71C1C"]
    A_isch    [label="Arterial occlusion / tourniquet\nembolism · vascular clamp\nreperfusion after revascularisation" fillcolor="#FFCDD2" color="#B71C1C"]
    A_exert   [label="Exertional rhabdomyolysis\nmilitary recruits · athletes\nheat + dehydration + unaccustomed load" fillcolor="#FFCDD2" color="#B71C1C"]
    A_statin  [label="Statin ± CYP3A4 inhibitor\nfibrate co-prescription\n(exposure-driven myotoxicity)" fillcolor="#FFCDD2" color="#B71C1C"]
    A_drug    [label="Other drug / toxin\nalcohol · cocaine · propofol\nantipsychotics (NMS) · snake venom" fillcolor="#FFCDD2" color="#B71C1C"]
    A_mh      [label="Malignant hyperthermia\nRYR1 / CACNA1S variant\nvolatile agent + suxamethonium" fillcolor="#FFCDD2" color="#B71C1C"]
    A_gen     [label="Metabolic myopathy\nCPT-II · McArdle · VLCAD\nsickle-cell trait (exertional)" fillcolor="#FFCDD2" color="#B71C1C"]
    A_sz      [label="Status epilepticus / agitation\nsustained tetanic contraction" fillcolor="#FFCDD2" color="#B71C1C"]
    A_inf     [label="Sepsis · influenza · burns\ndirect myotoxicity + hypoperfusion" fillcolor="#FFCDD2" color="#B71C1C"]
    A_elec    [label="Severe hypokalaemia / hypophosphataemia\nimpairs myocyte energetics" fillcolor="#FFCDD2" color="#B71C1C"]
    A_mech    [label="DOOR 1 — mechanical / ischaemic\nnecrosis rate = k·M_ischaemic·gate(ΔP)" shape=diamond fillcolor="#E57373" color="#7F0000" fontcolor="white"]
    A_meta    [label="DOOR 2 — metabolic / toxic\nnecrosis rate = primary(t)" shape=diamond fillcolor="#E57373" color="#7F0000" fontcolor="white"]
  }

  //=========================================================
  // 2 : MYOCYTE — how a cell dies
  //=========================================================
  subgraph cluster_myo {
    label="🔬 Myocyte energetic failure — the final common path is cytosolic Ca²⁺"
    style=filled fillcolor="#FFF3E0" color="#E65100" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    M_atp    [label="ATP depletion\nO₂ supply < demand" fillcolor="#FFE0B2" color="#E65100"]
    M_nak    [label="Na⁺/K⁺-ATPase failure\nintracellular Na⁺ ↑" fillcolor="#FFE0B2" color="#E65100"]
    M_ncx    [label="Na⁺/Ca²⁺ exchanger reverses\nCa²⁺ influx" fillcolor="#FFE0B2" color="#E65100"]
    M_serca  [label="SERCA / Ca²⁺-ATPase failure\nSR cannot re-sequester Ca²⁺" fillcolor="#FFE0B2" color="#E65100"]
    M_ryr    [label="RyR1 Ca²⁺ leak\n★ dantrolene's target" fillcolor="#FFCC80" color="#BF360C"]
    M_cai    [label="Cytosolic Ca²⁺ ↑↑\n(the convergence node)" shape=diamond fillcolor="#FFB74D" color="#BF360C"]
    M_calp   [label="Calpain activation\ncytoskeletal proteolysis" fillcolor="#FFE0B2" color="#E65100"]
    M_pla2   [label="Phospholipase A₂\nmembrane phospholipid hydrolysis" fillcolor="#FFE0B2" color="#E65100"]
    M_mpt    [label="Mitochondrial permeability\ntransition · cytochrome c release" fillcolor="#FFE0B2" color="#E65100"]
    M_ros    [label="Myocyte ROS burst\nxanthine oxidase · NADPH oxidase" fillcolor="#FFE0B2" color="#E65100"]
    M_sarco  [label="Sarcolemmal rupture\nloss of compartmentalisation" fillcolor="#FFAB91" color="#BF360C"]
    M_nec    [label="NECROTIC MUSCLE POOL\nM_nec (kg) — loaded but not yet released" shape=box3d fillcolor="#FF8A65" color="#7F0000" fontcolor="white"]
    M_via    [label="Viable-but-ischaemic pool\nM_isch (kg) — still salvageable" shape=box3d fillcolor="#FFCC80" color="#BF360C"]
  }

  //=========================================================
  // 3 : THE PRESSURE NODE — one variable, two gates
  //=========================================================
  subgraph cluster_press {
    label="🔒 THE PRESSURE NODE — ΔP gates necrosis and washout in OPPOSITE directions"
    style=filled fillcolor="#EDE7F6" color="#4527A0" penwidth=3 fontsize=13 fontname="Helvetica-Bold"

    P_ext   [label="External compression P_ext\n≈150 mmHg while entrapped\n→ 0 at extrication" fillcolor="#D1C4E9" color="#4527A0"]
    P_seq   [label="Third-space sequestration M_seq (L)\ncapillary leak into injured muscle\ntarget ≈ 0.7 L per kg necrotic" fillcolor="#D1C4E9" color="#4527A0"]
    P_comp  [label="Fascial compliance C\ntight compartment ≈0.010 L/mmHg\nfasciotomy × 12" fillcolor="#D1C4E9" color="#4527A0"]
    P_pcomp [label="P_compartment\n= P₀ + f·M_seq/C + P_ext" shape=diamond fillcolor="#B39DDB" color="#311B92"]
    P_map   [label="MAP\n(falls with plasma volume)" fillcolor="#D1C4E9" color="#4527A0"]
    P_dp    [label="ΔP = MAP − P_compartment\n★ the single gating variable\n(fasciotomy threshold ΔP < 30 mmHg)" shape=diamond fillcolor="#9575CD" color="#311B92" fontcolor="white"]
    P_g1    [label="GATE 1 — ischaemia gate\nhigh when ΔP < 30\n→ MORE necrosis" shape=hexagon fillcolor="#7E57C2" color="#311B92" fontcolor="white"]
    P_g2    [label="GATE 2 — washout gate\n= 1 − gate 1\n→ MORE release into blood" shape=hexagon fillcolor="#7E57C2" color="#311B92" fontcolor="white"]
    P_paradox [label="THE EXTRICATION PARADOX\nEntrapped: gate 1 on, gate 2 off →\nmuscle dies but stays silent.\nExtrication flips both → the\n\"smiling death\" K⁺/myoglobin surge" shape=note fillcolor="#FFF9C4" color="#F57F17"]
    P_fasc  [label="FASCIOTOMY\nsaves limb, opens gate 2\n→ renal load ↑ (real trade-off)" fillcolor="#C5CAE9" color="#1A237E"]
  }

  //=========================================================
  // 4 : RELEASE AND THE TWO CLOCKS
  //=========================================================
  subgraph cluster_rel {
    label="⏱ Release and the TWO CLOCKS — same flux, two half-lives, two different stories"
    style=filled fillcolor="#E8F5E9" color="#1B5E20" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    R_lys   [label="Lysis flux = k_lys · M_nec · gate 2\n(the ONE release process)" shape=diamond fillcolor="#A5D6A7" color="#1B5E20"]
    R_ck    [label="CLOCK 1 — Creatine kinase\n86 kDa · NOT filtered · t½ ≈ 36 h\nan INTEGRATOR of the insult\npeak 24–72 h" shape=box3d fillcolor="#81C784" color="#1B5E20"]
    R_mb    [label="CLOCK 2 — Myoglobin\n17.8 kDa · freely filtered · t½ ≈ 2.4 h\ntracks the INSTANTANEOUS rate\npeak ≈ 12 h, often already gone at triage" shape=box3d fillcolor="#66BB6A" color="#1B5E20" fontcolor="white"]
    R_lag   [label="THE LAG IS THE PROBLEM\nCK peaks ≈26 h AFTER myoglobin.\nThe toxin is set by clock 2;\nthe number ordered is on clock 1." shape=note fillcolor="#FFF9C4" color="#F57F17"]
    R_k     [label="K⁺  ≈100 mmol per kg muscle\n(6 kg ⇒ ≈600 mmol)" fillcolor="#A5D6A7" color="#1B5E20"]
    R_po4   [label="Phosphate ≈30 mmol/kg" fillcolor="#A5D6A7" color="#1B5E20"]
    R_crn   [label="Creatine ≈3.9 g/kg\n→ non-enzymatic → creatinine" fillcolor="#A5D6A7" color="#1B5E20"]
    R_ur    [label="Purines → urate ≈0.4 g/kg" fillcolor="#A5D6A7" color="#1B5E20"]
    R_acid  [label="Strong acid ≈9 mmol/kg\nlactate · sulphate · phosphate" fillcolor="#A5D6A7" color="#1B5E20"]
    R_other [label="LDH · AST · aldolase · CA-III\n(companion markers, same flux)" fillcolor="#C8E6C9" color="#1B5E20"]
    R_damp  [label="DAMPs: HMGB1 · mtDNA\nhistones · F-actin" fillcolor="#C8E6C9" color="#1B5E20"]
    R_deb   [label="Necrotic DEBRIS pool M_deb\nscaffold for Ca–PO₄ deposition;\ncleared by macrophages over 1–2 wk" shape=box3d fillcolor="#C8E6C9" color="#1B5E20"]
  }

  //=========================================================
  // 5 : VOLUME AND SYSTEMIC HAEMODYNAMICS
  //=========================================================
  subgraph cluster_vol {
    label="💧 Volume — the injured muscle is a sink that competes with the kidney for the fluid you give"
    style=filled fillcolor="#E1F5FE" color="#01579B" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    V_ecf   [label="Functional ECF volume\n(drives haemodynamics)" shape=box3d fillcolor="#B3E5FC" color="#01579B"]
    V_icf   [label="Intracellular water 28 L\nosmotic buffer that bounds\nplasma tonicity" shape=box3d fillcolor="#B3E5FC" color="#01579B"]
    V_pv    [label="Plasma volume ≈0.22 × ECF" fillcolor="#B3E5FC" color="#01579B"]
    V_shift [label="ICF ⇄ ECF water shift\n∝ (2·[Na⁺] + mannitol − ICF tonicity)" shape=diamond fillcolor="#81D4FA" color="#01579B"]
    V_raas  [label="RAAS · ADH · sympathetic\navid Na⁺/water retention" fillcolor="#B3E5FC" color="#01579B"]
    V_press [label="Pressure natriuresis / diuresis\nFE_H2O rises steeply with expansion" fillcolor="#B3E5FC" color="#01579B"]
    V_insen [label="Insensible loss ≈1 L/day\n(higher with fever/heat)" fillcolor="#E1F5FE" color="#01579B"]
    V_over  [label="FLUID OVERLOAD\nif you keep infusing into anuria:\npulmonary oedema" fillcolor="#FFCDD2" color="#B71C1C"]
  }

  //=========================================================
  // 6 : GLOMERULUS AND TUBULAR HANDLING OF MYOGLOBIN
  //=========================================================
  subgraph cluster_glom {
    label="🩺 Filtration and tubular handling — a saturable transporter splits ONE load into TWO toxic arms"
    style=filled fillcolor="#FFFDE7" color="#F57F17" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    G_gfr   [label="GFR = GFR_max · nephron mass\n· perfusion · (1 − obstruction)" shape=diamond fillcolor="#FFF59D" color="#F57F17"]
    G_siev  [label="Glomerular sieving σ ≈ 0.75\nmyoglobin is freely filtered" fillcolor="#FFF9C4" color="#F57F17"]
    G_fl    [label="Filtered load\nFL = GFR × [Mb] × σ  (mg/h)" shape=diamond fillcolor="#FFF59D" color="#F57F17"]
    G_meg   [label="Megalin / cubilin endocytosis\nSATURABLE: Tm ≈ 40 mg/h whole kidney\nReab = FL/(1 + FL/Tm)" fillcolor="#FFF176" color="#F57F17"]
    G_arm1  [label="ARM A — what IS reabsorbed\nheme inside proximal tubule cells.\nPer-cell burden = Reab ÷ nephron mass\n→ survivors inherit the dead ones' share" shape=hexagon fillcolor="#FFEE58" color="#F57F17"]
    G_exc   [label="ARM B — what is NOT reabsorbed\nspills distally: Exc = FL − Reab" shape=hexagon fillcolor="#FFEE58" color="#F57F17"]
    G_cdist [label="Distal concentration\nC_distal = Exc ÷ Q_urine\n★ where flow enters the arithmetic" shape=diamond fillcolor="#FFF176" color="#F57F17"]
    G_mburia [label="Dipstick myoglobinuria appears only\nonce Tm is exceeded — 20–50% of\ntrue rhabdomyolysis tests negative" shape=note fillcolor="#FFF9C4" color="#F57F17"]
    G_q     [label="Urine flow Q\n= FE_H2O·GFR + osmotic + diuretic" shape=diamond fillcolor="#FFF176" color="#F57F17"]
  }

  //=========================================================
  // 7 : HEME CHEMISTRY AND pH
  //=========================================================
  subgraph cluster_heme {
    label="🧪 Heme chemistry — pH decides how much of the myoglobin becomes a toxin"
    style=filled fillcolor="#FCE4EC" color="#880E4F" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    H_ph    [label="Urine pH\n4.6 (max acid) → 7.8 (max alkali)" shape=diamond fillcolor="#F8BBD0" color="#880E4F"]
    H_fdiss [label="f_diss(pH) — ferrihaemate release\nsigmoid, midpoint pH 5.9\npH 5.5 → 0.82   pH 6.5 → 0.09\n★ 9-fold on one unit of pH" shape=diamond fillcolor="#F48FB1" color="#880E4F"]
    H_ferri [label="Ferrihaemate / met-myoglobin\nglobin–heme dissociation" fillcolor="#F8BBD0" color="#880E4F"]
    H_fe    [label="Labile Fe²⁺ released\nlysosomal + cytosolic" fillcolor="#F8BBD0" color="#880E4F"]
    H_fent  [label="Fenton / Haber-Weiss\n·OH generation" fillcolor="#F8BBD0" color="#880E4F"]
    H_redox [label="Myoglobin redox cycling\nferryl (Fe⁴⁺=O) intermediate\nprotein radical" fillcolor="#F8BBD0" color="#880E4F"]
    H_lipid [label="Lipid peroxidation\nF₂-isoprostanes ↑" fillcolor="#F8BBD0" color="#880E4F"]
    H_ho1   [label="Heme oxygenase-1 induction\nprotective: degrades heme" fillcolor="#C8E6C9" color="#1B5E20"]
    H_fer   [label="Ferritin sequestration\nprotective: buffers Fe²⁺" fillcolor="#C8E6C9" color="#1B5E20"]
    H_gsh   [label="Glutathione / thiol pool\nprotective, depletable" fillcolor="#C8E6C9" color="#1B5E20"]
    H_ptcd  [label="Proximal tubular cell death\napoptosis + necrosis + ferroptosis" fillcolor="#EF9A9A" color="#B71C1C"]
  }

  //=========================================================
  // 8 : CAST PHYSICS
  //=========================================================
  subgraph cluster_cast {
    label="🧱 Cast physics — a concentration-SQUARED process, so flow is worth more than it looks"
    style=filled fillcolor="#EFEBE9" color="#3E2723" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    C_thp   [label="Tamm-Horsfall protein / uromodulin\nthick ascending limb secretion" fillcolor="#D7CCC8" color="#3E2723"]
    C_agg   [label="Mb–THP co-aggregation\nf_agg(pH): maximal below pH 5.6" shape=diamond fillcolor="#BCAAA4" color="#3E2723"]
    C_form  [label="Cast formation ∝ C_distal² · f_agg(pH)\n★ SQUARED — halving concentration\nquarters the formation rate" shape=diamond fillcolor="#A1887F" color="#3E2723" fontcolor="white"]
    C_urate [label="Urate crystals\nsolubility = 6.5·(1+10^(pH−5.75)) mg/dL\npH 5.0 → 7.7 · pH 6.5 → 43 mg/dL" fillcolor="#D7CCC8" color="#3E2723"]
    C_capo  [label="Ca–HPO₄ crystals\nHPO₄²⁻ fraction rises above pH 6.8\npH 6.5 → 0.33 · pH 7.4 → 0.80" fillcolor="#D7CCC8" color="#3E2723"]
    C_burd  [label="Intratubular cast burden" shape=box3d fillcolor="#BCAAA4" color="#3E2723"]
    C_obst  [label="Obstruction → tubular pressure ↑\n→ back-leak, GFR ↓" shape=diamond fillcolor="#A1887F" color="#3E2723" fontcolor="white"]
    C_diss  [label="Clearance by flow\n∝ cast · (Q/Q₀)^0.7 — slow (t½ days)\nprevention ≫ reversal" fillcolor="#D7CCC8" color="#3E2723"]
    C_opt   [label="THE pH OPTIMUM IS DERIVED\nAcid → ferrihaemate + urate crystals.\nAlkaline → Ca–HPO₄ crystals.\nComposite minimum at urine pH ≈6.6\n— which is the guideline target" shape=note fillcolor="#FFF9C4" color="#F57F17"]
  }

  //=========================================================
  // 9 : VASOCONSTRICTION / ISCHAEMIA ARM
  //=========================================================
  subgraph cluster_vaso {
    label="🩸 Arm C — renal vasoconstriction and medullary hypoxia"
    style=filled fillcolor="#E0F2F1" color="#004D40" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    W_no    [label="Myoglobin scavenges NO\n(loses the vasodilator brake)" fillcolor="#B2DFDB" color="#004D40"]
    W_et1   [label="Endothelin-1 ↑" fillcolor="#B2DFDB" color="#004D40"]
    W_txa2  [label="Thromboxane A₂ ↑" fillcolor="#B2DFDB" color="#004D40"]
    W_iso   [label="F₂-isoprostanes\n(vasoconstrictor as well as marker)" fillcolor="#B2DFDB" color="#004D40"]
    W_rbf   [label="Renal blood flow ↓\ncortical and medullary" shape=diamond fillcolor="#80CBC4" color="#004D40"]
    W_hyp   [label="Outer medullary hypoxia\nS3 segment is the watershed" fillcolor="#80CBC4" color="#004D40"]
    W_arm3  [label="ARM C — ischaemic injury\n= (1 − perfusion) + 0.5·volume deficit" shape=hexagon fillcolor="#4DB6AC" color="#004D40" fontcolor="white"]
  }

  //=========================================================
  // 10 : INJURY INTEGRATION, REPAIR, FIBROSIS
  //=========================================================
  subgraph cluster_inj {
    label="⚙️ Injury integration — THREE PARALLEL ARMS ADD, which is why blocking one has a ceiling"
    style=filled fillcolor="#FFEBEE" color="#C62828" penwidth=3 fontsize=13 fontname="Helvetica-Bold"

    I_sum   [label="Total injury drive\n= w_H·ARM A + w_C·ARM B + w_I·ARM C + iatrogenic\n★ ADDITIVE: 95% block of one arm\nremoves only that arm's share" shape=diamond fillcolor="#EF9A9A" color="#B71C1C"]
    I_tubi  [label="Sublethal tubular injury (recoverable)\nTUBI ∈ [0,1]" shape=box3d fillcolor="#FFCDD2" color="#B71C1C"]
    I_death [label="Nephron loss flux\n∝ TUBI² × nephron mass" shape=diamond fillcolor="#E57373" color="#7F0000" fontcolor="white"]
    I_neph  [label="FUNCTIONAL NEPHRON MASS\n(the state that becomes eGFR)" shape=box3d fillcolor="#FFAB91" color="#7F0000"]
    I_regen [label="Tubular regeneration\nsurviving cells re-epithelialise\n(rhabdomyolysis-AKI recovers unusually well)" fillcolor="#C8E6C9" color="#1B5E20"]
    I_fib   [label="Maladaptive repair → fibrosis\nfixed fraction (≈0.35) of every\nnephron lost becomes scar" shape=box3d fillcolor="#BCAAA4" color="#3E2723"]
    I_ngal  [label="NGAL · KIM-1 · L-FABP\nrise before creatinine" fillcolor="#FFCDD2" color="#B71C1C"]
  }

  //=========================================================
  // 11 : INFLAMMATION AND DEBRIS CLEARANCE
  //=========================================================
  subgraph cluster_inf {
    label="🔥 Inflammation — the same macrophages that clear the debris close the capillary leak"
    style=filled fillcolor="#FFF3E0" color="#EF6C00" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    F_tlr4  [label="TLR4 / TLR2 · MyD88 → NF-κB" fillcolor="#FFE0B2" color="#EF6C00"]
    F_nlrp3 [label="NLRP3 inflammasome\ncaspase-1 → IL-1β" fillcolor="#FFE0B2" color="#EF6C00"]
    F_il6   [label="IL-6 · TNF-α · IL-1β\nsystemic inflammatory response" fillcolor="#FFE0B2" color="#EF6C00"]
    F_leak  [label="Capillary leak\n★ driven by ACTIVE injury, not history\n(this is why the third space resolves)" shape=diamond fillcolor="#FFCC80" color="#BF360C"]
    F_m1    [label="M1 macrophage / neutrophil influx\namplifies tubular injury" fillcolor="#FFE0B2" color="#EF6C00"]
    F_m2    [label="M2 macrophage\nphagocytoses debris, promotes repair" fillcolor="#C8E6C9" color="#1B5E20"]
    F_clr   [label="Debris clearance\nmacrophages recruited BY the debris\nthey remove → resolution completes" shape=diamond fillcolor="#FFCC80" color="#BF360C"]
  }

  //=========================================================
  // 12 : ELECTROLYTES AND ACID-BASE
  //=========================================================
  subgraph cluster_elec {
    label="🧫 Electrolytes — potassium is a positive-feedback loop; calcium is biphasic by construction"
    style=filled fillcolor="#F3E5F5" color="#6A1B9A" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    E_ke    [label="ECF K⁺\n(the early killer)" shape=box3d fillcolor="#E1BEE7" color="#6A1B9A"]
    E_kup   [label="Na⁺/K⁺-ATPase cellular uptake\nsaturable; blunted by acidosis;\nboosted by insulin and β₂-agonist" fillcolor="#E1BEE7" color="#6A1B9A"]
    E_kren  [label="Renal K⁺ excretion\n= Q_urine × regulated urine [K⁺]\n★ anuria stops it by ARITHMETIC" shape=diamond fillcolor="#CE93D8" color="#6A1B9A"]
    E_kloop [label="POSITIVE FEEDBACK\nK⁺ ↑ → arrhythmia and acidosis →\nless uptake and less excretion → K⁺ ↑" shape=note fillcolor="#FFF9C4" color="#F57F17"]
    E_po4   [label="ECF phosphate ↑" shape=box3d fillcolor="#E1BEE7" color="#6A1B9A"]
    E_ca    [label="Ionised Ca²⁺ ↓ (early)" shape=box3d fillcolor="#E1BEE7" color="#6A1B9A"]
    E_dep   [label="Ca–PO₄ deposition INTO injured muscle\nonly above the normal Ca×PO₄ product;\nscaffold = debris pool" shape=diamond fillcolor="#CE93D8" color="#6A1B9A"]
    E_reb   [label="REBOUND HYPERCALCAEMIA (day 5–10)\ndeposit mobilised as macrophages\nclear the scaffold\n→ giving Ca²⁺ early enlarges the later rebound" shape=note fillcolor="#FFF9C4" color="#F57F17"]
    E_ur    [label="Urate ↑ (purine load + oliguria)" shape=box3d fillcolor="#E1BEE7" color="#6A1B9A"]
    E_hco   [label="Plasma HCO₃⁻" shape=box3d fillcolor="#E1BEE7" color="#6A1B9A"]
    E_sid   [label="Chloride load / strong ion difference\nsaline dilutes the bicarbonate space\n→ hyperchloraemic acidosis EMERGES" shape=diamond fillcolor="#CE93D8" color="#6A1B9A"]
    E_nae   [label="Renal net acid excretion\n∝ nephron mass; diverted by alkali" fillcolor="#E1BEE7" color="#6A1B9A"]
    E_na    [label="Plasma Na⁺ / tonicity" shape=box3d fillcolor="#E1BEE7" color="#6A1B9A"]
  }

  //=========================================================
  // 13 : THERAPY — FLOW TERM
  //=========================================================
  subgraph cluster_tflow {
    label="💉 THERAPY 1 — crystalloid: the DENOMINATOR (urine flow)"
    style=filled fillcolor="#E3F2FD" color="#0D47A1" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    T_ns    [label="0.9% saline\nNa⁺ 154 / Cl⁻ 154\ngives flow, COSTS pH" fillcolor="#BBDEFB" color="#0D47A1"]
    T_lr    [label="Ringer's lactate\nNa⁺ 130 / Cl⁻ 109 / lactate 28\ngives flow AND alkali" fillcolor="#BBDEFB" color="#0D47A1"]
    T_pl    [label="Balanced (acetate/gluconate 50)\nlargest alkali yield per litre" fillcolor="#BBDEFB" color="#0D47A1"]
    T_early [label="TIMING dominates DOSE\nfield start ⇒ KDIGO 1;\nsame rate begun at 24 h ⇒ KDIGO 3 + RRT" shape=note fillcolor="#FFF9C4" color="#F57F17"]
    T_target [label="Target: urine 200–300 mL/h\nuntil CK is clearly falling" fillcolor="#BBDEFB" color="#0D47A1"]
  }

  //=========================================================
  // 14 : THERAPY — pH TERM
  //=========================================================
  subgraph cluster_tph {
    label="💊 THERAPY 2 — alkali: the CHEMISTRY term f_diss(pH)"
    style=filled fillcolor="#F1F8E9" color="#33691E" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    T_bic   [label="NaHCO₃ infusion\nraises plasma HCO₃⁻ → bicarbonaturia\n→ urine pH 6.3–6.6" fillcolor="#DCEDC8" color="#33691E"]
    T_acz   [label="Acetazolamide\nrescues urine alkalinisation when\nmetabolic alkalosis limits the dose" fillcolor="#DCEDC8" color="#33691E"]
    T_fail  [label="Alkalinisation FAILS if volume-depleted\nor K⁺-depleted (aldosterone-driven\nacid urine despite bicarbonate)" shape=note fillcolor="#FFF9C4" color="#F57F17"]
    T_marg  [label="DIMINISHING RETURNS ARE ARITHMETIC\nabsolute injury saved by the same alkali:\n43 units at 100 mL/h → 18 at 1000 mL/h.\nThis is why the trials disagree with the theory" shape=note fillcolor="#FFF9C4" color="#F57F17"]
  }

  //=========================================================
  // 15 : THERAPY — SOURCE TERM
  //=========================================================
  subgraph cluster_tsrc {
    label="🩹 THERAPY 3 — extracorporeal: the NUMERATOR (plasma myoglobin)"
    style=filled fillcolor="#E0F7FA" color="#006064" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    T_hco   [label="High cut-off CVVH\nMb sieving ≈0.55 · CL ≈40 mL/min" fillcolor="#B2EBF2" color="#006064"]
    T_ihd   [label="Intermittent haemodialysis\nclears K⁺/acid, barely clears myoglobin" fillcolor="#B2EBF2" color="#006064"]
    T_ads   [label="Haemoadsorption\n(myoglobin-adsorbing cartridges)" fillcolor="#B2EBF2" color="#006064"]
    T_ceil  [label="A HARD CEILING\n40 mL/min adds ≈2.4 L/h to an endogenous\n≈2.4 L/h — at best a 2-fold change,\nand it starts AFTER the myoglobin peak.\nMost of its measured benefit is\nacid–base and K⁺ correction, not Mb removal" shape=note fillcolor="#FFF9C4" color="#F57F17"]
  }

  //=========================================================
  // 16 : ADJUNCTS AND IATROGENIC HARM
  //=========================================================
  subgraph cluster_adj {
    label="⚠️ Adjuncts — three of these move a term, two mostly add a fourth injury arm"
    style=filled fillcolor="#FBE9E7" color="#BF360C" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    D_man   [label="Mannitol\nosmotic diuresis (modest) + scavenging;\nfiltered, NOT reabsorbed" fillcolor="#FFCCBC" color="#BF360C"]
    D_mantox [label="ARM D (iatrogenic) — osmotic nephrosis\nthreshold ≈200 g cumulative;\nretained once GFR falls → runaway" shape=hexagon fillcolor="#FF8A65" color="#7F0000" fontcolor="white"]
    D_fur   [label="Loop diuretic\nraises flow but acidifies urine and\nwastes Cl⁻/K⁺ → contraction, hypernatraemia\nif replaced with saline alone" fillcolor="#FFCCBC" color="#BF360C"]
    D_dant  [label="Dantrolene\nRyR1 Ca²⁺-leak block → halves the\nrelease flux at source (MH / exertional)" fillcolor="#C8E6C9" color="#1B5E20"]
    D_ins   [label="Insulin + dextrose\nshifts K⁺ in; does not remove it" fillcolor="#FFCCBC" color="#BF360C"]
    D_cagl  [label="Calcium gluconate\nmembrane stabilisation for arrhythmia;\nfeeds the deposit → later rebound" fillcolor="#FFCCBC" color="#BF360C"]
    D_kbind [label="K⁺ binders (SZC / patiromer)\nslow but genuinely removes K⁺" fillcolor="#FFCCBC" color="#BF360C"]
    D_aox   [label="Antioxidant / iron chelator\nblocks ARM A only — hence the\nnegative trials despite good biology" fillcolor="#FFCCBC" color="#BF360C"]
    D_stop  [label="Stop the culprit drug\n(statin, propofol, trigger agent)" fillcolor="#C8E6C9" color="#1B5E20"]
  }

  //=========================================================
  // 17 : MARKERS AND STAGING
  //=========================================================
  subgraph cluster_mark {
    label="📊 What the clinician measures — and why creatinine misleads twice"
    style=filled fillcolor="#ECEFF1" color="#263238" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    S_cre   [label="Serum creatinine" shape=box3d fillcolor="#CFD8DC" color="#263238"]
    S_crn   [label="Released creatine pool\n→ extra creatinine production (≈2×)" fillcolor="#CFD8DC" color="#263238"]
    S_bias  [label="CREATININE LIES TWICE\n(1) production rises with the muscle load,\nso early eGFR overstates the damage;\n(2) it lags recovery of nephron mass" shape=note fillcolor="#FFF9C4" color="#F57F17"]
    S_bun   [label="Urea / BUN\n(flow-dependent reabsorption)" fillcolor="#CFD8DC" color="#263238"]
    S_kdigo [label="KDIGO stage\ncomputed as an OUTPUT" fillcolor="#B0BEC5" color="#263238"]
    S_mcm   [label="McMahon score\nage · sex · Cr · Ca · PO₄ · HCO₃ · CK · cause\ncomputed as an OUTPUT" fillcolor="#B0BEC5" color="#263238"]
    S_ckmb  [label="CK : myoglobin ratio\nrises as renal clearance is lost\n— a computable bedside signal" fillcolor="#CFD8DC" color="#263238"]
    S_gap   [label="Osmolar gap\nmannitol accumulation monitor" fillcolor="#CFD8DC" color="#263238"]
  }

  //=========================================================
  // 18 : CLINICAL ENDPOINTS
  //=========================================================
  subgraph cluster_end {
    label="🎯 Clinical endpoints"
    style=filled fillcolor="#E8EAF6" color="#1A237E" penwidth=3 fontsize=13 fontname="Helvetica-Bold"

    Z_uo    [label="Urine output / oligo-anuric hours" fillcolor="#C5CAE9" color="#1A237E"]
    Z_aki   [label="KDIGO stage 1 / 2 / 3" fillcolor="#9FA8DA" color="#1A237E"]
    Z_rrt   [label="Renal replacement therapy required" fillcolor="#9FA8DA" color="#1A237E"]
    Z_arr   [label="Hyperkalaemic arrhythmia / cardiac arrest\n(the deaths that happen on day 1)" fillcolor="#EF9A9A" color="#B71C1C"]
    Z_tet   [label="Tetany / seizures from hypocalcaemia" fillcolor="#C5CAE9" color="#1A237E"]
    Z_reb   [label="Rebound hypercalcaemia in recovery" fillcolor="#C5CAE9" color="#1A237E"]
    Z_limb  [label="Limb salvage vs amputation" fillcolor="#C5CAE9" color="#1A237E"]
    Z_ckd   [label="eGFR at day 90 / residual CKD" fillcolor="#9FA8DA" color="#1A237E"]
    Z_mort  [label="Mortality" fillcolor="#EF9A9A" color="#B71C1C"]
  }

  //========================= EDGES =========================
  // aetiology -> the two doors
  A_crush -> A_mech; A_immob -> A_mech; A_isch -> A_mech
  A_exert -> A_meta; A_statin -> A_meta; A_drug -> A_meta; A_mh -> A_meta
  A_gen -> A_meta; A_sz -> A_meta; A_inf -> A_meta; A_elec -> A_meta
  A_exert -> A_mech [style=dashed label="heat + hypovolaemia"]

  // doors -> myocyte
  A_mech -> M_atp; A_meta -> M_atp
  A_mh -> M_ryr [color="#B71C1C" penwidth=2]; A_gen -> M_atp
  M_atp -> M_nak -> M_ncx -> M_cai
  M_atp -> M_serca -> M_cai
  M_ryr -> M_cai [penwidth=2]
  M_cai -> M_calp -> M_sarco
  M_cai -> M_pla2 -> M_sarco
  M_cai -> M_mpt -> M_ros -> M_sarco
  M_sarco -> M_nec [penwidth=2]
  A_mech -> M_via [style=dashed]
  M_via -> M_nec [label="ischaemia gate" color="#4527A0" penwidth=2]

  // the pressure node
  A_crush -> P_ext [penwidth=2]
  P_seq -> P_pcomp [penwidth=2]; P_comp -> P_pcomp; P_ext -> P_pcomp [penwidth=2]
  P_pcomp -> P_dp [penwidth=2]; P_map -> P_dp [penwidth=2]
  P_dp -> P_g1 [penwidth=2 color="#311B92"]; P_dp -> P_g2 [penwidth=2 color="#311B92"]
  P_g1 -> M_via [label="→ necrosis" color="#311B92" penwidth=2]
  P_g2 -> R_lys [label="→ washout" color="#311B92" penwidth=2]
  P_g1 -> P_paradox [style=dotted]; P_g2 -> P_paradox [style=dotted]
  P_fasc -> P_comp [label="× 12 compliance" color="#1A237E" penwidth=2]
  P_fasc -> Z_limb [color="#1A237E"]
  P_fasc -> P_g2 [style=dashed label="reperfuses the load"]
  M_nec -> P_seq [style=dashed label="leak target"]
  V_pv -> P_map [penwidth=2]

  // release and the clocks
  M_nec -> R_lys [penwidth=2]
  R_lys -> R_ck [penwidth=2]; R_lys -> R_mb [penwidth=2]
  R_lys -> R_k; R_lys -> R_po4; R_lys -> R_crn; R_lys -> R_ur
  R_lys -> R_acid; R_lys -> R_other; R_lys -> R_damp; R_lys -> R_deb
  R_ck -> R_lag [style=dotted]; R_mb -> R_lag [style=dotted]
  R_ck -> S_ckmb; R_mb -> S_ckmb
  R_deb -> F_clr; R_deb -> E_dep [label="scaffold"]
  R_damp -> F_tlr4; R_damp -> F_nlrp3

  // volume
  V_ecf -> V_pv -> V_press -> G_q
  V_shift -> V_ecf; V_icf -> V_shift; E_na -> V_shift
  V_ecf -> V_raas [label="depletion"]; V_raas -> G_q [label="FE_H2O ↓"]
  V_insen -> V_ecf [dir=back]
  P_seq -> V_ecf [dir=back label="sequesters" color="#B71C1C"]
  V_ecf -> V_over [label="if anuric"] ; V_over -> Z_mort [style=dashed]
  F_leak -> P_seq [penwidth=2]

  // filtration and tubular handling
  I_neph -> G_gfr [penwidth=2]; W_rbf -> G_gfr; C_obst -> G_gfr [penwidth=2]
  G_gfr -> G_fl; R_mb -> G_fl [penwidth=2]; G_siev -> G_fl
  G_fl -> G_meg [penwidth=2]
  G_meg -> G_arm1 [penwidth=2]; G_meg -> G_exc [penwidth=2]
  I_neph -> G_meg [style=dashed label="Tm ∝ nephrons"]
  I_neph -> G_arm1 [style=dashed label="÷ nephron mass"]
  G_exc -> G_cdist [penwidth=2]; G_q -> G_cdist [label="÷ Q" penwidth=2 color="#0D47A1"]
  G_meg -> G_mburia [style=dotted]
  G_gfr -> G_q

  // heme chemistry
  H_ph -> H_fdiss [penwidth=2]
  H_fdiss -> H_ferri [penwidth=2]; H_fdiss -> G_arm1 [penwidth=2 color="#880E4F"]
  G_arm1 -> H_fe [penwidth=2]; H_ferri -> H_fe
  H_fe -> H_fent -> H_lipid; H_redox -> H_lipid; G_arm1 -> H_redox
  H_lipid -> H_ptcd [penwidth=2]
  H_ho1 -> H_fe [dir=back style=dashed label="degrades"]; H_fer -> H_fe [style=dashed]
  H_gsh -> H_lipid [style=dashed label="buffers"]
  H_ptcd -> I_sum [penwidth=2 color="#B71C1C"]
  H_lipid -> W_iso

  // casts
  C_thp -> C_agg; H_ph -> C_agg [penwidth=2]
  G_cdist -> C_form [penwidth=2]; C_agg -> C_form [penwidth=2]
  C_form -> C_burd [penwidth=2]
  H_ph -> C_urate [penwidth=2]; H_ph -> C_capo [penwidth=2]
  E_ur -> C_urate; E_ca -> C_capo; E_po4 -> C_capo
  C_urate -> C_burd; C_capo -> C_burd
  C_burd -> C_obst [penwidth=2]; C_diss -> C_burd [dir=back]; G_q -> C_diss [penwidth=2]
  C_obst -> I_sum [penwidth=2 color="#B71C1C"]
  C_urate -> C_opt [style=dotted]; C_capo -> C_opt [style=dotted]; H_fdiss -> C_opt [style=dotted]

  // vasoconstriction
  R_mb -> W_no [penwidth=2]; W_no -> W_rbf [penwidth=2]
  I_tubi -> W_et1; W_et1 -> W_rbf; W_txa2 -> W_rbf; W_iso -> W_rbf
  V_ecf -> W_rbf [label="hypovolaemia" penwidth=2]
  W_rbf -> W_hyp -> W_arm3 [penwidth=2]
  W_arm3 -> I_sum [penwidth=2 color="#B71C1C"]

  // injury integration
  I_sum -> I_tubi [penwidth=2]
  I_tubi -> I_death [penwidth=2]; I_death -> I_neph [penwidth=2 color="#B71C1C"]
  I_death -> I_fib [label="fixed fraction scars" penwidth=2]
  I_regen -> I_neph [penwidth=2 color="#1B5E20"]; I_tubi -> I_regen [style=dashed label="inhibits"]
  I_fib -> I_neph [style=dashed label="caps recovery"]
  I_tubi -> I_ngal; I_neph -> Z_ckd [penwidth=2]
  F_m2 -> I_regen

  // inflammation
  F_tlr4 -> F_il6; F_nlrp3 -> F_il6
  F_il6 -> F_leak [penwidth=2]; F_il6 -> F_m1 -> I_sum
  R_deb -> F_m2 [label="recruits"]; F_m2 -> F_clr [penwidth=2]
  F_clr -> R_deb [dir=back label="clears" color="#1B5E20"]
  F_clr -> E_reb [style=dotted]

  // electrolytes
  R_k -> E_ke [penwidth=2]
  E_ke -> E_kup [dir=both]; E_kren -> E_ke [dir=back penwidth=2]
  G_q -> E_kren [penwidth=2 color="#0D47A1"]; I_neph -> E_kren
  E_hco -> E_kup [style=dashed label="acidosis blocks"]
  E_ke -> E_kloop [style=dotted]; E_kren -> E_kloop [style=dotted]
  E_ke -> Z_arr [penwidth=2 color="#B71C1C"]; E_ca -> Z_arr [style=dashed label="protects"]
  R_po4 -> E_po4 [penwidth=2]; E_po4 -> E_dep [penwidth=2]; E_ca -> E_dep [penwidth=2]
  E_dep -> E_ca [dir=back label="consumes" color="#B71C1C" penwidth=2]
  E_dep -> E_reb [style=dotted]; E_reb -> Z_reb
  E_ca -> Z_tet
  R_ur -> E_ur; R_acid -> E_hco [color="#B71C1C" penwidth=2]
  E_sid -> E_hco [penwidth=2 color="#B71C1C"]; E_nae -> E_hco [penwidth=2 color="#1B5E20"]
  I_neph -> E_nae [penwidth=2]
  E_hco -> H_ph [penwidth=2 color="#33691E"]
  V_ecf -> H_ph [style=dashed label="depletion blocks alkalinisation"]
  E_ke -> H_ph [style=dashed label="K⁺ depletion blocks"]
  E_na -> E_sid

  // therapy: flow
  T_ns -> V_ecf [penwidth=2 color="#0D47A1"]; T_lr -> V_ecf [penwidth=2 color="#0D47A1"]
  T_pl -> V_ecf [penwidth=2 color="#0D47A1"]
  T_ns -> E_sid [label="Cl⁻ 154 → acidifies" color="#B71C1C" penwidth=2]
  T_lr -> E_hco [label="lactate → HCO₃⁻" color="#1B5E20"]
  T_pl -> E_hco [label="acetate/gluconate" color="#1B5E20"]
  V_press -> T_target [style=dotted]; T_early -> T_target [style=dotted]
  T_ns -> P_seq [style=dashed label="also fills the third space" color="#B71C1C"]

  // therapy: pH
  T_bic -> E_hco [penwidth=2 color="#33691E"]; T_acz -> H_ph [penwidth=2 color="#33691E"]
  T_bic -> E_na
  T_fail -> H_ph [style=dotted]; T_marg -> H_fdiss [style=dotted]
  T_bic -> C_capo [label="over-alkalinisation risk" style=dashed color="#B71C1C"]

  // therapy: source
  T_hco -> R_mb [label="removes" color="#006064" penwidth=2]
  T_ihd -> E_ke [label="removes" color="#006064"]; T_hco -> E_hco [label="buffer" color="#006064"]
  T_ads -> R_mb [color="#006064"]
  T_hco -> S_cre [label="clears creatinine too" color="#006064" style=dashed]
  T_ceil -> T_hco [style=dotted]

  // adjuncts
  D_man -> G_q [label="osmotic diuresis" color="#0D47A1"]
  D_man -> D_mantox [penwidth=2]; D_mantox -> I_sum [penwidth=2 color="#B71C1C"]
  D_man -> S_gap; G_gfr -> D_mantox [dir=back style=dashed label="retained when GFR falls"]
  D_fur -> G_q [label="raises flow" color="#0D47A1"]
  D_fur -> H_ph [label="acidifies" color="#B71C1C"]; D_fur -> E_na [label="Cl⁻/K⁺ wasting" color="#B71C1C"]
  D_dant -> M_ryr [label="blocks" color="#1B5E20" penwidth=2]
  D_dant -> R_lys [style=dashed color="#1B5E20"]
  D_ins -> E_kup [color="#1B5E20" penwidth=2]
  D_cagl -> Z_arr [label="stabilises" color="#1B5E20"]; D_cagl -> E_dep [label="feeds deposit" color="#B71C1C" style=dashed]
  D_kbind -> E_ke [label="removes" color="#1B5E20"]
  D_aox -> G_arm1 [label="blocks ARM A only" color="#1B5E20" penwidth=2]
  D_stop -> A_meta [label="removes driver" color="#1B5E20" penwidth=2]

  // markers
  R_crn -> S_crn -> S_cre [penwidth=2]
  G_gfr -> S_cre [dir=back penwidth=2]; S_crn -> S_bias [style=dotted]; I_neph -> S_bias [style=dotted]
  G_gfr -> S_bun [dir=back]; G_q -> S_bun [style=dashed]
  S_cre -> S_kdigo [penwidth=2]; Z_uo -> S_kdigo [penwidth=2]
  S_cre -> S_mcm; R_ck -> S_mcm; E_ca -> S_mcm; E_po4 -> S_mcm; E_hco -> S_mcm
  S_kdigo -> Z_aki [penwidth=2]; S_mcm -> Z_rrt
  G_q -> Z_uo [penwidth=2]

  // endpoints
  Z_aki -> Z_rrt; E_ke -> Z_rrt [style=dashed]; E_hco -> Z_rrt [style=dashed]
  Z_arr -> Z_mort [penwidth=2]; Z_aki -> Z_mort; Z_rrt -> Z_ckd
  I_fib -> Z_ckd [penwidth=2]
}
