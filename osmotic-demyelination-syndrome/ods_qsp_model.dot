/* =====================================================================
   ods_qsp_model.dot
   Osmotic Demyelination Syndrome (ODS) — QSP mechanistic map
   삼투성 탈수초 증후군 — 정량적 시스템 약리학 기계론적 지도

   THE STRUCTURE OF THIS MAP
   -------------------------
   Read it left to right as three machines wired in series:

     (1) THE KIDNEY decides the RATE at which plasma tonicity moves.
         It is not the prescription that sets the correction rate; it is
         the electrolyte-free water clearance, and that is governed by
         AVP.  Removing the AVP stimulus (volume, cortisol, thiazide,
         alcohol) opens the aquaresis and the sodium rises on its own.

     (2) THE ASTROCYTE decides whether that rate is survivable.  It holds
         two solute pools with grossly different time constants: an
         inorganic pool moved by CHANNELS (fast both ways) and an organic
         pool given away by a CHANNEL (VRAC/LRRC8A, fast) but taken back
         by TRANSPORTERS that must first be TRANSCRIBED (TonEBP -> SMIT1,
         TauT, BGT1; slow).  The gap between what the pool should hold at
         the current tonicity and what it does hold is OMEGA, and OMEGA
         is the disease.

     (3) THE OLIGODENDROCYTE is the victim, not the target.  Astrocytes
         die first; myelin is lost days later; the patient deteriorates
         days after that; the MRI turns positive later still.

   Nodes: 156.  Clusters: 20.
   ===================================================================== */

digraph ODS {
  graph [rankdir=LR, splines=true, nodesep=0.28, ranksep=0.85,
         fontname="Helvetica", fontsize=11, compound=true,
         label="Osmotic Demyelination Syndrome (ODS) — QSP mechanistic map\n삼투성 탈수초 증후군: 신장이 속도를 정하고, 별아교세포가 그 속도를 견딜 수 있는지 정하며, 희소돌기아교세포가 대가를 치른다\nOMEGA = ORG_set(Osm_eff) - ORG  =  the organic osmolyte deficit  =  the disease",
         labelloc="t", fontsize=20];
  node  [shape=box, style="rounded,filled", fontname="Helvetica",
         fontsize=10, margin="0.10,0.06"];
  edge  [fontname="Helvetica", fontsize=8, arrowsize=0.65, color="#5a6472"];

  /* ---------- 1. AETIOLOGY / PHENOTYPE ---------------------------- */
  subgraph cluster_aeti {
    label="① 병인 표현형 (Aetiological phenotype) — 같은 나트륨, 다른 신장";
    style="rounded,filled"; fillcolor="#eef3f8"; color="#7f97b4"; fontsize=13;
    node [fillcolor="#d7e3f0", color="#5a7ea6"];
    SIADH   [label="SIADH\nectopic / neuro / drug\n자율적 AVP 분비"];
    HYPOVOL [label="Hypovolaemia\nvomiting · diarrhoea\ndiuretic · third space"];
    THIAZ   [label="Thiazide\nNCC block\n희석능 장애"];
    ADRENAL [label="Adrenal insufficiency\ncortisol 결핍 → AVP 억제 실패"];
    POTOM   [label="Beer potomania\ntea-and-toast\n용질 섭취 <250 mOsm/d"];
    PRIMPOL [label="Primary polydipsia\n수분 섭취 > 배설능"];
    EXERT   [label="Exercise-associated\nMDMA · 급성 수분중독\n(<48 h)"];
    CIRRH   [label="Cirrhosis / pre-transplant\nGln↑ · myo-inositol↓\n삼투질 완충능 이미 소진"];
    CHF     [label="Heart failure\n유효순환혈액량↓"];
    HYPOK   [label="Hypokalaemia\nK 결핍 (알코올·이뇨제)"];
  }

  /* ---------- 2. AVP AXIS ----------------------------------------- */
  subgraph cluster_avp {
    label="② AVP 축 (Osmoreceptor · baroreceptor · V2)";
    style="rounded,filled"; fillcolor="#fdf1e6"; color="#c69a6d"; fontsize=13;
    node [fillcolor="#fadfc4", color="#b8874f"];
    OSMOR  [label="OVLT/SFO osmoreceptor\nTRPV1/TRPV4\nthreshold ≈ 280 mOsm/kg"];
    BARO   [label="Carotid/atrial baroreceptor\nnon-osmotic drive\nEC50 ≈ 8% ECF 결핍"];
    MAGNO  [label="Supraoptic/paraventricular\nmagnocellular neuron"];
    PITUIT [label="Posterior pituitary\nAVP 저장·분비"];
    AVPPL  [label="Plasma AVP\nt½ ≈ 20 min", fillcolor="#f6c98f"];
    V2R    [label="V2 receptor (AVPR2)\ncollecting duct 기저외측막"];
    GS     [label="Gs → adenylate cyclase\ncAMP ↑"];
    PKA    [label="PKA\nAQP2 Ser256 인산화"];
    AQP2   [label="AQP2 apical trafficking\n(τ ≈ 1.4 h)", fillcolor="#f6c98f"];
    AQP34  [label="AQP3 / AQP4\n기저외측막 water exit"];
    UTA1   [label="UT-A1 / UT-A3\n요소 재순환"];
    ENAC   [label="ENaC\n(V2 매개)"];
  }

  /* ---------- 3. RENAL WATER / SOLUTE ------------------------------ */
  subgraph cluster_renal {
    label="③ 신장 수분·용질 처리 (the machine that sets the RATE)";
    style="rounded,filled"; fillcolor="#e9f5ee"; color="#79ab8d"; fontsize=13;
    node [fillcolor="#cfe9da", color="#5d9878"];
    GFR    [label="GFR\n사구체 여과"];
    PT     [label="Proximal tubule\n등장성 재흡수 ~65%"];
    TAL    [label="Thick ascending limb\nNKCC2 → 희석분절\n(furosemide 표적)"];
    DCT    [label="Distal convoluted tubule\nNCC (thiazide 표적)"];
    CD     [label="Collecting duct\nAQP2 의존적 물 재흡수"];
    MEDGR  [label="Medullary gradient\ncountercurrent multiplier\n최대 1200 mOsm/kg"];
    WASH   [label="Medullary washout\n용질부하↑ → 농축능↓\n(등장뇨로 수렴)"];
    SOLEXC [label="Solute excretion\n2(U_Na+U_K) + urea + other\n정상 ≈ 820 mOsm/d", fillcolor="#a9d8bf"];
    UOSM   [label="Urine osmolality\n50 – 1150 mOsm/kg", fillcolor="#a9d8bf"];
    VU     [label="Urine volume\nV = SOLEXC / U_osm", fillcolor="#a9d8bf"];
    UNAK   [label="Urine (Na+K)\n= (E_Na+E_K)/V"];
    EFWC   [label="ELECTROLYTE-FREE WATER CLEARANCE\nEFWC = V × (1 − (U_Na+U_K)/S_Na)\n★ 교정속도를 실제로 정하는 양 ★",
            shape=box, style="filled,bold", fillcolor="#8fcfae", color="#2f7a53", fontsize=12];
    FURST  [label="Furst ratio (U_Na+U_K)/S_Na\n>1 이면 수분제한은 실패한다"];
  }

  /* ---------- 4. WHOLE-BODY FLUID & ELECTROLYTE -------------------- */
  subgraph cluster_body {
    label="④ 전신 체액·전해질 (Edelman)";
    style="rounded,filled"; fillcolor="#f3eef8"; color="#a08cbe"; fontsize=13;
    node [fillcolor="#e2d7f0", color="#8a72ad"];
    TBW   [label="Total body water\n≈ 0.6 × 체중"];
    NAE   [label="Exchangeable Na⁺\n(교환성; 골·피부 저장 제외)"];
    KE    [label="Exchangeable K⁺\n98% 세포내"];
    EDEL  [label="EDELMAN\n[Na]s = 1.11(Na_e+K_e)/TBW − 25.6\n★ K 보충은 Na 보충이다 ★",
           shape=box, style="filled,bold", fillcolor="#cbb8e4", color="#6f549a", fontsize=12];
    SNA   [label="Serum [Na⁺]", fillcolor="#cbb8e4"];
    OSMEF [label="Effective osmolality (tonicity)\nOsm_eff = 2[Na] + glucose/18", fillcolor="#cbb8e4"];
    UREAP [label="Plasma urea\n(BBB 투과 → 무효 삼투질)"];
    ECFV  [label="ECF volume\n→ baroreceptor"];
    SK    [label="Serum [K⁺]\n(Na 공역 수송체의 구동력)"];
  }

  /* ---------- 5. BLOOD-BRAIN BARRIER TRANSPORT -------------------- */
  subgraph cluster_bbbt {
    label="⑤ 혈액뇌장벽 수송체 (BBB transport)";
    style="rounded,filled"; fillcolor="#eaf2f7"; color="#7fa6c0"; fontsize=13;
    node [fillcolor="#cfe2ee", color="#5f8fae"];
    AQP4  [label="AQP4 (astrocyte endfoot)\n물은 초 단위로 평형"];
    UTB   [label="UT-B (SLC14A1)\n요소 뇌 확산 (t½ ~ 2 h)"];
    NKCC1 [label="NKCC1 (SLC12A2)\nRVI 무기이온 흡수"];
    NHE1  [label="NHE1 / AE2\nNa⁺/H⁺ · Cl⁻/HCO₃⁻ 교환"];
    NKA   [label="Na⁺/K⁺-ATPase\nATP 소비 · K⁺ 의존"];
    SMIT1 [label="SMIT1 (SLC5A3)\nNa⁺-공역 myo-inositol 흡수\n★ 전사 필요 ★", fillcolor="#a9cde5"];
    TAUT  [label="TauT (SLC6A6)\nNa⁺/Cl⁻-공역 taurine 흡수", fillcolor="#a9cde5"];
    BGT1  [label="BGT1 (SLC6A12)\nbetaine/GABA 흡수", fillcolor="#a9cde5"];
    SNAT  [label="SNAT3/5 (SLC38)\nglutamine 수송"];
    LRRC8 [label="VRAC / LRRC8A\n부피 활성 음이온 채널\n★ 채널: 밀리초 ★", fillcolor="#f4b8b8", color="#c06a6a"];
  }

  /* ---------- 6. RVD --------------------------------------------- */
  subgraph cluster_rvd {
    label="⑥ 저삼투 적응 · RVD (regulatory volume decrease) — 빠르다";
    style="rounded,filled"; fillcolor="#fdeef0"; color="#c98a92"; fontsize=13;
    node [fillcolor="#f8d6da", color="#b96b75"];
    SWELL [label="Astrocyte swelling\n(세포 부피 센서)"];
    RVD   [label="RVD 개시\nWNK/SPAK ↓ · LRRC8A ↑"];
    KCC   [label="KCC1/3\nK⁺-Cl⁻ 유출"];
    ELOUT [label="무기이온 유출\nNa⁺ K⁺ Cl⁻   t½ ≈ 2.5 h"];
    ORGOUT[label="유기 삼투질 유출\nVRAC 경유   t½ ≈ 6 h"];
    ADAPT [label="적응 완료 (24–48 h)\n뇌 수분 정상 + 삼투질 40% 소실\n= 만성 저나트륨혈증", fillcolor="#f0b3ba"];
  }

  /* ---------- 7. RVI --------------------------------------------- */
  subgraph cluster_rvi {
    label="⑦ 교정 중 재적응 · RVI — 무기이온은 빠르고 유기 삼투질은 느리다";
    style="rounded,filled"; fillcolor="#fef6e3"; color="#c9b06d"; fontsize=13;
    node [fillcolor="#f7ead0", color="#b39a52"];
    SHRINK[label="Astrocyte shrinkage\n(부피 센서, 반대 방향)"];
    RVI   [label="RVI 개시\nWNK1/3 → SPAK/OSR1 → NKCC1"];
    ELIN  [label="무기이온 재축적\nτ ≈ 3.6 h · 최대 60 mOsm/kg/d", fillcolor="#f2d99b"];
    TONEBP[label="TonEBP / NFAT5\n핵 이행 (τ ≈ 6 h)", fillcolor="#f2d99b"];
    ORE   [label="ORE/TonE 프로모터 요소\nSLC5A3 · SLC6A6 · SLC6A12 · AR · HSPA1"];
    TRANSC[label="전사 → 번역 → 막 삽입\nτ ≈ 24 h", fillcolor="#f2d99b"];
    ORGIN [label="유기 삼투질 재축적\n완전 회복까지 5–7 일", fillcolor="#eecb78"];
    ASYM  [label="★ 비대칭 ★\n주는 것: 채널 (t½ 6 h)\n받는 것: 전사 (t½ 2–3 d)\n비 ≈ 6 : 1",
           shape=box, style="filled,bold", fillcolor="#e8b84b", color="#8a6b12", fontsize=12];
  }

  /* ---------- 8. ORGANIC OSMOLYTE POOLS --------------------------- */
  subgraph cluster_org {
    label="⑧ 유기 삼투질 풀 (MRS로 볼 수 있는 것) — 정상 합계 48 mOsm/kg 뇌수분";
    style="rounded,filled"; fillcolor="#eef7f2"; color="#7cb096"; fontsize=13;
    node [fillcolor="#d3ecdf", color="#5f9a7d"];
    INS  [label="myo-Inositol  7.0\nβ = 3.2 (가장 반응성 큼)"];
    TAU  [label="Taurine  2.0\nβ = 3.2"];
    GLX  [label="Glutamate+Glutamine  15.0\nβ = 2.6"];
    CRE  [label="Creatine+PCr  10.0\nβ = 1.0"];
    GPC  [label="GPC+PC  2.5\nβ = 2.4"];
    OTHO [label="NAA · glycine · betaine  11.5\nβ = 0.8"];
    ORGT [label="ORG (합계)\nvs ORG_set(Osm_eff)", fillcolor="#a9d8bf"];
    OMEGA[label="Ω = ORG_set − ORG\n★ 이 모델의 질병 변수 ★\n정상 0 · 적응된 뇌 0 · 교정 중에만 >0",
          shape=box, style="filled,bold", fillcolor="#59b183", color="#1f6a45",
          fontcolor="white", fontsize=13];
  }

  /* ---------- 9. BRAIN VOLUME / TONICITY -------------------------- */
  subgraph cluster_bvol {
    label="⑨ 뇌 부피와 긴장도";
    style="rounded,filled"; fillcolor="#f0f4f8"; color="#8fa3b8"; fontsize=13;
    node [fillcolor="#dbe5ee", color="#6d87a1"];
    BSOL  [label="뇌 용질 총량\nBELEC + ORG + 불투과성"];
    BWAT  [label="뇌 수분 (mL/100 g)\n= 용질/Osm_eff\n정상 80.0"];
    BSWEL [label="뇌 부종 → ICP↑\n탈출(herniation) 위험"];
    BSHRK [label="뇌 위축 → 삼투압 스트레스\n(축삭 견인 · 세포골격)"];
    STRESS[label="STRESS = Ω + 위축 등가\n역치 Ω* = 8 mOsm/kg", fillcolor="#b9cbdc"];
  }

  /* ---------- 10. ASTROCYTE ENERGETICS & DEATH -------------------- */
  subgraph cluster_astro {
    label="⑩ 별아교세포 에너지와 사멸 (첫 번째 표적)";
    style="rounded,filled"; fillcolor="#fdeee9"; color="#cf9179"; fontsize=13;
    node [fillcolor="#f8dcd0", color="#bf7a5f"];
    ATP   [label="Astrocyte ATP\nNKA 부하 · 영양상태 · K⁺"];
    MPTP  [label="Mitochondrial permeability\ntransition · cyt-c 방출"];
    CASP  [label="Caspase-3 활성화"];
    GFAP  [label="GFAP 소실\n(초기 병리 표지)"];
    AQP4L [label="AQP4 소실\n(별아교세포 발판 붕괴)"];
    ASTD  [label="Astrocyte death\n★ 탈수초보다 먼저 ★", fillcolor="#f0b9a3"];
    GAPJ  [label="Gap junction syncytium\nCx43/Cx30 — 국소 손실은 보상됨\n(역치 ASTTHR ≈ 3%)"];
    ASTREP[label="Astrogliosis / 재증식\nτ ≈ 10 d"];
  }

  /* ---------- 11. NEUROINFLAMMATION & BBB ------------------------- */
  subgraph cluster_inflam {
    label="⑪ 신경염증과 혈액뇌장벽 붕괴";
    style="rounded,filled"; fillcolor="#f6eef6"; color="#b48cb4"; fontsize=13;
    node [fillcolor="#ead9ea", color="#9a739a"];
    BBBOP [label="BBB 개방\ntight junction (claudin-5·ZO-1) 소실"];
    MMP9  [label="MMP-9\n기저막 분해"];
    MICRO [label="Microglial activation\nM1 표현형"];
    TNF   [label="TNF-α · IL-1β · IL-6"];
    COMPL [label="보체 C3 / C5b-9\n(막공격복합체)"];
    IGGE  [label="IgG 혈관외 유출\n(수초 표적)"];
    ASTMG [label="Astrocyte–microglia crosstalk\nC3 · IL-1α · TNF → A1 astrocyte"];
  }

  /* ---------- 12. OLIGODENDROCYTE / MYELIN ------------------------ */
  subgraph cluster_oli {
    label="⑫ 희소돌기아교세포와 수초 (표적이 아니라 피해자)";
    style="rounded,filled"; fillcolor="#eaf0fb"; color="#8298c4"; fontsize=13;
    node [fillcolor="#d3ddf3", color="#6b83b4"];
    TROPH [label="영양지지 소실\n(별아교세포 유래 젖산·IGF-1)"];
    OLID  [label="Oligodendrocyte apoptosis"];
    MBP   [label="MBP · PLP · MOG 소실"];
    MYE   [label="수초 함량 (MYE)\n희소돌기아교세포 수를 추종", fillcolor="#b7c8ec"];
    OPC   [label="OPC (NG2⁺) 증식"];
    REMY  [label="재수초화\n수개월 (부분 회복 가능)"];
    AXON  [label="축삭은 상대적으로 보존\n(고전적 병리 소견)"];
  }

  /* ---------- 13. LESION TOPOGRAPHY ------------------------------- */
  subgraph cluster_topo {
    label="⑬ 병변 국소해부 — 왜 하필 다리뇌인가";
    style="rounded,filled"; fillcolor="#f5f2e8"; color="#b6ac86"; fontsize=13;
    node [fillcolor="#e8e2cd", color="#9c9169"];
    GWINT [label="회백질–백질 교차 밀도\n다리뇌 기저부에서 최대\n(횡·종주섬유 격자)"];
    CPM   [label="Central pontine myelinolysis\n다리뇌 중심 (가중치 1.00)", fillcolor="#ddd3b3"];
    EPM   [label="Extrapontine myelinolysis\n시상·기저핵·소뇌·피질하\n(가중치 0.55)", fillcolor="#ddd3b3"];
    SPARE [label="다리뇌 피개·연질막하 보존\n(고전적 '삼지창' 형태)"];
  }

  /* ---------- 14. CLINICAL ENDPOINTS ------------------------------ */
  subgraph cluster_clin {
    label="⑭ 임상 종말점 (이상성 경과)";
    style="rounded,filled"; fillcolor="#fdecec"; color="#cd8686"; fontsize=13;
    node [fillcolor="#f8d3d3", color="#bd6c6c"];
    PHASE1[label="1상: 교정 직후 호전\n의식·경련 개선"];
    PHASE2[label="2상: 2–7일 후 악화\n★ 진단의 함정 ★", fillcolor="#f1b3b3"];
    DYSAR [label="구음장애 · 연하곤란"];
    QUAD  [label="사지마비 · 강직"];
    LOCKED[label="Locked-in syndrome"];
    SEIZ  [label="경련 · 섬망"];
    MOVD  [label="추체외로 증상\n파킨슨증 · 근긴장이상 (EPM)"];
    MRS   [label="modified Rankin Scale\n기능적 결과"];
    RECOV [label="부분/완전 회복\n생존자의 상당수 (수개월)"];
  }

  /* ---------- 15. IMAGING & BIOMARKERS ---------------------------- */
  subgraph cluster_img {
    label="⑮ 영상과 바이오마커 — 영상은 증상보다 늦다";
    style="rounded,filled"; fillcolor="#eef6f7"; color="#7fb0b6"; fontsize=13;
    node [fillcolor="#d3eaec", color="#5f9aa2"];
    DWI   [label="DWI 제한 (가장 이른 소견)\n증상 후 수일"];
    T2FL  [label="T2/FLAIR 고신호\n'삼지창(trident)' 징후"];
    MRINEG[label="★ 증상 발현 시 MRI 정상일 수 있음 ★\n재촬영이 필요하다", fillcolor="#a9d8dd"];
    MRSIN [label="¹H-MRS: myo-inositol\n적응·회복을 직접 읽는 유일한 지표"];
    NFL   [label="혈청 NfL (축삭)"];
    GFAPS [label="혈청 GFAP (별아교세포)"];
    S100  [label="S100B"];
  }

  /* ---------- 16. THERAPY: RAISING THE SODIUM --------------------- */
  subgraph cluster_rx1 {
    label="⑯ 치료 ① 나트륨을 올리는 수단";
    style="rounded,filled"; fillcolor="#e8f4ec"; color="#74ab89"; fontsize=13;
    node [fillcolor="#cdead9", color="#569a75"];
    HTS   [label="3% NaCl (513 mmol/L)\n볼루스 100–150 mL 반복\nAdrogué–Madias: ΔNa/L = (513−Na)/(TBW+1)"];
    NS09  [label="0.9% NaCl (154 mmol/L)\nU_osm > 308 이면 저나트륨혈증을 악화시킨다\n(desalination)"];
    FLREST[label="수분 제한\n(U_Na+U_K)/S_Na > 1 이면 실패"];
    UREA  [label="경구 요소 15–30 g/d\n삼투 이뇨 + BBB 보호(동물)"];
    TOLVA [label="Tolvaptan (V2 길항)\n★ 자율적 수분이뇨 → 과교정 위험 ★", fillcolor="#f0c9a0", color="#c08b4f"];
    DEMEC [label="Demeclocycline\n신성 요붕증 유발"];
    FURO  [label="Furosemide + 3% NaCl\n요 농축 차단"];
    KCL   [label="KCl 보충\n★ 40 mmol ≈ +1.1 mmol/L Na ★", fillcolor="#f0c9a0", color="#c08b4f"];
  }

  /* ---------- 17. THERAPY: CONTROLLING THE RATE ------------------- */
  subgraph cluster_rx2 {
    label="⑰ 치료 ② 속도를 지배하는 수단 (여기가 실제 치료다)";
    style="rounded,filled"; fillcolor="#fdf3e8"; color="#c8a06c"; fontsize=13;
    node [fillcolor="#f8e2c6", color="#b58a4e"];
    DDAVP [label="Desmopressin 2 µg IV q8h\nV2 작용 → 신장을 '고정'\nt½ ≈ 3 h", fillcolor="#f2cd9c"];
    PROACT[label="Proactive DDAVP clamp\n처음부터 신장을 정지시키고\n3% NaCl로 속도를 처방한다", fillcolor="#eebf7c"];
    REACT [label="Reactive DDAVP\n과교정이 시작된 뒤 투여"];
    RESCUE[label="Relowering (재하강)\nD5W ± DDAVP\n★ 마감시한이 있다 ★", fillcolor="#eebf7c"];
    MONIT [label="q2h 혈청 Na + 요량\nEFWC 계산"];
    LIMIT [label="교정 한계\n정상위험 ≤10–12 mmol/L/24h\n고위험 ≤8 mmol/L/24h"];
  }

  /* ---------- 18. ADJUNCT / EXPERIMENTAL -------------------------- */
  subgraph cluster_rx3 {
    label="⑱ 보조·실험적 치료 (모두 전임상 또는 증례 수준)";
    style="rounded,filled"; fillcolor="#f2f0f6"; color="#9d95b5"; fontsize=13;
    node [fillcolor="#e0dcec", color="#8378a3"];
    DEXA  [label="Dexamethasone\nBBB 안정화 (rat)"];
    MINO  [label="Minocycline\n미세아교세포 억제 (rat)"];
    IVIG  [label="IVIG (증례 보고)"];
    PLEX  [label="Plasma exchange (증례 보고)"];
    MYOI  [label="myo-Inositol 보충\n(개념적; 임상근거 없음)"];
    TRH   [label="TRH · 저체온 (전임상)"];
  }

  /* ---------- 19. RISK MODIFIERS ---------------------------------- */
  subgraph cluster_risk {
    label="⑲ 위험 수식인자 — 모두 '운반체 용량'으로 수렴한다";
    style="rounded,filled"; fillcolor="#fbeef1"; color="#c58c9c"; fontsize=13;
    node [fillcolor="#f4d6de", color="#b16f83"];
    ALCO  [label="Alcoholism\nSMIT1/TauT 기능↓ · 영양불량"];
    MALN  [label="Malnutrition\nATP 예비력↓"];
    HYPOK2[label="Hypokalaemia\nNa⁺ 공역 수송 구동력↓\n★ 두 경로로 위험 ★"];
    LIVER [label="Liver disease / transplant\nmyo-inositol 이미 고갈"];
    NA105 [label="[Na] < 105\n삼투질 소실 최대"];
    BURN  [label="Burns · 저인산혈증"];
    FOSMN [label="FOSM (유기 수송능)\n1.00 정상 → 0.55 고위험", fillcolor="#eab6c4"];
  }

  /* ---------- 20. THE COUNTERFACTUAL ------------------------------ */
  subgraph cluster_cf {
    label="⑳ 이 모델의 중심 실험 (the one switch)";
    style="rounded,filled"; fillcolor="#e7e7e7"; color="#8a8a8a"; fontsize=13;
    node [fillcolor="#d5d5d5", color="#707070"];
    CF1  [label="같은 환자 · 같은 수액 · 같은 처방"];
    CF2  [label="AVP를 제시 시점 값으로 고정\n(반사실 / counterfactual)"];
    CF3  [label="AVP가 생리적으로 반응하도록 둠"];
    CF4  [label="두 팔의 차이가 곧 병이다\n= 신장이 만든 과교정",
          shape=box, style="filled,bold", fillcolor="#b5b5b5", color="#4a4a4a", fontsize=12];
  }

  /* ================= EDGES ======================================= */
  /* aetiology -> AVP / renal */
  SIADH -> MAGNO [label="자율 분비"];
  HYPOVOL -> ECFV [label="Na 소실"];
  THIAZ -> DCT [label="NCC 차단"];
  ADRENAL -> MAGNO [label="cortisol 억제 소실"];
  POTOM -> SOLEXC [label="용질 부하 ↓↓"];
  PRIMPOL -> TBW [label="수분 섭취 > 배설능"];
  EXERT -> TBW;
  CIRRH -> GLX [label="암모니아 → Gln ↑"];
  CIRRH -> INS [label="myo-inositol ↓ 40%", color="#b0416a", style=bold];
  CHF -> BARO;
  HYPOK -> SK;

  /* AVP axis */
  OSMOR -> MAGNO;  BARO -> MAGNO;  ECFV -> BARO;
  OSMEF -> OSMOR;  MAGNO -> PITUIT -> AVPPL -> V2R -> GS -> PKA -> AQP2;
  AQP2 -> CD [label="정단 물 투과성"];
  AQP34 -> CD;  UTA1 -> MEDGR;  ENAC -> CD;  V2R -> UTA1;  V2R -> ENAC;

  /* renal */
  GFR -> PT -> TAL -> DCT -> CD;
  TAL -> MEDGR;  MEDGR -> UOSM;  SOLEXC -> WASH -> MEDGR [label="농축능 ↓"];
  AQP2 -> UOSM;  SOLEXC -> VU;  UOSM -> VU [label="V = 용질/농도"];
  VU -> UNAK;  UNAK -> EFWC;  VU -> EFWC;  SNA -> EFWC;
  UNAK -> FURST;  SNA -> FURST;  FURST -> FLREST [label="비 > 1 → 무효", style=dashed, color="#b0416a"];
  EFWC -> TBW [label="자유수분 손실", color="#2f7a53", penwidth=2.0];

  /* body */
  TBW -> EDEL;  NAE -> EDEL;  KE -> EDEL;  EDEL -> SNA -> OSMEF;
  NAE -> ECFV;  KE -> SK;  UREAP -> UTB;
  KCL -> KE [label="★ Na를 올린다 ★", color="#b0416a", style=bold];

  /* BBB transport -> brain */
  OSMEF -> AQP4 [label="물은 즉시 평형"];
  AQP4 -> BWAT;
  NKCC1 -> ELIN;  NHE1 -> ELIN;  NKA -> ELIN;  SK -> NKA [label="K⁺ 의존"];
  SMIT1 -> ORGIN;  TAUT -> ORGIN;  BGT1 -> ORGIN;  SNAT -> ORGIN;
  LRRC8 -> ORGOUT;

  /* RVD */
  OSMEF -> SWELL [label="저긴장"];
  SWELL -> RVD -> KCC -> ELOUT;
  RVD -> LRRC8 [label="부피 활성"];
  ELOUT -> BSOL;  ORGOUT -> BSOL;
  ELOUT -> ADAPT;  ORGOUT -> ADAPT;
  ADAPT -> INS [label="−66%", color="#b0416a"];
  ADAPT -> TAU [label="−66%"];  ADAPT -> GLX [label="−55%"];
  ADAPT -> CRE;  ADAPT -> GPC;  ADAPT -> OTHO;

  /* RVI */
  BSHRK -> SHRINK -> RVI -> NKCC1;
  RVI -> ELIN;
  OMEGA -> TONEBP [label="삼투질 결핍이 신호"];
  TONEBP -> ORE -> TRANSC -> SMIT1;
  TRANSC -> TAUT;  TRANSC -> BGT1;
  TRANSC -> ORGIN;
  ORGIN -> INS;  ORGIN -> TAU;  ORGIN -> GLX;  ORGIN -> CRE;  ORGIN -> GPC;  ORGIN -> OTHO;
  ORGOUT -> ASYM [style=dashed];  ORGIN -> ASYM [style=dashed];
  ASYM -> OMEGA [color="#8a6b12", penwidth=2.0];
  SK -> ORGIN [label="Na 구동력", color="#b0416a"];
  ATP -> ORGIN [label="에너지"];

  /* organic pools -> omega */
  INS -> ORGT;  TAU -> ORGT;  GLX -> ORGT;  CRE -> ORGT;  GPC -> ORGT;  OTHO -> ORGT;
  ORGT -> OMEGA;  OSMEF -> OMEGA [label="ORG_set(Osm_eff)"];
  ORGT -> BSOL;  ELIN -> BSOL;

  /* brain volume */
  BSOL -> BWAT;  OSMEF -> BWAT;
  BWAT -> BSWEL [label="> 정상"];
  BWAT -> BSHRK [label="< 정상"];
  OMEGA -> STRESS [penwidth=2.0, color="#1f6a45"];
  BSHRK -> STRESS;
  BSWEL -> SEIZ [label="급성 저나트륨혈증의 위험"];

  /* injury cascade */
  STRESS -> ATP [label="NKA 부하"];
  MALN -> ATP;  SK -> ATP;
  STRESS -> MPTP [label="역치 초과분^1.x"];
  ATP -> MPTP [label="에너지 실패"];
  MPTP -> CASP -> ASTD;
  ASTD -> GFAP;  ASTD -> AQP4L;
  GAPJ -> ASTD [label="3% 미만 손실은 보상", style=dashed];
  ASTREP -> ASTD [label="재증식", style=dashed];
  ASTD -> BBBOP;  BBBOP -> MMP9;  ASTD -> MICRO;  BBBOP -> MICRO;
  MICRO -> TNF;  MICRO -> ASTMG;  ASTMG -> ASTD;
  BBBOP -> IGGE;  BBBOP -> COMPL;
  ASTD -> TROPH -> OLID;
  TNF -> OLID;  COMPL -> OLID;  IGGE -> OLID;
  OLID -> MBP -> MYE;  OLID -> MYE;
  OPC -> REMY -> MYE;  OLID -> OPC [label="손상 신호"];
  MYE -> AXON [style=dashed, label="축삭 보존"];

  /* topography */
  GWINT -> CPM;  GWINT -> EPM;  MYE -> CPM;  MYE -> EPM;  CPM -> SPARE [style=dashed];

  /* clinical */
  OSMEF -> PHASE1 [label="교정 → 즉시 호전"];
  CPM -> PHASE2;  EPM -> PHASE2;
  PHASE2 -> DYSAR;  PHASE2 -> QUAD -> LOCKED;  PHASE2 -> SEIZ;  EPM -> MOVD;
  DYSAR -> MRS;  QUAD -> MRS;  MOVD -> MRS;  REMY -> RECOV -> MRS;

  /* imaging */
  CPM -> DWI -> T2FL;  PHASE2 -> MRINEG [label="증상이 먼저다", color="#b0416a", style=bold];
  DWI -> MRINEG [style=dashed];
  INS -> MRSIN;  ASTD -> GFAPS;  MBP -> NFL;  ASTD -> S100;

  /* therapy: raise sodium */
  HTS -> NAE [penwidth=1.6];
  NS09 -> NAE;  NS09 -> UOSM [label="U_osm>308 이면 역효과", style=dashed, color="#b0416a"];
  FLREST -> TBW;
  UREA -> SOLEXC [label="삼투 이뇨"];  UREA -> UREAP;  UREAP -> BBBOP [label="보호 (동물)", style=dashed, color="#2f7a53"];
  UREA -> MICRO [label="억제 (동물)", style=dashed, color="#2f7a53"];
  TOLVA -> V2R [label="경쟁적 길항", color="#c08b4f", style=bold];
  DEMEC -> AQP2 [label="신성 요붕증"];
  FURO -> TAL;

  /* therapy: control the rate */
  DDAVP -> V2R [label="V2 작용", penwidth=1.8, color="#b58a4e"];
  DDAVP -> AQP2;
  PROACT -> DDAVP;  REACT -> DDAVP;  RESCUE -> DDAVP;
  PROACT -> HTS [label="속도를 처방 가능하게 만든다", color="#8a6b12", penwidth=1.8];
  RESCUE -> TBW [label="D5W 자유수분"];
  MONIT -> LIMIT;  EFWC -> MONIT;  LIMIT -> HTS;
  RESCUE -> OMEGA [label="Ω를 역치 아래로 되돌린다", color="#2f7a53", style=bold];

  /* adjunct */
  DEXA -> BBBOP [style=dashed, color="#2f7a53"];
  MINO -> MICRO [style=dashed, color="#2f7a53"];
  IVIG -> IGGE [style=dashed];  PLEX -> IGGE [style=dashed];
  MYOI -> INS [style=dashed];  TRH -> OLID [style=dashed];

  /* risk */
  ALCO -> FOSMN;  MALN -> FOSMN;  HYPOK2 -> FOSMN;  LIVER -> FOSMN;
  NA105 -> OMEGA;  BURN -> FOSMN;
  FOSMN -> ORGIN [label="재축적 속도 ↓", color="#b16f83", penwidth=2.0];
  HYPOK2 -> KCL [label="보충하면 Na가 오른다", style=dashed, color="#b0416a"];

  /* counterfactual */
  CF1 -> CF2;  CF1 -> CF3;
  CF2 -> CF4;  CF3 -> CF4;
  AVPPL -> CF3 [style=dashed];
  CF4 -> EFWC [style=dashed, color="#4a4a4a"];
}
