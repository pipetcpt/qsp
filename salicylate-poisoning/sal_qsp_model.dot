digraph SAL_QSP_Model {
  graph [
    label=<<B>Salicylate (Aspirin) Poisoning — QSP Mechanistic Map</B><BR/><FONT POINT-SIZE="14">The disease is graded by a number the assay reports — TOTAL plasma salicylate — that is separated from the quantity which does the killing (salicylate inside brain cells)<BR/>by two multiplications nobody measures: the free fraction (albumin saturates) and the pH partition of a weak acid, pKa 3.0.  Brain intracellular pH is BUFFERED and plasma pH is not,<BR/>so every intervention that moves PaCO2 or bicarbonate moves the partition — which is why the ventilator is a drug, and why the lab number can improve while the patient is being poisoned.</FONT>>
    labelloc=t fontsize=22 fontname="Helvetica"
    rankdir=LR bgcolor="#F7F8FA"
    splines=spline nodesep=0.30 ranksep=1.00
    newrank=true compound=true concentrate=false
  ]
  node [fontname="Helvetica" fontsize=10 style="filled,rounded" shape=box margin="0.14,0.05"]
  edge [fontname="Helvetica" fontsize=8 arrowsize=0.65 color="#5A6270"]

  //=========================================================
  // CLUSTER 1 : Exposure — five presentations, one molecule
  //=========================================================
  subgraph cluster_exposure {
    label="💊 Exposure — five clinical presentations that all reduce to a salicylate input rate"
    style=filled fillcolor="#FFEBEE" color="#B71C1C" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    X_acute   [label="Acute single ingestion\n150–500 mg/kg aspirin\n(10–35 g in an adult)" fillcolor="#FFCDD2" color="#B71C1C"]
    X_ec      [label="Enteric-coated aspirin\ndissolution delayed 4–12 h\npeak may be >24 h" fillcolor="#FFCDD2" color="#B71C1C"]
    X_conc    [label="Pharmacobezoar / concretion\n>20 g tablets + pylorospasm\n→ continuing absorption for days" fillcolor="#FFCDD2" color="#B71C1C"]
    X_chronic [label="Chronic therapeutic overshoot\n(therapeutic salicylism)\n3.6–5.4 g/day, elderly, CKD" fillcolor="#EF9A9A" color="#7F0000"]
    X_methyl  [label="Methyl salicylate\noil of wintergreen 1 mL ≈ 1.4 g ASA\ntopical / paediatric ingestion" fillcolor="#FFCDD2" color="#B71C1C"]
    X_bismuth [label="Bismuth subsalicylate\nteething gels · antidiarrhoeals\n(occult chronic source)" fillcolor="#FFCDD2" color="#B71C1C"]
    X_rate    [label="Salicylate input rate\nR_in(t)  ← the single\ncommon entry point" shape=diamond fillcolor="#E57373" color="#7F0000" fontcolor="white"]
  }

  //=========================================================
  // CLUSTER 2 : Gut — absorption is itself pH-dependent
  //=========================================================
  subgraph cluster_gut {
    label="🥄 Gastrointestinal handling (the first ion trap)"
    style=filled fillcolor="#FFF3E0" color="#E65100" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    G_stom   [label="Stomach  A_ST\ngastric pH 1.5–3.5 → aspirin is\nUN-IONISED → absorbed here" fillcolor="#FFE0B2" color="#E65100"]
    G_pylor  [label="Pylorospasm · delayed emptying\nsalicylate itself slows the stomach\n(self-prolonging absorption)" fillcolor="#FFE0B2" color="#E65100"]
    G_conc   [label="Concretion pool  A_CONC\nk_diss ≈ 0.03 /h\nreleases for 24–72 h" fillcolor="#FFCC80" color="#BF360C"]
    G_gut    [label="Small intestine  A_GUT\nlarge surface area\nka ≈ 1.6 /h (plain)" fillcolor="#FFE0B2" color="#E65100"]
    G_first  [label="Presystemic hydrolysis\ngut wall + hepatic esterases\naspirin → salicylate" fillcolor="#FFE0B2" color="#E65100"]
    G_char   [label="Activated charcoal  A_AC\n1 g/kg; binds ~10× its mass\nMDAC for EC / concretion" fillcolor="#FFF59D" color="#F57F17"]
    G_wbi    [label="Whole-bowel irrigation\nPEG 1.5–2 L/h\n(radio-opaque tablet mass)" fillcolor="#FFF59D" color="#F57F17"]
    G_gastric[label="Gastric mucosal injury\nCOX-1 block + direct acid trapping\nerosions · haemorrhage" fillcolor="#FFCC80" color="#BF360C"]
  }

  //=========================================================
  // CLUSTER 3 : Plasma binding — MULTIPLIER 1
  //=========================================================
  subgraph cluster_bind {
    label="🧪 MULTIPLIER 1 — plasma protein binding saturates (the free fraction is not a constant)"
    style=filled fillcolor="#E8EAF6" color="#283593" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    B_ctot  [label="TOTAL plasma salicylate  C_tot\n★ THE NUMBER THE LAB REPORTS ★\nmg/L  (mg/dL × 10)" fillcolor="#9FA8DA" color="#1A237E" penwidth=2]
    B_alb   [label="Albumin  40 g/L\nsite class 1: B1 232 mg/L, Kd 11.7\nsite class 2: B2 491 mg/L, Kd 381" fillcolor="#C5CAE9" color="#1A237E"]
    B_free  [label="FREE salicylate  C_f\n★ the pharmacologically real one ★\nC_f = C_tot − bound(C_f)" fillcolor="#7986CB" color="#1A237E" fontcolor="white" penwidth=2]
    B_fu    [label="Free fraction  fu\n150 mg/L → 8.5%\n500 mg/L → 29%\n800 mg/L → 43%" shape=diamond fillcolor="#5C6BC0" color="#1A237E" fontcolor="white"]
    B_hypo  [label="Hypoalbuminaemia\nelderly · cirrhosis · sepsis\n→ fu ↑ at the SAME total level" fillcolor="#C5CAE9" color="#1A237E"]
    B_disp  [label="Displacement\nwarfarin · phenytoin · valproate\nNSAIDs · free fatty acids" fillcolor="#C5CAE9" color="#1A237E"]
    B_acid  [label="Acidaemia weakens binding\nKd × (1 + 2.0·ΔpH)\n+21% free at pH 7.10" fillcolor="#C5CAE9" color="#1A237E"]
  }

  //=========================================================
  // CLUSTER 4 : pH partition — MULTIPLIER 2
  //=========================================================
  subgraph cluster_partition {
    label="⚖️ MULTIPLIER 2 — the pH partition of a weak acid (pKa 3.0): where the poison actually goes"
    style=filled fillcolor="#E0F7FA" color="#006064" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    P_pka    [label="Salicylic acid  pKa ≈ 3.0\nun-ionised fraction f_n(pH)\n= 1 / (1 + 10^(pH − pKa))" shape=diamond fillcolor="#80DEEA" color="#006064"]
    P_fn74   [label="f_n at pH 7.40\n= 40 parts per million\n(only this crosses membranes)" fillcolor="#B2EBF2" color="#006064"]
    P_fn710  [label="f_n at pH 7.10\n= 79 ppm\n(×2 in half a pH unit)" fillcolor="#B2EBF2" color="#006064"]
    P_kpbr   [label="Brain : free-plasma partition\nKp = f_n(pH_plasma) / f_n(pH_brain)\n≈ 10^(pH_brain − pH_plasma)" shape=diamond fillcolor="#4DD0E1" color="#006064" penwidth=2]
    P_brain  [label="BRAIN salicylate  C_cns\n★ THE VARIABLE THAT KILLS ★\nnever measured in life" fillcolor="#00838F" color="#006064" fontcolor="white" penwidth=3]
    P_musc   [label="Muscle / viscera  C_tis\nV 28 L — the big sink\nsets the apparent Vd" fillcolor="#B2EBF2" color="#006064"]
    P_vd     [label="Apparent Vd\n0.11 L/kg therapeutic →\n0.32 L/kg in acidaemic overdose" fillcolor="#B2EBF2" color="#006064"]
    P_buffb  [label="Brain intracellular buffering\nβ ≈ 35 mmol/L per pH unit\nHCO3⁻ᵢ = BB − β·(pH − 7.05)" fillcolor="#80DEEA" color="#006064"]
    P_phb    [label="Brain intracellular pH  pH_b\nDEFENDED: PaCO2 25→60 moves\nplasma 0.38 but brain only 0.14" fillcolor="#4DD0E1" color="#006064" penwidth=2]
    P_bb     [label="Brain buffer base  BB_b\ntracks plasma HCO3⁻ slowly\nt½ ≈ 4 h  ← the slow variable" fillcolor="#B2EBF2" color="#006064"]
    P_csf    [label="CSF / brain ECF\nno active efflux for salicylate\n(passive trapping only)" fillcolor="#B2EBF2" color="#006064"]
    P_asym   [label="THE ASYMMETRY\nCO2 crosses instantly, HCO3⁻ does not\n→ respiratory and metabolic acidosis\nare NOT equivalent for the brain" shape=note fillcolor="#FFF9C4" color="#F9A825" penwidth=2]
  }

  //=========================================================
  // CLUSTER 5 : Hepatic metabolism — capacity limited
  //=========================================================
  subgraph cluster_metab {
    label="🏭 Hepatic metabolism — five pathways, two of them saturable (Levy 1965)"
    style=filled fillcolor="#F3E5F5" color="#4A148C" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    M_hyd   [label="Esterase hydrolysis\naspirin → salicylate\nt½ 15–20 min" fillcolor="#E1BEE7" color="#4A148C"]
    M_su    [label="Salicyluric acid  (75% of dose)\nglycine N-acyltransferase\nVmax 100 mg/h · Km 34 mg/L  ★SATURATES" fillcolor="#CE93D8" color="#4A148C"]
    M_gly   [label="Glycine pool\ndepleted by conjugation\n→ effective Vmax falls with time" fillcolor="#E1BEE7" color="#4A148C"]
    M_pg    [label="Salicyl phenolic glucuronide\nUGT1A6\nVmax 27 mg/h · Km 550 mg/L  ★SATURATES" fillcolor="#CE93D8" color="#4A148C"]
    M_ag    [label="Salicyl acyl glucuronide\nUGT1A6 / 2B7\nfirst order, CL 0.045 L/h" fillcolor="#E1BEE7" color="#4A148C"]
    M_ga    [label="Gentisic acid  (CYP2C9)\n<1% of the dose\nfirst order" fillcolor="#E1BEE7" color="#4A148C"]
    M_kin   [label="Michaelis-Menten kinetics\nt½ 2–4 h at 650 mg\n→ 20–40 h in overdose" shape=diamond fillcolor="#BA68C8" color="#4A148C" fontcolor="white"]
    M_ceil  [label="Metabolic ceiling ≈ 2.5 g/day\na 30 g ingestion cannot be\nmetabolised — it must be excreted" shape=note fillcolor="#FFF9C4" color="#F9A825"]
  }

  //=========================================================
  // CLUSTER 6 : Renal handling — the therapeutic lever
  //=========================================================
  subgraph cluster_renal {
    label="🫘 Renal handling — non-ionic back-diffusion is the whole of urinary alkalinisation"
    style=filled fillcolor="#E8F5E9" color="#1B5E20" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    R_gfr    [label="GFR  7.2 L/h (120 mL/min)\nfalls with volume contraction\nGFR frac = 1 − 3·(ECF deficit)" fillcolor="#C8E6C9" color="#1B5E20"]
    R_filt   [label="Filtered load\n= GFR × C_free\n(only unbound drug is filtered)" fillcolor="#C8E6C9" color="#1B5E20"]
    R_sec    [label="Proximal secretion\nOAT1 / OAT3\n(saturable, probenecid-sensitive)" fillcolor="#C8E6C9" color="#1B5E20"]
    R_reab   [label="Tubular back-diffusion\nfrac_reab = 1 − exp(−a·f_n(urine pH)/UO)\n★ the pH-sensitive step" fillcolor="#A5D6A7" color="#1B5E20" penwidth=2]
    R_uph    [label="URINE pH\npH 5 → 97% reabsorbed\npH 8 → <3% reabsorbed" shape=diamond fillcolor="#66BB6A" color="#1B5E20" fontcolor="white" penwidth=2]
    R_thr    [label="Renal HCO3⁻ threshold ≈ 25 mmol/L\n↑ with hypokalaemia (+5.5 per mmol/L)\n↑ with volume contraction\n↓ with hypocapnia (−0.2 per mmHg)" fillcolor="#A5D6A7" color="#1B5E20"]
    R_bicu   [label="Bicarbonaturia\n= GFR × (HCO3⁻ − threshold)\n→ urinary HCO3⁻ concentration" fillcolor="#C8E6C9" color="#1B5E20"]
    R_uo     [label="Urine flow  UO\ncontact time ∝ 1/UO\n(why dehydration is so costly)" fillcolor="#C8E6C9" color="#1B5E20"]
    R_clren  [label="Renal clearance of salicylate\n0.5 mL/min at acid urine →\n40+ mL/min at urine pH 7.5–8" fillcolor="#81C784" color="#1B5E20"]
    R_kwast  [label="Kaliuresis\nurinary K = 20 + 0.35 × urinary HCO3⁻\n(alkalinisation causes it)" fillcolor="#C8E6C9" color="#1B5E20"]
    R_atn    [label="Acute kidney injury\nvolume depletion · hyperthermia\n· rhabdomyolysis → clearance collapses" fillcolor="#A5D6A7" color="#1B5E20"]
  }

  //=========================================================
  // CLUSTER 7 : Mitochondrial uncoupling
  //=========================================================
  subgraph cluster_mito {
    label="🔥 Mitochondrial uncoupling — the source of every metabolic sign"
    style=filled fillcolor="#FFF8E1" color="#FF6F00" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    U_prot  [label="Salicylate is a protonophore\nshuttles H⁺ across the inner membrane\n(the anion carries the proton back)" fillcolor="#FFECB3" color="#FF6F00"]
    U_grad  [label="Proton-motive force ↓\nΔψ dissipated" fillcolor="#FFECB3" color="#FF6F00"]
    U_atp   [label="Oxidative phosphorylation uncoupled\nATP synthesis ↓ while\nO2 consumption ↑" fillcolor="#FFE082" color="#FF6F00"]
    U_heat  [label="Heat production ↑\n→ HYPERTHERMIA\n(an agonal sign in adults)" fillcolor="#FFCA28" color="#E65100"]
    U_kreb  [label="Krebs cycle inhibition\nα-ketoglutarate & succinate\ndehydrogenases inhibited" fillcolor="#FFECB3" color="#FF6F00"]
    U_lac   [label="Lactate ↑\nanaerobic compensation\n(26 mmol/h at full uncoupling)" fillcolor="#FFE082" color="#FF6F00"]
    U_ket   [label="Ketogenesis ↑\nlipolysis + fatty-acid oxidation\nβ-hydroxybutyrate" fillcolor="#FFE082" color="#FF6F00"]
    U_glu   [label="Glycolysis ↑ · glucose demand ↑\nhepatic glycogen depleted" fillcolor="#FFECB3" color="#FF6F00"]
    U_vco2  [label="CO2 production ↑ (×1.6)\n→ the ventilator must do MORE\nwork, not less" fillcolor="#FFCA28" color="#E65100"]
    U_o2    [label="Tissue O2 extraction ↑\nnarrowed a-v difference late" fillcolor="#FFECB3" color="#FF6F00"]
  }

  //=========================================================
  // CLUSTER 8 : Acid-base control
  //=========================================================
  subgraph cluster_ab {
    label="🌬️ Acid-base — a genuinely mixed disorder, and the ventilator sits inside it"
    style=filled fillcolor="#E3F2FD" color="#0D47A1" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    A_resp   [label="Medullary respiratory centre\ndirectly stimulated by salicylate\nEmax 1.65 × , EC50 22 mg/L (brain)" fillcolor="#BBDEFB" color="#0D47A1"]
    A_chemo  [label="Central chemoreceptors\nrespond to brain pHi\n(not to plasma pH)" fillcolor="#BBDEFB" color="#0D47A1"]
    A_va     [label="Alveolar ventilation  V_A\n2–3 × normal in the awake patient\n★ this is a therapy the patient\nis giving themselves" fillcolor="#90CAF9" color="#0D47A1" penwidth=2]
    A_paco2  [label="PaCO2\n20–25 mmHg untreated\n(respiratory alkalosis first)" fillcolor="#90CAF9" color="#0D47A1"]
    A_hco3   [label="Plasma HCO3⁻\nconsumed by lactate, ketoacids\nand salicylate anion itself" fillcolor="#BBDEFB" color="#0D47A1"]
    A_ph     [label="Arterial pH\n6.1 + log10(HCO3⁻ / 0.0301·PaCO2)\ntypically HIGH early, low late" fillcolor="#64B5F6" color="#0D47A1" penwidth=2]
    A_ag     [label="Anion gap ↑\nlactate + ketoacids + salicylate\n(salicylate itself ≈ 5 mEq/L at 700 mg/L)" fillcolor="#BBDEFB" color="#0D47A1"]
    A_fatig  [label="Respiratory muscle fatigue\naccrues at V_A > 2.4 ×\n→ the compensation fails abruptly" fillcolor="#90CAF9" color="#0D47A1"]
    A_mixed  [label="Mixed primary respiratory alkalosis\n+ primary metabolic acidosis\n(a NORMAL pH conceals both)" shape=note fillcolor="#FFF9C4" color="#F9A825"]
    A_comp   [label="Renal compensation\nNH4⁺ / titratable acid excretion\n20 mmol/h per pH unit" fillcolor="#BBDEFB" color="#0D47A1"]
  }

  //=========================================================
  // CLUSTER 9 : CNS injury
  //=========================================================
  subgraph cluster_cns {
    label="🧠 Central nervous system — where the concentration that matters does its work"
    style=filled fillcolor="#FCE4EC" color="#880E4F" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    C_glut  [label="GLUT1 transport across the BBB\ninflux − efflux, Km 6 mmol/L" fillcolor="#F8BBD0" color="#880E4F"]
    C_cmr   [label="Cerebral glucose consumption\n18 mmol/L/h, ×1.5 when uncoupled" fillcolor="#F8BBD0" color="#880E4F"]
    C_neuro [label="NEUROGLYCOPENIA\nbrain glucose 1.3 → <0.5 mmol/L\nwith a NORMAL serum glucose" fillcolor="#F48FB1" color="#880E4F" penwidth=2]
    C_oedem [label="Cerebral oedema\nuncoupling + Na/K-ATPase failure\n(a terminal finding)" fillcolor="#F8BBD0" color="#880E4F"]
    C_tinn  [label="Tinnitus · reversible hearing loss\ncochlear outer hair cells\nprestin / NMDA; ~200–300 mg/L" fillcolor="#F8BBD0" color="#880E4F"]
    C_agit  [label="Agitation → confusion →\nlethargy → coma" fillcolor="#F48FB1" color="#880E4F"]
    C_seiz  [label="Seizure\n(hypoglycorrhachia + oedema)" fillcolor="#F48FB1" color="#880E4F"]
    C_inj   [label="Cumulative CNS injury\n∫ max(0, C_cns − 45) dt\n★ duration matters, not just peak" shape=diamond fillcolor="#EC407A" color="#880E4F" fontcolor="white"]
  }

  //=========================================================
  // CLUSTER 10 : Other organ systems
  //=========================================================
  subgraph cluster_organ {
    label="🫀 Other organ systems"
    style=filled fillcolor="#EFEBE9" color="#3E2723" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    O_cox1  [label="COX-1 inhibition (irreversible)\nplatelet TXA2 → bleeding time ↑\nlasts the platelet lifespan" fillcolor="#D7CCC8" color="#3E2723"]
    O_cox2  [label="COX-2 inhibition\nprostaglandin-dependent\nrenal blood flow ↓" fillcolor="#D7CCC8" color="#3E2723"]
    O_lung  [label="Non-cardiogenic pulmonary oedema\n(ALI/ARDS) — age, smoking,\nchronic exposure, acidaemia" fillcolor="#BCAAA4" color="#3E2723"]
    O_vaso  [label="Vasodilatation · relative hypovolaemia\n+ insensible loss from hyperpnoea\nand sweating (up to 5 L deficit)" fillcolor="#D7CCC8" color="#3E2723"]
    O_hep   [label="Hepatotoxicity\ntransaminitis; Reye syndrome\nin children with viral illness" fillcolor="#D7CCC8" color="#3E2723"]
    O_coag  [label="Hypoprothrombinaemia\nvitamin-K-dependent factor ↓\nINR ↑ (a late marker)" fillcolor="#D7CCC8" color="#3E2723"]
    O_gi    [label="Nausea · vomiting\n(chemoreceptor trigger zone)\n→ further volume and K loss" fillcolor="#D7CCC8" color="#3E2723"]
    O_temp  [label="Core temperature\n37 → 38.5 °C\nhyperthermia = poor prognosis" fillcolor="#BCAAA4" color="#3E2723"]
  }

  //=========================================================
  // CLUSTER 11 : Electrolytes and volume
  //=========================================================
  subgraph cluster_lyte {
    label="🧂 Potassium and volume — the hidden dependencies of the therapy"
    style=filled fillcolor="#F1F8E9" color="#33691E" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    L_kb    [label="Total body potassium  KB\nlost in urine, vomit, and\ninto cells with alkalaemia" fillcolor="#DCEDC8" color="#33691E"]
    L_shift [label="Transcellular shift\nΔK ≈ −3.0 mmol/L per pH unit\n(alkalaemia lowers plasma K)" fillcolor="#DCEDC8" color="#33691E"]
    L_kp    [label="Plasma K⁺\n★ the rate-limiting reagent of\nurinary alkalinisation" fillcolor="#AED581" color="#33691E" penwidth=2]
    L_ecf   [label="ECF volume  V_ECF\nintake − urine − insensible\n− sweat (0.16 L/h uncoupled)" fillcolor="#DCEDC8" color="#33691E"]
    L_na    [label="Sodium load from NaHCO3\nhypernatraemia · volume overload\n(the limit in CKD and HF)" fillcolor="#DCEDC8" color="#33691E"]
    L_ica   [label="Ionised calcium ↓ with alkalaemia\ntetany · QT" fillcolor="#DCEDC8" color="#33691E"]
  }

  //=========================================================
  // CLUSTER 12 : Therapeutics
  //=========================================================
  subgraph cluster_rx {
    label="💉 Therapeutics — five entry points into the same two multipliers"
    style=filled fillcolor="#E0F2F1" color="#004D40" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    T_ac     [label="1. DECONTAMINATION\nactivated charcoal ± MDAC\n(EC tablets, concretion, rising levels)" fillcolor="#B2DFDB" color="#004D40"]
    T_fluid  [label="2. VOLUME\ncrystalloid 10–20 mL/kg then\n1.5–2 × maintenance" fillcolor="#B2DFDB" color="#004D40"]
    T_bic    [label="3. SODIUM BICARBONATE\n1–1.5 mmol/kg bolus, then\n150 mmol/L at 250 mL/h" fillcolor="#4DB6AC" color="#004D40" penwidth=2]
    T_bic2   [label="…acts on BOTH multipliers:\n(a) plasma pH ↑ → drug leaves the brain\n(b) urine pH ↑ → renal clearance ×10–20" shape=note fillcolor="#FFF9C4" color="#F9A825"]
    T_k      [label="4. POTASSIUM\n20–40 mmol/L in the infusion\n(without it the urine will not alkalinise)" fillcolor="#80CBC4" color="#004D40"]
    T_glc    [label="5. DEXTROSE\ngive it whatever the serum glucose is\n(the brain is hypoglycaemic, the blood is not)" fillcolor="#80CBC4" color="#004D40"]
    T_hd     [label="6. HAEMODIALYSIS\nCL ≈ 6 L/h (100 mL/min);\nremoves drug AND corrects the acidosis" fillcolor="#4DB6AC" color="#004D40" penwidth=2]
    T_extrip [label="EXTRIP indications\nlevel >90 mg/dL (>6.6 mmol/L),\naltered mental state, ALI,\npH ≤7.20, failure of therapy, AKI" shape=note fillcolor="#FFF9C4" color="#F9A825"]
    T_vent   [label="7. VENTILATION STRATEGY\nif intubation is unavoidable:\nmatch the patient's own minute\nventilation, and give bicarbonate first" fillcolor="#4DB6AC" color="#004D40" penwidth=2]
    T_cool   [label="External cooling\n(hyperthermia is uncoupling,\nnot infection — antipyretics do nothing)" fillcolor="#B2DFDB" color="#004D40"]
  }

  //=========================================================
  // CLUSTER 13 : Iatrogenic hazards
  //=========================================================
  subgraph cluster_harm {
    label="☠️ Iatrogenic hazards — the same equations, run backwards"
    style=filled fillcolor="#FFEBEE" color="#B71C1C" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    H_intub [label="INTUBATION at a 'normal' PaCO2\nremoves the compensation the\npatient was generating" fillcolor="#EF9A9A" color="#7F0000" penwidth=2]
    H_apnoea[label="Apnoeic period at induction\n(RSI, paralysis, tube-check delay)\nPaCO2 rises 3–6 mmHg per minute" fillcolor="#FFCDD2" color="#B71C1C"]
    H_sed   [label="Sedation / opioid co-ingestion\n45% depression of drive is enough\nto raise brain salicylate" fillcolor="#FFCDD2" color="#B71C1C"]
    H_acz   [label="Acetazolamide\nalkalinises urine but ACIDIFIES blood\n→ moves drug INTO the brain" fillcolor="#EF9A9A" color="#7F0000"]
    H_nok   [label="Alkalinising without potassium\ndelays urine pH 7.5 by ~10 h\nand costs 3 mmol/L extra HCO3⁻" fillcolor="#FFCDD2" color="#B71C1C"]
    H_delay [label="Waiting for the level to 'declare itself'\nin an EC ingestion or a\nchronic presentation" fillcolor="#FFCDD2" color="#B71C1C"]
    H_fluid [label="Fluid restriction / diuretics\nurine flow ↓ → contact time ↑\n→ back-diffusion ↑" fillcolor="#FFCDD2" color="#B71C1C"]
  }

  //=========================================================
  // CLUSTER 14 : Measurement and its failures
  //=========================================================
  subgraph cluster_dx {
    label="🔬 Measurement — and why the standard readings mislead"
    style=filled fillcolor="#EDE7F6" color="#311B92" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    D_level  [label="Serial salicylate levels q2h\nuntil falling AND\nsymptoms improving" fillcolor="#D1C4E9" color="#311B92"]
    D_units  [label="Unit trap\nmg/dL vs mg/L vs mmol/L\n(×10 and ×0.0724)" fillcolor="#D1C4E9" color="#311B92"]
    D_done   [label="Done nomogram (1960)\nderived from ONE paediatric\nacute-ingestion series" fillcolor="#B39DDB" color="#311B92"]
    D_donefail[label="…fails for: chronic exposure,\nEC/concretion, acidaemia,\nand any patient whose pH has moved" shape=note fillcolor="#FFF9C4" color="#F9A825"]
    D_abg    [label="Arterial blood gas + electrolytes\n(the pH is more informative\nthan the level)" fillcolor="#D1C4E9" color="#311B92"]
    D_gap    [label="Osmolar / anion gap\nlactate · ketones · salicylate" fillcolor="#D1C4E9" color="#311B92"]
    D_ferric [label="Ferric chloride / Trinder\nqualitative screen\n(false positives: ketones, phenothiazines)" fillcolor="#D1C4E9" color="#311B92"]
    D_free   [label="FREE salicylate assay\nnot routinely available\n— the missing measurement" fillcolor="#B39DDB" color="#311B92" penwidth=2]
  }

  //=========================================================
  // CLUSTER 15 : Clinical endpoints
  //=========================================================
  subgraph cluster_end {
    label="🎯 Clinical endpoints (model outputs)"
    style=filled fillcolor="#FAFAFA" color="#212121" penwidth=2 fontsize=13 fontname="Helvetica-Bold"

    E_cns    [label="CNS score  0–100\nEmax on brain salicylate\nEC50 95 mg/L, Hill 2.2" fillcolor="#E0E0E0" color="#212121"]
    E_sev    [label="Severity index\nCNS + acidaemia + neuroglycopenia\n+ hyperthermia" fillcolor="#BDBDBD" color="#212121"]
    E_surv   [label="Survival / ICU need\ndriven by cumulative CNS exposure,\nnot by the peak level" fillcolor="#BDBDBD" color="#212121"]
    E_t12    [label="Apparent half-life\n3 h therapeutic → 37 h overdose\n→ 8 h with alkalinisation → 3 h on HD" fillcolor="#E0E0E0" color="#212121"]
    E_los    [label="Time to a safe level (<30 mg/dL)\nand length of stay" fillcolor="#E0E0E0" color="#212121"]
  }

  //=========================================================
  // EDGES — exposure and absorption
  //=========================================================
  X_acute -> X_rate; X_ec -> X_rate; X_chronic -> X_rate;
  X_methyl -> X_rate; X_bismuth -> X_rate; X_conc -> X_rate;
  X_rate -> G_stom;
  X_ec -> G_conc [style=dashed]; X_acute -> G_conc [label="≥20 g" style=dashed];
  G_stom -> G_gut [label="gastric emptying"];
  G_conc -> G_gut [label="slow dissolution"];
  G_stom -> G_pylor; G_pylor -> G_stom [label="delays emptying" style=dashed color="#B71C1C"];
  G_gut -> G_first; G_first -> B_ctot [label="F ≈ 0.9"];
  G_char -> G_stom [label="adsorbs" color="#1B5E20" arrowhead=tee];
  G_char -> G_gut [color="#1B5E20" arrowhead=tee];
  G_wbi -> G_conc [color="#1B5E20" arrowhead=tee];
  T_ac -> G_char; G_stom -> G_gastric; G_gastric -> O_gi;

  //=========================================================
  // EDGES — binding
  //=========================================================
  B_ctot -> B_free [label="minus bound"];
  B_alb -> B_free [arrowhead=tee label="binds"];
  B_free -> B_fu; B_ctot -> B_fu;
  B_hypo -> B_alb [arrowhead=tee]; B_disp -> B_alb [arrowhead=tee];
  B_acid -> B_alb [arrowhead=tee];
  A_ph -> B_acid;
  B_fu -> B_free [style=dashed];

  //=========================================================
  // EDGES — partition
  //=========================================================
  P_pka -> P_fn74; P_pka -> P_fn710;
  A_ph -> P_fn74 [style=dashed]; A_ph -> P_fn710 [style=dashed];
  P_fn74 -> P_kpbr; P_fn710 -> P_kpbr;
  P_phb -> P_kpbr [label="denominator"];
  P_buffb -> P_phb; P_bb -> P_phb;
  A_hco3 -> P_bb [label="t½ 4 h (slow)"];
  A_paco2 -> P_phb [label="instant (CO2 diffuses)" color="#B71C1C" penwidth=2];
  A_paco2 -> A_ph [label="instant"];
  P_asym -> P_kpbr [style=dashed];
  B_free -> P_brain [label="× Kp"]; P_kpbr -> P_brain [penwidth=2 color="#00838F"];
  B_free -> P_musc; P_kpbr -> P_musc [style=dashed label="same physics"];
  P_musc -> P_vd; B_fu -> P_vd;
  P_vd -> B_ctot [label="dilution: a bigger Vd\nLOWERS the reported level" style=dashed color="#B71C1C"];
  P_brain -> P_csf [dir=both style=dashed];

  //=========================================================
  // EDGES — metabolism
  //=========================================================
  G_first -> M_hyd; B_ctot -> M_su; B_ctot -> M_pg; B_ctot -> M_ag; B_ctot -> M_ga;
  M_su -> M_gly [arrowhead=tee label="consumes"]; M_gly -> M_su [label="limits Vmax" style=dashed];
  M_su -> M_kin; M_pg -> M_kin; M_kin -> E_t12;
  M_kin -> M_ceil; M_ceil -> R_clren [style=dashed label="everything else\nmust go renally"];

  //=========================================================
  // EDGES — renal
  //=========================================================
  B_free -> R_filt; R_gfr -> R_filt; B_free -> R_sec;
  R_filt -> R_reab; R_sec -> R_reab;
  R_uph -> R_reab [arrowhead=tee penwidth=2 color="#1B5E20"];
  R_uo -> R_reab [arrowhead=tee label="contact time"];
  R_reab -> R_clren [arrowhead=tee]; R_clren -> B_ctot [arrowhead=tee label="removes"];
  A_hco3 -> R_bicu; R_thr -> R_bicu [arrowhead=tee];
  R_bicu -> R_uph [penwidth=2]; R_bicu -> R_kwast;
  R_kwast -> L_kb [arrowhead=tee];
  L_kp -> R_thr [arrowhead=tee label="hypokalaemia RAISES\nthe threshold" color="#B71C1C" penwidth=2];
  L_ecf -> R_thr [label="contraction raises it"];
  A_paco2 -> R_thr [label="hypocapnia LOWERS it" color="#1B5E20"];
  L_ecf -> R_gfr; L_ecf -> R_uo; R_gfr -> R_uo;
  R_atn -> R_gfr [arrowhead=tee]; O_vaso -> L_ecf [arrowhead=tee];
  O_cox2 -> R_gfr [arrowhead=tee];

  //=========================================================
  // EDGES — uncoupling
  //=========================================================
  P_musc -> U_prot [label="intracellular drug"]; U_prot -> U_grad -> U_atp;
  U_atp -> U_heat -> O_temp; U_atp -> U_kreb;
  U_kreb -> U_lac; U_atp -> U_lac; U_atp -> U_ket; U_atp -> U_glu;
  U_atp -> U_vco2; U_atp -> U_o2;
  U_lac -> A_hco3 [arrowhead=tee]; U_ket -> A_hco3 [arrowhead=tee];
  U_lac -> A_ag; U_ket -> A_ag; B_ctot -> A_ag [label="salicylate anion"];
  U_glu -> C_cmr; O_temp -> L_ecf [arrowhead=tee label="sweat"];
  U_vco2 -> A_paco2 [label="raises the ventilation\nrequirement"];

  //=========================================================
  // EDGES — acid-base and ventilation
  //=========================================================
  P_brain -> A_resp [penwidth=2 label="direct stimulation"];
  P_phb -> A_chemo; A_chemo -> A_va; A_resp -> A_va;
  A_va -> A_paco2 [arrowhead=tee penwidth=2];
  A_paco2 -> A_ph; A_hco3 -> A_ph;
  A_va -> A_fatig; A_fatig -> A_va [arrowhead=tee style=dashed color="#B71C1C"];
  O_lung -> A_va [arrowhead=tee];
  A_ph -> A_comp; A_comp -> A_hco3;
  A_ph -> A_mixed [style=dashed]; A_ag -> A_mixed [style=dashed];
  A_ph -> L_shift; L_shift -> L_kp; L_kb -> L_kp;
  A_ph -> L_ica [arrowhead=tee];

  //=========================================================
  // EDGES — CNS
  //=========================================================
  C_glut -> C_neuro; C_cmr -> C_neuro [arrowhead=tee];
  P_brain -> C_cmr; P_brain -> C_agit; P_brain -> C_tinn; P_brain -> C_oedem;
  C_neuro -> C_seiz; C_oedem -> C_seiz; C_agit -> C_seiz;
  P_brain -> C_inj [penwidth=2]; C_neuro -> C_inj;
  C_inj -> E_surv [penwidth=2]; C_agit -> E_cns; P_brain -> E_cns [penwidth=2];
  E_cns -> E_sev; A_ph -> E_sev; C_neuro -> E_sev; O_temp -> E_sev;
  E_sev -> E_surv; R_clren -> E_los; E_t12 -> E_los;

  //=========================================================
  // EDGES — other organs
  //=========================================================
  B_ctot -> O_cox1 -> O_coag; B_ctot -> O_cox2;
  P_brain -> O_lung; B_ctot -> O_hep;
  P_brain -> O_gi; O_gi -> L_kb [arrowhead=tee]; O_gi -> L_ecf [arrowhead=tee];
  A_va -> L_ecf [arrowhead=tee label="insensible loss"];

  //=========================================================
  // EDGES — therapeutics
  //=========================================================
  T_fluid -> L_ecf [color="#004D40" penwidth=2];
  T_bic -> A_hco3 [color="#004D40" penwidth=2];
  T_bic -> T_bic2 [style=dashed];
  T_bic2 -> A_ph [style=dashed color="#004D40"];
  T_bic2 -> R_uph [style=dashed color="#004D40"];
  A_ph -> P_kpbr [label="pH ↑ → Kp ↓ → drug LEAVES the brain" color="#004D40" penwidth=2];
  T_k -> L_kb [color="#004D40" penwidth=2];
  T_glc -> C_glut [color="#004D40" penwidth=2];
  T_hd -> B_ctot [arrowhead=tee color="#004D40" penwidth=2];
  T_hd -> A_hco3 [color="#004D40"];
  T_extrip -> T_hd [style=dashed];
  T_vent -> A_va [color="#004D40" penwidth=2];
  T_cool -> O_temp [arrowhead=tee color="#004D40"];

  //=========================================================
  // EDGES — iatrogenic harm
  //=========================================================
  H_intub -> A_va [arrowhead=tee color="#B71C1C" penwidth=3];
  H_apnoea -> A_paco2 [color="#B71C1C" penwidth=2];
  H_sed -> A_va [arrowhead=tee color="#B71C1C" penwidth=2];
  H_acz -> R_uph [color="#B71C1C"]; H_acz -> A_hco3 [arrowhead=tee color="#B71C1C" penwidth=2];
  H_nok -> L_kp [arrowhead=tee color="#B71C1C"];
  H_fluid -> R_uo [arrowhead=tee color="#B71C1C"];
  H_delay -> D_level [arrowhead=tee color="#B71C1C"];

  //=========================================================
  // EDGES — measurement
  //=========================================================
  B_ctot -> D_level; D_level -> D_done; D_done -> D_donefail [style=dashed];
  D_units -> D_level [style=dashed];
  A_ph -> D_abg; A_ag -> D_gap; B_ctot -> D_ferric;
  B_free -> D_free [style=dashed];
  D_free -> P_brain [style=dashed label="what we would need\nto know" color="#311B92"];
  P_brain -> D_donefail [style=dashed color="#B71C1C" label="the nomogram grades\nthe wrong variable"];
  D_abg -> T_bic [style=dashed]; D_level -> T_hd [style=dashed];

  //=========================================================
  // Legend
  //=========================================================
  subgraph cluster_legend {
    label="Legend / model bookkeeping"
    style=filled fillcolor="#FFFFFF" color="#9E9E9E" fontsize=12 fontname="Helvetica-Bold"
    LG1 [label="28 ODE states · 12 treatment scenarios · 11 Shiny tabs\nCalibrated to: Levy 1965 (Michaelis-Menten metabolism),\nDone 1960, Hill 1971 (pH and tissue partition), Prescott 1982\n(alkalinisation vs diuresis), Proudfoot 2004, Juurlink 2015 (EXTRIP)" shape=note fillcolor="#F5F5F5" color="#616161"]
    LG2 [label="—▶ mass flow or activation        —⊣ inhibition / removal\nred = iatrogenic or self-amplifying     teal = therapy\nyellow notes = a consequence the model derives rather than assumes" shape=note fillcolor="#F5F5F5" color="#616161"]
    LG3 [label="THE ONE-LINE MODEL\nC_brain = C_total × fu(C_total, pH) × f_n(pH_plasma)/f_n(pH_brain)\nThe lab measures only the first term.  Bicarbonate is the only\nintervention that moves the second and third at once." shape=note fillcolor="#FFF9C4" color="#F9A825" penwidth=2]
    LG1 -> LG2 [style=invis]; LG2 -> LG3 [style=invis];
  }
}
